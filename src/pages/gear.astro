---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase === '/' ? '' : rawBase.replace(/\/$/, '');
---

<BaseLayout
  title="Production & Gear · Hey This Is Andrew"
  description="The exact kit behind commercial shoots, beverage captures, and YouTube productions. Zero sponsored bloat: strictly equipment actively deployed in the studio."
>
  <div class="container gear-page">
    <div class="gear-header">
      <span class="mono-tag">Verified Inventory</span>
      <h1 class="gear-title">Production &amp; Gear</h1>
      <p class="gear-lede">
        The exact kit behind commercial shoots, beverage captures, and YouTube productions.
        Zero sponsored bloat: strictly equipment actively deployed in the studio.
      </p>
    </div>

    <!-- Section 1: Camera Bodies -->
    <section id="bodies" class="gear-section">
      <SectionHeader
        id="bodies-heading"
        index="01"
        kicker="Primary & Secondary"
        title="Camera Bodies"
        lede="High-resolution hybrid cameras deployed for video and commercial stills."
      />
      <div class="gear-grid">
        <div class="gear-card">
          <div class="gear-meta-row">
            <span class="mono-tag">Primary Body</span>
            <span class="gear-spec font-mono">Full Frame</span>
          </div>
          <div>
            <h3 class="gear-item-name">Sony a7 IV</h3>
            <p class="gear-item-desc">33MP hybrid camera for studio video capture, talking-head YouTube production, and high-res photography.</p>
          </div>
          <a href="https://a.co/d/0i9uWbMj" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
            Storefront Link &rarr;
          </a>
        </div>

        <div class="gear-card">
          <div class="gear-meta-row">
            <span class="mono-tag">Compact Body</span>
            <span class="gear-spec font-mono">61MP R-Series</span>
          </div>
          <div>
            <h3 class="gear-item-name">Sony a7C R</h3>
            <p class="gear-item-desc">61MP ultra-compact body for high-resolution commercial photography, product detail shoots, and mobile travel rigs.</p>
          </div>
          <a href="https://a.co/d/0i9uWbMj" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
            Storefront Link &rarr;
          </a>
        </div>
      </div>
    </section>

    <!-- Section 2: Lighting & Flash -->
    <section id="lighting" class="gear-section">
      <SectionHeader
        id="lighting-heading"
        index="02"
        kicker="Continuous & Strobe"
        title="Lighting &amp; Flash"
        lede="Controlling the scene with continuous daylight and high-speed wireless radio flash."
      />
      <div class="gear-grid">
        <div class="gear-card">
          <div class="gear-meta-row">
            <span class="mono-tag">On-Camera Flash</span>
            <span class="gear-spec font-mono">GN60</span>
          </div>
          <div>
            <h3 class="gear-item-name">Sony HVL-F60RM2</h3>
            <p class="gear-item-desc">Flagship wireless radio control flash for event photography, editorial stills, and mobile bounce lighting.</p>
          </div>
          <a href="https://a.co/d/0i9uWbMj" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
            Storefront Link &rarr;
          </a>
        </div>

        <div class="gear-card">
          <div class="gear-meta-row">
            <span class="mono-tag">Key Light</span>
            <span class="gear-spec font-mono">200W Daylight</span>
          </div>
          <div>
            <h3 class="gear-item-name">Aputure Amaran 200d</h3>
            <p class="gear-item-desc">High-output 200W Bowens mount continuous daylight LED key light for YouTube video sets and high-speed photography.</p>
          </div>
          <a href="https://a.co/d/0i9uWbMj" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
            Storefront Link &rarr;
          </a>
        </div>

        <div class="gear-card">
          <div class="gear-meta-row">
            <span class="mono-tag">Accent Tube</span>
            <span class="gear-spec font-mono">RGBWW Pixel</span>
          </div>
          <div>
            <h3 class="gear-item-name">Amaran PT1c RGB Tube</h3>
            <p class="gear-item-desc">Battery-powered 1-foot RGBWW pixel tube for studio rim lighting, beverage highlights, and in-frame accents.</p>
          </div>
          <a href="https://a.co/d/0i9uWbMj" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
            Storefront Link &rarr;
          </a>
        </div>
      </div>
    </section>

    <!-- Section 3: Zoom Lenses -->
    <section id="zooms" class="gear-section">
      <SectionHeader
        id="zooms-heading"
        index="03"
        kicker="Sony G Master II Trinity"
        title="Zoom Lenses"
        lede="Complete focal length coverage from 16mm ultra-wide to 200mm telephoto compression."
      />
      <div class="gear-grid">
        <div class="gear-card">
          <div class="gear-meta-row">
            <span class="mono-tag">Ultra-Wide</span>
            <span class="gear-spec font-mono">f/2.8 GM II</span>
          </div>
          <div>
            <h3 class="gear-item-name">Sony 16-35mm f/2.8 GM II</h3>
            <p class="gear-item-desc">Ultra-wide zoom for architectural interiors, environmental bar portraits, and studio video desk capture.</p>
          </div>
          <a href="https://a.co/d/0i9uWbMj" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
            Storefront Link &rarr;
          </a>
        </div>

        <div class="gear-card">
          <div class="gear-meta-row">
            <span class="mono-tag">Standard Zoom</span>
            <span class="gear-spec font-mono">f/2.8 GM II</span>
          </div>
          <div>
            <h3 class="gear-item-name">Sony 24-70mm f/2.8 GM II</h3>
            <p class="gear-item-desc">The primary commercial workhorse. Razor-sharp resolving power across the entire range with lightning-fast autofocus.</p>
          </div>
          <a href="https://a.co/d/0i9uWbMj" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
            Storefront Link &rarr;
          </a>
        </div>

        <div class="gear-card">
          <div class="gear-meta-row">
            <span class="mono-tag">Telephoto</span>
            <span class="gear-spec font-mono">f/2.8 GM II</span>
          </div>
          <div>
            <h3 class="gear-item-name">Sony 70-200mm f/2.8 GM II</h3>
            <p class="gear-item-desc">Lightweight telephoto zoom for compressed event portraits, live venue coverage, and cinematic video b-roll.</p>
          </div>
          <a href="https://a.co/d/0i9uWbMj" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
            Storefront Link &rarr;
          </a>
        </div>
      </div>
    </section>

    <!-- Section 4: Prime & Macro Lenses -->
    <section id="primes" class="gear-section">
      <SectionHeader
        id="primes-heading"
        index="04"
        kicker="Compact Primes & Detail"
        title="Prime &amp; Macro Lenses"
        lede="Dedicated optics for high micro-contrast, intimate depth-of-field, and 1:1 macro rendering."
      />
      <div class="gear-grid">
        <div class="gear-card">
          <div class="gear-meta-row">
            <span class="mono-tag">Compact Wide</span>
            <span class="gear-spec font-mono">f/2.8 G</span>
          </div>
          <div>
            <h3 class="gear-item-name">Sony 24mm f/2.8 G</h3>
            <p class="gear-item-desc">Ultra-compact, all-metal prime paired with the a7C R for low-profile street captures and stealth documentary work.</p>
          </div>
          <a href="https://a.co/d/0i9uWbMj" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
            Storefront Link &rarr;
          </a>
        </div>

        <div class="gear-card">
          <div class="gear-meta-row">
            <span class="mono-tag">Compact Normal</span>
            <span class="gear-spec font-mono">f/2.5 G</span>
          </div>
          <div>
            <h3 class="gear-item-name">Sony 50mm f/2.5 G</h3>
            <p class="gear-item-desc">Precision normal focal length in an aluminum chassis with physical aperture ring and tactile control.</p>
          </div>
          <a href="https://a.co/d/0i9uWbMj" target="_blank" rel="noopener noreferrer" class="btn-secondary">
            Storefront Link &rarr;
          </a>
        </div>

        <div class="gear-card">
          <div class="gear-meta-row">
            <span class="mono-tag">Fast Normal</span>
            <span class="gear-spec font-mono">f/1.8 ZA</span>
          </div>
          <div>
            <h3 class="gear-item-name">Sony 55mm f/1.8 ZA</h3>
            <p class="gear-item-desc">Classic Zeiss optical formulation delivering micro-contrast and 3D pop for editorial and commercial stills.</p>
          </div>
          <a href="https://a.co/d/0i9uWbMj" target="_blank" rel="noopener noreferrer" class="btn-secondary">
            Storefront Link &rarr;
          </a>
        </div>

        <div class="gear-card">
          <div class="gear-meta-row">
            <span class="mono-tag">Portrait Prime</span>
            <span class="gear-spec font-mono">f/2.0 EVO</span>
          </div>
          <div>
            <h3 class="gear-item-name">Viltrox 85mm f/2.0 EVO</h3>
            <p class="gear-item-desc">Dedicated medium telephoto portrait lens providing background separation and rendering for interview setups.</p>
          </div>
          <a href="https://a.co/d/0i9uWbMj" target="_blank" rel="noopener noreferrer" class="btn-secondary">
            Storefront Link &rarr;
          </a>
        </div>

        <div class="gear-card">
          <div class="gear-meta-row">
            <span class="mono-tag">Macro Workhorse</span>
            <span class="gear-spec font-mono">1:1 Magnification</span>
          </div>
          <div>
            <h3 class="gear-item-name">Sony 90mm f/2.8 Macro G OSS</h3>
            <p class="gear-item-desc">Essential optic for Capture Create Caffeinate beverage photography, coffee extraction details, and ice textures.</p>
          </div>
          <a href="https://a.co/d/0i9uWbMj" target="_blank" rel="noopener noreferrer" class="btn-secondary">
            Storefront Link &rarr;
          </a>
        </div>
      </div>
    </section>

    <!-- Section 5: Audio Hardware -->
    <section id="audio" class="gear-section">
      <SectionHeader
        id="audio-heading"
        index="05"
        kicker="Microphones & Routing"
        title="Audio Hardware"
        lede="Dedicated broadcast dynamic mics and multi-dial directional digital shotgun feeds."
      />
      <div class="gear-grid">
        <div class="gear-card">
          <div class="gear-meta-row">
            <span class="mono-tag">Broadcast Dynamic</span>
            <span class="gear-spec font-mono">USB/XLR</span>
          </div>
          <div>
            <h3 class="gear-item-name">Shure MV6</h3>
            <p class="gear-item-desc">Direct-to-USB/XLR dynamic gaming and voiceover microphone for YouTube tutorials and voice captures.</p>
          </div>
          <a href="https://a.co/d/0i9uWbMj" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
            Storefront Link &rarr;
          </a>
        </div>

        <div class="gear-card">
          <div class="gear-meta-row">
            <span class="mono-tag">Shotgun Mic</span>
            <span class="gear-spec font-mono">Digital Hot Shoe</span>
          </div>
          <div>
            <h3 class="gear-item-name">Sony ECM-M1</h3>
            <p class="gear-item-desc">Compact 8-dial direct digital audio shotgun microphone with cableless multi-interface shoe connection.</p>
          </div>
          <a href="https://a.co/d/0i9uWbMj" target="_blank" rel="noopener noreferrer" class="btn-secondary">
            Storefront Link &rarr;
          </a>
        </div>

        <div class="gear-card">
          <div class="gear-meta-row">
            <span class="mono-tag">Directional Shotgun</span>
            <span class="gear-spec font-mono">Beamforming</span>
          </div>
          <div>
            <h3 class="gear-item-name">Sony ECM-B1M</h3>
            <p class="gear-item-desc">Advanced beamforming digital shotgun microphone for clear voice rejection on noisy convention floors.</p>
          </div>
          <a href="https://a.co/d/0i9uWbMj" target="_blank" rel="noopener noreferrer" class="btn-secondary">
            Storefront Link &rarr;
          </a>
        </div>

        <div class="gear-card">
          <div class="gear-meta-row">
            <span class="mono-tag">Desktop Condenser</span>
            <span class="gear-spec font-mono">Multi-Pattern</span>
          </div>
          <div>
            <h3 class="gear-item-name">Blue Yeti</h3>
            <p class="gear-item-desc">Multi-pattern USB condenser microphone for podcast scratch audio, secondary desk feeds, and voiceovers.</p>
          </div>
          <a href="https://a.co/d/0i9uWbMj" target="_blank" rel="noopener noreferrer" class="btn-secondary">
            Storefront Link &rarr;
          </a>
        </div>
      </div>
    </section>

    <!-- Section 6: Software, Routing & Grip -->
    <section id="tools" class="gear-section">
      <SectionHeader
        id="tools-heading"
        index="06"
        kicker="Studio Infrastructure"
        title="Software, Routing &amp; Grip"
        lede="Editing software, DSP routing pipelines, C-stands, and overhead rigging."
      />
      <div class="gear-grid">
        <div class="gear-card">
          <div class="gear-meta-row">
            <span class="mono-tag">Audio DSP</span>
            <span class="gear-spec font-mono">Submix Engine</span>
          </div>
          <div>
            <h3 class="gear-item-name">Elgato Wave Link 3</h3>
            <p class="gear-item-desc">Digital submixing and VST audio processing pipeline routing clean mic feeds directly to OBS and recording tracks.</p>
          </div>
          <a href="https://a.co/d/0i9uWbMj" target="_blank" rel="noopener noreferrer" class="btn-secondary">
            Storefront Link &rarr;
          </a>
        </div>

        <div class="gear-card">
          <div class="gear-meta-row">
            <span class="mono-tag">Video Post</span>
            <span class="gear-spec font-mono">Color & Edit</span>
          </div>
          <div>
            <h3 class="gear-item-name">DaVinci Resolve</h3>
            <p class="gear-item-desc">Primary NLE for grading 10-bit 4:2:2 S-Log3 footage, Fairlight audio mastering, and 9:16 vertical exports.</p>
          </div>
          <a href="https://a.co/d/0i9uWbMj" target="_blank" rel="noopener noreferrer" class="btn-secondary">
            Storefront Link &rarr;
          </a>
        </div>

        <div class="gear-card">
          <div class="gear-meta-row">
            <span class="mono-tag">Photo Post</span>
            <span class="gear-spec font-mono">Raw Workflow</span>
          </div>
          <div>
            <h3 class="gear-item-name">Adobe Lightroom &amp; Photoshop</h3>
            <p class="gear-item-desc">Precision color calibration for commercial cocktail and beverage photography with custom grain and grade curves.</p>
          </div>
          <a href="https://a.co/d/0i9uWbMj" target="_blank" rel="noopener noreferrer" class="btn-secondary">
            Storefront Link &rarr;
          </a>
        </div>

        <div class="gear-card">
          <div class="gear-meta-row">
            <span class="mono-tag">Mobile Camera</span>
            <span class="gear-spec font-mono">Manual Tools</span>
          </div>
          <div>
            <h3 class="gear-item-name">Moment Mobile Tools</h3>
            <p class="gear-item-desc">Pro camera apps, mobile ND filter adapters, and MagSafe rig handles for high-mobility behind-the-scenes recording.</p>
          </div>
          <a href="https://a.co/d/0i9uWbMj" target="_blank" rel="noopener noreferrer" class="btn-secondary">
            Storefront Link &rarr;
          </a>
        </div>

        <div class="gear-card">
          <div class="gear-meta-row">
            <span class="mono-tag">Heavy Grip</span>
            <span class="gear-spec font-mono">Mounting & Rigging</span>
          </div>
          <div>
            <h3 class="gear-item-name">Tripods &amp; C-Stands</h3>
            <p class="gear-item-desc">Heavy-duty stainless steel C-stands, boom arms, and carbon fiber video tripods securing overhead beverage rigs.</p>
          </div>
          <a href="https://a.co/d/0i9uWbMj" target="_blank" rel="noopener noreferrer" class="btn-secondary">
            Storefront Link &rarr;
          </a>
        </div>
      </div>
    </section>

    <!-- Official Amazon Storefront Banner -->
    <div class="gear-storefront-cta">
      <span class="mono-tag">Official Storefront</span>
      <h2 class="storefront-cta-title">Shop Andrew's Verified Kit on Amazon</h2>
      <p class="storefront-cta-desc">
        Direct access to all verified cameras, lenses, lighting accessories, Neewer C-stands, and audio gear.
      </p>
      <a href="https://a.co/d/0i9uWbMj" target="_blank" rel="noopener noreferrer" class="btn btn-primary">
        Open Amazon Storefront &rarr;
      </a>
    </div>
  </div>
</BaseLayout>

<style>
  .gear-page {
    padding-top: clamp(2rem, 4vw, 4rem);
    padding-bottom: clamp(4rem, 8vw, 7rem);
  }
  .gear-header {
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }
  .mono-tag {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border);
    padding: 0.3rem 0.65rem;
    display: inline-block;
    margin-bottom: 0.75rem;
  }
  .gear-title {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    color: var(--ink);
    margin: 0 0 0.75rem;
    line-height: 1.05;
  }
  .gear-lede {
    font-size: 1.05rem;
    color: var(--muted);
    max-width: 65ch;
    line-height: 1.7;
    margin: 0;
  }
  .gear-section {
    padding-top: clamp(2rem, 4vw, 3.5rem);
    border-top: 1px solid var(--line);
  }
  .gear-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: clamp(1rem, 2vw, 1.75rem);
    margin-top: 1.5rem;
  }
  .gear-card {
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.25rem;
    transition: border-color 0.25s ease, background-color 0.25s ease, transform 0.25s ease;
  }
  .gear-card:hover {
    border-color: rgba(255, 255, 255, 0.35);
    background: var(--surface-2);
    transform: translateY(-2px);
  }
  .gear-meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .gear-spec {
    font-size: 0.75rem;
    color: var(--muted);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .gear-item-name {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--ink);
    margin: 0 0 0.5rem;
  }
  .gear-item-desc {
    font-size: 0.9rem;
    color: var(--muted);
    line-height: 1.6;
    margin: 0;
  }
  .gear-storefront-cta {
    margin-top: clamp(3rem, 6vw, 5rem);
    background: var(--surface);
    border: 1px solid var(--border);
    padding: clamp(2rem, 5vw, 3.5rem);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }
  .storefront-cta-title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3.5vw, 2.5rem);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--ink);
    margin: 0;
    line-height: 1.1;
  }
  .storefront-cta-desc {
    color: var(--muted);
    max-width: 58ch;
    font-size: 1rem;
    line-height: 1.6;
    margin: 0;
  }
</style>
