---
/**
 * /sitemap — Complete architectural index of the site and connected brand channels.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';

const corePages = [
  { path: '/', title: 'Home', desc: 'Main hub featuring the brand universe, live photography elevator, about thesis, and gear.' },
  { path: '/build/', title: 'Build in Public', desc: 'Interactive milestone checklists, roadmap, and progression meters.' },
  { path: '/gear/', title: 'Production & Gear', desc: 'Complete inventory of camera bodies, lenses, lighting, and audio equipment.' },
  { path: '/cafe/', title: 'The Cafe', desc: 'Dedicated espresso bar setup, coffee gear, beans, and shoppable reels.' },
  { path: '/about/', title: 'About', desc: 'Story and background on Andrew Baxter, creative ethos, and the build-in-public thesis.' },
  { path: '/feed/', title: 'Feed', desc: 'Complete timeline of video episodes, published articles, and build updates.' },
  { path: '/links/', title: 'Links (Link in Bio)', desc: 'Clean, monochrome mobile index for social profiles and quick access.' },
  { path: '/press/', title: 'Press Kit', desc: 'Official biography, high-resolution photography, logos, and pitch stats.' },
  { path: '/events/', title: 'Events', desc: 'Upcoming shoots, bar pop-ups, creator collaborations, and speaking appearances.' },
  { path: '/privacy/', title: 'Privacy Policy', desc: 'Privacy commitment: zero invasive tracking, no third-party ad networks.' },
];

const brandUniverses = [
  { path: '/brands/hey-this-is-andrew/', title: 'Hey This Is Andrew', desc: 'Parent studio brand documenting creative entrepreneurship and craft.' },
  { path: '/brands/be-unconventional-hq/', title: 'BE Unconventional HQ', desc: 'Cinematic nerd culture, movie & game reviews, long-form video essays.' },
  { path: '/brands/capture-create-caffeinate/', title: 'Capture Create Caffeinate', desc: 'Hospitality & bar creative studio specializing in beverage photography and reels.' },
];

const externalChannels = [
  { url: 'https://www.linkedin.com/in/andrewlwyrbaxter/', title: 'LinkedIn', note: 'Professional background, network, and direct messaging' },
  { url: 'https://www.youtube.com/@HeyThisIsAndrew', title: 'YouTube', note: 'Long-form build-in-public series, studio vlogs, and gear reviews' },
  { url: 'https://www.instagram.com/hey_thisisandrew/', title: 'Instagram (@hey_thisisandrew)', note: 'Personal creative daily updates and behind-the-scenes' },
  { url: 'https://www.instagram.com/capturecreatecaffeinate/', title: 'Instagram (@capturecreatecaffeinate)', note: 'Bar and cocktail photography studio feed' },
  { url: 'https://tiktok.com/@hey_thisisandrew', title: 'TikTok', note: 'Short-form tips, camera setups, and quick edits' },
  { url: 'https://thisiscoffeetalk.substack.com/', title: 'Substack', note: 'Notes from the Build newsletter essays and transparent retrospectives' },
  { url: 'https://www.threads.net/@hey_thisisandrew', title: 'Threads', note: 'Real-time discussions and build-in-public thoughts' },
  { url: 'https://bsky.app/profile/thisisandrew.bsky.social', title: 'Bluesky', note: 'Open social web presence' },
];

const machineFeeds = [
  { path: '/sitemap-index.xml', title: 'XML Sitemap Index', note: 'Search engine protocol index for Google, Bing, and web spiders' },
  { path: '/feed', title: 'Latest RSS Feed / Content Stream', note: 'Structured content stream of recent videos and articles' },
];

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const fullUrl = (path: string) => path.startsWith('http') ? path : (path === '/' ? (baseUrl ? `${baseUrl}/` : '/') : `${baseUrl}${path}`);
---

<BaseLayout
  title="Sitemap · Hey This Is Andrew"
  description="Comprehensive index of every page, project, and external channel across the Hey This Is Andrew creative network."
>
  <div class="sitemap-container">
    <SectionHeader
      kicker="Directory"
      index="00"
      title="Sitemap"
      lede="A complete architectural index of every page, project, and external channel across the Hey This Is Andrew ecosystem."
      id="sitemap-heading"
    />

    <div class="sitemap-sections">
      <!-- Section 1: Core Pages -->
      <section class="sitemap-group" aria-labelledby="core-heading">
        <h2 id="core-heading" class="group-title">
          <span class="group-number">01</span> Core Website Pages
        </h2>
        <div class="sitemap-grid">
          {corePages.map((p) => (
            <a href={fullUrl(p.path)} class="sitemap-card">
              <div class="card-header">
                <span class="card-title">{p.title}</span>
                <span class="card-path">{p.path}</span>
              </div>
              <p class="card-desc">{p.desc}</p>
            </a>
          ))}
        </div>
      </section>

      <!-- Section 2: Brand Universes -->
      <section class="sitemap-group" aria-labelledby="brands-heading">
        <h2 id="brands-heading" class="group-title">
          <span class="group-number">02</span> Brand Universes
        </h2>
        <div class="sitemap-grid">
          {brandUniverses.map((b) => (
            <a href={fullUrl(b.path)} class="sitemap-card brand-card">
              <div class="card-header">
                <span class="card-title">{b.title}</span>
                <span class="card-path">{b.path}</span>
              </div>
              <p class="card-desc">{b.desc}</p>
            </a>
          ))}
        </div>
      </section>

      <!-- Section 3: Official Social Channels -->
      <section class="sitemap-group" aria-labelledby="channels-heading">
        <h2 id="channels-heading" class="group-title">
          <span class="group-number">03</span> Connected Channels & Social Links
        </h2>
        <div class="sitemap-grid external-grid">
          {externalChannels.map((c) => (
            <a href={c.url} target="_blank" rel="noopener noreferrer" class="sitemap-card external-card">
              <div class="card-header">
                <span class="card-title">{c.title}</span>
                <span class="card-icon" aria-hidden="true">↗</span>
              </div>
              <p class="card-desc">{c.note}</p>
              <span class="card-url">{c.url.replace(/^https?:\/\//, '')}</span>
            </a>
          ))}
        </div>
      </section>

      <!-- Section 4: Feeds & Machine Endpoints -->
      <section class="sitemap-group" aria-labelledby="feeds-heading">
        <h2 id="feeds-heading" class="group-title">
          <span class="group-number">04</span> Machine Endpoints & Feeds
        </h2>
        <div class="sitemap-grid feeds-grid">
          {machineFeeds.map((f) => (
            <a href={fullUrl(f.path)} class="sitemap-card feed-card">
              <div class="card-header">
                <span class="card-title">{f.title}</span>
                <span class="card-path">{f.path}</span>
              </div>
              <p class="card-desc">{f.note}</p>
            </a>
          ))}
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .sitemap-container {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: clamp(2rem, 5vw, 4rem) clamp(1.25rem, 4vw, 2.5rem);
  }

  .sitemap-sections {
    display: flex;
    flex-direction: column;
    gap: 4rem;
    margin-top: 3rem;
  }

  .sitemap-group {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .group-title {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-white, #fff);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding-bottom: 0.75rem;
  }

  .group-number {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-accent-text, #f59e0b);
    letter-spacing: 0.15em;
  }

  .sitemap-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  .sitemap-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.25rem;
    background: rgba(255, 255, 255, 0.025);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 4px;
    text-decoration: none;
    transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }

  .sitemap-card:hover {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.25);
    transform: translateY(-2px);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
  }

  .card-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.05rem;
    color: var(--color-white, #fff);
  }

  .card-path,
  .card-icon {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.45);
  }

  .card-desc {
    font-size: 0.85rem;
    line-height: 1.45;
    color: var(--color-white-muted, #999);
    margin: 0;
  }

  .card-url {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.35);
    margin-top: auto;
    word-break: break-all;
  }

  .brand-card {
    border-left: 3px solid rgba(255, 255, 255, 0.3);
  }

  .external-card {
    border-left: 3px solid rgba(245, 158, 11, 0.35);
  }

  .feed-card {
    border-left: 3px solid rgba(16, 185, 129, 0.35);
  }
</style>
