---
/**
 * Brand hub: Hey This Is Andrew (parent brand).
 * The creator behind the lanes: building in public, documenting the
 * messy middle of creative work, photography, and coffee.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import WorkWithAndrew from '../../components/WorkWithAndrew.astro';
import { getLatestVideos, getLatestArticles } from '../../lib/latest-content';
import parentLogo from '../../assets/brand-logos/hey-thisisandrew.png';
import portrait from '../../assets/hero-media/portrait.jpg';

const videos = await getLatestVideos(3);
const articles = await getLatestArticles(3);

const LANES = [
  {
    name: 'BE Unconventional HQ',
    desc: 'The cinematic media brand. Film, TV, games, and event coverage.',
    href: '/brands/be-unconventional-hq',
  },
  {
    name: 'Capture Create Caffeinate',
    desc: 'The hospitality content brand. Photography and video for bars and restaurants.',
    href: '/brands/capture-create-caffeinate',
  },
];
---

<BaseLayout
  title="Hey This Is Andrew · The Parent Brand"
  description="Hey This Is Andrew: the creator behind the lanes. Building brands in public, documenting the shoots, the edits, the gear, and everything learned along the way."
>
  <div class="container">
    <section class="hub-hero" aria-labelledby="hub-heading">
      <p class="hub-kicker">The parent brand</p>
      <div class="hub-lockup">
        <img class="hub-logo" src={parentLogo.src} alt="HEY_THISISANDREW logo" />
      </div>
      <h1 class="hub-headline" id="hub-heading">BUILDING IN PUBLIC.</h1>
      <p class="hub-deck">
        Andrew Baxter documents the messy middle of building creative brands:
        the shoots, the edits, the gear, and everything learned along the
        way. One person, three lanes, all of it out in the open.
      </p>
    </section>

    <section class="hub-media" aria-label="Andrew portrait">
      <img src={portrait.src} alt="Andrew Baxter portrait" loading="lazy" />
    </section>

    <section class="hub-lanes" aria-labelledby="hub-lanes-heading">
      <SectionHeader
        id="hub-lanes-heading"
        index="01"
        kicker="The lanes"
        title="Three brands, one builder"
        lede="Each lane is its own world. This is where they all start."
      />
      <ul class="lane-list">
        {LANES.map((lane) => (
          <li class="lane-item">
            <a class="lane-link" href={lane.href}>
              <span class="lane-name">{lane.name}</span>
              <span class="lane-desc">{lane.desc}</span>
              <span class="lane-arrow" aria-hidden="true">
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                  <path d="M1 11L11 1M11 1H3M11 1V9" stroke="currentColor" stroke-width="1.5" />
                </svg>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="hub-latest" aria-labelledby="hub-latest-heading">
      <SectionHeader
        id="hub-latest-heading"
        index="02"
        kicker="Fresh off the bench"
        title="Latest work"
        lede="The newest videos and articles from the parent brand feed."
        linkLabel="See the full feed"
        linkHref="/feed"
      />
      <ul class="latest-list">
        {videos.map((v) => (
          <li class="latest-item">
            <a class="latest-link" href={v.url} target="_blank" rel="noopener">
              <span class="latest-kind">VIDEO</span>
              <span class="latest-title">{v.title}</span>
            </a>
          </li>
        ))}
        {articles.map((a) => (
          <li class="latest-item">
            <a class="latest-link" href={a.url} target="_blank" rel="noopener">
              <span class="latest-kind">ARTICLE</span>
              <span class="latest-title">{a.title}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>

  <WorkWithAndrew />
</BaseLayout>

<style>
  .hub-hero {
    padding-top: clamp(3rem, 6vw, 5rem);
    padding-bottom: clamp(2rem, 4vw, 3rem);
    text-align: center;
    max-width: 56rem;
    margin-inline: auto;
  }

  .hub-kicker {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 1.75rem;
  }

  .hub-lockup {
    display: flex;
    justify-content: center;
    margin-bottom: 1.75rem;
  }

  .hub-logo {
    max-width: 320px;
    width: 80%;
    height: auto;
    display: block;
  }

  .hub-headline {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.2rem, 1.9vw + 1.6rem, 3.4rem);
    line-height: 1.06;
    letter-spacing: 0.01em;
    margin: 0 0 1.25rem;
  }

  .hub-deck {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.7;
    color: var(--muted);
    margin: 0;
  }

  .hub-media {
    max-width: 56rem;
    margin: 0 auto clamp(3rem, 6vw, 5rem);
  }

  .hub-media img {
    width: 100%;
    height: auto;
    display: block;
  }

  .hub-lanes {
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }

  .lane-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .lane-item {
    border-bottom: 1px solid var(--line);
  }

  .lane-link {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.5rem 1rem;
    align-items: center;
    padding: 1.4rem 0.25rem;
    text-decoration: none;
    color: var(--ink);
    transition: background 160ms ease;
  }

  .lane-link:hover {
    background: var(--surface);
  }

  .lane-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.25rem;
    grid-column: 1;
  }

  .lane-desc {
    font-family: var(--font-body);
    font-size: 0.9rem;
    color: var(--muted);
    grid-column: 1;
  }

  .lane-arrow {
    grid-column: 2;
    grid-row: 1 / 3;
    color: var(--muted);
  }

  .lane-link:hover .lane-arrow {
    color: var(--ink);
  }

  .hub-latest {
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }

  .latest-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .latest-item {
    border-bottom: 1px solid var(--line);
  }

  .latest-link {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 1.1rem 0.25rem;
    text-decoration: none;
    color: var(--ink);
    transition: background 160ms ease;
  }

  .latest-link:hover {
    background: var(--surface);
  }

  .latest-kind {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.22em;
    color: var(--muted);
    text-transform: uppercase;
    flex-shrink: 0;
    width: 5.5rem;
  }

  .latest-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.02rem;
    line-height: 1.35;
  }
</style>
