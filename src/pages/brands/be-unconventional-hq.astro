---
/**
 * Brand hub: BE Unconventional HQ.
 * A portfolio page for brand deal pitches. The cinematic media brand:
 * reviews, deep dives, and event coverage for nerd culture.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import WorkWithAndrew from '../../components/WorkWithAndrew.astro';
import beLogo from '../../assets/brand-logos/be-logo.png';
import beMedia from '../../assets/hero-media/be-hq-still.jpg';

const STATS = [
  { value: 'Film', label: 'Reviews and breakdowns' },
  { value: 'TV', label: 'Episode coverage' },
  { value: 'Games', label: 'Design and story analysis' },
  { value: 'Events', label: 'Premieres and conventions' },
];
---

<BaseLayout
  title="BE Unconventional HQ · HEY_THISISANDREW"
  description="BE Unconventional HQ: where nerd culture gets cinematic. Reviews, deep dives, and event coverage for film, TV, and games."
>
  <div class="container">
    <section class="hub-hero" aria-labelledby="hub-heading">
      <p class="hub-kicker">Media Brand · A Hey This Is Andrew lane</p>
      <div class="hub-lockup">
        <img class="hub-logo" src={beLogo.src} alt="BE Unconventional HQ logo" />
      </div>
      <h1 class="hub-headline" id="hub-heading">WHERE NERD CULTURE GETS CINEMATIC.</h1>
      <p class="hub-deck">
        Reviews, deep dives, and event coverage for people who love the craft
        behind the stories. If we are talking cinema, the content should look
        like cinema.
      </p>
      <p class="hub-actions">
        <a class="hub-cta" href="https://beunconventionalhq.com/" target="_blank" rel="noopener">
          Visit BE Unconventional HQ
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M1 11L11 1M11 1H3M11 1V9" stroke="currentColor" stroke-width="1.5" />
          </svg>
        </a>
      </p>
    </section>

    <section class="hub-media" aria-label="BE Unconventional HQ still">
      <img src={beMedia.src} alt="A cinematic still from the BE Unconventional HQ studio" loading="lazy" />
    </section>

    <section class="hub-about" aria-labelledby="hub-about-heading">
      <SectionHeader
        id="hub-about-heading"
        index="01"
        kicker="The brand"
        title="What it covers"
        lede="Slow down, appreciate the details, have a genuine conversation."
      />
      <div class="hub-coverage">
        {STATS.map((s) => (
          <div class="hub-stat">
            <p class="hub-stat-value">{s.value}</p>
            <p class="hub-stat-label">{s.label}</p>
          </div>
        ))}
      </div>
      <div class="hub-copy">
        <p>
          BE Unconventional HQ is an editorial publication for film, television,
          gaming, and live events. No clickbait, no artificial outrage, just
          unfiltered honesty and expertise-driven analysis.
        </p>
        <p>
          Screeners, review copies, event credentials, and partnership requests
          all start in one place. The brand is built for studios and publishers
          who want coverage that treats their work with the seriousness it
          deserves.
        </p>
      </div>
    </section>
  </div>

  <WorkWithAndrew />
</BaseLayout>

<style>
  .hub-hero {
    padding-top: clamp(3rem, 6vw, 5rem);
    padding-bottom: clamp(2rem, 4vw, 3rem);
    text-align: center;
    max-width: 56rem;
    margin-inline: auto;
  }

  .hub-kicker {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 1.75rem;
  }

  .hub-lockup {
    display: flex;
    justify-content: center;
    margin-bottom: 1.75rem;
  }

  .hub-logo {
    max-width: 220px;
    width: 60%;
    height: auto;
    display: block;
  }

  .hub-headline {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.2rem, 1.9vw + 1.6rem, 3.4rem);
    line-height: 1.06;
    letter-spacing: 0.01em;
    margin: 0 0 1.25rem;
  }

  .hub-deck {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.7;
    color: var(--muted);
    margin: 0 0 2rem;
  }

  .hub-actions {
    margin: 0;
  }

  .hub-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
    border: 1px solid var(--line);
    padding: 0.9rem 1.6rem;
    transition: border-color 160ms ease, background 160ms ease;
  }

  .hub-cta:hover {
    border-color: var(--key);
    background: var(--surface);
  }

  .hub-media {
    max-width: 72rem;
    margin: 0 auto clamp(3rem, 6vw, 5rem);
  }

  .hub-media img {
    width: 100%;
    height: auto;
    display: block;
  }

  .hub-about {
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }

  .hub-coverage {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    margin-bottom: 2.5rem;
  }

  @media (min-width: 720px) {
    .hub-coverage {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .hub-stat {
    background: var(--bg);
    padding: 1.5rem 1.25rem;
  }

  .hub-stat-value {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.6rem;
    margin: 0 0 0.4rem;
  }

  .hub-stat-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--muted);
    margin: 0;
  }

  .hub-copy {
    max-width: 44rem;
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.75;
    color: var(--muted);
  }

  .hub-copy p {
    margin: 0 0 1.25rem;
  }
</style>
