---
/**
 * /feed: the unified content stream. YouTube videos and Substack
 * articles merged into one newest-first feed. Each card carries its
 * kind as a mono category label: VIDEO or ARTICLE.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import { getLatestVideos, getLatestArticles, fmtDate } from '../lib/latest-content';
import type { LatestItem } from '../lib/latest-content';

const videos = await getLatestVideos(8);
const articles = await getLatestArticles(8);

const articleItems: LatestItem[] = articles.map((a) => ({
  kind: 'article' as const,
  label: 'Article',
  title: a.title,
  description: a.subtitle,
  image: a.image,
  url: a.url,
  date: a.date,
}));

const feed: LatestItem[] = [...videos, ...articleItems].sort(
  (a, b) => +new Date(b.date) - +new Date(a.date)
);
---

<BaseLayout
  title="Feed · HEY_THISISANDREW"
  description="Every video and article in one place. The full feed from Hey This Is Andrew: builds, breakdowns, and notes from the messy middle."
>
  <h1 class="vh">The HEY_THISISANDREW feed</h1>
  <div class="container">
    <section class="feed-head" aria-labelledby="feed-heading">
      <SectionHeader
        id="feed-heading"
        index="01"
        kicker="Everything, newest first"
        title="Feed"
        lede="Videos and articles in one stream. No algorithm, just the work in the order it shipped."
      />
    </section>

    <section class="feed-grid" aria-label="Content feed">
      {feed.length === 0 && (
        <p class="feed-empty">Nothing here yet. Check back soon.</p>
      )}
      {feed.map((item) => (
        <a
          class="feed-card"
          href={item.url}
          target="_blank"
          rel="noopener"
          data-kind={item.kind}
        >
          {item.image ? (
            <span class="feed-thumb">
              <img src={item.image} alt="" loading="lazy" />
            </span>
          ) : (
            <span class="feed-thumb feed-thumb--blank" aria-hidden="true">
              <span class="feed-thumb-mark">HIA</span>
            </span>
          )}
          <span class="feed-body">
            <span class="feed-meta">
              <span class="feed-kind">{item.kind === 'video' ? 'VIDEO' : 'ARTICLE'}</span>
              <span class="feed-date">{fmtDate(new Date(item.date))}</span>
            </span>
            <span class="feed-title">{item.title}</span>
            {item.description && (
              <span class="feed-desc">{item.description}</span>
            )}
          </span>
        </a>
      ))}
    </section>

    <section class="feed-newsletter" aria-label="Newsletter signup">
      <NewsletterSignup />
    </section>
  </div>
</BaseLayout>

<style>
  .feed-head {
    padding-top: clamp(3rem, 6vw, 5rem);
  }

  .feed-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }

  @media (min-width: 720px) {
    .feed-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1180px) {
    .feed-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .feed-empty {
    font-family: var(--font-body);
    color: var(--muted);
    font-size: 1rem;
  }

  .feed-card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--line);
    text-decoration: none;
    color: var(--ink);
    transition: border-color 160ms ease, transform 160ms ease;
  }

  .feed-card:hover {
    border-color: var(--key);
    transform: translateY(-2px);
  }

  .feed-thumb {
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--fill);
  }

  .feed-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .feed-thumb--blank {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .feed-thumb-mark {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.5rem;
    letter-spacing: 0.08em;
    color: var(--key-dim);
  }

  .feed-body {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.1rem 1.15rem 1.25rem;
  }

  .feed-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .feed-kind {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.22em;
    color: var(--key-ink);
    text-transform: uppercase;
  }

  .feed-date {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    color: var(--muted);
    text-transform: uppercase;
  }

  .feed-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.12rem;
    line-height: 1.3;
  }

  .feed-desc {
    font-family: var(--font-body);
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--muted);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .feed-newsletter {
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }
</style>
