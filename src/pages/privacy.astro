---
/**
 * Privacy — plain-language policy. This is a static site: no trackers, no
 * pixels, no analytics. The only personal data that ever leaves a
 * visitor's browser is an email address they choose to share.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';

const CONTACT_EMAIL = 'heythisisandrewb@gmail.com';
---
<BaseLayout
  title="Privacy · Hey This Is Andrew"
  description="Privacy policy for hey-this-is-andrew. This is a static site with no tracking. The only data collected is an email address you choose to share."
>
  <h1 class="vh">Privacy policy for Hey This Is Andrew</h1>
  <div class="page-head" aria-hidden="true"></div>

  <section class="privacy-section" aria-labelledby="privacy-heading">
    <div class="container">
      <SectionHeader
        id="privacy-heading"
        index="01"
        kicker="The short version"
        title="Privacy"
        lede="This is a static site. There is nothing here that watches you."
      />

      <div class="privacy-body reveal">
        <h2>What this site collects</h2>
        <p>
          Almost nothing. This site is a set of static pages served to your
          browser. It runs no analytics, no advertising pixels, and no
          behavioral tracking of any kind.
        </p>

        <h2>When you share your email</h2>
        <p>
          If you subscribe to the newsletter, your email address is handled by
          Substack, the newsletter platform. Substack's own privacy policy
          applies to anything you enter there. This site never sees, stores, or
          transmits your address anywhere else.
        </p>
        <p>
          If you use the contact form or press inquiry, your message opens in
          your own email client and is sent as a regular email to
          {CONTACT_EMAIL}. Nothing is stored on a server in between.
        </p>

        <h2>Cookies</h2>
        <p>
          This site sets no cookies of its own. Third parties you choose to
          visit (Substack, YouTube, social platforms) may set theirs according
          to their own policies.
        </p>

        <h2>Your data</h2>
        <p>
          Because this site stores nothing about you, there is nothing to
          request, correct, or delete here. If you subscribed to the
          newsletter and want off the list, use the unsubscribe link in any
          email, or write to {CONTACT_EMAIL} and it will be handled.
        </p>

        <h2>Changes</h2>
        <p>
          If this policy ever changes, the updated version will be posted
          here. The guiding rule stays the same: collect as little as
          possible, and be honest about what is collected.
        </p>

        <p class="privacy-updated">Last updated: September 2026.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-head { height: clamp(4.5rem, 8vw, 6rem); }
  .privacy-section {
    padding: clamp(2rem, 5vw, 4rem) 0 clamp(4rem, 8vw, 7rem);
  }
  .privacy-body {
    margin-top: clamp(2rem, 5vw, 3.5rem);
    max-width: 62ch;
  }
  .privacy-body h2 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.1rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin: 2.5rem 0 1rem;
  }
  .privacy-body h2:first-child { margin-top: 0; }
  .privacy-body p {
    color: rgba(245, 245, 245, 0.78);
    font-size: 1rem;
    line-height: 1.75;
    margin: 0 0 1.25rem;
  }
  .privacy-updated {
    margin-top: 2.5rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
</style>
