---
/**
 * WorkWithAndrew — the restrained conversion path. Three honest service
 * lines, then the newsletter signup. No inquiry form: press, media, and
 * contact inquiries go through /press.
 */
import SectionHeader from './SectionHeader.astro';
import NewsletterSignup from './NewsletterSignup.astro';

const SERVICES = [
  {
    title: 'Photography',
    desc: 'Hospitality and commercial photography. Bars, restaurants, product, process.',
  },
  {
    title: 'Creative production',
    desc: 'Video, editing, and color. Built for the way small brands actually ship.',
  },
  {
    title: 'Digital & creative systems',
    desc: 'Automation and workflow infrastructure for one-person operations.',
  },
];
---

<section id="work" aria-labelledby="work-heading" class="work-section">
  <div class="container">
    <SectionHeader
      id="work-heading"
      index="08"
      kicker="Work with Andrew"
      title="What I do"
      lede="Three lanes, one operator. For press, media, or project inquiries, head to the press kit."
    />
    <ul class="work-list">
      {SERVICES.map((s, i) => (
        <li class="work-item reveal" style={`--rd: ${i * 70}ms`}>
          <h3 class="work-title">{s.title}</h3>
          <p class="work-desc">{s.desc}</p>
        </li>
      ))}
    </ul>
    <div class="reveal" style="--rd: 210ms">
      <NewsletterSignup />
      <p class="press-link">
        Press, media, or project inquiry? <a href="/press">Visit the press kit</a>.
      </p>
    </div>
  </div>
</section>

<style>
  .work-section {
    padding: clamp(4rem, 8vw, 7rem) 0;
    border-top: 1px solid var(--line);
  }
  .work-list {
    list-style: none;
    margin: 0 0 clamp(2rem, 4vw, 3rem);
    padding: 0;
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 760px) {
    .work-list { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  .work-item {
    border: 1px solid var(--line);
    background: var(--surface);
    padding: 1.5rem;
  }
  .work-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.1rem;
    margin: 0 0 0.6rem;
    letter-spacing: 0.02em;
  }
  .work-desc {
    margin: 0;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.6;
  }
  .press-link {
    margin: 1.5rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .press-link a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
