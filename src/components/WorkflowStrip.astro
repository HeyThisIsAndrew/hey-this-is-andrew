---
import { WORKFLOW_STEPS as steps } from '../data/workflow';
---
<div class="workflow">
  <p class="kicker">Current workflow</p>
  <ol>
    {steps.map((s, i) => (
      <li>
        <span class="step-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
        <span class="step-stage">{s.stage}</span>
        <span class="step-detail">{s.detail}</span>
      </li>
    ))}
  </ol>
</div>

<style>
  .workflow {
    margin-top: 2.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    padding: 1.5rem;
  }
  .workflow .kicker { margin-bottom: 1.25rem; }
  .workflow ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
    gap: 1.5rem;
  }
  .workflow li {
    display: grid;
    gap: 0.25rem;
    border-left: 2px solid var(--key-dim);
    padding-left: 1rem;
  }
  .step-num {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
  }
  .step-stage {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 1.2rem;
  }
  .step-detail {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--muted);
  }
</style>
