---
import { getLatestArticles, fmtDate, SUBSTACK_URL } from '../lib/latest-content';
import SectionHeader from './SectionHeader.astro';
import NewsletterSignup from './NewsletterSignup.astro';

const articles = await getLatestArticles(3);

function estimateReadTime(text?: string, index = 0): string {
  if (!text) return `${3 + (index % 3)} min read`;
  const len = text.length;
  const minutes = Math.max(3, Math.min(6, Math.floor(len / 40) + 3));
  return `${minutes} min read`;
}
---
<section id="writing" aria-labelledby="writing-heading" class="writing-section">
  <div class="container">
    <div class="writing-head">
      <SectionHeader id="writing-heading" index="04" kicker="Writing" title="Notes from the build" lede="Longer thoughts on building in public, from the Substack." />
      <a class="btn btn-ghost writing-cta" href={SUBSTACK_URL} target="_blank" rel="noopener">
        Read everything on Substack
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M2 12L12 2M12 2H5M12 2v7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>

    <div class="article-grid">
      {articles.map((a, i) => (
        <a class="article-card reveal" style={`--rd: ${i * 70}ms`} href={a.url} target="_blank" rel="noopener">
          {a.image && (
            <span class="article-img" aria-hidden="true">
              <img src={a.image} alt="" loading="lazy" decoding="async" />
            </span>
          )}
          <span class="article-body">
            <span class="article-meta">
              <span class="article-source">Substack</span>
              <span class="article-dot" aria-hidden="true">·</span>
              <span class="article-read-time">{estimateReadTime(a.subtitle || a.title, i)}</span>
              <span class="article-dot" aria-hidden="true">·</span>
              <time>{fmtDate(new Date(a.date))}</time>
            </span>
            <span class="article-title">{a.title}</span>
            {a.subtitle && <span class="article-sub">{a.subtitle}</span>}
            <span class="article-more">Read the article
              <svg width="12" height="12" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M2 12L12 2M12 2H5M12 2v7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </span>
        </a>
      ))}
    </div>
    <NewsletterSignup />
  </div>
</section>

<style>
  .writing-section {
    padding: clamp(4rem, 8vw, 7rem) 0;
    border-top: 1px solid var(--line);
  }
  .writing-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-bottom: clamp(1.75rem, 4vw, 3rem);
  }
  .writing-head .sec-head { margin-bottom: 0; }
  .writing-cta { flex: none; }
  .article-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }
  @media (max-width: 900px) {
    .article-grid { grid-template-columns: 1fr; }
  }
  /* Monochrome cards, square edges. */
  .article-card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 0;
    text-decoration: none;
    color: var(--ink);
    overflow: hidden;
    transition: border-color 0.3s ease, transform 0.3s ease;
  }
  .article-card:hover, .article-card:focus-visible {
    border-color: rgba(255, 255, 255, 0.35);
    transform: translateY(-4px);
  }
  .article-img {
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #0d0d0d;
  }
  .article-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%) contrast(1.05);
    transition: transform 0.5s ease, filter 0.5s ease;
  }
  .article-card:hover .article-img img {
    transform: scale(1.04);
    filter: grayscale(20%) contrast(1.05);
  }
  .article-body {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    padding: 1.35rem 1.35rem 1.5rem;
  }
  .article-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .article-source { color: var(--ink); }
  .article-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.25rem;
    line-height: 1.25;
    text-wrap: balance;
  }
  .article-sub {
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .article-more {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 0.35rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .article-more svg { transition: transform 0.3s ease; }
  .article-card:hover .article-more svg { transform: translate(2px, -2px); }
  @media (prefers-reduced-motion: reduce) {
    .article-card, .article-img img, .article-more svg { transition: none; }
  }
</style>
