---
/**
 * NowBand — a restrained CURRENTLY readout. Small editorial band, not a
 * section. Values come from src/data/now.ts and are updated by hand;
 * nothing here is fabricated or "live"-faked.
 */
import { NOW_MONTH, NOW_ITEMS } from '../data/now';
---

<div class="now-band" role="region" aria-label="What Andrew is working on now">
  <div class="container now-inner">
    <p class="now-eyebrow"><span class="now-dot" aria-hidden="true"></span>Now <span class="now-month">{NOW_MONTH}</span></p>
    <dl class="now-list">
      {NOW_ITEMS.map((item) => (
        <div class="now-item">
          <dt>{item.label}</dt>
          <dd>{item.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</div>

<style>
  .now-band {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: var(--surface);
    padding: 1.75rem 0;
  }
  .now-inner {
    display: grid;
    gap: 1.25rem;
  }
  .now-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .now-dot {
    width: 8px;
    height: 8px;
    background: var(--ink);
    flex: none;
  }
  .now-month { color: var(--muted); }
  .now-list {
    display: grid;
    gap: 0.9rem 2rem;
    margin: 0;
    padding: 0;
  }
  @media (min-width: 760px) {
    .now-list { grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); }
  }
  .now-item dt {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 0.3rem;
  }
  .now-item dd {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--ink);
  }
</style>
