  /* ---- Spatial zoom ---- */
  /* The active panel is clickable to trigger the camera movement into the
     fullscreen view (the expand icon was removed). No magnifying-glass
     cursor: the interaction is the site's camera navigation, not a generic
     zoom. Links and buttons inside keep their pointer cursor. */
  .accordion-panel.active a,
  .accordion-panel.active button {
    cursor: pointer;
  }

  /* Fullscreen Brand Environment (Doorway Camera Destination) */
  .brand-fullscreen-env {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100dvh;
    z-index: 1000;
    background: #080808;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
    clip-path: inset(0px 0px 0px 0px);
    will-change: clip-path, opacity;
  }
  .brand-fullscreen-env.is-active {
    opacity: 1;
    pointer-events: auto;
