<script>
  class BrandAccordion {
    private section: HTMLElement;
    private panels: NodeListOf<HTMLElement>;
    private triggers: NodeListOf<HTMLButtonElement>;
    private announcer: HTMLElement | null;
    private playPauseBtn: HTMLButtonElement | null;
    public activeIndex: number = 0;
    private duration: number = 7000;
    private timer: number | null = null;
    private startTime: number = 0;
    private remainingTime: number = 0;
    private isPaused: boolean = false;
    private manualOverride: boolean = false;
    private hasStarted: boolean = false;

    constructor(el: HTMLElement) {
      this.section = el;
      this.panels = this.section.querySelectorAll('.accordion-panel');
      this.triggers = this.section.querySelectorAll('.acc-trigger');
      this.announcer = document.getElementById('accordion-announcer');
      this.playPauseBtn = this.section.querySelector('.accordion-play-pause');

      if (!this.panels.length) return;

      this.init();
    }

    init() {
      // Direct click on column triggers to switch active brand (STEP 1)
      this.triggers.forEach((trigger, i) => {
        trigger.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          if (this.activeIndex !== i) {
            this.manualOverride = true;
            this.goToPanel(i, true);
          }
        });
      });

      // Allow clicking anywhere on a collapsed inactive panel to activate it
      this.panels.forEach((panel, i) => {
        panel.addEventListener('click', (e) => {
          if (this.activeIndex !== i) {
            const target = e.target as HTMLElement;
            if (!target.closest('a, button')) {
              e.preventDefault();
              e.stopPropagation();
              this.manualOverride = true;
              this.goToPanel(i, true);
            }
          }
        });
      });

      // Check for reduced motion or mobile to disable auto-rotation
      const isMobile = window.innerWidth <= 768;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || isMobile) {
        this.manualOverride = true;
        this.updatePlayPauseIcon();
      }

      // Play/Pause Click
      if (this.playPauseBtn) {
        this.playPauseBtn.addEventListener('click', () => {
          this.manualOverride = !this.manualOverride;
          if (this.manualOverride) {
            this.pause();
          } else {
            this.resume();
          }
          this.updatePlayPauseIcon();
        });
      }

      // Auto-pause on hover/focus/touch (for the whole section)
      this.section.addEventListener('mouseenter', () => this.pause());
      this.section.addEventListener('mouseleave', () => {
        if (!this.manualOverride) this.resume();
      });
      this.section.addEventListener('focusin', () => this.pause());
      this.section.addEventListener('focusout', () => {
        setTimeout(() => {
          if (!this.section.contains(document.activeElement) && !this.manualOverride) {
            this.resume();
          }
        }, 10);
      });
      this.section.addEventListener('touchstart', () => this.pause(), { passive: true });

      // Keyboard support
      this.section.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
          e.preventDefault();
          this.manualOverride = true;
          this.goToPanel((this.activeIndex + 1) % this.panels.length);
        } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
          e.preventDefault();
          this.manualOverride = true;
          this.goToPanel((this.activeIndex - 1 + this.panels.length) % this.panels.length);
        } else if (e.key === 'Home') {
          e.preventDefault();
          this.manualOverride = true;
          this.goToPanel(0);
        } else if (e.key === 'End') {
          e.preventDefault();
          this.manualOverride = true;
          this.goToPanel(this.panels.length - 1);
        }
      });

      // Intersection Observer to start 3s beat when scrolled into view
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting && !this.hasStarted && !this.manualOverride) {
            this.hasStarted = true;
            setTimeout(() => {
              if (!this.manualOverride) {
                this.startTime = performance.now();
                this.remainingTime = this.duration;
                this.kick();
              }
            }, 3000); // 3s beat
            observer.disconnect();
          }
        });
      }, { threshold: 0.5 });

      observer.observe(this.section);

      // Force initial active styles correctly on fill
      this.updateProgressFill();
    }

    goToPanel(index: number, isManual = false) {
      if (index === this.activeIndex) return;

      const prevIndex = this.activeIndex;
      const direction = index > prevIndex ? 'left-to-right' : 'right-to-left';

      const prevFill = this.panels[this.activeIndex].querySelector('.progress-fill') as HTMLElement;
      if (prevFill) prevFill.style.width = '0%';

      const prevPanel = this.panels[this.activeIndex];
      prevPanel.classList.remove('active');
      prevPanel.dataset.direction = direction;
      this.triggers[this.activeIndex].setAttribute('aria-expanded', 'false');

      this.activeIndex = index;

      const newPanel = this.panels[this.activeIndex];
      newPanel.dataset.direction = direction;
      newPanel.classList.add('active');
      this.triggers[this.activeIndex].setAttribute('aria-expanded', 'true');
      this.section.dataset.direction = direction;

      if (this.announcer) {
        const title = newPanel.querySelector('.headline')?.textContent || '';
        this.announcer.textContent = `Panel ${index + 1} of ${this.panels.length}: ${title}`;
      }

      this.startTime = performance.now();
      this.remainingTime = this.duration;
      this.updateProgressFill();
      this.kick();
    }

    pause() {
      this.isPaused = true;
    }

    freezeForZoom() {
      this.manualOverride = true;
      this.isPaused = true;
      if (this.timer !== null) {
        cancelAnimationFrame(this.timer);
        this.timer = null;
      }
      this.updatePlayPauseIcon();
    }

    resume() {
      if (this.manualOverride) return;
      this.isPaused = false;
      this.kick();
    }

    resumeFromZoom() {
      this.manualOverride = false;
      this.isPaused = false;
      this.startTime = performance.now();
      this.kick();
      this.updatePlayPauseIcon();
    }

    kick() {
      if (this.timer !== null) return;
      if (this.isPaused || this.manualOverride) return;
      this.startTime = performance.now();
      this.timer = requestAnimationFrame(this.tick);
    }

    updatePlayPauseIcon() {
      if (!this.playPauseBtn) return;
      const iconPlay = this.playPauseBtn.querySelector('.icon-play') as HTMLElement;
      const iconPause = this.playPauseBtn.querySelector('.icon-pause') as HTMLElement;

      if (this.manualOverride) {
        iconPlay.style.display = 'block';
        iconPause.style.display = 'none';
        this.playPauseBtn.setAttribute('aria-pressed', 'true');
        this.playPauseBtn.setAttribute('aria-label', 'Play auto-rotation');
      } else {
        iconPlay.style.display = 'none';
        iconPause.style.display = 'block';
        this.playPauseBtn.setAttribute('aria-pressed', 'false');
        this.playPauseBtn.setAttribute('aria-label', 'Pause auto-rotation');
      }
    }

    updateProgressFill() {
      if (this.manualOverride) {
        const activeFill = this.panels[this.activeIndex].querySelector('.progress-fill') as HTMLElement;
        if (activeFill) activeFill.style.width = '0%';
        return;
      }

      const progress = 1 - (this.remainingTime / this.duration);
      const activeFill = this.panels[this.activeIndex].querySelector('.progress-fill') as HTMLElement;
      if (activeFill) {
        activeFill.style.width = `${progress * 100}%`;
      }
    }

    tick = () => {
      if (!this.isPaused && !this.manualOverride) {
        const now = performance.now();
        const elapsed = now - this.startTime;
        this.remainingTime -= elapsed;
        this.startTime = now;

        if (this.remainingTime <= 0) {
          this.goToPanel((this.activeIndex + 1) % this.panels.length);
        } else {
          this.updateProgressFill();
        }
        this.timer = requestAnimationFrame(this.tick);
      } else {
        this.timer = null;
        this.startTime = performance.now();
      }
    }
  }

  class BrandCameraController {
    private viewport: HTMLElement;
    private stage: HTMLElement;
    private accordion: BrandAccordion;
    private panels: HTMLElement[];
    private closeBtn: HTMLButtonElement | null;
    public isZoomed: boolean = false;
    private isClosing: boolean = false;
    private activePanel: HTMLElement | null = null;
    private initialStageLeft: number = 0;
    private initialStageTop: number = 0;

    constructor(viewport: HTMLElement, stage: HTMLElement, accordion: BrandAccordion, panels: HTMLElement[]) {
      this.viewport = viewport;
      this.stage = stage;
      this.accordion = accordion;
      this.panels = panels;
      this.closeBtn = viewport.querySelector<HTMLButtonElement>('.brand-camera-close-btn');

      this.init();
    }

    init() {
      this.panels.forEach((p, i) => {
        p.addEventListener('click', (e) => {
          if (window.innerWidth <= 768) return; // Allow direct link/button interactions in mobile stack

          const targetEl = e.target as HTMLElement;

          // Utility buttons (play/pause, close) handle their own actions
          if (targetEl.closest('.accordion-play-pause, .brand-camera-close-btn')) return;

          const isCurrentActive = p.classList.contains('active') && this.accordion.activeIndex === i;

          // STEP 1: Click collapsed column -> expand column only (NO zoom)
          if (!isCurrentActive) {
            e.preventDefault();
            e.stopPropagation();
            this.accordion.goToPanel(i, true);
            return;
          }

          // STEP 3: Already zoomed in -> clicking external link links out to brand
          if (this.isZoomed) {
            if (targetEl.closest('a')) {
              return; // Allow native link out to associated brand
            }
            // Clicking outside links closes zoom
            e.preventDefault();
            this.close();
            return;
          }

          // STEP 2: Panel is expanded -> clicking image, card, or link launches brand zoom
          e.preventDefault();
          e.stopPropagation();
          this.open(p);
        });
      });

      if (this.closeBtn) {
        this.closeBtn.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          this.close();
        });
      }

      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && this.isZoomed) {
          e.preventDefault();
          this.close();
        }
      });

      window.addEventListener('popstate', () => {
        if (this.isZoomed) {
          this.close();
        }
      });

      window.addEventListener('resize', () => {
        if (this.isZoomed && this.activePanel) {
          this.recalculate();
        }
      });
    }

    open(panel: HTMLElement) {
      if (this.isZoomed || this.isClosing) return;
      this.isZoomed = true;
      this.activePanel = panel;
      this.accordion.freezeForZoom();

      // 1. Measure initial geometry
      const targetRect = panel.getBoundingClientRect();
      const stageRect = this.stage.getBoundingClientRect();
      const vpWidth = window.innerWidth;
      const vpHeight = window.innerHeight;

      this.initialStageLeft = stageRect.left;
      this.initialStageTop = stageRect.top;

      // 2. Dynamic scale calculation:
      // Full-bleed cover scale: ensures active 16:9 panel and background image fill 100% of the screen
      // with zero black bars above or below on any screen ratio
      const scaleX = vpWidth / targetRect.width;
      const scaleY = vpHeight / targetRect.height;
      const scale = Math.max(scaleX, scaleY);

      // Safe viewport padding compensation:
      // When scaled panel overflows viewport bounds horizontally or vertically,
      // compensate content-inner and kicker insets so typography, buttons, and metadata remain 100% visible
      const overflowX = Math.max(0, (targetRect.width * scale - vpWidth) / 2);
      const overflowY = Math.max(0, (targetRect.height * scale - vpHeight) / 2);
      panel.style.setProperty('--zoom-overflow-x', `${overflowX / scale}px`);
      panel.style.setProperty('--zoom-overflow-y', `${overflowY / scale}px`);

      // 3. Target and viewport centers
      const targetCenterX = targetRect.left + targetRect.width / 2;
      const targetCenterY = targetRect.top + targetRect.height / 2;
      const viewportCenterX = vpWidth / 2;
      const viewportCenterY = vpHeight / 2;

      // 4. Target center coordinates relative to stage (transform-origin 0 0)
      const targetCX_stage = targetCenterX - stageRect.left;
      const targetCY_stage = targetCenterY - stageRect.top;

      // 5. Final camera translation so target center lands at viewport center
      const tx = viewportCenterX - scale * targetCX_stage;
      const ty = viewportCenterY - scale * targetCY_stage;

      // 6. Enter zoomed viewport mode without jumping or scrollbar shift
      const scrollbarWidth = window.innerWidth - document.documentElement.clientWidth;
      if (scrollbarWidth > 0) {
        document.body.style.paddingRight = `${scrollbarWidth}px`;
      }
      this.viewport.classList.remove('is-closing');
      this.viewport.classList.add('is-zoomed');
      document.body.style.overflow = 'hidden';

      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduced) {
        this.stage.style.transition = 'none';
        this.stage.style.transform = `translate3d(${tx}px, ${ty}px, 0) scale(${scale})`;
        return;
      }

      this.stage.style.transition = 'none';
      this.stage.style.transform = `translate3d(${this.initialStageLeft}px, ${this.initialStageTop}px, 0) scale(1)`;

      void this.stage.offsetWidth;

      // 7. Transition camera stage to calculated destination
      this.stage.style.transition = 'transform 700ms cubic-bezier(0.25, 1, 0.5, 1)';
      this.stage.style.transform = `translate3d(${tx}px, ${ty}px, 0) scale(${scale})`;
    }

    private recalculate() {
      if (!this.activePanel) return;
      const targetRect = this.activePanel.getBoundingClientRect();
      const stageRect = this.stage.getBoundingClientRect();
      const vpWidth = window.innerWidth;
      const vpHeight = window.innerHeight;

      const scaleX = vpWidth / targetRect.width;
      const scaleY = vpHeight / targetRect.height;
      const scale = Math.max(scaleX, scaleY);

      const overflowX = Math.max(0, (targetRect.width * scale - vpWidth) / 2);
      const overflowY = Math.max(0, (targetRect.height * scale - vpHeight) / 2);
      this.activePanel.style.setProperty('--zoom-overflow-x', `${overflowX / scale}px`);
      this.activePanel.style.setProperty('--zoom-overflow-y', `${overflowY / scale}px`);

      const targetCenterX = targetRect.left + targetRect.width / 2;
      const targetCenterY = targetRect.top + targetRect.height / 2;
      const viewportCenterX = vpWidth / 2;
      const viewportCenterY = vpHeight / 2;

      const targetCX_stage = targetCenterX - stageRect.left;
      const targetCY_stage = targetCenterY - stageRect.top;

      const tx = viewportCenterX - scale * targetCX_stage;
      const ty = viewportCenterY - scale * targetCY_stage;

      this.stage.style.transition = 'none';
      this.stage.style.transform = `translate3d(${tx}px, ${ty}px, 0) scale(${scale})`;
    }

    close() {
      if (!this.isZoomed || this.isClosing) return;
      this.isClosing = true;
      // Start reverse fade and layout return immediately at start of dolly
      this.viewport.classList.add('is-closing');

      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduced) {
        this.cleanup();
        return;
      }

      // Reverse exact camera movement back to resting position
      this.stage.style.transition = 'transform 700ms cubic-bezier(0.25, 1, 0.5, 1)';
      this.stage.style.transform = `translate3d(${this.initialStageLeft}px, ${this.initialStageTop}px, 0) scale(1)`;

      const onEnd = (e: TransitionEvent) => {
        if (e.target !== this.stage || e.propertyName !== 'transform') return;
        this.stage.removeEventListener('transitionend', onEnd);
        this.cleanup();
      };

      this.stage.addEventListener('transitionend', onEnd);

      setTimeout(() => {
        if (this.isClosing) {
          this.stage.removeEventListener('transitionend', onEnd);
          this.cleanup();
        }
      }, 750);
    }

    private cleanup() {
      if (this.activePanel) {
        this.activePanel.style.removeProperty('--zoom-overflow-x');
        this.activePanel.style.removeProperty('--zoom-overflow-y');
      }
      this.stage.style.transition = 'none';
      this.stage.style.transform = 'translate3d(0, 0, 0) scale(1)';
      this.viewport.classList.remove('is-zoomed', 'is-closing');
      document.body.style.overflow = '';
      document.body.style.paddingRight = '';
      this.isZoomed = false;
      this.isClosing = false;
      this.activePanel = null;
      this.accordion.resumeFromZoom();
    }
  }

  const initAccordion = () => {
    const hero = document.querySelector('.accordion-hero') as HTMLElement;
    const viewport = document.getElementById('brand-camera-viewport') as HTMLElement;
    const stage = document.getElementById('brand-camera-stage') as HTMLElement;
    if (!hero || !viewport || !stage) return;
    const accordion = new BrandAccordion(hero);
    const panels = Array.from(hero.querySelectorAll<HTMLElement>('.accordion-panel'));
    new BrandCameraController(viewport, stage, accordion, panels);

    // Direct brand selection from navbar dropdown or hash
    const selectBrandById = (brandId: string) => {
      const idx = panels.findIndex((p) => p.dataset.brandId === brandId || p.id === `brand-${brandId}`);
      if (idx >= 0) {
        accordion.goToPanel(idx);
      }
    };

    document.addEventListener('click', (e) => {
      const link = (e.target as Element | null)?.closest('a[href*="#brand-"]');
      if (!link) return;
      const href = link.getAttribute('href') || '';
      const match = href.match(/#brand-([a-z0-9-]+)/);
      if (match && match[1]) {
        selectBrandById(match[1]);
      }
    });

    const checkHash = () => {
      const hash = window.location.hash;
      if (hash && hash.startsWith('#brand-')) {
        selectBrandById(hash.replace('#brand-', ''));
      }
    };
    window.addEventListener('hashchange', checkHash);
    setTimeout(checkHash, 150);
  };

  initAccordion();
</script>
