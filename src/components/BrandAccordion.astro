</style>

<script>
  class BrandAccordion {
    private section: HTMLElement;
    private panels: NodeListOf<HTMLElement>;
    private triggers: NodeListOf<HTMLButtonElement>;
    private announcer: HTMLElement | null;
    private playPauseBtn: HTMLButtonElement | null;
    public activeIndex: number = 0;
    private duration: number = 7000;
    private timer: number | null = null;
    private startTime: number = 0;
    private remainingTime: number = 0;
    private isPaused: boolean = false;
    private manualOverride: boolean = false;
    private hasStarted: boolean = false;

    constructor(el: HTMLElement) {
      this.section = el;
      this.panels = this.section.querySelectorAll('.accordion-panel');
      this.triggers = this.section.querySelectorAll('.acc-trigger');
      this.announcer = document.getElementById('accordion-announcer');
      this.playPauseBtn = this.section.querySelector('.accordion-play-pause');

      if (!this.panels.length) return;

      this.init();
    }

    init() {
      // Check for reduced motion or mobile to disable auto-rotation
      const isMobile = window.innerWidth <= 767;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || isMobile) {
        this.manualOverride = true;
        this.updatePlayPauseIcon();
      }

      // Play/Pause Click
      if (this.playPauseBtn) {
        this.playPauseBtn.addEventListener('click', () => {
          this.manualOverride = !this.manualOverride;
          if (this.manualOverride) {
            this.pause();
          } else {
            this.resume();
          }
          this.updatePlayPauseIcon();
        });
      }

      // Auto-pause on hover/focus/touch (for the whole section)
      this.section.addEventListener('mouseenter', () => this.pause());
      this.section.addEventListener('mouseleave', () => {
        if (!this.manualOverride) this.resume();
      });
      this.section.addEventListener('focusin', () => this.pause());
      this.section.addEventListener('focusout', () => {
        setTimeout(() => {
          if (!this.section.contains(document.activeElement) && !this.manualOverride) {
            this.resume();
          }
        }, 10);
      });
      this.section.addEventListener('touchstart', () => this.pause(), { passive: true });

      // Keyboard support
      this.section.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
          e.preventDefault();
          this.manualOverride = true;
          this.goToPanel((this.activeIndex + 1) % this.panels.length);
        } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
          e.preventDefault();
          this.manualOverride = true;
          this.goToPanel((this.activeIndex - 1 + this.panels.length) % this.panels.length);
        } else if (e.key === 'Home') {
          e.preventDefault();
          this.manualOverride = true;
          this.goToPanel(0);
        } else if (e.key === 'End') {
          e.preventDefault();
          this.manualOverride = true;
          this.goToPanel(this.panels.length - 1);
        }
      });

      // Intersection Observer to start 3s beat when scrolled into view
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting && !this.hasStarted && !this.manualOverride) {
            this.hasStarted = true;
            setTimeout(() => {
              if (!this.manualOverride) {
                this.startTime = performance.now();
                this.remainingTime = this.duration;
                this.kick();
              }
            }, 3000); // 3s beat
            observer.disconnect();
          }
        });
      }, { threshold: 0.5 });

      observer.observe(this.section);

      // Force initial active styles correctly on fill
      this.updateProgressFill();
    }

    goToPanel(index: number) {
      if (index === this.activeIndex) return;

      const prevFill = this.panels[this.activeIndex].querySelector('.progress-fill') as HTMLElement;
      if (prevFill) prevFill.style.width = '0%';

      this.panels[this.activeIndex].classList.remove('active');
      this.triggers[this.activeIndex].setAttribute('aria-expanded', 'false');

      this.activeIndex = index;

      const newPanel = this.panels[this.activeIndex];
      newPanel.classList.add('active');
      this.triggers[this.activeIndex].setAttribute('aria-expanded', 'true');

      if (this.announcer) {
        const title = newPanel.querySelector('.headline')?.textContent || '';
        this.announcer.textContent = `Panel ${index + 1} of ${this.panels.length}: ${title}`;
      }

      this.startTime = performance.now();
      this.remainingTime = this.duration;
      this.updateProgressFill();
      this.kick();
    }

    pause() {
      this.isPaused = true;
    }

    freezeForZoom() {
      this.manualOverride = true;
      this.isPaused = true;
      if (this.timer !== null) {
        cancelAnimationFrame(this.timer);
        this.timer = null;
      }
      this.updatePlayPauseIcon();
    }

    resume() {
      if (this.manualOverride) return;
      this.isPaused = false;
      this.kick();
    }

    resumeFromZoom() {
      this.manualOverride = false;
      this.isPaused = false;
      this.startTime = performance.now();
      this.kick();
      this.updatePlayPauseIcon();
    }

    kick() {
      if (this.timer !== null) return;
      if (this.isPaused || this.manualOverride) return;
      this.startTime = performance.now();
      this.timer = requestAnimationFrame(this.tick);
    }

    updatePlayPauseIcon() {
      if (!this.playPauseBtn) return;
      const iconPlay = this.playPauseBtn.querySelector('.icon-play') as HTMLElement;
      const iconPause = this.playPauseBtn.querySelector('.icon-pause') as HTMLElement;

      if (this.manualOverride) {
        iconPlay.style.display = 'block';
        iconPause.style.display = 'none';
        this.playPauseBtn.setAttribute('aria-pressed', 'true');
        this.playPauseBtn.setAttribute('aria-label', 'Play auto-rotation');
      } else {
        iconPlay.style.display = 'none';
        iconPause.style.display = 'block';
        this.playPauseBtn.setAttribute('aria-pressed', 'false');
        this.playPauseBtn.setAttribute('aria-label', 'Pause auto-rotation');
      }
    }

    updateProgressFill() {
      if (this.manualOverride) {
        const activeFill = this.panels[this.activeIndex].querySelector('.progress-fill') as HTMLElement;
        if (activeFill) activeFill.style.width = '0%';
        return;
      }

      const progress = 1 - (this.remainingTime / this.duration);
      const activeFill = this.panels[this.activeIndex].querySelector('.progress-fill') as HTMLElement;
      if (activeFill) {
        activeFill.style.width = `${progress * 100}%`;
      }
    }

    tick = () => {
      if (!this.isPaused && !this.manualOverride) {
        const now = performance.now();
        const elapsed = now - this.startTime;
        this.remainingTime -= elapsed;
        this.startTime = now;

        if (this.remainingTime <= 0) {
          this.goToPanel((this.activeIndex + 1) % this.panels.length);
        } else {
          this.updateProgressFill();
        }
        this.timer = requestAnimationFrame(this.tick);
      } else {
        this.timer = null;
        this.startTime = performance.now();
      }
    }
  }

  /**
   * BrandDoorwayCamera
   * State Machine: IDLE -> OPENING -> OPEN -> CLOSING -> IDLE
   * When the active brand panel is clicked:
   * 1. Measures panel's screen rectangle (the doorway).
   * 2. Sets initial clip-path to that exact rectangle.
   * 3. Animates clip-path outward to 100vw x 100dvh (inset 0 0 0 0).
   * 4. Completely covers the site in the selected brand's fullscreen environment.
   * 5. Escape or clicking background reverses the doorway back into the panel.
   */
  class BrandDoorwayCamera {
    private env: HTMLElement;
    private brandViews: NodeListOf<HTMLElement>;
    private accordion: BrandAccordion;
    private panels: HTMLElement[];
    private state: 'IDLE' | 'OPENING' | 'OPEN' | 'CLOSING' = 'IDLE';
    private activePanel: HTMLElement | null = null;
    private closeButtons: NodeListOf<HTMLButtonElement>;

    constructor(env: HTMLElement, accordion: BrandAccordion, panels: HTMLElement[]) {
      this.env = env;
      this.accordion = accordion;
      this.panels = panels;
      this.brandViews = env.querySelectorAll('.env-brand-view');
      this.closeButtons = env.querySelectorAll('.env-close-btn');

      this.init();
    }

    init() {
      // Panel Click Handling
      this.panels.forEach((p, i) => {
        p.addEventListener('click', (e) => {
          // If clicked a link or inquiry button, let it follow naturally
          const link = (e.target as HTMLElement).closest('a, button.inquiry-link');
          if (link) return;

          // If panel is NOT active yet: select that brand in accordion (do NOT launch camera)
          if (!p.classList.contains('active')) {
            this.accordion.goToPanel(i);
            return;
          }

          // If panel IS already active: launch the fullscreen doorway camera!
          e.preventDefault();
          this.open(p, i);
        });
      });

      // Close buttons
      this.closeButtons.forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          this.close();
        });
      });

      // Background click in fullscreen environment (outside content inner) closes
      this.env.addEventListener('click', (e) => {
        if (this.state !== 'OPEN') return;
        const target = e.target as HTMLElement;
        // If clicking CTA button or link, do not close!
        if (target.closest('a, button, .env-content-inner')) return;
        this.close();
      });

      // Escape key closes
      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && (this.state === 'OPEN' || this.state === 'OPENING')) {
          e.preventDefault();
          this.close();
        }
      });

      // Browser back/forward closes
      window.addEventListener('popstate', () => {
        if (this.state === 'OPEN' || this.state === 'OPENING') {
          this.close();
        }
      });
    }

    open(panel: HTMLElement, index: number) {
      if (this.state !== 'IDLE') return;
      this.state = 'OPENING';
      this.activePanel = panel;
      this.accordion.freezeForZoom();

      // 1. Measure active panel's viewport rectangle
      const rect = panel.getBoundingClientRect();
      const top = Math.max(0, rect.top);
      const left = Math.max(0, rect.left);
      const right = Math.max(0, window.innerWidth - rect.right);
      const bottom = Math.max(0, window.innerHeight - rect.bottom);

      // 2. Activate matching brand view in fullscreen environment
      this.brandViews.forEach((v, i) => {
        if (i === index) {
          v.classList.add('is-visible');
        } else {
          v.classList.remove('is-visible');
        }
      });

      // 3. Set initial clipping rectangle to exactly the active panel's doorway
      this.env.style.transition = 'none';
      this.env.style.clipPath = `inset(${top}px ${right}px ${bottom}px ${left}px)`;
      this.env.classList.add('is-active');
      this.env.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';

      // 4. Force reflow, then animate clipping rectangle outward until it covers entire viewport
      this.env.getBoundingClientRect();

      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduced) {
        this.env.style.clipPath = 'inset(0px 0px 0px 0px)';
        this.state = 'OPEN';
        return;
      }

      this.env.style.transition = 'clip-path 0.55s cubic-bezier(0.16, 1, 0.3, 1)';
      this.env.style.clipPath = 'inset(0px 0px 0px 0px)';

      setTimeout(() => {
        if (this.state === 'OPENING') {
          this.state = 'OPEN';
        }
      }, 560);
    }

    close() {
      if (this.state !== 'OPEN' && this.state !== 'OPENING') return;
      this.state = 'CLOSING';

      // Measure current panel rectangle
      const rect = this.activePanel ? this.activePanel.getBoundingClientRect() : null;
      const top = rect ? Math.max(0, rect.top) : window.innerHeight / 2;
      const left = rect ? Math.max(0, rect.left) : window.innerWidth / 2;
      const right = rect ? Math.max(0, window.innerWidth - rect.right) : window.innerWidth / 2;
      const bottom = rect ? Math.max(0, window.innerHeight - rect.bottom) : window.innerHeight / 2;

      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduced) {
        this.cleanup();
        return;
      }

      this.env.style.transition = 'clip-path 0.45s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.45s ease';
      this.env.style.clipPath = `inset(${top}px ${right}px ${bottom}px ${left}px)`;

      setTimeout(() => {
        this.cleanup();
      }, 460);
    }

    private cleanup() {
      this.env.classList.remove('is-active');
      this.env.setAttribute('aria-hidden', 'true');
      this.env.style.clipPath = 'inset(0px 0px 0px 0px)';
      this.env.style.transition = 'none';
      document.body.style.overflow = '';
      this.brandViews.forEach((v) => v.classList.remove('is-visible'));
      this.state = 'IDLE';
      this.activePanel = null;
      this.accordion.resumeFromZoom();
    }
  }

  const initAccordion = () => {
    const hero = document.querySelector('.accordion-hero') as HTMLElement;
    const env = document.getElementById('brand-fullscreen-env') as HTMLElement;
    if (!hero) return;
    const accordion = new BrandAccordion(hero);
    const panels = Array.from(hero.querySelectorAll<HTMLElement>('.accordion-panel'));
    if (env) {
      new BrandDoorwayCamera(env, accordion, panels);
    }
  };

  initAccordion();
</script>
