  /* ============================================================
     CAMERA

     The viewport is the camera.

     The stage is the physical page/world.

     The environment layer is the room behind the doorway.

     The image itself is NEVER the camera.
     ============================================================ */

  .brand-camera-viewport {
    position: relative;
    width: 100%;
    height: clamp(480px, 72vh, 680px);

    overflow: hidden;
    isolation: isolate;

    background: #080808;
  }

  .brand-camera-stage {
    position: absolute;
    inset: 0;

    width: 100%;
    height: 100%;

    transform-origin: center center;

    transform:
      translate3d(0, 0, 0);

    transition:
      transform 700ms cubic-bezier(
        0.22,
        0.61,
        0.36,
        1
      );

    will-change: transform;

    z-index: 1;
  }

  /*
   * Once entering begins, the old page is allowed to
   * travel completely outside the camera frame.
   */
  .brand-camera-viewport.is-entering .brand-camera-stage,
  .brand-camera-viewport.is-zoomed .brand-camera-stage {
    pointer-events: none;
  }

  /* ============================================================
     BRAND ENVIRONMENT LAYER
     ============================================================ */

  .brand-environment-layer {
    position: absolute;
    inset: 0;

    z-index: 100;

    pointer-events: none;

    overflow: hidden;
  }

  .brand-environment {
    position: absolute;

    inset: 0;

    width: 100%;
    height: 100%;

    overflow: hidden;

    background: #080808;

    /*
     * Closed state is deliberately invisible.
     *
     * The JavaScript replaces this with the exact doorway
     * rectangle of the selected panel before opening it.
     */
    clip-path: inset(50% 50% 50% 50%);

    opacity: 0;

    pointer-events: none;

    transition:
      clip-path 700ms cubic-bezier(
        0.22,
        0.61,
        0.36,
        1
      ),
      opacity 1ms linear 700ms;
  }

  .brand-environment.is-active {
    opacity: 1;

    pointer-events: auto;

    clip-path: inset(0 0 0 0);

    transition:
      clip-path 700ms cubic-bezier(
        0.22,
        0.61,
        0.36,
        1
      ),
      opacity 1ms linear;
  }

  /*
   * On exit, the doorway closes again.
   */
  .brand-environment.is-exiting {
    opacity: 1;

    pointer-events: none;

    transition:
      clip-path 700ms cubic-bezier(
        0.22,
        0.61,
        0.36,
        1
      ),
      opacity 1ms linear 700ms;
  }

  /* ============================================================
     ENVIRONMENT BACKGROUND

     This image is the destination environment.

     It is NOT the accordion image being scaled.

     It is already full viewport size and is revealed
     through the doorway.
     ============================================================ */

  .environment-background {
    position: absolute;
    inset: 0;

    width: 100%;
    height: 100%;

    overflow: hidden;

    background: #050505;
  }

  .environment-background img {
    display: block;

    width: 100%;
    height: 100%;

    object-fit: cover;

    object-position: center center;

    transform: none;

    filter:
      brightness(0.82)
      contrast(1.08);

    /*
     * No zoom.
     * No transform.
     * No scaling animation.
     *
     * The doorway reveals the already-existing environment.
     */
    transition: filter 700ms ease;
  }

  .brand-environment.is-active
    .environment-background img {
    filter:
      brightness(0.88)
      contrast(1.08);
  }

  .environment-scrim {
    position: absolute;
    inset: 0;

    z-index: 2;

    background:
      linear-gradient(
        90deg,
        rgba(0, 0, 0, 0.78) 0%,
        rgba(0, 0, 0, 0.34) 48%,
        rgba(0, 0, 0, 0.12) 100%
      ),
      linear-gradient(
        0deg,
        rgba(0, 0, 0, 0.76) 0%,
        transparent 60%
      );

    pointer-events: none;
  }

  /* ============================================================
     ENVIRONMENT CONTENT
     ============================================================ */

  .environment-content {
    position: absolute;

    inset: 0;

    z-index: 5;

    display: flex;
    flex-direction: column;

    align-items: flex-start;
    justify-content: flex-end;

    padding:
      clamp(2rem, 6vw, 6rem);

    max-width: 100%;

    opacity: 0;

    transform: translateY(24px);

    transition:
      opacity 450ms ease 280ms,
      transform 650ms cubic-bezier(
        0.22,
        0.61,
        0.36,
        1
      ) 280ms;
  }

  .brand-environment.is-active
    .environment-content {
    opacity: 1;

    transform: translateY(0);
  }

  .environment-logo {
    position: absolute;

    top: clamp(2rem, 5vw, 5rem);
    right: clamp(2rem, 5vw, 5rem);

    width: auto;
    height: clamp(64px, 8vw, 120px);

    max-width: 280px;

    object-fit: contain;

    filter:
      drop-shadow(
        0 0 22px
        rgba(255, 255, 255, 0.35)
      );
  }

