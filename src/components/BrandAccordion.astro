  .env-viewport {
    position: relative;
    width: 100%;
    height: 100%;
  }
  .env-brand-view {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: none;
  }
  .env-brand-view.is-visible {
    display: block;
