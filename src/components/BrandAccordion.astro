---
/**
 * BrandAccordion: the brands section (#directory).
 *
 * Mechanics mirror the hero accordion on beunconventionalhq.com (HQ's
 * src/components/home/HeroAccordion.astro), per the Section 1.3 contract:
 *
 *  - Desktop: a flex row. Collapsed strips are --acc-strip wide and show the
 *    panel's art BLURRED, a vertical label and the logo in a fixed foot box.
 *    The open panel is `flex: 1 1 0%`; panels animate flex-grow/flex-basis.
 *    Hover (fine pointers, 768px+) only PEEKS: 28px wider, art sharpens, the
 *    frame lights up. Hover never opens a panel; a click or the keyboard does.
 *  - Panel 0 is rendered open on the server (`is-open`, aria-expanded="true").
 *  - Rotation: 8s per panel on a requestAnimationFrame clock that only runs
 *    while visible and not held. Held by hover, focus inside and a touch in
 *    progress; the first manual choice stops it; the toggle restarts it. Off
 *    by default below 768px and never with prefers-reduced-motion. The open
 *    panel's progress bar shows the clock.
 *  - Keyboard: arrows move between panels (and open them), Home/End jump,
 *    Escape closes the fullscreen brand view.
 *  - Phones: the same markup stacks (no duplicated markup). The open panel
 *    moves to the top; every panel has a fixed height, so the accordion's
 *    total height never changes.
 *  - Accents: the parent site is monochrome. A panel with accent 'be-red'
 *    (BE Unconventional HQ, a BE brand context) reads the --be-* tokens:
 *    red edge, red CTA, red progress. Every value comes from custom
 *    properties set per accent class, so the component itself is unthemed.
 *  - The fullscreen "brand view" (a camera dolly into the open panel) is this
 *    site's addition to HQ's mechanics. Desktop only.
 */
import { Image } from 'astro:assets';
import { childBrands, type ChildBrand } from '../data/brands';
import SectionHeader from './SectionHeader.astro';

interface Props {
  panels?: ChildBrand[];
}

const { panels = childBrands } = Astro.props;
const OPEN_SIZES = '(max-width: 767px) calc(100vw - 32px), calc(100vw - 2 * 180px)';
---
<section id="directory" aria-labelledby="directory-heading" class="brand-accordion-section">
  <span id="brands" class="bacc-anchor" aria-hidden="true"></span>
  <div class="container lanes-intro">
    <SectionHeader id="directory-heading" index="01" kicker="The lanes" title="The brands" />
  </div>

  <div class="bacc" data-bacc data-avoid-fab style={`--acc-n: ${panels.length}`}>
    <div class="bacc-viewport" data-bacc-viewport>
      <button type="button" class="bacc-close" data-bacc-close hidden aria-label="Close brand view (Esc)">
        <span class="bacc-close-key" aria-hidden="true">Esc</span>
        <span aria-hidden="true">Close</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>

      <div class="bacc-stage" data-bacc-stage>
        <div class="bacc-track">
          {panels.map((brand, i) => {
            const open = i === 0;
            const contentId = `bacc-content-${brand.id}`;
            const triggerId = `bacc-trigger-${brand.id}`;
            const hasCta = Boolean(brand.url && brand.cta) && !brand.comingSoon;
            return (
              <article
                class:list={[
                  'bacc-panel',
                  `bacc-accent-${brand.accent}`,
                  { 'is-open': open, 'is-teaser': !brand.mediaSrc, 'is-coming-soon': brand.comingSoon },
                ]}
                id={`brand-${brand.id}`}
                data-bacc-panel
                data-brand-id={brand.id}
              >
                <div class="bacc-media" aria-hidden="true">
                  {brand.mediaSrc ? (
                    <Image
                      src={brand.mediaSrc}
                      alt=""
                      widths={[640, 960, 1280, 1920]}
                      sizes={OPEN_SIZES}
                      format="webp"
                      loading={open ? 'eager' : 'lazy'}
                      decoding="async"
                    />
                  ) : (
                    /* Teaser card: monochrome "something is brewing" art for a
                       brand with no art yet (never an empty black box). */
                    <div class="bacc-teaser">
                      <svg class="bacc-teaser-art" viewBox="0 0 240 240" fill="none" stroke="currentColor" stroke-linecap="square">
                        <path d="M112 38c-10 12 10 20 0 34M132 30c-10 14 10 24 0 40M152 40c-10 12 10 20 0 32" stroke-width="3" opacity="0.55" />
                        <path d="M70 96h120l-10 70a26 26 0 0 1-26 22h-48a26 26 0 0 1-26-22z" stroke-width="5" />
                        <path d="M190 112h10a18 18 0 0 1 0 36h-14" stroke-width="5" />
                        <path d="M56 206h148" stroke-width="5" />
                      </svg>
                    </div>
                  )}
                </div>

                <button
                  type="button"
                  class="bacc-trigger"
                  id={triggerId}
                  aria-expanded={open ? 'true' : 'false'}
                  aria-controls={contentId}
                  data-bacc-trigger
                >
                  <span class="bacc-label">{brand.name}</span>
                  <span class="bacc-logo" aria-hidden="true">
                    {brand.logoSrc ? (
                      <Image src={brand.logoSrc} alt="" widths={[160, 320, 480]} sizes="(max-width: 767px) 96px, 240px" format="webp" loading="lazy" decoding="async" />
                    ) : (
                      <span class="bacc-logo-word">{brand.wordmark}</span>
                    )}
                  </span>
                </button>

                {/* Metadata chip: a sibling of the content block, pinned to the
                    open panel's TOP-LEFT corner (HQ puts tags top-left). */}
                <p class="bacc-chips" aria-hidden="true"><span class="bacc-chip">{brand.kicker}</span></p>

                <div class="bacc-content" id={contentId} role="region" aria-labelledby={triggerId}>
                  <h3 class="bacc-headline">{brand.headline}</h3>
                  <p class="bacc-deck">{brand.deck}</p>
                  {hasCta && (
                    <a class="bacc-cta" href={brand.url} target="_blank" rel="noopener">
                      {brand.cta}
                      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                        <path d="M2 12L12 2H5M12 2v7" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" />
                      </svg>
                    </a>
                  )}
                  {brand.comingSoon && brand.teaserTag && <span class="bacc-teaser-tag">{brand.teaserTag}</span>}
                  {brand.inquiryEmail && (
                    <a class="bacc-inquiry" href={`mailto:${brand.inquiryEmail}?subject=${encodeURIComponent('Photography project inquiry')}`}>
                      Start a project <span aria-hidden="true">→</span>
                    </a>
                  )}
                </div>

                <div class="bacc-progress" aria-hidden="true"><span class="bacc-progress-fill"></span></div>
              </article>
            );
          })}
        </div>

        <button type="button" class="bacc-toggle" data-bacc-toggle aria-label="Pause auto-rotation" hidden>
          <svg class="bacc-icon-pause" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z" /></svg>
          <svg class="bacc-icon-play" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
        </button>
      </div>
    </div>
  </div>
  <p class="vh" aria-live="polite" data-bacc-announcer></p>
</section>

<style>
  .brand-accordion-section {
    padding-block: 0;
    position: relative;
  }
  /* #brands is an alias for #directory (both land on this section). */
  .bacc-anchor {
    position: absolute;
    top: 0;
  }
  .lanes-intro {
    padding-top: clamp(3rem, 6vw, 5rem);
    padding-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }
  .lanes-intro :global(.sec-head) {
    margin-bottom: 0;
  }

  /* ─── ACCENTS ───────────────────────────────────────────────────────────
     Every colour the panel uses comes from these properties. */
  .bacc-accent-mono {
    --acc-edge: #f0f0f0;
    --acc-progress: #f0f0f0;
    --acc-frame: rgba(255, 255, 255, 0.35);
    --acc-frame-glow: rgba(255, 255, 255, 0.1);
    --acc-label-glow: 0 0 18px rgba(255, 255, 255, 0.45);
    --acc-cta-border: #f0f0f0;
    --acc-cta-hover-bg: #f0f0f0;
    --acc-cta-hover-ink: #080808;
    --acc-cta-glow: 0 0 28px rgba(240, 240, 240, 0.3);
  }
  .bacc-accent-be-red {
    --acc-edge: var(--be-red);
    --acc-progress: var(--be-crimson);
    --acc-frame: var(--be-frame);
    --acc-frame-glow: var(--be-frame-glow);
    --acc-label-glow: var(--be-label-glow);
    --acc-cta-border: var(--be-cta-hover);
    --acc-cta-hover-bg: var(--be-cta-hover);
    --acc-cta-hover-ink: #ffffff;
    --acc-cta-glow: var(--be-cta-glow);
  }

  /* ─── TRACK ─────────────────────────────────────────────────────────── */
  .bacc {
    position: relative;
  }
  .bacc-viewport {
    position: relative;
    width: 100%;
    overflow: hidden;
  }
  .bacc-stage {
    position: relative;
    width: 100%;
    transform-origin: 0 0;
  }
  .bacc-track {
    --strip: var(--acc-strip);
    display: flex;
    gap: var(--acc-gap);
    width: 100%;
    overflow: hidden;
    aspect-ratio: 16 / 7;
    min-height: 460px;
    height: calc(75vh - var(--nav-h) - 36px);
    background: var(--page-bg);
  }

  .bacc-panel {
    position: relative;
    flex: 0 0 var(--strip);
    min-width: 0;
    overflow: hidden;
    background: #111;
    color: var(--text);
    transition:
      flex-grow var(--acc-duration) var(--acc-ease),
      flex-basis var(--acc-duration) var(--acc-ease);
  }
  .bacc-panel.is-open {
    flex: 1 1 0%;
  }
  /* The active edge: a pseudo-element, so opening a panel shifts nothing. */
  .bacc-panel::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 5px;
    background: var(--acc-edge);
    z-index: 5;
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.5s ease 0.2s;
  }
  .bacc-panel.is-open::before {
    transform: scaleY(1);
  }
  /* Hover frame and a glow rising from the strip's foot. */
  .bacc-panel::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 4;
    pointer-events: none;
    opacity: 0;
    box-shadow:
      inset 0 0 0 1px var(--acc-frame),
      inset 0 -120px 90px -60px var(--acc-frame-glow);
    transition: opacity 0.35s ease;
  }
  .bacc-panel:not(.is-open):hover::after,
  .bacc-panel:not(.is-open):focus-within::after {
    opacity: 1;
  }

  /* ─── ART ───────────────────────────────────────────────────────────── */
  .bacc-media {
    position: absolute;
    inset: 0;
  }
  .bacc-media > :global(img),
  .bacc-media > .bacc-teaser {
    width: 100%;
    height: 100%;
    object-fit: cover;
    --zoom: 1;
    transform: translateX(var(--img-x, 0)) scale(var(--zoom));
    transition: filter 0.6s ease, transform 1.4s ease;
  }
  /* Collapsed: blurred. Art is framed for the open panel, never for a strip,
     so a sharp sliver is noise; blurred, it is colour and mood. The panel
     clips, so the overscan hides the soft blur edge. */
  .bacc-panel:not(.is-open) .bacc-media > :global(img),
  .bacc-panel:not(.is-open) .bacc-media > .bacc-teaser {
    filter: blur(10px) grayscale(0.35) brightness(0.5);
    --zoom: 1.18;
  }
  .bacc-panel:not(.is-open):hover .bacc-media > :global(img),
  .bacc-panel:not(.is-open):hover .bacc-media > .bacc-teaser {
    filter: blur(2.5px) grayscale(0) brightness(0.82);
  }
  .bacc-panel.is-open:hover .bacc-media > :global(img) {
    filter: brightness(1.08);
  }
  @media (prefers-reduced-motion: no-preference) {
    .bacc-panel:not(.is-open):hover .bacc-media > :global(img),
    .bacc-panel:not(.is-open):hover .bacc-media > .bacc-teaser {
      --zoom: 1.3;
    }
    .bacc-panel.is-open:hover .bacc-media > :global(img) {
      --zoom: 1.06;
    }
  }
  /* Scrim: the headline is always white type over this gradient. */
  .bacc-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(8, 8, 8, 0.92) 0%, rgba(8, 8, 8, 0.25) 60%, rgba(8, 8, 8, 0.1) 100%);
  }
  .bacc-panel.is-open .bacc-media::after {
    background:
      linear-gradient(90deg, rgba(8, 8, 8, 0.94) 0%, rgba(8, 8, 8, 0.7) 32%, rgba(8, 8, 8, 0.15) 62%, rgba(8, 8, 8, 0) 80%),
      linear-gradient(to top, rgba(0, 0, 0, 0.95) 0%, rgba(0, 0, 0, 0.6) 25%, transparent 45%);
  }

  /* Teaser card (no art yet). */
  .bacc-teaser {
    position: relative;
    display: grid;
    place-items: center;
    background:
      radial-gradient(ellipse 60% 70% at 70% 45%, rgba(255, 255, 255, 0.09), transparent 70%),
      #0b0b0b;
    color: rgba(245, 245, 245, 0.55);
    overflow: hidden;
  }
  .bacc-teaser-art {
    position: absolute;
    top: 50%;
    left: 70%;
    width: min(38%, 320px);
    height: auto;
    transform: translate(-50%, -58%);
  }

  /* ─── TRIGGER: label + logo ─────────────────────────────────────────── */
  .bacc-trigger {
    position: absolute;
    inset: 0;
    z-index: 3;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }
  .bacc-trigger:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: -4px;
  }
  /* The open panel's trigger stays focusable (keyboard) but lets pointer
     clicks through to the copy and the art. */
  .bacc-panel.is-open .bacc-trigger {
    z-index: 7;
    pointer-events: none;
    cursor: default;
  }
  .bacc-label {
    position: absolute;
    top: 50%;
    left: 50%;
    writing-mode: vertical-rl;
    transform: translate(-50%, -50%) rotate(180deg);
    font: 600 clamp(0.76rem, 0.88vw, 0.95rem) / 1 var(--font-body);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    white-space: nowrap;
    color: rgba(245, 245, 245, 0.62);
    transition: color 0.3s ease, letter-spacing 0.4s ease, text-shadow 0.3s ease, opacity 0.3s ease;
  }
  .bacc-panel:not(.is-open):hover .bacc-label {
    color: #fff;
    letter-spacing: 0.42em;
    text-shadow: var(--acc-label-glow);
  }
  .bacc-panel.is-open .bacc-label {
    opacity: 0;
  }
  /* The logo lives in a FIXED foot box, centred on the strip, contained at
     its natural aspect ratio. It glides to the open panel's bottom-right
     corner along `left` (one property, so it interpolates both ways). */
  .bacc-logo {
    --logo-w: calc(var(--strip) - 1.6rem);
    position: absolute;
    left: calc(50% - var(--logo-w) / 2);
    bottom: 1.6rem;
    width: var(--logo-w);
    height: clamp(56px, 6vw, 96px);
    display: grid;
    place-items: center;
    transition: left var(--acc-duration) var(--acc-ease), transform 0.4s ease, opacity 0.4s ease;
  }
  .bacc-logo :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: contain;
  }
  .bacc-logo-word {
    font: 800 1.35rem / 1 var(--font-display);
    letter-spacing: 0.08em;
    color: rgba(245, 245, 245, 0.8);
  }
  .bacc-panel:not(.is-open):hover .bacc-logo {
    transform: translateY(-6px) scale(1.06);
  }
  .bacc-panel.is-open .bacc-logo {
    left: calc(100% - var(--logo-w) - clamp(1.5rem, 3vw, 3rem));
    bottom: clamp(1.5rem, 3vw, 3rem);
  }

  /* ─── CHIPS (top-left) ──────────────────────────────────────────────── */
  .bacc-chips {
    --pad: clamp(1.5rem, 4vw, 3.75rem);
    position: absolute;
    top: var(--pad);
    left: var(--pad);
    right: calc(var(--pad) + 3.5rem);
    z-index: 6;
    margin: 0;
    display: flex;
    gap: 0.5rem;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.2s ease-out;
  }
  .bacc-panel.is-open .bacc-chips {
    opacity: 1;
    transition: opacity 0.4s ease-in 0.2s;
  }
  .bacc-chip {
    display: inline-block;
    padding: 0.4rem 0.8rem;
    background: rgba(10, 10, 10, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-left: 2px solid var(--acc-edge);
    font: 600 0.68rem / 1.2 var(--font-body);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.9);
    white-space: nowrap;
  }

  /* ─── OPEN CONTENT ──────────────────────────────────────────────────── */
  .bacc-content {
    --pad: clamp(1.5rem, 4vw, 3.75rem);
    position: absolute;
    left: 0;
    bottom: 0;
    z-index: 6;
    width: min(100%, var(--open-w, 100%));
    max-width: clamp(34rem, 52vw, 75rem);
    padding: var(--pad);
    padding-bottom: clamp(2rem, 3.5vw, 3.25rem);
    display: none;
    flex-direction: column;
    align-items: flex-start;
  }
  .bacc-panel.is-open .bacc-content {
    display: flex;
    animation: bacc-rise 0.6s cubic-bezier(0.22, 1, 0.36, 1) 0.2s both;
  }
  @keyframes bacc-rise {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: none; }
  }
  .bacc-headline {
    margin: 0 0 0.9rem;
    font: 800 clamp(2rem, 3.4vw, 5rem) / 1.05 var(--font-display);
    text-transform: uppercase;
    color: #ffffff;
    max-width: 18ch;
    text-wrap: balance;
  }
  .bacc-deck {
    margin: 0;
    max-width: min(70ch, 100%);
    font: 500 clamp(0.85rem, 1vw, 1.2rem) / 1.65 var(--font-body);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.72);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .bacc-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: var(--tap-min);
    margin-top: 1.4rem;
    padding: 1rem 2.5rem;
    border: 1px solid var(--acc-cta-border);
    background: rgba(8, 8, 8, 0.35);
    color: #ffffff;
    font: 700 0.8rem / 1.2 var(--font-display);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color 0.3s cubic-bezier(0.25, 0.8, 0.2, 1), color 0.3s ease, box-shadow 0.3s ease;
  }
  .bacc-cta:hover,
  .bacc-cta:focus-visible,
  .bacc-accent-be-red.is-open:hover .bacc-cta {
    background: var(--acc-cta-hover-bg);
    color: var(--acc-cta-hover-ink);
    box-shadow: var(--acc-cta-glow);
  }
  .bacc-cta:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 3px;
  }
  .bacc-teaser-tag {
    display: inline-block;
    margin-top: 1.4rem;
    padding: 0.6rem 1.2rem;
    border: 1px solid rgba(255, 255, 255, 0.25);
    font: 600 0.72rem / 1.2 var(--font-body);
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: rgba(245, 245, 245, 0.75);
  }
  .bacc-inquiry {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: var(--tap-min);
    margin-top: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(245, 245, 245, 0.7);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .bacc-inquiry:hover,
  .bacc-inquiry:focus-visible {
    color: #fff;
    border-color: #fff;
  }

  /* ─── PROGRESS + TOGGLE ─────────────────────────────────────────────── */
  .bacc-progress {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 5;
    height: 3px;
    background: rgba(255, 255, 255, 0.08);
    display: none;
  }
  .bacc-panel.is-open .bacc-progress {
    display: block;
  }
  .bacc-progress-fill {
    display: block;
    height: 100%;
    background: var(--acc-progress);
    transform: scaleX(0);
    transform-origin: left center;
  }
  .bacc-toggle {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 8;
    display: grid;
    place-items: center;
    width: var(--tap-min);
    height: var(--tap-min);
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.22);
    background: rgba(8, 8, 8, 0.6);
    color: #f0f0f0;
    cursor: pointer;
    transition: border-color 0.2s ease, background 0.2s ease;
  }
  .bacc-toggle:hover {
    border-color: rgba(255, 255, 255, 0.6);
    background: rgba(8, 8, 8, 0.85);
  }
  .bacc-toggle[hidden] {
    display: none;
  }
  .bacc-toggle .bacc-icon-play,
  .bacc-toggle.is-paused .bacc-icon-pause {
    display: none;
  }
  .bacc-toggle.is-paused .bacc-icon-play {
    display: block;
  }

  /* ─── DESKTOP: art fixed at the open width, the panel only clips it ────
     So a resize is a new clip, never a repaint (HQ measured 637ms/s of
     raster without this). --open-w is the track less the strips and gaps. */
  @media (min-width: 768px) {
    .bacc-track {
      container-type: inline-size;
    }
    .bacc-panel {
      --open-w: calc(100cqw - (var(--acc-n) - 1) * (var(--strip) + var(--acc-gap)));
    }
    .bacc-media > :global(img),
    .bacc-media > .bacc-teaser {
      position: absolute;
      top: 0;
      left: 50%;
      width: var(--open-w);
      max-width: none;
      --img-x: -50%;
      will-change: transform;
    }
    .bacc-media::after {
      inset: 0 auto 0 0;
      width: var(--open-w);
    }
  }
  @media (hover: hover) and (pointer: fine) and (min-width: 768px) {
    .bacc-panel:not(.is-open):hover {
      flex-basis: calc(var(--strip) + 28px);
    }
  }

  /* ─── PHONES: the same panels stack ─────────────────────────────────── */
  @media (max-width: 767px) {
    .bacc-track {
      flex-direction: column;
      aspect-ratio: auto;
      min-height: 0;
      height: auto;
      padding: 0 var(--gutter);
      background: none;
    }
    .bacc-panel {
      flex: none;
      width: 100%;
      height: 64px;
      border: 1px solid rgba(255, 255, 255, 0.1);
    }
    /* Fixed height whatever the brand, so the stack never changes height. */
    .bacc-panel.is-open {
      flex: none;
      order: -1;
      height: 500px;
      display: flex;
      flex-direction: column;
      border-color: rgba(255, 255, 255, 0.15);
    }
    .bacc-panel.is-open .bacc-media {
      position: relative;
      inset: auto;
      flex: none;
      height: 196px;
      overflow: hidden;
    }
    .bacc-panel.is-open .bacc-media::after {
      background: linear-gradient(to top, rgba(9, 9, 9, 1) 0%, rgba(9, 9, 9, 0.3) 55%, rgba(9, 9, 9, 0.15) 100%);
    }
    .bacc-panel.is-open .bacc-content {
      position: relative;
      flex: 1;
      width: 100%;
      max-width: none;
      padding: 0.25rem 1rem 1rem 1.25rem;
      background: #090909;
      overflow: hidden;
      animation: none;
    }
    .bacc-chips {
      top: 1rem;
      left: 1.25rem;
      right: 4.5rem;
    }
    .bacc-headline {
      font-size: clamp(1.35rem, 6vw, 1.9rem);
      line-height: 1.12;
      max-width: none;
      margin-bottom: 0.6rem;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .bacc-deck {
      font-size: 0.78rem;
      letter-spacing: 0.1em;
      -webkit-line-clamp: 3;
    }
    .bacc-cta {
      margin-top: 1rem;
      padding: 0.65rem 1.25rem;
      font-size: 0.72rem;
      max-width: 100%;
    }
    .bacc-teaser-tag {
      margin-top: 1rem;
    }
    /* A collapsed row: blurred art behind, name left, logo right. */
    .bacc-label {
      top: 50%;
      left: 1.25rem;
      writing-mode: horizontal-tb;
      transform: translateY(-50%);
      max-width: calc(100% - 72px - 3.25rem);
      overflow: hidden;
      text-overflow: ellipsis;
      font-size: 0.8rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      color: rgba(245, 245, 245, 0.9);
    }
    .bacc-panel:not(.is-open):hover .bacc-label {
      letter-spacing: 0.08em;
    }
    .bacc-logo {
      --logo-w: 72px;
      left: auto;
      right: 1rem;
      bottom: 50%;
      height: 36px;
      transform: translateY(50%);
    }
    .bacc-panel:not(.is-open):hover .bacc-logo {
      transform: translateY(50%);
    }
    .bacc-panel.is-open .bacc-logo {
      left: auto;
      right: 1rem;
      bottom: 1rem;
      width: 88px;
      height: 44px;
      transform: none;
    }
    .bacc-logo-word {
      font-size: 1rem;
    }
    .bacc-toggle {
      top: 10px;
      right: calc(var(--gutter) + 10px);
    }
  }

  /* ─── FULLSCREEN BRAND VIEW (desktop) ───────────────────────────────── */
  .bacc-viewport.is-zoomed {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100dvh;
    z-index: 1000;
    background: #080808;
  }
  .bacc-stage {
    transition: transform 700ms cubic-bezier(0.25, 1, 0.5, 1);
  }
  /* The close control: out of the page (and the tab order) until the view
     is open, then above everything, including the sticky site header. */
  .bacc-close {
    position: fixed;
    top: 1.5rem;
    right: 1.5rem;
    z-index: 1100;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: var(--tap-min);
    padding: 0.5rem 0.85rem;
    background: rgba(18, 18, 18, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #f5f5f5;
    font: 500 0.72rem / 1 var(--font-mono);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    cursor: pointer;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }
  .bacc-close[hidden] {
    display: none;
  }
  .bacc-close:hover,
  .bacc-close:focus-visible {
    background: #f0f0f0;
    color: #080808;
    border-color: #f0f0f0;
  }
  .bacc-close-key {
    padding: 0.12rem 0.35rem;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.25);
    font-size: 0.62rem;
  }
  .bacc-viewport.is-zoomed:not(.is-closing) .bacc-panel:not(.is-open),
  .bacc-viewport.is-zoomed:not(.is-closing) .bacc-toggle,
  .bacc-viewport.is-zoomed:not(.is-closing) .bacc-progress,
  .bacc-viewport.is-zoomed:not(.is-closing) .bacc-panel::before {
    opacity: 0;
    pointer-events: none;
  }
  .bacc-panel.is-open {
    cursor: zoom-in;
  }
  .bacc-panel.is-open :is(a, button) {
    cursor: pointer;
  }
  .bacc-viewport.is-zoomed .bacc-panel.is-open {
    cursor: default;
  }
  /* In the view, the corners track the visible viewport (the scaled panel
     can overflow it) and the chip keeps clear of the close control, which
     sits top-right while the chip sits top-left. */
  .bacc-viewport.is-zoomed:not(.is-closing) .bacc-panel.is-open .bacc-chips {
    top: calc(clamp(1.5rem, 3vw, 2.75rem) + var(--zoom-overflow-y, 0px));
    left: calc(clamp(1.5rem, 3vw, 2.75rem) + var(--zoom-overflow-x, 0px));
    right: auto;
  }
  .bacc-viewport.is-zoomed:not(.is-closing) .bacc-panel.is-open .bacc-content {
    padding-left: calc(clamp(1.5rem, 3.5vw, 3.25rem) + var(--zoom-overflow-x, 0px));
    padding-bottom: calc(clamp(1.5rem, 3.5vw, 3rem) + var(--zoom-overflow-y, 0px));
  }
  .bacc-viewport.is-zoomed:not(.is-closing) .bacc-panel.is-open .bacc-logo {
    left: calc(100% - var(--logo-w) - clamp(1.5rem, 3vw, 3rem) - var(--zoom-overflow-x, 0px));
    bottom: calc(clamp(1.5rem, 3vw, 3rem) + var(--zoom-overflow-y, 0px));
  }

  /* ─── REDUCED MOTION: no autoplay (script), no zoom effects ─────────── */
  @media (prefers-reduced-motion: reduce) {
    .bacc-panel,
    .bacc-panel::before,
    .bacc-logo,
    .bacc-stage,
    .bacc-media > :global(img),
    .bacc-media > .bacc-teaser {
      transition: none !important;
    }
    .bacc-media > :global(img),
    .bacc-media > .bacc-teaser,
    .bacc-panel:not(.is-open):hover .bacc-media > :global(img),
    .bacc-panel:not(.is-open):hover .bacc-media > .bacc-teaser {
      --zoom: 1;
    }
    .bacc-panel.is-open .bacc-content {
      animation: none;
    }
  }
</style>

<script>
  const DURATION = 8000;
  const MOBILE = '(max-width: 767px)';
  const REDUCED = '(prefers-reduced-motion: reduce)';

  function initBrandAccordion() {
    const root = document.querySelector<HTMLElement>('[data-bacc]');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';

    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-bacc-panel]'));
    const triggers = panels.map((p) => p.querySelector<HTMLButtonElement>('[data-bacc-trigger]')!);
    const toggle = root.querySelector<HTMLButtonElement>('[data-bacc-toggle]');
    const announcer = document.querySelector<HTMLElement>('[data-bacc-announcer]');
    const viewport = root.querySelector<HTMLElement>('[data-bacc-viewport]')!;
    const stage = root.querySelector<HTMLElement>('[data-bacc-stage]')!;
    const closeBtn = root.querySelector<HTMLButtonElement>('[data-bacc-close]');
    if (!panels.length || triggers.some((t) => !t)) return;

    const reduced = window.matchMedia(REDUCED);
    const mobile = window.matchMedia(MOBILE);

    let current = Math.max(0, panels.findIndex((p) => p.classList.contains('is-open')));
    let elapsed = 0;
    let last = 0;
    let raf = 0;
    let onScreen = false;
    /* Why rotation is not running, as independent reasons. */
    const holds = { hover: false, focus: false, touch: false, zoom: false };
    let userPaused = mobile.matches; // off by default on phones
    let stopped = false; // the first manual choice stops it (Play restarts)

    const canRotate = () => panels.length > 1 && !reduced.matches;
    const running = () =>
      canRotate() && !stopped && !userPaused && !holds.hover && !holds.focus && !holds.touch && !holds.zoom;

    function setFill(ratio: number) {
      const fill = panels[current]?.querySelector<HTMLElement>('.bacc-progress-fill');
      if (fill) fill.style.transform = `scaleX(${Math.min(1, Math.max(0, ratio))})`;
    }

    function open(index: number, { focus = false, announce = false } = {}) {
      const next = (index + panels.length) % panels.length;
      if (next !== current) {
        setFill(0);
        panels[current].classList.remove('is-open');
        triggers[current].setAttribute('aria-expanded', 'false');
        current = next;
        panels[current].classList.add('is-open');
        triggers[current].setAttribute('aria-expanded', 'true');
        if (announce && announcer) {
          const name = triggers[current].querySelector('.bacc-label')?.textContent ?? '';
          announcer.textContent = `${name}, panel ${current + 1} of ${panels.length}`;
        }
      }
      elapsed = 0;
      setFill(0);
      if (focus) triggers[current].focus();
    }

    /* The clock only ticks while it has something to do. */
    function kick() {
      if (raf || !running() || !onScreen) return;
      last = 0;
      raf = requestAnimationFrame(frame);
    }
    function frame(now: number) {
      if (!running() || !onScreen) {
        raf = 0;
        return;
      }
      if (!last) last = now;
      /* Capped: rAF pauses in a hidden tab, so the first frame back would
         otherwise count the whole time away and flip the panel at once. */
      const dt = Math.min(now - last, 100);
      last = now;
      elapsed += dt;
      if (elapsed >= DURATION) open(current + 1);
      setFill(elapsed / DURATION);
      raf = requestAnimationFrame(frame);
    }

    /* The label always states what the button will do next, which is the
       state: "Pause" while rotating, "Play" while paused. No aria-pressed
       (a pressed "Play" was the contradiction the audit caught). */
    function syncToggle() {
      if (toggle) {
        toggle.hidden = !canRotate();
        const paused = stopped || userPaused;
        toggle.classList.toggle('is-paused', paused);
        toggle.setAttribute('aria-label', paused ? 'Play auto-rotation' : 'Pause auto-rotation');
        toggle.title = paused ? 'Play auto-rotation' : 'Pause auto-rotation';
      }
      if (stopped || userPaused) setFill(0);
      kick();
    }

    const choose = (i: number, focus = false) => {
      stopped = true;
      open(i, { focus, announce: true });
      syncToggle();
    };

    triggers.forEach((t, i) => {
      t.addEventListener('click', (e) => {
        e.stopPropagation();
        if (i === current) {
          // Keyboard Enter/Space on the open panel's trigger opens the view.
          if (!mobile.matches) camera.open(panels[i]);
          return;
        }
        choose(i);
      });
      t.addEventListener('keydown', (e) => {
        let target = -1;
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') target = i + 1;
        else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') target = i - 1;
        else if (e.key === 'Home') target = 0;
        else if (e.key === 'End') target = panels.length - 1;
        else return;
        e.preventDefault();
        choose(target, true);
      });
    });

    toggle?.addEventListener('click', () => {
      if (stopped || userPaused) {
        stopped = false;
        userPaused = false;
        /* Play means play NOW: the pointer is on this button and it has
           focus, so both holds are true at this moment. They re-arm on the
           next mouseenter / focusin. */
        holds.hover = false;
        holds.focus = false;
      } else {
        userPaused = true;
      }
      syncToggle();
    });

    const hold = (key: keyof typeof holds, value: boolean) => () => {
      holds[key] = value;
      kick();
    };
    root.addEventListener('mouseenter', hold('hover', true));
    root.addEventListener('mouseleave', hold('hover', false));
    root.addEventListener('focusin', hold('focus', true));
    root.addEventListener('focusout', (e) => {
      if (!root.contains(e.relatedTarget as Node | null)) holds.focus = false;
      kick();
    });
    root.addEventListener('touchstart', hold('touch', true), { passive: true });
    root.addEventListener('touchend', hold('touch', false), { passive: true });
    root.addEventListener('touchcancel', hold('touch', false), { passive: true });
    new IntersectionObserver(([entry]) => {
      onScreen = entry.isIntersecting;
      kick();
    }, { threshold: 0.25 }).observe(root);
    const onMedia = () => {
      if (mobile.matches) userPaused = true;
      if (mobile.matches && camera.isZoomed) camera.close();
      syncToggle();
    };
    reduced.addEventListener('change', onMedia);
    mobile.addEventListener('change', onMedia);

    /* ─── Fullscreen brand view: a camera dolly into the open panel ─── */
    const camera = {
      isZoomed: false,
      isClosing: false,
      panel: null as HTMLElement | null,
      restX: 0,
      restY: 0,
      measure(panel: HTMLElement) {
        const r = panel.getBoundingClientRect();
        const s = stage.getBoundingClientRect();
        const vw = window.innerWidth;
        const vh = window.innerHeight;
        const scale = Math.max(vw / r.width, vh / r.height);
        panel.style.setProperty('--zoom-overflow-x', `${Math.max(0, (r.width * scale - vw) / 2) / scale}px`);
        panel.style.setProperty('--zoom-overflow-y', `${Math.max(0, (r.height * scale - vh) / 2) / scale}px`);
        const tx = vw / 2 - scale * (r.left + r.width / 2 - s.left);
        const ty = vh / 2 - scale * (r.top + r.height / 2 - s.top);
        return { tx, ty, scale, s };
      },
      open(panel: HTMLElement) {
        if (this.isZoomed || this.isClosing) return;
        this.isZoomed = true;
        this.panel = panel;
        holds.zoom = true;
        const { tx, ty, scale, s } = this.measure(panel);
        this.restX = s.left;
        this.restY = s.top;
        const gutter = window.innerWidth - document.documentElement.clientWidth;
        if (gutter > 0) document.body.style.paddingRight = `${gutter}px`;
        viewport.classList.remove('is-closing');
        viewport.classList.add('is-zoomed');
        document.body.style.overflow = 'hidden';
        if (closeBtn) {
          closeBtn.hidden = false;
          closeBtn.focus({ preventScroll: true });
        }
        stage.style.transition = 'none';
        if (reduced.matches) {
          stage.style.transform = `translate3d(${tx}px, ${ty}px, 0) scale(${scale})`;
          return;
        }
        stage.style.transform = `translate3d(${this.restX}px, ${this.restY}px, 0) scale(1)`;
        void stage.offsetWidth;
        stage.style.transition = '';
        stage.style.transform = `translate3d(${tx}px, ${ty}px, 0) scale(${scale})`;
      },
      recalc() {
        if (!this.panel || this.isClosing) return;
        const { tx, ty, scale } = this.measure(this.panel);
        stage.style.transition = 'none';
        stage.style.transform = `translate3d(${tx}px, ${ty}px, 0) scale(${scale})`;
      },
      close() {
        if (!this.isZoomed || this.isClosing) return;
        this.isClosing = true;
        viewport.classList.add('is-closing');
        if (reduced.matches) return this.cleanup();
        stage.style.transition = '';
        stage.style.transform = `translate3d(${this.restX}px, ${this.restY}px, 0) scale(1)`;
        const done = () => this.isClosing && this.cleanup();
        stage.addEventListener('transitionend', done, { once: true });
        window.setTimeout(done, 750);
      },
      cleanup() {
        this.panel?.style.removeProperty('--zoom-overflow-x');
        this.panel?.style.removeProperty('--zoom-overflow-y');
        stage.style.transition = 'none';
        stage.style.transform = '';
        viewport.classList.remove('is-zoomed', 'is-closing');
        document.body.style.overflow = '';
        document.body.style.paddingRight = '';
        if (closeBtn) closeBtn.hidden = true;
        const panel = this.panel;
        this.isZoomed = false;
        this.isClosing = false;
        this.panel = null;
        holds.zoom = false;
        panel?.querySelector<HTMLElement>('[data-bacc-trigger]')?.focus({ preventScroll: true });
        kick();
      },
    };

    panels.forEach((panel, i) => {
      panel.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (target.closest('a, button')) return; // links and controls act for themselves
        if (i !== current) {
          choose(i);
          return;
        }
        if (mobile.matches) return;
        if (camera.isZoomed) camera.close();
        else camera.open(panel);
      });
    });
    closeBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      camera.close();
    });
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && camera.isZoomed) {
        e.preventDefault();
        camera.close();
      }
    });
    window.addEventListener('resize', () => camera.isZoomed && camera.recalc());
    window.addEventListener('popstate', () => camera.isZoomed && camera.close());

    /* #brand-<id> (a link or the URL hash) opens that brand's panel. */
    const selectById = (id: string) => {
      const i = panels.findIndex((p) => p.dataset.brandId === id);
      if (i >= 0) choose(i);
    };
    document.addEventListener('click', (e) => {
      const link = (e.target as Element | null)?.closest?.('a[href*="#brand-"]');
      const m = link?.getAttribute('href')?.match(/#brand-([a-z0-9-]+)$/);
      if (m) selectById(m[1]);
    });
    const fromHash = () => {
      const m = window.location.hash.match(/^#brand-([a-z0-9-]+)$/);
      if (m) selectById(m[1]);
    };
    window.addEventListener('hashchange', fromHash);
    fromHash();

    syncToggle();
  }

  initBrandAccordion();
</script>
