---
import { Image } from 'astro:assets';
import parentLogo from '../assets/brand-logos/hey-thisisandrew.png';

/* Icon-only social links. Glyphs are hand-drawn brand marks at 24x24;
   links carry aria-labels so nothing is lost without the text. */
const socials = [
  {
    label: 'YouTube',
    href: 'https://www.youtube.com/@HeyThisIsAndrew',
    icon: '<rect x="2.5" y="6" width="19" height="12.5" rx="3.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M10.5 9.8v5l4.5-2.5z" fill="currentColor" stroke="none"/>',
  },
  {
    label: 'Instagram',
    href: 'https://www.instagram.com/hey_thisisandrew/',
    icon: '<rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="17.2" cy="6.8" r="1.2" fill="currentColor" stroke="none"/>',
  },
  {
    label: 'TikTok',
    href: 'https://tiktok.com/@hey_thisisandrew',
    icon: '<path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z" fill="currentColor" stroke="none"/>',
  },
  {
    label: 'Facebook',
    href: 'https://facebook.com/thisisandrew',
    icon: '<path d="M13.4 21v-6.9h2.3l.4-2.7h-2.7V9.7c0-.8.3-1.3 1.4-1.3h1.4V6c-.3 0-1.1-.1-2-.1-2 0-3.4 1.2-3.4 3.5v2H8.5v2.7h2.3V21h2.6z" fill="currentColor" stroke="none"/>',
  },
  {
    label: 'Bluesky',
    href: 'https://bsky.app/profile/thisisandrew.bsky.social',
    icon: '<path d="M12 10.8c-1.087-2.114-4.046-6.053-6.798-7.995C2.566.944 1.561 1.266.902 1.565.139 1.908 0 3.08 0 3.768c0 .69.378 5.65.624 6.479.815 2.736 3.713 3.66 6.383 3.364.136-.02.275-.039.415-.056-.138.022-.276.04-.415.056-3.912.58-7.387 2.005-2.83 7.078 5.013 5.19 6.87-4.167 7.844-7.48.974 3.313 2.83 12.67 7.844 7.48 4.557-5.073 1.082-6.498-2.83-7.078.14-.016.279-.036.415-.056 2.67.297 5.568-.628 6.383-3.364.246-.828.624-5.79.624-6.478 0-.69-.139-1.861-.902-2.206-.659-.298-1.664-.62-4.3 1.24C16.046 4.748 13.087 8.687 12 10.8z" fill="currentColor" stroke="none"/>',
  },
  {
    label: 'LinkedIn',
    href: 'https://www.linkedin.com/in/andrewlwyrbaxter/',
    icon: '<path d="M6.9 8.6H4V20h2.9V8.6zM5.4 7.3a1.7 1.7 0 1 0 0-3.4 1.7 1.7 0 0 0 0 3.4zM9.5 20h2.9v-5.6c0-.3 0-.6.1-.8.3-.6.9-1.2 1.9-1.2 1.4 0 1.9 1 1.9 2.6V20h2.9v-5.9c0-2.9-1.5-4.2-3.6-4.2-1.7 0-2.4.9-2.8 1.6v-1.4H9.5V20z" fill="currentColor" stroke="none"/>',
  },
];
const explore = [
  { label: 'About', href: '/about' },
  { label: 'Press kit', href: '/press' },
  { label: 'Privacy', href: '/privacy' },
];
---
<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <Image src={parentLogo} alt="Hey This Is Andrew" class="footer-logo" width={320} />
      <p class="footer-note">Creator, photographer, coffee drinker.</p>
    </div>
    <nav class="footer-nav" aria-label="Explore">
      <p class="footer-label">Explore</p>
      <ul>
        {explore.map((l) => (
          <li>
            <a href={l.href} target={l.external ? '_blank' : undefined} rel={l.external ? 'noopener' : undefined}>
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="footer-socials-col">
      <p class="footer-label">Follow</p>
      <ul class="socials" aria-label="Social links">
        {socials.map((s) => (
          <li>
            <a href={s.href} target="_blank" rel="noopener" aria-label={s.label} title={s.label}>
              <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                <Fragment set:html={s.icon} />
              </svg>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
  <div class="footer-bottom">
    <p>&copy; 2026 Andrew Baxter. All rights reserved.</p>
    <p>Built in public with Astro.</p>
    <p>All process, no perfectionism.</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    background: var(--surface);
    padding: 4rem 2rem 2rem;
    margin-top: 4rem;
  }
  .footer-inner {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 1.5rem;
    max-width: var(--maxw);
    margin: 0 auto;
    padding-bottom: 3rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }
  .footer-brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 0.75rem;
  }
  .footer-word {
    font-family: var(--font-display);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    line-height: 1.1;
    font-size: clamp(1.2rem, 2vw, 1.6rem);
    color: var(--ink);
    margin: 0;
  }
  .footer-logo {
    display: block;
    height: 5rem;
    width: auto;
  }
  .footer-note {
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--muted);
    font-size: 0.8rem;
    margin: 0;
  }
  .footer-nav {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .footer-label {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink);
    margin: 0 0 1.25rem;
    text-align: center;
  }
  .footer-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.9rem 1.5rem;
    justify-items: center;
  }
  .footer-nav a {
    position: relative;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.675rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
    white-space: nowrap;
    padding-bottom: 0.25rem;
  }
  .footer-nav a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background: var(--ink);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s ease;
  }
  .footer-nav a:hover {
    color: var(--ink);
  }
  .footer-nav a:hover::after {
    transform: scaleX(1);
  }
  .footer-socials-col {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .socials {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 40px);
    gap: 0.5rem;
    justify-content: center;
  }
  .socials a {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: #111;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }
  .socials a:hover {
    color: var(--ink);
    border-color: rgba(255, 255, 255, 0.4);
    transform: translateY(-3px);
  }
  .footer-bottom {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 1rem;
    max-width: var(--maxw);
    margin: 0 auto;
    padding-top: 1.5rem;
    text-align: center;
  }
  .footer-bottom p {
    margin: 0;
    font-size: 0.75rem;
    color: var(--muted);
  }
  @media (max-width: 768px) {
    .footer-inner {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .footer-brand {
      margin-bottom: 3rem;
    }
    .footer-bottom {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .socials a:hover {
      transform: none;
    }
  }
</style>
