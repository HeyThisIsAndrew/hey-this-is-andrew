---
import { Image } from 'astro:assets';
import parentLogo from '../assets/brand-logos/hey-thisisandrew.png';

/* Icon-only social links. Glyphs are hand-drawn brand marks at 24x24;
   links carry aria-labels so nothing is lost without the text. */
const socials = [
  {
    label: 'YouTube',
    href: 'https://www.youtube.com/@HeyThisIsAndrew',
    icon: '<rect x="2.5" y="6" width="19" height="12.5" rx="3.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M10.5 9.8v5l4.5-2.5z" fill="currentColor" stroke="none"/>',
  },
  {
    label: 'Instagram',
    href: 'https://www.instagram.com/hey_thisisandrew/',
    icon: '<rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="17.2" cy="6.8" r="1.2" fill="currentColor" stroke="none"/>',
  },
  {
    label: 'TikTok',
    href: 'https://tiktok.com/@hey_thisisandrew',
    icon: '<path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z" fill="currentColor" stroke="none"/>',
  },
  {
    label: 'Threads',
    href: 'https://www.threads.net/@hey_thisisandrew',
    icon: '<path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm3.8 13.5c-.7 1.2-1.8 1.8-3.2 1.8-2.3 0-3.9-1.6-3.9-4.1 0-2.6 1.8-4.3 4.2-4.3 2.1 0 3.6 1.4 3.6 3.4 0 2.2-1.4 3.5-3.3 3.5-.9 0-1.7-.4-2-.9l.8-.6c.2.4.7.6 1.2.6 1.3 0 2.2-1 2.2-2.6 0-1.5-1-2.5-2.5-2.5-1.8 0-3.1 1.3-3.1 3.4 0 2 1.3 3.2 3.1 3.2 1.1 0 2-.5 2.5-1.4l.8.6z" fill="currentColor" stroke="none"/>',
  },
  {
    label: 'Substack',
    href: 'https://heythisisandrew.substack.com/',
    icon: '<path d="M22.539 8.242H1.46V5.406h21.08v2.836zM1.46 10.812V24L12 18.11 22.54 24V10.812H1.46zM22.54 0H1.46v2.836h21.08V0z" fill="currentColor" stroke="none"/>',
  },
  {
    label: 'LinkedIn',
    href: 'https://www.linkedin.com/in/andrewlwyrbaxter/',
    icon: '<path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9h2.79v8.37H6.46v-8.37M7.86 6.7a1.4 1.4 0 1 0 0 2.8 1.4 1.4 0 0 0 0-2.8z" fill="currentColor" stroke="none"/>',
  },
];
const rawBase = import.meta.env.BASE_URL;
const base = rawBase === '/' ? '' : rawBase.replace(/\/$/, '');

const explore = [
  { label: 'About', href: `${base}/about` },
  { label: 'Feed', href: `${base}/feed` },
  { label: 'Links', href: `${base}/links` },
  { label: 'Press kit', href: `${base}/press` },
  { label: 'Sitemap', href: `${base}/sitemap` },
];
---
<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <Image src={parentLogo} alt="Hey This Is Andrew" class="footer-logo" width={320} />
      <p class="footer-note">Creator, photographer, coffee drinker.</p>
    </div>
    <nav class="footer-nav" aria-label="Explore">
      <p class="footer-label">Explore</p>
      <ul>
        {explore.map((l) => (
          <li>
            <a href={l.href}>
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="footer-socials-col">
      <p class="footer-label">Follow</p>
      <ul class="socials" aria-label="Social links">
        {socials.map((s) => (
          <li>
            <a href={s.href} target="_blank" rel="noopener" aria-label={s.label} title={s.label}>
              <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                <Fragment set:html={s.icon} />
              </svg>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
  <div class="footer-bottom">
    <p>&copy; 2026 Andrew Baxter. All rights reserved.</p>
    <p><a href={`${base}/privacy`} class="footer-privacy">Privacy</a></p>
    <p>Built in public with Astro.</p>
    <p>All process, no perfectionism.</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    background: var(--surface);
    padding: 4rem 2rem 2rem;
    margin-top: 4rem;
  }
  .footer-inner {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 1.5rem;
    max-width: var(--maxw);
    margin: 0 auto;
    padding-bottom: 3rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }
  .footer-brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 0.75rem;
  }
  .footer-word {
    font-family: var(--font-display);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    line-height: 1.1;
    font-size: clamp(1.2rem, 2vw, 1.6rem);
    color: var(--ink);
    margin: 0;
  }
  .footer-logo {
    display: block;
    height: 5rem;
    width: auto;
  }
  .footer-note {
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--muted);
    font-size: 0.8rem;
    margin: 0;
  }
  .footer-nav {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .footer-label {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink);
    margin: 0 0 1.25rem;
    text-align: center;
  }
  .footer-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.9rem 1.5rem;
    justify-items: center;
  }
  .footer-nav a {
    position: relative;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.675rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
    white-space: nowrap;
    padding-bottom: 0.25rem;
  }
  .footer-nav a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background: var(--ink);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s ease;
  }
  .footer-nav a:hover {
    color: var(--ink);
  }
  .footer-nav a:hover::after {
    transform: scaleX(1);
  }
  .footer-socials-col {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .socials {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 40px);
    gap: 0.5rem;
    justify-content: center;
  }
  .socials a {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: #111;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }
  .socials a:hover {
    color: var(--ink);
    border-color: rgba(255, 255, 255, 0.4);
    transform: translateY(-3px);
  }
  .footer-bottom {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 1rem;
    max-width: var(--maxw);
    margin: 0 auto;
    padding-top: 1.5rem;
    text-align: center;
  }
  .footer-bottom p {
    margin: 0;
    font-size: 0.75rem;
    color: var(--muted);
  }
  @media (max-width: 768px) {
    .footer-inner {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .footer-brand {
      margin-bottom: 3rem;
    }
    .footer-bottom {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .socials a:hover {
      transform: none;
    }
  }
</style>
