---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import portrait from '../assets/hero-media/portrait.jpg';
import type { LatestItem } from '../lib/latest-content';

// The top of the site is about Andrew: slide one is the Build in Public
// intro, followed by his three latest YouTube videos. The carousel keeps
// its existing rotation, TOC, progress, pause, keyboard, and reduced-motion
// behavior; only the content changed. Videos arrive from the page via the
// getLatestVideos() build-time fetcher (RSS, with a hardcoded fallback).

interface HeroSlide {
  id: string;
  toc: string;
  /** Editorial metadata hierarchy (BE-style): category, status, date. */
  metadata: string[];
  headline: string;
  deck?: string;
  ctaLabel?: string;
  ctaHref?: string;
  teaser?: string;
  image?: ImageMetadata;
  imageSrc?: string;
  /** Verified responsive variants for remote images (YouTube thumbs). */
  imageSrcset?: string;
  imageAlt: string;
  /** If set, the CTA opens the in-page video player (spatial zoom) instead of a link. */
  videoUrl?: string;
}

interface Props {
  videos?: LatestItem[];
}

const { videos = [] } = Astro.props;
const CHANNEL_URL = 'https://www.youtube.com/@HeyThisIsAndrew';

/**
 * Derive a concise editorial descriptor from the actual video title.
 * This is NOT invented metadata — it's extracted from the real title.
 * Used as the third metadata chip: YOUTUBE / LATEST / <descriptor>
 */
function videoDescriptor(title: string): string {
  const t = title.toLowerCase();
  
  // Check for known phrases first (most specific)
  if (t.includes('build in public')) return 'BUILD IN PUBLIC';
  if (t.includes('creator automation')) return 'CREATOR AUTOMATION';
  if (t.includes('monetization is slow')) return 'ALTERNATIVE REVENUE';
  if (t.includes('monetization')) return 'MONETIZATION';
  if (t.includes('brand deal')) return 'BRAND DEALS';
  
  // Fallback: extract first 2-3 meaningful words (skip articles, pronouns)
  const stopWords = new Set(['how', 'i\'m', 'im', 'i', 'the', 'a', 'an', 'to', 'for', 'with', 'on', 'in', 'of', 'and', 'just', 'made', 'do', 'it']);
  const words = title
    .replace(/[|!?.:;,'"]/g, ' ')
    .split(/\s+/)
    .filter(w => w.length > 2 && !stopWords.has(w.toLowerCase()))
    .slice(0, 3);
  
  return words.join(' ').toUpperCase() || 'VIDEO';
}

const slides: HeroSlide[] = [
  {
    id: 'build-in-public',
    toc: 'BUILD IN PUBLIC',
    metadata: ['BUILD IN PUBLIC', 'INTRO'],
    headline: 'Building in public.',
    deck: 'Documenting the messy middle of building three brands, commercial photography, and creator automation.',
    ctaLabel: 'Watch on YouTube',
    ctaHref: CHANNEL_URL,
    image: portrait,
    imageAlt: 'Andrew Baxter, creator and photographer',
  },
  ...videos.slice(0, 3).map((v, i) => {
    // Fallback slides point at the channel, not a video: label them honestly.
    const isFallback = v.url === CHANNEL_URL;
    const dateLabel = new Date(v.date)
      .toLocaleDateString('en-US', { month: 'short', year: 'numeric' })
      .toUpperCase();
    return {
      id: `video-${i}`,
      toc: videoDescriptor(v.title),
      // Truthful metadata: YOUTUBE / LATEST / SEP 2026 (or RECENT / AUG 2026)
      metadata: isFallback
        ? ['FROM THE CHANNEL']
        : ['YOUTUBE', i === 0 ? 'LATEST' : 'RECENT', dateLabel],
      headline: v.title,
      deck: v.description
        ? v.description.replace(/\n+/g, ' ').slice(0, 110).toUpperCase()
        : 'WATCH THE LATEST VIDEO ON YOUTUBE.',
      ctaLabel: 'Watch on YouTube',
      ctaHref: v.url,
      // Real videos open the in-page player with a spatial zoom from the slide thumbnail.
      videoUrl: isFallback ? undefined : v.url,
      imageSrc: v.image ?? undefined,
      imageSrcset: v.imageSrcset,
      imageAlt: v.title,
    };
  }),
];
---
<section class="brand-carousel" aria-roledescription="carousel" aria-label="Build in public">
  <div class="vh" aria-live="polite" id="carousel-announcer">
    {`Slide 1 of ${slides.length}: ${slides[0]?.headline ?? ''}`}
  </div>

  <div class="carousel-track">
    {slides.map((slide, i) => (
      <div 
        class:list={['carousel-slide', { active: i === 0 }]}
        data-index={i} 
        aria-hidden={i !== 0 ? "true" : "false"}
        aria-roledescription="slide"
        aria-label={`${i + 1} of ${slides.length}`}
      >
        <div
          class="slide-media"
          data-video-player={slide.videoUrl ? true : undefined}
          data-video-url={slide.videoUrl}
          data-video-title={slide.headline}
          role={slide.videoUrl ? "button" : undefined}
          tabindex={slide.videoUrl ? 0 : undefined}
          aria-label={slide.videoUrl ? `Play video: ${slide.headline}` : undefined}
        >
          {slide.image ? (
            <Image
              src={slide.image}
              alt={slide.imageAlt}
              widths={[960, 1440, 1920]}
              sizes="100vw"
              format="webp"
              fetchpriority={i === 0 ? "high" : "auto"}
              loading={i === 0 ? "eager" : "lazy"}
            />
          ) : slide.imageSrc ? (
            <img
              src={slide.imageSrc}
              srcset={slide.imageSrcset}
              sizes="100vw"
              alt={slide.imageAlt}
              fetchpriority={i === 0 ? "high" : "auto"}
              loading={i === 0 ? "eager" : "lazy"}
            />
          ) : (
            // FALLBACK CHAIN FOR HERO IMAGES (maintain this):
            // 1. slide.image (Astro ImageMetadata) - used for slide 1 portrait
            // 2. slide.imageSrc (string URL) - YouTube thumbnails for slides 2-4
            // 3. THIS FALLBACK: portrait.jpg - when YouTube feed is unreachable
            //    (FALLBACK_VIDEOS in latest-content.ts have image: null)
            // NEVER render an empty slide-media. An empty slide looks broken.
            // If you change the fallback image, update the import at the top.
            <Image
              src={portrait}
              alt={slide.imageAlt}
              widths={[960, 1440, 1920]}
              sizes="100vw"
              format="webp"
              loading="lazy"
            />
          )}
          {slide.videoUrl ? (
            <span class="slide-play" aria-hidden="true">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M8 5v14l11-7z" />
              </svg>
            </span>
          ) : null}
        </div>
        <div class="slide-scrim" aria-hidden="true"></div>
        <div class="container slide-content">
          <p class="kicker">{slide.metadata.map((m) => <span class="chip chip--brand">{m}</span>)}</p>
          <h2 class="display slide-title">{slide.headline}</h2>
          {slide.teaser ? (
            <span class="teaser-tag cta-anim">{slide.teaser}</span>
          ) : slide.ctaLabel && slide.ctaHref ? (
            <a
              class="btn btn-primary cta-anim"
              href={slide.ctaHref}
              target="_blank"
              rel="noopener"
              aria-label={`Watch ${slide.headline} on YouTube`}
            >
              {slide.ctaLabel}
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M2 12L12 2M12 2H5M12 2v7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          ) : null}
        </div>
      </div>
    ))}
  </div>

  <div class="carousel-toc">
    <div class="container toc-inner" style={`--slide-count: ${slides.length};`}>
      {slides.map((slide, i) => (
        <button 
          class:list={['toc-btn', { active: i === 0 }]}
          data-index={i}
          aria-label={`Go to slide ${i + 1}: ${slide.metadata.join(' / ')}`}
        >
          <span class="toc-label">0{i + 1} / {slide.toc}</span>
          <div class="toc-progress-track">
            <div class="toc-progress-fill"></div>
          </div>
        </button>
      ))}
      <div class="player-controls">
        <button class="player-btn player-prev" aria-label="Previous slide">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M10 3L5 8l5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button class="player-btn carousel-play-pause" aria-label="Pause carousel" aria-pressed="false">
          <svg class="icon-pause" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>
          </svg>
          <svg class="icon-play" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="display: none;">
            <path d="M8 5v14l11-7z"/>
          </svg>
        </button>
        <button class="player-btn player-next" aria-label="Next slide">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  /* BE-style overlay hero: text sits on the image.
     Media (21:9) is the frame; kicker goes top-right, headline + CTA
     bottom-left. The image stays dominant — text is restrained.
     Monochrome throughout; no BE red. */
  .brand-carousel {
    position: relative;
    background: var(--bg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    /* Editorial height: enough for 21:9 media, not a viewport takeover */
    min-height: 0;
    /* Sticky nav is in normal flow: the hero sits directly below it.
       Zero top padding so the hero image sits flush against the bottom of the navbar. */
    margin-top: 0;
    padding-top: 0;
    padding-block-start: 0;
  }

  .carousel-track {
    position: relative;
    width: 100%;
    /* Height is determined by the active slide's content */
    display: grid;
  }

  .carousel-slide {
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
    transform: scale(1.02);
    transition: opacity 0.45s ease, transform 0.45s cubic-bezier(0.22, 0.61, 0.36, 1),
      visibility 0s linear 0.45s;
    z-index: 1;
    /* Overlay layout: content sits on top of media, not below it */
    position: relative;
    display: block;
  }

  .carousel-slide.active {
    opacity: 1;
    visibility: visible;
    transform: scale(1);
    transition: opacity 0.45s ease, transform 0.45s cubic-bezier(0.22, 0.61, 0.36, 1),
      visibility 0s linear 0s;
    z-index: 2;
    position: relative;
  }

  /* Inactive slides are removed from layout to prevent height jumps */
  .carousel-slide:not(.active) {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  /* Media: 21:9 cinematic, contained, not full-bleed.
     The wider ratio keeps the hero compact so the progress bars and TOC
     remain fully visible in the viewport at scrollY = 0 on a 14-inch MacBook Pro. */
  .slide-media {
    position: relative;
    width: 100%;
    aspect-ratio: 21 / 9;
    max-height: calc(100vh - 170px);
    min-height: 380px;
    overflow: hidden;
    background: #111; /* fallback while loading */
  }

  .slide-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform: scale(1.05);
    transition: transform 6s linear;
  }

  .carousel-slide.active .slide-media img {
    transform: scale(1);
  }

  /* The slide visual is the video trigger: the FLIP zoom originates here,
     not from the CTA button. */
  .slide-media[role="button"] {
    cursor: pointer;
  }
  .slide-media[role="button"]:focus-visible {
    outline: 2px solid #fff;
    outline-offset: -2px;
  }
  /* Inactive slides are beneath the active one; keep their visuals out of
     the tab order and hit-testing. */
  .carousel-slide:not(.active) .slide-media[role="button"] {
    visibility: hidden;
  }

  /* Play affordance on the visual: subtle, reveals on hover/focus. */
  .slide-play {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 76px;
    height: 76px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.35);
    color: #fff;
    opacity: 0;
    transform: scale(0.92);
    transition: opacity 0.25s ease, transform 0.25s ease;
    pointer-events: none;
  }
  .slide-media[role="button"]:hover .slide-play,
  .slide-media[role="button"]:focus-visible .slide-play {
    opacity: 1;
    transform: scale(1);
  }
  @media (prefers-reduced-motion: reduce) {
    .slide-play {
      transition: none;
    }
  }

  /* Gradient scrim for text legibility over the image.
     Monochrome: black gradient, no color tint. Subtle — the image stays dominant. */
  .slide-scrim {
    display: block;
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      linear-gradient(to top, rgba(0, 0, 0, 0.72) 0%, rgba(0, 0, 0, 0.28) 32%, transparent 58%),
      linear-gradient(to bottom, rgba(0, 0, 0, 0.38) 0%, transparent 26%);
  }

  /* BE-style overlay content: text sits on the image.
     Kicker top-right, headline + CTA bottom-left.
     Text is restrained — it must not dominate the image. */
  .slide-content {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    padding: 0;
    padding-bottom: clamp(1.5rem, 3.5vw, 2.5rem);
    gap: 0.85rem;
    pointer-events: none;
  }

  /* Interactive children re-enable pointer events */
  .slide-content a,
  .slide-content button {
    pointer-events: auto;
  }

  .slide-content .kicker {
    position: absolute;
    top: clamp(1.5rem, 3.5vw, 2.5rem);
    left: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    gap: 0.5rem;
    margin-bottom: 0;
    max-width: 46%;
  }

  .slide-title {
    /* Restrained headline: present but not dominating the image.
       Smaller than BE's hero type — the image is the hero here. */
    font-size: clamp(1.25rem, 1.9vw, 1.9rem);
    line-height: 1.08;
    font-weight: 800;
    max-width: 22ch;
    text-wrap: balance;
    margin-bottom: 0;
    color: #fff;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.55);
    transform: translateY(16px);
    opacity: 0;
    transition: transform 0.4s cubic-bezier(0.22, 0.61, 0.36, 1), opacity 0.4s ease;
  }

  .kicker {
    transform: translateY(8px);
    opacity: 0;
    transition: transform 0.35s ease, opacity 0.35s ease;
    transition-delay: 0.05s;
  }

  .cta-anim {
    transform: translateY(8px);
    opacity: 0;
    transition: transform 0.35s ease, opacity 0.35s ease;
    transition-delay: 0.18s;
  }

  /* Animate content in on active slide */
  .carousel-slide.active .slide-title,
  .carousel-slide.active .kicker,
  .carousel-slide.active .cta-anim {
    transform: translateY(0);
    opacity: 1;
  }
  
  .carousel-slide.active .slide-title { transition-delay: 0.08s; }
  .carousel-slide.active .kicker { transition-delay: 0.03s; }
  .carousel-slide.active .cta-anim { transition-delay: 0.18s; }

  /* HQ-sized CTA: compact, sits just below the headline in the
     bottom-left cluster. */
  .slide-content .btn.cta-anim {
    align-self: flex-start;
    margin-top: 0.25rem;
    padding: 0.75rem 1.5rem;
    font-size: 0.78rem;
  }

  /* Coming Soon teaser tag: non-clickable, same placement as the CTA. */
  .teaser-tag {
    font-family: var(--font-body);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
    border: 1px solid var(--line);
    padding: 0.6rem 1.2rem;
    font-size: 0.8125rem;
    font-weight: 600;
    display: inline-block;
  }

  .slide-content .teaser-tag.cta-anim {
    align-self: flex-start;
    margin-top: 2.75rem;
  }

  /* Table of Contents: in normal flow below the slides (not overlaid).
     The stacked layout puts media → content → TOC in document order. */
  .carousel-toc {
    position: relative;
    width: 100%;
    z-index: 10;
    padding-top: 1rem;
    padding-bottom: clamp(1.5rem, 4vw, 3rem);
  }

  .toc-inner {
    display: grid;
    grid-template-columns: repeat(var(--slide-count, 4), 1fr);
    gap: 1rem;
  }

  @media (max-width: 900px) {
    .toc-inner {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
    .carousel-toc { padding-bottom: 1.5rem; }
  }

  .toc-btn {
    appearance: none;
    background: transparent;
    border: none;
    padding: 0.5rem 0;
    text-align: left;
    cursor: pointer;
    color: var(--muted);
    transition: color 0.3s ease;
  }

  .toc-btn:hover,
  .toc-btn:focus-visible {
    color: var(--ink);
  }

  .toc-label {
    display: block;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  .toc-progress-track {
    width: 100%;
    height: 2px;
    background: rgba(255, 255, 255, 0.18); /* Visible on black; was --line (#1a1a1a) which was nearly invisible */
  }

  .toc-progress-fill {
    height: 100%;
    width: 0%;
    background: var(--ink); /* White on parent surfaces per Color Addendum */
  }

  .toc-btn.active {
    color: var(--ink);
  }

  /* HQ player controls: square prev / play-pause / next buttons. */
  .player-controls {
    grid-column: 1 / -1;
    justify-self: start;
    display: flex;
    gap: 0.5rem;
  }

  .player-btn {
    appearance: none;
    width: 44px;
    height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.25);
    color: var(--ink);
    cursor: pointer;
    transition: border-color 0.25s ease, box-shadow 0.25s ease, background-color 0.25s ease;
  }

  .player-btn:hover,
  .player-btn:focus-visible {
    border-color: var(--color-accent);
    box-shadow: 0 0 18px rgba(178, 178, 178, 0.35);
    outline: none;
  }

  /* Accessibility / Performance: Kill animations if requested */
  @media (prefers-reduced-motion: reduce) {
    .slide-media img,
    .carousel-slide,
    .slide-title,
    .kicker,
    .cta-anim {
      transition: none !important;
      transform: none !important;
      animation: none !important;
    }
    .toc-progress-fill {
      transition: none !important;
    }
  }

  /* Mobile hero: Replicates mobile image orientation and overlay pattern (img_4264 spec).
     Media fits in 16:9 landscape orientation with image fitting cleanly.
     Metadata chips are placed at top-left overlaid on the image with scrim.
     Headline is punchy and placed at bottom-left overlaid on the image with shadow.
     Watch CTA button is visible and active directly below the headline.
     TOC and player controls flow cleanly below the hero. */
  @media (max-width: 768px) {
    .brand-carousel {
      height: auto;
      margin-top: 0;
      padding-top: 0;
      padding-block-start: 0;
      position: relative;
      width: 100%;
      overflow: hidden;
    }
    .carousel-track {
      position: relative;
      inset: auto;
      height: auto;
      display: grid;
      width: 100%;
      flex: none;
    }
    .carousel-slide {
      position: relative;
      inset: auto;
      grid-area: 1 / 1;
      width: 100%;
      display: block;
      transform: none;
    }
    .carousel-slide.active {
      transform: none;
    }
    .carousel-slide:not(.active) {
      position: absolute;
      inset: 0;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }
    /* Mobile orientation: 16:9 landscape ratio so hero image fits naturally on phones without aggressive cropping */
    .slide-media {
      position: relative;
      inset: auto;
      width: 100%;
      height: auto;
      aspect-ratio: 16 / 9;
      min-height: 220px;
      max-height: 52vh;
      overflow: hidden;
      flex: none;
      background: #080808;
    }
    .slide-media img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
    }
    .slide-media[data-empty-media] {
      display: none;
    }
    .carousel-slide:has(.slide-media[data-empty-media]) {
      justify-content: center;
    }
    /* Scrim active on mobile: ensures high contrast for overlaid text */
    .slide-scrim {
      display: block !important;
      position: absolute;
      inset: 0;
      z-index: 1;
      pointer-events: none;
      background:
        linear-gradient(to top, rgba(0, 0, 0, 0.9) 0%, rgba(0, 0, 0, 0.45) 45%, rgba(0, 0, 0, 0.1) 65%, transparent 80%),
        linear-gradient(to bottom, rgba(0, 0, 0, 0.72) 0%, rgba(0, 0, 0, 0.25) 30%, transparent 50%);
    }
    /* Overlay content: sits directly on top of the image */
    .slide-content {
      position: absolute !important;
      inset: 0 !important;
      height: 100% !important;
      z-index: 2 !important;
      display: flex !important;
      flex-direction: column !important;
      justify-content: flex-end !important;
      align-items: flex-start !important;
      padding: clamp(0.75rem, 3vw, 1.25rem) !important;
      padding-bottom: clamp(0.85rem, 3.5vw, 1.35rem) !important;
      gap: 0.35rem !important;
      pointer-events: none !important;
    }
    .slide-content a,
    .slide-content button {
      pointer-events: auto !important;
    }
    /* Metadata chips placed at top-left of the image */
    .slide-content .kicker {
      position: absolute !important;
      top: clamp(0.75rem, 3vw, 1.25rem) !important;
      left: clamp(0.75rem, 3vw, 1.25rem) !important;
      margin: 0 !important;
      display: flex !important;
      flex-wrap: wrap !important;
      justify-content: flex-start !important;
      gap: 0.35rem !important;
      max-width: 85% !important;
      z-index: 3 !important;
    }
    .slide-content .kicker .chip {
      font-size: 0.62rem !important;
      padding: 0.2rem 0.5rem !important;
      letter-spacing: 0.14em !important;
      background: rgba(10, 10, 10, 0.85) !important;
      backdrop-filter: blur(8px) !important;
      -webkit-backdrop-filter: blur(8px) !important;
      border: 1px solid rgba(255, 255, 255, 0.25) !important;
      color: #f0f0f0 !important;
    }
    /* Headline positioned bottom-left over the image */
    .slide-title {
      font-family: var(--font-display) !important;
      font-size: clamp(1.15rem, 4.8vw, 1.65rem) !important;
      font-weight: 800 !important;
      line-height: 1.08 !important;
      letter-spacing: -0.01em !important;
      text-transform: uppercase !important;
      color: #ffffff !important;
      text-shadow: 0 2px 14px rgba(0, 0, 0, 0.9) !important;
      margin: 0 !important;
      max-width: 22ch !important;
      text-wrap: balance !important;
    }
    /* Watch CTA button visible directly under the headline */
    .slide-content .btn.cta-anim {
      display: inline-flex !important;
      align-self: flex-start !important;
      margin-top: 0.15rem !important;
      padding: 0.45rem 0.95rem !important;
      font-size: 0.7rem !important;
      font-weight: 600 !important;
      letter-spacing: 0.1em !important;
      text-transform: uppercase !important;
      background: #ffffff !important;
      color: #080808 !important;
      border: 1px solid #ffffff !important;
      box-shadow: 0 3px 14px rgba(0, 0, 0, 0.6) !important;
    }
    .slide-content .teaser-tag.cta-anim {
      display: inline-block !important;
      align-self: flex-start !important;
      margin-top: 0.15rem !important;
      padding: 0.45rem 0.9rem !important;
      font-size: 0.68rem !important;
    }
    .carousel-slide.active .slide-title,
    .carousel-slide.active .kicker,
    .carousel-slide.active .cta-anim {
      opacity: 1 !important;
      transform: none !important;
      visibility: visible !important;
    }
    .slide-play {
      width: 52px;
      height: 52px;
      opacity: 0.85;
    }
    .carousel-toc {
      position: relative;
      margin-top: 0;
      padding-top: 0.75rem;
      padding-bottom: 1.25rem;
    }
    .toc-inner {
      grid-template-columns: repeat(2, 1fr) !important;
      gap: 0.75rem 1rem !important;
    }
    .player-controls {
      grid-column: 1 / -1 !important;
      margin-top: 0.25rem !important;
    }
  }
</style>

<script>
  class BrandCarousel {
    private section: HTMLElement;
    private slides: NodeListOf<HTMLElement>;
    private tocBtns: NodeListOf<HTMLElement>;
    private announcer: HTMLElement | null;
    private playPauseBtn: HTMLButtonElement | null;
    private prevBtn: HTMLButtonElement | null;
    private nextBtn: HTMLButtonElement | null;
    private activeIndex: number = 0;
    private duration: number = 6000;
    private timer: number | null = null;
    private startTime: number = 0;
    private remainingTime: number = 0;
    private isPaused: boolean = false;
    private userPaused: boolean = false;

    constructor(el: HTMLElement) {
      this.section = el;
      this.slides = this.section.querySelectorAll('.carousel-slide');
      this.tocBtns = this.section.querySelectorAll('.toc-btn');
      this.announcer = this.section.querySelector('#carousel-announcer');
      this.playPauseBtn = this.section.querySelector('.carousel-play-pause');
      this.prevBtn = this.section.querySelector('.player-prev');
      this.nextBtn = this.section.querySelector('.player-next');
      
      if (!this.slides.length || !this.tocBtns.length) return;

      this.init();
    }

    init() {
      // Check for reduced motion
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        this.userPaused = true;
        this.isPaused = true;
        this.updatePlayPauseIcon();
      }

      // TOC Click Handlers
      this.tocBtns.forEach((btn, i) => {
        btn.addEventListener('click', () => this.goToSlide(i));
      });

      // Play/Pause Click
      if (this.playPauseBtn) {
        this.playPauseBtn.addEventListener('click', () => {
          this.userPaused = !this.userPaused;
          if (this.userPaused) {
            this.pause();
          } else {
            this.resume();
          }
          this.updatePlayPauseIcon();
        });
      }

      // Prev / Next
      if (this.prevBtn) {
        this.prevBtn.addEventListener('click', () => this.goToSlide((this.activeIndex - 1 + this.slides.length) % this.slides.length));
      }
      if (this.nextBtn) {
        this.nextBtn.addEventListener('click', () => this.goToSlide((this.activeIndex + 1) % this.slides.length));
      }

      // Auto-pause on hover and focus
      this.section.addEventListener('mouseenter', () => this.pause());
      this.section.addEventListener('mouseleave', () => {
        if (!this.userPaused) this.resume();
      });
      this.section.addEventListener('focusin', () => this.pause());
      this.section.addEventListener('focusout', () => {
        // slight delay to check if focus completely left the carousel
        setTimeout(() => {
          if (!this.section.contains(document.activeElement) && !this.userPaused) {
            this.resume();
          }
        }, 10);
      });

      // Keyboard support
      this.section.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') {
          this.goToSlide((this.activeIndex + 1) % this.slides.length);
        } else if (e.key === 'ArrowLeft') {
          this.goToSlide((this.activeIndex - 1 + this.slides.length) % this.slides.length);
        }
      });

      // Start animation loop
      this.startTime = performance.now();
      this.remainingTime = this.duration;
      this.tick();
    }

    goToSlide(index: number) {
      if (index === this.activeIndex) return;
      
      // Reset previous
      const prevBtn = this.tocBtns[this.activeIndex];
      const prevFill = prevBtn.querySelector('.toc-progress-fill') as HTMLElement;
      if (prevFill) prevFill.style.width = '0%';
      
      this.slides[this.activeIndex].classList.remove('active');
      this.slides[this.activeIndex].setAttribute('aria-hidden', 'true');
      this.tocBtns[this.activeIndex].classList.remove('active');

      // Set new
      this.activeIndex = index;

      const newSlide = this.slides[this.activeIndex];
      newSlide.classList.add('active');
      newSlide.setAttribute('aria-hidden', 'false');
      this.tocBtns[this.activeIndex].classList.add('active');

      // Announce for Screen Readers
      if (this.announcer) {
        const title = newSlide.querySelector('.slide-title')?.textContent || '';
        this.announcer.textContent = `Slide ${index + 1} of ${this.slides.length}: ${title}`;
      }

      // Reset timer
      this.startTime = performance.now();
      this.remainingTime = this.duration;
    }

    pause() {
      this.isPaused = true;
    }

    resume() {
      this.isPaused = false;
      this.startTime = performance.now();
    }

    updatePlayPauseIcon() {
      if (!this.playPauseBtn) return;
      const iconPlay = this.playPauseBtn.querySelector('.icon-play') as HTMLElement;
      const iconPause = this.playPauseBtn.querySelector('.icon-pause') as HTMLElement;
      
      if (this.userPaused) {
        iconPlay.style.display = 'block';
        iconPause.style.display = 'none';
        this.playPauseBtn.setAttribute('aria-pressed', 'true');
        this.playPauseBtn.setAttribute('aria-label', 'Play carousel');
      } else {
        iconPlay.style.display = 'none';
        iconPause.style.display = 'block';
        this.playPauseBtn.setAttribute('aria-pressed', 'false');
        this.playPauseBtn.setAttribute('aria-label', 'Pause carousel');
      }
    }

    tick = () => {
      if (!this.isPaused) {
        const now = performance.now();
        const elapsed = now - this.startTime;
        this.remainingTime -= elapsed;
        this.startTime = now;

        if (this.remainingTime <= 0) {
          this.goToSlide((this.activeIndex + 1) % this.slides.length);
        } else {
          const progress = 1 - (this.remainingTime / this.duration);
          const activeBtn = this.tocBtns[this.activeIndex];
          const activeFill = activeBtn.querySelector('.toc-progress-fill') as HTMLElement;
          if (activeFill) {
            activeFill.style.width = `${progress * 100}%`;
          }
        }
      } else {
        this.startTime = performance.now();
      }

      this.timer = requestAnimationFrame(this.tick);
    }
  }

  const initCarousels = () => {
    document.querySelectorAll('.brand-carousel').forEach(el => {
      new BrandCarousel(el as HTMLElement);
    });
  };

  initCarousels();
</script>
