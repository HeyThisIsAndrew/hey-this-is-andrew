{
  "name": "andrew-sites",
  "private": true,
  "description": "Andrew's website builder: shared building blocks (packages/) and the sites made from them (sites/).",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "review": "node scripts/site.mjs review",
    "dev": "node scripts/site.mjs dev",
    "photos": "node scripts/site.mjs photos",
    "clean": "node scripts/site.mjs clean",
    "check": "node scripts/site.mjs check",
    "build": "pnpm -r --filter \"./sites/*\" --filter \"./templates/*\" build",
    "test": "pnpm -r --if-present test",
    "new-site": "node scripts/new-site.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^30.1.2",
    "typescript-eslint": "^8.71.1"
  }
}
