---
/**
 * BaseLayout: the shared @andrew/ui chrome (Nav, Footer, ChromeMeta) over
 * @andrew/tokens, with Reelay's theme and global styles layered on top.
 *
 * Everything is first-party: no third-party scripts, styles or fonts, so the
 * site needs no cookie banner. Keep it that way (the audit checks).
 */
import '@fontsource-variable/inter';
import '@andrew/tokens/tokens.css';
import '../styles/theme.css';
import '@andrew/ui/styles/base.css';
import '../styles/global.css';
import PageNav from '@andrew/ui/PageNav.astro';
import SectionBar from '../components/SectionBar.astro';
import Nav from '@andrew/ui/Nav.astro';
import Footer from '@andrew/ui/Footer.astro';
import ChromeMeta from '@andrew/ui/ChromeMeta.astro';
import logo from '../assets/logo-light.svg';
import logoDark from '../assets/logo-dark.svg';
import { SITE, NAV_LINKS, FOOTER_EXPLORE, UTILITY_LINKS, SOCIALS, homeUrl, href } from '../data/site';
import { OPERATOR, CONTACTS, TRADEMARKS, LIMITED_USE } from '../data/operator';

interface Props {
  title?: string;
  description?: string;
  /** Show the product sub-nav (product and feature pages). */
  subnav?: boolean;
  /** Structured data for this page (schema.org JSON-LD). */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  /** The side pane's title: the page's own name (default: the title before its colon). */
  pane?: string;
  /** The side pane's entries, when the page's headings can't supply them (DocPage's contents). */
  paneItems?: { id: string; label: string }[];
}

const {
  title = `${SITE.fullName}: ${SITE.tagline}`,
  description = SITE.description,
  subnav = false,
  jsonLd,
  noindex: pageNoindex = false,
  pane,
  paneItems,
} = Astro.props;
const paneHeading = pane ?? title.split(':')[0].trim();
/* REELAY_NOINDEX=1 marks a whole build as a preview (the GitHub Pages copy). */
const noindex = pageNoindex || import.meta.env.REELAY_NOINDEX === '1';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const site = Astro.site || new URL(SITE.url);
const canonicalURL = new URL(Astro.url.pathname, site);
/* One Open Graph image per page: public/og/<slug>.png (scripts/make-og.mjs). */
const pagePath = Astro.url.pathname.startsWith(base) ? Astro.url.pathname.slice(base.length) : Astro.url.pathname;
const slug = pagePath.replace(/^\/|\/$/g, '').replace(/\//g, '-') || 'home';
const ogImage = new URL(`${base}og/${slug}.png`, site).href;
const logoAsset = { src: logo.src, darkSrc: logoDark.src, width: 132, height: 32, alt: SITE.fullName };
/* Until the operator's details are filled in (src/data/operator.ts), the footer
   on every page says what Reelay is instead of printing {{PLACEHOLDERS}}. The
   legal pages still print them, so a REELAY_RELEASE=1 audit still fails. */
const operatorKnown = ![OPERATOR.legalEntity, OPERATOR.address, OPERATOR.country].some((v) => v.includes('{{'));
const operatorLine = operatorKnown
  ? `Reelay is operated by ${OPERATOR.legalEntity}, ${OPERATOR.address}, ${OPERATOR.country}. Contact: ${CONTACTS.support}.`
  : `Reelay Studio is a local-first desktop application in development and not yet released. Contact: ${CONTACTS.support}.`;
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="en" data-subnav={subnav ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <ChromeMeta color="#000000" lightColor="#ffffff" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.name}: ${title}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    {ld.map((d) => <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', ...d })} />)}
  </head>
  <body id="top">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Nav logo={logoAsset} homeHref={homeUrl} links={NAV_LINKS} />
    {/* The page's sections live here, not in the menu: the phone menu is top
        level only (Nav.astro). Titled with the page's name, it lists the
        page's TOP-LEVEL sections only ([data-sec], see SectionBar): never an
        accordion row or a card inside one, so a jump never opens anything.
        The first entry is the page's opening, under a real name (the hero's
        own data-pn-label), never "Top". */}
    <div class="scroll-progress" data-scroll-progress aria-hidden="true"></div>
    <PageNav heading={paneHeading} items={paneItems} selector="main [data-sec]" topLabel="Overview" />
    <SectionBar />
    <main id="main-content">
      <slot />
    </main>
    <Footer
      logo={logoAsset}
      homeHref={homeUrl}
      tagline={SITE.tagline}
      explore={FOOTER_EXPLORE}
      socials={SOCIALS}
      copyright={SITE.copyright}
      privacyHref={href('/privacy')}
      utility={UTILITY_LINKS}
      notes={[operatorLine, LIMITED_USE, TRADEMARKS]}
    />
    <script>
      import { initSectionAnchors } from '@andrew/ui/scripts/section-anchors.ts';
      initSectionAnchors();

      // Reading progress, where CSS can't drive it from a scroll timeline.
      const bar = document.querySelector<HTMLElement>('[data-scroll-progress]');
      if (bar && !CSS.supports('animation-timeline: scroll()')) {
        let queued = false;
        const draw = () => {
          queued = false;
          const max = document.documentElement.scrollHeight - window.innerHeight;
          bar.style.setProperty('--scroll', String(max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0));
        };
        const queue = () => { if (!queued) { queued = true; requestAnimationFrame(draw); } };
        window.addEventListener('scroll', queue, { passive: true });
        window.addEventListener('resize', queue, { passive: true });
        draw();
      }

      // Fade stages up as they arrive. Content is only hidden once this
      // script runs (html.js), and never under reduced motion.
      const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
      const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!still && 'IntersectionObserver' in window && items.length) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
        );
        items.forEach((el) => io.observe(el));
      } else {
        items.forEach((el) => el.classList.add('is-in'));
      }
    </script>
  </body>
</html>
