---
import DocPage from '../components/ui/DocPage.astro';
import { SITE, href } from '../data/site';
import { OPERATOR, CONTACTS } from '../data/operator';
const ph = (v: string) => /\{\{/.test(v);
const toc: [string, string][] = [
  ['policy', 'Our policy'],
  ['notice', 'Reporting infringement'],
  ['counter', 'Counter-notice'],
  ['agent', 'Designated agent'],
  ['repeat', 'Repeat infringers'],
];
---

<DocPage
  eyebrow="Legal"
  title="Copyright"
  pageTitle={`Copyright and DMCA: ${SITE.fullName}`}
  description="How to report copyright infringement involving Reelay or this website, the counter-notice process, and our designated agent."
  updated="October 12, 2026"
  toc={toc}
>
  <Fragment slot="lede">Reelay is for media you own or are authorised to manage. <strong>If you believe your work is being infringed, here is how to tell us.</strong></Fragment>

  <section id="policy">
    <h2>Our policy</h2>
    <p>Reelay is software that runs on its users’ Macs. We don’t host, store or publish videos: posts go from a user’s Mac to the platform they chose, under that platform’s own copyright rules. So if infringing content appears on TikTok, Instagram, YouTube, Snapchat, Threads, Facebook or Bluesky, the fastest route is that platform’s own copyright report.</p>
    <p>Our <a href={href('/terms')}>Terms</a> require users to import and republish only media they own or are authorised to manage. We respond to notices about this website and about content we host, and we act on reports that someone is using Reelay to infringe.</p>
  </section>

  <section id="notice">
    <h2>Reporting infringement</h2>
    <p>Send a written notice to our designated agent below that includes:</p>
    <ol>
      <li>your physical or electronic signature;</li>
      <li>the copyrighted work you believe is infringed;</li>
      <li>the material you believe infringes it, with enough detail for us to find it (for example, its address);</li>
      <li>your name, address, telephone number and email;</li>
      <li>a statement that you have a good-faith belief the use isn’t authorised by the copyright owner, its agent or the law; and</li>
      <li>a statement, under penalty of perjury, that the information in your notice is accurate and that you are the copyright owner or authorised to act for them.</li>
    </ol>
  </section>

  <section id="counter">
    <h2>Counter-notice</h2>
    <p>If material you posted was removed because of a notice and you believe that was a mistake or misidentification, you can send a counter-notice to the same agent, including:</p>
    <ol>
      <li>your physical or electronic signature;</li>
      <li>the material that was removed and where it appeared before;</li>
      <li>a statement, under penalty of perjury, that you have a good-faith belief it was removed as a result of mistake or misidentification;</li>
      <li>your name, address and telephone number, and a statement that you consent to the jurisdiction of the federal court for your address (or, outside the United States, any judicial district where we may be found), and that you will accept service of process from the person who sent the notice.</li>
    </ol>
    <p>We forward a valid counter-notice to the person who sent the original notice. Unless they tell us within 10 to 14 business days that they have filed a court action, the material may be restored.</p>
  </section>

  <section id="agent">
    <h2>Designated agent</h2>
    <dl class="facts">
      <div><dt>Agent</dt><dd><span class:list={[{ 'placeholder-token': ph(OPERATOR.dmcaAgent) }]}>{OPERATOR.dmcaAgent}</span></dd></div>
      <div><dt>Email</dt><dd><a href={`mailto:${CONTACTS.copyright}`}>{CONTACTS.copyright}</a></dd></div>
      <div><dt>Post</dt><dd><span class:list={[{ 'placeholder-token': ph(OPERATOR.address) }]}>{OPERATOR.address}</span></dd></div>
    </dl>
    <p>Notices that misrepresent infringement can create liability for the sender.</p>
  </section>

  <section id="repeat">
    <h2>Repeat infringers</h2>
    <p>Where we can identify someone who repeatedly uses Reelay to infringe, we end their licence under the Terms.</p>
  </section>
</DocPage>
