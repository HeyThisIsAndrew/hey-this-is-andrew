---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import GatekeeperSteps from '../components/ui/GatekeeperSteps.astro';
import { SITE, DATA_PATHS, href } from '../data/site';
import { RELEASE, CHANGELOG } from '../data/release';
import { softwareApplication } from '../data/seo';

const latest = CHANGELOG[0];
const apple = 'M16.4 12.6c0-2.4 2-3.6 2.1-3.6-1.1-1.7-2.9-1.9-3.5-1.9-1.5-.2-2.9.9-3.7.9-.8 0-1.9-.9-3.2-.8-1.6 0-3.1 1-4 2.4-1.7 3-.4 7.4 1.2 9.8.8 1.2 1.8 2.5 3 2.4 1.2 0 1.7-.8 3.1-.8s1.9.8 3.2.8c1.3 0 2.2-1.2 3-2.4.9-1.4 1.3-2.7 1.3-2.8 0 0-2.5-1-2.5-4zM14 5.4c.7-.8 1.1-1.9 1-3-.9 0-2.1.6-2.8 1.4-.6.7-1.2 1.8-1 2.9 1.1.1 2.1-.6 2.8-1.3z';
---

<BaseLayout
  title={`Download Reelay: ${SITE.fullName}`}
  description={`Download Reelay ${RELEASE.label} for Mac (${RELEASE.requirements}). Free during the beta. Release notes, SHA-256 checksum, first-open steps and how to uninstall.`}
  subnav
  jsonLd={softwareApplication()}
>
  <PageHero eyebrow="Download">
    <Fragment slot="title">Reelay for Mac.</Fragment>
    <Fragment slot="lede">Free during the beta. No account to create. <strong>{RELEASE.requirements}.</strong></Fragment>
  </PageHero>

  <section class="stage stage--flush-top" aria-labelledby="get-title">
    <div class="wrap">
      <h2 id="get-title" class="sr-only">Get the app</h2>
      <div class="get panel">
        <span class="get-glyph" aria-hidden="true"><svg viewBox="0 0 24 24"><path fill="currentColor" d={apple} /></svg></span>
        <dl class="get-facts">
          <div><dt>Version</dt><dd>{RELEASE.label}</dd></div>
          <div><dt>Released</dt><dd><time datetime={RELEASE.date}>{RELEASE.dateLabel}</time></dd></div>
          <div><dt>Size</dt><dd>{RELEASE.size}</dd></div>
          <div><dt>Requires</dt><dd>{RELEASE.requirements}</dd></div>
        </dl>
        <a class="btn btn-primary btn-lg" href={RELEASE.href}>Download {RELEASE.filename}</a>
        <div class="get-sha">
          <p>SHA-256</p>
          <code>{RELEASE.sha256}</code>
          <p class="fine">Check it in Terminal with <code>shasum -a 256 ~/Downloads/{RELEASE.filename}</code></p>
        </div>
      </div>

      <div class="mt-3"><GatekeeperSteps /></div>
    </div>
  </section>

  <section class="stage stage--lift" id="release-notes" aria-labelledby="notes-title">
    <div class="wrap-narrow">
      <p class="eyebrow">Release notes</p>
      <h2 id="notes-title" class="title">What’s new in {latest.version}</h2>
      <ul class="notes">{latest.items.map((i) => <li>{i}</li>)}</ul>
      <p class="mt-2"><a class="link-more" href={href('/changelog')}>Every release</a></p>
    </div>
  </section>

  <section class="stage" id="uninstall" aria-labelledby="un-title">
    <div class="wrap-narrow">
      <p class="eyebrow">Uninstall</p>
      <h2 id="un-title" class="title">Remove Reelay completely.</h2>
      <ol class="un">
        <li>Quit Reelay and drag it from Applications to the Trash.</li>
        <li>Delete its data folder, <code>{DATA_PATHS.mac}</code>, and its logs, <code>{DATA_PATHS.logs}</code>. In Terminal:<pre><code>rm -rf ~/Library/Application\ Support/Reelay ~/Library/Logs/Reelay</code></pre></li>
        <li>Open Keychain Access and delete the items named <strong>{DATA_PATHS.keychainService}</strong>.</li>
        <li>Your videos stay in your library folder (by default <code>{DATA_PATHS.library}</code>) until you delete them.</li>
      </ol>
      <p class="fine mt-2">Disconnect your accounts in Reelay first if you want it to revoke access with the platforms. See <a href={href('/data-deletion')}>Data Deletion</a>.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .get { display: grid; justify-items: center; gap: 1.5rem; padding: clamp(2rem, 5vw, 3.5rem); text-align: center; max-width: 52rem; margin: 0 auto; }
  .get-glyph { color: var(--r-ink); }
  .get-glyph svg { width: 3rem; height: 3rem; }
  .get-facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 1rem 2rem; width: 100%; }
  .get-facts div { border-top: 1px solid var(--hairline-strong); padding-top: 0.75rem; text-align: left; }
  .get-facts dt { font-size: 0.8rem; color: var(--r-ink-3); }
  .get-facts dd { font-weight: 600; color: var(--r-ink); }
  .get .btn { white-space: normal; text-align: center; max-width: 100%; }
  .get-sha { display: grid; gap: 0.35rem; max-width: 100%; }
  .get-sha > p:first-child { font-size: 0.8rem; font-weight: 600; color: var(--r-ink-3); }
  .get-sha > code { font-size: 0.85rem; color: var(--r-amber-text); overflow-wrap: anywhere; }
  .get-sha .fine code { overflow-wrap: anywhere; }
  .notes { margin-top: 1.5rem; padding-left: 1.2rem; display: grid; gap: 0.75rem; color: var(--r-ink-2); }
  .un { margin-top: 1.5rem; padding-left: 1.2rem; display: grid; gap: 0.9rem; color: var(--r-ink-2); }
  .un pre { margin-top: 0.6rem; padding: 0.85rem 1rem; border-radius: 12px; background: var(--r-code-bg); overflow-x: auto; color: var(--r-ink); }
  .un code { color: var(--r-ink); }
</style>
