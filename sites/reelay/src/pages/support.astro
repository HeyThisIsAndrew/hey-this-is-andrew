---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import Faq from '../components/ui/Faq.astro';
import GatekeeperSteps from '../components/ui/GatekeeperSteps.astro';
import PermissionsTable from '../components/ui/PermissionsTable.astro';
import { SITE, DATA_PATHS, AGENT_API, href } from '../data/site';
import { RELEASE } from '../data/release';
import { CONTACTS } from '../data/operator';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

interface GuideDetail {
  title: string;
  lines: string[];
}

interface HelpGuide {
  id: string;
  aliases?: string[];
  title: string;
  doing: string;
  slot:
    | 'branding'
    | 'library-grid'
    | 'download-sources'
    | 'command-center'
    | 'board'
    | 'automations'
    | 'agents-settings'
    | 'accounts';
  shotAlt: string;
  steps: string[];
  expect: string;
  details?: GuideDetail[];
  keywords: string;
  videoTitle?: string;
}

interface HelpCategory {
  id: string;
  number: string;
  title: string;
  blurb: string;
  badge: string;
  guides: HelpGuide[];
}

/* 6-Step Studio Tour (ported from Content_Downloader/reelay/gui/help_content.py TOUR) */
const tourSteps: HelpGuide[] = [
  {
    id: 'tour-profiles',
