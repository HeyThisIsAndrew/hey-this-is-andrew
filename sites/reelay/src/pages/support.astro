---
/**
 * Support: the Help Center, the reviewer permissions, questions and contact.
 *
 * The Help Center is the app's own (reelay/gui/help_content.py), copied in
 * as data by scripts/sync-help.mjs: the Get Started tour, six topics and
 * their guides, word for word, with the app's screenshots, crops and
 * numbered markers. Never retype it here: change the app's help, then run
 *   node scripts/sync-help.mjs <app checkout>
 * The audit fails when a guide is missing from this page or a picture
 * differs from the app's.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import Faq from '../components/ui/Faq.astro';
import GatekeeperSteps from '../components/ui/GatekeeperSteps.astro';
import PermissionsTable from '../components/ui/PermissionsTable.astro';
import HelpGuide from '../components/ui/HelpGuide.astro';
import helpData from '../data/help.json';
import { SITE, DATA_PATHS, AGENT_API, href } from '../data/site';
import { CONTACTS } from '../data/operator';

interface Step { text: string; mark: string }
interface Guide { key: string; title: string; doing: string; visual: unknown; steps: Step[]; expect: string; details: { title: string; lines: string[] }[]; related: string[]; keywords: string; note: string }
interface Help {
  tour: { key: string; title: string; goal: string; visual: unknown; steps: Step[]; next: string; note: string }[];
  categories: { key: string; title: string; blurb: string; guides: Guide[] }[];
}
const help = helpData as unknown as Help;
const guides = help.categories.flatMap((c) => c.guides);
const guideCount = guides.length;
const titleOf = Object.fromEntries(guides.map((g) => [g.key, g.title]));
const related = (keys: string[]) => keys.filter((k) => titleOf[k]).map((k) => ({ id: k, title: titleOf[k] }));
const num = (i: number) => String(i + 1).padStart(2, '0');

/* Addresses this page has had, kept so old links still land: the section
   names of the first Help Center draft, and the old YouTube setup anchors. */
const TOPIC_ALIASES: Record<string, string[]> = {
  library: ['media-library'],
  board: ['the-board'],
  publishing: ['accounts-signin'],
  settings: ['getting-started'],
  privacy: ['video-player'],
};
const GUIDE_ALIASES: Record<string, string[]> = { 'accounts-connect': ['connecting-youtube', 'youtube-setup'] };

const faq = [
  { q: 'Where are my videos and my database?', a: `<p>Videos go into the library folder you choose, by default <code>${DATA_PATHS.library}</code>. Everything else is in one database, <code>${DATA_PATHS.dbName}</code>, in <code>${DATA_PATHS.mac}</code>. You can move the database under <strong>Settings → Data</strong>.</p>` },
  { q: 'Where do transcripts come from?', a: '<p>From the original post’s own captions: the creator’s subtitles first, otherwise the platform’s automatic captions. Use <strong>Get from Original Post</strong> on a ticket. Reelay doesn’t run speech recognition to make transcripts, so a video posted without captions has none to fetch.</p>' },
  { q: 'Why doesn’t Reelay post to TikTok, Instagram or Snapchat for me?', a: '<p>Reelay prepares the caption and the file for them and you post in their own app, which keeps sounds, tags and Shop links. <strong>Prepare to Publish</strong> checks the file and caption, copies the caption, opens the uploader and shows the video in Finder; then you mark it posted.</p>' },
  { q: 'How do I turn on Bluesky, Threads or Facebook posting?', a: '<p>Connect the account under <strong>Accounts</strong>, switch the platform on under <strong>Settings → Automatic posting</strong>, and restart Reelay. Bluesky and Threads posts go out at their time while Reelay is running and the Mac is awake; Facebook schedules them itself.</p>' },
  { q: 'How do I disconnect an account?', a: `<p>Click <strong>Disconnect</strong> on its card under <strong>Accounts</strong>. Reelay revokes access where the platform allows it, deletes the token from your Keychain and removes the account. See <a href="${href('/data-deletion')}">Data Deletion</a> to remove everything.</p>` },
  { q: 'Can I connect an AI agent?', a: `<p>Yes, through the Agent API on <code>${AGENT_API.host}:${AGENT_API.port}</code>. <strong>Settings → AI agents</strong> shows its address and the access key. See <a href="${href('/ai')}">Agents</a>. An MCP endpoint is planned but isn’t in the app yet.</p>` },
  { q: 'What does Reelay run on?', a: `<p>A Mac with Apple silicon on macOS 12 Monterey or later: that’s the ready-to-run release package. On Windows 10 or 11 you build it yourself with the included PowerShell script, and on Linux you run it from source with Python 3.11 or later. <a href="${href('/download')}">Setup steps</a>.</p>` },
];
---

<BaseLayout
  title={`Support: ${SITE.fullName}`}
  description={`Reelay Studio's Help Center: a ${help.tour.length}-step Get Started tour and ${guideCount} short visual guides, the same ones as in the app. Plus the permissions Reelay asks each platform for, questions and contact.`}
>
  <PageHero eyebrow="Help Center">
    <Fragment slot="title">How Reelay works,<br /><span class="text-glow">step by step.</span></Fragment>
    <Fragment slot="lede">
      The same {help.tour.length}-step tour and {guideCount} guides as the Help page in the app, with its pictures.
      <strong>Reviewing Reelay for Google, TikTok or Meta?</strong> See the <a href={href('/reviewers')}>reviewer notes</a> or the <a href="#demo-verification">requested permissions</a>.
    </Fragment>

    <div class="help-search-shell" data-help-search-shell hidden>
      <label class="sr-only" for="help-search-input">Search the Help Center</label>
      <div class="help-search-bar">
        <svg class="help-search-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <circle cx="8.5" cy="8.5" r="5.75" stroke="currentColor" stroke-width="1.8" />
          <path d="M13 13l4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
        </svg>
        <input id="help-search-input" class="help-search-input" type="search" placeholder="Search help: schedule, TikTok, archive…" autocomplete="off" data-help-search />
        <button type="button" class="help-search-clear" data-help-clear hidden>Clear</button>
      </div>
      <div class="help-search-meta">
        <span role="status" data-help-status>{help.tour.length} tour steps and {guideCount} guides</span>
        <div class="help-search-actions">
          <button type="button" class="help-action-btn" data-expand-all>Open all</button>
          <button type="button" class="help-action-btn" data-collapse-all>Close all</button>
        </div>
      </div>
    </div>
  </PageHero>

  <section class="stage stage--flush-top" aria-label="Help topics">
    <div class="wrap">
      <div class="bento cat-bento" data-reveal>
        {help.categories.map((c, i) => (
          <a class="tile span-2 cat-card" href={`#${c.key}`}>
            <span class="cat-num">{num(i)} · {c.guides.length} {c.guides.length === 1 ? 'guide' : 'guides'}</span>
            <h2 class="cat-title">{c.title}</h2>
            <p>{c.blurb}</p>
            <span class="link-more">Open {c.title}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="stage stage--lift" id="get-started" aria-labelledby="tour-heading" data-help-section>
    <div class="wrap">
      <header class="chapter-head" data-reveal>
        <p class="eyebrow">Get Started</p>
        <h2 id="tour-heading" class="title" data-pn-label="Get Started">From your first profile to a published video.</h2>
        <p class="lede">New to Reelay? <a href={href('/download')}>Download it</a>, then follow these {help.tour.length} steps. Each one is a step of the tour in the app.</p>
      </header>
      <div class="guide-stack">
        {help.tour.map((t, i) => (
          <HelpGuide id={`tour-${t.key}`} index={String(i + 1)} title={t.title} doing={t.goal} pill="Tour"
            visual={t.visual} steps={t.steps} expectLabel="Next:" expect={t.next} note={t.note}
            video={`help-tour-${t.key}`} />
        ))}
      </div>
      <div class="mt-3" data-reveal><GatekeeperSteps /></div>
    </div>
  </section>

  {help.categories.map((c, ci) => (
    <section class:list={['stage', { 'stage--lift': ci % 2 === 1 }]} id={c.key} aria-labelledby={`${c.key}-heading`} data-help-section>
      <div class="wrap">
        {(TOPIC_ALIASES[c.key] ?? []).map((a) => <span id={a} class="anchor-alias" aria-hidden="true"></span>)}
        {c.guides.flatMap((g) => GUIDE_ALIASES[g.key] ?? []).map((a) => <span id={a} class="anchor-alias" aria-hidden="true"></span>)}
        <header class="chapter-head" data-reveal>
          <p class="eyebrow">{num(ci)} · {c.guides.length} {c.guides.length === 1 ? 'guide' : 'guides'}</p>
          <h2 id={`${c.key}-heading`} class="title" data-pn-label={c.title}>{c.title}</h2>
          <p class="lede">{c.blurb}</p>
        </header>
        <div class="guide-stack">
          {c.guides.map((g, gi) => (
            <HelpGuide id={g.key} index={`${ci + 1}.${gi + 1}`} title={g.title} doing={g.doing} pill={c.title}
              visual={g.visual} steps={g.steps} expectLabel="What to expect:" expect={g.expect} note={g.note}
              details={g.details} related={related(g.related)} keywords={g.keywords}
              aliases={GUIDE_ALIASES[g.key]} video={`help-${g.key}`} />
          ))}
        </div>
      </div>
    </section>
  ))}

  <section class="stage stage--lift" id="demo-verification" aria-labelledby="review-title">
    <div class="wrap">
      <header class="chapter-head" data-reveal>
        <p class="eyebrow">App review</p>
        <h2 id="review-title" class="title" data-pn-label="Permissions">What Reelay asks each platform for.</h2>
        <p class="lede">The full notes for Google, TikTok and Meta reviewers, with test steps and app IDs, are on the <a href={href('/reviewers')}>reviewer page</a>.</p>
      </header>
      <div data-reveal><PermissionsTable headingLevel={3} /></div>
    </div>
  </section>

  <section class="stage" aria-labelledby="faq-title">
    <div class="wrap-narrow">
      <h2 id="faq-title" class="title" data-reveal data-pn-label="Questions">Questions</h2>
      <div class="mt-2" data-reveal><Faq items={faq} /></div>
    </div>
  </section>

  <section class="stage stage--tight" aria-labelledby="contact-title">
    <div class="wrap">
      <h2 id="contact-title" class="title center" data-reveal>Contact</h2>
      <div class="spec-rail mt-2" data-reveal>
        <div class="spec"><span class="spec-label"><strong>Help with the app</strong><a href={`mailto:${CONTACTS.support}`}>{CONTACTS.support}</a></span></div>
        <div class="spec"><span class="spec-label"><strong>App review</strong><a href={`mailto:${CONTACTS.reviewers}`}>{CONTACTS.reviewers}</a></span></div>
        <div class="spec"><span class="spec-label"><strong>Privacy</strong><a href={`mailto:${CONTACTS.privacy}`}>{CONTACTS.privacy}</a></span></div>
        <div class="spec"><span class="spec-label"><strong>Security</strong><a href={`mailto:${CONTACTS.security}`}>{CONTACTS.security}</a></span></div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  /* Search, the way the app searches (help_content.search): every word must
     start a word somewhere in a guide's title, text or keywords. A search
     shows only the matches (opening them when there are three or fewer);
     clearing it puts every guide back as it was. Without JavaScript the
     search box stays hidden and every guide still opens by hand. */
  function initHelp() {
    const shell = document.querySelector<HTMLElement>('[data-help-search-shell]');
    if (!shell || shell.dataset.ready) return;
    shell.dataset.ready = '1';
    shell.hidden = false;
    const input = shell.querySelector<HTMLInputElement>('[data-help-search]')!;
    const clear = shell.querySelector<HTMLButtonElement>('[data-help-clear]')!;
    const status = shell.querySelector<HTMLElement>('[data-help-status]')!;
    const items = [...document.querySelectorAll<HTMLDetailsElement>('[data-guide-item]')];
    const sections = [...document.querySelectorAll<HTMLElement>('[data-help-section]')];
    const idle = status.textContent;
    const tokens = new Map(items.map((d) => [d, (d.dataset.searchText || '').match(/[\p{L}\p{N}#@]+/gu) || []]));
    let before: Map<HTMLDetailsElement, boolean> | null = null;

    const run = () => {
      const words = input.value.toLowerCase().match(/[\p{L}\p{N}#@]+/gu) || [];
      clear.hidden = !words.length;
      if (!words.length) {
        items.forEach((d) => { d.hidden = false; if (before) d.open = before.get(d) ?? false; });
        sections.forEach((s) => { s.hidden = false; });
        before = null;
        status.textContent = idle;
        return;
      }
      if (!before) before = new Map(items.map((d) => [d, d.open]));
      const hits = items.filter((d) => words.every((w) => tokens.get(d)!.some((t) => t.startsWith(w))));
      items.forEach((d) => { d.hidden = !hits.includes(d); d.open = hits.includes(d) && hits.length <= 3; });
      sections.forEach((s) => { s.hidden = !s.querySelector('[data-guide-item]:not([hidden])'); });
      status.textContent = hits.length
        ? `${hits.length} ${hits.length === 1 ? 'guide matches' : 'guides match'} “${input.value.trim()}”`
        : `Nothing matches “${input.value.trim()}”. Try a word like schedule, caption or TikTok.`;
    };
    input.addEventListener('input', run);
    input.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter') return;
      const first = items.find((d) => !d.hidden);
      if (first) { first.open = true; first.scrollIntoView({ block: 'start' }); first.querySelector('summary')?.focus(); }
    });
    clear.addEventListener('click', () => { input.value = ''; run(); input.focus(); });
    shell.querySelector('[data-expand-all]')!.addEventListener('click', () => items.forEach((d) => { if (!d.hidden) d.open = true; }));
    shell.querySelector('[data-collapse-all]')!.addEventListener('click', () => items.forEach((d) => { d.open = false; }));

    /* A link to a guide (or one of its old addresses) opens it. */
    const openFromHash = () => {
      let id = location.hash.slice(1);
      try { id = decodeURIComponent(id); } catch { /* keep it raw */ }
      if (!id) return;
      const target = items.find((d) => d.id === id || (d.dataset.aliases || '').split(',').includes(id));
      if (!target) return;
      if (input.value) { input.value = ''; run(); }
      target.open = true;
      requestAnimationFrame(() => target.scrollIntoView({ block: 'start' }));
    };
    openFromHash();
    window.addEventListener('hashchange', openFromHash);
  }
  initHelp();
  document.addEventListener('astro:page-load', initHelp);
</script>

<style>
  .help-search-shell { margin: 2rem auto 0; max-width: 44rem; text-align: left; }
  .help-search-shell[hidden] { display: none; }
  .help-search-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.55rem 0.75rem 0.55rem 1.1rem;
    border-radius: 999px;
    background: var(--r-panel);
    border: 1px solid var(--hairline-strong);
    box-shadow: var(--shadow-sm);
  }
  .help-search-bar:focus-within { border-color: var(--r-amber); box-shadow: 0 0 0 3px var(--r-amber-soft); }
  .help-search-icon { width: 1.2rem; height: 1.2rem; flex: none; color: var(--r-ink-3); }
  .help-search-input { flex: 1; min-width: 0; border: 0; background: transparent; color: var(--r-ink); font-size: 1rem; line-height: 1.4; outline: none; }
  .help-search-input::placeholder { color: var(--r-ink-4); }
  .help-search-input::-webkit-search-cancel-button { display: none; }
  .help-search-clear {
    flex: none;
    padding: 0.35rem 0.85rem;
    border: 1px solid var(--hairline-strong);
    border-radius: 999px;
    background: var(--r-fill-2);
    color: var(--r-ink-2);
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
  }
  .help-search-clear:hover { color: var(--r-ink); }
  .help-search-meta {
    margin-top: 0.85rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0 0.35rem;
    font-size: 0.86rem;
    color: var(--r-ink-3);
  }
  .help-search-actions { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .help-action-btn {
    min-height: 2rem;
    padding: 0.3rem 0.85rem;
    border-radius: 999px;
    border: 1px solid var(--hairline);
    background: var(--r-tile);
    color: var(--r-ink-2);
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
  }
  .help-action-btn:hover { color: var(--r-ink); border-color: var(--hairline-strong); }

  /* Six topics, two rows of three: every card the height of the tallest, so
     the rows read as one even block. */
  .cat-bento { grid-auto-rows: 1fr; }
  .cat-card { display: flex; flex-direction: column; color: var(--r-ink); text-decoration: none; transition: transform 0.35s var(--r-ease), background-color 0.25s ease; }
  .cat-card:hover { color: var(--r-ink); background: var(--r-tile-2); transform: translateY(-3px); }
  .cat-num { font-size: 0.78rem; font-weight: 700; letter-spacing: 0.04em; color: var(--r-amber-text); margin-bottom: 0.6rem; }
  .cat-title { font-size: 1.2rem; font-weight: 650; letter-spacing: -0.01em; }
  .cat-card p { margin-top: 0.4rem; color: var(--r-ink-3); flex: 1; }
  .cat-card .link-more { margin-top: 1rem; }

  .anchor-alias { display: block; position: relative; top: -5rem; visibility: hidden; }
  .guide-stack { display: flex; flex-direction: column; gap: 0.85rem; }
  .spec-label a { color: var(--r-amber-text); font-size: 1.05rem; overflow-wrap: anywhere; }
</style>
