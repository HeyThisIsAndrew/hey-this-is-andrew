---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import Faq from '../components/ui/Faq.astro';
import { SITE, DOWNLOADS, DATA_PATHS, AGENT_API, href } from '../data/site';

const faq = [
  { q: 'Where are my videos and my database?', a: `<p>Videos go into the library folder you choose, by default <code>~/Movies/Reelay</code> on a Mac. Everything else is in one database, <code>${DATA_PATHS.dbName}</code>, in <code>${DATA_PATHS.mac}</code> on a Mac or <code>${DATA_PATHS.windows}</code> on Windows. You can move the database under <strong>Settings → Data</strong>.</p>` },
  { q: 'Where do transcripts come from?', a: '<p>From the original post’s own captions: the creator’s subtitles first, otherwise the platform’s automatic captions. Use <strong>Get from Original Post</strong> on a ticket. Reelay doesn’t run speech recognition to make transcripts, so a video posted without captions has none to fetch.</p>' },
  { q: 'Why can’t Reelay post to TikTok or Instagram for me?', a: '<p>Both only allow automatic posting from developer apps they have reviewed and approved. Until then, <strong>Prepare to Publish</strong> checks the file and caption, copies the caption, opens the uploader and selects the video file, and you post it yourself.</p>' },
  { q: 'How do I turn on Bluesky, Threads or Facebook posting?', a: '<p>Connect the account under <strong>Accounts</strong>, switch the platform on under <strong>Settings → Automatic posting</strong>, and restart Reelay. Bluesky and Threads posts go out at their scheduled time while Reelay is running and the Mac is awake; Facebook schedules them itself.</p>' },
  { q: 'How do I disconnect an account?', a: `<p>Click <strong>Disconnect</strong> on its card under <strong>Accounts</strong>. Reelay revokes the token where the platform allows, deletes it from your keychain and removes the account. See <a href="${href('/data-deletion')}">User Data Deletion</a> for removing everything.</p>` },
  { q: 'Can I connect an AI agent?', a: `<p>Yes, through the Agent API on <code>${AGENT_API.host}:${AGENT_API.port}</code>. <strong>Settings → AI agents</strong> shows its address and the access key. See <a href="${href('/ai')}">Agents</a>. An MCP endpoint is planned but not in the app yet.</p>` },
  { q: 'What are the system requirements?', a: '<p>A Mac with Apple silicon running macOS 12 Monterey or later. A Windows 10 and 11 (64-bit) build is made by the same project but isn’t published yet.</p>' },
];
---

<BaseLayout
  title={`Support: ${SITE.fullName}`}
  description="Help with Reelay Studio: getting started, connecting YouTube, common questions, how to delete your data, and notes for Google and Meta app reviewers."
>
  <PageHero eyebrow="Support">
    <Fragment slot="title">How can we help?</Fragment>
    <Fragment slot="lede">Getting started, connecting YouTube, and answers to the questions people ask most. <strong>Reviewing Reelay for Google or Meta?</strong> Your notes are <a href="#demo-verification">below</a>.</Fragment>
  </PageHero>

  <section class="stage stage--flush-top" aria-label="Help topics">
    <div class="wrap">
      <div class="bento" data-reveal>
        <a class="tile span-2 topic" href="#get-started"><h3>Get started</h3><p>Install, open and bring your first videos in.</p><span class="link-more">Start</span></a>
        <a class="tile span-2 topic" href="#youtube-setup"><h3>Connect YouTube</h3><p>Five steps, and the three limits to know.</p><span class="link-more">Set up</span></a>
        <a class="tile span-2 topic" href={href('/data-deletion')}><h3>Delete your data</h3><p>Disconnect one account, or remove everything.</p><span class="link-more">Instructions</span></a>
      </div>
    </div>
  </section>

  <section class="stage stage--lift" id="get-started" aria-labelledby="start-title">
    <div class="wrap">
      <div class="split">
        <div data-reveal>
          <p class="eyebrow">Get started</p>
          <h2 id="start-title" class="title">From download to your first ticket.</h2>
          <div class="recommend" data-recommend>
            <p class="rec-k">Recommended for this computer</p>
            <p class="rec-v" data-rec-text>Reelay for Mac with Apple silicon</p>
            <a class="btn btn-primary" href={DOWNLOADS.macArm.href} data-rec-btn>Download .dmg</a>
            <p class="fine" data-rec-note>{DOWNLOADS.macArm.requirements}</p>
          </div>
        </div>
        <ol class="steps" data-reveal style="--reveal-delay:.08s">
          <li><span class="step-n">1</span><span><strong>Install.</strong> Open the .dmg and drag Reelay to Applications.</span></li>
          <li><span class="step-n">2</span><span><strong>Open it the first time.</strong> This beta isn’t notarized yet: Control-click Reelay in Applications and choose Open.</span></li>
          <li><span class="step-n">3</span><span><strong>Bring videos in.</strong> On the Download page, paste a profile link you own or manage, click List Videos, tick what you want and Download.</span></li>
          <li><span class="step-n">4</span><span><strong>Open the Board.</strong> Every download is a ticket in Backlog, ready for its copy.</span></li>
        </ol>
      </div>
      <div class="selftest" data-reveal>
        <p><strong>Something not working?</strong> Reelay has a built-in environment check that runs without opening a window. Send us what it prints.</p>
        <pre><code>/Applications/Reelay.app/Contents/MacOS/Reelay --self-test</code></pre>
      </div>
    </div>
  </section>

  <section class="stage" id="youtube-setup" aria-labelledby="yt-title">
    <div class="wrap">
      <header class="chapter-head" data-reveal>
        <p class="eyebrow">Connecting YouTube</p>
        <h2 id="yt-title" class="headline">Your own Google project.<br /><span class="text-silver">Your own quota.</span></h2>
        <p class="lede">Google has apps like Reelay connect through a free Google Cloud project that you own, so your quota and channels stay yours. <strong>Accounts → Set Up YouTube…</strong> is a guide with a button for each Google page.</p>
      </header>
      <ol class="steps steps--wide" data-reveal>
        <li><span class="step-n">1</span><span>Create a project.</span></li>
        <li><span class="step-n">2</span><span>Enable the YouTube Data API v3.</span></li>
        <li><span class="step-n">3</span><span>Set up the sign-in screen as External, adding each Google account you’ll connect as a test user.</span></li>
        <li><span class="step-n">4</span><span>Create a Desktop app client ID.</span></li>
        <li><span class="step-n">5</span><span>Paste the client ID and secret into Reelay, or load the downloaded JSON.</span></li>
      </ol>
      <p class="lede mt-2" data-reveal>Then <strong>Sign in with Google</strong> opens Google’s page in your browser. Three limits to know:</p>
      <div class="feature-grid" data-reveal>
        <div class="feature"><h3>Private until audited</h3><p>Uploads from a project that hasn’t passed YouTube’s API compliance audit are locked to private, so scheduled videos won’t go public. Reelay flags it on the card.</p></div>
        <div class="feature"><h3>Weekly sign-in</h3><p>While the project is in Testing mode, Google expires sign-ins every seven days, so you’ll need to reconnect.</p></div>
        <div class="feature"><h3>A daily upload limit</h3><p>YouTube’s default API quota caps uploads per day. You can ask Google for more.</p></div>
      </div>
    </div>
  </section>

  <section class="stage stage--lift" id="demo-verification" aria-labelledby="review-title">
    <div class="wrap">
      <header class="chapter-head" data-reveal>
        <p class="eyebrow">App Review</p>
        <h2 id="review-title" class="headline">Notes for Google<br /><span class="text-silver">and Meta reviewers.</span></h2>
        <p class="lede">Reelay is a desktop app for macOS and Windows. It has no web app and no server that stores user data. <strong>Here is what it requests, where in the app each permission is used, and how to see it.</strong></p>
      </header>

      <div class="review" data-reveal>
        <div class="review-block">
          <h3>Google: YouTube Data API v3</h3>
          <dl class="scopes">
            <div><dt><code>https://www.googleapis.com/auth/youtube.upload</code></dt><dd>Uploads a video the user picks, with its title, description, tags and publish time, from <strong>Board → Post automatically to → YouTube</strong>.</dd></div>
            <div><dt><code>https://www.googleapis.com/auth/youtube.readonly</code></dt><dd>Lists the connected channel’s uploads, including private and scheduled ones, as a download source; confirms when a scheduled video is live (<strong>Check YouTube for Updates</strong>).</dd></div>
            <div><dt><code>https://www.googleapis.com/auth/yt-analytics.readonly</code></dt><dd>Requested only by Reelay’s own Google sign-in, read-only, to show a video’s performance on its ticket.</dd></div>
          </dl>
          <ul class="review-facts">
            <li><strong>Sign-in:</strong> OAuth 2.0 for native apps (RFC 8252). The system browser opens Google’s consent page and returns to a one-time loopback address, <code>http://127.0.0.1:&lt;port&gt;/</code>, with PKCE. The code is exchanged on the user’s computer.</li>
            <li><strong>Storage:</strong> tokens in the macOS Keychain or Windows Credential Manager; channel and video details in the local database. Nothing is sent to Reelay servers.</li>
            <li><strong>Revocation:</strong> <strong>Accounts → Disconnect</strong> calls <code>https://oauth2.googleapis.com/revoke</code>, deletes the token and removes the account.</li>
            <li><strong>Limited Use:</strong> see the <a href={`${href('/privacy')}#google-limited-use`}>Google section of the Privacy Policy</a>.</li>
          </ul>
        </div>

        <div class="review-block">
          <h3>Meta: Instagram, Facebook and Threads</h3>
          <dl class="scopes">
            <div><dt><code>instagram_business_basic</code>, <code>instagram_business_content_publish</code></dt><dd>Requested by Reelay’s Instagram sign-in to identify the connected professional account. Reelay does not publish to Instagram today: the user posts in Instagram, helped by <strong>Prepare to Publish</strong>. Read-only insights are requested for performance on the ticket.</dd></div>
            <div><dt><code>threads_basic</code>, <code>threads_content_publish</code></dt><dd>Publish a scheduled Threads post the user wrote, once Threads posting is switched on.</dd></div>
            <div><dt><code>pages_show_list</code>, <code>pages_manage_posts</code>, <code>pages_read_engagement</code></dt><dd>Choose a Facebook Page and publish or schedule the video post the user wrote, once Facebook posting is switched on.</dd></div>
          </dl>
          <ul class="review-facts">
            <li><strong>Sign-in:</strong> Meta redirects to Reelay’s sign-in server, which exchanges the code with Reelay’s app secret and returns the tokens to the app over the loopback address. It keeps nothing after the sign-in.</li>
            <li><strong>Publishing:</strong> from the user’s computer directly to <code>graph.facebook.com</code> and <code>graph.threads.com</code>.</li>
            <li><strong>Data deletion:</strong> <a href={href('/data-deletion')}>User Data Deletion Instructions</a>.</li>
          </ul>
        </div>

        <div class="review-block">
          <h3>TikTok</h3>
          <dl class="scopes">
            <div><dt><code>user.info.basic</code>, <code>video.list</code></dt><dd>Identify the connected account and list its videos. Read-only <code>user.info.stats</code> is requested for performance on the ticket. Reelay does not post to TikTok.</dd></div>
          </dl>
        </div>

        <div class="review-cta">
          <p>For test credentials, a screen recording of a flow, or anything else you need, write to the review desk.</p>
          <a class="btn btn-primary" href={`mailto:${SITE.complianceEmail}`}>{SITE.complianceEmail}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="stage" aria-labelledby="faq-title">
    <div class="wrap-narrow">
      <h2 id="faq-title" class="title" data-reveal>Questions</h2>
      <div class="mt-2" data-reveal><Faq items={faq} /></div>
    </div>
  </section>

  <section class="stage stage--tight" aria-labelledby="contact-title">
    <div class="wrap">
      <h2 id="contact-title" class="title center" data-reveal>Contact</h2>
      <div class="spec-rail mt-2" data-reveal>
        <div class="spec"><span class="spec-label"><strong>Help with the app</strong><a href={`mailto:${SITE.supportEmail}`}>{SITE.supportEmail}</a></span></div>
        <div class="spec"><span class="spec-label"><strong>App review and compliance</strong><a href={`mailto:${SITE.complianceEmail}`}>{SITE.complianceEmail}</a></span></div>
        <div class="spec"><span class="spec-label"><strong>Privacy</strong><a href={`mailto:${SITE.privacyEmail}`}>{SITE.privacyEmail}</a></span></div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .topic { display: flex; flex-direction: column; color: var(--r-ink); transition: transform 0.4s var(--r-ease), background-color 0.3s ease; }
  .topic:hover { color: var(--r-ink); background: var(--r-tile-2); transform: translateY(-3px); }
  .topic p { color: var(--r-ink-3); flex: 1; }
  .topic .link-more { margin-top: 1rem; }

  .recommend { margin-top: 2rem; display: grid; justify-items: start; gap: 0.6rem; }
  .rec-k { font-size: 0.85rem; font-weight: 600; color: var(--r-ink-3); }
  .rec-v { font-size: 1.25rem; font-weight: 600; color: var(--r-ink); }

  .steps { list-style: none; display: grid; }
  .steps li { display: flex; align-items: flex-start; gap: 1.1rem; padding: 1.15rem 0; border-top: 1px solid var(--hairline); font-size: 1.05rem; color: var(--r-ink-2); }
  .steps li:last-child { border-bottom: 1px solid var(--hairline); }
  .steps strong { color: var(--r-ink); }
  .step-n { display: grid; place-items: center; flex: none; width: 2rem; height: 2rem; border-radius: 50%; background: rgba(240, 180, 76, 0.14); color: var(--r-amber-text); font-size: 0.9rem; font-weight: 700; }
  .steps--wide { margin-bottom: 1rem; }

  .selftest { margin-top: clamp(3rem, 6vw, 4.5rem); max-width: 46rem; }
  .selftest p { color: var(--r-ink-2); }
  .selftest pre { margin-top: 0.85rem; padding: 1rem 1.15rem; border-radius: 14px; background: #0e0e10; overflow-x: auto; font-size: 0.88rem; color: var(--r-ink); }

  .review { display: grid; gap: clamp(2.5rem, 5vw, 4rem); }
  .review-block h3 { font-size: clamp(1.4rem, 2.2vw, 1.75rem); font-weight: 650; letter-spacing: -0.025em; padding-bottom: 1rem; border-bottom: 1px solid var(--hairline-strong); }
  .scopes div { display: grid; gap: 0.5rem 2rem; padding: 1.1rem 0; border-bottom: 1px solid var(--hairline); }
  @media (min-width: 860px) { .scopes div { grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); } }
  .scopes dt code, .review-facts code { font-size: 0.86rem; color: var(--r-amber-text); overflow-wrap: anywhere; }
  .scopes dd { color: var(--r-ink-2); }
  .review-facts { list-style: none; display: grid; gap: 0.75rem; margin-top: 1.25rem; color: var(--r-ink-2); }
  .review-facts strong { color: var(--r-ink); }
  .review-cta { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.25rem; padding: clamp(1.5rem, 3vw, 2.25rem); border-radius: var(--radius-lg); background: linear-gradient(180deg, rgba(240, 180, 76, 0.1), rgba(240, 180, 76, 0.03)); }
  .review-cta p { max-width: 34rem; color: var(--r-ink); }
  .spec-label a { color: var(--r-amber-text); font-size: 1.05rem; }
</style>

<script>
  // Point the recommendation at the visitor's own system. Only the Mac build
  // is published, so other systems are told so rather than sent a dead link.
  const box = document.querySelector<HTMLElement>('[data-recommend]');
  if (box) {
    const ua = navigator.userAgent;
    const text = box.querySelector<HTMLElement>('[data-rec-text]');
    const btn = box.querySelector<HTMLAnchorElement>('[data-rec-btn]');
    const note = box.querySelector<HTMLElement>('[data-rec-note]');
    if (/Windows/i.test(ua) && text && btn && note) {
      text.textContent = 'Reelay for Windows isn’t published yet';
      btn.textContent = 'See all downloads';
      btn.href = btn.href.replace(/https?:\/\/[^#]+/, `${location.origin}/#download`);
      note.textContent = 'The Mac version for Apple silicon is available now.';
    } else if (/iPhone|iPad|Android/i.test(ua) && text && note) {
      text.textContent = 'Reelay is a desktop app for Mac';
      note.textContent = 'Open this page on your Mac to download it.';
    }
  }
</script>
