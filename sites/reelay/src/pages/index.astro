---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Statement from '../components/Statement.astro';
import ProFeatureAccordion from '../components/ProFeatureAccordion.astro';
import TrustComplianceStrip from '../components/TrustComplianceStrip.astro';
import { SITE } from '../data/site';
import { softwareApplication } from '../data/seo';
---

<BaseLayout title={`${SITE.fullName}: ${SITE.tagline}`} description={SITE.description} jsonLd={softwareApplication()}>
  <Hero />

  <Statement />

  <ProFeatureAccordion />

  <TrustComplianceStrip />
</BaseLayout>
