---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import AppleMetricsStrip from '../components/AppleMetricsStrip.astro';
import InteractiveWorkflow from '../components/InteractiveWorkflow.astro';
import StudioMockup from '../components/StudioMockup.astro';
import ProFeatureAccordion from '../components/ProFeatureAccordion.astro';
import DataFlowTopology from '../components/DataFlowTopology.astro';
import SiliconSpecs from '../components/SiliconSpecs.astro';
import DownloadSection from '../components/DownloadSection.astro';
import { SITE } from '../data/site';
---

<BaseLayout
  title={`${SITE.fullName} — ${SITE.tagline}`}
  description={SITE.description}
>
  <!-- Hero Section: Monumental Typography & CTAs -->
  <Hero />

  <!-- Cinema Studio Native Desktop Window Preview (Anchoring the Hero) -->
  <StudioMockup />

  <!-- Apple Pro Performance Spec Rail -->
  <AppleMetricsStrip />

  <!-- End-to-End Interactive Creator Workflow Demonstration -->
  <InteractiveWorkflow />

  <!-- Apple-Grade 5-Drawer Vertical Feature Accordion -->
  <ProFeatureAccordion />

  <!-- Zero-Knowledge Trust & Data-Flow Architecture -->
  <DataFlowTopology />

  <!-- Hardware & Silicon Optimization Matrix (Metal / DirectX / NVMe) -->
  <SiliconSpecs />

  <!-- Native Desktop Installers & Apple Notarized Binaries -->
  <DownloadSection />
</BaseLayout>

