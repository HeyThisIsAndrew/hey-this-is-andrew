---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Statement from '../components/Statement.astro';
import InteractiveWorkflow from '../components/InteractiveWorkflow.astro';
import CapabilityMatrix from '../components/CapabilityMatrix.astro';
import ProFeatureAccordion from '../components/ProFeatureAccordion.astro';
import SafetySection from '../components/SafetySection.astro';
import DataFlowTopology from '../components/DataFlowTopology.astro';
import TechSpecs from '../components/TechSpecs.astro';
import DownloadSection from '../components/DownloadSection.astro';
import { SITE } from '../data/site';
import { softwareApplication } from '../data/seo';
---

<BaseLayout title={`${SITE.fullName}: ${SITE.tagline}`} description={SITE.description} jsonLd={softwareApplication()}>
  <Hero />

  <Statement />

  <InteractiveWorkflow />

  <!-- Works with -->
  <section class="stage" id="works-with" aria-labelledby="works-title">
    <div class="wrap">
      <header class="chapter-head" data-reveal>
        <p class="eyebrow">Works with</p>
        <h2 id="works-title" class="headline">Seven platforms.<br /><span class="text-silver">Exactly what it does on each.</span></h2>
        <p class="lede">Reelay posts automatically only where a platform allows it and you’ve turned it on. <strong>Everywhere else it does everything up to the button</strong>, and you post.</p>
      </header>
      <div data-reveal><CapabilityMatrix /></div>
    </div>
  </section>

  <ProFeatureAccordion />

  <SafetySection />

  <DataFlowTopology />

  <TechSpecs />

  <DownloadSection />
</BaseLayout>
