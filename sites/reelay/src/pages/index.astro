---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Statement from '../components/Statement.astro';
import ImportScene from '../components/ImportScene.astro';
import CaptionLab from '../components/CaptionLab.astro';
import InteractiveWorkflow from '../components/InteractiveWorkflow.astro';
import SearchScene from '../components/SearchScene.astro';
import PublishSection from '../components/PublishSection.astro';
import ProFeatureAccordion from '../components/ProFeatureAccordion.astro';
import DataFlowTopology from '../components/DataFlowTopology.astro';
import TechSpecs from '../components/TechSpecs.astro';
import DownloadSection from '../components/DownloadSection.astro';
import { SITE, href } from '../data/site';
---

<BaseLayout title={`${SITE.fullName}: ${SITE.tagline}`} description={SITE.description}>
  <Hero />

  <Statement />

  <!-- Chapter 1: bring it in -->
  <section class="stage stage--lift" id="bring-it-in" aria-labelledby="import-title">
    <div class="wrap">
      <header class="chapter-head" data-reveal>
        <p class="eyebrow">Bring it in</p>
        <h2 id="import-title" class="headline">Your whole archive.<br /><span class="text-silver">In one place.</span></h2>
        <p class="lede">List every video on a TikTok, Instagram or YouTube profile you own or manage, with its cover, date, caption, length and views. Pick what you want and pull it down. <strong>TikTok comes in clean: the watermark-free stream, with the creator’s own audio.</strong></p>
      </header>
    </div>
    <div class="wrap-wide" data-reveal>
      <div class="import-stage">
        <div class="halo" style="width:60%;height:60%;left:20%;top:30%;background:rgba(240,150,40,.35)" aria-hidden="true"></div>
        <ImportScene />
      </div>
    </div>
    <div class="wrap">
      <div class="spec-rail mt-4" data-reveal>
        <div class="spec"><span class="spec-value">1<small>click</small></span><span class="spec-label"><strong>Saved sources</strong>Profiles you use often, and connected YouTube channels, including private and scheduled videos.</span></div>
        <div class="spec"><span class="spec-value">6</span><span class="spec-label"><strong>Facts of provenance</strong>Source platform, original link, import date, first publish date, creator and permission, on every video.</span></div>
        <div class="spec"><span class="spec-value">0</span><span class="spec-label"><strong>Watermarks</strong>TikTok downloads are the clean stream. The post’s separate sound is never merged in.</span></div>
      </div>
      <p class="mt-3"><a class="link-more" href={href('/features/library')}>More about the library and player</a></p>
    </div>
  </section>

  <!-- Chapter 2: copy for every platform -->
  <section class="stage" id="copy" aria-labelledby="copy-title">
    <div class="wrap">
      <header class="chapter-head" data-reveal>
        <p class="eyebrow">Copy for every platform</p>
        <h2 id="copy-title" class="headline">One video.<br /><span class="text-silver">Six sets of rules.</span></h2>
        <p class="lede">Every ticket holds ready-to-paste copy for six platforms, each with a Copy button and a live count that follows that platform’s own rules. <strong>Over the limit is reported and the save is refused. Nothing is ever cut short.</strong></p>
      </header>
      <div data-reveal>
        <CaptionLab />
      </div>
    </div>
  </section>

  <!-- Chapter 3: the board -->
  <InteractiveWorkflow />

  <!-- Chapter 4: search what was said -->
  <section class="stage" id="search" aria-labelledby="search-title">
    <div class="wrap">
      <div class="split">
        <div data-reveal>
          <p class="eyebrow">Search</p>
          <h2 id="search-title" class="headline">Find the moment<br /><span class="text-silver">you said it.</span></h2>
          <p class="lede mt-2">The Board searches everything: titles, original captions, every platform’s copy, tags, notes, and <strong>the transcript of what was said</strong>, taken from the original post’s captions. A card found by its spoken words shows you the quote.</p>
          <p class="fine mt-2">Prefix matching and “exact phrases”. The index updates itself whenever a ticket changes.</p>
        </div>
        <div data-reveal style="--reveal-delay:.1s">
          <SearchScene />
        </div>
      </div>
    </div>
  </section>

  <PublishSection />

  <ProFeatureAccordion />

  <DataFlowTopology />

  <TechSpecs />

  <DownloadSection />
</BaseLayout>

<style>
  .import-stage { position: relative; isolation: isolate; max-width: 1180px; margin: 0 auto; }
</style>
