---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Statement from '../components/Statement.astro';
import ImportScene from '../components/ImportScene.astro';
import CaptionLab from '../components/CaptionLab.astro';
import InteractiveWorkflow from '../components/InteractiveWorkflow.astro';
import CapabilityMatrix from '../components/CapabilityMatrix.astro';
import SearchScene from '../components/SearchScene.astro';
import PublishSection from '../components/PublishSection.astro';
import AccountsScene from '../components/AccountsScene.astro';
import BrandingScene from '../components/BrandingScene.astro';
import ProFeatureAccordion from '../components/ProFeatureAccordion.astro';
import SafetySection from '../components/SafetySection.astro';
import DataFlowTopology from '../components/DataFlowTopology.astro';
import TechSpecs from '../components/TechSpecs.astro';
import DownloadSection from '../components/DownloadSection.astro';
import Screen from '../components/ui/Screen.astro';
import { SITE, href } from '../data/site';
import { softwareApplication } from '../data/seo';
---

<BaseLayout title={`${SITE.fullName}: ${SITE.tagline}`} description={SITE.description} subnav jsonLd={softwareApplication()}>
  <Hero />

  <Statement />

  <!-- Bring it in -->
  <section class="stage stage--lift" id="bring-it-in" aria-labelledby="import-title">
    <div class="wrap">
      <header class="chapter-head" data-reveal>
        <p class="eyebrow">Bring it in</p>
        <h2 id="import-title" class="headline">Your whole archive.<br /><span class="text-silver">In one place.</span></h2>
        <p class="lede">Bring in the videos you own or have permission to manage from TikTok, Instagram and YouTube, plus your Snapchat Spotlight links. See each one’s cover, date, caption, length and views first, then <strong>pick what comes in and keep a record of where it came from.</strong></p>
      </header>
    </div>
    <div class="wrap-wide" data-reveal>
      <div class="import-stage">
        <div class="halo" style="width:60%;height:60%;left:20%;top:30%;background:var(--r-glow-1)" aria-hidden="true"></div>
        <ImportScene />
      </div>
    </div>
    <div class="wrap">
      <div class="spec-rail mt-4" data-reveal>
        <div class="spec"><span class="spec-value">1<small>click</small></span><span class="spec-label"><strong>Saved sources</strong>Add a profile by @username or link, one section per platform. Your connected YouTube channel appears on its own.</span></div>
        <div class="spec"><span class="spec-value">6</span><span class="spec-label"><strong>Facts of provenance</strong>Source platform, original link, import date, first publish date, creator and permission, on every video.</span></div>
        <div class="spec"><span class="spec-value">4</span><span class="spec-label"><strong>Places to bring media from</strong>TikTok, Instagram, YouTube, and Snapchat Spotlight links.</span></div>
      </div>
      <p class="mt-3"><a class="link-more" href={href('/features/library')}>More about the Library</a></p>
    </div>
  </section>

  <!-- Copy for every platform -->
  <section class="stage" id="copy" aria-labelledby="copy-title">
    <div class="wrap">
      <header class="chapter-head" data-reveal>
        <p class="eyebrow">Copy for every platform</p>
        <h2 id="copy-title" class="headline">One video.<br /><span class="text-silver">Six sets of rules.</span></h2>
        <p class="lede">Every ticket holds ready-to-paste copy for six platforms, each with a Copy button and a live count that follows that platform’s own rules. <strong>Over the limit is reported and the save is refused. Nothing is ever cut short.</strong></p>
      </header>
      <div data-reveal>
        <CaptionLab />
      </div>
    </div>
  </section>

  <InteractiveWorkflow />

  <!-- Works with -->
  <section class="stage" id="works-with" aria-labelledby="works-title">
    <div class="wrap">
      <header class="chapter-head" data-reveal>
        <p class="eyebrow">Works with</p>
        <h2 id="works-title" class="headline">Seven platforms.<br /><span class="text-silver">Exactly what it does on each.</span></h2>
        <p class="lede">Reelay posts automatically only where a platform allows it and you’ve turned it on. <strong>Everywhere else it does everything up to the button</strong>, and you post.</p>
      </header>
      <div data-reveal><CapabilityMatrix /></div>
    </div>
  </section>

  <!-- Search -->
  <section class="stage stage--lift" id="search" aria-labelledby="search-title">
    <div class="wrap">
      <div class="split">
        <div data-reveal>
          <p class="eyebrow">Search</p>
          <h2 id="search-title" class="headline">Find the moment<br /><span class="text-silver">you said it.</span></h2>
          <p class="lede mt-2">The Board searches everything: titles, original captions, every platform’s copy, tags, notes, and <strong>the transcript of what was said</strong>, taken from the original post’s captions. A card found by its spoken words shows you the quote.</p>
          <p class="fine mt-2">Prefix matching and “exact phrases”. The index updates itself whenever a ticket changes.</p>
        </div>
        <div data-reveal style="--reveal-delay:.1s">
          <SearchScene />
        </div>
      </div>
    </div>
  </section>

  <PublishSection />

  <!-- Accounts and profiles -->
  <section class="stage stage--lift" id="accounts" aria-labelledby="accounts-title">
    <div class="wrap">
      <header class="chapter-head" data-reveal>
        <p class="eyebrow">Accounts</p>
        <h2 id="accounts-title" class="headline">Every platform.<br /><span class="text-silver">One card each.</span></h2>
        <p class="lede">Accounts shows an integration card per platform with its status, and how many are connected. <strong>Sign in with one click</strong> as each platform approves Reelay’s app, or use your own developer keys under Advanced Setup.</p>
      </header>
    </div>
    <div class="wrap-wide" data-reveal><div class="import-stage"><AccountsScene /></div></div>
    <div class="wrap mt-3" data-reveal>
      <Screen id="accounts" caption="Accounts in the app, from a demo profile." />
    </div>
  </section>

  <section class="stage" id="profiles" aria-labelledby="profiles-title">
    <div class="wrap">
      <header class="chapter-head center" data-reveal>
        <p class="eyebrow">Profiles</p>
        <h2 id="profiles-title" class="headline">Every creator.<br /><span class="text-silver">Their own look.</span></h2>
        <p class="lede">Each creator gets a profile with their own library folder, board and accounts, and their own logo and colours. <strong>You always know whose profile you’re in.</strong></p>
      </header>
      <div data-reveal><BrandingScene /></div>
      <div class="mt-3" data-reveal><Screen id="branding" caption="Edit Profile & Branding in the app." /></div>
    </div>
  </section>

  <ProFeatureAccordion />

  <SafetySection />

  <DataFlowTopology />

  <TechSpecs />

  <DownloadSection />
</BaseLayout>

<style>
  .import-stage { position: relative; isolation: isolate; max-width: 1180px; margin: 0 auto; }
</style>
