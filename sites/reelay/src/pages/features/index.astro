---
import Accordion from '@andrew/ui/Accordion.astro';
import AccordionRow from '@andrew/ui/AccordionRow.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import NextUp from '../../components/ui/NextUp.astro';
import BoardScene from '../../components/BoardScene.astro';
import ImportScene from '../../components/ImportScene.astro';
import SearchScene from '../../components/SearchScene.astro';
import AccountsScene from '../../components/AccountsScene.astro';
import BrandingScene from '../../components/BrandingScene.astro';
import { SITE, href } from '../../data/site';

const all = [
  ['An image-first Library', 'Hover-scrub previews, Small to XL tiles, 24, 48, 96 or All per page, Grid or List.'],
  ['Download Sources', 'One window, a section per platform: add a profile by @username or link, then list its videos in one click.'],
  ['Provenance on every video', 'Platform, link, dates, creator and permission.'],
  ['A player beside your captions', 'Real keyboard shortcuts, and a preview copy for formats it can’t decode.'],
  ['Transcripts from the original post', 'Searchable, with the quote shown on the card.'],
  ['Copy for six platforms', 'Live counts against each platform’s own limits. Never cut short.'],
  ['Readiness and the Ready gate', 'Scheduling refuses what isn’t ready, and says why.'],
  ['Coverage map', 'Six platforms on every card, coloured by where each stands.'],
  ['Prepare to Publish', 'Everything up to the button for TikTok, Instagram and Snapchat. You post; Reelay records it.'],
  ['The side panel', 'The video, a readiness ring, the platforms, the captions and a Schedule button that says what will happen.'],
  ['YouTube upload and schedule', 'Publishes on time even when Reelay is closed.'],
  ['Durable sends', 'Recorded before they run; interrupted ones wait for you.'],
  ['Change history', 'Every saved change, who made it, and a one-click restore.'],
  ['Automations', 'When, if, then. Fill, tag, route and schedule, safely.'],
  ['Import Sheet', 'CSV or a shared Google Sheet, previewed row by row.'],
  ['Writing help on your computer', 'Spelling, local-model rewrites and brand voice. No tokens.'],
  ['Video tools', 'Remove or replace sound, give one platform its own sound, burn in captions. Originals untouched.'],
  ['Profiles and branding', 'One per creator, each with its own folder, board, accounts, logo and colours.'],
  ['Accounts', 'An integration card per platform, one-click sign-in, and your own developer keys under Advanced Setup.'],
  ['Shared database', 'Drive, Dropbox, iCloud Drive or OneDrive; one editor at a time.'],
  ['Agent API', 'Local, documented, and approval-gated. Edits by an AI assistant are marked.'],
  ['Four themes', 'Light, Dark, Black, or Custom in a profile’s brand colours.'],
  ['Sign-ins in your Keychain', 'Account tokens are kept in the macOS Keychain on your Mac.'],
];
---

<BaseLayout
  title={`Features: ${SITE.fullName}`}
  description="Everything in Reelay: a library that brings your videos home, a board of tickets with copy for six platforms and a readiness check, safe automations, and a local Agent API."
>
  <PageHero eyebrow="Features">
    <Fragment slot="title">Everything a video needs<br /><span class="text-glow">before it leaves.</span></Fragment>
    <Fragment slot="lede">Reelay does three jobs, in order. <strong>Bring it in. Get it ready. Send it out.</strong> Each one is built to be careful with your work.</Fragment>
  </PageHero>

  {/* Two top-level sections: the five chapters (an accordion), then the
      whole list, which used to hide in a sixth row of that accordion. */}
  <section class="stage stage--flush-top" id="chapters" aria-labelledby="chapters-title" data-sec data-pn-label="The chapters">
    <div class="wrap">
      <header class="chapter-head" data-reveal data-sec-head>
        <p class="eyebrow">Five chapters</p>
        <h2 id="chapters-title" class="headline">One video, start to finish.<br /><span class="text-silver">Open a chapter.</span></h2>
      </header>
      <div class="r-acc">
      <Accordion>
        <AccordionRow id="library" kicker="01 · Bring it in" title="Library and Player" size="md" open>
      <div class="row-wrap">
        <div class="row-intro">
          <p class="lede">Bring in the videos you own or manage from TikTok, Instagram and YouTube, and your Snapchat Spotlight links, with the facts of where each one came from. <strong>Then watch it right beside the words you’re writing for it.</strong></p>
          <a class="link-more mt-1" href={href('/features/library')}>Explore Library and Player</a>
        </div>
      </div>
      <div class="row-wrap"><div class="f-stage"><ImportScene /></div></div>

        </AccordionRow>
        <AccordionRow id="pipeline" kicker="02 · Get it ready" title="Board and Tickets" size="md">
      <div class="row-wrap">
        <div class="row-intro">
          <p class="lede">Every video is a ticket with copy for six platforms, a readiness checklist and a coverage map. <strong>Scheduling refuses anything that isn’t ready, and cards move themselves as platforms go live.</strong></p>
          <a class="link-more mt-1" href={href('/features/pipeline')}>Explore Board and Tickets</a>
        </div>
      </div>
      <div class="row-wrap"><div class="f-stage"><BoardScene /></div></div>

        </AccordionRow>
        <AccordionRow id="automations" kicker="03 · Do it once" title="Automations" size="md">
      <div class="row-wrap">
        <div class="split">
          <div>
            <p class="lede mt-2">When a video arrives, if it matches, then fill its empty copy from a template, add hashtags, choose platforms or schedule it. <strong>Once per video, never over your own words, and all of it logged.</strong></p>
            <a class="link-more mt-1" href={href('/features/automations')}>Explore Automations</a>
          </div>
          <div class="rule-vis" aria-hidden="true">
            <p><b>When</b> a video is added to the board</p>
            <p><b>If</b> it came from TikTok</p>
            <p><b>Then</b> set its platforms to YouTube, Instagram and Threads</p>
            <p><b>And</b> fill the Threads text from <code>{'{hook}'}</code></p>
          </div>
        </div>
      </div>

        </AccordionRow>
        <AccordionRow id="search" kicker="04 · Find anything" title="Search" size="md">
      <div class="row-wrap">
        <div class="split split--flip">
          <div>
            <p class="lede mt-2">One search across titles, captions, every platform’s copy, tags, notes and transcripts. <strong>A video found by what was said in it shows you the quote.</strong></p>
            <a class="link-more mt-1" href={`${href('/features/library')}#transcripts`}>How transcripts work</a>
          </div>
          <div><SearchScene /></div>
        </div>
      </div>

        </AccordionRow>
        <AccordionRow id="profiles-accounts" kicker="05 · Profiles & Accounts" title="Every creator. Every platform." navLabel="Profiles and accounts" size="md">
      <div class="row-wrap">
        <div class="row-intro center">
          <p class="lede">Each creator gets a dedicated profile with their own library folder, board, accounts, and branding. Sign in with one click as platforms approve Reelay, or provide your own developer keys.</p>
        </div>
        <div class="mt-4"><BrandingScene /></div>
        <div class="mt-4"><AccountsScene /></div>
      </div>

        </AccordionRow>
      </Accordion>
      </div>
    </div>
  </section>

  <section class="stage" id="all-features" aria-labelledby="all-title" data-sec data-pn-label="Every feature">
    <div class="wrap">
      <header class="chapter-head" data-reveal data-sec-head>
        <p class="eyebrow">Everything</p>
        <h2 id="all-title" class="headline">Every feature.<br /><span class="text-silver">On one page.</span></h2>
      </header>
      <div class="feature-grid" data-reveal>
        {all.map(([t, d]) => <div class="feature"><h3>{t}</h3><p>{d}</p></div>)}
      </div>
    </div>
  </section>

  <NextUp kicker="Start with" title="Library and Player" href={href('/features/library')} />
</BaseLayout>

<style>
  .f-stage { max-width: 1240px; margin: 0 auto; }
  .chapter-head .link-more { display: inline-flex; }
  .rule-vis {
    display: grid;
    gap: 0.75rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    border-radius: var(--radius-xl);
    background: var(--r-panel);
    box-shadow: var(--r-panel-shadow);
  }
  .rule-vis p { padding: 0.9rem 1.1rem; border-radius: 14px; background: var(--r-fill-2); color: var(--r-ink); font-size: 1.08rem; }
  .rule-vis b { display: inline-block; min-width: 3.4rem; color: var(--r-amber-text); }
  @media (max-width: 560px) { .rule-vis b { display: block; min-width: 0; margin-bottom: 0.15rem; } }
  .rule-vis code { color: var(--r-amber-text); }
</style>
