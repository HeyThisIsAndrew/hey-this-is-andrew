---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import NextUp from '../../components/ui/NextUp.astro';
import ImportScene from '../../components/ImportScene.astro';
import PlayerDemo from '../../components/PlayerDemo.astro';
import SearchScene from '../../components/SearchScene.astro';
import LibraryGridScene from '../../components/LibraryGridScene.astro';
import SourcesScene from '../../components/SourcesScene.astro';
import { SITE, href } from '../../data/site';

const naming = [
  { name: 'Platform, date and video ID', example: 'TikTok_20261009_7692175258450677023.mp4', note: 'The default' },
  { name: 'Date and your name', example: '2026-10-09_golden-hour-big-sur.mp4', note: 'Suggest Names fills it from the caption' },
  { name: 'Custom pattern…', example: '{date}_{custom}.mp4', note: 'For when you have a system' },
];
---

<BaseLayout
  title={`Library and Player: ${SITE.fullName}`}
  description="Bring in the videos you own or manage from TikTok, Instagram, YouTube and Snapchat into an image-first Library with hover-scrub previews. Watch each one beside the words you write for it, and search everything that was said."
>
  <PageHero eyebrow="Library and Player">
    <Fragment slot="title">Everything you’ve made.<br /><span class="text-glow">Right here.</span></Fragment>
    <Fragment slot="lede">Reelay brings in the videos you own or manage from the platforms you post to, keeps the facts of where each one came from, and plays each one right beside the words you’re writing for it.</Fragment>
  </PageHero>

  <section class="stage stage--flush-top" aria-label="The Download page">
    <div class="wrap-wide" data-reveal>
      <div class="lib-stage">
        <div class="halo" style="width:70%;height:50%;left:15%;top:35%;background:rgba(240,150,40,.32)" aria-hidden="true"></div>
        <ImportScene />
      </div>
    </div>
  </section>

  <section class="stage" id="library-grid" aria-labelledby="grid-title">
    <div class="wrap">
      <header class="chapter-head center" data-reveal>
        <p class="eyebrow">The Library</p>
        <h2 id="grid-title" class="headline">Covers first.<br /><span class="text-silver">Scrub without opening.</span></h2>
        <p class="lede">An image-first grid of every video, sized the way you like it from Small to XL. <strong>Hover a cover to scrub through the video.</strong> Page through 24, 48 or 96 at a time, or All, and switch to a List when you want the details. Reelay remembers your page.</p>
      </header>
    </div>
    <div class="wrap-wide" data-reveal><div class="lib-stage"><LibraryGridScene /></div></div>
  </section>

  <section class="stage stage--lift" id="download-sources" aria-labelledby="src-title">
    <div class="wrap">
      <div class="split">
        <div data-reveal>
          <p class="eyebrow">Download Sources</p>
          <h2 id="src-title" class="title">Add an account by @username or link.</h2>
          <p class="lede">One section per platform: TikTok, Instagram, YouTube and Snapchat. Type a username or paste a profile link, mark the accounts that are yours, and List Videos is one click from then on. <strong>Only import media you own or have permission to manage.</strong></p>
          <p class="fine mt-2">Snapchat doesn’t let apps list a profile’s videos, so you paste your Spotlight links instead.</p>
        </div>
        <div data-reveal style="--reveal-delay:.08s"><SourcesScene /></div>
      </div>
    </div>
  </section>

  <section class="stage" aria-labelledby="pick-title">
    <div class="wrap">
      <header class="chapter-head" data-reveal>
        <p class="eyebrow">Download</p>
        <h2 id="pick-title" class="headline">See everything first.<br /><span class="text-silver">Take only what you pick.</span></h2>
        <p class="lede">Paste a profile link, or click a saved source, and Reelay lists every video before anything downloads. <strong>New videos start unselected</strong>, and the strip above the list always tells you what is.</p>
      </header>
      <div class="feature-grid" data-reveal>
        <div class="feature"><h3>Saved sources</h3><p>One-click buttons for the profiles you use most, grouped by platform. Connected YouTube channels appear on their own, private and scheduled videos included.</p></div>
        <div class="feature"><h3>Your audio, as posted</h3><p>A TikTok video comes in with the creator’s own audio. The post’s separate sound track is never merged in.</p></div>
        <div class="feature"><h3>Select the way you think</h3><p>Select All follows your search. More picks the newest few, what the search shows, or the highlighted rows. Space ticks highlighted rows.</p></div>
        <div class="feature"><h3>Search and hashtags</h3><p>Search matches captions and hashtags, and All hashtags filters the list to one, with counts. Click a hashtag in the side panel to do the same.</p></div>
        <div class="feature"><h3>Tagged products</h3><p>For TikTok Shop videos, the tagged products are read from the public page in the background, so you can filter to every video for one product.</p></div>
        <div class="feature"><h3>A record of every download</h3><p>Each download writes a manifest.md and a JSON file per video, and Rename Files… renames what you already have, with a preview first.</p></div>
      </div>
    </div>
  </section>

  <section class="stage stage--lift" aria-labelledby="names-title">
    <div class="wrap">
      <div class="split">
        <div data-reveal>
          <p class="eyebrow">File names</p>
          <h2 id="names-title" class="title">Names you can read in Finder.</h2>
          <p class="lede">Choose how files are named from plain options, with a live example under each one. Suggest Names writes names from captions, or you can type your own.</p>
        </div>
        <ul class="names" data-reveal style="--reveal-delay:.08s">
          {naming.map((n, i) => (
            <li class:list={['name-opt', { on: i === 0 }]}>
              <span class="name-radio" aria-hidden="true"></span>
              <span><strong>{n.name}</strong><code>{n.example}</code><small>{n.note}</small></span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="stage" aria-labelledby="prov-title">
    <div class="wrap">
      <header class="chapter-head" data-reveal>
        <p class="eyebrow">Provenance</p>
        <h2 id="prov-title" class="headline">Where it came from.<br /><span class="text-silver">On every video.</span></h2>
        <p class="lede">Every imported video records the facts a rights question will ask. <strong>Links from your own accounts are marked as your own content</strong>; anything else stays unrecorded until you set it on the ticket.</p>
      </header>
      <div class="spec-rail spec-rail--5" data-reveal>
        <div class="spec"><span class="spec-label"><strong>Source platform</strong>TikTok, Instagram or YouTube</span></div>
        <div class="spec"><span class="spec-label"><strong>Original link</strong>The post it came from</span></div>
        <div class="spec"><span class="spec-label"><strong>Imported</strong>When it came in</span></div>
        <div class="spec"><span class="spec-label"><strong>First published</strong>And by which creator</span></div>
        <div class="spec"><span class="spec-label"><strong>Permission</strong>Own content, or what you record</span></div>
      </div>
    </div>
  </section>

  <section class="stage stage--lift" id="player" aria-labelledby="player-title">
    <div class="wrap">
      <header class="chapter-head" data-reveal>
        <p class="eyebrow">The player</p>
        <h2 id="player-title" class="headline">Watch it where<br /><span class="text-silver">you write it.</span></h2>
        <p class="lede">Select a video and it plays in the right-hand panel, above its captions and readiness. <strong>It shows the cover until you press play, and it never autoplays.</strong></p>
      </header>
      <div data-reveal><PlayerDemo /></div>
      <div class="feature-grid mt-4" data-reveal>
        <div class="feature"><h3>Formats it can’t play, handled</h3><p>YouTube’s VP9 and AV1 above 1080p can’t be decoded in the panel, so Reelay offers an H.264 preview copy, made in the background, or opens it in QuickTime. The original is never touched.</p></div>
        <div class="feature"><h3>Lets go of the file</h3><p>The player releases a file the moment you switch videos, so renaming or moving it still works.</p></div>
        <div class="feature"><h3>Scrub from the grid</h3><p>The Library and Board are grids of thumbnails. Hover a card to scrub through the video before you open it.</p></div>
      </div>
    </div>
  </section>

  <section class="stage" id="transcripts" aria-labelledby="tr-title">
    <div class="wrap">
      <div class="split">
        <div data-reveal>
          <p class="eyebrow">Transcripts</p>
          <h2 id="tr-title" class="title">Search what was said.</h2>
          <p class="lede">Get from Original Post turns a post’s own captions into the ticket’s transcript: the creator’s subtitles first, otherwise the platform’s automatic ones. From then on, the Board’s search finds the video by its spoken words and shows you the quote.</p>
          <p class="fine mt-2">Reelay doesn’t run speech recognition to make transcripts, so a video posted without captions has no transcript to fetch.</p>
        </div>
        <div data-reveal style="--reveal-delay:.08s"><SearchScene /></div>
      </div>
    </div>
  </section>

  <section class="stage stage--lift" id="video-tools" aria-labelledby="tools-title">
    <div class="wrap">
      <header class="chapter-head" data-reveal>
        <p class="eyebrow">Video tools</p>
        <h2 id="tools-title" class="headline">Small edits.<br /><span class="text-silver">The original stays put.</span></h2>
        <p class="lede">Three edits, done by ffmpeg on your computer. Each writes a new <code>.edited.mp4</code> beside the original, and <strong>the edited copy is what gets posted</strong> until you choose Use Original.</p>
      </header>
      <div class="bento" data-reveal>
        <div class="tile span-2"><h3>Remove the sound</h3><p>For a clip you want silent everywhere, or to add a platform’s own sound when you post.</p></div>
        <div class="tile span-2"><h3>Replace the sound</h3><p>Swap in a track you have the rights to use.</p></div>
        <div class="tile span-2"><h3>Burn in captions</h3><p>From a .srt, .vtt or .ass file you have, or automatic captions when the free faster-whisper add-on is installed.</p></div>
      </div>
    </div>
  </section>

  <section class="stage stage--tight">
    <div class="wrap-narrow center">
      <p class="fine">Only import and republish media you own or have permission to manage, and follow each platform’s terms.</p>
    </div>
  </section>

  <NextUp kicker="Next" title="Board and Tickets" href={href('/features/pipeline')} />
</BaseLayout>

<style>
  .lib-stage { position: relative; isolation: isolate; max-width: 1180px; margin: 0 auto; }
  .names { list-style: none; display: grid; gap: 0.75rem; }
  .name-opt {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 1.1rem 1.25rem;
    border-radius: 18px;
    background: var(--r-fill);
  }
  .name-opt.on { background: rgba(240, 180, 76, 0.1); box-shadow: inset 0 0 0 1px rgba(245, 197, 107, 0.35); }
  .name-radio { flex: none; width: 1.15rem; height: 1.15rem; margin-top: 0.15rem; border-radius: 50%; box-shadow: inset 0 0 0 1.5px var(--r-ink-4); }
  .on .name-radio { box-shadow: inset 0 0 0 5px var(--r-amber); }
  .name-opt strong { display: block; font-size: 1.02rem; }
  .name-opt code { display: block; margin-top: 0.35rem; font-size: 0.82rem; color: var(--r-amber-text); overflow-wrap: anywhere; }
  .name-opt small { display: block; margin-top: 0.3rem; font-size: 0.85rem; color: var(--r-ink-3); }
  .lede code { font-size: 0.85em; color: var(--r-ink); }
</style>
