---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../data/site';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '');
---

<BaseLayout
  title={`Cross-Platform Pipeline & Kanban Board — ${SITE.fullName}`}
  description="Manage multi-platform video releases with Reelay's Kanban pipeline. 5 lifecycle stages, visual coverage maps, and Prepare to Publish handoffs."
>
  <div class="feature-page">
    <div class="container">
      <header class="feature-header">
        <a href={`${base}/features`} class="back-link">← All Features</a>
        <div class="badge-pill">
          <span class="pill-dot"></span>
          <span>PILLAR 02 • EDITORIAL FLOW</span>
        </div>
        <h1 class="feature-title">Cross-Platform Pipeline (Kanban)</h1>
        <p class="feature-lead">
          One master video, five target platforms. Track publishing readiness across YouTube Shorts, Instagram Reels, TikTok, Threads, and Facebook on a native visual board designed specifically for high-velocity video production.
        </p>
      </header>

      <!-- Interactive Kanban Pipeline Simulator -->
      <section class="kanban-simulator-section" aria-label="Interactive Kanban Board Simulation">
        <div class="simulator-header">
          <div class="sim-title-group">
            <span class="sim-indicator">● LIVE SIMULATOR</span>
            <h3>Interactive Production Board</h3>
          </div>
          <p class="sim-caption">Click stages or cards below to inspect platform readiness coverage maps.</p>
        </div>

        <div class="kanban-board-frame">
          <div class="board-top-bar">
            <div class="board-window-controls">
              <span class="dot red"></span>
              <span class="dot yellow"></span>
              <span class="dot green"></span>
            </div>
            <span class="board-title-label">Reelay Studio — Pipeline: Q4_Social_Launches</span>
            <span class="board-meta-tag">14 Active Media Cuts</span>
          </div>

          <div class="kanban-columns-grid" role="region" aria-label="Kanban Columns">
            <!-- Col 1: Backlog -->
            <div class="kanban-column" data-stage="backlog">
              <div class="column-header">
                <span class="col-name">01 BACKLOG</span>
                <span class="col-count">4</span>
              </div>
              <div class="card-stack">
                <div class="k-card active-card" tabindex="0" role="button" aria-label="Card: Apple Metal Whisper Benchmarks">
                  <div class="card-top-row">
                    <span class="card-codec">4K ProRes</span>
                    <span class="card-duration">01:14</span>
                  </div>
                  <h4 class="card-clip-title">Apple Metal Whisper Benchmarks</h4>
                  <div class="coverage-pills">
                    <span class="pill-tag ready" title="YouTube Ready">YT</span>
                    <span class="pill-tag draft" title="TikTok Drafting">TT</span>
                    <span class="pill-tag pending" title="Instagram Pending">IG</span>
                  </div>
                </div>
                <div class="k-card" tabindex="0" role="button" aria-label="Card: Studio Setup Walkthrough">
                  <div class="card-top-row">
                    <span class="card-codec">1080p VP9</span>
                    <span class="card-duration">00:48</span>
                  </div>
                  <h4 class="card-clip-title">Studio Setup Walkthrough</h4>
                  <div class="coverage-pills">
                    <span class="pill-tag ready">YT</span>
                    <span class="pill-tag ready">IG</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Col 2: Staging -->
            <div class="kanban-column" data-stage="staging">
              <div class="column-header">
                <span class="col-name">02 STAGING</span>
                <span class="col-count">3</span>
              </div>
              <div class="card-stack">
                <div class="k-card" tabindex="0" role="button" aria-label="Card: SQLite FTS5 Search Demo">
                  <div class="card-top-row">
                    <span class="card-codec">AV1 Proxy</span>
                    <span class="card-duration">00:52</span>
                  </div>
                  <h4 class="card-clip-title">SQLite FTS5 Search Demo</h4>
                  <div class="coverage-pills">
                    <span class="pill-tag ready">YT</span>
                    <span class="pill-tag ready">TT</span>
                    <span class="pill-tag ready">IG</span>
                    <span class="pill-tag draft">TH</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Col 3: Ready (Selected Default) -->
            <div class="kanban-column active-column" data-stage="ready">
              <div class="column-header">
                <span class="col-name">03 READY FOR RELEASE</span>
                <span class="col-count active-count">5</span>
              </div>
              <div class="card-stack">
                <div class="k-card featured-card" tabindex="0" role="button" aria-label="Card: Local AI MCP Architecture Guide">
                  <div class="card-top-row">
                    <span class="card-codec amber">9:16 Vertical</span>
                    <span class="card-duration">00:58</span>
                  </div>
                  <h4 class="card-clip-title">Local AI MCP Architecture Guide</h4>
                  <p class="card-hook-text">"Stop paying $50/mo cloud markups for video you already own."</p>
                  <div class="coverage-pills">
                    <span class="pill-tag ready">YT</span>
                    <span class="pill-tag ready">TT</span>
                    <span class="pill-tag ready">IG</span>
                    <span class="pill-tag ready">TH</span>
                    <span class="pill-tag ready">FB</span>
                  </div>
                  <div class="card-status-bar">
                    <span class="status-indicator">5/5 Channels Verified</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Col 4: Scheduled -->
            <div class="kanban-column" data-stage="scheduled">
              <div class="column-header">
                <span class="col-name">04 SCHEDULED</span>
                <span class="col-count">2</span>
              </div>
              <div class="card-stack">
                <div class="k-card" tabindex="0" role="button" aria-label="Card: Hardware Proxy Comparison">
                  <div class="card-top-row">
                    <span class="card-codec">1080p AV1</span>
                    <span class="card-duration">00:35</span>
                  </div>
                  <h4 class="card-clip-title">Hardware Proxy Comparison</h4>
                  <div class="coverage-pills">
                    <span class="pill-tag ready">YT</span>
                    <span class="pill-tag ready">IG</span>
                  </div>
                  <span class="schedule-badge">Tomorrow • 14:00 UTC</span>
                </div>
              </div>
            </div>

            <!-- Col 5: Published -->
            <div class="kanban-column" data-stage="published">
              <div class="column-header">
                <span class="col-name">05 PUBLISHED</span>
                <span class="col-count">8</span>
              </div>
              <div class="card-stack">
                <div class="k-card published-card" tabindex="0" role="button" aria-label="Card: Reelay Studio Launch Teaser">
                  <div class="card-top-row">
                    <span class="card-codec">Live Asset</span>
                    <span class="card-duration">00:45</span>
                  </div>
                  <h4 class="card-clip-title">Reelay Studio Launch Teaser</h4>
                  <div class="coverage-pills">
                    <span class="pill-tag live">Live 5/5</span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Active Card Inspection Drawer -->
          <div class="card-inspector-panel">
            <div class="inspector-header">
              <div class="inspector-badge">INSPECTED CARD METADATA</div>
              <h4>Local AI MCP Architecture Guide (Ready for Release)</h4>
            </div>
            <div class="inspector-grid">
              <div class="inspector-col">
                <span class="col-label">Media Specifications</span>
                <div class="spec-row"><span>Source Asset:</span> <code>render_final_mcp_v2.mp4</code></div>
                <div class="spec-row"><span>Aspect Ratio:</span> <strong>1080 × 1920 (9:16 Vertical)</strong></div>
                <div class="spec-row"><span>Hardware Proxy:</span> <strong>ProRes 422 Proxy (105 MB)</strong></div>
                <div class="spec-row"><span>Audio Transcript:</span> <strong>Whisper Large-v3 (100% On-Device)</strong></div>
              </div>
              <div class="inspector-col">
                <span class="col-label">Cross-Platform Coverage Validation</span>
                <div class="coverage-row">
                  <span class="platform-name">YouTube Shorts</span>
                  <span class="badge-status ready">✓ 100 char title • #Shorts tag present</span>
                </div>
                <div class="coverage-row">
                  <span class="platform-name">Instagram Reels</span>
                  <span class="badge-status ready">✓ 2,200 char caption formatted • Cover art bound</span>
                </div>
                <div class="coverage-row">
                  <span class="platform-name">TikTok</span>
                  <span class="badge-status ready">✓ Commercial sounds cleared • 4 hashtags</span>
                </div>
                <div class="coverage-row">
                  <span class="platform-name">Threads & Facebook</span>
                  <span class="badge-status ready">✓ Native text snippet & direct link ready</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Deep Dive Architectural Content -->
      <div class="deep-dive-content">
        <h2>1. The 5 Deterministic Lifecycle Gates</h2>
        <p>
          Generic issue trackers lack video-specific context. Reelay Studio enforces five deterministic publishing gates directly in its local SQLite database schema:
        </p>
        <div class="stages-flow">
          <div class="stage-item">
            <span class="stage-num">01</span>
            <div class="stage-desc-group">
              <strong>Backlog</strong>
              <p>Raw video cuts, external ingestions via <code>yt-dlp</code>, and unedited screen recordings awaiting review.</p>
            </div>
            <span class="stage-badge">Local Disk</span>
          </div>
          <div class="stage-item">
            <span class="stage-num">02</span>
            <div class="stage-desc-group">
              <strong>Staging</strong>
              <p>Drafting hook variations, running Whisper speech recognition, and generating platform-specific caption adaptations.</p>
            </div>
            <span class="stage-badge">In Progress</span>
          </div>
          <div class="stage-item">
            <span class="stage-num">03</span>
            <div class="stage-desc-group">
              <strong>Ready</strong>
              <p>Full validation passed: resolution conforms to 9:16, audio peaks normalized, hashtags within platform API limits.</p>
            </div>
            <span class="stage-badge active">Verified 5/5</span>
          </div>
          <div class="stage-item">
            <span class="stage-num">04</span>
            <div class="stage-desc-group">
              <strong>Scheduled</strong>
              <p>Locked into queue for direct HTTPS dispatch to platform APIs at the creator's target release hour.</p>
            </div>
            <span class="stage-badge">Queue Guard</span>
          </div>
          <div class="stage-item">
            <span class="stage-num">05</span>
            <div class="stage-desc-group">
              <strong>Published</strong>
              <p>Successfully uploaded with live platform URL references and publication receipts saved in local SQLite ledger.</p>
            </div>
            <span class="stage-badge live">Live Receipts</span>
          </div>
        </div>

        <h2>2. At-a-Glance Platform Coverage Map</h2>
        <p>
          Publishing to multiple destinations is fragile when character counts, hashtags, and aspect ratios differ. Reelay's Coverage Map evaluates every card against platform rules in real time:
        </p>
        <div class="coverage-preview card">
          <h4>Coverage Status Definitions</h4>
          <ul class="coverage-list">
            <li><span class="dot-ready">●</span> <strong>Green (Ready):</strong> Media dimensions, audio tracks, and platform copy are completely validated.</li>
            <li><span class="dot-pending">●</span> <strong>Amber (Drafting):</strong> Character limit exceeded, missing custom thumbnail, or pending Whisper transcription.</li>
            <li><span class="dot-handoff">●</span> <strong>Grey (Manual Handoff):</strong> Platform requires manual creator intervention or mobile app upload flow.</li>
          </ul>
        </div>

        <h2>3. "Prepare to Publish" Frictionless Handoff</h2>
        <p>
          Some platforms occasionally restrict third-party API scheduling (such as specific mobile-only sticker features or audio trending tags). Reelay solves this with its signature <strong>Prepare to Publish</strong> feature:
        </p>
        <div class="handoff-feature-card">
          <div class="handoff-col">
            <h4>One-Click Export Bundle</h4>
            <p>Packages final video cuts, copied platform captions, and exact hashtag strings into your clipboard and native export tray.</p>
          </div>
          <div class="handoff-col">
            <h4>AirDrop & Local Sharing</h4>
            <p>Instantly hands off raw media files to your mobile device or opens native platform web studios without re-rendering.</p>
          </div>
          <div class="handoff-col">
            <h4>Zero Deadlines Missed</h4>
            <p>When remote APIs experience outages or rate limits, your content release cadence remains completely unblocked.</p>
          </div>
        </div>

        <div class="cta-box">
          <h3>Take Command of Multi-Platform Publishing</h3>
          <p>Download Reelay Studio and manage your video production pipeline natively on your workstation.</p>
          <a href={`${base}/#download`} class="btn btn-primary">Download Reelay Studio</a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .feature-page {
    padding-top: clamp(3rem, 6vw, 5rem);
    padding-bottom: clamp(5rem, 8vw, 8rem);
  }

  .back-link {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 600;
    color: #94a3b8;
    margin-bottom: 1.5rem;
    display: inline-block;
    transition: color 0.15s ease;
  }
  .back-link:hover {
    color: #f8fafc;
  }

  .feature-header {
    margin-bottom: 3.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding-bottom: 3rem;
  }

  .badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem;
    background: rgba(245, 158, 11, 0.08);
    border: 1px solid rgba(245, 158, 11, 0.28);
    border-radius: 9999px;
    font-family: var(--font-mono, monospace);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: #fbbf24;
    text-transform: uppercase;
    margin-bottom: 1.25rem;
  }

  .pill-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #f59e0b;
    box-shadow: 0 0 8px rgba(245, 158, 11, 0.6);
  }

  .feature-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 4.25rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.1;
    background: var(--text-gradient-silver);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    margin-top: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .feature-lead {
    font-family: var(--font-body);
    font-size: clamp(1.15rem, 1.8vw, 1.35rem);
    color: #a1a1aa;
    line-height: 1.65;
    max-width: 840px;
  }

  /* Kanban Simulator Frame */
  .kanban-simulator-section {
    margin-bottom: 5rem;
  }

  .simulator-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 1.25rem;
  }

  .sim-title-group h3 {
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: #f8fafc;
    margin: 0.25rem 0 0 0;
  }

  .sim-indicator {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    color: #34d399;
    letter-spacing: 0.04em;
  }

  .sim-caption {
    font-family: var(--font-body);
    font-size: 0.88rem;
    color: #71717a;
    margin: 0;
  }

  .kanban-board-frame {
    background: #090a0f;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-lg, 16px);
    overflow: hidden;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.65);
  }

  .board-top-bar {
    background: #11121a;
    padding: 0.75rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .board-window-controls {
    display: flex;
    gap: 0.4rem;
  }

  .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
  }
  .dot.red { background-color: #ff5f56; }
  .dot.yellow { background-color: #ffbd2e; }
  .dot.green { background-color: #27c93f; }

  .board-title-label {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: #94a3b8;
  }

  .board-meta-tag {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: #fbbf24;
    background: rgba(245, 158, 11, 0.12);
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
  }

  .kanban-columns-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1rem;
    padding: 1.5rem;
    background: #06070a;
    overflow-x: auto;
  }

  .kanban-column {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 10px;
    padding: 1rem 0.85rem;
    display: flex;
    flex-direction: column;
    min-width: 190px;
  }

  .kanban-column.active-column {
    background: rgba(245, 158, 11, 0.03);
    border-color: rgba(245, 158, 11, 0.25);
  }

  .column-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .col-name {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    color: #94a3b8;
    letter-spacing: 0.03em;
  }

  .col-count {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: #64748b;
    background: rgba(255, 255, 255, 0.06);
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
  }

  .col-count.active-count {
    color: #fbbf24;
    background: rgba(245, 158, 11, 0.2);
  }

  .card-stack {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .k-card {
    background: #111218;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    padding: 0.85rem;
    cursor: pointer;
    transition: transform 0.15s ease, border-color 0.15s ease;
  }

  .k-card:hover, .k-card:focus {
    transform: translateY(-2px);
    border-color: rgba(255, 255, 255, 0.2);
    outline: none;
  }

  .k-card.featured-card {
    border-color: rgba(245, 158, 11, 0.5);
    background: linear-gradient(180deg, #181922 0%, #101117 100%);
    box-shadow: 0 4px 15px rgba(245, 158, 11, 0.12);
  }

  .card-top-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }

  .card-codec {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: #94a3b8;
    background: rgba(255, 255, 255, 0.06);
    padding: 0.1rem 0.35rem;
    border-radius: 3px;
  }
  .card-codec.amber {
    color: #fbbf24;
    background: rgba(245, 158, 11, 0.15);
  }

  .card-duration {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: #71717a;
  }

  .card-clip-title {
    font-size: 0.85rem;
    font-weight: 600;
    color: #f1f5f9;
    line-height: 1.3;
    margin: 0 0 0.5rem 0;
  }

  .card-hook-text {
    font-size: 0.74rem;
    color: #94a3b8;
    font-style: italic;
    line-height: 1.4;
    margin-bottom: 0.65rem;
  }

  .coverage-pills {
    display: flex;
    gap: 4px;
    flex-wrap: wrap;
  }

  .pill-tag {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 700;
    padding: 0.12rem 0.35rem;
    border-radius: 3px;
  }
  .pill-tag.ready { background: rgba(52, 211, 153, 0.15); color: #34d399; }
  .pill-tag.draft { background: rgba(245, 158, 11, 0.15); color: #fbbf24; }
  .pill-tag.pending { background: rgba(255, 255, 255, 0.06); color: #94a3b8; }
  .pill-tag.live { background: rgba(59, 130, 246, 0.2); color: #60a5fa; }

  .card-status-bar {
    margin-top: 0.75rem;
    padding-top: 0.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .status-indicator {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: #34d399;
    font-weight: 600;
  }

  .schedule-badge {
    display: block;
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: #fbbf24;
  }

  /* Card Inspector Panel */
  .card-inspector-panel {
    background: #0d0e15;
    border-top: 1px solid rgba(255, 255, 255, 0.09);
    padding: 1.5rem;
  }

  .inspector-header {
    margin-bottom: 1.25rem;
  }

  .inspector-badge {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    color: #fbbf24;
    letter-spacing: 0.05em;
    margin-bottom: 0.35rem;
  }

  .inspector-header h4 {
    font-family: var(--font-display);
    font-size: 1.2rem;
    color: #f8fafc;
    margin: 0;
  }

  .inspector-grid {
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: 2rem;
  }

  .col-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: #71717a;
    font-weight: 700;
    text-transform: uppercase;
    display: block;
    margin-bottom: 0.75rem;
  }

  .spec-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.84rem;
    padding: 0.4rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    color: #94a3b8;
  }
  .spec-row strong {
    color: #f1f5f9;
  }
  .spec-row code {
    font-family: var(--font-mono);
    color: #fbbf24;
  }

  .coverage-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.84rem;
    padding: 0.45rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .platform-name {
    font-weight: 600;
    color: #f1f5f9;
  }

  .badge-status.ready {
    font-size: 0.76rem;
    color: #34d399;
  }

  /* Deep Dive Stages Flow */
  .deep-dive-content {
    color: #cbd5e1;
    font-size: 1.05rem;
    line-height: 1.75;
  }

  .deep-dive-content h2 {
    font-family: var(--font-display);
    font-size: 1.75rem;
    color: #f8fafc;
    margin-top: 3.5rem;
