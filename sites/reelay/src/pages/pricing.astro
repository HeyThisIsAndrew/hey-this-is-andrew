---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import Faq from '../components/ui/Faq.astro';
import { SITE, DOWNLOADS, DATA_PATHS, PRICING, href } from '../data/site';

const included = [
  'Add a finished video by dragging it in, or bring in your own TikTok, Instagram, YouTube and Snapchat posts',
  'Repurpose: every platform’s copy drafted from the transcript, in your voice profile',
  'Copy and live limits for six platforms',
  'Readiness, the Ready gate and coverage map',
  'YouTube upload and scheduling',
  'Prepare to Publish for TikTok, Instagram and Snapchat',
  'Automations',
  'Archive search, transcripts included',
  'Video tools',
  'Agent API and MCP, with approvals',
  'Shared database',
  'Unlimited profiles and videos',
];

const faq = [
  { q: 'What do I get for the price?', a: `<p>A licence to use Reelay on the Macs you own or control, every feature, and <strong>${PRICING.updates}</strong> from the day you buy. ${PRICING.afterUpdates} We don’t sell a “lifetime” plan.</p>` },
  { q: 'Is there a subscription?', a: '<p>No. You pay once. There’s no Reelay account, no seat count and no storage plan, because your library and database live on your own Mac.</p>' },
  { q: 'What else might I pay for?', a: '<p>Repurpose drafts copy with Meta’s Muse Spark model using <strong>your own Meta API key</strong>, so Meta bills you for what you use under your agreement with them; Reelay adds nothing on top and never sees the key. Everything else, including YouTube posting (YouTube’s free daily API quota) and the local writing help, costs nothing extra.</p>' },
  { q: 'Do I need a Reelay account?', a: `<p>No. Everything Reelay needs is on your computer: your videos in your library folder (by default <code>${DATA_PATHS.library}</code>), your post records and captions in one local database, <code>${DATA_PATHS.dbName}</code>, and your platform sign-ins in the macOS Keychain. You connect your own platform accounts inside the app.</p>` },
  { q: 'Can I get a refund?', a: `<p>Yes, within ${PRICING.refund} of buying, for any reason: write to <a href="mailto:${SITE.supportEmail}">${SITE.supportEmail}</a>.</p>` },
  { q: 'What do I need to post to YouTube?', a: `<p>Until Reelay’s own Google sign-in is approved, you connect through a free Google Cloud project that you own. <strong>Accounts → Set Up YouTube…</strong> walks you through it in five steps. Uploads from a project Google hasn’t audited stay private, so see <a href="${href('/support')}#youtube-setup">Connecting YouTube</a> for the limits.</p>` },
  { q: 'What does it run on?', a: `<p>A Mac with Apple silicon on macOS 12 Monterey or later. On Windows 10 or 11 you build it yourself with the included PowerShell script, and on Linux you run it from source with Python 3.11 or later. <a href="${href('/download')}">Setup steps</a>.</p>` },
];
---

<BaseLayout
  title={`Pricing: ${SITE.fullName}`}
  description={`Reelay Studio is ${PRICING.amount} ${PRICING.terms}, with ${PRICING.updates}. No subscription and no Reelay account: your videos and database stay on your Mac.`}
>
  <PageHero eyebrow="Pricing">
    <Fragment slot="title">Pay once.<br /><span class="text-glow">Keep your work.</span></Fragment>
    <Fragment slot="lede">One licence, every feature, for as many creators as you manage. <strong>No subscription, no storage fees, and no Reelay account.</strong> Your work lives on your Mac, so there’s nothing for us to charge you rent on.</Fragment>
  </PageHero>

  <section class="stage stage--flush-top" aria-labelledby="plan-title">
    <div class="wrap">
      <div class="plan" data-reveal>
        <div class="plan-price">
          <h2 id="plan-title" class="sr-only">Reelay Studio licence</h2>
          <p class="plan-name">Reelay Studio {SITE.version}</p>
          <p class="plan-amount"><span>{PRICING.amount}</span><small>{PRICING.terms}, {PRICING.updates}</small></p>
          <a class="btn btn-primary btn-lg" href={PRICING.purchaseUrl}>Buy Reelay</a>
          <a class="link-more" href={DOWNLOADS.macArm.href}>Download for Mac</a>
          <p class="fine">{DOWNLOADS.macArm.requirements}. {PRICING.afterUpdates}</p>
        </div>
        <ul class="plan-list">
          {included.map((i) => <li>{i}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="stage stage--lift" id="no-cloud-bill" aria-labelledby="costs-title" data-sec data-pn-label="No cloud bill">
    <div class="wrap">
      <header class="chapter-head" data-reveal data-sec-head>
        <p class="eyebrow">Why it can be</p>
        <h2 id="costs-title" class="headline" data-pn-label="No cloud bill">No cloud.<br /><span class="text-silver">No cloud bill.</span></h2>
      </header>
      <div class="spec-rail" data-reveal>
        <div class="spec"><span class="spec-value">$0</span><span class="spec-label"><strong>Storage</strong>Your videos and database are on your own disk.</span></div>
        <div class="spec"><span class="spec-value">0</span><span class="spec-label"><strong>Markup on AI</strong>Repurpose uses your own Meta API key; local writing help runs on your Mac.</span></div>
        <div class="spec"><span class="spec-value">0</span><span class="spec-label"><strong>Seats</strong>Share a database through a folder you already sync.</span></div>
      </div>
    </div>
  </section>

  <section class="stage" id="questions" aria-labelledby="faq-title" data-sec data-pn-label="Questions">
    <div class="wrap-narrow">
      <h2 id="faq-title" class="title" data-reveal data-sec-head>Questions</h2>
      <div class="mt-2" data-reveal><Faq items={faq} /></div>
      <p class="mt-3" data-reveal><a class="link-more" href={href('/download')}>Download, release notes and checksum</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .plan {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    padding: clamp(2rem, 5vw, 4rem);
    border-radius: var(--radius-xl);
    background:
      radial-gradient(60% 80% at 0% 0%, rgba(240, 170, 60, 0.18), transparent 65%),
      var(--r-panel);
    box-shadow: var(--r-panel-shadow), 0 60px 140px -50px var(--r-glow-1);
  }
  @media (min-width: 860px) {
    .plan { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); align-items: center; }
  }
  .plan-price { display: flex; flex-direction: column; align-items: flex-start; gap: 1rem; }
  .plan-name { font-weight: 600; color: var(--r-amber-text); }
  .plan-amount span { display: block; font-family: var(--font-display); font-size: clamp(5rem, 12vw, 8.5rem); font-weight: 700; line-height: 0.9; letter-spacing: -0.06em; color: var(--r-ink); }
  .plan-amount small { display: block; margin-top: 0.5rem; font-size: 1.1rem; color: var(--r-ink-3); }
  .plan-list { list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); gap: 0 2rem; }
  .plan-list li { position: relative; padding: 0.8rem 0 0.8rem 1.75rem; border-top: 1px solid var(--hairline); color: var(--r-ink); font-size: 0.98rem; }
  .plan-list li::before { content: ''; position: absolute; left: 0.15rem; top: 1.2rem; width: 0.6rem; height: 0.32rem; border-left: 2px solid var(--r-amber-text); border-bottom: 2px solid var(--r-amber-text); transform: rotate(-45deg); }
</style>
