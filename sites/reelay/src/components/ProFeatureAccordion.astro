---
/**
 * ProFeatureAccordion: Horizontal Kinetic Capability Switcher.
 * An Apple-standard interactive switcher for Reelay's 5 core capabilities:
 * Automations, Local LLM Writing Assist, ffmpeg Video Tools, Local Agent API,
 * and Multi-Creator Profiles & Vault.
 *
 * Test hooks: five [data-accordion-header] buttons with aria-expanded & aria-selected.
 */
import { href, AGENT_API } from '../data/site';

const drawers = [
  {
    id: 'automations',
    num: '01',
    shortTitle: 'Automations',
    title: 'Automations',
    kicker: 'When · If · Then Rules',
    body: 'When a video is added or moved, if its caption, hashtag, length or source matches, then fill an empty field from a template, add hashtags, pick platforms or schedule it for a day and time. A rule acts on each video once, templates never overwrite what you typed, and everything it does is logged.',
    link: { label: 'Explore Automations', href: href('/features/automations') },
    tags: ['Rules engine', 'Zero overwrite', 'Action log'],
  },
  {
    id: 'writing',
    num: '02',
    shortTitle: 'Writing assist',
    title: 'Writing help, on your computer',
    kicker: 'Local LLM · No Cloud',
    body: 'An Assist menu on every caption: spelling and grammar, rewrites through a model running on your own machine (Ollama or llama.cpp), and brand-voice profiles. Suggestions are only ever suggestions. No paid AI, no tokens.',
    link: { label: 'How it stays local', href: `${href('/ai')}#writing-help` },
    tags: ['Ollama / llama.cpp', 'Brand voice', 'Zero tokens'],
  },
  {
    id: 'video-tools',
    num: '03',
    shortTitle: 'Video tools',
    title: 'Video tools',
    kicker: 'ffmpeg · Non-destructive',
    body: 'Remove the sound, replace it with a track you have rights to, or burn in captions from a .srt, .vtt or .ass file, all with ffmpeg on this computer. The original is never changed; the edited copy is what gets posted until you choose Use Original.',
    link: { label: 'Library and player', href: href('/features/library') },
    tags: ['Strip / swap audio', 'Burn captions', 'Original intact'],
  },
  {
    id: 'agents',
    num: '04',
    shortTitle: 'Agent API',
    title: 'An API for your agents',
    kicker: 'Local HTTP · OpenAPI 3.1',
    body: 'A local HTTP API with an OpenAPI 3.1 description, so an agent can read the board and draft copy. Anything that posts, archives or changes many tickets waits for a person to approve it on the Mac. Agents can ask; they can’t approve.',
    link: { label: 'Explore the Agent API', href: href('/ai') },
    tags: ['localhost:8471', 'OpenAPI 3.1', 'Approval gate'],
  },
  {
    id: 'profiles',
    num: '05',
    shortTitle: 'Profiles & Vault',
    title: 'Profiles and a shared database',
    kicker: 'Multi-creator · SQLite',
    body: 'One profile per creator, each with its own library folder, board and channels. Move the database into Google Drive, Dropbox, iCloud Drive or OneDrive and a teammate can open it too: one editor at a time, everyone else view-only.',
    link: { label: 'Board and tickets', href: href('/features/pipeline') },
    tags: ['Folder isolation', 'Cloud sync ready', 'Single-writer lock'],
  },
];
---
<section class="stage stage--lift acc" id="four-pillars" aria-labelledby="acc-title">
  <div class="wrap">
    <header class="chapter-head" data-reveal>
      <p class="eyebrow">Deep capabilities</p>
      <h2 id="acc-title" class="headline">Built in.<br /><span class="text-silver">Not bolted on.</span></h2>
      <p class="lede">Every capability runs directly on your Apple silicon Mac. No subscriptions, no cloud middleware, no remote data leakage.</p>
    </header>

    <div class="kinetic-switcher" data-accordion>
      <div class="switcher-track-wrap" data-reveal>
        <div class="switcher-track" role="tablist" aria-label="Reelay deep capabilities">
          {drawers.map((d, i) => (
            <button
              type="button"
              class:list={['switcher-tab', { 'is-active': i === 0 }]}
              id={`acc-${d.id}`}
              role="tab"
              data-accordion-header
              data-target={d.id}
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-expanded={i === 0 ? 'true' : 'false'}
              aria-controls={`acc-panel-${d.id}`}
              tabindex={i === 0 ? 0 : -1}
            >
              <span class="tab-num">{d.num}</span>
              <span class="tab-label">{d.shortTitle}</span>
            </button>
          ))}
        </div>
      </div>

      <div class="showcase-card" data-reveal>
        <div class="showcase-narrative">
          {drawers.map((d, i) => (
            <div
              class:list={['capability-panel', { 'is-active': i === 0 }]}
              id={`acc-panel-${d.id}`}
              role="tabpanel"
              aria-labelledby={`acc-${d.id}`}
              hidden={i !== 0}
            >
              <span class="panel-kicker">{d.kicker}</span>
              <h3 class="panel-title">{d.title}</h3>
              <p class="panel-body">{d.body}</p>
              <div class="panel-tags" aria-label="Key guarantees">
                {d.tags.map((t) => <span class="tag-pill">{t}</span>)}
              </div>
              <div class="panel-action">
                <a class="link-more" href={d.link.href}>
                  {d.link.label}
                </a>
              </div>
            </div>
          ))}
        </div>

        <div class="showcase-visual-stage" aria-hidden="true">
          <div class="acc-vis is-on" data-acc-vis="automations">
            <div class="rule">
              <p><span class="k">When</span> a video is added to the board</p>
              <p><span class="k">If</span> the caption contains <em>“recipe”</em></p>
              <p><span class="k">Then</span> fill the TikTok caption from <em>{'{hook}'} {'{hashtags}'}</em></p>
              <p><span class="k">And</span> schedule it for next Tuesday at 9:00</p>
            </div>
            <p class="vis-note">Scheduling still goes through the Ready gate.</p>
          </div>

          <div class="acc-vis" data-acc-vis="writing">
            <div class="assist">
              <p class="assist-text">the last ten minutes of light on the big sur coast, <u>shot hand held</u> from the turnout</p>
              <div class="assist-pop">
                <span class="assist-h">Assist</span>
                <span>Spelling: <b>handheld</b></span>
                <span>Rewrite in my brand voice</span>
                <span>Get SEO Suggestions</span>
                <span class="assist-model">Model: llama3.2:3b on this Mac</span>
              </div>
            </div>
          </div>

          <div class="acc-vis" data-acc-vis="video-tools">
            <div class="files">
              <div class="file"><span class="still still--snow fthumb"></span><span><b>first-snow.mp4</b><small>Original, never changed</small></span></div>
              <div class="arrow">ffmpeg · burn in captions.srt</div>
              <div class="file hot"><span class="still still--snow fthumb"><i class="sub">first snow and I was not ready</i></span><span><b>first-snow.edited.mp4</b><small>This copy gets posted</small></span></div>
            </div>
          </div>

          <div class="acc-vis" data-acc-vis="agents">
            <div class="term">
              <p><span class="dim">$</span> curl -X POST {AGENT_API.url}/v1/videos/42/schedule</p>
              <p class="dim">HTTP/1.1 202 Accepted</p>
              <p>{'{'} "status": <span class="amb">"pending"</span>, "approval_id": 17, "operation": "schedule" {'}'}</p>
            </div>
            <div class="term term--you">
              <p class="dim"># On the Mac, a person decides</p>
              <p><span class="dim">$</span> python -m reelay.approvals show 17</p>
              <p class="dim">schedule · Desert road trip, day four · YouTube</p>
              <p><span class="dim">$</span> python -m reelay.approvals <span class="amb">approve</span> 17</p>
            </div>
          </div>

          <div class="acc-vis" data-acc-vis="profiles">
            <div class="profiles">
              {[
                ['JL', 'Juniper Lane', '#f5c56b,#d9653b', 'Editing'],
                ['MR', 'Mesa Roasters', '#5eb1ff,#2f5fd0', 'View only'],
                ['HK', 'Harbor Kitchen', '#5fe08a,#1f8a4c', 'View only'],
              ].map(([ini, name, g, state]) => (
                <div class="prof">
                  <span class="pav" style={`background:linear-gradient(135deg,${g})`}>{ini}</span>
                  <span><b>{name}</b><small>{state}</small></span>
                </div>
              ))}
              <p class="vis-note">reelay.db in a shared Dropbox folder · one editor at a time</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .kinetic-switcher {
    margin-top: clamp(2rem, 4vw, 3.5rem);
  }

  .switcher-track-wrap {
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    padding: 0.25rem 0.25rem 1.25rem;
    margin: 0 -0.5rem;
  }
  .switcher-track-wrap::-webkit-scrollbar {
    display: none;
  }

  .switcher-track {
    display: flex;
    gap: 0.65rem;
    min-width: min-content;
    justify-content: flex-start;
    padding: 0 0.5rem;
  }
  @media (min-width: 960px) {
    .switcher-track {
      justify-content: center;
    }
  }

  .switcher-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.7rem 1.25rem;
    border-radius: 999px;
    border: 1px solid var(--hairline-strong);
    background: var(--r-fill);
    color: var(--r-ink-3);
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    flex: 0 0 auto;
    transition: all 0.25s var(--r-ease);
  }
  .switcher-tab:hover {
    color: var(--r-ink);
    border-color: var(--hairline-hover, rgba(255, 255, 255, 0.2));
    background: var(--r-fill-2);
  }
  .switcher-tab.is-active,
  .switcher-tab[aria-selected='true'] {
    color: var(--r-ink);
    background: rgba(245, 197, 107, 0.12);
    border-color: rgba(245, 197, 107, 0.45);
    box-shadow: 0 0 24px -4px rgba(245, 197, 107, 0.25);
  }

  .tab-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.45rem;
    height: 1.45rem;
    border-radius: 50%;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 700;
    background: var(--r-fill-3);
    color: var(--r-ink-3);
    transition: all 0.25s var(--r-ease);
  }
  .switcher-tab.is-active .tab-num,
  .switcher-tab[aria-selected='true'] .tab-num {
    background: var(--r-amber);
    color: var(--r-on-amber);
  }

  .showcase-card {
    display: grid;
    grid-template-columns: 1fr;
    border-radius: var(--radius-xl);
    background: var(--r-panel);
    border: 1px solid var(--hairline-strong);
    box-shadow: var(--r-panel-shadow);
    overflow: hidden;
  }
  @media (min-width: 960px) {
    .showcase-card {
      grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.15fr);
      min-height: 28rem;
    }
  }

  .showcase-narrative {
    padding: clamp(1.75rem, 4vw, 3rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .capability-panel {
    display: none;
  }
  .capability-panel.is-active,
  .capability-panel:not([hidden]) {
    display: block;
    animation: panel-fade 0.45s var(--r-ease) both;
  }
  @keyframes panel-fade {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .panel-kicker {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 700;
    color: var(--r-amber-text);
  }
  .panel-title {
    margin: 0.5rem 0 1rem;
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.4vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.2;
    color: var(--r-ink);
  }
  .panel-body {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--r-ink-2);
    max-width: 34rem;
    margin-bottom: 1.5rem;
  }
  .panel-tags {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.75rem;
  }
  .tag-pill {
    font-size: 0.78rem;
    font-weight: 500;
    padding: 0.28rem 0.7rem;
    border-radius: 999px;
    background: var(--r-fill-2);
    border: 1px solid var(--hairline);
    color: var(--r-ink-2);
  }
  .panel-action {
    margin-top: 0.25rem;
  }

  .showcase-visual-stage {
    position: relative;
    min-height: 25rem;
    background: rgba(0, 0, 0, 0.25);
    border-top: 1px solid var(--hairline);
    overflow: hidden;
  }
  @media (min-width: 960px) {
    .showcase-visual-stage {
      border-top: 0;
      border-left: 1px solid var(--hairline);
      min-height: 100%;
    }
  }

  .acc-vis {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(1.5rem, 4vw, 3rem);
    opacity: 0;
    transform: scale(0.98);
    transition: opacity 0.45s ease, transform 0.5s var(--r-ease);
    pointer-events: none;
  }
  .acc-vis.is-on {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
  .vis-note {
    margin-top: 1.25rem;
    font-size: 0.85rem;
    color: var(--r-ink-4);
  }

  .rule {
    display: grid;
    gap: 0.75rem;
  }
  .rule p {
    font-size: clamp(0.98rem, 1.5vw, 1.15rem);
    color: var(--r-ink);
    padding: 0.85rem 1.1rem;
    border-radius: 14px;
    background: var(--r-fill-2);
    border: 1px solid var(--hairline);
  }
  .rule .k {
    display: inline-block;
    min-width: 3.4rem;
    font-weight: 700;
    color: var(--r-amber-text);
  }
  @media (max-width: 560px) {
    .rule .k {
      display: block;
      min-width: 0;
      margin-bottom: 0.15rem;
    }
  }
  .rule em {
    font-style: normal;
    font-family: var(--font-mono);
    font-size: 0.9em;
    color: var(--r-amber-text);
  }

  .assist {
    position: relative;
  }
  .assist-text {
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--r-ink);
    padding: 1.1rem 1.25rem;
    border-radius: 14px;
    background: var(--r-input);
    box-shadow: inset 0 0 0 1px var(--hairline);
  }
  .assist-text u {
    text-decoration: underline wavy #ff6a5f;
    text-underline-offset: 4px;
  }
  .assist-pop {
    display: grid;
    gap: 0.15rem;
    width: min(100%, 18rem);
    margin: 0.75rem 0 0 auto;
    padding: 0.5rem;
    border-radius: 14px;
    background: rgba(36, 36, 40, 0.95);
    box-shadow: var(--r-float-shadow);
    font-size: 0.92rem;
    border: 1px solid var(--hairline-strong);
  }
  .assist-pop span {
    padding: 0.5rem 0.65rem;
    border-radius: 8px;
    color: var(--r-ink-2);
  }
  .assist-pop span:nth-child(2) {
    background: var(--r-amber);
    color: var(--r-on-amber);
  }
  .assist-pop span:nth-child(2) b {
    color: var(--r-on-amber);
  }
  .assist-h {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--r-ink-4) !important;
  }
  .assist-model {
    font-size: 0.78rem;
    color: var(--r-ink-4) !important;
  }

  .files {
    display: grid;
    gap: 0.9rem;
  }
  .file {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem;
    border-radius: 16px;
    background: var(--r-fill);
    border: 1px solid var(--hairline);
  }
  .file.hot {
    background: rgba(240, 180, 76, 0.1);
    box-shadow: inset 0 0 0 1px rgba(245, 197, 107, 0.35);
  }
  .fthumb {
    width: 4.5rem;
    height: 6rem;
    border-radius: 10px;
    flex: none;
  }
  .sub {
    position: absolute;
    z-index: 1;
    left: 6%;
    right: 6%;
    bottom: 10%;
    font-style: normal;
    font-size: 0.48rem;
    line-height: 1.2;
    text-align: center;
    color: #fff;
    text-shadow: 0 1px 2px #000;
  }
  .file b {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--r-ink);
  }
  .file small {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.85rem;
    color: var(--r-ink-3);
  }
  .arrow {
    padding-left: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--r-amber-text);
  }

  .term {
    padding: 1.1rem 1.25rem;
    border-radius: 14px;
    background: var(--r-code-bg);
    box-shadow: inset 0 0 0 1px var(--hairline);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    line-height: 1.7;
    color: var(--r-ink);
    overflow-x: auto;
  }
  .term p {
    color: var(--r-ink);
    white-space: nowrap;
  }
  .term .dim {
    color: var(--r-ink-4);
  }
  .term .amb {
    color: var(--r-amber-text);
  }
  .term--you {
    margin-top: 0.9rem;
    box-shadow: inset 0 0 0 1px rgba(245, 197, 107, 0.3);
  }

  .profiles {
    display: grid;
    gap: 0.6rem;
  }
  .prof {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.8rem 1rem;
    border-radius: 16px;
    background: var(--r-fill);
    border: 1px solid var(--hairline);
  }
  .prof:first-child {
    background: var(--r-fill-3);
  }
  .pav {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    font-size: 0.85rem;
    font-weight: 700;
    color: #111;
  }
  .prof b {
    display: block;
    font-size: 1rem;
  }
  .prof small {
    font-size: 0.85rem;
    color: var(--r-ink-3);
  }

  @media (prefers-reduced-motion: reduce) {
    .acc-vis,
    .switcher-tab,
    .tab-num {
      transition: none;
    }
    .capability-panel.is-active,
    .capability-panel:not([hidden]) {
      animation: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-accordion]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-accordion-header]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('.capability-panel'));
    const visuals = Array.from(root.querySelectorAll<HTMLElement>('[data-acc-vis]'));

    const activate = (idx: number, focus = false) => {
      tabs.forEach((tab, i) => {
        const on = i === idx;
        tab.classList.toggle('is-active', on);
        tab.setAttribute('aria-selected', String(on));
        tab.setAttribute('aria-expanded', String(on));
        tab.setAttribute('tabindex', on ? '0' : '-1');
        if (on && focus) tab.focus();
      });

      const activeTarget = tabs[idx]?.dataset.target;
      panels.forEach((p) => {
        const match = p.id === `acc-panel-${activeTarget}`;
        p.classList.toggle('is-active', match);
        p.hidden = !match;
      });

      visuals.forEach((v) => {
        v.classList.toggle('is-on', v.dataset.accVis === activeTarget);
      });
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => activate(i));
      tab.addEventListener('keydown', (e) => {
        let next = i;
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
          next = (i + 1) % tabs.length;
          e.preventDefault();
          activate(next, true);
        } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
          next = (i - 1 + tabs.length) % tabs.length;
          e.preventDefault();
          activate(next, true);
        } else if (e.key === 'Home') {
          e.preventDefault();
          activate(0, true);
        } else if (e.key === 'End') {
          e.preventDefault();
          activate(tabs.length - 1, true);
        }
      });
    });
  });
</script>
