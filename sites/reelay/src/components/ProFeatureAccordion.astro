      display: none;
    }

    .panel-body {
      flex: 1 1 0%;
      min-width: 0;
      height: 100%;
      overflow-y: auto;
    }

    .acc-panel.is-collapsed .panel-body {
      opacity: 0;
      pointer-events: none;
      position: absolute;
