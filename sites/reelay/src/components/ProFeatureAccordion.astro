---
/**
 * ProFeatureAccordion: the rest of the app, Apple-style. A hairline list of
 * headings on one side, one picture on the other that follows whichever
 * heading is open. One drawer is open at a time; the first renders open.
 *
 * Test hooks: five [data-accordion-header] buttons with aria-expanded.
 */
import { href, AGENT_API } from '../data/site';

const drawers = [
  {
    id: 'automations',
    title: 'Automations',
    body: 'When a video is added or moved, if its caption, hashtag, length or source matches, then fill an empty field from a template, add hashtags, pick platforms or schedule it for a day and time. A rule acts on each video once, templates never overwrite what you typed, and everything it does is logged.',
    link: { label: 'Explore Automations', href: href('/features/automations') },
  },
  {
    id: 'writing',
    title: 'Writing help, on your computer',
    body: 'An Assist menu on every caption: spelling and grammar, rewrites through a model running on your own machine (Ollama or llama.cpp), and brand-voice profiles. Suggestions are only ever suggestions. No paid AI, no tokens.',
    link: { label: 'How it stays local', href: `${href('/ai')}#writing-help` },
  },
  {
    id: 'video-tools',
    title: 'Video tools',
    body: 'Remove the sound, replace it with a track you have rights to, or burn in captions from a .srt, .vtt or .ass file, all with ffmpeg on this computer. The original is never changed; the edited copy is what gets posted until you choose Use Original.',
    link: { label: 'Library and player', href: href('/features/library') },
  },
  {
    id: 'agents',
    title: 'An API for your agents',
    body: `A local HTTP API with an OpenAPI 3.1 description, so an agent can read the board and draft copy. Anything that posts, archives or changes many tickets waits for a person to approve it on the Mac. Agents can ask; they can’t approve.`,
    link: { label: 'Explore the Agent API', href: href('/ai') },
  },
  {
    id: 'profiles',
    title: 'Profiles and a shared database',
    body: 'One profile per creator, each with its own library folder, board and channels. Move the database into Google Drive, Dropbox, iCloud Drive or OneDrive and a teammate can open it too: one editor at a time, everyone else view-only.',
    link: { label: 'Board and tickets', href: href('/features/pipeline') },
  },
];
---
<section class="stage stage--lift acc" id="four-pillars" aria-labelledby="acc-title">
  <div class="wrap">
    <header class="chapter-head" data-reveal>
      <p class="eyebrow">And there’s more</p>
      <h2 id="acc-title" class="headline">Built in.<br /><span class="text-silver">Not bolted on.</span></h2>
    </header>

    <div class="acc-grid" data-accordion>
      <div class="acc-list">
        {drawers.map((d, i) => (
          <div class="acc-item" data-acc-item={d.id}>
            <h3 class="acc-h">
              <button
                type="button"
                class="acc-btn"
                id={`acc-${d.id}`}
                data-accordion-header
                aria-expanded={i === 0 ? 'true' : 'false'}
                aria-controls={`acc-panel-${d.id}`}
              >
                <span>{d.title}</span>
                <span class="acc-plus" aria-hidden="true"></span>
              </button>
            </h3>
            <div class="acc-panel" id={`acc-panel-${d.id}`} role="region" aria-labelledby={`acc-${d.id}`} hidden={i !== 0}>
              <p>{d.body}</p>
              <a class="link-more" href={d.link.href}>{d.link.label}</a>
            </div>
          </div>
        ))}
      </div>

      <div class="acc-stage" aria-hidden="true">
        <div class="acc-vis is-on" data-acc-vis="automations">
          <div class="rule">
            <p><span class="k">When</span> a video is added to the board</p>
            <p><span class="k">If</span> the caption contains <em>“recipe”</em></p>
            <p><span class="k">Then</span> fill the TikTok caption from <em>{'{hook}'} {'{hashtags}'}</em></p>
            <p><span class="k">And</span> schedule it for next Tuesday at 9:00</p>
          </div>
          <p class="vis-note">Scheduling still goes through the Ready gate.</p>
        </div>
        <div class="acc-vis" data-acc-vis="writing">
          <div class="assist">
            <p class="assist-text">the last ten minutes of light on the big sur coast, <u>shot hand held</u> from the turnout</p>
            <div class="assist-pop">
              <span class="assist-h">Assist</span>
              <span>Spelling: <b>handheld</b></span>
              <span>Rewrite in my brand voice</span>
              <span>Get SEO Suggestions</span>
              <span class="assist-model">Model: llama3.2:3b on this Mac</span>
            </div>
          </div>
        </div>
        <div class="acc-vis" data-acc-vis="video-tools">
          <div class="files">
            <div class="file"><span class="still still--snow fthumb"></span><span><b>first-snow.mp4</b><small>Original, never changed</small></span></div>
            <div class="arrow">ffmpeg · burn in captions.srt</div>
            <div class="file hot"><span class="still still--snow fthumb"><i class="sub">first snow and I was not ready</i></span><span><b>first-snow.edited.mp4</b><small>This copy gets posted</small></span></div>
          </div>
        </div>
        <div class="acc-vis" data-acc-vis="agents">
          <div class="term">
            <p><span class="dim">$</span> curl -X POST {AGENT_API.url}/v1/videos/42/schedule</p>
            <p class="dim">HTTP/1.1 202 Accepted</p>
            <p>{'{'} "status": <span class="amb">"pending"</span>, "approval_id": 17, "operation": "schedule" {'}'}</p>
          </div>
          <div class="term term--you">
            <p class="dim"># On the Mac, a person decides</p>
            <p><span class="dim">$</span> python -m reelay.approvals show 17</p>
            <p class="dim">schedule · Desert road trip, day four · YouTube</p>
            <p><span class="dim">$</span> python -m reelay.approvals <span class="amb">approve</span> 17</p>
          </div>
        </div>
        <div class="acc-vis" data-acc-vis="profiles">
          <div class="profiles">
            {[
              ['JL', 'Juniper Lane', '#f5c56b,#d9653b', 'Editing'],
              ['MR', 'Mesa Roasters', '#5eb1ff,#2f5fd0', 'View only'],
              ['HK', 'Harbor Kitchen', '#5fe08a,#1f8a4c', 'View only'],
            ].map(([ini, name, g, state]) => (
              <div class="prof">
                <span class="pav" style={`background:linear-gradient(135deg,${g})`}>{ini}</span>
                <span><b>{name}</b><small>{state}</small></span>
              </div>
            ))}
            <p class="vis-note">reelay.db in a shared Dropbox folder · one editor at a time</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .acc-grid { display: grid; gap: clamp(2.5rem, 5vw, 5rem); align-items: start; }
  @media (min-width: 960px) {
    .acc-grid { grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); }
    .acc-stage { position: sticky; top: calc(var(--r-nav-h) + 3rem); }
  }
  .acc-item { border-top: 1px solid var(--hairline-strong); }
  .acc-item:last-child { border-bottom: 1px solid var(--hairline-strong); }
  .acc-h { font-size: inherit; }
  .acc-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    min-height: 64px;
    padding: 1.15rem 0;
    border: 0;
    background: none;
    cursor: pointer;
    text-align: left;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2vw, 1.6rem);
    font-weight: 650;
    letter-spacing: -0.025em;
    color: var(--r-ink-3);
    transition: color 0.25s ease;
  }
  .acc-btn:hover, .acc-btn[aria-expanded='true'] { color: var(--r-ink); }
  .acc-plus { position: relative; flex: none; width: 1.75rem; height: 1.75rem; border-radius: 50%; background: var(--r-fill-3); transition: transform 0.4s var(--r-ease), background-color 0.25s ease; }
  .acc-plus::before, .acc-plus::after { content: ''; position: absolute; left: 50%; top: 50%; width: 0.7rem; height: 1.6px; margin: -0.8px 0 0 -0.35rem; border-radius: 1px; background: currentColor; }
  .acc-plus::after { transform: rotate(90deg); transition: transform 0.4s var(--r-ease); }
  .acc-btn[aria-expanded='true'] .acc-plus { background: var(--r-amber); color: var(--r-on-amber); transform: rotate(180deg); }
  .acc-btn[aria-expanded='true'] .acc-plus::after { transform: rotate(0deg); }
  .acc-panel { padding: 0 0 1.5rem; }
  .acc-panel p { font-size: 1.05rem; line-height: 1.55; color: var(--r-ink-2); max-width: 34rem; }
  .acc-panel .link-more { margin-top: 0.35rem; }
  .acc-panel:not([hidden]) { animation: acc-in 0.5s var(--r-ease) both; }
  @keyframes acc-in { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: none; } }

  .acc-stage {
    position: relative;
    min-height: 26rem;
    border-radius: var(--radius-xl);
    background:
      var(--r-panel);
    box-shadow: var(--r-panel-shadow);
    overflow: hidden;
  }
  .acc-vis {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(1.5rem, 4vw, 3rem);
    opacity: 0;
    transform: scale(0.98);
    transition: opacity 0.5s ease, transform 0.6s var(--r-ease);
    pointer-events: none;
  }
  .acc-vis.is-on { opacity: 1; transform: none; }
  .vis-note { margin-top: 1.25rem; font-size: 0.85rem; color: var(--r-ink-4); }

  .rule { display: grid; gap: 0.75rem; }
  .rule p { font-size: clamp(1rem, 1.6vw, 1.2rem); color: var(--r-ink); padding: 0.85rem 1.1rem; border-radius: 14px; background: var(--r-fill-2); }
  .rule .k { display: inline-block; min-width: 3.4rem; font-weight: 700; color: var(--r-amber-text); }
  @media (max-width: 560px) { .rule .k { display: block; min-width: 0; margin-bottom: 0.15rem; } }
  .rule em { font-style: normal; font-family: var(--font-mono); font-size: 0.9em; color: var(--r-amber-text); }

  .assist { position: relative; }
  .assist-text { font-size: 1.15rem; line-height: 1.6; color: var(--r-ink); padding: 1.1rem 1.25rem; border-radius: 14px; background: var(--r-input); box-shadow: inset 0 0 0 1px var(--hairline); }
  .assist-text u { text-decoration: underline wavy #ff6a5f; text-underline-offset: 4px; }
  .assist-pop { display: grid; gap: 0.15rem; width: min(100%, 18rem); margin: 0.75rem 0 0 auto; padding: 0.5rem; border-radius: 14px; background: rgba(36, 36, 40, 0.95); box-shadow: var(--r-float-shadow); font-size: 0.92rem; }
  .assist-pop span { padding: 0.5rem 0.65rem; border-radius: 8px; color: var(--r-ink-2); }
  .assist-pop span:nth-child(2) { background: var(--r-amber); color: var(--r-on-amber); }
  .assist-pop span:nth-child(2) b { color: var(--r-on-amber); }
  .assist-h { font-size: 0.72rem; font-weight: 700; color: var(--r-ink-4) !important; }
  .assist-model { font-size: 0.78rem; color: var(--r-ink-4) !important; }

  .files { display: grid; gap: 0.9rem; }
  .file { display: flex; align-items: center; gap: 1rem; padding: 0.75rem; border-radius: 16px; background: var(--r-fill); }
  .file.hot { background: rgba(240, 180, 76, 0.1); box-shadow: inset 0 0 0 1px rgba(245, 197, 107, 0.35); }
  .fthumb { width: 4.5rem; height: 6rem; border-radius: 10px; flex: none; }
  .sub { position: absolute; z-index: 1; left: 6%; right: 6%; bottom: 10%; font-style: normal; font-size: 0.48rem; line-height: 1.2; text-align: center; color: #fff; text-shadow: 0 1px 2px #000; }
  .file b { display: block; font-family: var(--font-mono); font-size: 0.92rem; font-weight: 500; color: var(--r-ink); }
  .file small { display: block; margin-top: 0.25rem; font-size: 0.85rem; color: var(--r-ink-3); }
  .arrow { padding-left: 1.5rem; font-family: var(--font-mono); font-size: 0.8rem; color: var(--r-amber-text); }

  .term { padding: 1.1rem 1.25rem; border-radius: 14px; background: var(--r-code-bg); box-shadow: inset 0 0 0 1px var(--hairline); font-family: var(--font-mono); font-size: 0.82rem; line-height: 1.7; color: var(--r-ink); overflow-x: auto; }
  .term p { color: var(--r-ink); white-space: nowrap; }
  .term .dim { color: var(--r-ink-4); }
  .term .amb { color: var(--r-amber-text); }
  .term--you { margin-top: 0.9rem; box-shadow: inset 0 0 0 1px rgba(245, 197, 107, 0.3); }

  .profiles { display: grid; gap: 0.6rem; }
  .prof { display: flex; align-items: center; gap: 0.9rem; padding: 0.8rem 1rem; border-radius: 16px; background: var(--r-fill); }
  .prof:first-child { background: var(--r-fill-3); }
  .pav { display: grid; place-items: center; width: 2.6rem; height: 2.6rem; border-radius: 50%; font-size: 0.85rem; font-weight: 700; color: #111; }
  .prof b { display: block; font-size: 1rem; }
  .prof small { font-size: 0.85rem; color: var(--r-ink-3); }

  @media (max-width: 959px) {
    .acc-stage { min-height: 24rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .acc-vis, .acc-plus, .acc-plus::after { transition: none; }
    .acc-panel:not([hidden]) { animation: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-accordion]').forEach((root) => {
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-accordion-header]'));
    const visuals = Array.from(root.querySelectorAll<HTMLElement>('[data-acc-vis]'));
    const open = (btn: HTMLButtonElement) => {
      for (const b of buttons) {
        const on = b === btn;
        b.setAttribute('aria-expanded', String(on));
        const panel = document.getElementById(b.getAttribute('aria-controls') || '');
        if (panel) panel.hidden = !on;
      }
      const id = btn.closest<HTMLElement>('[data-acc-item]')?.dataset.accItem;
      visuals.forEach((v) => v.classList.toggle('is-on', v.dataset.accVis === id));
    };
    buttons.forEach((b) => b.addEventListener('click', () => open(b)));
  });
</script>
