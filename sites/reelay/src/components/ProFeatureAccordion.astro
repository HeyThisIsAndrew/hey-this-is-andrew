---
/**
 * ProFeatureAccordion: the homepage's five chapters, stacked vertically.
 *
 * Full-width rows (01 to 05) that open downward, one at a time, built on
 * @andrew/ui's Accordion and AccordionRow: the pattern of the personal
 * site's /build and BE Unconventional HQ's /featured. Only the look is
 * Reelay's (the overrides at the bottom of this file).
 *
 * The shared Accordion also owns deep links: a link to anything inside a
 * row (the nav's #works-with, #data-topology, #tech-specs, #download) opens
 * that row on load, on hashchange, and on a same-page click (capture phase,
 * before the browser scrolls). Collapsed rows are inert, and without
 * JavaScript every row reads open.
 *
 * #studio-preview belongs to the Hero; nothing here repeats it.
 * Every claim below follows the Reelay app repository (README, paths.py,
 * tokens.py, assist.py, packaging/).
 */
import Accordion from '@andrew/ui/Accordion.astro';
import AccordionRow from '@andrew/ui/AccordionRow.astro';
import CapabilityMatrix from './CapabilityMatrix.astro';
import { SITE, DOWNLOADS, href } from '../data/site';
import { RELEASE } from '../data/release';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const topologyNodes = [
  {
    id: 'on-device',
    short: 'On your computer',
    title: 'Your archive lives where you put it.',
    body: 'Videos download into your library folder. Tickets, copy and transcripts live in one local database.',
    rows: [
      ['Videos', 'Your library folder'],
      ['Database', 'reelay.db, on your computer'],
      ['Edited copies', 'Beside the original'],
      ['Copies on Reelay’s servers', 'None'],
    ],
  },
  {
    id: 'keychain',
    short: 'In your keychain',
    title: 'Sign-ins never touch a file.',
    body: 'Platform sign-ins, the Bluesky App Password and the Agent API key are kept in the system keychain, under “Reelay”.',
    rows: [
      ['YouTube and Meta sign-ins', 'Keychain'],
      ['Bluesky App Password', 'Keychain'],
      ['Agent API key', 'Keychain'],
      ['In the database or logs', 'Never'],
    ],
  },
  {
    id: 'platforms',
    short: 'Straight to platforms',
    title: 'From your computer to theirs.',
    body: 'Uploads go from your computer directly to each platform. Disconnecting an account revokes it with the platform too.',
    rows: [
      ['Video uploads', 'Your computer → the platform'],
      ['Google sign-in', 'Loopback on 127.0.0.1'],
      ['Sign-in helper', 'Swaps a code, keeps no videos'],
      ['Ad or analytics SDKs', 'None'],
    ],
  },
  {
    id: 'boundaries',
    short: 'Clear limits',
    title: 'You hold the publish button.',
    body: 'The Agent API answers on your own computer only, and anything an agent wants to publish waits for your approval.',
    rows: [
      ['Agent API', '127.0.0.1 by default'],
      ['Publishing by an agent', 'Needs your approval'],
      ['Downloads', 'Known platform hosts only'],
      ['Every release', 'SHA-256 checksum'],
    ],
  },
];

const apple = 'M16.4 12.6c0-2.4 2-3.6 2.1-3.6-1.1-1.7-2.9-1.9-3.5-1.9-1.5-.2-2.9.9-3.7.9-.8 0-1.9-.9-3.2-.8-1.6 0-3.1 1-4 2.4-1.7 3-.4 7.4 1.2 9.8.8 1.2 1.8 2.5 3 2.4 1.2 0 1.7-.8 3.1-.8s1.9.8 3.2.8c1.3 0 2.2-1.2 3-2.4.9-1.4 1.3-2.7 1.3-2.8 0 0-2.5-1-2.5-4zM14 5.4c.7-.8 1.1-1.9 1-3-.9 0-2.1.6-2.8 1.4-.6.7-1.2 1.8-1 2.9 1.1.1 2.1-.6 2.8-1.3z';
const windows = 'M0 3.449L9.75 2.1v9.451H0m10.949-9.602L24 0v11.4H10.949M0 12.6h9.75v9.451L0 20.699M10.949 12.6H24V24l-12.949-1.801';

const panels = [
  {
    id: 'workflow',
    num: '01',
    kicker: 'Four columns',
    title: 'Your board',
    headline: 'Every video, on one board.',
    body: 'Each video is a ticket in one of four columns, Inbox to Posted, each with a title and subtitle you can change. A card shows where it’s going and a status line that names what still needs work, and it moves itself as its platforms go live.',
    tags: ['Inbox, In Prep, Scheduled, Posted', 'A status line on every card', 'Cards move themselves'],
    link: { label: 'Board and Tickets', href: href('/features/pipeline') },
  },
  {
    id: 'platforms',
    num: '02',
    kicker: 'Seven platforms',
    title: 'Platforms and rules',
    headline: 'Exactly what it does on each platform.',
    body: 'YouTube uploads and schedules. Bluesky, Threads and Facebook post automatically once you turn them on. TikTok, Instagram and Snapchat you post yourself, with the caption and file ready. When-if-then rules fill in the repetitive parts.',
    tags: ['Automatic: YouTube, Bluesky, Threads, Facebook', 'You post: TikTok, Instagram, Snapchat', 'When · if · then rules'],
    link: { label: 'Automations', href: href('/features/automations') },
  },
  {
    id: 'tools',
    num: '03',
    kicker: 'Edit and write',
    title: 'Creator tools',
    headline: 'Small edits. Local writing help.',
    body: 'Remove a video’s sound or replace it with a track you have rights to, and burn in captions from a .srt or .vtt file, with ffmpeg on your computer. The original never changes. Rewrites run on a local model through Ollama or llama.cpp: no tokens, no subscription.',
    tags: ['ffmpeg on your computer', 'Originals untouched', 'Ollama or llama.cpp'],
    link: { label: 'Library and Player', href: href('/features/library') },
  },
  {
    id: 'privacy',
    num: '04',
    kicker: 'Local first',
    title: 'Privacy by design',
    headline: 'Your work stays on your computer.',
    body: 'Your videos, database and transcripts stay where you put them. Sign-ins live in the system keychain, never in a file, and uploads go straight from your computer to each platform.',
    tags: ['A local database', 'Sign-ins in your keychain', 'No ads or analytics SDKs'],
    link: { label: 'Security', href: href('/security') },
  },
  {
    id: 'download',
    num: '05',
    kicker: RELEASE.label,
    title: 'Download and specs',
    headline: 'Free during the beta.',
    body: 'A ready-to-run app for Macs with Apple silicon on macOS 12 or later. On Windows 10 or 11, build it yourself with the included PowerShell script; on Linux, run it from source with Python 3.11 or later.',
    tags: ['macOS 12+ · Apple silicon', 'Windows: build script', 'Linux: from source'],
    link: { label: 'Download and release notes', href: href('/download') },
  },
];
---

<section class="stage stage--lift pillars" id="four-pillars" aria-labelledby="acc-title" data-sec data-pn-label="Inside Reelay">
  <div class="wrap">
    <header class="chapter-head" data-reveal data-sec-head>
      <p class="eyebrow">Inside Reelay</p>
      <h2 id="acc-title" class="headline">Everything in one place.<br /><span class="text-silver">Open a chapter.</span></h2>
    </header>

    <div class="pillars-list r-acc r-acc--cards">
      <Accordion exclusive>
        {panels.map((p, i) => (
          <AccordionRow id={`pillar-${p.id}`} kicker={`${p.num} · ${p.kicker}`} title={p.title} level={3} size="md" open={i === 0}>
            <div class:list={['panel-inner', { 'panel-inner--stack': p.id === 'platforms' }]}>
              <div class="panel-narrative">
                <p class="panel-title">{p.headline}</p>
                <p class="panel-body-text">{p.body}</p>
                <ul class="panel-tags" aria-label="In short">
                  {p.tags.map((t) => <li class="tag-pill">{t}</li>)}
                </ul>
                <a class="link-more" href={p.link.href}>{p.link.label}</a>
              </div>

              <div class="panel-visual">
                {p.id === 'workflow' && (
                  <div class="ws ws-board">
                    <div class="shotframe" data-crop>
                      <picture>
                        <source media="(prefers-color-scheme: dark)" type="image/webp" srcset={`${base}screens/web/board-dark-960.webp 960w, ${base}screens/web/board-dark-1440.webp 1440w`} sizes="(min-width: 960px) 640px, 92vw" />
                        <img src={`${base}screens/web/board-light-960.webp`} srcset={`${base}screens/web/board-light-960.webp 960w, ${base}screens/web/board-light-1440.webp 1440w`} sizes="(min-width: 960px) 640px, 92vw" width="1440" height="900" loading="lazy" decoding="async" alt="Reelay’s Board: four columns, Backlog, Staging, Scheduled and Published, of video tickets, each with its platform marks and a status line." />
                      </picture>
                    </div>
                    <p class="ws-note">The real app, in your system’s light or dark appearance.</p>
                  </div>
                )}

                {p.id === 'platforms' && (
                  <div class="ws ws-platforms" id="works-with">
                    <CapabilityMatrix />
                    <p class="rule-preview"><span class="rule-tag">A rule</span> When a video is added, if its caption mentions “sunset”, then fill the TikTok caption from a template.</p>
                  </div>
                )}

                {p.id === 'tools' && (
                  <div class="ws ws-tools" id="creator-tools">
                    <div class="vis-card">
                      <p class="bar-title">Video tools</p>
                      <div class="files">
                        <div class="file">
                          <span class="fthumb" aria-hidden="true"></span>
                          <span><b>first-snow.mp4</b><small>The original, never changed</small></span>
                        </div>
                        <p class="arrow">Burn in captions from first-snow.srt</p>
                        <div class="file hot">
                          <span class="fthumb" aria-hidden="true"><i class="sub">first snow and I was not ready</i></span>
                          <span><b>first-snow.edited.mp4</b><small>The copy that gets posted</small></span>
                        </div>
                      </div>
                    </div>
                    <div class="vis-card">
                      <p class="bar-title">Assist</p>
                      <p class="assist-text">the last ten minutes of light on the big sur coast, <u>shot hand held</u> from the turnout</p>
                      <div class="assist-pop">
                        <span>Spelling: <b>handheld</b></span>
                        <span>Brand voice: <b>natural and direct</b></span>
                        <span class="assist-model">llama3.2:3b on this computer · no tokens</span>
                      </div>
                    </div>
                  </div>
                )}

                {p.id === 'privacy' && (
                  <div class="ws ws-topology" id="data-topology">
                    <div class="ws-tabs" role="tablist" aria-label="Where your data lives">
                      {topologyNodes.map((n, idx) => (
                        <button type="button" role="tab" class="topology-tab" id={`top-tab-${n.id}`} data-node-target={n.id}
                          aria-selected={idx === 0 ? 'true' : 'false'} aria-controls={`panel-${n.id}`} tabindex={idx === 0 ? 0 : -1}>
                          <span class="wf-num">{String(idx + 1).padStart(2, '0')}</span>
                          <span>{n.short}</span>
                        </button>
                      ))}
                    </div>
                    <div class="wf-panels">
                    {topologyNodes.map((n, idx) => (
                      <div class="wf-panel" role="tabpanel" id={`panel-${n.id}`} aria-labelledby={`top-tab-${n.id}`} hidden={idx !== 0} tabindex="0">
                        <div class="topology-detail-card">
                          <p class="top-detail-title">{n.title}</p>
                          <p class="top-detail-body">{n.body}</p>
                          <dl class="top-rows">
                            {n.rows.map(([item, loc]) => (
                              <div class="top-row"><dt>{item}</dt><dd>{loc}</dd></div>
                            ))}
                          </dl>
                        </div>
                      </div>
                    ))}
                    </div>
                  </div>
                )}

                {p.id === 'download' && (
                  <div class="ws ws-download download-section" id="download">
                    <div class="ws-dl-cards">
                      <div class="download-card download-card--featured">
                        <span class="dc-badge dc-badge--featured">{DOWNLOADS.macArm.badge}</span>
                        <span class="dc-glyph" aria-hidden="true"><svg viewBox="0 0 24 24"><path fill="currentColor" d={apple} /></svg></span>
                        <p class="dc-title">{DOWNLOADS.macArm.platform}</p>
                        <p class="dc-specs">{DOWNLOADS.macArm.requirements}</p>
                        <a class="btn btn-primary btn-sm dc-btn" href={DOWNLOADS.macArm.href}>Download for Mac</a>
                        <p class="dc-meta">{DOWNLOADS.macArm.filename} · {DOWNLOADS.macArm.size}</p>
                      </div>
                      <div class="download-card">
                        <span class="dc-badge">{DOWNLOADS.windows.badge}</span>
                        <span class="dc-glyph" aria-hidden="true"><svg viewBox="0 0 24 24"><path fill="currentColor" d={windows} /></svg></span>
                        <p class="dc-title">{DOWNLOADS.windows.platform}</p>
                        <p class="dc-specs">{DOWNLOADS.windows.requirements}</p>
                        <a class="btn btn-secondary btn-sm dc-btn" href={DOWNLOADS.windows.href}>Build steps</a>
                        <p class="dc-meta"><code>{DOWNLOADS.windows.pipelineScript}</code></p>
                      </div>
                      <div class="download-card">
                        <span class="dc-badge">{DOWNLOADS.linux.badge}</span>
                        <span class="dc-glyph" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 17 10 11 4 5"></polyline><line x1="12" y1="19" x2="20" y2="19"></line></svg></span>
                        <p class="dc-title">{DOWNLOADS.linux.platform}</p>
                        <p class="dc-specs">{DOWNLOADS.linux.requirements}</p>
                        <a class="btn btn-secondary btn-sm dc-btn" href={DOWNLOADS.linux.href}>Source steps</a>
                        <p class="dc-meta"><code>{DOWNLOADS.linux.pipelineScript}</code></p>
                      </div>
                    </div>
                    <details class="checksums checksums-drawer" id="tech-specs">
                      <summary class="checksums-summary"><span>SHA-256 checksum for the Mac release</span><span class="cs-ver">{SITE.version}</span></summary>
                      <div class="checksums-content"><pre>{RELEASE.sha256}</pre></div>
                    </details>
                  </div>
                )}
              </div>
            </div>
          </AccordionRow>
        ))}
      </Accordion>
    </div>
  </div>
</section>

<style>
  .pillars { padding-top: clamp(3rem, 6vw, 5rem); }
  .pillars-list { margin-top: clamp(1.5rem, 3vw, 2.5rem); }

  /* ── Inside an open row: the story beside the picture ─────────────── */
  .panel-inner {
    display: grid;
    gap: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--hairline);
  }
  @media (min-width: 960px) {
    .panel-inner { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: 2.5rem; align-items: start; }
    /* The capability table has six columns: beside the text it ran off a
       1024px screen, so this row puts it under the text, full width. */
    .panel-inner--stack { grid-template-columns: minmax(0, 1fr); gap: 1.75rem; }
    .panel-inner--stack .panel-narrative { max-width: 46rem; }
  }
  .panel-narrative { display: flex; flex-direction: column; gap: 0.9rem; }
  .panel-title { font-family: var(--font-display); font-size: clamp(1.35rem, 2.4vw, 1.9rem); font-weight: 700; line-height: 1.15; letter-spacing: -0.025em; color: var(--r-ink); }
  .panel-body-text { font-size: 1rem; line-height: 1.55; color: var(--r-ink-2); }
  /* Three tags, one per line: a wrapping row would leave one alone. */
  .panel-tags { display: flex; flex-direction: column; align-items: flex-start; gap: 0.4rem; list-style: none; }
  .tag-pill { font-size: 0.8rem; font-weight: 500; color: var(--r-ink-2); padding: 0.3rem 0.7rem; border-radius: 999px; background: var(--r-fill-2); }
  .panel-visual { min-width: 0; }

  .ws {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 1rem;
    border-radius: var(--radius-md);
    background: var(--r-bg-alt);
    box-shadow: inset 0 0 0 1px var(--hairline);
  }
  .ws-tabs { display: flex; gap: 0.3rem; padding: 0.25rem; border-radius: 999px; background: var(--r-fill-2); overflow-x: auto; scrollbar-width: none; }
  .topology-tab {
    flex: 1 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    min-height: 36px;
    padding: 0 0.85rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--r-ink-2);
    font: 500 0.85rem var(--font-body);
    white-space: nowrap;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .topology-tab[aria-selected='true'] { background: var(--r-ink); color: var(--r-on-ink); }
  .topology-tab[aria-selected='true'] .wf-num { color: inherit; opacity: 0.7; }
  /* A narrow box (a phone, or the picture column at 1024px): four tabs as
     an even 2 x 2 grid, all visible. As a sideways strip with no scrollbar,
     up to half of them sat out of sight. */
  .ws { container-type: inline-size; }
  @container (max-width: 560px) {
    .ws-tabs { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: 1fr; border-radius: 14px; overflow: visible; }
    .topology-tab { border-radius: 10px; white-space: normal; text-align: center; line-height: 1.2; padding: 0.4rem 0.5rem; min-height: 44px; }
  }
  .wf-num { font-size: 0.72rem; font-variant-numeric: tabular-nums; color: var(--r-amber-text); }
  .ws-note { font-size: 0.8rem; color: var(--r-ink-4); }

  .topology-detail-card, .vis-card, .download-card {
    padding: 1rem;
    border-radius: 12px;
    background: var(--r-surface);
    box-shadow: inset 0 0 0 1px var(--hairline);
  }

  .rule-preview { font-size: 0.88rem; line-height: 1.5; color: var(--r-ink-2); }
  .rule-tag { display: inline-block; margin-right: 0.4rem; padding: 0.1rem 0.5rem; border-radius: 999px; background: var(--r-amber-soft); color: var(--r-amber-text); font-size: 0.75rem; font-weight: 600; }

  .ws-tools { display: grid; gap: 0.75rem; }
  @media (min-width: 640px) { .ws-tools { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .bar-title { margin-bottom: 0.7rem; font-size: 0.8rem; font-weight: 600; color: var(--r-ink-3); }
  .files { display: grid; gap: 0.45rem; }
  .file { display: flex; align-items: center; gap: 0.7rem; padding: 0.5rem 0.65rem; border-radius: 10px; background: var(--r-fill); }
  .file.hot { background: var(--r-amber-soft); }
  .file b { display: block; font-size: 0.86rem; color: var(--r-ink); overflow-wrap: anywhere; }
  .file small { display: block; font-size: 0.78rem; color: var(--r-ink-3); }
  .fthumb { position: relative; flex: none; width: 2.2rem; height: 3rem; border-radius: 6px; overflow: hidden; background: linear-gradient(160deg, #3b4a63, #11151c); }
  .sub { position: absolute; left: 2px; right: 2px; bottom: 3px; padding: 1px 2px; border-radius: 2px; background: rgba(0, 0, 0, 0.75); color: #fff; font-size: 0.42rem; font-style: normal; line-height: 1.2; }
  .arrow { padding-left: 0.6rem; font-size: 0.78rem; color: var(--r-amber-text); }
  .assist-text { margin-bottom: 0.6rem; font-size: 0.9rem; line-height: 1.5; color: var(--r-ink-2); }
  .assist-pop { display: grid; gap: 0.3rem; padding: 0.6rem 0.75rem; border-radius: 10px; background: var(--r-fill); font-size: 0.82rem; color: var(--r-ink-2); }
  .assist-pop b { color: var(--r-ink); }
  .assist-model { font-size: 0.76rem; color: var(--r-ink-4); }

  .top-detail-title { font-weight: 600; color: var(--r-ink); }
  .top-detail-body { margin: 0.35rem 0 0.8rem; font-size: 0.9rem; line-height: 1.5; color: var(--r-ink-2); }
  .top-rows { display: grid; }
  .top-row { display: flex; justify-content: space-between; gap: 1rem; padding: 0.45rem 0; border-top: 1px solid var(--hairline); font-size: 0.86rem; }
  .top-row dt { color: var(--r-ink-3); }
  .top-row dd { color: var(--r-ink); text-align: right; }

  /* Three platforms: three across, or one column. Never two and one. */
  .ws-dl-cards { display: grid; grid-template-columns: minmax(0, 1fr); grid-auto-rows: 1fr; gap: 0.75rem; }
  @media (min-width: 640px) { .ws-dl-cards { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .download-card { display: flex; flex-direction: column; gap: 0.4rem; min-width: 0; }
  .download-card--featured { box-shadow: inset 0 0 0 1px var(--r-amber-line); }
  .dc-badge { font-size: 0.75rem; font-weight: 600; color: var(--r-ink-3); }
  .dc-badge--featured { color: var(--r-amber-text); }
  .dc-glyph { width: 1.5rem; height: 1.5rem; margin-top: 0.2rem; color: var(--r-ink); }
  .dc-glyph svg { width: 100%; height: 100%; }
  .dc-title { font-weight: 600; color: var(--r-ink); }
  .dc-specs { font-size: 0.82rem; color: var(--r-ink-3); }
  .dc-btn { margin-top: auto; width: 100%; }
  .dc-meta { font-size: 0.74rem; color: var(--r-ink-4); overflow-wrap: anywhere; }
  .dc-meta code { font-size: 0.95em; }
  .checksums { padding-top: 0.75rem; border-top: 1px solid var(--hairline); font-size: 0.85rem; }
  .checksums summary { display: flex; justify-content: space-between; gap: 0.75rem; cursor: pointer; color: var(--r-ink-2); }
  .cs-ver { color: var(--r-ink-3); }
  .checksums pre { margin-top: 0.5rem; padding: 0.6rem; border-radius: 8px; background: var(--r-fill); color: var(--r-ink-2); font-size: 0.78rem; white-space: pre-wrap; overflow-wrap: anywhere; }

  /* Depth inside an open row (two columns only): the picture drifts a
     little against the text as the row crosses the screen, over a glow
     that drifts the other way. Transform only, compositor-driven; the
     picture stays fully clickable. Phones get none of it: it would cost
     touch scrolling its momentum, and there's no text column to drift
     against. */
  .panel-visual { position: relative; isolation: isolate; }
  /* The screenshot is 16:10 in a 16:9 frame: full width, never cropped at
     the sides, with a little height to spare. At rest it shows the middle;
     with motion it pans that spare height as the row scrolls past. */
  .shotframe { aspect-ratio: 16 / 9; overflow: hidden; border-radius: 12px; background: var(--r-tile); box-shadow: var(--app-frame); }
  .shotframe img { display: block; width: 100%; height: auto; transform: translateY(-5%); }
  @media (min-width: 960px) and (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .panel-visual::before {
        content: '';
        position: absolute;
        z-index: -1;
        inset: 10% -6% -4% -6%;
        background: radial-gradient(50% 50% at 50% 50%, var(--r-amber-soft), transparent 70%);
        animation: pv-glow linear both;
        animation-range: cover 0% cover 100%;
        pointer-events: none;
      }
      .panel-visual > .ws {
        animation: pv-drift linear both;
        animation-range: cover 0% cover 100%;
      }
      @keyframes pv-drift { from { transform: translateY(24px); } to { transform: translateY(-24px); } }
      /* The screenshot pans its spare height inside the frame, too. */
      .shotframe img {
        animation: pv-shot linear both;
        animation-range: cover 0% cover 100%;
      }
      @keyframes pv-shot { from { transform: translateY(0); } to { transform: translateY(-10%); } }
      @keyframes pv-glow { from { transform: translateY(-30px); } to { transform: translateY(30px); } }
      /* In a rule of its own, or the minifier folds it into the animation
         shorthand, which browsers reject (see Hero.astro). */
      .pillars .panel-visual::before, .pillars .panel-visual > .ws, .pillars .shotframe img { animation-timeline: view(); }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .topology-tab { transition: none; }
  }
  /* Every panel shares one grid cell and the inactive ones are only invisible
     (visibility also takes them out of the tab order and the accessibility
     tree), so the box is always as tall as the tallest panel: switching never
     moves the page below. */
  .wf-panels { display: grid; }
  .wf-panels > .wf-panel { grid-area: 1 / 1; min-width: 0; }
  .wf-panels > .wf-panel[hidden] { display: block; visibility: hidden; }
</style>

<script>
  /* The two tab sets inside the rows (board columns, data boundaries).
     Opening and closing rows, and deep links, are @andrew/ui Accordion's. */
  function initTabs(root: ParentNode, tabSel: string, panelSel: string) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>(tabSel));
    const panels = Array.from(root.querySelectorAll<HTMLElement>(panelSel));
    const select = (i: number, focus = false) => {
      tabs.forEach((t, idx) => {
        t.setAttribute('aria-selected', String(idx === i));
        t.tabIndex = idx === i ? 0 : -1;
      });
      panels.forEach((p, idx) => { p.hidden = idx !== i; });
      if (focus) tabs[i]?.focus();
    };
    tabs.forEach((tab, i) => {
      if (tab.dataset.bound) return;
      tab.dataset.bound = '1';
      tab.addEventListener('click', () => select(i));
      tab.addEventListener('keydown', (e) => {
        const last = tabs.length - 1;
        const next = e.key === 'ArrowRight' || e.key === 'ArrowDown' ? (i === last ? 0 : i + 1)
          : e.key === 'ArrowLeft' || e.key === 'ArrowUp' ? (i === 0 ? last : i - 1)
          : e.key === 'Home' ? 0 : e.key === 'End' ? last : -1;
        if (next < 0) return;
        e.preventDefault();
        select(next, true);
      });
    });
  }
  function initPillars() {
    document.querySelectorAll<HTMLElement>('.pillars').forEach((root) => {
      initTabs(root, '.topology-tab', '.ws-topology .wf-panel');
    });
  }
  initPillars();
  document.addEventListener('astro:page-load', initPillars);
</script>
