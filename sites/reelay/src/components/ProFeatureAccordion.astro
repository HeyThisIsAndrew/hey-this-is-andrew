---
/**
 * ProFeatureAccordion: Horizontal Expandable Capability Track.
 * Inspired by the BE Unconventional HQ horizontal deck/accordion interaction pattern:
 * - A horizontal track of expandable capability panels on desktop.
 * - Active panel commands generous visual space for narrative & live workstation interfaces.
 * - Inactive panels remain as recognizable, legible narrow vertical strips with hover states.
 * - Responsive vertical accordion on mobile to prevent overflow, clipping, or awkward squishing.
 * - Full keyboard navigation, ARIA semantics, and reduced-motion support.
 *
 * Test hooks: Exactly 5 [data-accordion-header] buttons with aria-expanded & aria-selected.
 */
import { href, AGENT_API } from '../data/site';

const drawers = [
  {
    id: 'automations',
    num: '01',
    shortTitle: 'Automations',
    title: 'Automations',
    kicker: 'When · If · Then Rules',
    body: 'When a video is added or moved, if its caption, hashtag, length or source matches, then fill an empty field from a template, add hashtags, pick platforms or schedule it for a day and time. A rule acts on each video once, templates never overwrite what you typed, and everything it does is logged.',
    link: { label: 'Explore Automations', href: href('/features/automations') },
    tags: ['Rules engine', 'Zero overwrite', 'Action log'],
  },
  {
    id: 'writing',
    num: '02',
    shortTitle: 'Writing assist',
    title: 'Writing help, on your computer',
    kicker: 'Local LLM · No Cloud',
    body: 'An Assist menu on every caption: spelling and grammar, rewrites through a model running on your own machine (Ollama or llama.cpp), and brand-voice profiles. Suggestions are only ever suggestions. No paid AI, no tokens.',
    link: { label: 'How it stays local', href: `${href('/ai')}#writing-help` },
    tags: ['Ollama / llama.cpp', 'Brand voice', 'Zero tokens'],
  },
  {
    id: 'video-tools',
    num: '03',
    shortTitle: 'Video tools',
    title: 'Video tools',
    kicker: 'ffmpeg · Non-destructive',
    body: 'Remove the sound, replace it with a track you have rights to, or burn in captions from a .srt, .vtt or .ass file, all with ffmpeg on this computer. The original is never changed; the edited copy is what gets posted until you choose Use Original.',
    link: { label: 'Library and player', href: href('/features/library') },
    tags: ['Strip / swap audio', 'Burn captions', 'Original intact'],
  },
  {
    id: 'agents',
    num: '04',
    shortTitle: 'Agent API',
    title: 'An API for your agents',
    kicker: 'Local HTTP · OpenAPI 3.1',
    body: 'A local HTTP API with an OpenAPI 3.1 description, so an agent can read the board and draft copy. Anything that posts, archives or changes many tickets waits for a person to approve it on the Mac. Agents can ask; they can’t approve.',
    link: { label: 'Explore the Agent API', href: href('/ai') },
    tags: ['localhost:8471', 'OpenAPI 3.1', 'Approval gate'],
  },
  {
    id: 'profiles',
    num: '05',
    shortTitle: 'Profiles & Vault',
    title: 'Profiles and a shared database',
    kicker: 'Multi-creator · SQLite',
    body: 'One profile per creator, each with its own library folder, board and channels. Move the database into Google Drive, Dropbox, iCloud Drive or OneDrive and a teammate can open it too: one editor at a time, everyone else view-only.',
    link: { label: 'Board and tickets', href: href('/features/pipeline') },
    tags: ['Folder isolation', 'Cloud sync ready', 'Single-writer lock'],
  },
];
---
<section class="stage stage--lift acc" id="four-pillars" aria-labelledby="acc-title">
  <div class="wrap">
    <header class="chapter-head" data-reveal>
      <p class="eyebrow">Deep capabilities</p>
      <h2 id="acc-title" class="headline">Built in.<br /><span class="text-silver">Not bolted on.</span></h2>
      <p class="lede">Every capability runs directly on your Apple silicon Mac. No subscriptions, no cloud middleware, no remote data leakage.</p>
    </header>

    <div class="horizontal-accordion-wrap" data-reveal>
      <div class="horizontal-accordion" data-accordion role="region" aria-label="Reelay deep capabilities track">
        {drawers.map((d, i) => (
          <div
            class:list={['acc-panel', { 'is-expanded': i === 0, 'is-collapsed': i !== 0 }]}
            data-panel-id={d.id}
            id={`acc-panel-wrap-${d.id}`}
          >
            <!-- Panel Header Strip / Trigger -->
            <button
              type="button"
              class="panel-strip"
              data-accordion-header
              data-target={d.id}
              id={`acc-${d.id}`}
              role="button"
              aria-expanded={i === 0 ? 'true' : 'false'}
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-controls={`panel-body-${d.id}`}
              aria-label={`${d.title} capability drawer`}
              tabindex={i === 0 ? 0 : -1}
            >
              <div class="strip-header-content">
                <span class="strip-num">{d.num}</span>
                <span class="strip-label">{d.shortTitle}</span>
              </div>
              <div class="strip-marker" aria-hidden="true">
                <span class="strip-indicator"></span>
                <svg class="strip-chevron" width="12" height="12" viewBox="0 0 12 12" fill="none">
                  <path d="M2.5 4.5L6 8L9.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </div>
            </button>

            <!-- Expanded Panel Body -->
            <div
              class="panel-body"
              id={`panel-body-${d.id}`}
              role="region"
              aria-labelledby={`acc-${d.id}`}
              hidden={i !== 0}
            >
              <div class="panel-inner">
                <!-- Narrative column -->
                <div class="panel-narrative">
                  <div class="narrative-meta">
                    <span class="panel-num-pill">{d.num}</span>
                    <span class="panel-kicker">{d.kicker}</span>
                  </div>
                  <h3 class="panel-title">{d.title}</h3>
                  <p class="panel-body-text">{d.body}</p>

                  <div class="panel-tags" aria-label="Key guarantees">
                    {d.tags.map((t) => <span class="tag-pill">{t}</span>)}
                  </div>

                  <div class="panel-action">
                    <a class="link-more" href={d.link.href}>{d.link.label}</a>
                  </div>
                </div>

                <!-- Visual workstation column -->
                <div class="panel-visual" aria-hidden="true">
                  {d.id === 'automations' && (
                    <div class="vis-card vis-card--rule">
                      <div class="card-bar">
                        <span class="bar-dot"></span>
                        <span class="bar-title">Rule Definition</span>
                      </div>
                      <div class="rule">
                        <p><span class="k">When</span> a video is added to the board</p>
                        <p><span class="k">If</span> the caption contains <em>“recipe”</em></p>
                        <p><span class="k">Then</span> fill the TikTok caption from <em>{'{hook}'} {'{hashtags}'}</em></p>
                        <p><span class="k">And</span> schedule it for next Tuesday at 9:00</p>
                      </div>
                      <p class="vis-note">Scheduling still goes through the Ready gate.</p>
                    </div>
                  )}

                  {d.id === 'writing' && (
                    <div class="vis-card vis-card--assist">
                      <div class="card-bar">
                        <span class="bar-dot"></span>
                        <span class="bar-title">Local LLM Assist</span>
                      </div>
                      <div class="assist">
                        <p class="assist-text">the last ten minutes of light on the big sur coast, <u>shot hand held</u> from the turnout</p>
                        <div class="assist-pop">
                          <span class="assist-h">Assist Menu</span>
                          <span>Spelling: <b>handheld</b></span>
                          <span>Rewrite in my brand voice</span>
                          <span>Get SEO Suggestions</span>
                          <span class="assist-model">Model: llama3.2:3b on this Mac · 0 tokens</span>
                        </div>
                      </div>
                    </div>
                  )}

                  {d.id === 'video-tools' && (
                    <div class="vis-card vis-card--tools">
                      <div class="card-bar">
                        <span class="bar-dot"></span>
                        <span class="bar-title">ffmpeg Pipeline</span>
                      </div>
                      <div class="files">
                        <div class="file">
                          <span class="still still--snow fthumb"></span>
                          <span><b>first-snow.mp4</b><small>Original · Never modified</small></span>
                        </div>
                        <div class="arrow">ffmpeg · burn in captions.srt</div>
                        <div class="file hot">
                          <span class="still still--snow fthumb"><i class="sub">first snow and I was not ready</i></span>
                          <span><b>first-snow.edited.mp4</b><small>Rendered copy · Ready to post</small></span>
                        </div>
                      </div>
                    </div>
                  )}

                  {d.id === 'agents' && (
                    <div class="vis-card vis-card--agents">
                      <div class="card-bar">
                        <span class="bar-dot"></span>
                        <span class="bar-title">Agent REST API · OpenAPI 3.1</span>
                      </div>
                      <div class="term">
                        <p><span class="dim">$</span> curl -X POST {AGENT_API.url}/v1/videos/42/schedule</p>
                        <p class="dim">HTTP/1.1 202 Accepted</p>
                        <p>{'{'} "status": <span class="amb">"pending"</span>, "approval_id": 17, "operation": "schedule" {'}'}</p>
                      </div>
                      <div class="term term--you">
                        <p class="dim"># On the Mac, human approval required</p>
                        <p><span class="dim">$</span> python -m reelay.approvals show 17</p>
                        <p class="dim">schedule · Desert road trip, day four · YouTube</p>
                        <p><span class="dim">$</span> python -m reelay.approvals <span class="amb">approve</span> 17</p>
                      </div>
                    </div>
                  )}

                  {d.id === 'profiles' && (
                    <div class="vis-card vis-card--profiles">
                      <div class="card-bar">
                        <span class="bar-dot"></span>
                        <span class="bar-title">Multi-Creator Vault</span>
                      </div>
                      <div class="profiles">
                        {[
                          ['JL', 'Juniper Lane', '#f5c56b,#d9653b', 'Active Editing Session'],
                          ['MR', 'Mesa Roasters', '#5eb1ff,#2f5fd0', 'View Only · Locked'],
                          ['HK', 'Harbor Kitchen', '#5fe08a,#1f8a4c', 'View Only · Locked'],
                        ].map(([ini, name, g, state]) => (
                          <div class="prof">
                            <span class="pav" style={`background:linear-gradient(135deg,${g})`}>{ini}</span>
                            <span><b>{name}</b><small>{state}</small></span>
                          </div>
                        ))}
                        <p class="vis-note">reelay.db single-writer SQLite lock in shared sync folder</p>
                      </div>
                    </div>
                  )}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .acc {
    position: relative;
  }

  .horizontal-accordion-wrap {
    margin-top: clamp(2rem, 4vw, 3.5rem);
    width: 100%;
  }

  /* -------------------------------------------------------------
     DESKTOP LAYOUT (Horizontal Track of Expandable Panels)
     ------------------------------------------------------------- */
  @media (min-width: 860px) {
    .horizontal-accordion {
      display: flex;
      flex-direction: row;
      align-items: stretch;
      width: 100%;
      height: 580px;
      min-height: 540px;
      border-radius: var(--radius-xl);
      background: var(--r-panel);
      border: 1px solid var(--hairline-strong);
      box-shadow: 0 30px 80px -20px rgba(0, 0, 0, 0.7);
      overflow: hidden;
      position: relative;
    }

    .acc-panel {
      display: flex;
      flex-direction: row;
      align-items: stretch;
      position: relative;
      overflow: hidden;
      min-width: 0;
      border-right: 1px solid var(--hairline);
      transition: flex 0.6s cubic-bezier(0.25, 1, 0.5, 1), background-color 0.4s ease;
    }

    .acc-panel:last-child {
      border-right: none;
    }

    /* Collapsed Panel Strip */
    .acc-panel.is-collapsed {
      flex: 0 0 72px;
      background: rgba(16, 16, 18, 0.88);
      cursor: pointer;
    }

    .acc-panel.is-collapsed:hover {
      background: rgba(26, 26, 32, 0.96);
    }

    .acc-panel.is-collapsed .panel-strip {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: space-between;
      width: 72px;
      height: 100%;
      padding: 2.25rem 0.5rem;
      background: transparent;
      border: none;
      cursor: pointer;
      color: var(--r-ink-3);
    }

    .acc-panel.is-collapsed .strip-header-content {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1.75rem;
    }

    .acc-panel.is-collapsed .strip-num {
      font-family: var(--font-mono);
      font-size: 0.85rem;
      font-weight: 700;
      color: var(--r-amber);
      letter-spacing: 0.05em;
    }

    .acc-panel.is-collapsed .strip-label {
      writing-mode: vertical-rl;
      transform: rotate(180deg);
      font-family: var(--font-body);
      font-size: 0.95rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.22em;
      color: var(--r-ink-3);
      white-space: nowrap;
      transition: color 0.3s ease, letter-spacing 0.3s ease;
    }

    .acc-panel.is-collapsed:hover .strip-label {
      color: var(--r-ink);
      letter-spacing: 0.26em;
    }

    .acc-panel.is-collapsed .strip-indicator {
      display: block;
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--r-ink-4);
      transition: all 0.3s ease;
    }

    .acc-panel.is-collapsed:hover .strip-indicator {
      background: var(--r-amber);
      transform: scale(1.5);
      box-shadow: 0 0 10px var(--r-amber);
    }

    .acc-panel.is-collapsed .strip-chevron {
      display: none;
    }

    .acc-panel.is-collapsed .panel-body {
      display: none;
      width: 0;
      opacity: 0;
      pointer-events: none;
    }

    /* Expanded Panel State */
    .acc-panel.is-expanded {
      flex: 1 1 0%;
      min-width: 0;
      background: var(--r-panel);
    }

    .acc-panel.is-expanded .panel-strip {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: space-between;
      width: 56px;
      height: 100%;
      padding: 2.25rem 0.4rem;
      background: rgba(0, 0, 0, 0.25);
      border: none;
      border-right: 1px solid var(--hairline);
      cursor: default;
      flex-shrink: 0;
    }

    .acc-panel.is-expanded .strip-header-content {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1.75rem;
    }

    .acc-panel.is-expanded .strip-num {
      font-family: var(--font-mono);
      font-size: 0.85rem;
      font-weight: 700;
      color: var(--r-amber);
    }

    .acc-panel.is-expanded .strip-label {
      writing-mode: vertical-rl;
      transform: rotate(180deg);
      font-family: var(--font-body);
      font-size: 0.9rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.22em;
      color: var(--r-ink);
      white-space: nowrap;
    }

    .acc-panel.is-expanded .strip-indicator {
      display: block;
      width: 6px;
      height: 20px;
      border-radius: 3px;
      background: var(--r-amber);
      box-shadow: 0 0 12px var(--r-amber);
    }

    .acc-panel.is-expanded .strip-chevron {
      display: none;
    }

    .acc-panel.is-expanded .panel-body {
      flex: 1 1 auto;
      min-width: 0;
      height: 100%;
      display: flex;
      align-items: stretch;
      overflow-y: auto;
      background: var(--r-panel);
    }

    .panel-inner {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
      gap: clamp(1.5rem, 3vw, 2.75rem);
      padding: clamp(2rem, 3.5vw, 3.25rem);
      width: 100%;
      align-items: center;
      box-sizing: border-box;
    }

    .panel-narrative,
    .panel-visual {
      animation: panel-reveal 0.5s var(--r-ease) both;
    }

    @keyframes panel-reveal {
      from {
        opacity: 0;
        transform: translateY(10px);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
  }

  /* -------------------------------------------------------------
     MOBILE LAYOUT (Accessible Vertical Stacking)
     ------------------------------------------------------------- */
  @media (max-width: 859px) {
    .horizontal-accordion {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      width: 100%;
    }

    .acc-panel {
      display: flex;
      flex-direction: column;
      border-radius: var(--radius-lg);
      background: var(--r-panel);
      border: 1px solid var(--hairline-strong);
      overflow: hidden;
      width: 100%;
      transition: border-color 0.3s ease;
    }

    .acc-panel.is-expanded {
      border-color: rgba(245, 197, 107, 0.4);
      box-shadow: 0 8px 30px -10px rgba(0, 0, 0, 0.5);
    }

    .panel-strip {
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      padding: 1.15rem 1.35rem;
      background: var(--r-fill);
      border: none;
      cursor: pointer;
      text-align: left;
      color: var(--r-ink);
      font-family: var(--font-body);
      transition: background-color 0.25s ease;
    }

    .acc-panel.is-collapsed .panel-strip:hover {
      background: var(--r-fill-2);
    }

    .acc-panel.is-expanded .panel-strip {
      background: rgba(245, 197, 107, 0.08);
      border-bottom: 1px solid var(--hairline);
    }

    .strip-header-content {
      display: flex;
      align-items: center;
      gap: 0.85rem;
    }

    .strip-num {
      font-family: var(--font-mono);
      font-size: 0.85rem;
      font-weight: 700;
      color: var(--r-amber);
    }

    .strip-label {
      font-size: 1.05rem;
      font-weight: 650;
      letter-spacing: -0.01em;
      color: var(--r-ink);
    }

    .strip-marker {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 1.75rem;
      height: 1.75rem;
      border-radius: 50%;
      background: var(--r-fill-2);
      color: var(--r-ink-3);
      transition: transform 0.3s var(--r-ease), color 0.3s ease, background-color 0.3s ease;
    }

    .strip-indicator {
      display: none;
    }

    .strip-chevron {
      display: block;
      transition: transform 0.3s var(--r-ease);
    }

    .acc-panel.is-expanded .strip-chevron {
      transform: rotate(180deg);
      color: var(--r-amber);
    }

    .acc-panel.is-expanded .strip-marker {
      background: rgba(245, 197, 107, 0.15);
      color: var(--r-amber);
    }

    .acc-panel.is-collapsed .panel-body {
      display: none;
    }

    .acc-panel.is-expanded .panel-body {
      display: block;
      padding: 1.5rem 1.25rem 1.85rem;
      background: var(--r-panel);
    }

    .panel-inner {
      display: flex;
      flex-direction: column;
      gap: 1.75rem;
    }
  }

  /* -------------------------------------------------------------
     SHARED NARRATIVE & VISUAL WORKSTATION STYLES
     ------------------------------------------------------------- */
  .panel-strip:focus-visible {
    outline: 2px solid var(--r-amber);
    outline-offset: -2px;
  }

  .narrative-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .panel-num-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
    background: rgba(245, 197, 107, 0.15);
    border: 1px solid rgba(245, 197, 107, 0.35);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 700;
    color: var(--r-amber);
  }

  .panel-kicker {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 700;
    color: var(--r-amber-text);
  }

  .panel-title {
    margin: 0 0 1rem;
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.4vw, 2.1rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.2;
    color: var(--r-ink);
  }

  .panel-body-text {
    font-size: 1.02rem;
    line-height: 1.62;
    color: var(--r-ink-2);
    margin: 0 0 1.5rem;
  }

  .panel-tags {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.75rem;
  }

  .tag-pill {
    font-size: 0.78rem;
    font-weight: 500;
    padding: 0.28rem 0.7rem;
    border-radius: 999px;
    background: var(--r-fill-2);
    border: 1px solid var(--hairline);
    color: var(--r-ink-2);
  }

  .panel-action {
    margin-top: 0.25rem;
  }

  .link-more {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--r-amber);
    text-decoration: none;
    transition: gap 0.2s ease, color 0.2s ease;
  }

  .link-more:hover {
    color: var(--r-ink);
  }

  /* Visual Workstation Cards */
  .panel-visual {
    width: 100%;
  }

  .vis-card {
    border-radius: 16px;
    background: rgba(0, 0, 0, 0.35);
    border: 1px solid var(--hairline-strong);
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
  }

  .card-bar {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1.15rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--hairline);
  }

  .bar-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--r-amber);
    box-shadow: 0 0 8px var(--r-amber);
  }

  .bar-title {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 600;
    color: var(--r-ink-3);
  }

  .vis-note {
    margin-top: 1.15rem;
    font-size: 0.85rem;
    color: var(--r-ink-4);
  }

  /* Rule Definition Visual */
  .rule {
    display: grid;
    gap: 0.65rem;
  }

  .rule p {
    font-size: clamp(0.92rem, 1.4vw, 1.05rem);
    color: var(--r-ink);
    padding: 0.8rem 1rem;
    border-radius: 12px;
    background: var(--r-fill-2);
    border: 1px solid var(--hairline);
    margin: 0;
  }

  .rule .k {
    display: inline-block;
    min-width: 3.4rem;
    font-weight: 700;
    color: var(--r-amber-text);
  }

  @media (max-width: 560px) {
    .rule .k {
      display: block;
      min-width: 0;
      margin-bottom: 0.15rem;
    }
  }

  .rule em {
    font-style: normal;
    font-family: var(--font-mono);
    font-size: 0.9em;
    color: var(--r-amber-text);
  }

  /* Assist Visual */
