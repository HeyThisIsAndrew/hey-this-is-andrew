<script>
  function initMasterShowcase() {
    document.querySelectorAll<HTMLElement>('[data-accordion]').forEach((root) => {
      const panels = Array.from(root.querySelectorAll<HTMLElement>('.acc-panel'));
      const triggers = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-accordion-header]'));

      const activate = (idx: number, focus = false) => {
        panels.forEach((panel, i) => {
          const isTarget = i === idx;
          panel.classList.toggle('is-expanded', isTarget);
          panel.classList.toggle('is-collapsed', !isTarget);

          const trigger = triggers[i];
          if (trigger) {
            trigger.setAttribute('aria-expanded', String(isTarget));
            trigger.setAttribute('aria-selected', String(isTarget));
            trigger.setAttribute('tabindex', isTarget ? '0' : '-1');
            if (isTarget && focus) trigger.focus();
          }
        });
      };

      triggers.forEach((trigger, i) => {
        trigger.addEventListener('click', (e) => {
          e.stopPropagation();
          activate(i);
        });

        trigger.addEventListener('keydown', (e) => {
          let next = i;
          if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
            next = (i + 1) % triggers.length;
            e.preventDefault();
            activate(next, true);
          } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
            next = (i - 1 + triggers.length) % triggers.length;
            e.preventDefault();
            activate(next, true);
          } else if (e.key === 'Home') {
            e.preventDefault();
            activate(0, true);
          } else if (e.key === 'End') {
            e.preventDefault();
            activate(triggers.length - 1, true);
          }
        });
      });

      // Expand on strip click anywhere
      panels.forEach((panel, i) => {
        panel.addEventListener('click', (e) => {
          const target = e.target as HTMLElement;
          if (panel.classList.contains('is-collapsed') || target.closest('.panel-strip')) {
            activate(i);
          }
        });
      });

      // Panel 01 Workflow Step Tabs
      const wfTabs = Array.from(root.querySelectorAll<HTMLButtonElement>('.workflow-step-tab'));
      const wfPanels = Array.from(root.querySelectorAll<HTMLElement>('.ws-workflow .wf-panel'));

      wfTabs.forEach((tab, i) => {
        tab.addEventListener('click', () => {
          wfTabs.forEach((t, idx) => {
            const active = idx === i;
            t.setAttribute('aria-selected', String(active));
            t.setAttribute('tabindex', active ? '0' : '-1');
          });
          wfPanels.forEach((p, idx) => {
            p.hidden = idx !== i;
          });
        });

        tab.addEventListener('keydown', (e) => {
          let next = i;
          if (e.key === 'ArrowRight' || e.key === 'ArrowDown') next = (i + 1) % wfTabs.length;
          else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') next = (i - 1 + wfTabs.length) % wfTabs.length;
          else if (e.key === 'Home') next = 0;
          else if (e.key === 'End') next = wfTabs.length - 1;
          else return;
          e.preventDefault();
          wfTabs[next]?.click();
          wfTabs[next]?.focus();
        });
      });

      // Panel 04 Topology Tabs
      const topTabs = Array.from(root.querySelectorAll<HTMLButtonElement>('.topology-tab'));
      const topPanels = Array.from(root.querySelectorAll<HTMLElement>('.ws-topology .wf-panel'));

      topTabs.forEach((tab, i) => {
        tab.addEventListener('click', () => {
          topTabs.forEach((t, idx) => {
            const active = idx === i;
            t.setAttribute('aria-selected', String(active));
            t.setAttribute('tabindex', active ? '0' : '-1');
          });
          topPanels.forEach((p, idx) => {
            p.hidden = idx !== i;
          });
        });

        tab.addEventListener('keydown', (e) => {
          let next = i;
          if (e.key === 'ArrowDown' || e.key === 'ArrowRight') next = (i + 1) % topTabs.length;
          else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') next = (i - 1 + topTabs.length) % topTabs.length;
          else return;
          e.preventDefault();
          topTabs[next]?.click();
          topTabs[next]?.focus();
        });
      });
    });
  }

  initMasterShowcase();
  document.addEventListener('astro:page-load', initMasterShowcase);
</script>
