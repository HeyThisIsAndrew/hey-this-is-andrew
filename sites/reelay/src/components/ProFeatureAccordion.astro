---
/**
 * ProFeatureAccordion.astro: The Master Consolidated Showcase Accordion
 * Inspired by BE Unconventional HQ's horizontal expandable-panel interaction.
 *
 * Consolidates the Reelay homepage around 5 core thematic pillars:
 * 1. 01 Core Workflow (4-Stage Board): Import to Publish (#interactive-workflow / #studio-preview)
 * 2. 02 7 Platforms & Automations: Native APIs & When-If-Then Rules (#works-with)
 * 3. 03 Creator Tools & Local Assist: ffmpeg pipeline & Zero-Cloud AI
 * 4. 04 Local-First Privacy & Architecture: SQLite reelay.db & Keychain (#data-topology)
 * 5. 05 Download, Specs & Integrity: Apple silicon DMG, SHA-256 Checksums (#download / #tech-specs)
 */
import PlatformIcon from './ui/PlatformIcon.astro';
import Coverage from './ui/Coverage.astro';
import { SITE, DOWNLOADS, CAPABILITIES, CAP_COLUMNS, href } from '../data/site';
import { DEMO_CARDS, type Cover, type PlatformKey } from '../data/demo';

const card = DEMO_CARDS[2];
const cov = (yt: Cover, tt: Cover, ig: Cover, th: Cover): Record<PlatformKey, Cover> =>
  ({ youtube: yt, tiktok: tt, instagram: ig, bluesky: 'off', threads: th, facebook: 'off' });

const workflowSteps = [
  {
    id: 'backlog',
    label: 'Backlog',
    kicker: 'Every download lands here',
    title: 'A video becomes a ticket.',
    body: 'Each video you bring in arrives as a card in Backlog, carrying its original caption, source, and local metadata.',
    coverage: cov('needs', 'needs', 'needs', 'needs'),
    status: 'Needs copy for 4 platforms',
  },
  {
    id: 'staging',
    label: 'Staging',
    kicker: 'Write it once per platform',
    title: 'Ready means ready.',
    body: 'Platform checklist: tailored caption, character limits, video validation. Ready when at least one platform is confirmed.',
    coverage: cov('ready', 'ready', 'ready', 'ready'),
    status: 'Ready for 4 platforms',
  },
  {
    id: 'scheduled',
    label: 'Scheduled',
    kicker: 'Nothing unready gets through',
    title: 'The Ready gate holds the door.',
    body: 'Scheduling validates each platform. Direct upload queues run with rollback safety and zero silent overwrites.',
    coverage: cov('sched', 'ready', 'ready', 'sched'),
    status: 'YouTube · Tue 9:00 AM',
  },
  {
    id: 'published',
    label: 'Published',
    kicker: 'One record of everywhere it went',
    title: 'It finishes on its own.',
    body: 'Card moves to Published when complete. Check for Updates confirms live posts, and change history records every edit.',
    coverage: cov('live', 'live', 'live', 'live'),
    status: 'Live on 4 platforms',
  },
];

const topologyNodes = [
  {
    id: 'on-device',
    label: 'On your computer',
    short: 'Library & database',
    title: 'Your archive lives where you put it.',
    body: 'Videos download into your local library folder. Every ticket, copy, transcript, and index live in local SQLite (reelay.db).',
    rows: [
      ['Videos', 'Your local library folder'],
      ['Database', 'SQLite (reelay.db)'],
      ['Transcripts & Edits', 'Local application support'],
      ['Cloud copies on Reelay', 'None'],
    ],
  },
  {
    id: 'keychain',
    label: 'In your keychain',
    short: 'Sign-ins & keys',
    title: 'Sign-ins never touch a file.',
    body: 'Platform OAuth tokens and API keys are stored in macOS Keychain. Revoked tokens are purged locally and at provider.',
    rows: [
      ['YouTube & Meta tokens', 'macOS Keychain'],
      ['Bluesky App Password', 'macOS Keychain'],
      ['Agent API Key', 'macOS Keychain'],
      ['In Reelay database', 'Never'],
    ],
  },
  {
    id: 'platforms',
    label: 'Direct to platforms',
    short: 'Uploads & posts',
    title: 'From your computer to theirs.',
    body: 'Uploads go directly from your Mac to platform APIs with zero cloud middleware. Sign-ins use secure local loopback.',
    rows: [
      ['Video uploads', 'Your Mac → Platform API'],
      ['Google sign-in', 'Loopback on 127.0.0.1'],
      ['Sign-in broker', 'Ephemeral code exchange only'],
      ['Third-party trackers', 'Zero'],
    ],
  },
  {
    id: 'security',
    label: 'Local boundaries',
    short: 'Isolation & safety',
    title: 'Strict security boundaries.',
    body: 'Reelay operates entirely on your device. Agents require explicit approvals before any publish, edit, or delete action.',
    rows: [
      ['Agent execution', 'Requires human confirmation'],
      ['Network activity', 'Declared platform hosts only'],
      ['Telemetry & Ads', 'Completely absent'],
      ['Source verification', 'SHA-256 release digests'],
    ],
  },
];


const apple = 'M16.4 12.6c0-2.4 2-3.6 2.1-3.6-1.1-1.7-2.9-1.9-3.5-1.9-1.5-.2-2.9.9-3.7.9-.8 0-1.9-.9-3.2-.8-1.6 0-3.1 1-4 2.4-1.7 3-.4 7.4 1.2 9.8.8 1.2 1.8 2.5 3 2.4 1.2 0 1.7-.8 3.1-.8s1.9.8 3.2.8c1.3 0 2.2-1.2 3-2.4.9-1.4 1.3-2.7 1.3-2.8 0 0-2.5-1-2.5-4zM14 5.4c.7-.8 1.1-1.9 1-3-.9 0-2.1.6-2.8 1.4-.6.7-1.2 1.8-1 2.9 1.1.1 2.1-.6 2.8-1.3z';
const windows = 'M0 3.449L9.75 2.1v9.451H0m10.949-9.602L24 0v11.4H10.949M0 12.6h9.75v9.451L0 20.699M10.949 12.6H24V24l-12.949-1.801';

const panels = [
  {
    id: 'workflow',
    num: '01',
    shortTitle: 'Workflow',
    title: 'Core Workflow',
    kicker: '4-Stage Kanban Pipeline',
    headline: 'From local files to finished posts.',
    body: 'Bring in videos you own or manage. Reelay parses metadata, drafts platform-tailored copy, and moves tickets through an Apple-standard Kanban board. Nothing leaves your Mac until you inspect and approve it.',
    link: { label: 'Explore Pipeline & Board', href: href('/features/pipeline') },
    tags: ['Staging library', 'Approval gate', 'Zero accidental posts'],
    anchorId: 'studio-preview',
  },
  {
    id: 'platforms',
    num: '02',
    shortTitle: 'Platforms',
    title: 'Platforms & Rules',
    kicker: 'Seven Platforms · Native APIs',
    headline: 'Seven platforms. Exactly what it does on each.',
    body: 'Reelay connects directly from your Mac to platform APIs with zero cloud middleware. Automate repetitive metadata filling with When · If · Then rules, while respecting each platform’s rules and boundaries.',
    link: { label: 'Explore Automations & Rules', href: href('/features/automations') },
    tags: ['YouTube, TikTok, Meta', 'Direct API posting', 'When · If · Then rules'],
    anchorId: 'works-with',
  },
  {
    id: 'tools',
    num: '03',
    shortTitle: 'Creator Tools',
    title: 'Creator Tools',
    kicker: 'Local ffmpeg & Zero-Token AI',
    headline: 'Non-destructive video tools. Zero-cloud AI.',
    body: 'Strip or replace audio tracks, burn subtitles non-destructively from SRT/VTT files with ffmpeg on this computer, and get caption rewrites using local LLMs (Ollama or llama.cpp) running on your Mac’s Apple silicon. No monthly tokens, no cloud subscriptions, no data leaks.',
    link: { label: 'Explore Video Tools & Local AI', href: href('/features/library') },
    tags: ['ffmpeg audio & subs', 'Originals untouched', 'Ollama / llama.cpp'],
    anchorId: 'creator-tools',
  },
  {
    id: 'privacy',
    num: '04',
    shortTitle: 'Privacy',
    title: 'Privacy & Architecture',
    kicker: 'Local SQLite · macOS Keychain',
    headline: 'Where your data actually goes. The 3 boundaries.',
    body: 'Your SQLite database (reelay.db), media files, and platform sign-ins live on your Mac. Platform tokens are stored exclusively in macOS Keychain. Zero analytics, zero tracking, zero third-party telemetry.',
    link: { label: 'Security & Privacy Architecture', href: href('/security') },
    tags: ['SQLite reelay.db', 'macOS Keychain', 'Zero telemetry'],
    anchorId: 'data-topology',
  },
  {
    id: 'download',
    num: '05',
    shortTitle: 'Download',
    title: 'Download & Specs',
    kicker: 'Apple Silicon Native · v0.12.0 Beta',
    headline: 'Native Mac app. 105.4 MB. Free beta.',
    body: 'Reelay is an Apple silicon native macOS application (macOS 12+). Verified DMG with cryptographic SHA-256 integrity. Also available via automated PowerShell script for Windows and source build on Linux.',
    link: { label: 'Download Center & Release Notes', href: href('/download') },
    tags: ['macOS 12+ Apple silicon', 'Windows script', 'Linux source'],
    anchorId: 'download',
  },
];
---

<section class="stage stage--lift acc" id="four-pillars" aria-labelledby="acc-title">
  <div class="wrap">
    <header class="chapter-head" data-reveal>
      <p class="eyebrow">The Studio Showcase</p>
      <h2 id="acc-title" class="headline">Everything in one place.<br /><span class="text-silver">Explore how Reelay works.</span></h2>
      <p class="lede">Select any panel below to explore Reelay’s core workflow, platform integrations, creator tools, local-first privacy, and download options.</p>
    </header>

    <div class="horizontal-accordion-wrap" data-reveal>
      <div class="horizontal-accordion" data-accordion role="region" aria-label="Reelay deep capabilities track">
        {panels.map((p, i) => (
          <div
            class:list={['acc-panel', { 'is-expanded': i === 0, 'is-collapsed': i !== 0 }]}
            data-panel-id={p.id}
            id={`acc-panel-wrap-${p.id}`}
          >
            <!-- Panel Header Strip / Trigger -->
            <button
              type="button"
              class="panel-strip"
              data-accordion-header
              data-target={p.id}
              id={`acc-${p.id}`}
              role="button"
              aria-expanded={i === 0 ? 'true' : 'false'}
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-controls={`panel-body-${p.id}`}
              aria-label={`${p.title} capability drawer`}
              tabindex={i === 0 ? 0 : -1}
            >
              <div class="strip-header-content">
                <span class="strip-num">{p.num}</span>
                <span class="strip-label">{p.shortTitle}</span>
              </div>
              <div class="strip-marker" aria-hidden="true">
                <span class="strip-indicator"></span>
                <svg class="strip-chevron" width="12" height="12" viewBox="0 0 12 12" fill="none">
                  <path d="M2.5 4.5L6 8L9.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </div>
            </button>

            <!-- Expanded Panel Body -->
            <div
              class="panel-body"
              id={`panel-body-${p.id}`}
              role="region"
              aria-labelledby={`acc-${p.id}`}
            >
              <div class="panel-inner">
                <!-- Narrative column -->
                <div class="panel-narrative">
                  <div class="narrative-meta">
                    <span class="panel-num-pill">{p.num}</span>
                    <span class="panel-kicker">{p.kicker}</span>
                  </div>
                  <h3 class="panel-title">{p.headline}</h3>
                  <p class="panel-body-text">{p.body}</p>

                  <div class="panel-tags" aria-label="Key guarantees">
                    {p.tags.map((t) => <span class="tag-pill">{t}</span>)}
                  </div>

                  <div class="panel-action">
                    <a class="link-more" href={p.link.href}>{p.link.label}</a>
                  </div>
                </div>

                <!-- Visual Workstation Column -->
                <div class="panel-visual">
                  {/* PANEL 01: Core 4-Stage Publishing Workflow */}
                  {p.id === 'workflow' && (
                    <div class="ws-workstation ws-workflow" id="interactive-workflow">
                      <div class="ws-header">
                        <div class="ws-tabs" role="tablist" aria-label="Board columns">
                          {workflowSteps.map((s, idx) => (
                            <button
                              type="button"
                              role="tab"
                              class="workflow-step-tab"
                              id={`tab-${s.id}`}
                              data-step-target={s.id}
                              aria-selected={idx === 0 ? 'true' : 'false'}
                              aria-controls={`panel-${s.id}`}
                              tabindex={idx === 0 ? 0 : -1}
                            >
                              <span class="wf-num">{String(idx + 1).padStart(2, '0')}</span>
                              <span>{s.label}</span>
                            </button>
                          ))}
                        </div>
                      </div>

                      <div class="ws-content">
                        {workflowSteps.map((s, idx) => (
                          <div
                            class="wf-panel"
                            role="tabpanel"
                            id={`panel-${s.id}`}
                            aria-labelledby={`tab-${s.id}`}
                            hidden={idx !== 0}
                            tabindex="0"
                          >
                            <div class="ticket-card" id="studio-preview">
                              <div class="tc-top">
                                <span class="tc-title">{card.title}</span>
                                <span class={`tc-badge tc-badge--${idx === 0 ? 'backlog' : idx === 1 ? 'staging' : idx === 2 ? 'sched' : 'live'}`}>{s.status}</span>
                              </div>
                              <p class="tc-meta">{s.kicker} · 0:42 · 1080×1920 · 48 kHz AAC</p>
                              <div class="tc-cov">
                                <span class="tc-cov-label">Platform Readiness:</span>
                                <Coverage coverage={s.coverage} />
                              </div>
                              <div class="tc-preview">
                                <p class="tc-caption">“{s.body}”</p>
                              </div>
                            </div>
                          </div>
                        ))}
                      </div>
                      <p class="workflow-simulation-disclaimer">Interactive preview of Reelay’s local pipeline.</p>
                    </div>
                  )}

                  {/* PANEL 02: 7 Platforms & Automations */}
                  {p.id === 'platforms' && (
                    <div class="ws-workstation ws-platforms" id="works-with">
                      <div class="ws-table-wrap">
                        <table class="cm-table" id="works-with-table">
                          <thead>
                            <tr>
                              <th scope="col">Platform</th>
                              {CAP_COLUMNS.map(([, label]) => <th scope="col">{label}</th>)}
                            </tr>
                          </thead>
                          <tbody>
                            {CAPABILITIES.map((row) => (
                              <tr>
                                <th scope="row">
                                  <span class="cm-pf">
                                    {row.key === 'snapchat'
                                      ? <span class="cm-dot" aria-hidden="true">S</span>
                                      : <PlatformIcon name={row.key} />}
                                    {row.name}
                                  </span>
                                </th>
                                {CAP_COLUMNS.map(([key, label]) => {
                                  const c = row[key];
                                  return (
                                    <td data-label={label} class={`cm-${c.state}`}>
                                      <span class="cm-g" aria-hidden="true"></span>
                                      <span class="cm-l">{c.label}</span>
                                    </td>
                                  );
                                })}
                              </tr>
                            ))}
                          </tbody>
                        </table>
                      </div>
                      <div class="rule-preview-pill">
                        <span class="rule-tag">Rule Hook</span>
                        <span>When video added → If tag matches → Then format captions & schedule</span>
                      </div>
                    </div>
                  )}

                  {/* PANEL 03: Creator Tools & Local Assist */}
                  {p.id === 'tools' && (
                    <div class="ws-workstation ws-tools" id="creator-tools">
                      <div class="tools-grid">
                        <div class="vis-card vis-card--tools">
                          <div class="card-bar">
                            <span class="bar-dot"></span>
                            <span class="bar-title">ffmpeg Video Pipeline</span>
                          </div>
                          <div class="files">
                            <div class="file">
                              <span class="fthumb"></span>
                              <span><b>first-snow.mp4</b><small>Original · Never modified</small></span>
                            </div>
                            <div class="arrow">ffmpeg · burn in captions.srt</div>
                            <div class="file hot">
                              <span class="fthumb"><i class="sub">first snow and I was not ready</i></span>
                              <span><b>first-snow.edited.mp4</b><small>Rendered copy · Ready to post</small></span>
                            </div>
                          </div>
                        </div>

                        <div class="vis-card vis-card--assist">
                          <div class="card-bar">
                            <span class="bar-dot"></span>
                            <span class="bar-title">Local LLM Assist (Zero Cloud)</span>
                          </div>
                          <div class="assist">
                            <p class="assist-text">the last ten minutes of light on the big sur coast, <u>shot hand held</u> from the turnout</p>
                            <div class="assist-pop">
                              <span class="assist-h">Assist Menu</span>
                              <span>Spelling: <b>handheld</b></span>
                              <span>Brand Voice: <b>Natural & Direct</b></span>
                              <span class="assist-model">Model: llama3.2:3b on this Mac · 0 tokens</span>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  )}

                  {/* PANEL 04: Local-First Privacy & Architecture */}
                  {p.id === 'privacy' && (
                    <div class="ws-workstation ws-topology" id="data-topology">
                      <div class="ws-tabs" role="tablist" aria-label="Data boundaries">
                        {topologyNodes.map((n, idx) => (
                          <button
                            type="button"
                            role="tab"
                            class="topology-tab"
                            id={`top-tab-${n.id}`}
                            data-node-target={n.id}
                            aria-selected={idx === 0 ? 'true' : 'false'}
                            aria-controls={`panel-${n.id}`}
                            tabindex={idx === 0 ? 0 : -1}
                          >
                            <span class="wf-num">{String(idx + 1).padStart(2, '0')}</span>
                            <span>{n.short}</span>
                          </button>
                        ))}
                      </div>

                      <div class="ws-content">
                        {topologyNodes.map((n, idx) => (
                          <div
                            class="wf-panel"
                            role="tabpanel"
                            id={`panel-${n.id}`}
                            aria-labelledby={`top-tab-${n.id}`}
                            hidden={idx !== 0}
                            tabindex="0"
                          >
                            <div class="topology-detail-card">
                              <h4 class="top-detail-title">{n.title}</h4>
                              <p class="top-detail-body">{n.body}</p>
                              <dl class="top-rows">
                                {n.rows.map(([item, loc]) => (
                                  <div class="top-row">
                                    <dt>{item}</dt>
                                    <dd><code>{loc}</code></dd>
                                  </div>
                                ))}
                              </dl>
                            </div>
                          </div>
                        ))}
                      </div>
                    </div>
                  )}

                  {/* PANEL 05: Download, Specs & Integrity */}
                  {p.id === 'download' && (
                    <div class="ws-workstation ws-download download-section" id="download">
                      <div class="ws-dl-cards">
                        <!-- macOS (Featured Release) -->
                        <div class="download-card download-card--featured">
                          <div class="dc-badge dc-badge--verified">{DOWNLOADS.macArm.badge}</div>
                          <span class="dc-glyph" aria-hidden="true"><svg viewBox="0 0 24 24"><path fill="currentColor" d={apple} /></svg></span>
                          <h4 class="dc-title">{DOWNLOADS.macArm.platform}</h4>
                          <p class="dc-specs">{DOWNLOADS.macArm.requirements}</p>
                          <a class="btn btn-primary btn-sm dc-btn" href={DOWNLOADS.macArm.href}>Download for Mac</a>
                          <p class="dc-meta">{DOWNLOADS.macArm.filename} · {DOWNLOADS.macArm.size}</p>
                        </div>

                        <!-- Windows Card -->
                        <div class="download-card">
                          <div class="dc-badge">{DOWNLOADS.windows.badge}</div>
                          <span class="dc-glyph" aria-hidden="true"><svg viewBox="0 0 24 24"><path fill="currentColor" d={windows} /></svg></span>
                          <h4 class="dc-title">{DOWNLOADS.windows.platform}</h4>
                          <p class="dc-specs">{DOWNLOADS.windows.requirements}</p>
                          <a class="btn btn-secondary btn-sm dc-btn" href={DOWNLOADS.windows.href}>{DOWNLOADS.windows.label}</a>
                          <p class="dc-meta font-mono"><code>{DOWNLOADS.windows.pipelineScript}</code></p>
                        </div>

                        <!-- Linux Card -->
                        <div class="download-card">
                          <div class="dc-badge">{DOWNLOADS.linux.badge}</div>
                          <span class="dc-glyph" aria-hidden="true">🐧</span>
                          <h4 class="dc-title">{DOWNLOADS.linux.platform}</h4>
                          <p class="dc-specs">{DOWNLOADS.linux.requirements}</p>
                          <a class="btn btn-secondary btn-sm dc-btn" href={DOWNLOADS.linux.href}>{DOWNLOADS.linux.label}</a>
                          <p class="dc-meta font-mono"><code>{DOWNLOADS.linux.pipelineScript}</code></p>
                        </div>
                      </div>

                      <div class="dl-footer-row" id="tech-specs">
                        <details class="checksums-drawer">
                          <summary class="checksums-summary">
                            <span class="cs-label">Cryptographic SHA-256 release checksum</span>
                            <span class="cs-ver">{SITE.version}</span>
                          </summary>
                          <div class="checksums-content">
                            <pre>25d314bff7a3bdecffa66c5ba2261e3c732b347401d1c2e881ccdcde3f2fdfa0</pre>
                          </div>
                        </details>
                      </div>
                    </div>
                  )}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .acc {
    position: relative;
    padding-block: clamp(2rem, 5vw, 4rem);
  }

  .horizontal-accordion-wrap {
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
    width: 100%;
  }

  /* Desktop Horizontal Track Layout (>= 860px) */
  @media (min-width: 860px) {
    .horizontal-accordion {
      display: flex;
      flex-direction: row;
      height: 680px;
      gap: 8px;
      width: 100%;
      border-radius: var(--radius-lg);
      background: var(--r-bg-alt);
      border: 1px solid var(--hairline-strong);
      padding: 8px;
      overflow: hidden;
      box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.5);
    }

    .acc-panel {
      position: relative;
      display: flex;
      flex-direction: row;
      border-radius: calc(var(--radius-lg) - 4px);
      overflow: hidden;
      background: var(--r-fill);
      border: 1px solid var(--hairline);
      transition: flex 0.45s cubic-bezier(0.16, 1, 0.3, 1),
                  background 0.3s ease,
                  border-color 0.3s ease;
    }

    .acc-panel.is-collapsed {
      flex: 0 0 72px;
      cursor: pointer;
    }

    .acc-panel.is-collapsed:hover {
      background: var(--r-fill-2);
      border-color: rgba(245, 197, 107, 0.3);
    }

    .acc-panel.is-expanded {
      flex: 1 1 0%;
      background: var(--r-surface);
      border-color: rgba(245, 197, 107, 0.35);
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
    }

    /* Left accent indicator bar on active panel */
    .acc-panel.is-expanded::before {
      content: '';
      position: absolute;
      top: 0;
      bottom: 0;
      left: 0;
      width: 4px;
      background: var(--r-amber-text);
      z-index: 5;
    }

    .panel-strip {
      flex: 0 0 72px;
      width: 72px;
      height: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: space-between;
      padding: 1.5rem 0.5rem;
      background: transparent;
      border: none;
      cursor: pointer;
      color: var(--r-ink-2);
      transition: color 0.2s ease;
      user-select: none;
    }

    .strip-header-content {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1.5rem;
      width: 100%;
    }

    .strip-num {
      font-family: var(--font-mono);
      font-size: 0.85rem;
      font-weight: 700;
      color: var(--r-amber-text);
      letter-spacing: 0.05em;
    }

    .strip-label {
      writing-mode: vertical-rl;
      transform: rotate(180deg);
      font-family: var(--font-body);
      font-size: 0.82rem;
      font-weight: 600;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      white-space: nowrap;
      color: var(--r-ink-2);
      transition: color 0.2s ease;
    }

