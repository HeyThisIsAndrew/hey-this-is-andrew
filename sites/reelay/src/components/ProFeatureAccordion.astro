---
/**
 * ProFeatureAccordion: Apple-Grade 5-Drawer Vertical Feature Accordion
 * Built with @andrew/ui SectionHeader and accessible progressive disclosure.
 * Drawer 01 is rendered open on the server for instant LCP painting.
 */
import SectionHeader from '@andrew/ui/SectionHeader.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '');
---

<section class="section pro-accordion-section" aria-labelledby="architecture-heading">
  <span id="architecture-drawers" class="sr-only"></span>
  <div class="container">
    <SectionHeader
      index="02"
      kicker="CAPABILITIES & ARCHITECTURE"
      title="The Reelay Studio Architecture"
      lede="Engineered from the ground up as a native desktop application for creator sovereignty, speed, and privacy. Explore the core pillars:"
      id="architecture-heading"
    />

    <div class="pro-accordion-group" data-accordion-group id="four-pillars">
      <!-- ========================================================
           DRAWER 01: Media Library & In-App Video Player
           (Rendered open on server)
           ======================================================== -->
      <div class="pro-drawer is-expanded" id="drawer-media-library">
        <h3 class="pro-drawer-heading">
          <button
            type="button"
            class="pro-drawer-header"
            data-accordion-header
            aria-expanded="true"
            aria-controls="drawer-media-library-content"
          >
            <span class="pro-drawer-num font-mono">01</span>
            <div class="pro-drawer-title-wrap">
              <span class="pro-drawer-kicker font-mono">PRO PLAYBACK ENGINE & ARCHIVE</span>
              <span class="pro-drawer-title">Media Library & In-App Player</span>
            </div>
            <div class="pro-drawer-meta-pill">
              <span class="spec-tag">60 FPS</span>
              <span class="spec-tag">VP9/AV1</span>
              <span class="spec-tag">Whisper AI</span>
            </div>
            <span class="pro-drawer-chevron" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </span>
          </button>
        </h3>
        <div id="drawer-media-library-content" class="pro-drawer-body" role="region" aria-labelledby="drawer-media-library">
          <div class="pro-drawer-body-inner">
            <div class="drawer-split-grid">
              <!-- Left Narrative -->
              <div class="drawer-narrative">
                <h4 class="drawer-subhead">Stop organizing video in spreadsheets.</h4>
                <p>
                  Built on native <code>QGraphicsView</code> and <code>QtMultimedia</code>, Reelay's playback engine scrubs smoothly through 4K 60fps footage with zero cloud buffering.
                </p>
                <ul class="drawer-feature-list">
                  <li>
                    <strong>Direct High-Fidelity Downloads:</strong> Bundled <code>yt-dlp</code> pulls pristine video assets directly from YouTube, TikTok, and Instagram.
                  </li>
                  <li>
                    <strong>Intelligent Ratio Detection:</strong> Distinguishes automatically between 9:16 vertical Shorts/Reels and 16:9 longform 4K footage.
                  </li>
                  <li>
                    <strong>Offline Whisper Speech Indexing:</strong> Transcribes audio locally on your GPU. Full-text search (SQLite FTS5) instantly locates the exact second you spoke any phrase.
                  </li>
                </ul>
                <div class="drawer-actions">
                  <a href={`${base}/features/library`} class="btn btn-secondary btn-sm">
                    Explore Studio Player & Library →
                  </a>
                </div>
              </div>

              <!-- Right Interactive Showcase -->
              <div class="drawer-showcase">
                <div class="mockup-subcard">
                  <div class="subcard-header">
                    <span class="font-mono text-xs">REELAY HARDWARE DECODER • VP9/AV1</span>
                    <span class="badge">Metal 60 FPS</span>
                  </div>
                  <div class="mini-player-display">
                    <div class="player-aspect-badge">9:16 VERTICAL CANVAS</div>
                    <div class="live-soundwave">
                      <span></span><span></span><span></span><span></span><span></span><span></span><span></span>
                    </div>
                    <div class="player-quote">
                      "Local-first content operations for multi-platform video creators."
                    </div>
                    <div class="player-caption-box">
                      <span class="cap-word active">Stop</span>
                      <span class="cap-word active">organizing</span>
                      <span class="cap-word active">in</span>
                      <span class="cap-word">spreadsheets</span>
                    </div>
                  </div>
                  <div class="mini-player-bar">
                    <span class="play-dot">▶</span>
                    <div class="mini-scrub-track"><div class="mini-scrub-fill" style="width: 48%;"></div></div>
                    <span class="font-mono text-xs">00:24 / 00:58</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- ========================================================
           DRAWER 02: Cross-Platform Kanban Pipeline
           ======================================================== -->
      <div class="pro-drawer" id="drawer-kanban-pipeline">
        <h3 class="pro-drawer-heading">
          <button
            type="button"
            class="pro-drawer-header"
            data-accordion-header
            aria-expanded="false"
            aria-controls="drawer-kanban-pipeline-content"
          >
            <span class="pro-drawer-num font-mono">02</span>
            <div class="pro-drawer-title-wrap">
              <span class="pro-drawer-kicker font-mono">MULTI-PLATFORM WORKFLOW</span>
              <span class="pro-drawer-title">Cross-Platform Kanban Pipeline</span>
            </div>
            <div class="pro-drawer-meta-pill">
              <span class="spec-tag">5 Stages</span>
              <span class="spec-tag">Coverage Map</span>
              <span class="spec-tag">Frictionless Handoff</span>
            </div>
            <span class="pro-drawer-chevron" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </span>
          </button>
        </h3>
        <div id="drawer-kanban-pipeline-content" class="pro-drawer-body" role="region" aria-labelledby="drawer-kanban-pipeline">
          <div class="pro-drawer-body-inner">
            <div class="drawer-split-grid">
              <!-- Left Narrative -->
              <div class="drawer-narrative">
                <h4 class="drawer-subhead">One master video. Five native platforms.</h4>
                <p>
                  Eliminate fragmented Trello boards and missing video files. Reelay tracks each video's lifecycle from raw capture to live verified publishing across YouTube, TikTok, Instagram, Threads, and Facebook.
                </p>
                <ul class="drawer-feature-list">
                  <li>
                    <strong>5 Verified Lifecycle Columns:</strong> Move cards through <code>Backlog</code> → <code>Staging</code> → <code>Ready</code> → <code>Scheduled</code> → <code>Published</code>.
                  </li>
                  <li>
                    <strong>Live Coverage Indicators:</strong> Color-coded indicators on every card show platform readiness, aspect ratios, and custom cover completeness at a glance.
                  </li>
                  <li>
                    <strong>"Prepare to Publish" Handoff:</strong> When platforms restrict automated publishing APIs, one-click export bundles video files, formatted copy, hashtags, and links directly to native mobile or desktop trays.
                  </li>
                </ul>
                <div class="drawer-actions">
                  <a href={`${base}/features/pipeline`} class="btn btn-secondary btn-sm">
                    Explore Kanban Pipeline →
                  </a>
                </div>
              </div>

              <!-- Right Interactive Showcase -->
              <div class="drawer-showcase">
                <div class="mockup-subcard">
                  <div class="subcard-header">
                    <span class="font-mono text-xs">PIPELINE STAGING • BOARD PREVIEW</span>
                    <span class="badge">14 Active Cards</span>
                  </div>
                  <div class="kanban-sim-grid">
                    <div class="kanban-sim-col">
                      <div class="sim-col-title font-mono">READY (4)</div>
                      <div class="sim-card active">
                        <div class="sim-card-title">Creator_Economy_Drop_03</div>
                        <div class="sim-card-tags">
                          <span class="sim-tag ready">YT Shorts</span>
                          <span class="sim-tag ready">IG Reels</span>
                          <span class="sim-tag pending">TikTok</span>
                        </div>
                      </div>
                      <div class="sim-card">
                        <div class="sim-card-title">Editing_Breakdown_4K</div>
                        <div class="sim-card-tags">
                          <span class="sim-tag ready">YT 16:9</span>
                        </div>
                      </div>
                    </div>
                    <div class="kanban-sim-col">
                      <div class="sim-col-title font-mono">SCHEDULED (2)</div>
                      <div class="sim-card scheduled">
                        <div class="sim-card-title">Hardware_Vs_Cloud_Final</div>
                        <div class="sim-card-time font-mono">Today • 16:00 PST</div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- ========================================================
           DRAWER 03: Safe Automations & Rules Engine
           ======================================================== -->
      <div class="pro-drawer" id="drawer-automations-engine">
        <h3 class="pro-drawer-heading">
          <button
            type="button"
            class="pro-drawer-header"
            data-accordion-header
            aria-expanded="false"
            aria-controls="drawer-automations-engine-content"
          >
            <span class="pro-drawer-num font-mono">03</span>
            <div class="pro-drawer-title-wrap">
              <span class="pro-drawer-kicker font-mono">LOCAL OPERATIONAL LOGIC</span>
              <span class="pro-drawer-title">Automations & Rules Engine</span>
            </div>
            <div class="pro-drawer-meta-pill">
              <span class="spec-tag">When / If / Then</span>
              <span class="spec-tag">Dynamic Tags</span>
              <span class="spec-tag">Zero Overwrite</span>
            </div>
            <span class="pro-drawer-chevron" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </span>
          </button>
        </h3>
        <div id="drawer-automations-engine-content" class="pro-drawer-body" role="region" aria-labelledby="drawer-automations-engine">
          <div class="pro-drawer-body-inner">
            <div class="drawer-split-grid">
              <!-- Left Narrative -->
              <div class="drawer-narrative">
                <h4 class="drawer-subhead">Deterministic desktop logic. Zero accidental publishes.</h4>
                <p>
                  Eliminate repetitive metadata formatting with deterministic desktop rules that trigger automatically when cards move between stages.
                </p>
                <ul class="drawer-feature-list">
                  <li>
                    <strong>Intuitive When / If / Then Rules:</strong> Configure safe local workflows without scripting: <em>When video enters "Ready", generate platform-tailored copy.</em>
                  </li>
                  <li>
                    <strong>Dynamic Tag Interpolation:</strong> Auto-populates platform copy using <code>{`{hook}`}</code>, <code>{`{caption}`}</code>, <code>{`{hashtags}`}</code>, and <code>{`{creator}`}</code> tokens.
                  </li>
                  <li>
                    <strong>Creator Safety Gates:</strong> Each rule executes once per video; manual copy is never overwritten; scheduling strictly enforces readiness verification.
                  </li>
                </ul>
                <div class="drawer-actions">
                  <a href={`${base}/features/automations`} class="btn btn-secondary btn-sm">
                    Explore Rules Engine →
                  </a>
                </div>
              </div>

              <!-- Right Interactive Showcase -->
              <div class="drawer-showcase">
                <div class="mockup-subcard">
                  <div class="subcard-header">
                    <span class="font-mono text-xs">LOCAL SQLITE TRIGGER RUNNER</span>
                    <span class="badge">Rule Active</span>
                  </div>
                  <div class="rule-builder-sim">
                    <div class="sim-rule-row">
                      <span class="rule-kw font-mono">WHEN</span>
                      <span class="rule-arg">Card moves to <code>Ready</code></span>
                    </div>
                    <div class="sim-rule-row">
                      <span class="rule-kw font-mono">IF</span>
                      <span class="rule-arg">Ratio is <code>9:16</code> AND Platform is <code>Instagram Reels</code></span>
                    </div>
                    <div class="sim-rule-row highlight">
                      <span class="rule-kw font-mono">THEN</span>
                      <span class="rule-arg">Append <code>{`{creator}`}</code> signature & schedule verification</span>
                    </div>
                  </div>
                  <div class="rule-gate-notice">
                    <span class="font-mono text-xs">Safety Gate: Creator manual copy locked. Never overwritten.</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- ========================================================
           DRAWER 04: AI Companion Ecosystem (MCP)
           ======================================================== -->
      <div class="pro-drawer" id="drawer-ai-companion">
        <h3 class="pro-drawer-heading">
          <button
            type="button"
            class="pro-drawer-header"
            data-accordion-header
            aria-expanded="false"
            aria-controls="drawer-ai-companion-content"
          >
            <span class="pro-drawer-num font-mono">04</span>
            <div class="pro-drawer-title-wrap">
              <span class="pro-drawer-kicker font-mono">MODEL CONTEXT PROTOCOL (MCP)</span>
              <span class="pro-drawer-title">AI Companion Ecosystem</span>
            </div>
            <div class="pro-drawer-meta-pill">
              <span class="spec-tag">Native MCP</span>
              <span class="spec-tag">0x Token Markup</span>
              <span class="spec-tag">ScopedPipeline</span>
            </div>
            <span class="pro-drawer-chevron" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </span>
          </button>
        </h3>
        <div id="drawer-ai-companion-content" class="pro-drawer-body" role="region" aria-labelledby="drawer-ai-companion">
          <div class="pro-drawer-body-inner">
            <div class="drawer-split-grid">
              <!-- Left Narrative -->
              <div class="drawer-narrative">
                <h4 class="drawer-subhead">Bring your own intelligence. Retain absolute veto power.</h4>
                <p>
                  Instead of paying marked-up token fees inside proprietary walled gardens, Reelay exposes standard Model Context Protocol (MCP) and OpenAPI endpoints locally.
                </p>
                <ul class="drawer-feature-list">
                  <li>
                    <strong>Zero Token Markup:</strong> Connect Claude Desktop, ChatGPT, Google Gemini, or Meta Muse directly. We never bill for or mark up AI tokens.
                  </li>
                  <li>
                    <strong>ScopedPipeline Security Boundary:</strong> Autonomous agents can draft copy, but destructive actions (publishing, scheduling, deleting) trigger durable SQLite <code>approval_requests</code>.
                  </li>
                  <li>
                    <strong>Offline Brand Voice Profiles:</strong> Built-in local writing helpers that run on-device without calling external LLM APIs.
                  </li>
                </ul>
                <div class="drawer-actions">
                  <a href={`${base}/ai`} class="btn btn-secondary btn-sm">
                    Explore AI & MCP Integration →
                  </a>
                </div>
              </div>

              <!-- Right Interactive Showcase -->
              <div class="drawer-showcase">
                <div class="mockup-subcard">
                  <div class="subcard-header">
                    <span class="font-mono text-xs">SCOPED PIPELINE • SECURITY GATE</span>
                    <span class="badge">Human Approval Required</span>
                  </div>
                  <div class="mcp-gate-box">
                    <div class="mcp-req-title">
                      <span class="font-mono text-xs">INCOMING MCP AGENT REQUEST</span>
                    </div>
                    <div class="mcp-code-block font-mono">
                      Tool: publish_to_youtube_shorts<br/>
                      Title: "Publish Everywhere. Never Lose Control."<br/>
                      Status: PENDING_CREATOR_APPROVAL
                    </div>
                    <div class="mcp-actions-row">
                      <button type="button" class="btn btn-primary btn-sm">Approve Action</button>
                      <button type="button" class="btn btn-secondary btn-sm">Deny</button>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- ========================================================
           DRAWER 05: Local-First Sovereignty & Architecture
           ======================================================== -->
      <div class="pro-drawer" id="drawer-local-sovereignty">
        <span id="privacy-first" style="position: absolute; pointer-events: none; opacity: 0;"></span>
        <h3 class="pro-drawer-heading">
          <button
            type="button"
            class="pro-drawer-header"
            data-accordion-header
            aria-expanded="false"
            aria-controls="drawer-local-sovereignty-content"
          >
            <span class="pro-drawer-num font-mono">05</span>
            <div class="pro-drawer-title-wrap">
              <span class="pro-drawer-kicker font-mono">ZERO-CLOUD HARDWARE ARCHITECTURE</span>
              <span class="pro-drawer-title">Your Computer is the Cloud</span>
            </div>
            <div class="pro-drawer-meta-pill">
              <span class="spec-tag">macOS Keychain</span>
              <span class="spec-tag">SQLite Database</span>
              <span class="spec-tag">Direct HTTPS</span>
            </div>
            <span class="pro-drawer-chevron" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </span>
          </button>
        </h3>
        <div id="drawer-local-sovereignty-content" class="pro-drawer-body" role="region" aria-labelledby="drawer-local-sovereignty">
          <div class="pro-drawer-body-inner">
            <div class="drawer-split-grid">
              <!-- Left Narrative -->
              <div class="drawer-narrative">
                <h4 class="drawer-subhead">Your credentials stay in your Keychain. Your videos on your disk.</h4>
                <p>
                  No multi-tenant database breaches. No sudden subscription hostage situations. Reelay executes entirely on your personal workstation.
                </p>
                <ul class="drawer-feature-list">
                  <li>
                    <strong>OS Hardware Keychain Encryption:</strong> Tokens for YouTube, TikTok, and Meta are encrypted by your operating system's hardware keychain. They are never sent to Reelay servers.
                  </li>
                  <li>
                    <strong>Local SQLite Database:</strong> All video metadata, tags, and column states live in <code>~/Library/Application Support/reelay/app.db</code>. Back it up, query it, or export it anytime.
                  </li>
                  <li>
                    <strong>Full Platform Compliance:</strong> Adheres strictly to the Google API Limited Use Policy and Meta Platform Terms. Disconnecting an account or deleting your local folder wipes all credentials immediately.
                  </li>
                </ul>
                <div class="drawer-actions">
                  <a href={`${base}/privacy`} class="btn btn-secondary btn-sm">
                    Read Privacy Policy →
                  </a>
                  <a href={`${base}/data-deletion`} class="btn btn-secondary btn-sm">
                    Data Deletion Guide →
                  </a>
                </div>
              </div>

              <!-- Right Interactive Showcase -->
              <div class="drawer-showcase">
                <div class="mockup-subcard">
                  <div class="subcard-header">
                    <span class="font-mono text-xs">LOCAL SECURITY TOPOLOGY</span>
                    <span class="badge">Zero Proxy Relay</span>
                  </div>
                  <div class="topology-diagram">
                    <div class="topo-node workstation">
                      <div class="topo-icon">💻</div>
                      <strong>Your Machine (Local SQLite)</strong>
                      <span class="font-mono text-xs">Keychain Encrypted Tokens</span>
                    </div>
                    <div class="topo-arrow font-mono">
                      <span>Direct HTTPS Dispatch (RFC 8252 Loopback)</span>
                      <span>▼ Zero Middleware Server</span>
                    </div>
                    <div class="topo-node cloud-targets">
                      <div class="topo-targets-row">
                        <span class="target-chip">YouTube API</span>
                        <span class="target-chip">Instagram API</span>
                        <span class="target-chip">TikTok API</span>
                      </div>
                      <span class="font-mono text-xs">Official Platform Endpoints Only</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Monorepo Accordion Interactive Script -->
<script>
  function initProAccordions() {
    const groups = document.querySelectorAll('[data-accordion-group]');
    groups.forEach(group => {
      const headers = group.querySelectorAll('[data-accordion-header]');
      headers.forEach(header => {
        // Remove existing listener to prevent duplicate attachment
        header.replaceWith(header.cloneNode(true));
      });

      const freshHeaders = group.querySelectorAll('[data-accordion-header]');
      freshHeaders.forEach(header => {
        header.addEventListener('click', () => {
          const isExpanded = header.getAttribute('aria-expanded') === 'true';
          const drawer = header.closest('.pro-drawer');
          
          if (drawer) {
            if (isExpanded) {
              // Collapse
              header.setAttribute('aria-expanded', 'false');
              drawer.classList.remove('is-expanded');
            } else {
              // Expand this drawer
              header.setAttribute('aria-expanded', 'true');
              drawer.classList.add('is-expanded');
            }
          }
        });
      });
    });

    // Deep link hash handling
    if (window.location.hash) {
      const target = document.querySelector(window.location.hash);
      if (target) {
        const drawer = target.classList.contains('pro-drawer') ? target : target.closest('.pro-drawer');
        if (drawer) {
          drawer.classList.add('is-expanded');
          const header = drawer.querySelector('[data-accordion-header]');
          if (header) header.setAttribute('aria-expanded', 'true');
          drawer.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }
    }
  }

  initProAccordions();
  document.addEventListener('astro:page-load', initProAccordions);
</script>

<style>
  .pro-accordion-section {
    padding-top: clamp(3.5rem, 6vw, 6rem);
    padding-bottom: clamp(3.5rem, 6vw, 6rem);
    border-bottom: 1px solid var(--hairline);
    position: relative;
  }

  .pro-accordion-group {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-top: 3rem;
  }

  /* Drawer Container */
  .pro-drawer {
    background-color: #0b0c11;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius);
    overflow: hidden;
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .pro-drawer:hover {
    border-color: rgba(255, 255, 255, 0.2);
  }

  .pro-drawer.is-expanded {
    border-color: rgba(229, 169, 60, 0.45);
    background: linear-gradient(180deg, rgba(229, 169, 60, 0.03) 0%, rgba(11, 12, 17, 1) 100%);
    box-shadow: 0 15px 45px rgba(0, 0, 0, 0.5), 0 0 30px rgba(229, 169, 60, 0.08);
  }

  .pro-drawer-heading {
    margin: 0;
    padding: 0;
  }

  /* Header Button: Apple Touch-Optimized Height */
  .pro-drawer-header {
    width: 100%;
    min-height: 56px;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 1.5rem 2rem;
    background: transparent;
    border: none;
    text-align: left;
    cursor: pointer;
    color: var(--text-primary);
    position: relative;
    transition: background-color 0.2s ease;
  }

  .pro-drawer-header:hover {
    background-color: rgba(255, 255, 255, 0.02);
  }

  .pro-drawer-num {
    font-size: 1rem;
    font-weight: 700;
    color: var(--brand);
    flex-shrink: 0;
  }

  .pro-drawer-title-wrap {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .pro-drawer-kicker {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--text-muted);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .pro-drawer-title {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2.5vw, 1.65rem);
    font-weight: 700;
    color: #ffffff;
    line-height: 1.2;
    letter-spacing: -0.025em;
  }

  .pro-drawer-meta-pill {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-shrink: 0;
  }

  .spec-tag {
    font-family: var(--font-mono);
