---
/**
 * TrustComplianceStrip: Authoritative, concise regulatory and platform
 * trust disclosures at the base of the homepage.
 *
 * Verbatim disclosures:
 * - Google Limited Use
 * - Meta Platform Terms & Data Deletion
 * - YouTube Terms of Service
 */
import { LIMITED_USE } from '../data/operator';
import { href } from '../data/site';
---

<section class="trust-strip stage" aria-label="Platform compliance and data trust">
  <div class="wrap">
    <div class="trust-card" data-reveal>
      <div class="trust-badges">
        <span class="trust-badge">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
          Google API Limited Use
        </span>
        <span class="trust-badge">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
          </svg>
          Sign-ins in your keychain
        </span>
        <span class="trust-badge">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/>
            <path d="M12 8v4l3 3"/>
          </svg>
          No ads or analytics SDKs
        </span>
      </div>

      <p class="trust-limited-use">
        {LIMITED_USE}
      </p>

      <div class="trust-links">
        <span>By using Reelay with YouTube, you agree to the <a href="https://www.youtube.com/t/terms" target="_blank" rel="noopener noreferrer">YouTube Terms of Service</a> and Google’s <a href="https://policies.google.com/privacy" target="_blank" rel="noopener noreferrer">Privacy Policy</a>.</span>
        <span>Meta data deletion: <a href={href('/data-deletion')}>Review deletion procedures</a>.</span>
        <span>Security: <a href={href('/security')}>How Reelay keeps your data safe</a>.</span>
      </div>
    </div>
  </div>
</section>

<style>
  @media (min-width: 900px) { .trust-badges { flex-direction: row !important; } }
  .trust-strip {
    padding-block: clamp(2.5rem, 5vw, 4rem);
    border-top: 1px solid var(--hairline);
  }

  .trust-card {
    padding: clamp(1.25rem, 3vw, 2rem);
    border-radius: var(--radius-lg);
    background: var(--r-fill-2);
    border: 1px solid var(--hairline-strong);
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  /* Three badges: one row, or one column. Never two and one. */
  .trust-badges {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6rem 1rem;
  }

  .trust-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--r-amber-text);
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    background: var(--r-amber-soft);
    border: 1px solid rgba(245, 197, 107, 0.25);
  }

  .trust-limited-use {
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--r-ink-2);
    margin: 0;
  }

  .trust-links {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.82rem;
    color: var(--r-ink-3);
    padding-top: 0.5rem;
    border-top: 1px solid var(--hairline);
  }

  .trust-links a {
    color: var(--r-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .trust-links a:hover {
    color: var(--r-amber-text);
  }
</style>
