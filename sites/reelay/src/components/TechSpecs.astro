---
/**
 * TechSpecs: Apple's tech-specs table. Labels left, facts right, hairlines
 * between. Every line is checkable against the app's README and code.
 */
import { AGENT_API, DATA_PATHS, href } from '../data/site';

const specs = [
  { k: 'Runs on', v: ['Mac with Apple silicon, macOS 12 Monterey or later'] },
  { k: 'Brings in from', v: ['TikTok, Instagram and YouTube profiles you own or manage', 'Snapchat Spotlight links you paste'] },
  { k: 'Writes copy for', v: ['YouTube, TikTok, Instagram, Bluesky, Threads and Facebook', 'Live counts against each platform’s own limits'] },
  { k: 'Posts automatically to', v: ['YouTube: upload and schedule', 'Bluesky, Threads and Facebook once you turn them on'] },
  { k: 'Posted by hand', v: ['TikTok, Instagram and Snapchat, with Prepare to Publish'] },
  { k: 'Board', v: ['Backlog, Staging, Scheduled, Published', 'Custom columns per profile'] },
  { k: 'Storage', v: [`SQLite (${DATA_PATHS.dbName}) with FTS5 full-text search`, 'Optional shared database in Drive, Dropbox, iCloud Drive or OneDrive'] },
  { k: 'Sign-ins', v: ['Stored in the macOS Keychain', 'Google sign-in over loopback (RFC 8252) with PKCE'] },
  { k: 'Player', v: ['QtMultimedia with FFmpeg', 'Space or K to play, J and L skip 10 s, arrows skip 5 s, M mutes', 'H.264 preview copy for VP9 and AV1 above 1080p'] },
  { k: 'Writing help', v: ['Built-in spelling; LanguageTool offline when installed', 'Rewrites with Ollama or llama.cpp on your computer'] },
  { k: 'Agent API', v: [`REST on ${AGENT_API.host}:${AGENT_API.port}, OpenAPI 3.1`, 'Bearer key from the keychain; approvals for anything that posts'] },
  { k: 'Appearance', v: ['Light, Dark, Black, or Custom with each profile’s brand colours'] },
];
---
<section class="stage specs" id="tech-specs" aria-labelledby="specs-title">
  <div class="wrap">
    <header class="specs-head" data-reveal>
      <h2 id="specs-title" class="title">Tech specs</h2>
      <p class="fine">Reelay 0.12.0 beta · <a href={href('/changelog')}>Changelog</a></p>
    </header>
    <dl class="spec-table" data-reveal>
      {specs.map((s) => (
        <div class="spec-row">
          <dt>{s.k}</dt>
          <dd>{s.v.map((line) => <span>{line}</span>)}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .specs-head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--hairline-strong); }
  .spec-row { display: grid; gap: 0.5rem 2rem; padding: 1.5rem 0; border-bottom: 1px solid var(--hairline); }
  @media (min-width: 760px) {
    .spec-row { grid-template-columns: 15rem minmax(0, 1fr); }
  }
  .spec-row dt { font-weight: 600; font-size: 1.02rem; color: var(--r-ink); }
  .spec-row dd { display: grid; gap: 0.3rem; font-size: 1.02rem; color: var(--r-ink-2); }
</style>
