---
/**
 * DownloadSection: closing stage of the home page.
 * Multi-platform support:
 * 1. macOS (Apple Silicon): Verified release artifact (.dmg)
 * 2. Windows 10/11: Automated build pipeline (packaging/build_windows.ps1)
 * 3. Linux: Run from source with Python 3.11+
 *
 * Test hooks: #download, .download-section with the version, .download-card (3 cards),
 * and a .checksums-drawer <details> with the SHA-256.
 */
import { SITE, DOWNLOADS, href } from '../data/site';
import { RELEASE } from '../data/release';
import GatekeeperSteps from './ui/GatekeeperSteps.astro';

const apple = 'M16.4 12.6c0-2.4 2-3.6 2.1-3.6-1.1-1.7-2.9-1.9-3.5-1.9-1.5-.2-2.9.9-3.7.9-.8 0-1.9-.9-3.2-.8-1.6 0-3.1 1-4 2.4-1.7 3-.4 7.4 1.2 9.8.8 1.2 1.8 2.5 3 2.4 1.2 0 1.7-.8 3.1-.8s1.9.8 3.2.8c1.3 0 2.2-1.2 3-2.4.9-1.4 1.3-2.7 1.3-2.8 0 0-2.5-1-2.5-4zM14 5.4c.7-.8 1.1-1.9 1-3-.9 0-2.1.6-2.8 1.4-.6.7-1.2 1.8-1 2.9 1.1.1 2.1-.6 2.8-1.3z';
const windows = 'M0 3.449L9.75 2.1v9.451H0m10.949-9.602L24 0v11.4H10.949M0 12.6h9.75v9.451L0 20.699M10.949 12.6H24V24l-12.949-1.801';
---
<section id="download" class="stage download-section" aria-labelledby="dl-title">
  <div class="horizon dl-horizon" aria-hidden="true"></div>
  <div class="wrap">
    <header class="dl-head" data-reveal>
      <span class="dl-icon" aria-hidden="true">
        <svg viewBox="0 0 32 32" fill="none"><defs><linearGradient id="dlr" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#ffe2a8"/><stop offset=".5" stop-color="#f0b44c"/><stop offset="1" stop-color="#df6f3c"/></linearGradient></defs><circle cx="16" cy="16" r="9" stroke="url(#dlr)" stroke-width="2.4" stroke-linecap="round" stroke-dasharray="12.6 2.3" transform="rotate(-80 16 16)"/><path d="M14 12.6v6.8l5.4-3.4z" fill="#f5f5f7"/></svg>
      </span>
      <h2 id="dl-title" class="headline">Your videos.<br /><span class="text-glow">Ready to go anywhere.</span></h2>
      <p class="lede">Reelay Studio {SITE.version}. Free while it’s in beta, and no account to create.</p>
    </header>

    <div class="download-cards-grid" data-reveal>
      <!-- macOS Card (Primary / Verified Release Artifact) -->
      <div class="download-card download-card--featured">
        <div class="dc-badge dc-badge--verified">{DOWNLOADS.macArm.badge}</div>
        <span class="dc-glyph" aria-hidden="true"><svg viewBox="0 0 24 24"><path fill="currentColor" d={apple} /></svg></span>
        <h3 class="dc-title">{DOWNLOADS.macArm.platform}</h3>
        <p class="dc-req">{DOWNLOADS.macArm.arch}</p>
        <p class="dc-specs">{DOWNLOADS.macArm.requirements}</p>
        <a class="btn btn-primary btn-lg dc-btn" href={DOWNLOADS.macArm.href}>Download for Mac</a>
        <p class="dc-meta">{DOWNLOADS.macArm.filename} · {DOWNLOADS.macArm.size}</p>
      </div>

      <!-- Windows Card (Automated Build Pipeline) -->
      <div class="download-card">
        <div class="dc-badge">{DOWNLOADS.windows.badge}</div>
        <span class="dc-glyph" aria-hidden="true"><svg viewBox="0 0 24 24"><path fill="currentColor" d={windows} /></svg></span>
        <h3 class="dc-title">{DOWNLOADS.windows.platform}</h3>
        <p class="dc-req">{DOWNLOADS.windows.arch}</p>
        <p class="dc-specs">{DOWNLOADS.windows.requirements}</p>
        <a class="btn btn-secondary btn-lg dc-btn" href={DOWNLOADS.windows.href}>{DOWNLOADS.windows.label}</a>
        <p class="dc-meta font-mono"><code>{DOWNLOADS.windows.pipelineScript}</code></p>
      </div>

      <!-- Linux Card (Run from Source) -->
      <div class="download-card">
        <div class="dc-badge">{DOWNLOADS.linux.badge}</div>
        <span class="dc-glyph" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="4 17 10 11 4 5"></polyline>
            <line x1="12" y1="19" x2="20" y2="19"></line>
          </svg>
        </span>
        <h3 class="dc-title">{DOWNLOADS.linux.platform}</h3>
        <p class="dc-req">{DOWNLOADS.linux.arch}</p>
        <p class="dc-specs">{DOWNLOADS.linux.requirements}</p>
        <a class="btn btn-secondary btn-lg dc-btn" href={DOWNLOADS.linux.href}>{DOWNLOADS.linux.label}</a>
        <p class="dc-meta font-mono"><code>{DOWNLOADS.linux.pipelineScript}</code></p>
      </div>
    </div>

    <div class="dl-center-link" data-reveal>
      <a class="link-more" href={href('/download')}>Release notes, platform setup guides, and uninstall instructions →</a>
    </div>

    <div class="dl-notes" data-reveal>
      <GatekeeperSteps compact />
      <details class="checksums-drawer">
        <summary class="checksums-summary">Verify your download</summary>
        <div class="checksums-content">
          <p>Compare the SHA-256 of the file you downloaded with ours. In Terminal:</p>
          <pre><code>shasum -a 256 ~/Downloads/{RELEASE.filename}</code></pre>
          <p class="sha"><span>{RELEASE.filename}</span><code>{RELEASE.sha256}</code></p>
        </div>
      </details>
      <p class="fine">Only import and republish media you own or have permission to manage.</p>
    </div>
  </div>
</section>

<style>
  .download-section { overflow: clip; text-align: center; padding-bottom: clamp(7rem, 12vw, 10rem); }
  .dl-horizon { bottom: -8%; height: 60%; opacity: 0.9; }
  .dl-head { display: flex; flex-direction: column; align-items: center; }
  .dl-icon {
    display: grid;
    place-items: center;
    width: 5.5rem;
    height: 5.5rem;
    margin-bottom: 2rem;
    border-radius: 24px;
    background: linear-gradient(180deg, #2c2c30, #0c0c0e);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.18), 0 0 0 1px rgba(255, 255, 255, 0.08), 0 30px 80px var(--r-glow-1);
  }
  .dl-icon svg { width: 3.6rem; height: 3.6rem; }
  .dl-head .lede { margin: 1.5rem auto 0; }

  /* 3-Card Balanced Grid */
  .download-cards-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    text-align: center;
  }
  @media (max-width: 960px) {
    .download-cards-grid {
      grid-template-columns: 1fr;
      max-width: 28rem;
      margin-left: auto;
      margin-right: auto;
    }
  }

  .download-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.65rem;
    padding: clamp(1.8rem, 3vw, 2.4rem) 1.5rem;
    border-radius: var(--radius-xl);
    background: var(--r-panel);
    border: 1px solid var(--hairline);
    box-shadow: var(--r-panel-shadow);
    position: relative;
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }
  .download-card:hover {
    transform: translateY(-2px);
    border-color: rgba(255, 255, 255, 0.22);
    box-shadow: 0 20px 55px rgba(0, 0, 0, 0.6);
  }
  .download-card--featured {
    border-color: rgba(240, 180, 76, 0.35);
    background: linear-gradient(180deg, rgba(240, 180, 76, 0.06) 0%, var(--r-panel) 35%);
  }

  .dc-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
    background: var(--r-fill-2);
    color: var(--r-ink-3);
    border: 1px solid var(--hairline);
  }
  .dc-badge--verified {
    background: var(--r-amber-soft);
    color: var(--r-amber-text);
    border-color: rgba(240, 180, 76, 0.3);
  }

  .dc-glyph {
    display: grid;
    place-items: center;
    width: 3.2rem;
    height: 3.2rem;
    margin-top: 0.5rem;
    color: var(--r-ink);
  }
  .dc-glyph svg { width: 2.4rem; height: 2.4rem; }
  .dc-title { font-size: 1.35rem; font-weight: 700; color: var(--r-ink); margin: 0; }
  .dc-req { font-size: 0.95rem; font-weight: 600; color: var(--r-ink-2); margin: 0; }
  .dc-specs { font-size: 0.8rem; color: var(--r-ink-3); margin-bottom: 0.5rem; min-height: 1.3rem; }
  .dc-btn { width: 100%; justify-content: center; min-height: 44px; margin-top: auto; }
  .dc-meta { font-size: 0.78rem; color: var(--r-ink-4); overflow-wrap: anywhere; margin-top: 0.25rem; }
  .dc-meta code { font-size: 0.76rem; color: var(--r-amber-text); }

  .dl-center-link { margin-top: 2rem; }

  .dl-notes { max-width: 46rem; margin: clamp(3rem, 6vw, 4.5rem) auto 0; display: grid; gap: 1.5rem; text-align: left; }
  .checksums-drawer { border-top: 1px solid var(--hairline); border-bottom: 1px solid var(--hairline); }
  .checksums-summary { display: flex; align-items: center; justify-content: space-between; min-height: 56px; cursor: pointer; list-style: none; font-weight: 600; color: var(--r-ink); }
  .checksums-summary::-webkit-details-marker { display: none; }
  .checksums-summary::after { content: '+'; font-size: 1.4rem; font-weight: 300; color: var(--r-ink-3); transition: transform 0.3s var(--r-ease); }
  .checksums-drawer[open] .checksums-summary::after { transform: rotate(45deg); }
  .checksums-content { padding-bottom: 1.5rem; font-size: 0.92rem; }
  .checksums-content pre { margin: 0.75rem 0 1.25rem; padding: 0.9rem 1rem; border-radius: 12px; background: var(--r-code-bg); overflow-x: auto; font-size: 0.82rem; color: var(--r-ink); }
  .sha { display: grid; gap: 0.25rem; }
  .sha span { font-family: var(--font-mono); font-size: 0.82rem; color: var(--r-ink); }
  .sha code { font-size: 0.82rem; color: var(--r-amber-text); overflow-wrap: anywhere; }
</style>
