---
import SectionHeader from '@andrew/ui/SectionHeader.astro';
import { SITE, DOWNLOADS } from '../data/site';
---

<section class="section download-section" id="download" aria-labelledby="download-heading">
  <div class="container">
    <SectionHeader
      index="05"
      kicker="COMPATIBILITY & INSTALLERS"
      title="Download Reelay Studio"
      lede={`Current Release: ${SITE.version} • Built natively for Apple Silicon. Zero cloud tracking or remote telemetry.`}
      id="download-heading"
    />

    <!-- Platform Installer Cards Grid -->
    <div class="download-cards-grid">
      <!-- macOS Apple Silicon (Primary / Verified Artifact) -->
      <div class="download-card featured">
        <div class="featured-badge">Verified Release Artifact</div>
        <div class="card-os-header">
          <div class="os-icon-wrap">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
              <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.4c.66-.82 1.11-1.96.99-3.1-.96.04-2.12.64-2.8 1.44-.6.69-1.12 1.83-1 2.93 1.08.08 2.16-.54 2.81-1.27z"/>
            </svg>
          </div>
          <div>
            <h3 class="download-os-title">macOS</h3>
            <span class="download-chip font-mono">Apple Silicon (M1–M4)</span>
          </div>
        </div>

        <p class="download-specs-note">Native ARM64 binary with Apple Metal & Neural Engine Whisper acceleration.</p>

        <div class="download-meta-table">
          <div class="meta-row">
            <span class="meta-label">Requirements</span>
            <span class="meta-val font-mono">{DOWNLOADS.macArm.requirements}</span>
          </div>
          <div class="meta-row">
            <span class="meta-label">Package Size</span>
            <span class="meta-val font-mono">{DOWNLOADS.macArm.size}</span>
          </div>
          <div class="meta-row">
            <span class="meta-label">Code Signing</span>
            <span class="meta-val font-mono text-success">{DOWNLOADS.macArm.signature}</span>
          </div>
        </div>

        <a href={DOWNLOADS.macArm.href} class="btn btn-primary btn-lg download-action-btn">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          Download .DMG (Apple Silicon)
        </a>
        <div class="file-name-meta font-mono">
          <code>{DOWNLOADS.macArm.filename}</code>
        </div>
      </div>

      <!-- macOS Intel (Build in Pipeline) -->
      <div class="download-card">
        <div class="pipeline-badge">Build Pipeline</div>
        <div class="card-os-header">
          <div class="os-icon-wrap">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
              <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.4c.66-.82 1.11-1.96.99-3.1-.96.04-2.12.64-2.8 1.44-.6.69-1.12 1.83-1 2.93 1.08.08 2.16-.54 2.81-1.27z"/>
            </svg>
          </div>
          <div>
            <h3 class="download-os-title">macOS</h3>
            <span class="download-chip font-mono">Intel (x86_64)</span>
          </div>
        </div>

        <p class="download-specs-note">Universal x86_64 architecture for Intel-powered Mac workstations.</p>

        <div class="download-meta-table">
          <div class="meta-row">
            <span class="meta-label">Requirements</span>
            <span class="meta-val font-mono">{DOWNLOADS.macIntel.requirements}</span>
          </div>
          <div class="meta-row">
            <span class="meta-label">Package Size</span>
            <span class="meta-val font-mono">{DOWNLOADS.macIntel.size}</span>
          </div>
          <div class="meta-row">
            <span class="meta-label">Build Automation</span>
            <span class="meta-val font-mono text-muted">{DOWNLOADS.macIntel.signature}</span>
          </div>
        </div>

        <a href={DOWNLOADS.macIntel.href} class="btn btn-secondary btn-lg download-action-btn" target="_blank" rel="noopener">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
          </svg>
          View Release Pipeline →
        </a>
        <div class="file-name-meta font-mono">
          <code>{DOWNLOADS.macIntel.filename}</code>
        </div>
      </div>

      <!-- Windows (Build in Pipeline) -->
      <div class="download-card">
        <div class="pipeline-badge">Build Pipeline</div>
        <div class="card-os-header">
          <div class="os-icon-wrap">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
              <path d="M0 3.449L9.75 2.1v9.451H0m10.949-9.602L24 0v11.4H10.949M0 12.6h9.75v9.451L0 20.699M10.949 12.6H24V24l-12.949-1.801"/>
            </svg>
          </div>
          <div>
            <h3 class="download-os-title">Windows</h3>
            <span class="download-chip font-mono">Windows 10 / 11 (64-bit)</span>
          </div>
        </div>

        <p class="download-specs-note">Native desktop installer with hardware DirectX 12 playback pipeline.</p>

        <div class="download-meta-table">
          <div class="meta-row">
            <span class="meta-label">Requirements</span>
            <span class="meta-val font-mono">{DOWNLOADS.windows.requirements}</span>
          </div>
          <div class="meta-row">
            <span class="meta-label">Package Size</span>
            <span class="meta-val font-mono">{DOWNLOADS.windows.size}</span>
          </div>
          <div class="meta-row">
            <span class="meta-label">Build Automation</span>
            <span class="meta-val font-mono text-muted">{DOWNLOADS.windows.signature}</span>
          </div>
        </div>

        <a href={DOWNLOADS.windows.href} class="btn btn-secondary btn-lg download-action-btn" target="_blank" rel="noopener">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
          </svg>
          View Release Pipeline →
        </a>
        <div class="file-name-meta font-mono">
          <code>{DOWNLOADS.windows.filename}</code>
        </div>
      </div>
    </div>

    <!-- First-Launch 3-Step Walkthrough -->
    <div class="first-launch-walkthrough">
      <h3 class="walkthrough-title">Three Steps to Local-First Content Operations</h3>
      <div class="walkthrough-grid">
        <div class="walkthrough-step">
          <div class="step-num font-mono">01</div>
          <h4 class="step-heading">Install & Launch</h4>
          <p class="step-desc">
            Open the downloaded disk image and drag Reelay to your Applications folder. (During the developer beta preview, right-click and select "Open" to launch).
          </p>
        </div>
        <div class="walkthrough-step">
          <div class="step-num font-mono">02</div>
          <h4 class="step-heading">Select Local Media Root</h4>
          <p class="step-desc">
            Point Reelay to your videos folder. The embedded SQLite engine indexes assets in milliseconds with zero cloud uploads.
          </p>
        </div>
        <div class="walkthrough-step">
          <div class="step-num font-mono">03</div>
          <h4 class="step-heading">Connect Direct Endpoints</h4>
          <p class="step-desc">
            Authenticate YouTube or Meta accounts via direct OAuth 2.0. Credentials seal into OS Keychain and can be wiped with one click.
          </p>
        </div>
      </div>
    </div>

    <!-- Cryptographic Integrity & Checksums Drawer -->
    <div class="checksums-section">
      <details class="checksums-drawer">
        <summary class="checksums-summary">
          <span class="summary-left">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
            <strong>Verify Cryptographic Checksums (SHA-256)</strong>
          </span>
          <span class="summary-toggle-indicator font-mono">Expand Hashes ↓</span>
        </summary>
        <div class="checksums-content">
          <p class="checksum-explainer">
            Verify the cryptographic integrity of downloaded binaries prior to installation using <code>shasum -a 256 Reelay-0.12.0-mac-arm64.dmg</code> on macOS.
          </p>
          <div class="checksum-table">
            <div class="checksum-row">
              <span class="file-label">macOS Apple Silicon (Verified):</span>
              <code class="hash-code font-mono">{DOWNLOADS.macArm.sha256}</code>
            </div>
            <div class="checksum-row">
              <span class="file-label">macOS Intel x86_64:</span>
              <span class="hash-status font-mono text-muted">{DOWNLOADS.macIntel.sha256}</span>
            </div>
            <div class="checksum-row">
              <span class="file-label">Windows 64-bit EXE:</span>
              <span class="hash-status font-mono text-muted">{DOWNLOADS.windows.sha256}</span>
            </div>
          </div>
        </div>
      </details>
    </div>

    <!-- Security & Open Source Transparency Strip -->
    <div class="download-security-notice">
      <div class="notice-col">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--brand)" stroke-width="2">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
        </svg>
        <span>Hardware Keychain Encryption • Local NVMe Storage • Zero Bundled Adware • Offline Capable</span>
      </div>
      <div class="notice-links">
        <a href={`${SITE.githubUrl}/releases`} target="_blank" rel="noopener">GitHub Releases & Full Changelog →</a>
      </div>
    </div>
  </div>
</section>

<style>
  .download-section {
    background: radial-gradient(circle at 50% 0%, rgba(229, 169, 60, 0.04) 0%, transparent 60%),
                var(--color-bg);
  }

  .download-cards-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.75rem;
    margin-top: 2.5rem;
    margin-bottom: 3.5rem;
  }

  .download-card {
    background-color: #0b0c10;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-lg);
    padding: clamp(1.85rem, 3vw, 2.35rem) 1.85rem;
    display: flex;
    flex-direction: column;
    position: relative;
    box-shadow: 0 15px 45px rgba(0, 0, 0, 0.45);
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .download-card:hover {
    transform: translateY(-2px);
    border-color: rgba(255, 255, 255, 0.22);
    box-shadow: 0 20px 55px rgba(0, 0, 0, 0.6);
  }

  .download-card.featured {
    border-color: rgba(229, 169, 60, 0.45);
    background: linear-gradient(180deg, rgba(229, 169, 60, 0.08) 0%, rgba(229, 169, 60, 0.01) 35%, #0d0e14 100%);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6), 0 0 45px rgba(229, 169, 60, 0.12);
  }

  .featured-badge {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    background-color: var(--brand);
    color: #07080a;
    font-size: 0.7rem;
    font-weight: 750;
    text-transform: uppercase;
    padding: 0.25rem 0.65rem;
    border-radius: 4px;
    letter-spacing: 0.06em;
    font-family: var(--font-mono);
  }

  .pipeline-badge {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    background-color: rgba(255, 255, 255, 0.05);
    color: var(--text-muted);
    border: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    padding: 0.25rem 0.65rem;
    border-radius: 4px;
    letter-spacing: 0.06em;
    font-family: var(--font-mono);
  }

  .card-os-header {
    display: flex;
    align-items: center;
    gap: 1.15rem;
    margin-bottom: 1.35rem;
  }

  .os-icon-wrap {
    width: 54px;
    height: 54px;
    border-radius: 12px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.08) 0%, rgba(255, 255, 255, 0.02) 100%), #14151d;
    border: 1px solid rgba(255, 255, 255, 0.14);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    flex-shrink: 0;
  }

  .download-os-title {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0;
    color: #ffffff;
  }

  .download-chip {
    font-size: 0.78rem;
    color: var(--brand-light);
  }

  .download-specs-note {
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
    min-height: 2.6rem;
  }

  .download-meta-table {
    background-color: var(--color-surface-2);
    border: 1px solid var(--hairline);
    border-radius: calc(var(--radius) - 2px);
    padding: 0.9rem 1.1rem;
    margin-bottom: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .meta-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.8rem;
    gap: 0.5rem;
  }

  .meta-label {
    color: var(--text-dim);
    flex-shrink: 0;
  }

  .meta-val {
    color: var(--text-primary);
    font-size: 0.76rem;
    text-align: right;
    word-break: break-word;
  }

  .text-success {
    color: #3ecf8e;
  }

  .download-action-btn {
    width: 100%;
    margin-bottom: 1rem;
    min-height: 48px;
    justify-content: center;
  }

  .file-name-meta {
    text-align: center;
    font-size: 0.72rem;
  }

  .file-name-meta code {
    color: var(--text-dim);
    background: transparent;
    border: none;
    padding: 0;
  }

  /* First-Launch Walkthrough */
  .first-launch-walkthrough {
    background-color: var(--color-surface);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    padding: 2.25rem;
    margin-bottom: 2.5rem;
  }

  .walkthrough-title {
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--text-primary);
    margin-bottom: 1.5rem;
    text-align: center;
  }

  .walkthrough-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.75rem;
  }

  .walkthrough-step {
    padding: 1.25rem;
    background-color: var(--color-surface-2);
    border: 1px solid var(--hairline);
    border-radius: calc(var(--radius) - 2px);
  }

  .step-num {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--brand);
    margin-bottom: 0.5rem;
  }

  .step-heading {
    font-size: 0.98rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.4rem;
  }

  .step-desc {
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--text-secondary);
    margin: 0;
  }

  /* Checksums Drawer */
  .checksums-section {
    margin-bottom: 2rem;
  }

  .checksums-drawer {
    background-color: var(--color-surface);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .checksums-summary {
    padding: 1.1rem 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    user-select: none;
    font-size: 0.92rem;
    color: var(--text-primary);
    min-height: 48px;
    list-style: none;
    outline: none;
  }

  .checksums-summary:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: -2px;
  }

  .checksums-summary::-webkit-details-marker {
    display: none;
  }

  .summary-left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .summary-left svg {
    color: var(--brand);
  }

  .summary-toggle-indicator {
    font-size: 0.78rem;
    color: var(--brand-light);
  }

  .checksums-content {
    padding: 1.25rem 1.5rem;
    border-top: 1px solid var(--hairline);
    background-color: var(--color-surface-2);
  }

  .checksum-explainer {
    font-size: 0.82rem;
    color: var(--text-secondary);
    margin-bottom: 1rem;
  }

  .checksum-table {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .checksum-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 0.65rem 0.85rem;
    background-color: var(--color-surface);
    border: 1px solid var(--hairline);
    border-radius: 4px;
    font-size: 0.78rem;
  }

  .file-label {
    font-weight: 600;
    color: var(--text-primary);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .hash-code {
    font-size: 0.72rem;
    color: var(--brand-light);
    word-break: break-all;
    background: transparent;
    border: none;
    padding: 0;
  }

  .hash-status {
    font-size: 0.75rem;
  }

  /* Notice */
  .download-security-notice {
    background-color: var(--color-surface-2);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    padding: 1.25rem 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .notice-col {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.88rem;
    color: var(--text-secondary);
  }

  .notice-links a {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--brand-light);
    white-space: nowrap;
  }

  @media (max-width: 960px) {
    .download-cards-grid,
    .walkthrough-grid {
      grid-template-columns: 1fr;
    }

    .checksum-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.25rem;
    }

    .download-security-notice {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
