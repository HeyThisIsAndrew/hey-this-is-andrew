---
/**
 * LibraryGridScene: the Library as the app draws it (reelay/gui/cards.py,
 * chrome.py, download_page.py). An image-first grid with hover-scrub
 * previews, a tile slider from Small (180) to XL (400), 24 / 48 / 96 / All
 * per page, and a Grid / List toggle. Interactive; it works without JS at
 * the defaults (Medium, 24, Grid).
 */
import AppWindow from './ui/AppWindow.astro';

const stills = ['dusk', 'neon', 'desert', 'snow', 'kitchen', 'ocean', 'forest', 'city', 'gym', 'studio', 'dusk', 'ocean', 'neon', 'desert', 'forest', 'kitchen'];
const titles = [
  'Golden hour at Big Sur', 'Tokyo after midnight', 'Desert road trip, day four', 'First snow in the Alps',
  'Three knife skills', 'Surf check at dawn', 'Sixty seconds of forest', 'Night market loop', 'Leg day, no excuses',
  'Studio light test', 'Highway 1, northbound', 'Tide pools at low tide', 'Shibuya crossing, 2 a.m.',
  'Dune ridge at sunrise', 'Rain on the canopy', 'Sourdough, start to finish',
];
const lens = ['0:22', '0:57', '0:39', '0:18', '0:48', '0:26', '1:00', '0:33', '0:31', '0:15', '0:44', '0:29', '0:52', '0:37', '0:41', '0:58'];
const items = stills.map((s, i) => ({ still: s, title: titles[i], len: lens[i], done: i % 5 !== 3 }));
const TOTAL = 213;
---
<div class="lgs" data-library-scene style="--tile:240">
  <div class="lgs-controls" aria-label="Library view controls">
    <div class="ctl">
      <span class="ctl-k" id="lgs-view-k">View</span>
      <div class="seg" role="group" aria-labelledby="lgs-view-k">
        <button type="button" aria-pressed="true" data-view="grid">Grid</button>
        <button type="button" aria-pressed="false" data-view="list">List</button>
      </div>
    </div>
    <div class="ctl ctl--grow">
      <label class="ctl-k" for="lgs-size">Tile size</label>
      <input id="lgs-size" type="range" min="180" max="400" step="20" value="240" data-size aria-valuetext="Medium, 240" />
      <span class="ctl-v" data-size-label>Medium</span>
    </div>
    <div class="ctl">
      <span class="ctl-k" id="lgs-page-k">Per page</span>
      <div class="seg" role="group" aria-labelledby="lgs-page-k">
        {[24, 48, 96, 0].map((n) => <button type="button" aria-pressed={n === 24 ? 'true' : 'false'} data-page={n}>{n ? n : 'All'}</button>)}
      </div>
    </div>
  </div>

  <div class="scale-stage">
    <div class="lscene">
      <AppWindow title="Reelay: Library" label="Reelay's Library: a grid of video covers with hover-scrub previews, a tile size control, page size and a Grid or List toggle.">
        <div class="lbody">
          <div class="lhead">
            <span class="lname">Library</span>
            <span class="lsearch">Search captions, hashtags, your names and file names</span>
            <span class="lcount" data-count>1–24 of {TOTAL}</span>
          </div>
          <ul class="lgrid" data-grid>
            {items.map((it) => (
              <li class="ltile" data-tile>
                <span class={`cover still still--${it.still}`} style="--scrub:0.5">
                  <span class="len">{it.len}</span>
                  <span class="scrubbar" aria-hidden="true"><i></i></span>
                </span>
                <span class="meta">
                  <span class="t">{it.title}</span>
                  <span class:list={['s', { ok: it.done }]}>{it.done ? '✓ Downloaded' : 'Not downloaded'}</span>
                </span>
              </li>
            ))}
          </ul>
          <div class="lfoot"><span class="pbtn">Previous</span><span data-pages>Page 1 of 9</span><span class="pbtn">Next</span></div>
        </div>
      </AppWindow>
    </div>
  </div>
  <p class="lgs-note">Interactive illustration. Try the controls, and hover a downloaded cover to scrub through it.</p>
</div>

<style>
  /* Three controls: one row, or one column. Never two and one. */
  .lgs { container-type: inline-size; }
  .lgs-controls {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }
  @container (min-width: 720px) {
    .lgs-controls { grid-template-columns: auto minmax(0, 1fr) auto; gap: 1.5rem; }
  }
  .ctl { display: flex; align-items: center; gap: 0.6rem; }
  .ctl--grow input { width: min(220px, 40vw); height: 32px; accent-color: var(--r-amber); }
  .ctl-k { font-size: 0.85rem; font-weight: 600; color: var(--r-ink-2); }
  .ctl-v { min-width: 4.5rem; font-size: 0.85rem; color: var(--r-ink-3); }
  .seg { display: inline-flex; padding: 3px; border-radius: 999px; background: var(--r-fill-2); }
  .seg button { min-height: 36px; min-width: 44px; padding: 0 0.8rem; border: 0; border-radius: 999px; background: none; color: var(--r-ink-2); font-size: 0.85rem; font-weight: 500; cursor: pointer; }
  .seg button[aria-pressed='true'] { background: var(--r-ink); color: var(--r-on-ink); }
  .lgs-note { margin-top: 1rem; font-size: 0.82rem; color: var(--r-ink-4); text-align: center; }

  .scale-stage { container-type: inline-size; width: 100%; }
  .lscene { font-size: calc(100cqw / 64); }
  .lbody { background: var(--app-bg); color: var(--app-ink); padding: 0.9em 1em; height: 34em; display: flex; flex-direction: column; }
  .lhead { display: flex; align-items: center; gap: 0.8em; margin-bottom: 0.9em; }
  .lname { font-size: 1.15em; font-weight: 700; letter-spacing: -0.02em; }
  .lsearch { flex: 1; height: 2.1em; display: flex; align-items: center; padding: 0 0.8em; border-radius: 0.6em; background: var(--app-raised); box-shadow: inset 0 0 0 0.0625em var(--app-border); font-size: 0.74em; color: var(--app-muted); white-space: nowrap; overflow: hidden; }
  .lcount { font-size: 0.72em; color: var(--app-ink-2); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .lgrid {
    flex: 1;
    min-height: 0;
    overflow: hidden;
    list-style: none;
    display: grid;
    /* the app's tile size, in its points; 20 points = 1em in this scene */
    grid-template-columns: repeat(auto-fill, minmax(calc(var(--tile) / 20 * 1em), 1fr));
    grid-auto-rows: max-content;
    gap: 0.7em;
    align-content: start;
  }
  .ltile { border-radius: 0.6em; overflow: hidden; background: var(--app-surface); box-shadow: 0 0 0 0.0625em var(--app-border); }
  .cover {
    display: block;
    aspect-ratio: 4 / 5;
    background-size: 260% 100% !important;
    background-position: calc(var(--scrub) * 100%) 50% !important;
    transition: background-position 0.08s linear;
  }
  .len { position: absolute; z-index: 1; right: 0.4em; bottom: 0.4em; font-size: 0.6em; font-weight: 600; padding: 0.15em 0.4em; border-radius: 0.3em; background: rgba(0, 0, 0, 0.6); color: #fff; }
  .scrubbar { position: absolute; z-index: 1; left: 0; right: 0; bottom: 0; height: 0.2em; background: rgba(255, 255, 255, 0.25); opacity: 0; transition: opacity 0.2s ease; }
  .scrubbar i { display: block; height: 100%; width: calc(var(--scrub) * 100%); background: #fff; }
  .ltile.is-scrub .scrubbar { opacity: 1; }
  .meta { display: grid; gap: 0.2em; padding: 0.45em 0.55em 0.55em; }
  .t { font-size: 0.66em; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .s { font-size: 0.56em; color: var(--app-muted); }
  .s.ok { color: var(--app-ok); }
  .lfoot { display: flex; align-items: center; justify-content: center; gap: 1em; padding-top: 0.7em; font-size: 0.7em; color: var(--app-ink-2); }
  .pbtn { padding: 0.35em 0.8em; border-radius: 0.5em; background: var(--app-raised); color: var(--app-ink); }

  /* List view */
  .is-list .lgrid { grid-template-columns: 1fr; gap: 0; }
  .is-list .ltile { display: grid; grid-template-columns: 2.2em minmax(0, 1fr); align-items: center; gap: 0.7em; padding: 0.3em 0.5em; border-radius: 0; box-shadow: inset 0 -0.0625em 0 var(--app-border); background: transparent; }
  .is-list .cover { width: 2.2em; aspect-ratio: 3 / 4; border-radius: 0.3em; }
  .is-list .len, .is-list .scrubbar { display: none; }
  .is-list .meta { grid-template-columns: minmax(0, 1fr) 7em; align-items: center; padding: 0; }
  .is-list .t { font-size: 0.72em; }

  @container (max-width: 560px) {
    .lscene { font-size: calc(100cqw / 30); }
    .lsearch { display: none; }
  }
</style>

<script>
  const NAMES: [number, string][] = [[180, 'Small'], [240, 'Medium'], [320, 'Large'], [400, 'XL']];
  const TOTAL = 213;
  document.querySelectorAll<HTMLElement>('[data-library-scene]').forEach((root) => {
    const size = root.querySelector<HTMLInputElement>('[data-size]')!;
    const sizeLabel = root.querySelector<HTMLElement>('[data-size-label]')!;
    const count = root.querySelector<HTMLElement>('[data-count]')!;
    const pages = root.querySelector<HTMLElement>('[data-pages]')!;
    const scene = root.querySelector<HTMLElement>('.lscene')!;
    const nameFor = (v: number) => NAMES.reduce((best, n) => (Math.abs(n[0] - v) < Math.abs(best[0] - v) ? n : best))[1];

    size.addEventListener('input', () => {
      const v = Number(size.value);
      root.style.setProperty('--tile', String(v));
      sizeLabel.textContent = nameFor(v);
      size.setAttribute('aria-valuetext', `${nameFor(v)}, ${v}`);
    });
    root.querySelectorAll<HTMLButtonElement>('[data-view]').forEach((b) => b.addEventListener('click', () => {
      root.querySelectorAll('[data-view]').forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
      scene.classList.toggle('is-list', b.dataset.view === 'list');
    }));
    root.querySelectorAll<HTMLButtonElement>('[data-page]').forEach((b) => b.addEventListener('click', () => {
      root.querySelectorAll('[data-page]').forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
      const n = Number(b.dataset.page);
      count.textContent = n ? `1–${n} of ${TOTAL}` : `All ${TOTAL}`;
      pages.textContent = n ? `Page 1 of ${Math.ceil(TOTAL / n)}` : 'One page';
    }));
    // Hover-scrub: the cover follows the pointer across the tile.
    root.querySelectorAll<HTMLElement>('[data-tile]').forEach((tile) => {
      const cover = tile.querySelector<HTMLElement>('.cover')!;
      if (!tile.querySelector('.s.ok')) return;
      tile.addEventListener('pointermove', (e) => {
        const r = cover.getBoundingClientRect();
        const f = Math.min(1, Math.max(0, (e.clientX - r.left) / r.width));
        cover.style.setProperty('--scrub', f.toFixed(3));
        tile.classList.add('is-scrub');
      });
      tile.addEventListener('pointerleave', () => { cover.style.setProperty('--scrub', '0.5'); tile.classList.remove('is-scrub'); });
    });
  });
</script>
