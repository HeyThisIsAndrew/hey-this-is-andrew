---
/**
 * InteractiveWorkflow.astro: End-to-End Publishing Demonstration
 * Proves core product value through a 4-stage interactive creator journey:
 * 1. Find & Ingest → 2. Prepare & Format → 3. Review & Gate → 4. Publish & Handoff
 *
 * Full keyboard navigation (W3C APG Tablist pattern), ARIA compliance,
 * reduced-motion support, no-JS progressive disclosure, and explicit simulation disclosure.
 */
import SectionHeader from '@andrew/ui/SectionHeader.astro';

const steps = [
  {
    id: 'step-find',
    num: '01',
    label: 'Find & Ingest',
    kicker: 'LOCAL ARCHIVE & TRANSCRIPTS',
    headline: 'Locate the exact moment without hunting through folders.',
    desc: 'Select a clip from your local library. Reelay immediately reads resolution, duration, and hardware proxies, while on-device Whisper AI indexes spoken words into local SQLite full-text search.',
    meta: [
      { k: 'Resolution', v: '1080 × 1920 (9:16 Vertical)' },
      { k: 'Duration', v: '00:58.24' },
      { k: 'Codec', v: 'VP9 / AV1 Hardware Proxy' },
      { k: 'Transcript', v: 'Indexed via local SQLite FTS5' },
    ],
    previewType: 'find',
  },
  {
    id: 'step-prepare',
    num: '02',
    label: 'Prepare & Format',
    kicker: 'KANBAN STAGING & TEMPLATES',
    headline: 'Format copy for multiple platforms in a single stroke.',
    desc: 'The clip enters the staging pipeline. Deterministic local automation rules populate tailored captions from {hook}, {caption}, and {hashtags} tokens without overwriting your manual edits.',
    meta: [
      { k: 'YouTube Shorts', v: 'Title + Description + #shorts' },
      { k: 'Instagram Reels', v: 'Caption + First Comment Hashtags' },
      { k: 'TikTok', v: 'Hook + Trend Audio Marker' },
      { k: 'Threads', v: 'Micro-copy + Link Reference' },
    ],
    previewType: 'prepare',
  },
  {
    id: 'step-review',
    num: '03',
    label: 'Review & Gate',
    kicker: 'HUMAN-IN-THE-LOOP SAFETY',
    headline: 'Review platform readiness before anything goes live.',
    desc: 'The Coverage Map verifies aspect ratios, thumbnail covers, and character limits. Destructive actions trigger durable SQLite approval requests—an AI assistant or automation cannot publish without explicit sign-off.',
    meta: [
      { k: 'Aspect Ratios', v: 'Verified (9:16 compliant)' },
      { k: 'Character Limits', v: 'All platforms within bounds' },
      { k: 'Custom Cover', v: 'Frame 00:04.12 Selected' },
      { k: 'Safety Gate', v: 'Awaiting Physical Creator Sign-off' },
    ],
    previewType: 'review',
  },
  {
    id: 'step-publish',
    num: '04',
    label: 'Publish & Handoff',
    kicker: 'DIRECT PLATFORM DISPATCH',
    headline: 'Direct HTTPS publishing or one-click native handoff.',
    desc: 'When authorized, Reelay connects directly from your workstation to YouTube and Meta APIs via TLS 1.3. For platforms with posting restrictions, our Prepare to Publish tray exports copy and video instantly.',
    meta: [
      { k: 'YouTube Upload', v: 'Direct OAuth HTTPS • Status: 200 OK' },
      { k: 'Instagram Graph', v: 'Direct HTTPS • Container Published' },
      { k: 'TikTok Flow', v: 'Prepare-to-Publish Export Tray' },
      { k: 'Credentials', v: 'Safely locked in OS Keychain' },
    ],
    previewType: 'publish',
  },
];
---

<section class="section interactive-workflow-section" id="interactive-workflow" aria-labelledby="workflow-heading">
  <div class="container">
    <SectionHeader
      index="01"
      kicker="END-TO-END PUBLISHING DEMONSTRATION"
      title="How Reelay Works: From Raw Clip to Live Release"
      lede="See how a video moves from your local hard drive to published status across YouTube, TikTok, and Instagram in four deterministic steps."
      id="workflow-heading"
    />

    <!-- Notice clarifying simulation context -->
    <div class="workflow-simulation-disclaimer">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="12" y1="16" x2="12" y2="12"></line>
        <line x1="12" y1="8" x2="12.01" y2="8"></line>
      </svg>
      <span>Interactive Demonstration: Simulates desktop application lifecycle states. No live network transmissions occur on this page.</span>
    </div>

    <!-- Interactive Stage Wrapper -->
    <div class="workflow-stage-container" data-workflow-container>
      <!-- Navigation Step Tabs -->
      <div class="workflow-tabs-bar" role="tablist" aria-label="Publishing Workflow Stages">
        {steps.map((s, idx) => (
          <button
            type="button"
            class:list={['workflow-step-tab', { active: idx === 0 }]}
            role="tab"
            id={`tab-${s.id}`}
            aria-selected={idx === 0 ? 'true' : 'false'}
            aria-controls={`panel-${s.id}`}
            tabindex={idx === 0 ? 0 : -1}
            data-step-target={s.id}
            data-step-index={idx}
          >
            <span class="tab-step-num font-mono">{s.num}</span>
            <span class="tab-step-label">{s.label}</span>
            <span class="active-indicator" aria-hidden="true"></span>
          </button>
        ))}
      </div>

      <!-- Stage Detail Panels -->
      <div class="workflow-panels-wrap">
        {steps.map((s, idx) => (
          <div
            id={`panel-${s.id}`}
            class:list={['workflow-panel', { active: idx === 0 }]}
            role="tabpanel"
            aria-labelledby={`tab-${s.id}`}
            hidden={idx !== 0}
            data-panel-id={s.id}
          >
            <div class="workflow-split-layout">
              <!-- Left Column: Architectural Explanation -->
              <div class="workflow-narrative">
                <div class="workflow-panel-kicker font-mono">{s.kicker}</div>
                <h3 class="workflow-panel-title">{s.headline}</h3>
                <p class="workflow-panel-desc">{s.desc}</p>

                <!-- Technical Properties Card -->
                <div class="workflow-meta-card">
                  <div class="meta-card-head font-mono">STAGE 0{idx + 1} SPECIFICATIONS</div>
                  <div class="meta-rows-list">
                    {s.meta.map(m => (
                      <div class="meta-row-item">
                        <span class="meta-k">{m.k}:</span>
                        <span class="meta-v font-mono">{m.v}</span>
                      </div>
                    ))}
                  </div>
                </div>
              </div>

              <!-- Right Column: Simulated Desktop UI Box -->
              <div class="workflow-simulation">
                <!-- Step 1 Simulation: Find & Ingest -->
                {s.previewType === 'find' && (
                  <div class="sim-display-box">
                    <div class="sim-box-titlebar">
                      <span class="font-mono text-xs">LOCAL LIBRARY • ASSET INSPECTION</span>
                      <span class="sim-badge">Simulated Desktop UI</span>
                    </div>
                    <div class="sim-clip-card">
                      <div class="clip-thumb-preview">
                        <div class="thumb-phone">
                          <div class="thumb-waveform" aria-hidden="true">
                            <span></span><span></span><span></span><span></span><span></span>
                          </div>
                          <span class="thumb-text font-mono">00:58</span>
                        </div>
                      </div>
                      <div class="clip-details">
                        <div class="clip-name font-mono">2026-10-interview-clip-04.mp4</div>
                        <div class="clip-tags font-mono text-xs text-muted">1080x1920 • 60 FPS • ProRes Proxy Cached</div>
                        <div class="clip-transcript-snippet">
                          <span class="ts-time font-mono">00:12</span>
                          <span class="ts-highlight">"...stop organizing content in Google Sheets when you can own the database..."</span>
                        </div>
                      </div>
                    </div>
                    <div class="sim-status-row font-mono">
                      <span>✓ Whisper AI Transcription: 100% On-Device</span>
                      <span class="text-brand">Ready for Pipeline</span>
                    </div>
                  </div>
                )}

                <!-- Step 2 Simulation: Prepare & Format -->
                {s.previewType === 'prepare' && (
                  <div class="sim-display-box">
                    <div class="sim-box-titlebar">
                      <span class="font-mono text-xs">KANBAN STAGING • AUTOMATION TEMPLATES</span>
                      <span class="sim-badge">Simulated Desktop UI</span>
                    </div>
                    <div class="sim-template-box">
                      <div class="template-pill-row">
                        <span class="pill-token">{'{hook}'}</span>
                        <span class="pill-token">{'{caption}'}</span>
                        <span class="pill-token">{'{hashtags}'}</span>
                      </div>
                      <div class="template-preview-output font-mono">
                        <div class="output-row">
                          <span class="platform-name">YouTube Shorts:</span>
                          <span class="output-text">"Stop organizing in sheets. Local-first studio. #shorts #creator"</span>
                        </div>
                        <div class="output-row">
                          <span class="platform-name">Instagram Reels:</span>
                          <span class="output-text">"Stop organizing in sheets. Full local custody. @BeUnconventional"</span>
                        </div>
                      </div>
                    </div>
                    <div class="sim-status-row font-mono">
                      <span>✓ Rules Gate: No manual copy overwritten</span>
                      <span class="text-brand">Staged in Column 03</span>
                    </div>
                  </div>
                )}

                <!-- Step 3 Simulation: Review & Gate -->
                {s.previewType === 'review' && (
                  <div class="sim-display-box">
                    <div class="sim-box-titlebar">
                      <span class="font-mono text-xs">SCOPED PIPELINE • SAFETY VERIFICATION</span>
                      <span class="sim-badge">Simulated Desktop UI</span>
                    </div>
                    <div class="sim-gate-container">
                      <div class="coverage-check-list">
                        <div class="check-item verified">
                          <span class="check-icon">✓</span>
                          <span>YouTube Shorts: 9:16 aspect ratio valid (1080x1920)</span>
                        </div>
                        <div class="check-item verified">
                          <span class="check-icon">✓</span>
                          <span>Instagram Reels: Character count 248 / 2200 compliant</span>
                        </div>
                        <div class="check-item verified">
                          <span class="check-icon">✓</span>
                          <span>TikTok: Prepare-to-Publish clipboard bundle ready</span>
                        </div>
                      </div>
                      <div class="gate-signoff-bar">
                        <span class="font-mono text-xs">CREATOR SIGNOFF GATE</span>
                        <div class="gate-btns">
                          <span class="btn btn-primary btn-sm btn-simulated">Approve & Dispatch</span>
                        </div>
                      </div>
                    </div>
                    <div class="sim-status-row font-mono">
                      <span>Security: Durable SQLite approval request row</span>
                      <span class="text-brand">Physical Approval Required</span>
                    </div>
                  </div>
                )}

                <!-- Step 4 Simulation: Publish & Handoff -->
                {s.previewType === 'publish' && (
                  <div class="sim-display-box">
                    <div class="sim-box-titlebar">
                      <span class="font-mono text-xs">DISPATCH LOGS • DIRECT TLS 1.3 CLIENT</span>
                      <span class="sim-badge">Simulated Desktop UI</span>
                    </div>
                    <div class="sim-publish-logs font-mono">
                      <div class="log-line success">
                        <span>[16:04:12]</span> POST /youtube/v3/videos: 200 OK (Upload Complete)
                      </div>
                      <div class="log-line success">
                        <span>[16:04:14]</span> POST /graph.facebook.com: 200 OK (Reels Published)
                      </div>
                      <div class="log-line info">
                        <span>[16:04:15]</span> TikTok Handoff: Media & Copy exported to QuickShare tray
                      </div>
                      <div class="log-line success">
                        <span>[16:04:16]</span> SQLite app.db: Card moved to 'Published' column
                      </div>
                    </div>
                    <div class="sim-status-row font-mono">
                      <span>Direct Connection: Client-to-API from local IP</span>
                      <span class="text-brand">Complete</span>
                    </div>
                  </div>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- Accessible APG Tablist Script with Keyboard Handling -->
<script>
  function initWorkflowStepper() {
    const container = document.querySelector('[data-workflow-container]');
    if (!container) return;

    // Mark as JS-enabled
    container.classList.add('js-enabled');

    const tabs = Array.from(container.querySelectorAll('.workflow-step-tab'));
    const panels = Array.from(container.querySelectorAll('.workflow-panel'));

    function selectTab(index: number, focus = true) {
      if (index < 0 || index >= tabs.length) return;

      tabs.forEach((tab, i) => {
        const isSelected = i === index;
        tab.classList.toggle('active', isSelected);
        tab.setAttribute('aria-selected', isSelected ? 'true' : 'false');
        tab.setAttribute('tabindex', isSelected ? '0' : '-1');
        if (isSelected && focus) {
          (tab as HTMLElement).focus();
        }
      });

      panels.forEach((panel, i) => {
        const isSelected = i === index;
        panel.classList.toggle('active', isSelected);
        panel.hidden = !isSelected;
      });
    }

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => {
        selectTab(index, false);
      });

      tab.addEventListener('keydown', (e: KeyboardEvent) => {
        let newIndex = index;
        if (e.key === 'ArrowRight') {
          newIndex = (index + 1) % tabs.length;
          e.preventDefault();
        } else if (e.key === 'ArrowLeft') {
          newIndex = (index - 1 + tabs.length) % tabs.length;
          e.preventDefault();
        } else if (e.key === 'Home') {
          newIndex = 0;
          e.preventDefault();
        } else if (e.key === 'End') {
          newIndex = tabs.length - 1;
          e.preventDefault();
        } else if (e.key === 'Enter' || e.key === ' ') {
          newIndex = index;
          e.preventDefault();
        } else {
          return;
        }
        selectTab(newIndex, true);
      });
    });
  }

  initWorkflowStepper();
  document.addEventListener('astro:page-load', initWorkflowStepper);
</script>

<style>
  .interactive-workflow-section {
    padding-top: clamp(3.5rem, 6vw, 6rem);
    padding-bottom: clamp(3.5rem, 6vw, 6rem);
    border-bottom: 1px solid var(--hairline);
    background-color: rgba(255, 255, 255, 0.015);
    position: relative;
  }

  .workflow-simulation-disclaimer {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    font-size: 0.8rem;
    color: var(--text-muted);
    background-color: var(--color-surface);
    border: 1px solid var(--hairline);
    padding: 0.45rem 0.9rem;
    border-radius: var(--radius);
    margin-top: 1rem;
    margin-bottom: 2rem;
  }

  .workflow-simulation-disclaimer svg {
    color: var(--brand);
    flex-shrink: 0;
  }

  .workflow-stage-container {
    background-color: #0c0d13;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.65), inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }

  /* Navigation Tabs Bar */
  .workflow-tabs-bar {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    background-color: #12131a;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .workflow-step-tab {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 1.15rem 1rem;
    background: transparent;
    border: none;
    border-right: 1px solid rgba(255, 255, 255, 0.08);
    cursor: pointer;
    color: var(--text-muted);
    font-size: 0.9rem;
    font-weight: 600;
    font-family: var(--font-display);
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
    position: relative;
    min-height: 48px;
    outline: none;
  }

  .workflow-step-tab:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: -2px;
    z-index: 2;
  }

  .workflow-step-tab:last-child {
    border-right: none;
  }

  .workflow-step-tab:hover {
    background-color: rgba(255, 255, 255, 0.04);
    color: var(--text-primary);
  }

  .workflow-step-tab.active {
    background-color: var(--color-surface);
    color: #ffffff;
    font-weight: 700;
  }

  .workflow-step-tab .active-indicator {
    display: none;
    position: absolute;
    bottom: -1px;
    left: 0;
    right: 0;
    height: 3px;
    background-color: var(--brand);
    box-shadow: 0 0 12px rgba(229, 169, 60, 0.7);
  }

  .workflow-step-tab.active .active-indicator {
    display: block;
  }

  .tab-step-num {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--text-muted);
    background-color: rgba(255, 255, 255, 0.06);
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    border: 1px solid var(--hairline);
  }

  .workflow-step-tab.active .tab-step-num {
    color: #090a0d;
    background-color: var(--brand);
    border-color: var(--brand);
  }

  /* Panels */
  .workflow-panels-wrap {
    position: relative;
  }

  .workflow-panel {
    display: block;
    animation: fadeIn 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .workflow-panel[hidden] {
    display: none;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(3px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .workflow-split-layout {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 2.5rem;
    padding: clamp(1.75rem, 3.5vw, 3rem);
    align-items: start;
  }

  /* Narrative */
  .workflow-narrative {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .workflow-panel-kicker {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--brand);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .workflow-panel-title {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.4vw, 1.95rem);
    font-weight: 700;
    color: #ffffff;
    line-height: 1.25;
    letter-spacing: -0.03em;
  }

  .workflow-panel-desc {
    font-size: 0.96rem;
    color: var(--text-secondary);
    line-height: 1.65;
  }

  /* Meta Card */
  .workflow-meta-card {
    background-color: rgba(255, 255, 255, 0.025);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius);
    padding: 1.25rem;
    margin-top: 0.5rem;
  }

  .meta-card-head {
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: 0.1em;
    margin-bottom: 0.85rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--hairline);
  }

  .meta-rows-list {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .meta-row-item {
    display: flex;
    justify-content: space-between;
    font-size: 0.82rem;
    gap: 1rem;
  }

  .meta-k {
    color: var(--text-muted);
  }

  .meta-v {
    color: #ffffff;
    font-weight: 600;
    text-align: right;
  }

  /* Right Simulation Box */
  .workflow-simulation {
    display: flex;
    flex-direction: column;
  }

  .sim-display-box {
    background-color: #0b0c10;
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
  }

  .sim-box-titlebar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--text-muted);
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--hairline);
  }

  .sim-badge {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    background-color: rgba(255, 255, 255, 0.08);
    color: var(--text-secondary);
    padding: 0.15rem 0.45rem;
    border-radius: 3px;
    border: 1px solid var(--hairline);
  }

  /* Step 1 Clip Card */
  .sim-clip-card {
    background-color: var(--color-surface);
    border: 1px solid var(--hairline);
    border-radius: 6px;
    padding: 1rem;
    display: flex;
    gap: 1.25rem;
    align-items: center;
  }

  .clip-thumb-preview {
    width: 70px;
    height: 100px;
    background: linear-gradient(180deg, #1f202a 0%, #121318 100%);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .thumb-phone {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    text-align: center;
    padding: 0.35rem;
  }

  .thumb-waveform {
    display: flex;
    align-items: flex-end;
    gap: 2.5px;
    height: 22px;
  }

  .thumb-waveform span {
    width: 2.5px;
    background-color: var(--brand);
    border-radius: 1px;
    display: inline-block;
  }

  .thumb-waveform span:nth-child(1) { height: 10px; }
  .thumb-waveform span:nth-child(2) { height: 18px; }
  .thumb-waveform span:nth-child(3) { height: 22px; }
  .thumb-waveform span:nth-child(4) { height: 14px; }
  .thumb-waveform span:nth-child(5) { height: 8px; }

  .thumb-text {
    font-size: 0.65rem;
    color: var(--text-muted);
  }

  .clip-details {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 0;
  }

  .clip-name {
    font-size: 0.88rem;
    color: #ffffff;
    word-break: break-all;
  }

  .clip-transcript-snippet {
    margin-top: 0.4rem;
    background-color: var(--color-surface-2);
    border-left: 2px solid var(--brand);
    padding: 0.4rem 0.6rem;
    border-radius: 3px;
    font-size: 0.75rem;
    display: flex;
    gap: 0.5rem;
  }

  .ts-time {
    color: var(--brand);
  }

  .ts-highlight {
    color: var(--text-primary);
  }

  /* Step 2 Template Box */
  .sim-template-box {
    background-color: var(--color-surface);
    border: 1px solid var(--hairline);
    border-radius: 6px;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .template-pill-row {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .pill-token {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--brand);
    background-color: var(--brand-dim);
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
    border: 1px solid rgba(229, 169, 60, 0.3);
  }

  .template-preview-output {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    font-size: 0.8rem;
    background-color: #0b0c10;
    padding: 0.85rem;
    border-radius: 4px;
  }

  .output-row {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .platform-name {
    color: var(--text-muted);
    font-size: 0.72rem;
  }

