---
// Apple Pro Performance & Spec Strip
const metrics = [
  {
    value: "60 FPS",
    unit: "HARDWARE DECODE",
    label: "Local Playback Engine",
    sub: "Hardware-accelerated Qt player with automatic VP9/AV1 proxies for smooth scrubbing.",
  },
  {
    value: "100%",
    unit: "ON-DEVICE",
    label: "Local-First Architecture",
    sub: "Raw media on NVMe, drafts in local SQLite, and tokens locked in your OS Keychain.",
  },
  {
    value: "0",
    unit: "CLOUD SERVERS",
    label: "Direct Platform Dispatch",
    sub: "Direct HTTPS requests to YouTube and Meta from your machine. Zero multi-tenant relay servers.",
  },
  {
    value: "$0",
    unit: "TOKEN MARKUP",
    label: "Bring Your Own Models",
    sub: "Connect Claude, ChatGPT, or Gemini via local MCP. Reelay never bills or marks up AI tokens.",
  },
];
---

<section class="metrics-strip-section" aria-label="Key Performance Metrics">
  <div class="container">
    <div class="metrics-rail">
      {metrics.map((m, idx) => (
        <div class="metric-cell">
          <div class="metric-top">
            <span class="metric-value font-display">{m.value}</span>
            <span class="metric-unit font-mono">{m.unit}</span>
          </div>
          <h3 class="metric-label">{m.label}</h3>
          <p class="metric-sub">{m.sub}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .metrics-strip-section {
    padding-top: clamp(2rem, 4vw, 3.5rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
    border-bottom: 1px solid var(--hairline);
    position: relative;
  }

  .metrics-rail {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.035) 0%, rgba(255, 255, 255, 0.008) 100%), #0c0d13;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-lg);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.1);
    overflow: hidden;
  }

  .metric-cell {
    padding: clamp(1.75rem, 3vw, 2.5rem) clamp(1.25rem, 2vw, 2rem);
    display: flex;
    flex-direction: column;
    position: relative;
    border-right: 1px solid rgba(255, 255, 255, 0.08);
    transition: background-color 0.25s ease;
  }

  .metric-cell:last-child {
    border-right: none;
  }

  .metric-cell:hover {
    background-color: rgba(255, 255, 255, 0.02);
  }

  .metric-top {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 0.85rem;
    flex-wrap: wrap;
  }

  .metric-value {
    font-size: clamp(2.35rem, 3.8vw, 3.25rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
    background: linear-gradient(180deg, #ffffff 25%, #9ea3b2 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .metric-unit {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--brand);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .metric-label {
    font-size: 1.02rem;
    font-weight: 650;
    color: #ffffff;
    margin-bottom: 0.45rem;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  .metric-sub {
    font-size: 0.84rem;
    color: var(--text-muted);
    line-height: 1.55;
    margin: 0;
  }

  @media (max-width: 1024px) {
    .metrics-rail {
      grid-template-columns: repeat(2, 1fr);
    }
    .metric-cell:nth-child(2) {
      border-right: none;
    }
    .metric-cell:nth-child(1),
    .metric-cell:nth-child(2) {
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }
  }

  @media (max-width: 600px) {
    .metrics-rail {
      grid-template-columns: 1fr;
    }
    .metric-cell {
      border-right: none !important;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      padding: 1.5rem;
    }
    .metric-cell:last-child {
      border-bottom: none;
    }
  }
</style>
