---
/**
 * WorkflowStory: how a video leaves the building, in five steps, told with
 * the real app's screens (public/screens/web, made by scripts/screens-web.mjs
 * from the captures in public/screens).
 *
 * Every step is checked against the app (README "Board", help.md "Ready
 * check", "Prepare to Publish", the side panel's Schedule / Publish Now
 * dock, Mark as Posted). Nothing here implies posting that Reelay doesn't do:
 * TikTok and Instagram are posted by the person, in their own apps.
 *
 * A sticky header stays under the nav for the whole story: the headline on
 * one line (once the big one has scrolled away) and the five steps, each
 * under a bar that fills as you read through it.
 *
 * TWO LAYOUTS, ONE MARKUP
 * - Pinned (JavaScript on, motion allowed): one sticky frame shows the
 *   current step's screen, beside the steps on a wide screen or a phone on
 *   its side, above them on a phone or tablet held upright. A step is
 *   current while it crosses the anchor line (the middle of the room left
 *   for reading), and that one attribute (data-stage) drives the frame:
 *   which screen, where it's zoomed, the highlight, the status line. The
 *   wheel and touch are never intercepted: the page scrolls as it always does.
 * - Stacked (reduced motion, no JavaScript, or no room): each step carries its
 *   own picture, in reading order. Nothing is pinned or animated, and
 *   nothing is only reachable through motion.
 */
import { DEMO_CARDS, OPEN_TICKET } from '../data/demo';
import PlatformIcon from './ui/PlatformIcon.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const shot = (id: string, theme: string, w: number) => `${base}screens/web/${id}-${theme}-${w}.webp`;
const caption = OPEN_TICKET.caption;
const tags = (caption.match(/#\w+/g) || []).length;

type Ring = { l: number; t: number; w: number; h: number };
const steps = [
  {
    id: 'library',
    label: 'Library',
    title: 'A video comes into your library.',
    body: 'List a profile you own or manage, tick the videos you want, and Reelay downloads them into your library folder, each with where it came from: the platform, the original link, the date and the creator.',
    facts: ['Your library folder, on your computer', 'Provenance recorded on every video'],
    status: 'In your library · Downloaded',
    screen: 'library-grid',
    alt: 'Reelay’s Library: a grid of downloaded videos, Golden hour at Big Sur first.',
    zoom: { s: 1.3, x: 0, y: 12 },
    ring: { l: 17.6, t: 22.8, w: 19.4, h: 23.6 } as Ring,
  },
  {
    id: 'preparation',
    label: 'Preparation',
    title: 'It becomes a ticket, with copy for each platform.',
    body: 'On the Board the video is a ticket. You write its caption once per platform, with live counts against each one’s own limits, so nothing gets cut short when it posts.',
    facts: ['YouTube title, 100 characters', 'TikTok 4,000 · Instagram 2,200 and 30 hashtags'],
    status: 'Backlog → Staging',
    screen: 'board',
    alt: 'The Board, with Golden hour at Big Sur in the Staging column.',
    zoom: { s: 1.25, x: 36, y: 22 },
    ring: { l: 37.4, t: 12.8, w: 19, h: 32.2 } as Ring,
    overlay: 'copy',
  },
  {
    id: 'readiness',
    label: 'Readiness',
    title: 'Reelay checks it’s ready to leave.',
    body: 'The top of the ticket lists every platform it’s going to, each with a tick or a warning that names what’s missing. It counts as ready when at least one platform is. Platforms you post by hand never hold it back.',
    facts: ['One row per platform, ✓ or ⚠', 'Hand-posted platforms never block'],
    status: 'Ready for 4 of 4',
    screen: 'command-center',
    alt: 'The side panel: a readiness ring at 4 of 4, YouTube ready to post, TikTok and Instagram posted by hand.',
    zoom: { s: 1.45, x: 100, y: 66 },
    ring: { l: 70.4, t: 52.8, w: 27.4, h: 25.4 } as Ring,
  },
  {
    id: 'approval',
    label: 'Approval',
    title: 'You decide when it goes.',
    body: 'Press Schedule or Publish Now, and the line above the button says exactly what will happen. Scheduling refuses any platform that isn’t ready. TikTok and Instagram you post yourself: Prepare to Publish copies the caption and opens their uploader, then you click Mark as Posted.',
    facts: ['One line says what will happen', 'Hand-posted platforms: Mark as Posted'],
    status: 'Your call · Schedule or Publish Now',
    screen: 'command-center',
    alt: 'The bottom of the side panel: “Publishes on YouTube as soon as it’s uploaded” above Save Changes and Publish Now.',
    zoom: { s: 1.8, x: 100, y: 100 },
    ring: { l: 70.2, t: 88.6, w: 28, h: 9.8 } as Ring,
    overlay: 'handoff',
  },
  {
    id: 'published',
    label: 'Published',
    title: 'It keeps the record of where it went.',
    body: 'Once every platform it’s going to is live, the card moves itself to Published. The refresh button on the Board checks YouTube and confirms what went out, and the ticket lists every post, automatic or by hand.',
    facts: ['Cards move themselves', 'Every post on one list'],
    status: 'Published · on every platform it was going to',
    screen: 'board',
    alt: 'The Board’s Published column: cards marked Posted outside Reelay.',
    zoom: { s: 1.3, x: 100, y: 34 },
    ring: { l: 78.4, t: 7.6, w: 20.6, h: 72.6 } as Ring,
  },
];
const screens = ['library-grid', 'board', 'command-center'];
const ringStyle = (r: Ring) => `left:${r.l}%;top:${r.t}%;width:${r.w}%;height:${r.h}%`;
const copyRows = [
  { p: 'youtube', name: 'YouTube title', n: OPEN_TICKET.card.title.length, max: '100' },
  { p: 'tiktok', name: 'TikTok', n: caption.length, max: '4,000' },
  { p: 'instagram', name: 'Instagram', n: caption.length, max: `2,200 · ${tags}/30 #` },
] as const;
void DEMO_CARDS;
---
<section class="stage story" id="interactive-workflow" aria-labelledby="story-title" data-story>
  <div class="wrap">
    <header class="chapter-head story-head">
      <p class="eyebrow">How it works</p>
      <h2 id="story-title" class="headline">Five steps from your library<br /><span class="text-silver">to everywhere it goes.</span></h2>
    </header>

    {/* Sticky under the nav for the whole story: the headline again, on one
        line (shown once the big one has scrolled away), and the five steps,
        each with a bar that fills as you read through it. */}
    <div class="story-top-spacer" aria-hidden="true"></div>
    <div class="story-top" data-story-top>
      <p class="story-mini" aria-hidden="true"><span class="sm-k">How it works</span> <span class="sm-t">Five steps from your library to everywhere it goes.</span></p>
      <ol class="story-index" aria-label="The five steps">
        {steps.map((s, i) => (
          <li><a href={`#story-${s.id}`} data-story-link={i + 1} aria-current={i === 0 ? 'step' : undefined}><span class="si-bar" aria-hidden="true"><i></i></span><span class="si-n">0{i + 1}</span> {s.label}</a></li>
        ))}
      </ol>
    </div>

    <div class="story-grid">
      <div class="story-steps">
        {steps.map((s, i) => (
          <article class="story-step" id={`story-${s.id}`} data-step={i + 1} aria-labelledby={`story-${s.id}-title`}>
            <h3 id={`story-${s.id}-title`} class="step-title">{s.title}</h3>
            <p class="step-body">{s.body}</p>
            <ul class="step-facts">{s.facts.map((f) => <li>{f}</li>)}</ul>
            {/* Stacked layout: this step's own picture. */}
            <figure class="step-figure">
              <div class="frame" data-crop>
                <div class="shot is-on" style={`--s:${s.zoom.s};--x:${s.zoom.x}%;--y:${s.zoom.y}%`}>
                  <picture>
                    <source media="(prefers-color-scheme: dark)" type="image/webp" srcset={`${shot(s.screen, 'dark', 960)} 960w, ${shot(s.screen, 'dark', 1440)} 1440w`} sizes="(min-width: 760px) 640px, 92vw" />
                    <img src={shot(s.screen, 'light', 960)} srcset={`${shot(s.screen, 'light', 960)} 960w, ${shot(s.screen, 'light', 1440)} 1440w`} sizes="(min-width: 760px) 640px, 92vw" width="1440" height="900" alt={s.alt} loading="lazy" decoding="async" />
                  </picture>
                  <span class="ring" style={ringStyle(s.ring)} aria-hidden="true"></span>
                </div>
              </div>
              <figcaption class="step-status"><span class="dot" aria-hidden="true"></span><span class="st-n">0{i + 1}</span> {s.status}</figcaption>
            </figure>
          </article>
        ))}
      </div>

      {/* Pinned layout: one sticky frame. Decorative: the steps say it all. */}
      <div class="stage-spacer" aria-hidden="true"></div>
      <div class="story-stage" aria-hidden="true">
        <div class="stage-box">
          <div class="frame frame--stage" data-crop>
            {screens.map((id) => (
              <div class="shot" data-shot={id}>
                <picture>
                  <source media="(prefers-color-scheme: dark)" type="image/webp" srcset={`${shot(id, 'dark', 960)} 960w, ${shot(id, 'dark', 1440)} 1440w`} sizes="(min-width: 1024px) 72vw, 92vw" />
                  <img src={shot(id, 'light', 960)} srcset={`${shot(id, 'light', 960)} 960w, ${shot(id, 'light', 1440)} 1440w`} sizes="(min-width: 1024px) 72vw, 92vw" width="1440" height="900" alt="" loading="lazy" decoding="async" />
                </picture>
                {steps.map((s, i) => s.screen === id && <span class="ring" data-ring={i + 1} style={ringStyle(s.ring)}></span>)}
              </div>
            ))}
            <div class="ov ov--copy" data-ov="2">
              <p class="ov-k">Ticket copy · {OPEN_TICKET.card.title}</p>
              {copyRows.map((r) => (
                <p class="ov-row"><PlatformIcon name={r.p} /><span>{r.name}</span><b>{r.n} / {r.max}</b></p>
              ))}
            </div>
            <div class="ov ov--handoff" data-ov="4">
              <p class="ov-k">Posted by hand</p>
              <p class="ov-row"><PlatformIcon name="tiktok" /><PlatformIcon name="instagram" /><span>Prepare to Publish, then <b>Mark as Posted</b></span></p>
            </div>
          </div>
          <div class="stage-status">
            {steps.map((s, i) => <p data-status={i + 1}><span class="dot"></span><span class="st-n">0{i + 1}</span> {s.status}</p>)}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .story { padding-top: clamp(2rem, 5vw, 4rem); }
  /* No clipping or stacking box between the story's sticky parts (the
     header, the frame) and the page: every section clips sideways (.stage),
     and inside a clipping box iPhone and iPad Safari move a sticky element
     a frame late, so it shook up and down while scrolling. Nothing here
     spills sideways (the root clips the viewport). */
  .story { overflow: visible; isolation: auto; }
  .story-head { margin-bottom: 0; }

  /* ── The sticky header: one line of title, then the five steps ────────
     Sticky under the nav for the whole story (its containing block is the
     story's .wrap). Its height never changes: the one-line title has its
     room reserved at rest, where it's the gap under the big headline, and
     only fades in once the header is stuck and the big headline has gone
     under the nav. So becoming stuck moves nothing on the page. */
  .story-top-spacer { height: 0; }
  .story-top {
    position: sticky;
    top: var(--nav-bar-h);
    z-index: 3;
    margin-inline: calc(50% - 50vw);
    padding-inline: calc(50vw - 50%);
    margin-bottom: clamp(1.75rem, 4vw, 3rem);
    background: var(--r-bg);
  }
  /* Held with position: fixed on touch screens (see initStory), in the
     same place and size sticky gave it. */
  .story-top.is-fixed {
    position: fixed;
    top: var(--nav-bar-h);
    left: var(--fx-left, 0px);
    width: var(--fx-w, 100%);
    margin: 0;
    padding-inline: var(--pad, 0px);
  }
  .story-top::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    height: 1.75rem;
    background: linear-gradient(var(--r-bg), color-mix(in srgb, var(--r-bg) 0%, transparent));
    opacity: 0;
    pointer-events: none;
  }
  .story-top[data-stuck]::after { opacity: 1; }
  .story-mini {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    height: 2.6rem;
    padding-top: 0.8rem;
    white-space: nowrap;
    overflow: hidden;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 650;
    letter-spacing: -0.015em;
    color: var(--r-ink);
    opacity: 0;
    transform: translateY(0.35rem);
  }
  .sm-k { flex: none; color: var(--r-amber-text); }
  .sm-t { min-width: 0; overflow: hidden; text-overflow: ellipsis; }
  .story-top[data-stuck] .story-mini { opacity: 1; transform: none; }
  /* Opacity and transform only: the compositor runs them, so they never
     cost a touch scroll its momentum (a colour fade did; see below). */
  @media (prefers-reduced-motion: no-preference) {
    .story-mini { transition: opacity 0.35s ease, transform 0.45s var(--r-ease); }
    .story-top::after { transition: opacity 0.35s ease; }
  }

  /* The step index: five numbered links, each under a bar that fills as
     you read through its step (the script sets each bar's scaleX). */
  .story-index {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0.4rem;
    list-style: none;
  }
  .story-index a {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
    min-height: 44px;
    padding-top: 0.8rem;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--r-ink-3);
    text-decoration: none;
    transition: none;   /* overrides the site-wide link fade; see below */
  }
  .si-bar { position: absolute; left: 0; right: 0; top: 0; height: 2px; border-radius: 2px; background: var(--hairline-strong); overflow: hidden; }
  .si-bar i { display: block; height: 100%; background: var(--r-amber-text); transform-origin: 0 50%; transform: scaleX(0); will-change: transform; }
  /* Without the script: the current (first) step's bar is full. */
  .story-index a[aria-current='step'] .si-bar i { transform: scaleX(1); }
  /* The current step's mark changes colour gently with a mouse. On a touch
     screen it switches instantly: a colour fade runs on the main thread
     every frame, and fired mid-swipe (as the pinned story does on a phone)
     it cut the swipe's momentum. Measured: 4 to 7 short swipes a run with
     the fade, 0 to 1 without, the same as before the phone was pinned. */
  @media (hover: hover) {
    .story-index a { transition: color 0.3s ease; }
  }
  .story-index a:hover { color: var(--r-ink); }
  .story-index a[aria-current='step'] { color: var(--r-ink); }
  .si-n, .st-n { font-family: var(--font-mono); font-size: 0.78rem; font-weight: 600; color: var(--r-amber-text); font-variant-numeric: tabular-nums; }
  @media (max-width: 640px) {
    .story-index { gap: 0.2rem; }
    .story-index a { flex-direction: column; gap: 0.1rem; padding-top: 0.6rem; font-size: 0.72rem; }
    /* One line on a phone: the headline alone, sized to the width (it's
       about 25.2 font-sizes long), so it fits whole from 320px up. */
    .story-mini { height: 2.3rem; padding-top: 0.7rem; font-size: clamp(0.7rem, calc((100vw - 2 * var(--r-gutter)) / 26), 0.9rem); }
    .sm-k { display: none; }
  }

  /* ── Stacked (default): text, then its picture, step after step ─────── */
  .story-steps { display: grid; gap: clamp(3rem, 7vw, 5rem); }
  .story-step { scroll-margin-top: calc(var(--nav-bar-h) + var(--sth, 6rem) + 1rem); }
  .step-title { font-family: var(--font-display); font-size: clamp(1.6rem, 3.2vw, 2.4rem); font-weight: 700; line-height: 1.1; letter-spacing: -0.03em; color: var(--r-ink); max-width: 22ch; }
  .step-body { margin-top: 0.9rem; max-width: 34rem; font-size: 1.05rem; line-height: 1.55; color: var(--r-ink-2); }
  .step-facts { display: flex; flex-direction: column; gap: 0.35rem; margin-top: 1rem; list-style: none; }
  .step-facts li { display: flex; gap: 0.55rem; align-items: baseline; font-size: 0.92rem; color: var(--r-ink-3); }
  .step-facts li::before { content: ''; flex: none; width: 0.9rem; height: 1px; background: var(--r-amber-text); transform: translateY(-0.25em); }
  .step-figure { margin-top: 1.5rem; }

  /* The frame: a window onto the real screen, zoomed where the step is. */
  .frame {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 14px;
    background: var(--r-tile);
    box-shadow: var(--app-frame);
  }
  .shot {
    position: absolute;
    inset: 0;
    transform-origin: var(--x, 50%) var(--y, 50%);
    transform: scale(var(--s, 1));
  }
  .shot img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .ring {
    position: absolute;
    border-radius: calc(10px / var(--s, 1));
    box-shadow: 0 0 0 calc(2px / var(--s, 1)) var(--r-amber), 0 0 0 calc(7px / var(--s, 1)) color-mix(in srgb, var(--r-amber) 22%, transparent);
    pointer-events: none;
  }
  .step-status, .stage-status p {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.85rem;
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--r-ink-2);
  }
  .dot { width: 0.5rem; height: 0.5rem; border-radius: 50%; background: var(--r-amber-text); flex: none; }

  .story-stage { display: none; }
  .stage-spacer { display: none; }

  /* Stacked on a wide screen, or a phone on its side (reduced motion, or no
     JavaScript): each step is its text beside its picture, so the section
     stays compact without pinning anything. */
  @media (min-width: 1024px), (orientation: landscape) and (min-width: 640px) and (max-height: 599.98px) {
    .story:not([data-pinned]) .story-step {
      display: grid;
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      grid-template-areas: 't fig' 'b fig' 'f fig' '. fig';
      grid-template-rows: auto auto auto 1fr;
      column-gap: clamp(2.5rem, 5vw, 4.5rem);
      align-items: start;
    }
    .story:not([data-pinned]) .step-title { grid-area: t; }
    .story:not([data-pinned]) .step-body { grid-area: b; }
    .story:not([data-pinned]) .step-facts { grid-area: f; }
    .story:not([data-pinned]) .step-figure { grid-area: fig; margin-top: 0; }
  }

  /* ── Pinned (JS and motion allowed) ───────────────────────────────────── */
  .story[data-pinned] .story-steps { gap: 0; }
  .story[data-pinned] .story-step {
    display: flex;
    flex-direction: column;
    justify-content: center;
    opacity: 0.38;
    transition: opacity 0.45s ease;
  }
  .story[data-pinned] .story-step.is-current { opacity: 1; }
  .story[data-pinned] .step-figure { display: none; }
  .story[data-pinned] .story-stage { display: block; position: sticky; }

  /* Wide, or a phone on its side: the steps on the left, the frame pinned
     beside them, under the sticky header and centred in the room left.
     (Pinned under the header, as upright, a phone on its side would have no
     room left for the text: the screen is 390px tall.) */
  @media (min-width: 1024px), (orientation: landscape) and (min-width: 640px) and (max-height: 599.98px) {
    .story[data-pinned] .story-grid {
      display: grid;
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: clamp(2.5rem, 5vw, 4.5rem);
      align-items: start;
    }
    .story[data-pinned] .story-step { min-height: 44vh; padding-block: 2rem; }
    .story[data-pinned] .story-step:last-child { min-height: 52vh; }
    .story[data-pinned] .story-stage {
      top: calc(var(--nav-bar-h) + var(--sth, 0px) + max(1rem, (100svh - var(--nav-bar-h) - var(--sth, 0px) - 34rem) / 2));
    }
    /* Never taller than the room under the header (16:10 plus the status line). */
    .story[data-pinned] .stage-box { max-width: calc((100svh - var(--nav-bar-h) - var(--sth, 0px) - 5rem) * 1.6); margin-inline: auto; }
    /* Held by the script on touch screens (see initStory) where sticky put
       it: the same top, and the column's measured left edge and width. */
    .story[data-pinned] .story-stage.is-fixed { position: fixed; left: var(--fx-left, 0px); width: var(--fx-w, auto); margin: 0; }
  }

  /* A phone on its side: the same, scaled to a short screen, with a tighter
     header. Each step is most of a screen tall so one holds the middle. */
  @media (orientation: landscape) and (min-width: 640px) and (max-width: 1023.98px) and (max-height: 599.98px) {
    .story-mini { height: 2.1rem; padding-top: 0.55rem; font-size: 0.88rem; }
    .story-index a { padding-top: 0.6rem; font-size: 0.82rem; }
    .story[data-pinned] .story-grid { grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: clamp(1.5rem, 4vw, 2.5rem); }
    .story[data-pinned] .story-stage { top: calc(var(--nav-bar-h) + var(--sth, 0px) + 0.5rem); }
    .story[data-pinned] .stage-box { max-width: calc((100svh - var(--nav-bar-h) - var(--sth, 0px) - 3.25rem) * 1.6); }
    .story[data-pinned] .story-step { min-height: 78svh; padding-block: 1rem; }
    .story[data-pinned] .story-step:last-child { min-height: 86svh; }
    .story[data-pinned] .step-title { font-size: clamp(1.3rem, 3.4vw, 1.6rem); }
    .story[data-pinned] .step-body { margin-top: 0.6rem; font-size: 0.92rem; line-height: 1.5; }
    .story[data-pinned] .step-facts { margin-top: 0.7rem; }
    .story[data-pinned] .step-facts li { font-size: 0.82rem; }
    .story[data-pinned] .stage-status { margin-top: 0.5rem; min-height: 1.4rem; }
    .story[data-pinned] .stage-status p { font-size: 0.8rem; }
  }

  /* The frame is small on any phone: the overlays shrink with it. */
  @media (max-width: 1023.98px) {
    .story[data-pinned] .ov { min-width: 0; gap: 0.25rem; padding: 0.5rem 0.65rem; border-radius: 10px; }
    .story[data-pinned] .ov-k { font-size: 0.62rem; }
    .story[data-pinned] .ov-row { font-size: 0.7rem; gap: 0.35rem; }
    .story[data-pinned] .ov-row :global(svg) { width: 0.85rem; height: 0.85rem; }
  }

  /* Phones and tablets held upright: the frame pinned under the sticky
     header, and the steps scrolling up beneath it, each one taking over the
     frame as it reaches the middle of the space below. Nothing is
     intercepted: it's ordinary scrolling past sticky boxes, so a swipe
     carries on as it always does.

     The band is opaque (the steps pass under it) and reaches the screen
     edges through negative margins, plain layout. Never through clip-path
     or a huge box-shadow: on a sticky box, iPhone Safari repositions those
     a frame late, and the picture shook up and down while scrolling.
     Its foot is feathered, so the text below fades out under it rather
     than being cut by a hard edge. */
  @media (max-width: 639.98px), (max-width: 1023.98px) and (min-height: 600px), (max-width: 1023.98px) and (orientation: portrait) {
    .story[data-pinned] .story-grid { display: flex; flex-direction: column; }
    /* The band below does the feathering here. */
    .story[data-pinned] .story-top::after { display: none; }
    .story[data-pinned] .story-stage {
      order: -1;
      z-index: 2;
      top: calc(var(--nav-bar-h) + var(--sth, 0px));
      margin-inline: calc(50% - 50vw);
      padding: 0.75rem calc(50vw - 50%) 0.35rem;
      background: var(--r-bg);
    }
    .story[data-pinned] .story-stage::after {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      top: 100%;
      height: 3.5rem;
      background: linear-gradient(
        var(--r-bg) 0%,
        color-mix(in srgb, var(--r-bg) 82%, transparent) 25%,
        color-mix(in srgb, var(--r-bg) 45%, transparent) 55%,
        color-mix(in srgb, var(--r-bg) 15%, transparent) 80%,
        transparent 100%
      );
      pointer-events: none;
    }
    /* Held by the script (see initStory): the same place as sticky gives
       it, under the header and edge to edge, with the same inset. */
    .story[data-pinned] .story-stage.is-fixed {
      position: fixed;
      left: 0;
      right: 0;
      margin: 0;
      padding-inline: var(--pad, 0px);
    }
    .story[data-pinned] .stage-spacer { display: block; order: -1; flex: none; height: 0; }
    /* Scroll anchoring is off for touch and phone-width pages (global.css). */
    .story[data-pinned] .stage-box { max-width: 34rem; margin-inline: auto; }
    /* A hairline instead of the frame's deep shadow, which the band would
       cut off in a visible line. */
    .story[data-pinned] .frame--stage { box-shadow: 0 0 0 1px var(--hairline-strong); }
    .story[data-pinned] .story-step { min-height: 52svh; padding-block: 1.25rem; }
    .story[data-pinned] .story-step:last-child { min-height: 60svh; }
    .story[data-pinned] .step-title { font-size: clamp(1.45rem, 6vw, 1.9rem); }
    .story[data-pinned] .step-body { font-size: 1rem; }
    .story[data-pinned] .stage-status { margin-top: 0.55rem; min-height: 1.4rem; }
    .story[data-pinned] .stage-status p { font-size: 0.82rem; }
  }
  .frame--stage .shot { opacity: 0; transition: opacity 0.5s ease, transform 0.8s var(--r-ease); }
  .frame--stage .shot.is-on { opacity: 1; }
  .frame--stage .ring { opacity: 0; transition: opacity 0.4s ease 0.25s; }
  .frame--stage .ring.is-on { opacity: 1; }
  .stage-status { position: relative; min-height: 1.6rem; margin-top: 0.85rem; }
  .stage-status p { position: absolute; inset: 0 auto auto 0; margin: 0; opacity: 0; transition: opacity 0.35s ease; }
  .stage-status p.is-on { opacity: 1; }

  /* Overlays: the ticket's copy (step 2), the hand-off (step 4). */
  .ov {
    position: absolute;
    display: grid;
    gap: 0.45rem;
    min-width: 15.5rem;
    padding: 0.85rem 1rem;
    border-radius: 14px;
    background: var(--r-surface);
    box-shadow: inset 0 0 0 1px var(--hairline-strong), var(--r-float-shadow);
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.4s ease 0.2s, transform 0.5s var(--r-ease) 0.2s;
  }
  .ov.is-on { opacity: 1; transform: none; }
  .ov--copy { right: 4%; bottom: 7%; }
  .ov--handoff { left: 4%; top: 7%; }
  .ov-k { font-size: 0.72rem; font-weight: 600; color: var(--r-amber-text); }
  .ov-row { display: flex; align-items: center; gap: 0.5rem; font-size: 0.86rem; color: var(--r-ink-2); }
  .ov-row :global(svg) { width: 1.05rem; height: 1.05rem; flex: none; }
  .ov-row b { margin-left: auto; font-weight: 600; color: var(--r-ink); font-variant-numeric: tabular-nums; }
  .ov--handoff .ov-row b { margin-left: 0; }
  .ov--handoff .ov-row span { margin-left: 0.15rem; }

  @media (prefers-reduced-motion: reduce) {
    .story-index a, .story-step, .frame--stage .shot, .frame--stage .ring, .ov, .stage-status p, .story-mini, .story-top::after { transition: none !important; }
  }
</style>

<script>
  /* The story is a progress enhancement over plain reading. Nothing here
     scrolls the page or touches the wheel: the page scrolls as it always
     does, and the script only reads where things are and updates a few
     classes and transforms.

     - Which step is current: an IntersectionObserver on a thin band at the
       "anchor" line, the middle of the room left for reading (under the
       sticky header, and under the pinned frame on a phone held upright).
     - The step bars: each fills from 0 to 1 as its step passes the anchor
       line (a scaleX transform, so the compositor paints it). With reduced
       motion they snap: steps up to the current one full, the rest empty.
     - Touch screens (iPhone and iPad, any width): the header and the pinned
       frame are held with position: fixed through the middle of the story.
       Mobile Safari moves sticky boxes a little behind the scroll: in a
       screen recording the pinned frame wandered over 8 device pixels from
       frame to frame while the fixed nav above it held to 0.001px. Both are
       switched to fixed at exactly the place sticky put them, and back
       shortly before the end, so neither switch moves anything; sticky
       still does the arriving and leaving. */
  function initStory() {
    document.querySelectorAll<HTMLElement>('[data-story]').forEach((root) => {
      if (root.dataset.ready) return;
      root.dataset.ready = '1';
      const steps = Array.from(root.querySelectorAll<HTMLElement>('.story-step'));
      const shots = Array.from(root.querySelectorAll<HTMLElement>('.frame--stage .shot'));
      const rings = Array.from(root.querySelectorAll<HTMLElement>('.frame--stage .ring'));
      const overlays = Array.from(root.querySelectorAll<HTMLElement>('[data-ov]'));
      const statuses = Array.from(root.querySelectorAll<HTMLElement>('[data-status]'));
      const links = Array.from(root.querySelectorAll<HTMLAnchorElement>('[data-story-link]'));
      const bars = links.map((a) => a.querySelector<HTMLElement>('.si-bar i'));
      const top = root.querySelector<HTMLElement>('[data-story-top]')!;
      const topSpacer = root.querySelector<HTMLElement>('.story-top-spacer')!;
      const grid = root.querySelector<HTMLElement>('.story-grid')!;
      const wrap = top.parentElement!;
      const stage = root.querySelector<HTMLElement>('.story-stage')!;
      const spacer = root.querySelector<HTMLElement>('.stage-spacer')!;
      const zooms = steps.map((s) => s.querySelector<HTMLElement>('.step-figure .shot')?.getAttribute('style') ?? '');
      const screenOf = steps.map((s) => (s.querySelector('.step-figure img')?.getAttribute('src') ?? '').match(/web\/(.+)-(?:light|dark)-/)?.[1] ?? '');

      // Pinned whenever motion is allowed and there's room: any wide screen,
      // a phone or tablet held upright (the frame under the header), or a
      // phone on its side (the frame beside the steps, as on a wide screen).
      const NM = '(prefers-reduced-motion: no-preference)';
      const mq = window.matchMedia(`${NM} and (min-width: 1024px), ${NM} and (min-height: 600px), ${NM} and (orientation: landscape) and (min-width: 640px)`);
      // The frame beside the steps (the same query as the CSS).
      const side = window.matchMedia('(min-width: 1024px), (orientation: landscape) and (min-width: 640px) and (max-height: 599.98px)');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
      // Held with position: fixed on any touch screen (an iPad Pro is 1024 to
      // 1366 wide, so it takes the wide layout and missed the phone-only hold),
      // and below desktop width.
      const touch = window.matchMedia('(hover: none) and (pointer: coarse)');
      const narrow = window.matchMedia('(max-width: 1023.98px)');

      // ── Steps ──────────────────────────────────────────────────────────
      let current = 0;
      const shown = bars.map(() => -1);
      const setBar = (i: number, f: number) => {
        const v = Math.round(f * 1000) / 1000;
        if (shown[i] === v || !bars[i]) return;
        shown[i] = v;
        bars[i]!.style.transform = `scaleX(${v})`;
      };
      const snapBars = () => bars.forEach((_, i) => setBar(i, i < current ? 1 : 0));
      const show = (n: number) => {
        if (n === current) return;
        current = n;
        root.dataset.stage = String(n);
        steps.forEach((s, i) => s.classList.toggle('is-current', i + 1 === n));
        shots.forEach((el) => {
          const on = el.dataset.shot === screenOf[n - 1];
          el.classList.toggle('is-on', on);
          if (on) el.setAttribute('style', zooms[n - 1]);
        });
        rings.forEach((r) => r.classList.toggle('is-on', r.dataset.ring === String(n)));
        overlays.forEach((o) => o.classList.toggle('is-on', o.dataset.ov === String(n)));
        statuses.forEach((p) => p.classList.toggle('is-on', p.dataset.status === String(n)));
        links.forEach((a) => (a.dataset.storyLink === String(n) ? a.setAttribute('aria-current', 'step') : a.removeAttribute('aria-current')));
        if (reduce.matches) snapBars();
      };

      // ── Geometry: the header's height and the anchor line ─────────────
      let navH = 0;
      let anchor = 0.5;                       // fraction of the viewport height
      let fixed = false;
      const measure = () => {
        navH = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--nav-bar-h')) || 0;
        const h = top.getBoundingClientRect().height;
        root.style.setProperty('--sth', `${h}px`);
        let from = navH + h;                  // reading room starts under the header…
        if (root.hasAttribute('data-pinned') && !side.matches) {
          from = parseFloat(getComputedStyle(stage).top) + stage.getBoundingClientRect().height;   // …or under the frame
        }
        anchor = Math.min(0.9, Math.max(0.3, (from + innerHeight) / 2 / innerHeight));
        root.style.setProperty('--anchor', anchor.toFixed(4));
      };
      let io: IntersectionObserver | null = null;
      const observe = () => {
        io?.disconnect();
        const a = anchor * 100;
        io = new IntersectionObserver((entries) => {
          for (const e of entries) if (e.isIntersecting) show(Number((e.target as HTMLElement).dataset.step));
        }, { rootMargin: `-${(a - 1).toFixed(2)}% 0px -${(99 - a).toFixed(2)}% 0px` });
        steps.forEach((s) => io!.observe(s));
      };

      // ── The touch hold ─────────────────────────────────────────────────
      const MARGIN = 48;   // px into the stretch before fixing, and before its end
      const holds = () => touch.matches || narrow.matches;
      let held: HTMLElement[] = [];
      const unfix = () => {
        if (!fixed) return;
        fixed = false;
        for (const el of held) {
          el.classList.remove('is-fixed');
          for (const v of ['--pad', '--fx-left', '--fx-w']) el.style.removeProperty(v);
        }
        spacer.style.height = topSpacer.style.height = '0px';
      };
      // The header, and the frame when the story is pinned (stacked, with
      // reduced motion, the header is the only sticky box).
      const fix = () => {
        const withStage = root.hasAttribute('data-pinned');
        // Read everything first, then write: exact, unrounded sizes, so the
        // text below never shifts by a fraction of a pixel.
        const t = top.getBoundingClientRect();
        const tcs = getComputedStyle(top);
        const r = stage.getBoundingClientRect();
        const spad = getComputedStyle(stage).paddingLeft;
        fixed = true;
        held = withStage ? [top, stage] : [top];
        topSpacer.style.height = `${t.height + parseFloat(tcs.marginBottom)}px`;
        top.style.setProperty('--fx-left', `${t.left}px`);
        top.style.setProperty('--fx-w', `${t.width}px`);
        top.style.setProperty('--pad', tcs.paddingLeft);
        if (!withStage) {
          // nothing else to hold
        } else if (side.matches) {
          stage.style.setProperty('--fx-left', `${r.left}px`);
          stage.style.setProperty('--fx-w', `${r.width}px`);
        } else {
          spacer.style.height = `${r.height}px`;
          stage.style.setProperty('--pad', spad);
        }
        for (const el of held) el.classList.add('is-fixed');
      };

      // ── Every frame the page scrolls ───────────────────────────────────
      let queued = false;
      const tick = () => {
        queued = false;
        const t = top.getBoundingClientRect();
        const ts = topSpacer.getBoundingClientRect();   // where the header sits in the page, stuck or not
        const g = grid.getBoundingClientRect();
        const rects = reduce.matches ? null : steps.map((s) => s.getBoundingClientRect());
        let inside = false;
        if (holds()) {
          // Hysteresis: in 48px into a stretch, out 24px before its end, so
          // the tests can never flip it back and forth.
          const m = fixed ? MARGIN / 2 : MARGIN;
          // The header inside its own stretch: stuck, and not yet leaving
          // with the end of the story (its containing block, .wrap).
          const hb = ts.height ? ts.height : t.height + parseFloat(getComputedStyle(top).marginBottom);
          inside = ts.top < navH - m && wrap.getBoundingClientRect().bottom - hb > navH + m;
          if (root.hasAttribute('data-pinned')) {
            // And the frame inside its pinned stretch (beside the steps it pins
            // lower than the header, so its stretch can begin while the header
            // is still arriving).
            const st = parseFloat(getComputedStyle(stage).top) || 0;
            const h = (fixed && !side.matches ? spacer : stage).getBoundingClientRect().height;
            inside = inside && g.top < st - m && g.bottom - h > st + m;
          }
        }
        // Writes from here on (no layout reads after this point).
        if (t.top <= navH + 0.5) top.setAttribute('data-stuck', '');
        else top.removeAttribute('data-stuck');
        if (rects) {
          const y = innerHeight * anchor;
          rects.forEach((r, i) => setBar(i, Math.min(1, Math.max(0, (y - r.top) / r.height))));
        }
        if (inside && !fixed) fix();
        else if (!inside && fixed) unfix();
      };
      const queue = () => { if (!queued) { queued = true; requestAnimationFrame(tick); } };
      window.addEventListener('scroll', queue, { passive: true });
      // Phones fire resize as the browser's toolbars slide in and out while
      // scrolling: never let go there, only re-measure (a turned phone
      // changes the header's and the frame's size and inset).
      let lastH = innerHeight, lastW = innerWidth;
      window.addEventListener('resize', () => {
        if (fixed) { unfix(); fix(); }
        measure();
        if (Math.abs(innerHeight - lastH) > 80 || innerWidth !== lastW) observe();   // not for toolbar slides
        lastH = innerHeight; lastW = innerWidth;
        queue();
      }, { passive: true });
      new ResizeObserver(() => { if (!fixed) measure(); }).observe(top);

      // The index links: land the step on the anchor line, so the frame and
      // the bar show it (a plain jump would leave it under the header).
      links.forEach((a) => a.addEventListener('click', (e) => {
        const step = steps[Number(a.dataset.storyLink) - 1];
        if (!step) return;
        e.preventDefault();
        const y = step.getBoundingClientRect().top + scrollY - innerHeight * anchor + 12;
        window.scrollTo({ top: y, behavior: reduce.matches ? 'auto' : 'smooth' });
        history.replaceState(null, '', `#${step.id}`);
      }));

      const apply = () => {
        unfix();
        if (mq.matches) root.dataset.pinned = '';
        else delete root.dataset.pinned;
        measure();
        observe();
        const was = current;
        current = 0;
        show(Math.max(was, 1));
        if (reduce.matches) snapBars();
        queue();
      };
      apply();
      for (const m of [mq, side, reduce, touch, narrow]) m.addEventListener('change', apply);
    });
  }
  initStory();
  document.addEventListener('astro:page-load', initStory);
</script>
