---
/**
 * AccountsScene: the Accounts page (reelay/gui/accounts_page.py), drawn the
 * way the app is being asked to lay it out (APP_DESIGN_BRIEF.md, "Accounts").
 *
 * The rule: every row is full and every card is the same size, whatever it
 * holds. The six platforms you sign in to are the grid, 3 x 2 (2 x 3 when
 * narrower, 1 x 6 on a phone): six divides evenly at every width, so no row
 * is ever left with an orphan. Snapchat has no sign-in, only a hand-posting
 * note, so it is a full-width strip under the grid rather than a seventh
 * card (seven is what made the app's grid 3-3-1). Cards stretch to the
 * tallest in the grid and pin their action to the bottom edge.
 */
import AppWindow from './ui/AppWindow.astro';
import PlatformIcon from './ui/PlatformIcon.astro';

const cards = [
  { key: 'youtube', name: 'YouTube', mode: 'Uploads and schedules', status: 'Connected', tone: 'ok', line: 'Juniper Lane', action: 'Disconnect', extra: 'Advanced Setup' },
  { key: 'tiktok', name: 'TikTok', mode: 'Copy and paste', status: 'Connected', tone: 'ok', line: '@juniperlane', action: 'Disconnect' },
  { key: 'instagram', name: 'Instagram', mode: 'Copy and paste', status: 'Not connected', tone: 'off', line: 'Sign in to attach your account', action: 'Sign in with Instagram' },
  { key: 'bluesky', name: 'Bluesky', mode: 'Automatic posting off', status: 'Not connected', tone: 'off', line: 'Posts with an app password', action: 'Connect Bluesky…' },
  { key: 'threads', name: 'Threads', mode: 'Automatic posting on', status: 'Connected', tone: 'ok', line: '@juniperlane', action: 'Disconnect' },
  { key: 'facebook', name: 'Facebook', mode: 'Automatic posting off', status: 'Signed out', tone: 'warn', line: 'Juniper Lane Page', action: 'Sign in with Facebook' },
] as const;
const connected = cards.filter((c) => c.tone === 'ok').length;
const total = cards.length;
---
<div class="scale-stage">
  <div class="ascene">
    <AppWindow title="Reelay: Accounts" label={`Reelay's Accounts page: six platform cards of equal size in two rows of three, ${connected} of ${total} connected, each with a status pill and one action. Snapchat, which is posted by hand, sits in a strip below.`}>
      <div class="abody">
        <div class="ahead">
          <span class="aname">Accounts</span>
          <span class="acount">{connected} of {total} connected</span>
        </div>
        <p class="asub">Where Juniper Lane’s videos go out. Each profile has its own accounts, so creators stay separate.</p>
        <div class="agrid">
          {cards.map((c) => (
            <div class="acard">
              <div class="ac-top">
                <PlatformIcon name={c.key} />
                <span class="ac-names"><b>{c.name}</b><span class="ac-mode">{c.mode}</span></span>
                <span class={`pill pill--${c.tone}`}>{c.status}</span>
              </div>
              <p class="ac-line">{c.line}</p>
              <div class="ac-foot">
                <span class:list={['ac-btn', { primary: c.action.startsWith('Sign in') || c.action.startsWith('Connect') }]}>{c.action}</span>
                {'extra' in c && <span class="ac-more">{c.extra}…</span>}
              </div>
            </div>
          ))}
        </div>
        <div class="astrip">
          <span class="snap" aria-hidden="true">S</span>
          <b>Snapchat</b>
          <span class="pill pill--off">Posted by hand</span>
          <span class="astrip-line">Copy the caption from a ticket and post Spotlight from the Snapchat app.</span>
        </div>
      </div>
    </AppWindow>
  </div>
</div>

<style>
  .scale-stage { container-type: inline-size; width: 100%; }
  .ascene { font-size: calc(100cqw / 56); }
  .abody { padding: 1.1em 1.2em 1.3em; background: var(--app-bg); color: var(--app-ink); }
  .ahead { display: flex; align-items: baseline; gap: 0.8em; }
  .aname { font-size: 1.3em; font-weight: 700; letter-spacing: -0.02em; }
  .acount { font-size: 0.78em; font-weight: 600; color: var(--app-ink-2); }
  .asub { margin: 0.35em 0 1em; font-size: 0.76em; color: var(--app-ink-2); }
  /* Equal columns AND equal rows: every card is the size of the largest. */
  .agrid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); grid-auto-rows: 1fr; gap: 0.75em; }
  .acard { display: flex; flex-direction: column; gap: 0.55em; min-width: 0; padding: 0.95em; border-radius: 0.9em; background: var(--app-surface); box-shadow: 0 0 0 0.0625em var(--app-border); }
  .ac-top { display: flex; align-items: center; gap: 0.6em; }
  .ac-top :global(svg) { flex: none; width: 1.6em; height: 1.6em; }
  .ac-names { display: grid; min-width: 0; line-height: 1.25; }
  .ac-names b { font-size: 0.86em; }
  .ac-mode { font-size: 0.62em; color: var(--app-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .pill { margin-left: auto; flex: none; font-size: 0.6em; font-weight: 700; padding: 0.3em 0.6em; border-radius: 1em; white-space: nowrap; }
  .pill--ok { background: color-mix(in srgb, var(--app-ok) 18%, transparent); color: var(--app-ok); }
  .pill--warn { background: color-mix(in srgb, var(--app-warn) 18%, transparent); color: var(--app-warn); }
  .pill--off { background: var(--app-raised); color: var(--app-ink-2); }
  .ac-line { font-size: 0.7em; color: var(--app-ink-2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  /* The action sits on the card's bottom edge, so a row of cards lines up. */
  .ac-foot { margin-top: auto; display: flex; align-items: center; gap: 0.8em; padding-top: 0.2em; }
  .ac-btn { font-size: 0.68em; font-weight: 600; padding: 0.4em 0.8em; border-radius: 0.5em; background: var(--app-raised); color: var(--app-ink); white-space: nowrap; }
  .ac-btn.primary { background: var(--app-accent); color: var(--app-on-accent); }
  .ac-more { font-size: 0.64em; color: var(--app-muted); white-space: nowrap; }
  .astrip { display: flex; align-items: center; gap: 0.6em; margin-top: 0.75em; padding: 0.7em 0.95em; border-radius: 0.9em; background: var(--app-surface); box-shadow: 0 0 0 0.0625em var(--app-border); }
  .astrip b { font-size: 0.8em; }
  .astrip .pill { margin-left: 0; }
  .astrip-line { font-size: 0.66em; color: var(--app-ink-2); min-width: 0; }
  .snap { display: inline-grid; place-items: center; flex: none; width: 1.3em; height: 1.3em; border-radius: 0.35em; background: #fffc00; color: #000; font-size: 0.75em; font-weight: 800; }
  @container (max-width: 760px) {
    .ascene { font-size: calc(100cqw / 36); }
    .agrid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @container (max-width: 480px) {
    .ascene { font-size: calc(100cqw / 24); }
    .agrid { grid-template-columns: minmax(0, 1fr); }
    .astrip { flex-wrap: wrap; }
    .astrip-line { flex-basis: 100%; }
  }
</style>
