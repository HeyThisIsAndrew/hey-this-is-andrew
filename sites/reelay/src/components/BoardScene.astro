---
/**
 * BoardScene: a faithful rendering of Reelay's main window. Sidebar, the
 * four-column Board of media-first tickets with their coverage maps, and the
 * side panel with the player, readiness, the Posting to chips and the
 * Save Changes / Schedule dock. The layout follows the real app (reelay/gui:
 * main_window, board_page, post_panel, ticket_widgets, player).
 *
 * Drawn in the app's Spatial Glass theme (src/styles/glass.css): frosted
 * sidebar and inspector over the glass canvas, recessed column wells, and
 * glass video cards with their rim, catchlight and selected ring.
 *
 * Sized in em off one container-relative font-size, so the whole window
 * scales like a screenshot. On a phone the side panel is shown on its own,
 * large enough to read, instead of a shrunken desktop.
 */
import AppWindow from './ui/AppWindow.astro';
import Coverage from './ui/Coverage.astro';
import PlatformIcon from './ui/PlatformIcon.astro';
import GlassRing from './ui/GlassRing.astro';
import SourceBadge from './ui/SourceBadge.astro';
import { DEMO_CARDS, OPEN_TICKET, CREATOR } from '../data/demo';
import { STAGES, STAGE_SUBTITLES, SITE } from '../data/site';

const open = OPEN_TICKET.card;
/* Readiness as the app shows it (ticket_widgets._readiness_row): one compact
 * row per platform. Platforms you post by hand count as ready and never block. */
const readiness = [
  { p: 'youtube', name: 'YouTube', state: 'ok', note: 'Ready to post' },
  { p: 'threads', name: 'Threads', state: 'ok', note: 'Ready to post' },
  { p: 'tiktok', name: 'TikTok', state: 'hand', note: 'Posted by hand' },
  { p: 'instagram', name: 'Instagram', state: 'hand', note: 'Posted by hand' },
] as const;
const MARK = { ok: '✓', hand: '–', bad: '!' } as const;
/* "Posting to" (ticket_widgets.PlatformPicker): one chip per platform, ticked = going there. Each ticked
 * platform then gets its caption box, whose header says where it stands, its count and a ⋯ menu
 * (Mark as Scheduled, Mark as Posted, Back to Preparing, Publish…). */
const CHIPS = [
  { p: 'youtube', name: 'YouTube', on: true }, { p: 'tiktok', name: 'TikTok', on: true },
  { p: 'instagram', name: 'Instagram', on: true }, { p: 'bluesky', name: 'Bluesky', on: false },
  { p: 'threads', name: 'Threads', on: true }, { p: 'facebook', name: 'Facebook', on: false },
] as const;
const SECTIONS = [
  { p: 'youtube', name: 'YouTube', state: 'Preparing', count: '94/5,000' },
] as const;
---
<div class="scale-stage">
  <div class="scene">
    <AppWindow title="Reelay" label="Reelay's Board: four columns of video cards, each with its platform logos and a status line, and the side panel showing the selected video, its readiness, where it is going and the Schedule button.">
      <div class="layout">
        <aside class="side glass-sidebar">
          <div class="profile">
            <span class="avatar">{CREATOR.initials}</span>
            <span class="pwho">
              <span class="pname">{CREATOR.name}</span>
              <span class="ptag">{CREATOR.tagline}</span>
            </span>
          </div>
          <ul class="snav glass-nav">
            <li>Library</li>
            <li class="on">Board</li>
            <li>Automations</li>
            <li>Accounts</li>
            <li>Settings</li>
          </ul>
          <div class="side-foot">
            <span>Help</span>
            <span class="ver">Reelay {SITE.versionNumber}</span>
          </div>
        </aside>

        <section class="board">
          <header class="bhead">
            <span class="bname glass-title">Board</span>
            <span class="search">
              <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="7" cy="7" r="4.6" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M10.5 10.5 14 14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
              Search titles, captions and what was said
            </span>
            <span class="bbtn glass-btn">
              <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2.5 4h11M4.5 8h7M6.5 12h3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
              Filter
            </span>
            <span class="bbtn glass-btn">Columns</span>
            <span class="bicon" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M13 8a5 5 0 1 1-1.5-3.6M13 2.8v2.6h-2.6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
            <span class="bicon" aria-hidden="true"><svg viewBox="0 0 16 16"><circle cx="3.5" cy="8" r="1.2" fill="currentColor"/><circle cx="8" cy="8" r="1.2" fill="currentColor"/><circle cx="12.5" cy="8" r="1.2" fill="currentColor"/></svg></span>
          </header>
          <div class="cols">
            {STAGES.map((stage) => {
              const cards = DEMO_CARDS.filter((d) => d.stage === stage);
              return (
                <div class="col glass-well">
                  <div class="col-head glass-heading"><span>{stage}</span><b class="tnum">{cards.length}</b></div>
                  <div class="col-sub">{STAGE_SUBTITLES[stage]}</div>
                  {cards.map((card) => (
                    <div class:list={['card', 'glass-card', { 'is-selected': card.id === open.id }]}>
                      <div class={`thumb still still--${card.still}`}>
                        <SourceBadge source={card.source} kind={card.kind} />
                        <span class="len tnum">{card.length}</span>
                      </div>
                      <div class="card-body">
                        <span class="ctitle">{card.title}</span>
                        <span class="cmeta tnum">{card.date} · {card.views} views</span>
                        <Coverage coverage={card.coverage} brand class="ccov" />
                        <span class={`cstatus tone-${card.tone}`}>{card.status}</span>
                      </div>
                    </div>
                  ))}
                </div>
              );
            })}
          </div>
        </section>

        <aside class="inspector glass-panel">
          <div class="ibody">
            <div class="player">
              <div class={`picture still still--${open.still}`}>
                <span class="play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5.5v13l10.5-6.5z" fill="currentColor"/></svg></span>
              </div>
              <div class="pbar" aria-hidden="true">
                <svg class="pbtn" viewBox="0 0 24 24"><path d="M8 5.5v13l10.5-6.5z" fill="currentColor"/></svg>
                <span class="scrub"><i style="width:41%"></i></span>
                <span class="time">0:09 / {open.length}</span>
                <span class="speed">1×</span>
              </div>
            </div>
            <div class="ititle">
              <span class="glass-title">{open.title}</span>
              <span class="stage-pill">{open.stage}</span>
            </div>
            <span class="imeta tnum">{open.kind} · {open.date} · {open.views} views</span>

            <div class="ready glass-panel">
              <!-- With every platform ready the line beside the ring is empty and hidden (ReadinessHeader), so the ring sits alone. -->
              <div class="ready-top">
                <GlassRing class="ring" ready={4} total={4} />
              </div>
              {readiness.map((r) => (
                <div class="rrow">
                  <PlatformIcon name={r.p} brand />
                  <span class="rname">{r.name}</span>
                  <span class="rnote">{r.note}</span>
                  <span class={`rmark rmark--${r.state}`}>{MARK[r.state]}</span>
                </div>
              ))}
            </div>

            <div class="sect">
              <div class="sect-h"><span class="glass-heading">Posting to</span><em class="tnum">4 preparing · 0 scheduled · 0 posted</em></div>
              <div class="chips">
                {CHIPS.map((c) => (
                  <span class:list={['chip', 'glass-chip', { on: c.on }]}><PlatformIcon name={c.p} brand />{c.name}</span>
                ))}
              </div>
              {SECTIONS.map((sec) => (
                <div class="psec">
                  <PlatformIcon name={sec.p} brand />
                  <b>{sec.name} ▸</b>
                  <span class="pstate">{sec.state}</span>
                  <span class="pcount tnum">{sec.count}</span>
                  <span class="pmore" aria-hidden="true">⋯</span>
                </div>
              ))}
            </div>
          </div>

          <div class="dock glass-dock">
            <span class="dock-sum">Goes live Tue 9:00 AM on YouTube, Threads.</span>
            <div class="dock-btns">
              <span class="dbtn glass-btn">Save Changes</span>
              <span class="dbtn glass-btn glass-btn--primary">Schedule</span>
            </div>
          </div>
        </aside>
      </div>
    </AppWindow>
  </div>
</div>

<style>
  .scale-stage { container-type: inline-size; width: 100%; }
  .scene {
    font-size: calc(100cqw / 76);
    --cov-ok: var(--app-ok); --cov-info: var(--app-info); --cov-bad: var(--app-bad);
    --cov-ring: var(--app-raised);
  }
  .layout {
    display: grid;
    grid-template-columns: 11.5em minmax(0, 1fr) 18.5em;
    height: 36em;
    color: var(--app-ink);
  }

  /* Sidebar */
  .side { display: flex; flex-direction: column; padding: 1em 0.7em; }
  .profile { display: flex; align-items: center; gap: 0.6em; padding: 0.2em 0.4em 1em; min-width: 0; }
  .avatar { flex: none; display: grid; place-items: center; width: 1.9em; height: 1.9em; border-radius: 50%; background: linear-gradient(135deg, #f5c56b, #d9653b); color: #1a0f04; font-size: 0.72em; font-weight: 700; }
  .pwho { display: grid; min-width: 0; }
  .pname { font-size: 0.82em; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ptag { font-size: 0.66em; color: var(--app-ink-2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .snav { list-style: none; display: grid; gap: 0.15em; }
  .snav li { font-size: 0.82em; padding: 0.55em 0.85em; color: var(--app-ink-2); }
  .snav li.on { font-weight: 600; }
  .side-foot { margin-top: auto; display: grid; gap: 0.35em; padding: 0 0.75em; font-size: 0.75em; color: var(--app-ink-2); }
  .ver { font-size: 0.9em; color: var(--app-muted); }

  /* Board */
  .board { display: flex; flex-direction: column; min-width: 0; padding: 0.9em 0.9em 0.9em 1em; }
  .bhead { display: flex; align-items: center; gap: 0.5em; margin-bottom: 0.9em; }
  .bname { font-size: 1.15em; margin-right: 0.4em; }
  /* Fields are solid in glass too (app.qss QLineEdit): raised, a #32415c border, 11px radius. */
  .search { flex: 1; display: flex; align-items: center; gap: 0.5em; height: 2.1em; padding: 0 0.75em; border-radius: 0.6875em; background: var(--app-raised); box-shadow: inset 0 0 0 0.0625em var(--app-border); font-size: 0.74em; color: var(--app-muted); white-space: nowrap; overflow: hidden; }
  .search svg { width: 1em; height: 1em; flex: none; }
  .bbtn { display: inline-flex; align-items: center; gap: 0.45em; font-size: 0.72em; font-weight: 600; padding: 0.5em 0.85em; white-space: nowrap; }
  .bbtn svg { width: 1em; height: 1em; }
  .bicon { display: grid; place-items: center; width: 1.6em; height: 1.6em; border-radius: 0.45em; color: var(--app-ink-2); }
  .bicon svg { width: 0.85em; height: 0.85em; }
  .cols { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.7em; flex: 1; min-height: 0; }
  .col { display: flex; flex-direction: column; gap: 0.6em; padding: 0.6em; min-width: 0; overflow: hidden; }
  /* The column's name leads, in ink at 700; what it holds sits under it in muted (app.qss ColumnTitle / ColumnPurpose). */
  .col-head { display: flex; justify-content: space-between; align-items: center; padding: 0.15em 0.25em 0.2em; font-size: 0.8em; font-weight: 700; color: var(--app-ink); }
  .col-sub { margin-top: -0.55em; padding: 0 0.3em 0.1em; font-size: 0.6em; color: var(--app-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  /* ColumnCount: a solid card-coloured chip with a hairline, 9px radius. */
  .col-head b { font-size: 0.78em; font-weight: 600; color: var(--app-ink-2); padding: 0.1em 0.6em; border-radius: 0.5625em; background: var(--app-raised); box-shadow: inset 0 0 0 0.0625em #28344a; }
  .card { flex: none; overflow: hidden; }
  .thumb { aspect-ratio: 16 / 9; }
  .len { position: absolute; z-index: 1; font-size: 0.56em; font-weight: 700; padding: 0.18em 0.45em; border-radius: 0.35em; background: rgba(0, 0, 0, 0.6); color: #fff; white-space: nowrap; }
  .thumb :global(.src-badge) { font-size: 0.6em; }
  .len { right: 0.45em; bottom: 0.4em; }
  .card-body { display: grid; gap: 0.4em; padding: 0.55em 0.6em 0.65em; }
  .ctitle { font-size: 0.7em; font-weight: 600; line-height: 1.25; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .cmeta { font-size: 0.58em; color: var(--app-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .card-body :global(.ccov) { font-size: 0.72em; padding: 0.15em 0 0.1em; }
  .cstatus { font-size: 0.6em; color: var(--app-ink-2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .tone-needs { color: var(--app-bad); }
  .tone-ready { color: var(--app-ink-2); }
  .tone-muted { color: var(--app-muted); }
  .tone-sched { color: var(--app-info); }
  .tone-live { color: var(--app-ok); }

  /* Side panel: the ticket */
  .inspector { display: flex; flex-direction: column; margin: 0.6em 0.6em 0.6em 0; min-width: 0; min-height: 0; overflow: hidden; }
  .ibody { flex: 1; min-height: 0; overflow: hidden; display: flex; flex-direction: column; gap: 0.6em; padding: 0.8em 0.8em 0.4em; }
  /* The player (player.py): the picture with the large accent play button over it, and under it the
     player bar on the surface colour: play, an accent scrubber on a pressed-colour groove, the time, speed. */
  .player { flex: none; display: flex; flex-direction: column; overflow: hidden; background: var(--app-surface); }
  .picture { position: relative; height: 6em; }
  .play { position: absolute; z-index: 2; left: 50%; top: 50%; display: grid; place-items: center; width: 2.6em; height: 2.6em; margin: -1.3em 0 0 -1.3em; border-radius: 50%; background: var(--app-accent); color: var(--app-on-accent); }
  .play svg { width: 1.2em; height: 1.2em; margin-left: 0.15em; }
  .pbar { display: flex; align-items: center; gap: 0.5em; height: 1.6em; padding: 0 0.4em; box-shadow: inset 0 -0.0625em 0 var(--app-divider); }
  .pbtn { flex: none; width: 0.75em; height: 0.75em; color: var(--app-ink-2); }
  .scrub { flex: 1; position: relative; height: 0.25em; border-radius: 1em; background: var(--app-pressed); }
  .scrub i { display: block; height: 100%; border-radius: inherit; background: var(--app-accent); position: relative; }
  .scrub i::after { content: ''; position: absolute; right: -0.375em; top: 50%; width: 0.75em; height: 0.75em; margin-top: -0.375em; border-radius: 50%; background: var(--app-accent); }
  .time, .speed { flex: none; font-size: 0.6em; font-weight: 600; font-variant-numeric: tabular-nums; color: var(--app-ink-2); }
  .ititle { display: flex; align-items: center; justify-content: space-between; gap: 0.6em; margin-bottom: -0.45em; }
  .ititle > span:first-child { font-size: 0.92em; line-height: 1.2; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  /* StagePill: raised, divider hairline, 9px radius. */
  .stage-pill { flex: none; font-size: 0.58em; font-weight: 600; padding: 0.25em 0.75em; border-radius: 0.5625em; background: var(--app-raised); box-shadow: inset 0 0 0 0.0625em var(--app-divider); color: var(--app-ink-2); }
  .imeta { font-size: 0.62em; color: var(--app-muted); }

  /* Readiness (ticket_widgets.ReadinessHeader): a glass card; the ring, then one row per platform,
     each divided from the last by a hairline, no fill of its own. */
  .ready { display: grid; padding: 0.5em 0.75em 0.4em; }
  .ready-top { display: flex; justify-content: center; margin-bottom: 0.3em; }
  .ready-top :global(.ring) { flex: none; width: 2.4em; height: 2.4em; }
  .rrow { display: grid; grid-template-columns: 0.9em 5em minmax(0, 1fr) 0.8em; align-items: center; gap: 0.55em; padding: 0.35em 0.7em 0.35em 0.55em; box-shadow: inset 0 0.0625em 0 var(--glass-edge); font-size: 0.64em; }
  .rrow :global(svg) { width: 0.9em; height: 0.9em; }
  .rname { font-weight: 600; }
  .rnote { color: var(--app-ink-2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .rmark { text-align: right; font-weight: 700; }
  .rmark--ok { color: var(--app-ink); }
  .rmark--hand { color: var(--app-muted); }
  .rmark--bad { color: var(--app-bad); }

  .sect { display: grid; gap: 0.5em; }
    /* The summary sits on its own line under the heading, as in the glass inspector. */
  .sect-h { display: grid; gap: 0.2em; font-size: 0.68em; font-weight: 600; color: var(--app-ink-2); }
  .sect-h em { font-style: normal; font-weight: 400; font-size: 0.9em; color: var(--app-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .chips { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.3em; }
  .chip { display: flex; align-items: center; gap: 0.4em; min-width: 0; padding: 0.58em 0.7em; font-size: 0.56em; white-space: nowrap; overflow: hidden; }
  .chip :global(svg) { flex: none; width: 1.1em; height: 1.1em; }
  /* One caption card per ticked platform (app.qss PlatformCopy): a raised gradient, .10 hairline, .26 top edge, 18px radius. */
  .psec { display: grid; grid-template-columns: 1em auto minmax(0, 1fr) auto 1em; align-items: center; gap: 0.5em; padding: 0.55em 0.75em; border-radius: 1.125em; background: linear-gradient(180deg, #272e40, #1c2436); box-shadow: inset 0 0 0 0.0625em var(--glass-line), inset 0 0.0625em 0 var(--glass-top); font-size: 0.62em; }
  .psec :global(svg) { width: 1em; height: 1em; }
  .pstate { color: var(--app-ink-2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .pcount { color: var(--app-muted); font-variant-numeric: tabular-nums; }
  .pmore { color: var(--app-ink-2); text-align: right; }

  .dock { flex: none; display: grid; gap: 0.5em; padding: 0.7em 0.9em 0.85em; }
  .dock-sum { font-size: 0.6em; color: var(--app-ink-2); }
  .dock-btns { display: flex; justify-content: flex-end; gap: 0.5em; }
  .dbtn { font-size: 0.64em; font-weight: 600; padding: 0.5em 0.85em; }

  /* Phone: the side panel on its own, readable, like a cropped close-up. */
  @container (max-width: 620px) {
    .scene { font-size: calc(100cqw / 21); }
    .layout { grid-template-columns: minmax(0, 1fr); height: auto; }
    .side, .board { display: none; }
    .inspector { margin: 0.6em; }
    .picture { height: 16em; }
  }
</style>
