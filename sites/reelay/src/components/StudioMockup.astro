---
---

<section class="mockup-section" id="studio-preview">
  <div class="container">
    <div class="window-frame">
      <!-- Window Chrome / Titlebar -->
      <div class="window-titlebar">
        <div class="window-traffic-lights">
          <span class="light red"></span>
          <span class="light yellow"></span>
          <span class="light green"></span>
        </div>
        <div class="window-title">Reelay Studio — Project: 2026_Q4_Shorts_Pipeline</div>
        <div class="window-version font-mono">macOS Native • v0.12.0 Beta</div>
      </div>

      <!-- App Sub-header / Mode Tabs -->
      <div class="app-toolbar">
        <div class="app-tabs">
          <button class="app-tab active">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polygon points="23 7 16 12 23 17 23 7"></polygon>
              <rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
            </svg>
            Studio Player & Media Library
          </button>
          <button class="app-tab">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="3" width="7" height="18"></rect>
              <rect x="14" y="3" width="7" height="10"></rect>
            </svg>
            Kanban Pipeline
            <span class="tab-counter">14</span>
          </button>
          <button class="app-tab">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="16 18 22 12 16 6"></polyline>
              <polyline points="8 6 2 12 8 18"></polyline>
            </svg>
            Rules & Automations
          </button>
          <button class="app-tab">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm1 14.5h-2v-2h2zm0-4.5h-2V7h2z"></path>
            </svg>
            AI Companion (MCP)
          </button>
        </div>
        <div class="app-toolbar-right">
          <span class="badge">Hardware 60 FPS</span>
        </div>
      </div>

      <!-- Main Workspace Grid -->
      <div class="workspace-grid">
        <!-- Left: In-App Video Player -->
        <div class="player-pane">
          <div class="player-topbar">
            <div class="ratio-toggle">
              <span class="toggle-pill active">9:16 Vertical</span>
              <span class="toggle-pill">16:9 Longform</span>
            </div>
            <div class="codec-pill">AV1 / VP9 Proxy</div>
          </div>

          <!-- Video Canvas Mock -->
          <div class="video-canvas">
            <div class="video-preview-phone">
              <div class="phone-screen">
                <div class="video-watermark">REELAY PREVIEW</div>
                <div class="video-center-graphic">
                  <div class="sound-wave">
                    <span></span><span></span><span></span><span></span><span></span>
                  </div>
                  <div class="preview-text">"Local-first content operations for multi-platform video creators."</div>
                </div>
                <div class="video-overlay-captions">
                  <span class="caption-word active">Stop</span>
                  <span class="caption-word active">organizing</span>
                  <span class="caption-word active">in</span>
                  <span class="caption-word">spreadsheets</span>
                </div>
              </div>
            </div>

            <!-- Scrubber bar -->
            <div class="player-controls">
              <div class="scrub-timeline">
                <div class="scrub-progress" style="width: 42%;"></div>
                <div class="scrub-handle" style="left: 42%;"></div>
              </div>
              <div class="controls-bar">
                <div class="ctrl-left">
                  <button class="ctrl-btn play-btn" aria-label="Play">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                      <polygon points="5 3 19 12 5 21 5 3"></polygon>
                    </svg>
                  </button>
                  <span class="time-label">00:24.12 / 00:58.00</span>
                </div>
                <div class="ctrl-right">
                  <span class="speed-label">1.5x</span>
                  <button class="ctrl-btn" aria-label="Loop">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <polyline points="17 1 21 5 17 9"></polyline>
                      <path d="M3 11V9a4 4 0 0 1 4-4h14"></path>
                      <polyline points="7 23 3 19 7 15"></polyline>
                      <path d="M21 13v2a4 4 0 0 1-4 4H3"></path>
                    </svg>
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Right: Inspector (Transcript + Multi-platform Coverage) -->
        <div class="inspector-pane">
          <!-- Whisper Transcript Section -->
          <div class="inspector-card">
            <div class="inspector-card-header">
              <div class="card-header-title">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"></path>
                  <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
                  <line x1="12" y1="19" x2="12" y2="23"></line>
                </svg>
                <span>Offline Whisper AI Transcript</span>
              </div>
              <span class="badge">FTS5 Indexed</span>
            </div>
            <div class="transcript-stream">
              <div class="transcript-line">
                <span class="ts-time">00:02</span>
                <span class="ts-text">Stop organizing your video assets across fragmented spreadsheets.</span>
              </div>
              <div class="transcript-line active">
                <span class="ts-time">00:12</span>
                <span class="ts-text">Reelay pulls high-fidelity media directly from YouTube, TikTok and Instagram.</span>
              </div>
              <div class="transcript-line">
                <span class="ts-time">00:24</span>
                <span class="ts-text">Your API credentials stay safely locked in your local OS Keychain.</span>
              </div>
            </div>
          </div>

          <!-- Multi-platform Coverage Map -->
          <div class="inspector-card">
            <div class="inspector-card-header">
              <div class="card-header-title">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10"></circle>
                  <line x1="2" y1="12" x2="22" y2="12"></line>
                  <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                </svg>
                <span>Cross-Platform Coverage Map</span>
              </div>
              <span class="status-summary">3/5 Ready</span>
            </div>
            <div class="platform-rows">
              <div class="platform-row">
                <div class="platform-meta">
                  <span class="platform-indicator ready"></span>
                  <span class="platform-name">YouTube Shorts</span>
                </div>
                <span class="platform-status status-ready">Ready</span>
              </div>
              <div class="platform-row">
                <div class="platform-meta">
                  <span class="platform-indicator ready"></span>
                  <span class="platform-name">Instagram Reels</span>
                </div>
                <span class="platform-status status-ready">Ready</span>
              </div>
              <div class="platform-row">
                <div class="platform-meta">
                  <span class="platform-indicator pending"></span>
                  <span class="platform-name">TikTok</span>
                </div>
                <span class="platform-status status-pending">Drafting</span>
              </div>
              <div class="platform-row">
                <div class="platform-meta">
                  <span class="platform-indicator ready"></span>
                  <span class="platform-name">Threads</span>
                </div>
                <span class="platform-status status-ready">Handoff Ready</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- App Bottom Statusbar -->
      <div class="app-statusbar">
        <div class="status-seg">
          <span class="status-icon">●</span>
          <span>SQLite Store: ~/Library/Application Support/reelay/app.db (1.4 GB)</span>
        </div>
        <div class="status-seg">
          <span class="status-icon">●</span>
          <span>OS Keychain: 4 Accounts Encrypted</span>
        </div>
        <div class="status-seg">
          <span class="status-icon">●</span>
          <span>MCP Tunnel: 127.0.0.1:4482 Active</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .mockup-section {
    padding-bottom: clamp(3rem, 6vw, 6rem);
  }

  .window-frame {
    background-color: #0c0d12;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: var(--radius-lg);
    box-shadow: 0 30px 90px rgba(0, 0, 0, 0.85), 0 0 0 1px rgba(255, 255, 255, 0.08), 0 0 80px rgba(229, 169, 60, 0.08);
    overflow: hidden;
  }

  .window-titlebar {
    background-color: #0c0d11;
    padding: 0.75rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--hairline);
  }

  .window-traffic-lights {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .light {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .light.red { background-color: #ff5f56; }
  .light.yellow { background-color: #ffbd2e; }
  .light.green { background-color: #27c93f; }

  .window-title {
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .window-version {
    font-size: 0.72rem;
    color: var(--text-dim);
    font-family: var(--font-mono);
  }

  .app-toolbar {
    background-color: var(--color-surface-2);
    padding: 0.5rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--hairline);
    overflow-x: auto;
  }

  .app-tabs {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .app-tab {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    background: transparent;
    border: none;
    color: var(--text-muted);
    font-size: 0.8rem;
    font-weight: 500;
    padding: 0.4rem 0.75rem;
    border-radius: 4px;
    cursor: default;
    white-space: nowrap;
  }

  .app-tab.active {
    background-color: var(--color-surface-elevated);
    color: #ffffff;
  }

  .tab-counter {
    background-color: var(--color-surface);
    color: var(--text-secondary);
    border: 1px solid var(--hairline);
    font-size: 0.7rem;
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
  }

  .workspace-grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    background-color: #0b0c10;
    min-height: 460px;
  }

  .player-pane {
    border-right: 1px solid var(--hairline);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .player-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .ratio-toggle {
    display: flex;
    background-color: var(--color-surface-2);
    padding: 0.2rem;
    border-radius: 4px;
    border: 1px solid var(--hairline);
  }

  .toggle-pill {
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.25rem 0.6rem;
    border-radius: 3px;
    color: var(--text-muted);
  }

  .toggle-pill.active {
    background-color: rgba(255, 255, 255, 0.1);
    color: #ffffff;
  }

  .codec-pill {
    font-size: 0.72rem;
    font-family: var(--font-mono);
    color: var(--text-muted);
    background-color: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--hairline);
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
  }

  .video-canvas {
    background-color: #070709;
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 1.25rem;
    position: relative;
  }

  .video-preview-phone {
    width: 210px;
    height: 330px;
    background-color: #121318;
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.8);
    position: relative;
    overflow: hidden;
  }

  .phone-screen {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 0.85rem;
    background: linear-gradient(180deg, #171820 0%, #0d0e12 100%);
  }

  .video-watermark {
    font-size: 0.58rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.25);
    letter-spacing: 0.1em;
  }

  .video-center-graphic {
    text-align: center;
  }

  .sound-wave {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 3px;
    margin-bottom: 0.5rem;
  }

  .sound-wave span {
    width: 3px;
    height: 16px;
    background-color: var(--brand);
    border-radius: 1px;
    animation: wave 1.2s infinite ease-in-out;
  }
  .sound-wave span:nth-child(2) { height: 26px; animation-delay: 0.15s; }
  .sound-wave span:nth-child(3) { height: 34px; animation-delay: 0.3s; }
  .sound-wave span:nth-child(4) { height: 20px; animation-delay: 0.45s; }
  .sound-wave span:nth-child(5) { height: 12px; animation-delay: 0.6s; }

  @keyframes wave {
    0%, 100% { transform: scaleY(0.4); }
    50% { transform: scaleY(1); }
  }

  .preview-text {
    font-size: 0.72rem;
    color: var(--text-secondary);
    line-height: 1.3;
  }

  .video-overlay-captions {
    background-color: rgba(0, 0, 0, 0.7);
    border-radius: 4px;
    padding: 0.35rem 0.5rem;
    font-size: 0.72rem;
    font-weight: 600;
    text-align: center;
  }

  .caption-word {
    color: rgba(255, 255, 255, 0.4);
    margin: 0 1px;
  }
  .caption-word.active {
    color: #ffffff;
  }

  .player-controls {
    width: 100%;
    margin-top: 1rem;
  }

  .scrub-timeline {
    width: 100%;
    height: 4px;
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 2px;
    position: relative;
    cursor: pointer;
  }

  .scrub-progress {
    height: 100%;
    background-color: var(--brand);
    border-radius: 2px;
  }

  .scrub-handle {
    position: absolute;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: #ffffff;
  }

  .controls-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 0.75rem;
  }

  .ctrl-left, .ctrl-right {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .ctrl-btn {
    background-color: var(--color-surface-2);
    border: 1px solid var(--hairline);
    color: var(--text-primary);
    width: 26px;
    height: 26px;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  .time-label, .speed-label {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    color: var(--text-muted);
  }

  .inspector-pane {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .inspector-card {
    background-color: var(--color-surface-2);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    padding: 1.15rem;
  }

  .inspector-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.85rem;
    border-bottom: 1px solid var(--hairline);
    padding-bottom: 0.65rem;
  }

  .card-header-title {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: #ffffff;
  }

  .status-summary {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    color: var(--text-muted);
  }

  .transcript-stream {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .transcript-line {
    display: flex;
    gap: 0.65rem;
    font-size: 0.8rem;
    padding: 0.4rem 0.5rem;
    border-radius: 4px;
    transition: background-color 0.15s ease;
  }

  .transcript-line.active {
    background-color: rgba(255, 255, 255, 0.04);
    border-left: 2px solid var(--brand);
  }

  .ts-time {
    font-family: var(--font-mono);
    color: var(--text-muted);
    font-size: 0.75rem;
    flex-shrink: 0;
  }

  .ts-text {
    color: var(--text-secondary);
    line-height: 1.4;
  }

  .platform-rows {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .platform-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.45rem 0.6rem;
    background-color: rgba(255, 255, 255, 0.015);
    border-radius: 4px;
    font-size: 0.82rem;
  }

  .platform-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .platform-indicator {
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }
  .platform-indicator.ready { background-color: var(--brand); }
  .platform-indicator.pending { background-color: var(--text-dim); }

  .platform-status {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .app-statusbar {
    background-color: #0b0c10;
    border-top: 1px solid var(--hairline);
    padding: 0.4rem 1.25rem;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    font-size: 0.72rem;
    font-family: var(--font-mono);
    color: var(--text-dim);
    overflow-x: auto;
  }

  .status-seg {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    white-space: nowrap;
  }

  .status-icon {
    color: var(--brand);
    font-size: 0.6rem;
  }

  @media (max-width: 900px) {
    .workspace-grid {
      grid-template-columns: 1fr;
    }
    .player-pane {
      border-right: none;
      border-bottom: 1px solid var(--hairline);
    }
  }

  @media (max-width: 640px) {
    .window-titlebar {
      padding: 0.6rem 0.85rem;
    }
    .window-title {
      font-size: 0.72rem;
    }
    .window-version {
      display: none;
    }
    .app-toolbar {
      padding: 0.4rem 0.75rem;
    }
    .app-toolbar-right {
      display: none;
    }
    .player-pane {
      padding: 0.85rem;
    }
    .inspector-pane {
      padding: 0.85rem;
    }
    .video-preview-phone {
      width: 150px;
      height: 250px;
    }
  }
</style>
