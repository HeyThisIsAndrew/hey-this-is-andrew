---
import SectionHeader from '@andrew/ui/SectionHeader.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '');
---

<section class="section privacy-section" id="privacy-first">
  <div class="container">
    <SectionHeader
      index="03"
      kicker="LOCAL-FIRST SOVEREIGNTY"
      title="Your Computer is the Cloud"
      lede="Your credentials stay in your Mac Keychain. Your videos stay on your NVMe hard drive. Your drafts live in local SQLite. No tracking, no subscription traps, no server outages."
      id="privacy-first"
    />

    <div class="privacy-card-wrap">
      <div class="architecture-grid">
        <!-- Arch Card 1 -->
        <div class="arch-card">
          <div class="arch-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
              <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path>
              <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path>
            </svg>
          </div>
          <h4>Local SQLite Database</h4>
          <p>
            All video metadata, column positions, tags, and automation rules are stored in a fast local SQLite database on your machine. You can back it up, query it, or export it anytime.
          </p>
          <span class="path-badge">~/Library/Application Support/reelay/app.db</span>
        </div>

        <!-- Arch Card 2 -->
        <div class="arch-card">
          <div class="arch-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
          </div>
          <h4>OS Keychain Token Protection</h4>
          <p>
            OAuth access tokens for YouTube, TikTok, and Meta are encrypted by your operating system's hardware keychain. They are never transmitted to Reelay or any third-party telemetry server.
          </p>
          <span class="path-badge">macOS Keychain / Windows Credential Manager</span>
        </div>

        <!-- Arch Card 3 -->
        <div class="arch-card">
          <div class="arch-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
          </div>
          <h4>Direct Platform Dispatch</h4>
          <p>
            When publishing a video to YouTube Shorts or Instagram Reels, your desktop application connects directly to Google and Meta endpoints from your personal network connection.
          </p>
          <span class="path-badge">Direct HTTPS • Zero Middleware Proxies</span>
        </div>

        <!-- Arch Card 4 -->
        <div class="arch-card">
          <div class="arch-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <polygon points="10 8 16 12 10 16 10 8"></polygon>
            </svg>
          </div>
          <h4>Offline Whisper AI Processing</h4>
          <p>
            Speech-to-text models run directly on your workstation GPU (Apple Silicon Metal / DirectX). Spoken transcripts are generated locally without uploading creator audio to third-party clouds.
          </p>
          <span class="path-badge">Local GPU Inference • 100% Offline</span>
        </div>
      </div>

      <!-- Quick Compliance Links Box -->
      <div class="compliance-mini-bar">
        <div class="compliance-mini-text">
          <strong>Reviewer & Enterprise Ready:</strong> Explicitly compliant with Google API Limited Use Policy and Meta Platform Terms.
        </div>
        <div class="compliance-mini-links">
          <a href={`${base}/privacy`}>Read Privacy Policy →</a>
          <a href={`${base}/data-deletion`}>Data Deletion Guide →</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .privacy-section {
    position: relative;
    background-color: transparent;
  }

  .privacy-card-wrap {
    margin-top: 2.5rem;
  }

  .architecture-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.75rem;
    margin-bottom: 2rem;
  }

  .arch-card {
    background-color: var(--color-surface);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
  }

  .arch-icon {
    width: 44px;
    height: 44px;
    border-radius: var(--radius);
    background-color: var(--color-surface-2);
    color: var(--brand);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
    border: 1px solid var(--hairline);
  }

  .arch-card h4 {
    font-size: 1.15rem;
    margin-bottom: 0.65rem;
    color: #ffffff;
  }

  .arch-card p {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 1.25rem;
    flex: 1;
  }

  .path-badge {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-dim);
    background-color: var(--color-surface-2);
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
    border: 1px solid var(--hairline);
    width: fit-content;
  }

  .compliance-mini-bar {
    background-color: var(--color-surface);
    border: 1px solid var(--hairline-strong);
    border-radius: var(--radius);
    padding: 1.25rem 1.75rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .compliance-mini-text {
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  .compliance-mini-text strong {
    color: #ffffff;
  }

  .compliance-mini-links {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    font-size: 0.88rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .compliance-mini-links a {
    color: var(--text-primary);
  }

  .compliance-mini-links a:hover {
    color: var(--brand);
  }

  @media (max-width: 840px) {
    .architecture-grid {
      grid-template-columns: 1fr;
    }
    .compliance-mini-bar {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
