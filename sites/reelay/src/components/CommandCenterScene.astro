---
/**
 * CommandCenterScene: the Board's side panel (reelay/gui/post_panel.py,
 * ticket_widgets.py): the video on top, the readiness ring (how many of the
 * platforms it's going to are ready, posted-by-hand ones included) over one
 * compact row per platform, "Posting to" (one chip per platform, ticked =
 * going there), each ticked platform's caption box with where it stands, its
 * count and a ⋯ menu, and Save Changes / Schedule pinned at the bottom with one
 * line saying exactly what will happen. Drawn in the app's Spatial Glass
 * theme: a frosted panel on the glass canvas (src/styles/glass.css).
 */
import PlatformIcon from './ui/PlatformIcon.astro';
import { OPEN_TICKET } from '../data/demo';

const card = OPEN_TICKET.card;
/* ticket_widgets._readiness_row: ✓ ready, – posted by hand, ! blocking (its first problem as the note). */
const platforms = [
  { p: 'youtube', name: 'YouTube', note: 'Ready to post', tone: 'ok' },
  { p: 'threads', name: 'Threads', note: 'Ready to post', tone: 'ok' },
  { p: 'facebook', name: 'Facebook', note: 'Write the Facebook text', tone: 'bad' },
  { p: 'tiktok', name: 'TikTok', note: 'Posted by hand', tone: 'hand' },
] as const;
const MARK = { ok: '✓', hand: '–', bad: '!' } as const;
const ready = platforms.filter((p) => p.tone !== 'bad').length;
const total = platforms.length;
const C = 2 * Math.PI * 15.5;
const ringId = `glass-ring-${Math.random().toString(36).slice(2, 8)}`;
const CHIPS = [
  { p: 'youtube', name: 'YouTube', on: true }, { p: 'tiktok', name: 'TikTok', on: true },
  { p: 'instagram', name: 'Instagram', on: false }, { p: 'bluesky', name: 'Bluesky', on: false },
  { p: 'threads', name: 'Threads', on: true }, { p: 'facebook', name: 'Facebook', on: true },
] as const;
---
<div class="ccs" role="img" aria-label={`The side panel: ${card.title} playing above a readiness ring showing ${ready} of ${total} platforms ready, a row per platform, the Posting to chips, the TikTok caption, and Save Changes and Schedule buttons.`}>
  <div class="cc-panel">
    <div class={`cc-video still still--${card.still}`}>
      <span class="cc-play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5.5v13l10.5-6.5z" fill="currentColor"/></svg></span>
      <span class="cc-time tnum">0:09 / {card.length}</span>
    </div>
    <div class="cc-titlebar">
      <strong class="glass-title">{card.title}</strong>
      <span class="cc-stage">{card.stage}</span>
    </div>
    <div class="cc-head">
      <svg class="ring glass-ring" viewBox="0 0 36 36" aria-hidden="true">
        <defs><linearGradient id={ringId} x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#70b6ff" /><stop offset="1" stop-color="#4da3ff" /></linearGradient></defs>
        <circle class="ring-disc" cx="18" cy="18" r="13" />
        <circle class="ring-track" cx="18" cy="18" r="15.5" />
        <circle class="ring-arc" cx="18" cy="18" r="15.5" stroke={`url(#${ringId})`} stroke-dasharray={`${(ready / total) * C} ${C}`} transform="rotate(-90 18 18)" />
        <text x="18" y="21" text-anchor="middle">{ready}/{total}</text>
      </svg>
      <span class="cc-sum">Ready for YouTube, Threads, TikTok (by hand). Not ready for Facebook.</span>
    </div>
    <ul class="cc-pfs">
      {platforms.map((p) => (
        <li>
          <PlatformIcon name={p.p} brand />
          <span class="n">{p.name}</span>
          <span class="note">{p.note}</span>
          <span class={`mk mk--${p.tone}`}>{MARK[p.tone]}</span>
        </li>
      ))}
    </ul>
    <div class="cc-sect">
      <span class="cc-sect-h"><span class="glass-heading">Posting to</span><em class="tnum">4 preparing · 0 scheduled · 0 posted</em></span>
      <div class="cc-chips">
        {CHIPS.map((c) => <span class:list={['cc-chip', 'glass-chip', { on: c.on }]}><PlatformIcon name={c.p} brand />{c.name}</span>)}
      </div>
    </div>
    <div class="cc-copy">
      <div class="cc-psec"><PlatformIcon name="youtube" brand /><b>YouTube ▸</b><span>Preparing</span><em class="tnum">94/5,000</em><i aria-hidden="true">⋯</i></div>
      <div class="cc-psec"><PlatformIcon name="tiktok" brand /><b>TikTok ▾</b><span>Preparing</span><em class="tnum">124/4,000</em><i aria-hidden="true">⋯</i></div>
      <div class="cc-box"><p>{OPEN_TICKET.caption}</p></div>
    </div>
    <div class="cc-dock glass-dock">
      <span class="cc-what">Goes live Tue 9:00 AM on YouTube, Threads.</span>
      <div class="cc-btns">
        <span class="cc-btn glass-btn">Save Changes</span>
        <span class="cc-btn glass-btn glass-btn--primary">Schedule</span>
      </div>
    </div>
  </div>
</div>

<style>
  .ccs { display: flex; justify-content: center; }
  .cc-panel {
    width: min(100%, 420px);
    min-width: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.85rem;
    padding: 1rem;
    padding-bottom: 0;
    border-radius: 22px;
    /* The frosted panel, painted over the glass canvas it sits on in the app. */
    background: var(--glass-panel), var(--glass-canvas);
    color: var(--app-ink);
    box-shadow: var(--glass-frame), inset 0 0 0 1px var(--glass-line), inset 0 1px 0 var(--glass-top);
    font-size: 0.9rem;
    overflow: hidden;
    --row: rgba(242, 246, 252, 0.05);
    --row-line: inset 0 0 0 1px var(--glass-line);
  }
  .cc-video { position: relative; aspect-ratio: 9 / 10; border-radius: 14px; }
  .cc-play { position: absolute; z-index: 2; left: 50%; top: 46%; display: grid; place-items: center; width: 3.4rem; height: 3.4rem; margin: -1.7rem 0 0 -1.7rem; border-radius: 50%; background: rgba(255, 255, 255, 0.22); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); color: #fff; }
  .cc-play svg { width: 1.4rem; height: 1.4rem; margin-left: 0.15rem; }
  .cc-time { position: absolute; z-index: 2; left: 0.8rem; bottom: 0.7rem; font-size: 0.75rem; font-weight: 600; color: #fff; }
  .cc-titlebar { display: flex; align-items: center; justify-content: space-between; gap: 0.6rem; }
  .cc-titlebar strong { font-size: 1.05rem; color: var(--app-ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .cc-stage { flex: none; font-size: 0.72rem; font-weight: 600; padding: 0.2rem 0.65rem; border-radius: 999px; background: rgba(242, 246, 252, 0.07); box-shadow: var(--row-line); color: var(--app-ink-2); }
  .cc-head { display: flex; align-items: center; gap: 0.8rem; min-width: 0; }
  .cc-sum { min-width: 0; }
  .ring { width: 3rem; height: 3rem; flex: none; }
  .ring text { font-size: 9px; }
  .cc-sum { font-size: 0.8rem; line-height: 1.4; color: var(--app-ink-2); }
  .cc-pfs { list-style: none; display: grid; gap: 0.3rem; }
  .cc-pfs li { display: grid; grid-template-columns: 1rem 5.2rem minmax(0, 1fr) 0.8rem; align-items: center; gap: 0.6rem; padding: 0.45rem 0.8rem 0.45rem 0.65rem; border-radius: 10px; background: var(--row); box-shadow: var(--row-line); font-size: 0.82rem; }
  .cc-pfs :global(svg) { width: 1rem; height: 1rem; }
  .n { font-weight: 600; }
  .note { color: var(--app-ink-2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .mk { text-align: right; font-weight: 700; }
  .mk--ok { color: var(--app-ink); }
  .mk--bad { color: var(--app-bad); }
  .mk--hand { color: var(--app-muted); }
  .cc-sect { display: grid; grid-template-columns: minmax(0, 1fr); gap: 0.5rem; min-width: 0; }
    /* The summary sits on its own line under the heading. */
  .cc-sect-h { display: grid; gap: 0.15rem; font-size: 0.82rem; font-weight: 600; color: var(--app-ink-2); }
  .cc-sect-h em { font-style: normal; font-weight: 400; font-size: 0.76rem; color: var(--app-muted); min-width: 0; }
  .cc-chips { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.35rem; }
  .cc-chip { display: flex; align-items: center; gap: 0.4rem; min-width: 0; padding: 7px 10px; border-radius: 10px; font-size: 0.76rem; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .cc-chip :global(svg) { flex: none; width: 1rem; height: 1rem; }
  .cc-psec { display: grid; grid-template-columns: 1rem auto minmax(0, 1fr) auto 1rem; align-items: center; gap: 0.5rem; padding: 0.45rem 0.7rem; border-radius: 10px; background: var(--row); box-shadow: var(--row-line); font-size: 0.8rem; }
  .cc-psec :global(svg) { width: 1rem; height: 1rem; }
  .cc-psec span { color: var(--app-ink-2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .cc-psec em { font-style: normal; color: var(--app-muted); font-variant-numeric: tabular-nums; }
  .cc-psec i { font-style: normal; color: var(--app-ink-2); text-align: right; }
  .cc-copy { display: grid; gap: 0.4rem; }
  .cc-box { padding: 0.6rem 0.75rem; border-radius: 10px; background: rgba(11, 15, 23, 0.42); box-shadow: var(--row-line); }
  .cc-copy p { font-size: 0.8rem; line-height: 1.45; color: var(--app-ink-2); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .cc-dock { display: grid; gap: 0.55rem; margin: 0 -1rem; padding: 0.8rem 1rem 1rem; border-radius: 0 0 22px 22px; box-shadow: inset 0 1px 0 var(--glass-dock-top); }
  .cc-what { font-size: 0.78rem; line-height: 1.4; color: var(--app-ink-2); }
  .cc-btns { display: flex; justify-content: flex-end; gap: 0.5rem; }
  .cc-btn { text-align: center; padding: 0.55rem 1rem; border-radius: 12px; font-weight: 600; font-size: 0.84rem; }
  @media (max-width: 360px) {
    .cc-panel { padding: 0.75rem 0.75rem 0; }
    .cc-dock { margin: 0 -0.75rem; padding: 0.75rem; }
    .cc-chip { font-size: 0.66rem; padding: 0.35rem 0.35rem; gap: 0.25rem; }
    .cc-psec { font-size: 0.72rem; gap: 0.35rem; padding: 0.4rem 0.5rem; }
    .cc-pfs li { grid-template-columns: 1rem 4.4rem minmax(0, 1fr) 0.8rem; gap: 0.45rem; }
    .cc-btns .cc-btn { flex: 1; white-space: nowrap; padding: 0.55rem 0.5rem; font-size: 0.8rem; }
  }
</style>
