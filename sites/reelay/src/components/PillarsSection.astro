---
import SectionHeader from '@andrew/ui/SectionHeader.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '');
---

<section class="section pillars-section" id="four-pillars">
  <div class="container">
    <SectionHeader
      index="02"
      kicker="CAPABILITIES & ARCHITECTURE"
      title="The Four Pillars of Reelay Studio"
      lede="Engineered from the ground up as a native desktop application for creator sovereignty, speed, and privacy."
      id="four-pillars"
    />

    <div class="pillars-grid">
      <!-- Pillar 1 -->
      <div class="pillar-card">
        <div class="pillar-badge-row">
          <span class="pillar-num">01</span>
          <span class="badge">Reelay Studio</span>
        </div>
        <h3 class="pillar-title">Media Library & In-App Player</h3>
        <p class="pillar-summary">
          Stop organizing video in spreadsheets. View large 16:9 and 9:16 previews, scrub footage with a native hardware-accelerated player, and search spoken words with offline Whisper AI.
        </p>
        <ul class="pillar-features">
          <li>
            <strong>High-Fidelity Downloads:</strong> Direct ingestion from TikTok, Instagram, and YouTube via bundled <code>yt-dlp</code>.
          </li>
          <li>
            <strong>Hardware-Accelerated Scrubbing:</strong> 60 FPS playback with automatic proxy generation for VP9/AV1 codecs.
          </li>
          <li>
            <strong>Offline Whisper Speech Search:</strong> Local AI transcribes audio on your GPU. Full-text search over spoken dialog via SQLite FTS5.
          </li>
        </ul>
        <a href={`${base}/features/library`} class="pillar-link">
          Explore Studio Player & Library →
        </a>
      </div>

      <!-- Pillar 2 -->
      <div class="pillar-card">
        <div class="pillar-badge-row">
          <span class="pillar-num">02</span>
          <span class="badge">Visual Kanban</span>
        </div>
        <h3 class="pillar-title">Cross-Platform Pipeline</h3>
        <p class="pillar-summary">
          One video, five platforms. Track readiness across YouTube Shorts, Instagram Reels, and TikTok on an interactive Kanban board with visual coverage indicators.
        </p>
        <ul class="pillar-features">
          <li>
            <strong>5 Lifecycle Stages:</strong> <code>Backlog</code> → <code>Staging</code> → <code>Ready</code> → <code>Scheduled</code> → <code>Published</code>.
          </li>
          <li>
            <strong>Coverage Map Indicators:</strong> Instant at-a-glance status indicators on every card for YouTube, TikTok, IG, Threads, and Facebook.
          </li>
          <li>
            <strong>Prepare to Publish Handoff:</strong> When platforms restrict automated publishing APIs, one-click export hands off copy and media seamlessly.
          </li>
        </ul>
        <a href={`${base}/features/pipeline`} class="pillar-link">
          Explore Kanban Pipeline →
        </a>
      </div>

      <!-- Pillar 3 -->
      <div class="pillar-card">
        <div class="pillar-badge-row">
          <span class="pillar-num">03</span>
          <span class="badge">Safe Logic</span>
        </div>
        <h3 class="pillar-title">Automations & Rules Engine</h3>
        <p class="pillar-summary">
          Eliminate repetitive formatting tasks with safe, deterministic desktop rules that trigger automatically when videos enter columns.
        </p>
        <ul class="pillar-features">
          <li>
            <strong>When / If / Then Logic:</strong> Trigger custom actions when a video is ingested or moved to <code>Ready</code>.
          </li>
          <li>
            <strong>Dynamic Templating:</strong> Auto-populates platform copy and tags from <code>{`{hook}`}</code>, <code>{`{caption}`}</code>, and <code>{`{creator}`}</code> tokens.
          </li>
          <li>
            <strong>Safety Gates:</strong> Rules execute once per video; never overwrites manual copy; scheduling strictly enforces readiness verification.
          </li>
        </ul>
        <a href={`${base}/features/automations`} class="pillar-link">
          Explore Rules Engine →
        </a>
      </div>

      <!-- Pillar 4 -->
      <div class="pillar-card">
        <div class="pillar-badge-row">
          <span class="pillar-num">04</span>
          <span class="badge">MCP Protocol</span>
        </div>
        <h3 class="pillar-title">AI Companion Ecosystem</h3>
        <p class="pillar-summary">
          Bring your own assistant (Claude, ChatGPT, Gemini, Meta Muse) via the Model Context Protocol. We provide tools; you keep control and pay zero token markup.
        </p>
        <ul class="pillar-features">
          <li>
            <strong>Zero AI Token Markup:</strong> Bring your own assistant subscriptions; Reelay never bills for or marks up LLM tokens.
          </li>
          <li>
            <strong>ScopedPipeline Safety Boundary:</strong> Destructive commands (publishing, mass deleting) trigger durable SQLite <code>approval_requests</code>.
          </li>
          <li>
            <strong>Local Token-Free Helpers:</strong> Offline brand voice templates and metadata generators that run without calling external APIs.
          </li>
        </ul>
        <a href={`${base}/ai`} class="pillar-link">
          Explore AI & MCP Integration →
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .pillars-section {
    position: relative;
    background-color: transparent;
  }

  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.75rem;
    margin-top: 2.5rem;
  }

  .pillar-card {
    background-color: var(--color-surface);
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    padding: 2.25rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .pillar-card:hover {
    transform: translateY(-2px);
    border-color: var(--hairline-strong);
  }

  .pillar-badge-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
  }

  .pillar-num {
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 700;
    color: var(--brand);
  }

  .pillar-title {
    font-size: 1.45rem;
    margin-bottom: 0.75rem;
    color: #ffffff;
  }

  .pillar-summary {
    font-size: 0.92rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .pillar-features {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin-bottom: 2rem;
    flex: 1;
  }

  .pillar-features li {
    font-size: 0.88rem;
    color: var(--text-muted);
    line-height: 1.5;
    position: relative;
    padding-left: 1.25rem;
  }

  .pillar-features li::before {
    content: "•";
    position: absolute;
    left: 0;
    color: var(--brand);
    font-weight: bold;
  }

  .pillar-features strong {
    color: #ffffff;
  }

  .pillar-features code {
    background-color: var(--color-surface-2);
    padding: 0.15rem 0.35rem;
    border-radius: 4px;
    font-size: 0.85em;
    color: var(--text-primary);
  }

  .pillar-link {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-primary);
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .pillar-link:hover {
    color: var(--brand);
  }

  @media (max-width: 840px) {
    .pillars-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
