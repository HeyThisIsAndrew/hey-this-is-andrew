---
/**
 * VideoSlot: a screencast slot (src/data/screens.json, kind "video").
 * Never autoplays: muted, captioned, with the browser's own controls (play
 * and pause). Until public/screens/<id>.mp4 exists, a labelled placeholder.
 */
import fs from 'node:fs';
import path from 'node:path';
import screens from '../../data/screens.json';

interface Props { id: string; class?: string }
const { id, class: cls } = Astro.props;
const slot = screens.slots.find((s) => s.id === id);
if (!slot) throw new Error(`Unknown video slot "${id}" (add it to src/data/screens.json)`);
const pub = path.resolve('public/screens');
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const ready = fs.existsSync(path.join(pub, `${id}.mp4`));
const hasVtt = fs.existsSync(path.join(pub, `${id}.vtt`));
const hasPoster = fs.existsSync(path.join(pub, `${id}-poster.png`));
---
<figure class:list={['vslot', cls]} data-video-slot={id} data-video-ready={ready ? '' : undefined}>
  {ready ? (
    <video controls muted playsinline preload="none" width={slot.width / 2} height={slot.height / 2} poster={hasPoster ? `${base}screens/${id}-poster.png` : undefined} aria-label={slot.title}>
      <source src={`${base}screens/${id}.mp4`} type="video/mp4" />
      {hasVtt && <track kind="captions" src={`${base}screens/${id}.vtt`} srclang="en" label="English" default />}
    </video>
  ) : (
    <div class="slot" role="img" aria-label={`Screencast to come: ${slot.title}`}
      data-screen-files={`public/screens/${id}.mp4 public/screens/${id}.vtt public/screens/${id}-poster.png`}>
      <span class="play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5.5v13l10.5-6.5z" fill="currentColor"/></svg></span>
      <span class="slot-k">Screencast to come</span>
    </div>
  )}
  <figcaption>{slot.title}</figcaption>
</figure>

<style>
  .vslot { margin: 0; }
  video { width: 100%; height: auto; border-radius: 14px; background: #000; }
  .slot {
    aspect-ratio: 16 / 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    padding: 1.25rem;
    border-radius: 14px;
    background: repeating-linear-gradient(135deg, var(--r-fill) 0 12px, transparent 12px 24px), var(--r-tile);
    box-shadow: inset 0 0 0 1.5px var(--hairline-strong);
    text-align: center;
  }
  .play { display: grid; place-items: center; width: 3rem; height: 3rem; border-radius: 50%; background: var(--r-fill-3); color: var(--r-ink-2); margin-bottom: 0.25rem; }
  .play svg { width: 1.2rem; height: 1.2rem; margin-left: 0.15rem; }
  .slot-k { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--r-amber-text); }
  figcaption { margin-top: 0.6rem; font-size: 0.82rem; color: var(--r-ink-3); }
</style>
