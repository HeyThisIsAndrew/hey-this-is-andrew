---
/**
 * Platform glyphs for product renderings.
 *
 * THE MARKS ARE THE OFFICIAL ONES, not redrawn: the same path data BE
 * Unconventional HQ uses (its src/data/icons.js, Simple Icons and the
 * platforms' own marks). The earlier hand-simplified glyphs drifted, Threads
 * worst of all (its @ read as a loose spiral). Snapchat is the exception: HQ
 * has no mark for it, so it keeps its simple ghost.
 *
 * Default: the mark alone in currentColor (marketing UI).
 * brand: the official colours, for renderings of the app's screens: YouTube's
 * red play button, the YouTube Shorts mark (red, white play) for a Short, TikTok's note with its cyan and red echoes on near-black,
 * Instagram's glyph on its gradient, Bluesky's blue butterfly, Threads' white
 * @ on near-black, Facebook's white f on blue, Snapchat's ghost on yellow.
 */
interface Props {
  name: 'youtube' | 'youtube_shorts' | 'tiktok' | 'instagram' | 'bluesky' | 'threads' | 'facebook' | 'snapchat';
  size?: number | string;
  class?: string;
  brand?: boolean;
}
const { name, size = '1em', class: cls, brand = false } = Astro.props;
const MARKS: Record<string, { viewBox: string; d: string }> = {
