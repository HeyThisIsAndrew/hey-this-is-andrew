---
/**
 * Platform glyphs for product renderings.
 *
 * Default: simplified monochrome glyphs in currentColor (marketing UI).
 * brand: the official colour marks, drawn the same way the app does (reelay/gui/logos.py), for renderings of
 * the app's screens: YouTube's red play button, TikTok's note with its cyan and red echoes on near-black,
 * Instagram's gradient, Bluesky's blue butterfly, Threads' white @ on near-black, Facebook's white f on blue,
 * Snapchat's ghost on yellow.
 */
interface Props {
  name: 'youtube' | 'tiktok' | 'instagram' | 'bluesky' | 'threads' | 'facebook' | 'snapchat';
  size?: number | string;
  class?: string;
  brand?: boolean;
}
const { name, size = '1em', class: cls, brand = false } = Astro.props;
const TIKTOK = 'M14.2 3h3c.2 1.9 1.5 3.4 3.4 3.6v3.1a7.1 7.1 0 0 1-3.4-1v6.2a5.6 5.6 0 1 1-5.6-5.6c.3 0 .6 0 .9.1v3.2a2.5 2.5 0 1 0 1.7 2.3z';
const BLUESKY = 'M12 11.2C10.7 8.6 7.2 4 4.6 3.6 3 3.4 2.6 4.6 2.6 6c0 1.1.6 5 1 5.6.9 1.6 3 2 4.7 1.6-3 .5-4.1 2.3-2.4 4.1 3 3.1 4.6-.7 5.4-2.6l.7-1.7.7 1.7c.8 1.9 2.4 5.7 5.4 2.6 1.7-1.8.6-3.6-2.4-4.1 1.7.4 3.8 0 4.7-1.6.4-.6 1-4.5 1-5.6 0-1.4-.4-2.6-2-2.4-2.6.4-6.1 5-7.4 7.6z';
const THREADS = 'M16.8 11.1a6.6 6.6 0 0 0-.3-.1c-.2-3-1.8-4.7-4.6-4.7-1.7 0-3.1.7-3.9 2l1.5 1c.6-.9 1.6-1.1 2.4-1.1 1 0 1.7.3 2.1.9.3.4.5 1 .6 1.7a10 10 0 0 0-2.3-.1c-2.3.1-3.8 1.5-3.7 3.4.1 1 .6 1.8 1.4 2.3.7.5 1.6.7 2.6.6 1.3-.1 2.3-.6 3-1.4.5-.7.9-1.5 1-2.6.6.4 1.1.9 1.3 1.5.4 1 .4 2.6-.9 3.9-1.2 1.2-2.6 1.7-4.8 1.7-2.4 0-4.2-.8-5.4-2.3-1.1-1.4-1.7-3.4-1.7-6s.6-4.6 1.7-6c1.2-1.5 3-2.3 5.4-2.3 2.4 0 4.3.8 5.5 2.3.6.7 1.1 1.7 1.4 2.8l1.7-.5c-.4-1.4-1-2.5-1.8-3.5C17.5 1.1 15.2.1 12.2.1h-.1C9.2.1 6.9 1.1 5.4 3c-1.4 1.7-2.1 4.1-2.1 7.1s.7 5.4 2.1 7.1c1.5 1.9 3.8 2.9 6.7 2.9h.1c2.6 0 4.4-.7 5.9-2.2 2-2 1.9-4.5 1.3-6-.5-1.1-1.4-2-2.6-2.6zm-4.5 4.4c-1 .1-2.1-.4-2.2-1.4 0-.7.5-1.5 2.2-1.6h.6c.6 0 1.2.1 1.8.2-.2 2.4-1.3 2.7-2.4 2.8z';
const FACEBOOK = 'M12 2a10 10 0 0 0-1.6 19.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.3c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.3v7A10 10 0 0 0 12 2z';
const gid = `ig-${Math.random().toString(36).slice(2, 9)}`;
---
{brand ? (
  <svg class:list={['pf-icon', 'pf-brand', cls]} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true">
    {name === 'youtube' && (
      <>
        <rect x="0" y="4.3" width="24" height="15.4" rx="4.3" fill="#FF0000" />
        <path d="M9.6 8.2v7.6l6.7-3.8z" fill="#FFFFFF" />
      </>
    )}
    {name === 'tiktok' && (
      <>
        <rect width="24" height="24" rx="5.8" fill="#111111" />
        <g transform="translate(3.84 3.84) scale(0.68)">
          <path d={TIKTOK} fill="#25F4EE" transform="translate(-1.2 -1.2)" />
          <path d={TIKTOK} fill="#FE2C55" transform="translate(1.2 1.2)" />
          <path d={TIKTOK} fill="#FFFFFF" />
        </g>
      </>
    )}
    {name === 'instagram' && (
      <>
        <defs>
          <linearGradient id={gid} x1="0" y1="1" x2="1" y2="0">
            <stop offset="0" stop-color="#FEDA75" /><stop offset=".35" stop-color="#FA7E1E" />
            <stop offset=".6" stop-color="#D62976" /><stop offset="1" stop-color="#4F5BD5" />
          </linearGradient>
        </defs>
        <rect width="24" height="24" rx="6.7" fill={`url(#${gid})`} />
        <rect x="4.8" y="4.8" width="14.4" height="14.4" rx="4.3" fill="none" stroke="#FFFFFF" stroke-width="1.9" />
        <circle cx="12" cy="12" r="3.4" fill="none" stroke="#FFFFFF" stroke-width="1.9" />
        <circle cx="16.1" cy="7.9" r="1" fill="#FFFFFF" />
      </>
    )}
    {name === 'bluesky' && <path d={BLUESKY} fill="#1185FE" />}
    {name === 'threads' && (
      <>
        <rect width="24" height="24" rx="5.8" fill="#111111" />
        <g transform="translate(4.8 4.8) scale(0.6)"><path d={THREADS} fill="#FFFFFF" transform="translate(-0.9 0.9)" /></g>
      </>
    )}
    {name === 'facebook' && (
      <>
        <circle cx="12" cy="12" r="9.4" fill="#FFFFFF" />
        <path d={FACEBOOK} fill="#0866FF" />
      </>
    )}
    {name === 'snapchat' && (
      <>
        <rect width="24" height="24" rx="5.8" fill="#FFFC00" />
        <path d="M7.2 13.9l.2-3.8c0-6.5 9.2-6.5 9.2 0l.2 3.8c3.4.5 2.4 2.4.6 2.4-1.9.5-3.1 2.6-3.1 2.6-1.4-1.4-3.2-1.4-4.6 0 0 0-1.2-2.1-3.1-2.6-1.8 0-2.8-1.9.6-2.4z" fill="#FFFFFF" stroke="#111111" stroke-width="1.1" stroke-linejoin="round" />
      </>
    )}
  </svg>
) : (
  <svg class:list={['pf-icon', cls]} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
    {name === 'youtube' && (
      <>
        <rect x="2" y="5" width="20" height="14" rx="4.2" />
        <path d="M10 9v6l5.2-3z" fill="#000" fill-opacity=".85" />
      </>
    )}
    {name === 'tiktok' && <path d={TIKTOK} />}
    {name === 'instagram' && (
      <>
        <rect x="3" y="3" width="18" height="18" rx="5.5" fill="none" stroke="currentColor" stroke-width="2" />
        <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2" />
        <circle cx="17.3" cy="6.7" r="1.2" />
      </>
    )}
    {name === 'bluesky' && <path d={BLUESKY} />}
    {name === 'threads' && <path d={THREADS} />}
    {name === 'facebook' && <path d={FACEBOOK} />}
    {name === 'snapchat' && (
      <path d="M7.2 13.9l.2-3.8c0-6.5 9.2-6.5 9.2 0l.2 3.8c3.4.5 2.4 2.4.6 2.4-1.9.5-3.1 2.6-3.1 2.6-1.4-1.4-3.2-1.4-4.6 0 0 0-1.2-2.1-3.1-2.6-1.8 0-2.8-1.9.6-2.4z" />
    )}
  </svg>
)}
