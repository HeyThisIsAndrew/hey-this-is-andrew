---
/** Simplified monochrome platform glyphs for product renderings. */
interface Props {
  name: 'youtube' | 'tiktok' | 'instagram' | 'bluesky' | 'threads' | 'facebook';
  size?: number | string;
  class?: string;
}
const { name, size = '1em', class: cls } = Astro.props;
---
<svg class:list={['pf-icon', cls]} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
  {name === 'youtube' && (
    <>
      <rect x="2" y="5" width="20" height="14" rx="4.2" />
      <path d="M10 9v6l5.2-3z" fill="#000" fill-opacity=".85" />
    </>
  )}
  {name === 'tiktok' && (
    <path d="M14.2 3h3c.2 1.9 1.5 3.4 3.4 3.6v3.1a7.1 7.1 0 0 1-3.4-1v6.2a5.6 5.6 0 1 1-5.6-5.6c.3 0 .6 0 .9.1v3.2a2.5 2.5 0 1 0 1.7 2.3z" />
  )}
  {name === 'instagram' && (
    <>
      <rect x="3" y="3" width="18" height="18" rx="5.5" fill="none" stroke="currentColor" stroke-width="2" />
      <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2" />
      <circle cx="17.3" cy="6.7" r="1.2" />
    </>
  )}
  {name === 'bluesky' && (
    <path d="M12 11.2C10.7 8.6 7.2 4 4.6 3.6 3 3.4 2.6 4.6 2.6 6c0 1.1.6 5 1 5.6.9 1.6 3 2 4.7 1.6-3 .5-4.1 2.3-2.4 4.1 3 3.1 4.6-.7 5.4-2.6l.7-1.7.7 1.7c.8 1.9 2.4 5.7 5.4 2.6 1.7-1.8.6-3.6-2.4-4.1 1.7.4 3.8 0 4.7-1.6.4-.6 1-4.5 1-5.6 0-1.4-.4-2.6-2-2.4-2.6.4-6.1 5-7.4 7.6z" />
  )}
  {name === 'threads' && (
    <path d="M16.8 11.1a6.6 6.6 0 0 0-.3-.1c-.2-3-1.8-4.7-4.6-4.7-1.7 0-3.1.7-3.9 2l1.5 1c.6-.9 1.6-1.1 2.4-1.1 1 0 1.7.3 2.1.9.3.4.5 1 .6 1.7a10 10 0 0 0-2.3-.1c-2.3.1-3.8 1.5-3.7 3.4.1 1 .6 1.8 1.4 2.3.7.5 1.6.7 2.6.6 1.3-.1 2.3-.6 3-1.4.5-.7.9-1.5 1-2.6.6.4 1.1.9 1.3 1.5.4 1 .4 2.6-.9 3.9-1.2 1.2-2.6 1.7-4.8 1.7-2.4 0-4.2-.8-5.4-2.3-1.1-1.4-1.7-3.4-1.7-6s.6-4.6 1.7-6c1.2-1.5 3-2.3 5.4-2.3 2.4 0 4.3.8 5.5 2.3.6.7 1.1 1.7 1.4 2.8l1.7-.5c-.4-1.4-1-2.5-1.8-3.5C17.5 1.1 15.2.1 12.2.1h-.1C9.2.1 6.9 1.1 5.4 3c-1.4 1.7-2.1 4.1-2.1 7.1s.7 5.4 2.1 7.1c1.5 1.9 3.8 2.9 6.7 2.9h.1c2.6 0 4.4-.7 5.9-2.2 2-2 1.9-4.5 1.3-6-.5-1.1-1.4-2-2.6-2.6zm-4.5 4.4c-1 .1-2.1-.4-2.2-1.4 0-.7.5-1.5 2.2-1.6h.6c.6 0 1.2.1 1.8.2-.2 2.4-1.3 2.7-2.4 2.8z" />
  )}
  {name === 'facebook' && (
    <path d="M12 2a10 10 0 0 0-1.6 19.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.3c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.3v7A10 10 0 0 0 12 2z" />
  )}
