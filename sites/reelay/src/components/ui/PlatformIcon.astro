---
{brand ? (
  <svg class:list={['pf-icon', 'pf-brand', cls]} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true">
    {name === 'youtube' && (
      <>
        <path d="M9.2 7.8v8.4l7-4.2z" fill="#FFFFFF" />
        <path d={mark.d} fill="#FF0000" />
      </>
    )}
    {name === 'youtube_shorts' && (
      <>
        <path d="m18.931 9.99-1.441-.601 1.717-.913a4.48 4.48 0 0 0 1.874-6.078 4.506 4.506 0 0 0-6.09-1.874L4.792 5.929a4.504 4.504 0 0 0-2.402 4.193 4.521 4.521 0 0 0 2.666 3.904c.036.012 1.442.6 1.442.6l-1.706.901a4.51 4.51 0 0 0-2.369 3.967A4.528 4.528 0 0 0 6.93 24c.725 0 1.437-.174 2.08-.508l10.21-5.406a4.494 4.494 0 0 0 2.39-4.192 4.525 4.525 0 0 0-2.678-3.904Z" fill="#FF0000" />
        <path d="M9.597 15.19V8.824l6.007 3.184z" fill="#FFFFFF" />
      </>
    )}
    {name === 'tiktok' && (
      <>
        <rect width="24" height="24" rx="5.8" fill="#111111" />
        <g transform="translate(5 5) scale(0.58)">
          <path d={mark.d} fill="#25F4EE" transform="translate(-1 -1)" />
          <path d={mark.d} fill="#FE2C55" transform="translate(1 1)" />
          <path d={mark.d} fill="#FFFFFF" />
        </g>
      </>
    )}
    {name === 'instagram' && (
      <>
        <defs>
          <linearGradient id={gid} x1="0" y1="1" x2="1" y2="0">
            <stop offset="0" stop-color="#FEDA75" /><stop offset=".35" stop-color="#FA7E1E" />
            <stop offset=".6" stop-color="#D62976" /><stop offset="1" stop-color="#4F5BD5" />
          </linearGradient>
        </defs>
        <rect width="24" height="24" rx="6.7" fill={`url(#${gid})`} />
        <svg x="4.5" y="4.5" width="15" height="15" viewBox={mark.viewBox}><path d={mark.d} fill="#FFFFFF" /></svg>
      </>
    )}
    {name === 'bluesky' && <svg x="1" y="1" width="22" height="22" viewBox={mark.viewBox}><path d={mark.d} fill="#1185FE" /></svg>}
    {name === 'threads' && (
      <>
        <rect width="24" height="24" rx="5.8" fill="#111111" />
        <svg x="3" y="3" width="18" height="18" viewBox={mark.viewBox}><path d={mark.d} fill="#FFFFFF" /></svg>
      </>
    )}
    {name === 'facebook' && (
      <>
        <circle cx="12" cy="12" r="10.5" fill="#FFFFFF" />
        <path d={mark.d} fill="#0866FF" />
      </>
    )}
    {name === 'snapchat' && (
      <>
        <rect width="24" height="24" rx="5.8" fill="#FFFC00" />
        <path d={SNAPCHAT} fill="#FFFFFF" stroke="#111111" stroke-width="1.1" stroke-linejoin="round" />
      </>
    )}
  </svg>
) : (
  <svg class:list={['pf-icon', cls]} width={size} height={size} viewBox={mark ? mark.viewBox : '0 0 24 24'} aria-hidden="true" fill="currentColor">
    <path d={mark ? mark.d : SNAPCHAT} />
  </svg>
)}
