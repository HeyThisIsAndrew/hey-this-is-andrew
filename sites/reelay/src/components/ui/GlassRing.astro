---
/**
 * The readiness ring in Spatial Glass (ticket_widgets.py
 * ReadinessRing._paint_glass), drawn in the widget's own 40px box: a 34px
 * ring, a glassy disc lit from above inside it, a faint track, and the
 * progress arc over a soft accent halo, clockwise from 12 o'clock. The arc's
 * conical accent-hover -> accent -> accent-hover sweep is approximated with a
 * top-to-bottom gradient. Styles: .glass-ring in src/styles/glass.css.
 */
interface Props {
  ready: number;
  total: number;
  class?: string;
}
const { ready, total, class: cls } = Astro.props;
const R = 17;
const C = 2 * Math.PI * R;
const dash = total ? `${(ready / total) * C} ${C}` : `0 ${C}`;
const id = `glass-ring-${Math.random().toString(36).slice(2, 8)}`;
---
<svg class:list={['glass-ring', cls]} viewBox="0 0 40 40" aria-hidden="true">
  <defs>
    <radialGradient id={`${id}-disc`} cx="20" cy="9.8" r="23.8" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#202633" stop-opacity="0.9" />
      <stop offset="1" stop-color="#131926" stop-opacity="0.6" />
    </radialGradient>
    <linearGradient id={`${id}-arc`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#70b6ff" />
      <stop offset="0.5" stop-color="#4da3ff" />
      <stop offset="1" stop-color="#4da3ff" />
    </linearGradient>
  </defs>
  <circle class="ring-disc" cx="20" cy="20" r="15" fill={`url(#${id}-disc)`} />
  <circle class="ring-track" cx="20" cy="20" r={R} />
  {ready > 0 && <circle class="ring-halo" cx="20" cy="20" r={R} stroke-dasharray={dash} transform="rotate(-90 20 20)" />}
  {ready > 0 && <circle class="ring-arc" cx="20" cy="20" r={R} stroke={`url(#${id}-arc)`} stroke-dasharray={dash} transform="rotate(-90 20 20)" />}
  <text x="20" y="23.5" text-anchor="middle" font-size="10">{total ? `${ready}/${total}` : '–'}</text>
</svg>
