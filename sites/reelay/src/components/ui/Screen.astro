---
/**
 * Screen: a real app screenshot slot (src/data/screens.json). Light and dark
 * captures swap with the visitor's colour scheme. Until the files exist in
 * public/screens/, a labelled placeholder shows exactly what goes there, so
 * a missing screenshot is never silently skipped.
 */
import fs from 'node:fs';
import path from 'node:path';
import screens from '../../data/screens.json';

interface Props { id: string; alt?: string; class?: string; caption?: string }
const { id, alt, class: cls, caption } = Astro.props;
const slot = screens.slots.find((s) => s.id === id);
if (!slot) throw new Error(`Unknown screenshot slot "${id}" (add it to src/data/screens.json)`);
const pub = path.resolve('public/screens');
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const file = (theme: string) => `${id}-${theme}@2x.png`;
const has = (theme: string) => fs.existsSync(path.join(pub, file(theme)));
const themes = slot.themes as string[];
const light = themes.includes('light') && has('light');
const dark = themes.includes('dark') && has('dark');
const ready = themes.every(has);
const w = slot.width / 2;
const h = slot.height / 2;
const label = alt ?? `Reelay: ${slot.title}`;
---
<figure class:list={['screen', cls, { 'screen--slot': !ready }]} data-screen-slot={id} data-screen-ready={ready ? '' : undefined}>
  {ready ? (
    <picture>
      {dark && light && <source srcset={`${base}screens/${file('dark')}`} media="(prefers-color-scheme: dark)" />}
      <img src={`${base}screens/${file(light ? 'light' : 'dark')}`} width={w} height={h} alt={label} loading="lazy" decoding="async" />
    </picture>
  ) : (
    <div class="slot" style={`aspect-ratio:${slot.width}/${slot.height}`} role="img" aria-label={`Screenshot to come: ${slot.title}`}>
      <span class="slot-k">Screenshot slot</span>
      <span class="slot-t">{slot.title}</span>
      <code class="slot-f">public/screens/{themes.map((t) => file(t)).join(' + ')}</code>
      <span class="slot-d">{slot.width} × {slot.height} px · {themes.join(' and ')}</span>
    </div>
  )}
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .screen { margin: 0; }
  .screen img { width: 100%; height: auto; border-radius: 14px; box-shadow: var(--app-frame); }
  .slot {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    padding: 1.5rem;
    border-radius: 14px;
    background: linear-gradient(180deg, var(--r-panel) 0%, var(--r-tile) 100%);
    border: 1px solid var(--hairline-strong);
    box-shadow: var(--app-frame);
    text-align: center;
  }
  .slot-k { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--r-amber-text); }
  .slot-t { max-width: 34rem; font-size: 0.98rem; font-weight: 600; color: var(--r-ink); }
  .slot-f { max-width: 100%; font-size: 0.75rem; color: var(--r-ink-3); overflow-wrap: anywhere; }
  .slot-d { font-size: 0.78rem; color: var(--r-ink-3); }
  figcaption { margin-top: 0.75rem; font-size: 0.85rem; color: var(--r-ink-3); text-align: center; }
</style>
