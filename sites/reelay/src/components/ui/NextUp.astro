---
/** The band at the foot of a page that hands the reader to the next one. */
interface Props {
  kicker: string;
  title: string;
  href: string;
}
const { kicker, title, href } = Astro.props;
---
<section class="next-up" aria-label={`Next: ${title}`}>
  <a class="wrap next-link" href={href}>
    <span class="next-kicker">{kicker}</span>
    <span class="next-title">{title}<span class="next-arrow" aria-hidden="true">→</span></span>
  </a>
</section>

<style>
  .next-up { padding-block: clamp(4rem, 9vw, 7rem); background: radial-gradient(60% 100% at 50% 100%, rgba(240, 160, 50, 0.1), transparent 70%); }
  .next-link { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 0.75rem; color: var(--r-ink); }
  .next-kicker { font-size: 1rem; font-weight: 600; color: var(--r-amber-text); }
  .next-title { font-family: var(--font-display); font-size: clamp(2.2rem, 5.5vw, 4.25rem); font-weight: 700; letter-spacing: -0.04em; line-height: 1.05; }
  .next-arrow { display: inline-block; margin-left: 0.3em; transition: transform 0.4s var(--r-ease); color: var(--r-amber-text); }
  .next-link:hover { color: var(--r-ink); }
  .next-link:hover .next-arrow { transform: translateX(0.2em); }
</style>
