---
/**
 * ProductNav: Apple's second bar. The product name, its chapters and a
 * Download pill, frosted and sticky under the global nav. The current page
 * is marked at build time; on the home page a scrollspy follows the
 * chapters. On phones the links fold into a sheet.
 */
import { PRODUCT_NAV, homeUrl, href } from '../../data/site';

/* Matched without the base path, so the marks hold under a subpath build too. */
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const full = Astro.url.pathname;
const path = (base && full.startsWith(base) ? full.slice(base.length) : full).replace(/\/$/, '') || '/';
const isHome = path === '/';
const current = PRODUCT_NAV.find((l) => l.match.some((m) => (m === '/' ? isHome : path === m || path.startsWith(`${m}/`))));
---
<nav class="pnav" aria-label="Reelay" data-pnav data-home={isHome ? '' : undefined}>
  <div class="pnav-inner">
    <a class="pnav-title" href={homeUrl}>Reelay</a>
    <button type="button" class="pnav-toggle" aria-expanded="false" aria-controls="pnav-sheet" data-pnav-toggle>
      <span class="sr-only">Reelay sections</span>
      <svg viewBox="0 0 12 8" aria-hidden="true"><path d="M1 1.5 6 6.5l5-5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
    <ul class="pnav-links" id="pnav-sheet" data-pnav-sheet>
      {PRODUCT_NAV.map((l) => (
        <li>
          <a href={l.href} data-pnav-id={l.id} aria-current={current?.id === l.id ? 'page' : undefined}>{l.label}</a>
        </li>
      ))}
    </ul>
    <a class="pnav-cta" href={href('/download')}>Download</a>
  </div>
</nav>

<style>
  .pnav {
    position: sticky;
    top: var(--nav-bar-h, var(--r-nav-h, 56px));
    z-index: 90;
    height: var(--r-subnav-h);
    background: var(--r-glass);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    box-shadow: inset 0 -1px 0 var(--hairline);
  }
  .pnav-inner {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1rem;
    height: 100%;
    max-width: calc(var(--r-wrap) + 2 * var(--r-gutter));
    margin: 0 auto;
    padding: 0 var(--r-gutter);
  }
  .pnav-title { font-family: var(--font-display); font-size: 1.3rem; font-weight: 600; letter-spacing: -0.02em; color: var(--r-ink); margin-right: auto; }
  .pnav-title:hover { color: var(--r-ink); }
  .pnav-links { display: flex; align-items: center; gap: 0.25rem; list-style: none; }
  .pnav-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 0.6rem;
    font-size: 0.78rem;
    color: var(--r-ink-2);
    border-radius: 8px;
  }
  .pnav-links a:hover { color: var(--r-ink); }
  .pnav-links a[aria-current='page'],
  .pnav-links a.is-active { color: var(--r-ink); font-weight: 600; }
  .pnav-cta {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    padding: 0 0.95rem;
    border-radius: 999px;
    background: var(--r-amber);
    color: var(--r-on-amber);
    font-size: 0.78rem;
    font-weight: 600;
    position: relative;
  }
  /* 44px hit area around the 32px pill */
  .pnav-cta::before { content: ''; position: absolute; inset: -6px -2px; }
  .pnav-cta:hover { color: var(--r-on-amber); filter: brightness(1.06); }
  .pnav-toggle { display: none; }

  @media (max-width: 860px) {
    .pnav-toggle {
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      margin-left: -0.6rem;
      border: 0;
      background: none;
      color: var(--r-ink-2);
      cursor: pointer;
      order: 0;
    }
    .pnav-toggle svg { width: 12px; height: 8px; transition: transform 0.3s var(--r-ease); }
    .pnav-toggle[aria-expanded='true'] svg { transform: rotate(180deg); }
    .pnav-title { margin-right: 0; }
    .pnav-cta { margin-left: auto; }
    .pnav-links {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      display: grid;
      gap: 0;
      padding: 0.5rem var(--r-gutter) 1.25rem;
      background: var(--r-glass-strong);
      backdrop-filter: saturate(180%) blur(20px);
      -webkit-backdrop-filter: saturate(180%) blur(20px);
      box-shadow: inset 0 -1px 0 var(--hairline), 0 30px 60px -30px rgba(0, 0, 0, 0.5);
      visibility: hidden;
      opacity: 0;
      transform: translateY(-8px);
      transition: opacity 0.3s ease, transform 0.35s var(--r-ease), visibility 0.3s;
    }
    .pnav.is-open .pnav-links { visibility: visible; opacity: 1; transform: none; }
    .pnav-links a { font-size: 1.05rem; padding: 0; border-bottom: 1px solid var(--hairline); border-radius: 0; width: 100%; }
    .pnav-links li:last-child a { border-bottom: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pnav-links, .pnav-toggle svg { transition: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-pnav]').forEach((nav) => {
    const toggle = nav.querySelector<HTMLButtonElement>('[data-pnav-toggle]')!;
    const sheet = nav.querySelector<HTMLElement>('[data-pnav-sheet]')!;
    const setOpen = (open: boolean) => {
      nav.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', String(open));
    };
    toggle.addEventListener('click', () => setOpen(!nav.classList.contains('is-open')));
    sheet.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) setOpen(false); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && nav.classList.contains('is-open')) { setOpen(false); toggle.focus(); } });
    document.addEventListener('click', (e) => { if (!nav.contains(e.target as Node)) setOpen(false); });

    // Home: light the chapter in view (Privacy, Tech Specs; Overview otherwise).
    if (nav.hasAttribute('data-home') && 'IntersectionObserver' in window) {
      const links = new Map<string, HTMLAnchorElement>();
      nav.querySelectorAll<HTMLAnchorElement>('[data-pnav-id]').forEach((a) => links.set(a.dataset.pnavId!, a));
      const spy: [string, string][] = [['data-topology', 'privacy'], ['tech-specs', 'tech-specs']];
      const visible = new Set<string>();
      const paint = () => {
        const id = spy.find(([sec]) => visible.has(sec))?.[1] ?? 'overview';
        links.forEach((a, key) => {
          const on = key === id;
          a.classList.toggle('is-active', on);
          if (on) a.setAttribute('aria-current', key === 'overview' ? 'page' : 'location');
          else a.removeAttribute('aria-current');
        });
      };
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) e.isIntersecting ? visible.add(e.target.id) : visible.delete(e.target.id);
        paint();
      }, { rootMargin: '-40% 0px -50% 0px' });
      spy.forEach(([sec]) => { const el = document.getElementById(sec); if (el) io.observe(el); });
    }
  });
</script>
