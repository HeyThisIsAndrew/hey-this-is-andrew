---
/** A long-form document: title, summary line, date, contents, body. */
import BaseLayout from '../../layouts/BaseLayout.astro';
interface Props {
  title: string;
  pageTitle: string;
  description: string;
  eyebrow?: string;
  updated?: string;
  toc?: [string, string][];
}
const { title, pageTitle, description, eyebrow = 'Legal', updated, toc = [] } = Astro.props;
---
<BaseLayout title={pageTitle} description={description} pane={title} paneItems={toc.map(([id, label]) => ({ id, label }))}>
  <header class="doc-hero">
    <div class="wrap">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      <p class="lede"><slot name="lede" /></p>
      {updated && <p class="doc-meta">Last updated {updated}</p>}
    </div>
  </header>
  <div class:list={['wrap', 'doc-layout', { 'doc-layout--solo': !toc.length }]}>
    {toc.length > 0 && (
      <nav class="doc-toc" aria-label="On this page">
        <div>
          <p>On this page</p>
          <ol>{toc.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}</ol>
        </div>
      </nav>
    )}
    <div class="legal-content">
      <slot />
    </div>
  </div>
</BaseLayout>

<style>
  .doc-layout--solo { grid-template-columns: minmax(0, 1fr) !important; }
</style>
