---
/**
 * HelpPicture: a Help Center picture, drawn the way the app draws it
 * (reelay/gui/help_page.py, HelpShot / PlatformChart / StorageDiagram).
 *
 * A screenshot shows only the part of the window its guide is about (the
 * app's crop), enlarged, with a numbered marker on each control a step
 * points at. Marker positions are the app's own, measured from the live
 * widgets (help_shots/marks.json), so they land on the real controls. The
 * light or dark screenshot follows the visitor's colour scheme. Two pictures
 * are drawn rather than captured: who posts to each platform, and where
 * Reelay keeps data. Everything comes from src/data/help.json.
 */
import help from '../../data/help.json';
import PlatformIcon from './PlatformIcon.astro';

interface Visual { shot?: string; drawn?: string; alt: string; crop?: number[]; marks?: Record<string, number[]> }
interface Props { visual: Visual; steps: { text: string; mark: string }[] }
const { visual, steps } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const md = (s: string) => esc(s).replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
const plain = (s: string) => s.replace(/\*\*/g, '');
const pct = (n: number) => `${+(n * 100).toFixed(3)}%`;

let frame: { ratio: number; img: string } | null = null;
const markers: { n: number; box: string; badge: string }[] = [];
if (visual.shot && visual.crop) {
  const [W, H] = help.shotSize;
  const [cx, cy, cw, ch] = visual.crop;
  frame = {
    ratio: (cw * W) / (ch * H),
    img: `width:${pct(1 / cw)};left:${pct(-cx / cw)};top:${pct(-cy / ch)}`,
  };
  // Step n points at its mark; markers on neighbouring controls sit side by side, as in the app.
  const placed: [number, number][] = [];
  steps.forEach((s, i) => {
    const r = s.mark && visual.marks?.[s.mark];
    if (!r) return;
    const [x, y, w, h] = r;
    const left = Math.max(0, (x - cx) / cw), top = Math.max(0, (y - cy) / ch);
    const right = Math.min(1, (x + w - cx) / cw), bottom = Math.min(1, (y + h - cy) / ch);
    let bx = left, by = top;
    while (placed.some(([px, py]) => Math.abs(px - bx) < 0.045 && Math.abs(py - by) < 0.07) && bx < 0.9) bx += 0.05;
    placed.push([bx, by]);
    markers.push({
      n: i + 1,
      box: `left:${pct(left)};top:${pct(top)};width:${pct(right - left)};height:${pct(bottom - top)}`,
      badge: `left:clamp(0.75rem, ${pct(bx)}, calc(100% - 0.75rem));top:clamp(0.75rem, ${pct(by)}, calc(100% - 0.75rem))`,
    });
  });
}
const described = markers.length ? ` Numbered markers point at the controls in steps ${markers.map((m) => m.n).join(', ')}.` : '';
const [storageHead, storageFoot] = help.storage.labels;
---
{frame && (
  <figure class="hp">
    <div class="hp-frame" data-crop style={`aspect-ratio:${frame.ratio.toFixed(4)}`}>
      <picture>
        <source media="(prefers-color-scheme: dark)" srcset={`${base}help/${visual.shot}-dark.webp`} />
        <img src={`${base}help/${visual.shot}-light.webp`} width={help.shotSize[0]} height={help.shotSize[1]}
          alt={plain(visual.alt) + described} loading="lazy" decoding="async" style={frame.img} />
      </picture>
      {markers.map((m) => <span class="hp-box" style={m.box} aria-hidden="true"></span>)}
      {markers.map((m) => <span class="hp-badge" style={m.badge} aria-hidden="true">{m.n}</span>)}
    </div>
  </figure>
)}

{visual.drawn === 'platforms' && (
  <figure class="hp hp-drawn" aria-label={plain(visual.alt)}>
    <ul class="hp-posting">
      {help.posting.map(([key, label, who, note]) => (
        <li>
          <PlatformIcon name={key as 'youtube'} brand />
          <strong>{label}</strong>
          <span class:list={['hp-pill', { 'hp-pill--you': !who.startsWith('Reelay') }]}>{who}</span>
          <span class="hp-note" set:html={md(note)} />
        </li>
      ))}
    </ul>
  </figure>
)}

{visual.drawn === 'storage' && (
  <figure class="hp hp-drawn" aria-label={plain(visual.alt)}>
    <p class="hp-head" set:html={md(storageHead)} />
    <ul class="hp-places">
      {help.storage.places.map(([, title, where]) => (
        <li><strong>{title}</strong><span set:html={md(where)} /></li>
      ))}
    </ul>
    <p class="hp-foot" set:html={md(storageFoot)} />
  </figure>
)}

<style>
  .hp { margin: 0; }
  /* The crop: the screenshot is wider than the frame and offset, and the
     frame clips it (data-crop: the cut-off check knows this is deliberate). */
  .hp-frame {
    position: relative;
    overflow: hidden;
    border-radius: 12px;
    background: var(--r-tile);
    box-shadow: var(--app-frame);
  }
  .hp-frame img { position: absolute; max-width: none; height: auto; display: block; }
  .hp-box {
    position: absolute;
    border-radius: 6px;
    box-shadow: 0 0 0 2px var(--r-amber);
    background: color-mix(in srgb, var(--r-amber) 14%, transparent);
    pointer-events: none;
  }
  .hp-badge {
    position: absolute;
    display: grid;
    place-items: center;
    width: 1.4rem;
    height: 1.4rem;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: var(--r-amber);
    color: var(--r-on-amber);
    box-shadow: 0 0 0 2px var(--r-bg);
    font-size: 0.72rem;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    pointer-events: none;
  }

  .hp-drawn {
    padding: 1rem 1.1rem;
    border-radius: 12px;
    background: var(--r-tile);
    box-shadow: inset 0 0 0 1px var(--hairline-strong);
  }
  .hp-posting { list-style: none; display: grid; gap: 0.55rem; }
  .hp-posting li {
    display: grid;
    grid-template-columns: 1.4rem 5.6rem auto minmax(0, 1fr);
    align-items: center;
    gap: 0.6rem;
    font-size: 0.88rem;
  }
  .hp-posting :global(svg) { width: 1.3rem; height: 1.3rem; }
  .hp-pill {
    justify-self: start;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
    white-space: nowrap;
    background: color-mix(in srgb, var(--r-ok-text) 16%, transparent);
    color: var(--r-ok-text);
  }
  .hp-pill--you { background: var(--r-fill-2); color: var(--r-ink-2); }
  .hp-note { color: var(--r-ink-3); font-size: 0.82rem; min-width: 0; }
  @media (max-width: 520px) {
    .hp-posting li { grid-template-columns: 1.4rem minmax(0, 1fr) auto; }
    .hp-note { grid-column: 2 / -1; }
  }
  .hp-head { font-size: 0.92rem; color: var(--r-ink); }
  /* Three places: three across, or one per row; never two and one. */
  .hp-drawn { container-type: inline-size; }
  .hp-places { list-style: none; display: grid; grid-template-columns: minmax(0, 1fr); gap: 0.6rem; margin: 0.7rem 0; }
  @container (min-width: 30rem) { .hp-places { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .hp-places li {
    display: grid;
    gap: 0.25rem;
    padding: 0.75rem 0.85rem;
    border-radius: 10px;
    background: var(--r-fill);
    font-size: 0.84rem;
    color: var(--r-ink-3);
  }
  .hp-places strong { color: var(--r-ink); font-size: 0.9rem; }
  .hp-foot { font-size: 0.82rem; color: var(--r-ink-3); }
</style>
