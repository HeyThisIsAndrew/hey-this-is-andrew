---
import { SITE, DOWNLOADS } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '');
---

<section class="hero-section">
  <div class="container hero-container">
    <!-- Top Category Eyebrow -->
    <div class="hero-badge-wrap">
      <div class="badge hero-badge">
        <span class="badge-dot"></span>
        <span class="font-mono">LOCAL-FIRST CONTENT OPERATIONS STUDIO</span>
      </div>
    </div>

    <!-- H1 Headline: Crisp, Bold, High Contrast White -->
    <h1 class="hero-title">
      <span class="hero-title-line">Publish Everywhere.</span>
      <span class="hero-title-line accent-text">Never Lose Control.</span>
    </h1>

    <!-- Subtitle: Explains the Real Value in Plain English -->
    <p class="hero-subtitle">
      Organize video assets, prepare platform-tailored copy, and schedule multi-platform releases across YouTube, TikTok, and Instagram—directly from a native desktop application. No cloud database lock-in. No token markups.
    </p>

    <!-- CTAs: High Contrast, Monorepo Standard -->
    <div class="hero-cta-group">
      <div class="hero-ctas">
        <a href={`${base}/#download`} class="btn btn-primary btn-lg">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          Download for macOS (Apple Silicon)
        </a>
        <a href={`${base}/#interactive-workflow`} class="btn btn-secondary btn-lg">
          See How It Works ↓
        </a>
      </div>
      <p class="hero-compatibility-note">
        macOS 13+ (Apple Silicon M1–M4 verified) • Intel & Windows in build pipeline • No cloud account required
      </p>
    </div>

    <!-- Value Props: Clean Unified Neutral Monochrome Icons -->
    <div class="hero-highlights">
      <div class="highlight-item">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="highlight-icon">
          <rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect>
          <rect x="2" y="14" width="20" height="8" rx="2" ry="2"></rect>
          <line x1="6" y1="6" x2="6.01" y2="6"></line>
          <line x1="6" y1="18" x2="6.01" y2="18"></line>
        </svg>
        <span>Local SQLite Store</span>
      </div>
      <div class="highlight-item">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="highlight-icon">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
        <span>OS Keychain Security</span>
      </div>
      <div class="highlight-item">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="highlight-icon">
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
        <span>Zero AI Token Markup</span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    padding-top: clamp(3.5rem, 6vw, 5.5rem);
    padding-bottom: clamp(2rem, 4vw, 3.5rem);
    text-align: center;
    position: relative;
    background: radial-gradient(ellipse 80% 50% at 50% 0%, rgba(229, 169, 60, 0.1) 0%, rgba(7, 8, 10, 0) 70%);
  }

  .hero-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    z-index: 2;
  }

  .hero-badge-wrap {
    margin-bottom: 1.5rem;
  }

  .hero-badge {
    background-color: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.14);
    padding: 0.35rem 0.95rem;
    color: var(--text-secondary);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    letter-spacing: 0.1em;
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--brand);
    box-shadow: 0 0 10px rgba(229, 169, 60, 0.8);
  }

  .hero-title {
    font-size: clamp(2.75rem, 6vw, 4.75rem);
    line-height: 1.08;
    letter-spacing: -0.035em;
    font-weight: 700;
    max-width: 960px;
    margin-bottom: 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-title-line {
    background: linear-gradient(180deg, #ffffff 25%, #b5b9c5 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    display: block;
  }

  .hero-title-line.accent-text {
    background: linear-gradient(180deg, #fce2a6 0%, #e5a93c 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    display: block;
    filter: drop-shadow(0 0 35px rgba(229, 169, 60, 0.25));
  }

  .hero-subtitle {
    font-size: clamp(1.05rem, 1.8vw, 1.25rem);
    color: var(--text-secondary);
    max-width: 700px;
    line-height: 1.6;
    margin-bottom: 2.25rem;
    font-weight: 400;
  }

  .hero-cta-group {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 2.5rem;
  }

  .hero-ctas {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .hero-compatibility-note {
    font-size: 0.82rem;
    color: var(--text-dim);
    margin: 0;
    font-family: var(--font-mono);
  }

  .hero-highlights {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2.5rem;
    flex-wrap: wrap;
    padding-top: 1.5rem;
    border-top: 1px solid var(--hairline);
    width: 100%;
    max-width: 720px;
  }

  .highlight-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.84rem;
    font-weight: 500;
    color: var(--text-muted);
  }

  .highlight-icon {
    color: var(--brand);
    opacity: 0.85;
  }

  @media (max-width: 640px) {
    .hero-title {
      font-size: 2.25rem;
      letter-spacing: -0.025em;
    }
    .hero-ctas {
      flex-direction: column;
      width: 100%;
    }
    .hero-ctas .btn {
      width: 100%;
    }
    .hero-highlights {
      flex-direction: column;
      gap: 0.85rem;
      padding-top: 1.25rem;
    }
  }
</style>
