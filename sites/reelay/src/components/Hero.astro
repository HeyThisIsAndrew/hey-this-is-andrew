---
/**
 * Hero: the announcement. Product name, a headline at full scale, one
 * sentence of substance, one primary action, and then the product itself,
 * lit from below like a device on a black set.
 */
import BoardScene from './BoardScene.astro';
import { SITE, DOWNLOADS } from '../data/site';
---
<section class="hero" aria-labelledby="hero-title">
  <div class="wrap hero-copy">
    <p class="eyebrow eyebrow--glow hero-in" style="--d:0s">Reelay Studio</p>
    <h1 id="hero-title" class="display hero-in" style="--d:.08s">
      <span class="line">Publish everywhere.</span>
      <span class="line text-glow">Never lose control.</span>
    </h1>
    <p class="lede hero-in" style="--d:.18s">
      A desktop app that turns every video you make into a ticket, with
      <strong>copy written for each platform</strong>, a
      <strong>readiness check before anything posts</strong>, and
      <strong>your whole archive kept on your own computer</strong>.
    </p>
    <div class="cta-row hero-in" style="--d:.28s">
      <a class="btn btn-primary btn-lg" href={DOWNLOADS.macArm.href}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M16.4 12.6c0-2.4 2-3.6 2.1-3.6-1.1-1.7-2.9-1.9-3.5-1.9-1.5-.2-2.9.9-3.7.9-.8 0-1.9-.9-3.2-.8-1.6 0-3.1 1-4 2.4-1.7 3-.4 7.4 1.2 9.8.8 1.2 1.8 2.5 3 2.4 1.2 0 1.7-.8 3.1-.8s1.9.8 3.2.8c1.3 0 2.2-1.2 3-2.4.9-1.4 1.3-2.7 1.3-2.8 0 0-2.5-1-2.5-4zM14 5.4c.7-.8 1.1-1.9 1-3-.9 0-2.1.6-2.8 1.4-.6.7-1.2 1.8-1 2.9 1.1.1 2.1-.6 2.8-1.3z"/></svg>
        Download for Mac
      </a>
      <a class="link-more" href="#interactive-workflow">See how it works</a>
    </div>
    <p class="fine hero-in hero-fine" style="--d:.34s">
      Free during the beta · {SITE.version} · {DOWNLOADS.macArm.requirements}
    </p>
  </div>

  <div id="studio-preview" class="wrap-wide product">
    <div class="horizon" aria-hidden="true"></div>
    <div class="product-tilt">
      <BoardScene />
    </div>
    <div class="floor" aria-hidden="true"></div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: calc(var(--r-nav-h) + clamp(4rem, 9vw, 7.5rem));
    padding-bottom: clamp(5rem, 10vw, 9rem);
    text-align: center;
    overflow: clip;
    isolation: isolate;
  }
  .hero::before {
    /* a high, cool key light over the headline */
    content: '';
    position: absolute;
    z-index: -1;
    left: 50%;
    top: -10%;
    width: min(1400px, 160vw);
    height: 900px;
    transform: translateX(-50%);
    background:
      radial-gradient(36% 30% at 50% 22%, rgba(255, 236, 205, 0.1), transparent 70%),
      radial-gradient(60% 50% at 50% 30%, rgba(240, 160, 50, 0.08), transparent 75%);
    pointer-events: none;
  }
  :global(html[data-subnav]) .hero { padding-top: clamp(3.5rem, 8vw, 6.5rem); }
  .hero-copy { display: flex; flex-direction: column; align-items: center; }
  .display .line { display: block; padding-bottom: 0.04em; }
  .hero .lede { margin-top: clamp(1.5rem, 3vw, 2.25rem); max-width: 40rem; }
  .hero .cta-row { justify-content: center; margin-top: clamp(2rem, 3.5vw, 2.75rem); }
  .hero-fine { margin-top: 1.25rem; }

  .product {
    position: relative;
    margin-top: clamp(4rem, 8vw, 7rem);
    perspective: 2400px;
  }
  .product .horizon { bottom: -6%; height: 90%; }
  .product-tilt {
    position: relative;
    transform-origin: 50% 100%;
  }
  .floor {
    position: absolute;
    left: 10%;
    right: 10%;
    bottom: -2.5rem;
    height: 5rem;
    background: radial-gradient(50% 50% at 50% 50%, rgba(255, 190, 110, 0.32), transparent 70%);
    filter: blur(24px);
    z-index: -1;
  }

  /* Entrance: copy rises in sequence; the product settles from a tilt as
     it scrolls into view (scroll-driven, so it costs no script). */
  @media (prefers-reduced-motion: no-preference) {
    .hero-in { animation: rise 1.1s var(--r-ease) both; animation-delay: var(--d, 0s); }
    @keyframes rise { from { opacity: 0; transform: translateY(22px); } to { opacity: 1; transform: none; } }
    @supports (animation-timeline: view()) {
      .product-tilt {
        animation: settle linear both;
        animation-timeline: view();
        animation-range: entry 0% cover 45%;
      }
      @keyframes settle {
        from { transform: rotateX(18deg) scale(0.92); opacity: 0.4; }
        to { transform: none; opacity: 1; }
      }
    }
  }
</style>
