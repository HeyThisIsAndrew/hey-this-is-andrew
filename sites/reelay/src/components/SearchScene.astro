---
/**
 * SearchScene: the Board's archive search (store.py: an FTS5 index over
 * titles, original captions, transcripts, every platform's copy, tags,
 * topic, keywords and notes). A card found by its spoken words shows the
 * quote. Transcripts come from the original post's captions.
 */
const results = [
  { still: 'dusk', title: 'Golden hour at Big Sur', where: 'Found in what was said', quote: ['Look at the water, it is completely ', 'gold', ' right now.'], spoken: true },
  { still: 'desert', title: 'Desert road trip, day four', where: 'Found in the TikTok caption', quote: ['…chasing that ', 'gold', 'en light across the valley floor'], spoken: false },
  { still: 'ocean', title: 'Surf check at dawn', where: 'Found in the hashtags', quote: ['#', 'gold', 'enhour #surf #dawnpatrol'], spoken: false },
];
---
<div class="search-scene" role="img" aria-label="The Board's search for the word gold, finding three videos: one by what was said in it, two by their captions and hashtags.">
  <div class="sbar">
    <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="7" cy="7" r="4.6" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M10.5 10.5 14 14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
    <span class="q">gold<span class="caret"></span></span>
    <span class="hits">3 videos</span>
  </div>
  <ul class="results">
    {results.map((r) => (
      <li class:list={['res', { spoken: r.spoken }]}>
        <span class={`rthumb still still--${r.still}`}></span>
        <span class="rbody">
          <strong>{r.title}</strong>
          <span class="rwhere">{r.spoken && <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 1.5a2.5 2.5 0 0 0-2.5 2.5v4a2.5 2.5 0 0 0 5 0V4A2.5 2.5 0 0 0 8 1.5zM3.5 7.5a.75.75 0 0 0-1.5 0A6 6 0 0 0 7.25 13.4V15h1.5v-1.6A6 6 0 0 0 14 7.5a.75.75 0 0 0-1.5 0 4.5 4.5 0 0 1-9 0z" fill="currentColor"/></svg>}{r.where}</span>
          <span class="rquote">{r.quote[0]}<mark>{r.quote[1]}</mark>{r.quote[2]}</span>
        </span>
      </li>
    ))}
  </ul>
</div>

<style>
  .search-scene {
    padding: clamp(1rem, 2.5vw, 1.5rem);
    border-radius: var(--radius-xl);
    background:
      radial-gradient(70% 50% at 20% 0%, rgba(240, 170, 60, 0.1), transparent 70%),
      linear-gradient(180deg, #151517, #0c0c0d);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08), 0 40px 100px -30px rgba(0, 0, 0, 0.9);
  }
  .sbar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 3.25rem;
    padding: 0 1.1rem;
    border-radius: 16px;
    background: #0a0a0b;
    box-shadow: inset 0 0 0 1px rgba(245, 197, 107, 0.45), 0 0 0 5px rgba(240, 180, 76, 0.08);
  }
  .sbar svg { width: 1.1rem; height: 1.1rem; color: var(--r-ink-3); flex: none; }
  .q { font-size: 1.15rem; font-weight: 500; }
  .caret { display: inline-block; width: 2px; height: 1.15em; margin-left: 2px; vertical-align: -0.2em; background: var(--r-amber); animation: blink 1.1s steps(2, start) infinite; }
  @keyframes blink { to { visibility: hidden; } }
  @media (prefers-reduced-motion: reduce) { .caret { animation: none; } }
  .hits { margin-left: auto; font-size: 0.82rem; color: var(--r-ink-3); }
  .results { list-style: none; display: grid; gap: 0.5rem; margin-top: 0.9rem; }
  .res {
    display: grid;
    grid-template-columns: 4.25rem minmax(0, 1fr);
    gap: 1rem;
    align-items: center;
    padding: 0.7rem;
    border-radius: 16px;
  }
  .res.spoken { background: rgba(255, 255, 255, 0.05); }
  .rthumb { width: 4.25rem; height: 5.6rem; border-radius: 10px; }
  .rbody { display: grid; gap: 0.3rem; min-width: 0; }
  .rbody strong { font-size: 1rem; }
  .rwhere { display: inline-flex; align-items: center; gap: 0.35rem; font-size: 0.8rem; color: var(--r-ink-3); }
  .res.spoken .rwhere { color: var(--r-amber-text); }
  .rwhere svg { width: 0.9rem; height: 0.9rem; }
  .rquote { font-size: 0.92rem; color: var(--r-ink-2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .res.spoken .rquote { white-space: normal; color: var(--r-ink); font-size: 1rem; }
  mark { background: rgba(240, 180, 76, 0.25); color: #fff; border-radius: 4px; padding: 0 0.12em; }
</style>
