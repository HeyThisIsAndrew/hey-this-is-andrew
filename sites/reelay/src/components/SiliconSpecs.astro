---
/**
 * SiliconSpecs.astro: Apple Pro Hardware Architecture Matrix
 * Grounding software performance in Apple Silicon (Metal/NE) & Windows DirectX 12.
 */
import SectionHeader from '@andrew/ui/SectionHeader.astro';

const specs = [
  {
    kicker: "APPLE SILICON M-SERIES",
    title: "Metal Acceleration & Neural Engine",
    desc: "Engineered specifically for M1, M2, M3, and M4 chips. Takes full advantage of Apple's unified memory architecture for zero-copy 4K scrubbing and GPU decoding.",
    bullets: [
      "Hardware-accelerated VP9, AV1, and H.265 playback via Apple Metal pipeline",
      "Apple Neural Engine accelerated Whisper transcription without CPU throttling",
      "Apple Notarized, Gatekeeper-verified native ARM64 universal binary",
    ],
    tag: "Native macOS 13+ Ventura or Sonoma",
  },
  {
    kicker: "WINDOWS 10 & 11 WORKSTATIONS",
    title: "DirectX 12 & Media Foundation",
    desc: "Optimized for modern multi-core x86_64 workstations and dedicated NVIDIA / AMD GPUs. Zero Electron overhead—compiled native performance.",
    bullets: [
      "DirectX 12 hardware video acceleration for high-framerate playback",
      "Windows Credential Manager (DPAPI) token encryption",
      "Multi-threaded background queue for automated bulk imports",
    ],
    tag: "Windows 10 / 11 (64-bit)",
  },
  {
    kicker: "LOCAL NVMe & SQLITE ENGINE",
    title: "Your Computer is the Database",
    desc: "Your video files never touch multi-tenant cloud servers. All drafts, metadata, and tags live in an embedded SQLite database on your personal storage drive.",
    bullets: [
      "Sub-millisecond queries via SQLite FTS5 full-text speech search index",
      "Zero recurring cloud database charges or token markups",
      "One-click complete profile deletion or portable backup export",
    ],
    tag: "100% Local Disk Custody",
  },
];
---

<section class="section silicon-specs-section" aria-labelledby="silicon-heading">
  <span id="silicon-architecture" class="sr-only"></span>
  <div class="container">
    <SectionHeader
      index="03"
      kicker="HARDWARE & SILICON OPTIMIZATION"
      title="Built for Apple Silicon & High-Performance PCs"
      lede="Reelay is not a browser app in a web frame. It is native compiled desktop software engineered to unlock the full potential of your workstation."
      id="silicon-heading"
    />

    <div class="silicon-grid">
      {specs.map((spec) => (
        <div class="silicon-card">
          <div class="silicon-card-top">
            <span class="silicon-kicker font-mono">{spec.kicker}</span>
            <span class="silicon-badge font-mono">{spec.tag}</span>
          </div>
          <h3 class="silicon-title">{spec.title}</h3>
          <p class="silicon-desc">{spec.desc}</p>
          <ul class="silicon-bullets">
            {spec.bullets.map((b) => (
              <li>{b}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .silicon-specs-section {
    padding-top: clamp(3.5rem, 6vw, 6rem);
    padding-bottom: clamp(3.5rem, 6vw, 6rem);
    border-bottom: 1px solid var(--hairline);
    background-color: rgba(255, 255, 255, 0.01);
    position: relative;
  }

  .silicon-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.75rem;
    margin-top: 3rem;
  }

  .silicon-card {
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.03) 0%, rgba(255, 255, 255, 0.005) 100%), #0c0d12;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-lg);
    padding: clamp(1.75rem, 3vw, 2.35rem);
    display: flex;
    flex-direction: column;
    box-shadow: 0 15px 45px rgba(0, 0, 0, 0.5);
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .silicon-card:hover {
    transform: translateY(-2px);
    border-color: rgba(255, 255, 255, 0.25);
    box-shadow: 0 20px 55px rgba(0, 0, 0, 0.7);
  }

  .silicon-card-top {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .silicon-kicker {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--brand);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .silicon-badge {
    font-size: 0.72rem;
    color: var(--text-secondary);
    background-color: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 0.25rem 0.6rem;
    border-radius: 6px;
    width: fit-content;
  }

  .silicon-title {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: #ffffff;
    line-height: 1.25;
    margin-bottom: 0.85rem;
  }

  .silicon-desc {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .silicon-bullets {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 1.25rem;
    border-top: 1px solid var(--hairline);
  }

  .silicon-bullets li {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.5;
    position: relative;
    padding-left: 1.15rem;
  }

  .silicon-bullets li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--brand);
    font-weight: bold;
  }

  @media (max-width: 1024px) {
    .silicon-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
