// Cloudflare Worker serving this static site from dist/. The site links to
// /support, not /support/, so that is the form served without a redirect.
// Deploy: pnpm cf deploy reelay (or push to main; see .github/workflows/cloudflare.yml).
{
  "name": "reelay",
  "compatibility_date": "2026-10-06",
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  }
}
