---
import Layout from '../../layouts/Layout.astro';
import { getArticleFeedItems } from '../../lib/articles';
import { getVideoItems } from '../../lib/feed-items';
import { DEFAULT_BYLINE } from '../../data/sections.js';
import CardGrid from '../../components/CardGrid.astro';
import ContentCard from '../../components/ContentCard.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { Image } from 'astro:assets';
import andrewHeadshot from '../../assets/andrew-headshot.webp';
import { SOCIAL_ICONS } from '../../data/icons.js';

export async function getStaticPaths() {
  const author = {
    slug: 'andrew-baxter',
    ...DEFAULT_BYLINE
  };
  
  return [{ params: { slug: author.slug }, props: { author } }];
}

const { author } = Astro.props;

// Use 4 items instead of 5 so they form a perfect single row on desktop (which is a 4-column grid).
const latestArticles = getArticleFeedItems().slice(0, 4);
const latestVideos = (await getVideoItems()).slice(0, 4);

const founderSocials = [
  { name: 'Instagram', url: 'https://www.instagram.com/hey_thisisandrew/', icon: SOCIAL_ICONS.Instagram },
  { name: 'YouTube', url: 'https://www.youtube.com/@HeyThisIsAndrew', icon: SOCIAL_ICONS.YouTube },
  { name: 'TikTok', url: 'https://www.tiktok.com/@hey_thisisandrew', icon: SOCIAL_ICONS.TikTok },
  { name: 'Threads', url: 'https://www.threads.net/@hey_thisisandrew', icon: SOCIAL_ICONS.Threads },
  { name: 'Facebook', url: 'https://www.facebook.com/thisisandrew', icon: SOCIAL_ICONS.Facebook },
  { name: 'Twitter', url: 'https://twitter.com/_ThisIsAndrew', icon: SOCIAL_ICONS.Twitter },
  { name: 'Bluesky', url: 'https://bsky.app/profile/thisisandrew.bsky.social', icon: SOCIAL_ICONS.Bluesky },
  { name: 'LinkedIn', url: 'https://www.linkedin.com/in/andrewlwyrbaxter/', icon: SOCIAL_ICONS.LinkedIn },
  { name: 'Substack', url: 'https://thisiscoffeetalk.substack.com/', icon: SOCIAL_ICONS.Substack },
];

const mobileSocialRows = [
  founderSocials.slice(0, Math.ceil(founderSocials.length / 2)),
  founderSocials.slice(Math.ceil(founderSocials.length / 2)),
];


import { site } from '../../data/site.js';
const title = `${author.name} | BE UNCONVENTIONAL HQ`;
const description = author.bio;

const profileSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  'mainEntity': {
    '@type': 'Person',
    'name': author.name,
    'description': author.bio,
    'jobTitle': author.role,
    'url': new URL(Astro.url.pathname, site.url).toString(),
    'image': new URL('/_astro/andrew-headshot.webp', site.url).toString(),
    'sameAs': founderSocials.map(s => s.url)
  }
};

---


<Layout title={title} description={description}>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(profileSchema)} />
  <main class="author-page">

    <section class="masthead-section">
      <div class="masthead-container">
        <div class="masthead-image">
          <div class="masthead-image-wrapper">
            <Image
              src={andrewHeadshot}
              alt="Andrew Baxter"
              class="founder-img"
              width={400}
              height={400}
            />
          </div>
        </div>
        <div class="masthead-bio">
          <h1 class="founder-name">{author.name}</h1>
          <h2 class="founder-title">{author.role}</h2>
          
          <div class="desktop-socials">
            {founderSocials.map((social, index) => (
              <>
                <a href={social.url} target="_blank" rel="noopener noreferrer" aria-label={social.name} class="founder-social-link">
                  <span class="social-icon-wrapper" set:html={social.icon} />
                </a>
                {index < founderSocials.length - 1 && <span class="social-separator">|</span>}
              </>
            ))}
          </div>

          <div class="mobile-socials">
            {mobileSocialRows.map((row) => (
              <div class="social-row">
                {row.map((social, index) => (
                  <>
                    <a href={social.url} target="_blank" rel="noopener noreferrer" aria-label={social.name} class="founder-social-link">
                      <span class="social-icon-wrapper" set:html={social.icon} />
                    </a>
                    {index < row.length - 1 && <span class="social-separator">|</span>}
                  </>
                ))}
              </div>
            ))}
          </div>
          
          <div class="founder-text">
            <p>
              He spent more than a decade in games and technology, including time at Sony Interactive Entertainment as a software engineer and in quality assurance. That background informs the coverage: not access, but a working knowledge of how these products are built, tested, and shipped, and what that means for the people who play and watch them. He founded BE Unconventional HQ in 2026 and edits its film, television, and games coverage.
            </p>
          </div>
        </div>
      </div>
    </section>

    {latestArticles.length > 0 && (
      <section class="highlights-section">
        <SectionHeading title="LATEST ARTICLES" />
        <CardGrid columns={4}>
          {latestArticles.map((item: any, index: number) => (
            <ContentCard item={item} index={index} />
          ))}
        </CardGrid>
      </section>
    )}

    {latestVideos.length > 0 && (
      <section class="highlights-section">
        <SectionHeading title="LATEST VIDEOS" />
        <CardGrid columns={4}>
          {latestVideos.map((item: any, index: number) => (
            <ContentCard item={item} index={index} />
          ))}
        </CardGrid>
      </section>
    )}
  </main>
</Layout>

<style>
  .author-page {
    /* Offset the fixed navbar so content doesn't slip underneath it */
    padding-top: var(--space-navbar-height, 80px);
    padding-bottom: 4rem;
  }

  .masthead-section {
    padding: 2rem 2rem 4rem 2rem;
    max-width: 1536px;
    margin: 0 auto;
  }

  .masthead-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3rem;
    background: rgba(25, 25, 25, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 3rem;
    border-radius: 0;
  }

  @media (min-width: 768px) {
    .masthead-container {
      flex-direction: row;
      align-items: flex-start;
    }
  }

  .masthead-image {
    flex-shrink: 0;
  }

  .masthead-image-wrapper {
    width: 200px;
    height: 200px;
    border-radius: 50%;
    border: 2px solid var(--color-accent);
    overflow: hidden;
  }

  .founder-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .masthead-bio {
    flex-grow: 1;
  }

  .founder-name {
    font-size: 2rem;
    font-weight: 800;
    color: var(--color-white);
    margin-bottom: 0.25rem;
  }
  .founder-name a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .founder-name a:hover,
  .founder-name a:active {
    color: var(--color-accent-text, #ef4444);
  }

  .founder-title {
    font-size: 1rem;
    color: var(--color-accent-text);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 1rem;
  }

  .desktop-socials {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: clamp(0.15rem, 1vw, 1rem);
    margin-bottom: 1.5rem;
  }

  .mobile-socials {
    display: none;
  }

  .founder-social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-white-muted);
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .founder-social-link:hover {
    color: var(--color-accent-text);
    transform: translateY(-2px);
  }
  
  .social-icon-wrapper {
    display: inline-block;
    width: 24px;
    height: 24px;
  }

  .social-icon-wrapper :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
    fill: currentColor;
  }

  .social-separator {
    color: var(--color-white-muted);
    opacity: 0.3;
    font-size: 0.9rem;
  }

  .founder-text p {
    color: var(--color-white-muted);
    font-size: 1.25rem;
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .highlights-section {
    padding: 0 2rem;
    max-width: 1536px;
    margin: 0 auto 4rem auto;
  }


  @media (max-width: 768px) {
    .masthead-container {
      padding: 2rem;
      text-align: center;
    }
    .founder-text {
      text-align: left;
      text-wrap: pretty;
      max-width: 260px;
      margin: 0 auto;
    }
    .founder-text p {
      font-size: 0.95rem;
    }
    .desktop-socials {
      display: none;
    }
    .mobile-socials {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
      width: 100%;
      margin: 0 auto 2rem auto;
    }
    .social-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      width: 100%;
    }
  }
</style>
