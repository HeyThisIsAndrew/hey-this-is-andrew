---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site.js';
import SocialsSection from '../components/SocialsSection.astro';
import SectionHeader from '../components/SectionHeader.astro';
import PageTitle from '../components/PageTitle.astro';
import { SOCIAL_ICONS } from '../data/icons.js';
import { Image } from 'astro:assets';
import Button from '../components/Button.astro';
import CtaPanel from '../components/CtaPanel.astro';
/*
  The PRE-CROPPED mark (src/assets/logo-mark.webp), not logo.webp.

  logo.webp is a 2000x2000 square canvas whose artwork is only 1909x839, so
  the other 58% of its height is transparent padding. Because the <Image>
  width/height attributes set the reserved aspect ratio, `.about-image-container`
  was sizing a SQUARE box for artwork that fills 42% of it, and on a two-column
  hero that empty box is what set the section's height. logo-mark.webp is the
  same artwork on its real content box, so the box size IS the mark size.
  Same reasoning as the fallback mark in ArticleThumb.astro.
*/
import logoImage from '../assets/logo-mark.webp';
import andrewHeadshot from '../assets/andrew-headshot.webp';

const title = `About | ${site.name}`;
const description =
  'BE Unconventional HQ is an editorial publication where nerd culture gets cinematic. Covering Film, TV, Games, and Events with a focus on the craft behind the stories.';

const pillars = [
  {
    value: 'FILM \u00b7 TV \u00b7 GAMES',
    label: 'Coverage',
    desc: 'Reviews, analysis, and event reporting',
    backText: 'Film, television, and games, plus reporting from the events where that work gets shown.',
    longValue: true,
  },
  {
    value: '2026',
    label: 'Founded',
    desc: 'Independent, no publisher',
    backText: 'Founded in 2026 and run independently. No publisher, no network, and no editorial mandate from anyone else.',
  },
  {
    value: 'WEEKLY',
    label: 'Publishing Cadence',
    desc: 'New coverage every week',
    backText: 'New coverage every week, so what we publish keeps pace with what is actually releasing.',
  },
  {
    value: '4K',
    label: 'Production Standard',
    desc: 'Sony Alpha, DaVinci Resolve, Shure',
    backText: 'Shot on Sony Alpha bodies, recorded with Shure microphones, and graded in DaVinci Resolve. Finished in 4K.',
  },
];

const founderSocials = [
  { name: 'Instagram', url: 'https://www.instagram.com/hey_thisisandrew/', icon: SOCIAL_ICONS.Instagram },
  { name: 'YouTube', url: 'https://www.youtube.com/@HeyThisIsAndrew', icon: SOCIAL_ICONS.YouTube },
  { name: 'TikTok', url: 'https://www.tiktok.com/@hey_thisisandrew', icon: SOCIAL_ICONS.TikTok },
  { name: 'Threads', url: 'https://www.threads.net/@hey_thisisandrew', icon: SOCIAL_ICONS.Threads },
  { name: 'Facebook', url: 'https://www.facebook.com/thisisandrew', icon: SOCIAL_ICONS.Facebook },
  { name: 'Twitter', url: 'https://twitter.com/_ThisIsAndrew', icon: SOCIAL_ICONS.Twitter },
  { name: 'Bluesky', url: 'https://bsky.app/profile/thisisandrew.bsky.social', icon: SOCIAL_ICONS.Bluesky },
  { name: 'LinkedIn', url: 'https://www.linkedin.com/in/andrewlwyrbaxter/', icon: SOCIAL_ICONS.LinkedIn },
  { name: 'Substack', url: 'https://thisiscoffeetalk.substack.com/', icon: SOCIAL_ICONS.Substack },
];

/* The mobile social row splits into two lines. Derived from the list rather
   than hardcoded so removing a platform cannot leave a dangling separator. */
const mobileSocialRows = [
  founderSocials.slice(0, Math.ceil(founderSocials.length / 2)),
  founderSocials.slice(Math.ceil(founderSocials.length / 2)),
];


const founderSocialsList = [
  'https://www.youtube.com/@HeyThisIsAndrew',
  'https://www.tiktok.com/@hey_thisisandrew',
  'https://www.threads.net/@hey_thisisandrew',
  'https://www.facebook.com/thisisandrew',
  'https://twitter.com/_ThisIsAndrew',
  'https://bsky.app/profile/thisisandrew.bsky.social',
  'https://www.linkedin.com/in/andrewlwyrbaxter/',
  'https://thisiscoffeetalk.substack.com/'
];

const aboutSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  'mainEntity': {
    '@type': 'Person',
    'name': 'Andrew Baxter',
    'description': 'Founder & Editor of BE Unconventional HQ',
    'jobTitle': 'Founder & Editor',
    'image': new URL('/_astro/andrew-headshot.webp', site.url).toString(),
    'url': site.url,
    'sameAs': founderSocialsList
  }
};

---


<Layout title={title} description={description}>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(aboutSchema)} />
  <main class="about-page">

    <section class="about-hero">
      <div class="about-image-container ">
        <Image
          src={logoImage}
          alt="BE Unconventional HQ"
          class="about-profile-img"
          width={1000}
          height={460}
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <div class="about-story " data-delay="200">
        <p class="section-kicker about-kicker">The Publication</p>
        <h1 class="about-title-main">WHERE NERD CULTURE GETS CINEMATIC</h1>
        <p class="about-title-sub">FILM | TV | GAMES | EVENTS</p>
        <div class="about-text">
          <p>
            <strong>BE Unconventional HQ</strong> is an editorial publication for people who love the craft behind the stories. Our principle is simple: if we're talking cinema, then our content should look like cinema.
          </p>
          <p>
            From breaking down the cinematography of a new film or show to exploring game design, covering live events, and diving into the filmmaking process, our goal is to slow down, appreciate the details, and have genuine conversations.
          </p>
          <p>
            No clickbait, no artificial outrage, just unfiltered honesty and expertise-driven industry analysis.
          </p>
          <p>
            If you're passionate about Movies, TV, Games, and Events you're in the right place.
          </p>
          <p class="about-motto">
            BE YOURSELF. <br />
            BE PASSIONATE. <br />
            BE UNCONVENTIONAL.
          </p>
        </div>
      </div>
    </section>

    <section class="masthead-section ">
      <SectionHeader class="about-section-header">
        <PageTitle
          kicker="MASTHEAD"
          primary="INSIDE THE"
          secondary="HQ"
          scale="secondary"
        />
      </SectionHeader>
      <div class="masthead-container">
        <div class="masthead-image">
          {/* The photo goes where the name beside it goes. A mouse and touch
              target only (aria-hidden, out of the tab order): the name link
              is the keyboard and screen-reader path, so the author stays one
              stop, and the photo's alt would only repeat the heading. */}
          <a href="/author/andrew-baxter" class="masthead-image-wrapper" tabindex="-1" aria-hidden="true">
            <Image
              src={andrewHeadshot}
              alt=""
              class="founder-img"
              width={400}
              height={400}
            />
          </a>
        </div>
        <div class="masthead-bio">
          <h2 class="founder-name"><a href="/author/andrew-baxter">Andrew Baxter</a></h2>
          <h3 class="founder-title">Founder & Editor</h3>
          <div class="founder-socials desktop-socials">
            {founderSocials.map((social, index) => (
              <>
                <a href={social.url} target="_blank" rel="noopener noreferrer" aria-label={social.name} class="founder-social-link">
                  <span class="social-icon-wrapper" set:html={social.icon} />
                </a>
                {index < founderSocials.length - 1 && <span class="social-separator">|</span>}
              </>
            ))}
          </div>

          <div class="mobile-socials">
            {mobileSocialRows.map((row) => (
              <div class="social-row">
                {row.map((social, index) => (
                  <>
                    <a href={social.url} target="_blank" rel="noopener noreferrer" aria-label={social.name} class="founder-social-link">
                      <span class="social-icon-wrapper" set:html={social.icon} />
                    </a>
                    {index < row.length - 1 && <span class="social-separator">|</span>}
                  </>
                ))}
              </div>
            ))}
          </div>
          <div class="founder-text">
            <p>
              He spent more than a decade in games and technology, including time at Sony Interactive Entertainment as a software engineer and in quality assurance. That background informs the coverage: not access, but a working knowledge of how these products are built, tested, and shipped, and what that means for the people who play and watch them. He founded BE Unconventional HQ in 2026 and edits its film, television, and games coverage.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="stats-section">
      <div class="stats-grid">
        {/*
          The button takes an EXPLICIT name rather than computing one from its
          contents. Both faces of the card live inside it, so left to itself it
          announced the value, the label, the sub-line and then the whole
          back-face paragraph as a single run. `aria-label` fixes what is read;
          `aria-describedby` then offers the back copy as the description,
          which is what it actually is.
        */}
        {
          pillars.map((pillar, index) => (
            <button
              class="stat-card flip-card "
              data-delay={100 + index * 100}
              aria-label={`${pillar.label}: ${pillar.value}. ${pillar.desc}`}
              aria-describedby={`pillar-back-${index}`}
            >
              <div class="flip-card-inner">
                <div class="flip-card-front">
                  <span class:list={['stat-value', pillar.longValue && 'stat-value-long']}>
                    {pillar.value}
                  </span>
                  <span class="stat-label">{pillar.label}</span>
                  <p class="pillar-desc">{pillar.desc}</p>
                  {/* The affordance. Nothing previously signalled that these
                      cards had a back at all. `aria-hidden` because the
                      description below already tells a screen reader what is
                      there, in words rather than a glyph. */}
                  <span class="flip-hint" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M2 12a10 10 0 0 1 17-7.1L22 8" />
                      <path d="M22 3v5h-5" />
                    </svg>
                  </span>
                </div>
                <div class="flip-card-back">
                  <p id={`pillar-back-${index}`}>{pillar.backText}</p>
                </div>
              </div>
            </button>
          ))
        }
      </div>
    </section>

    <SocialsSection />

    {/* `stagger={false}` because "Editorial Inquiries" is a multi-word tail:
        the lockup's default tuck would run it through the line above. */}
    <CtaPanel
      class="press-inquiries-section"
      kicker="Media"
      primary="Press and"
      secondary="Editorial Inquiries"
      description="Screeners, review copies, event credentials, and partnership requests all start in one place."
      stagger={false}
    >
      <Button href="/collaborations">Visit Collaborations</Button>
    </CtaPanel>
  </main>

</Layout>

<style>
  .about-section-header {
    /* Was 5rem, stacking on top of `.about-hero`'s own bottom margin for a
       double section break between the publication copy and the founder card.
       The shared `--space-section-header` token is the single source of that
       header-to-content gap now, so this rule can go away entirely once the
       global `.section-header` rule is the only one that sets it. */
    margin-bottom: var(--space-section-header);
  }

  .about-kicker {
    color: var(--color-accent-text);
    font-size: clamp(0.75rem, calc(0.375rem + 0.9vw), 1.1rem);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    margin-bottom: 1.25rem;
    text-align: center;
  }

  .about-story h1.about-title-main {
    text-align: center;
    text-wrap: balance;
    font-size: clamp(1.2rem, calc(0.75rem + 1.2vw), 2.2rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--color-white);
    text-shadow: 0 10px 40px rgba(0, 0, 0, 0.6);
    line-height: 1.2;
    /* NOT `white-space: nowrap`. See the grid note in about.css: nowrap made
       this heading's min-content width the hero's column sizer and starved
       the logo beside it. `text-wrap: balance` above splits it evenly when it
       does wrap, which on a wide desktop it still does not need to. */
    margin-bottom: 1rem;
  }

  .about-title-sub {
    text-align: center;
    color: rgba(255, 255, 255, 0.9);
    font-size: clamp(0.6rem, calc(0.4rem + 1vw), 1rem);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    text-shadow: 0 0 15px rgba(255, 255, 255, 0.2);
    margin-top: 0.5rem;
    margin-bottom: 2rem;
    white-space: nowrap;
  }

  .about-motto {
    color: rgba(255, 255, 255, 0.9);
    font-size: clamp(0.6rem, calc(0.4rem + 1vw), 1rem);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    text-shadow: 0 0 15px rgba(255, 255, 255, 0.2);
    margin-top: 2.5rem;
    /* Do not force nowrap so it can wrap on mobile gracefully */
  }

  @media (min-width: 769px) {
    .about-motto br {
      display: none;
    }
  }

  /* "FILM · TV · GAMES" cannot ride the numeric `.stat-value` scale without
     overflowing the card, so long values get their own step down. */
  .stat-value-long {
    font-size: clamp(1rem, calc(0.7rem + 0.9vw), 1.25rem);
    letter-spacing: 0.06em;
    line-height: 1.3;
    text-wrap: balance;
  }

  .pillar-desc {
    font-size: 0.8rem;
    color: var(--color-white-muted);
    margin-top: 0.5rem;
    line-height: 1.4;
    text-wrap: balance;
  }

  .masthead-section {
    padding: 0 2rem;
    max-width: 1536px;
    margin: 0 auto var(--space-section) auto;
  }

  .masthead-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3rem;
    background: rgba(25, 25, 25, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 3rem;
    border-radius: 0;
  }

  @media (min-width: 768px) {
    .masthead-container {
      flex-direction: row;
      align-items: flex-start;
    }
  }

  .masthead-image {
    flex-shrink: 0;
  }

  .masthead-image-wrapper {
    display: block;
    width: 200px;
    height: 200px;
    border-radius: 50%;
    border: 2px solid var(--color-accent);
    overflow: hidden;
  }

  .founder-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .masthead-bio {
    flex-grow: 1;
  }

  .founder-name {
    font-size: 2rem;
    font-weight: 800;
    color: var(--color-white);
    margin-bottom: 0.25rem;
  }
  .founder-name a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .founder-name a:hover,
  .founder-name a:active {
    color: var(--color-accent-text, #ef4444);
  }

  .founder-title {
    font-size: 1rem;
    color: var(--color-accent-text);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 1rem;
  }

  .desktop-socials {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: clamp(0.15rem, 1vw, 1rem);
    margin-bottom: 1.5rem;
  }

  .mobile-socials {
    display: none;
  }

  .founder-social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-white-muted);
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .founder-social-link:hover {
    /* `--color-accent-text` (#ef4444), not `--color-accent` (#cc0000).

       These marks sit on the masthead card, which resolves to #111111. The
       deep red measures 3.21:1 there: it clears the 3:1 floor for a non-text
       graphic, but only just, and it is LOWER than the icons' own resting
       #888888 at 5.33:1. A hover state that reduces contrast is backwards.
       The lighter accent reads at 5.02:1 and is the same brand red the
       kickers use. `--color-accent` stays what it is: a border and glow
       colour, which is the only role it has the contrast for. */
    color: var(--color-accent-text);
    transform: translateY(-2px);
  }
  
  .social-icon-wrapper {
    display: inline-block;
    width: 24px;
    height: 24px;
  }

  .social-icon-wrapper :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
    fill: currentColor;
  }

  .social-separator {
    color: var(--color-white-muted);
    opacity: 0.3;
    font-size: 0.9rem;
  }

  .founder-text p {
    color: var(--color-white-muted);
    font-size: 1.25rem;
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  /*
    The flip affordance.

    A card that hides half its content behind hover has to say so. This is a
    small rotate glyph in the corner of the front face: dim at rest, accent on
    hover or keyboard focus, and gone the moment the card turns (it belongs to
    the front, and the front is what is leaving).
  */
  .flip-hint {
    position: absolute;
    right: 0.85rem;
    bottom: 0.85rem;
    display: inline-flex;
    color: var(--color-white-muted);
    opacity: 0.45;
    transition: opacity 0.3s ease, color 0.3s ease;
  }

  .flip-card:hover .flip-hint,
  .flip-card:focus-visible .flip-hint {
    color: var(--color-accent-text);
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .flip-hint {
      /* Without the turn to explain it, a rotate arrow is a lie. The cards
         still swap faces below; the glyph just stops implying motion. */
      opacity: 0.6;
    }
  }

  /* FLIP CARD STYLES */
  .flip-card {
    background: transparent;
    border: none;
    padding: 0;
    cursor: pointer;
    perspective: 1000px;
    width: 100%;
  }

  .flip-card-inner {
    position: relative;
    width: 100%;
    height: 100%;
    text-align: center;
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    transform-style: preserve-3d;
  }

  .flip-card:hover .flip-card-inner,
  .flip-card:focus .flip-card-inner,
  .flip-card:focus-within .flip-card-inner {
    transform: rotateY(180deg);
  }

  @media (prefers-reduced-motion: reduce) {
    /* Swap the faces without spinning them. The information stays reachable;
       only the 600ms 3D rotation goes away. */
    .flip-card-inner {
      transition: none;
    }
  }

  /* Reset global stat-card hover translateY since inner flips */
  .stat-card.flip-card:hover {
    transform: none;
    border-color: transparent;
    box-shadow: none;
  }

  .flip-card-front, .flip-card-back {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
    border-radius: 0;
    padding: 2.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    background: var(--color-surface);
    border: 1px solid rgba(255, 255, 255, 0.05);
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .flip-card:hover .flip-card-front,
  .flip-card:hover .flip-card-back {
    border-color: var(--color-accent);
    box-shadow: 0 8px 30px rgba(204, 0, 0, 0.1);
  }

  /* The front needs position relative to dictate the total height of the container */
  .flip-card-front {
    position: relative; 
  }

  .flip-card-back {
    transform: rotateY(180deg);
    background: rgba(25, 25, 25, 0.95);
    text-align: center;
  }

  .flip-card-back p {
    color: var(--color-white);
    font-size: 1.05rem;
    line-height: 1.5;
    margin: 0;
    width: 100%;
    text-wrap: balance;
  }

  @media (max-width: 768px) {
    .about-story h1.about-title-main {
      font-size: clamp(1.2rem, calc(0.5rem + 3vw), 1.6rem);
      text-align: center;
    }
    .masthead-container {
      padding: 2rem;
      text-align: center;
    }
    .founder-text {
      text-align: left;
      text-wrap: pretty;
      max-width: 260px;
      margin: 0 auto;
    }
    .founder-text p {
      font-size: 0.95rem;
    }
    .flip-card-back p {
      font-size: 0.9rem;
    }
    .desktop-socials {
      display: none;
    }
    .mobile-socials {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
      width: 100%;
      margin: 0 auto 2rem auto;
    }
    .social-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      width: 100%;
    }
  }
</style>
