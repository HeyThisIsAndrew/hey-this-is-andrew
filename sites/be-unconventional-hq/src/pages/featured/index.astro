---
import Layout from '../../layouts/Layout.astro';
import { getFeaturedBrandsLocal, getHubBackdropOverride, urlFor, HUB_CATEGORY_LABELS } from '../../lib/local-content';
import { parseVideoId } from '../../lib/platforms/youtube';

/*
  `featuredBrand` docs are read out of src/data/videos.json, which is a frozen
  Sanity export with no generated types — every consumer of it in this repo
  (see /featured/[slug].astro) annotates the doc as `any` for exactly that
  reason. Naming the shape once here is what lets the map/sort callbacks below
  be typed instead of each one tripping ts(7006) "implicitly has an any type".
*/
type Brand = any;

// getFeaturedBrandsLocal() is synchronous — it filters an imported JSON array.
const brands: Brand[] = getFeaturedBrandsLocal();

/*
  Which category a hub sits in is a FIELD ON THE HUB (`hubCategory`), edited in
  the Local CMS, not a lookup table in this file. The table that used to live
  here meant a newly created hub landed in a nameless "other" row until someone
  edited page code, which is not something an editor can do.

  The labels are shared with the hub pages (HUB_CATEGORY_LABELS), which show the
  row a visitor came in through — two copies of that list could disagree with
  each other, and the one on the hub page would be the one that looked wrong.
  Adding a hub is a data change; adding a CATEGORY is a design decision, which
  is why the ordering below stays in code.
*/
const categoryLabels = HUB_CATEGORY_LABELS;

const groupedBrands = brands.reduce((acc: Record<string, Brand[]>, brand: Brand) => {
  const category = brand.hubCategory || 'other';
  if (!acc[category]) acc[category] = [];
  acc[category].push(brand);
  return acc;
}, {} as Record<string, Brand[]>);

const desiredOrder = ['universes', 'streaming', 'studios', 'gaming'];
const sortedCategories = Object.keys(groupedBrands).sort((a, b) => {
  const indexA = desiredOrder.indexOf(a);
  const indexB = desiredOrder.indexOf(b);
  if (indexA === -1 && indexB === -1) return 0;
  if (indexA === -1) return 1;
  if (indexB === -1) return -1;
  return indexA - indexB;
});

/* Gaming's rows run PlayStation, Nintendo, Xbox. Sorted HERE, before the
   preload below reads the first card, so the preload and the deck cannot
   name different images (it used to be sorted inside the render). */
if (groupedBrands.gaming) {
  const gamingOrder = ['playstation', 'nintendo', 'xbox'];
  groupedBrands.gaming = [...groupedBrands.gaming].sort((a: Brand, b: Brand) => {
    const aIdx = gamingOrder.indexOf(a.slug?.current || '');
    const bIdx = gamingOrder.indexOf(b.slug?.current || '');
    if (aIdx === -1 && bIdx === -1) return 0;
    if (aIdx === -1) return 1;
    if (bIdx === -1) return -1;
    return aIdx - bIdx;
  });
}

/*
  ONE builder for a deck card's image, used by the card AND the LCP preload.
  The preload used to name the 600px file alone while the card chose among
  600/1200/2400 by `sizes`, so on a desktop the front card downloaded twice
  (the global QA sweep, rule 1). Same srcset, same sizes, one request.
*/
const DECK_CARD_SIZES = '(max-width: 600px) 600px, (min-width: 1920px) 2250px, 1200px';
const deckCardSources = (heroImage: any) => {
  if (!heroImage) return null;
  const at = (w: number, q: number) => urlFor(heroImage).width(w).auto('format').quality(q).url();
  const mobile = at(600, 70);
  const regular = at(1200, 78);
  const wide = at(2400, 78);
  return { src: regular, srcset: `${mobile} 600w, ${regular} 1200w, ${wide} 2400w`, sizes: DECK_CARD_SIZES };
};

const firstHero = sortedCategories.length > 0 ? deckCardSources(groupedBrands[sortedCategories[0]]?.[0]?.heroImage) : null;

interface BrandMeta {
  color: string;
  rgb: string;
  desc: string;
}

/*
  Brand colour and the one-line description are fields on the hub too
  (`brandColor.hex` and `description`). They were a hardcoded table here,
  which meant the two things an editor most wants to change about a hub —
  what it says and what colour it glows — were the two things they could not
  reach from the CMS.

  The RGB triple the dynamic lighting needs is DERIVED from the hex rather
  than stored beside it. Storing both invites them to drift apart, and there
  is only ever one right answer for a given colour.
*/
function hexToRgbTriple(hex?: string): string {
  const m = /^#?([0-9a-f]{6})$/i.exec((hex ?? '').trim());
  if (!m) return '204, 0, 0'; // site accent, matching the CSS fallback
  const int = parseInt(m[1], 16);
  return `${(int >> 16) & 255}, ${(int >> 8) & 255}, ${int & 255}`;
}

interface BrandMeta {
  color: string;
  rgb: string;
  desc: string;
}

function metaFor(brand: Brand): BrandMeta {
  const hex = brand?.brandColor?.hex;
  return {
    color: hex || 'var(--color-accent)',
    rgb: hexToRgbTriple(hex),
    desc:
      brand?.description ||
      `The definitive source for ${brand?.title ?? 'this hub'} intel, trailers, and updates.`,
  };
}

/* ─────────────────────────────────────────────────────────────────────────
   CINEMATIC TYPOGRAPHY — candidates, and the one that ships.

   Two modes, and which one you get depends on the build:

     • `npm run dev` — the picker renders and every candidate is loaded, so
       faces can be compared live. Default is "Demo all", which puts a
       DIFFERENT candidate on each category with its name beside it.
     • production build — the picker is not emitted at all, only PROD_FONT is
       downloaded, and every title renders in it. No review chrome, and no
       paying for seven unused webfonts on a page that is in the Lighthouse
       gate.

   `family` is the Google Fonts css2 query fragment; `stack` is the CSS
   font-family. To change what ships, change PROD_FONT — nothing else.
   ───────────────────────────────────────────────────────────────────────── */
interface DemoFont {
  id: string;
  short: string;
  label: string;
  family: string;
  stack: string;
  weight: number;
  /** Extra tracking for faces that set too tight at banner sizes. */
  tracking: string;
}

const DEMO_FONTS: DemoFont[] = [
  // ── The four original candidates (issue #138) ──
  { id: 'syncopate', short: 'Syncopate', label: 'SYNCOPATE (Epic Ultra-Wide)',
    family: 'Syncopate:wght@700', stack: "'Syncopate', sans-serif", weight: 700, tracking: '-0.01em' },
  { id: 'bebas', short: 'Bebas Neue', label: 'BEBAS NEUE (Tall/Condensed)',
    family: 'Bebas+Neue', stack: "'Bebas Neue', sans-serif", weight: 400, tracking: '0.01em' },
  { id: 'cinzel', short: 'Cinzel', label: 'CINZEL (Prestige Serif)',
    family: 'Cinzel:wght@700..900', stack: "'Cinzel', serif", weight: 800, tracking: '0.01em' },
  { id: 'oswald', short: 'Oswald', label: 'OSWALD (Modern Tech/Heavy)',
    family: 'Oswald:wght@700', stack: "'Oswald', sans-serif", weight: 700, tracking: '-0.01em' },

  // ── Added candidates, all chosen for behaviour at banner size ──
  // Anton: the blockbuster one-sheet face. Very heavy, tightly condensed, so
  // "THE MULTIVERSE" holds one line where a wide face wraps.
  { id: 'anton', short: 'Anton', label: 'ANTON (Blockbuster Poster)',
    family: 'Anton', stack: "'Anton', sans-serif", weight: 400, tracking: '-0.01em' },
  // Big Shoulders: editorial-cinematic, tall and narrow — title-card energy
  // without Anton's bluntness.
  { id: 'bigshoulders', short: 'Big Shoulders', label: 'BIG SHOULDERS (Tall Editorial)',
    family: 'Big+Shoulders+Display:wght@800', stack: "'Big Shoulders Display', sans-serif", weight: 800, tracking: '0.01em' },
  // Archivo Black: neutral heavy grotesque, closest to the site's own Syne.
  { id: 'archivo', short: 'Archivo Black', label: 'ARCHIVO BLACK (Heavy Neutral)',
    family: 'Archivo+Black', stack: "'Archivo Black', sans-serif", weight: 400, tracking: '-0.02em' },
  // Unbounded: contemporary streaming-brand display, wide and geometric.
  { id: 'unbounded', short: 'Unbounded', label: 'UNBOUNDED (Modern Streamer)',
    family: 'Unbounded:wght@800', stack: "'Unbounded', sans-serif", weight: 800, tracking: '-0.02em' },

  // ── Second batch, added because picking one from eight was still a
  //    coin-toss. These widen the RANGE rather than the count: each is a
  //    different answer to "what kind of brand is this", not another
  //    heavy grotesque.
  // Teko: very tall, very condensed, near-zero sidebearings. Sports-broadcast
  // and trailer-title energy; fits the longest category name on one line at a
  // size no other face here survives.
  { id: 'teko', short: 'Teko', label: 'TEKO (Broadcast Condensed)',
    family: 'Teko:wght@600', stack: "'Teko', sans-serif", weight: 600, tracking: '0.03em' },
  // Michroma: wide, square, monospaced feel. The streaming-service wordmark
  // look — closest thing on Google Fonts to a modern platform logotype.
  { id: 'michroma', short: 'Michroma', label: 'MICHROMA (Platform Wordmark)',
    family: 'Michroma', stack: "'Michroma', sans-serif", weight: 400, tracking: '0.02em' },
  // Orbitron: overt sci-fi geometry. Right for the games and franchise rows,
  // conspicuously wrong for a prestige-studio row — which is useful to see.
  { id: 'orbitron', short: 'Orbitron', label: 'ORBITRON (Sci-Fi Geometric)',
    family: 'Orbitron:wght@700', stack: "'Orbitron', sans-serif", weight: 700, tracking: '0.02em' },
  // Saira Condensed: condensed without Teko's extreme height. The safe pick
  // if Anton reads too blunt and Bebas too thin.
  { id: 'saira', short: 'Saira Cond', label: 'SAIRA CONDENSED (Neutral Condensed)',
    family: 'Saira+Condensed:wght@700', stack: "'Saira Condensed', sans-serif", weight: 700, tracking: '0.02em' },
  // Playfair Display: high-contrast serif. A second prestige option beside
  // Cinzel, and a much less costumed one — Cinzel reads Roman, this reads
  // editorial.
  { id: 'playfair', short: 'Playfair', label: 'PLAYFAIR DISPLAY (Editorial Serif)',
    family: 'Playfair+Display:wght@800', stack: "'Playfair Display', serif", weight: 800, tracking: '0.01em' },
  // Sora: contemporary geometric sans, quieter than all of the above. The
  // control condition — if the page looks better with this, the headings
  // should not be a display face at all.
  { id: 'sora', short: 'Sora', label: 'SORA (Modern Neutral)',
    family: 'Sora:wght@700', stack: "'Sora', sans-serif", weight: 700, tracking: '0.04em' },
  // Russo One: heavy squared-off, motorsport/action-poster. Loud, and the
  // only face here with genuinely square counters.
  { id: 'russo', short: 'Russo One', label: 'RUSSO ONE (Squared Heavy)',
    family: 'Russo+One', stack: "'Russo One', sans-serif", weight: 400, tracking: '0.03em' },

  /*
    GOTHAM STAND-INS.

    Gotham is a licensed Hoefler & Co typeface — it is not on Google Fonts
    and cannot be self-hosted without buying a webfont licence, so it cannot
    simply be dropped in. Montserrat is the long-standing open substitute:
    the same geometric-sans skeleton and near-identical proportions.

    Both weights are here because "Medium" behaves very differently at these
    two jobs. At 90px across a full-bleed bar, Medium is genuinely light —
    elegant and modern, but it does not hold against a bright still. The
    ExtraBold cut is what film marketing actually uses at poster size.
  */
  { id: 'gotham', short: 'Montserrat Md', label: 'MONTSERRAT MEDIUM (Gotham-like)',
    family: 'Montserrat:wght@500', stack: "'Montserrat', sans-serif", weight: 500, tracking: '0.02em' },
  { id: 'gotham-heavy', short: 'Montserrat XB', label: 'MONTSERRAT EXTRABOLD (Gotham Black-like)',
    family: 'Montserrat:wght@800', stack: "'Montserrat', sans-serif", weight: 800, tracking: '-0.01em' },
];

/*
  THE FACE THAT SHIPS.

  Syncopate. The comment here used to describe Montserrat while the constant
  said Cinzel, which is the kind of drift that happens when the prose is not
  next to the thing it describes — so keep this line and the constant edited
  together, and keep it short.

  Toggle in dev to compare. Whatever you land on needs a woff2 in
  public/fonts/ and an entry in SELF_HOSTED_FILES below, or the build throws.
*/
const PROD_FONT = 'gotham';

const IS_DEV = import.meta.env.DEV;

/*
  THE SHIPPING FACE IS SELF-HOSTED. THE PICKER'S EIGHT ARE NOT.

  A render-blocking stylesheet on a third-party origin is the reason this page
  failed the Lighthouse gate at 80% with a 0.276 layout shift. The page paints
  an interim layout while that request is outstanding and re-lays out when it
  lands; the shift tracked the stylesheet's arrival exactly, and serving it
  instantly took CLS to zero. The font itself was never applied — with
  `display=optional` the browser declined it — so this was never about
  typography, only about a slow resource in the critical path.

  Montserrat's latin subset is 18kB. It sits in public/fonts/ beside Inter and
  Syne, which this site already self-hosts for the same reason, and it costs no
  DNS lookup, no TLS handshake and no third-party round trip.

  The other seven faces are a dev-only comparison tool. They stay on Google
  Fonts because none of them ships, and downloading eight families to compare
  them once is not worth committing.
*/
const activeFonts = IS_DEV ? DEMO_FONTS : DEMO_FONTS.filter((f) => f.id === PROD_FONT);
const SELF_HOSTED_FONTS = IS_DEV ? [] : activeFonts.filter((f) => f.id === PROD_FONT);
const REMOTE_FONTS = activeFonts.filter((f) => !SELF_HOSTED_FONTS.includes(f));
/*
  THE SHIPPING FACE USES `font-display: optional` (see selfHostedFaceCss).

  `swap` paints every heading in the fallback and re-lays it out when the real
  face arrives; at `clamp(1.35rem, 6.5vw, 2.5rem)` across four accordion rows
  that reflow is worth a measurable chunk of CLS on a page that once failed the
  gate at 80% with 0.276. `optional` gives the face ~100ms: if it lands it is
  used from first paint, and if it does not the fallback is kept FOR THAT PAGE
  LOAD, so nothing moves after paint either way. It is still cached for the
  next navigation, so a returning visitor sees it immediately.

  That reasoning applies to ONE self-hosted face on a real page load. It does
  NOT apply to the dev picker's stylesheet — see the note on fontImportUrl,
  where `optional` was silently dropping most of the comparison faces.
*/
/*
  `display=swap` HERE, NOT `optional` — and the distinction is the whole reason
  most of the picker's faces appeared not to work.

  `optional` gives the browser about 100ms to fetch a face and PERMANENTLY
  declines it for that page load if it misses. That is the correct trade for
  one shipping face on a real page. It is the wrong one for a stylesheet naming
  seventeen families: the first few files land inside the window and everything
  after them is dropped, which is exactly the reported symptom — every face
  from the fifth (Anton) rightward rendering in the body font while the first
  four worked.

  This URL only ever exists in DEV. Production filters REMOTE_FONTS down to
  nothing (the shipping face is self-hosted below), so `fontImportUrl` is null
  in a build and no third-party request is made at all. There is no CLS budget
  to protect here — this is a comparison tool — so the faces should simply
  arrive, however long they take.
*/
const fontImportUrl = REMOTE_FONTS.length
  ? `https://fonts.googleapis.com/css2?${REMOTE_FONTS.map((f) => `family=${f.family}`).join('&')}&display=swap`
  : null;

/*
  Emitted as one inline <style> rather than written out in the scoped block,
  so the face list stays a single source of truth: adding a candidate to
  DEMO_FONTS is all it takes, and production automatically ships exactly one
  @import instead of eight.
*/
/*
  NO `@import` HERE. IT IS LOADED AS A REAL STYLESHEET IN <head> (below).

  An `@import` inside an inline <style> is the slowest way to load CSS: the
  browser cannot discover it until it has parsed this block, then it fetches
  the stylesheet, then the font. That late arrival is what actually caused the
  0.276 layout shift — measured, the relayout fired the instant the imported
  sheet resolved, and it fired whether or not the font was ever applied
  (`display=optional` correctly declined it and the shift happened anyway).

  A <link> in the head is discovered by the preload scanner immediately, before
  the document body is even parsed, so it resolves during the initial layout
  rather than causing a second one.
*/
/*
  `optional` rather than `swap`: the browser gets a short window to use the
  face, and if it misses, the fallback is kept FOR THAT PAGE LOAD rather than
  being swapped out underneath the reader. Nothing can move after paint. Being
  same-origin and 18kB, it makes the window comfortably in practice.
*/
/*
  The shipping face, self-hosted. Keyed off the font's own id so changing
  PROD_FONT is still a one-line edit: add the woff2 to public/fonts/ and its
  entry here, and nothing else moves. Hardcoding Montserrat's family name and
  filename in this template meant switching the shipping face silently kept
  serving Montserrat's file under the new face's name.
*/
const SELF_HOSTED_FILES: Record<string, { family: string; file: string }> = {
  gotham: { family: 'Montserrat', file: '/fonts/montserrat-500-latin.woff2' },
  cinzel: { family: 'Cinzel', file: '/fonts/cinzel-700-latin.woff2' },
  syncopate: { family: 'Syncopate', file: '/fonts/syncopate-700-latin.woff2' },
};

/*
  A PROD_FONT WITH NO FILE FAILS SILENTLY, SO IT FAILS THE BUILD INSTEAD.

  Without an entry above, no @font-face is emitted and no preload is written:
  the build succeeds, the page ships, and the headings quietly render in the
  fallback sans-serif. Nobody finds that until it is live. scripts/
  featured-containment.test.mjs asserts the same thing offline.
*/
if (!SELF_HOSTED_FILES[PROD_FONT]) {
  throw new Error(
    `PROD_FONT is '${PROD_FONT}' but SELF_HOSTED_FILES has no entry for it. ` +
      'Add the woff2 to public/fonts/ and register it above, or the headings ' +
      'ship in the fallback face with no warning.',
  );
}

const selfHostedFile = SELF_HOSTED_FILES[PROD_FONT] ?? null;

const selfHostedFaceCss = SELF_HOSTED_FONTS.map((f) => {
  const asset = SELF_HOSTED_FILES[f.id];
  if (!asset) return '';
  return `@font-face {
  font-family: '${asset.family}';
  font-style: normal;
  font-weight: ${f.weight};
  font-display: optional;
  src: url('${asset.file}') format('woff2');
}`;
})
  .filter(Boolean)
  .join('\n');

/*
  THE PICKER SETS VARIABLES. IT DOES NOT SET font-family DIRECTLY.

  It used to, and it lost every time. These rules live in an inline <style> in
  the head; the .accordion-title rules they were trying to beat live in this
  component's SCOPED block, which Astro rewrites to
  `.accordion-title[data-astro-cid-…]`. That is one class plus one attribute —
  the same 0,2,0 as `[data-title-font='x'] .accordion-title` — and the scoped
  sheet is emitted after the inline one, so the tie went to the base rule and
  the picker changed nothing. Measured in dev with getComputedStyle: choosing
  any of thirteen faces left the title in the previous face, and the weight
  and tracking never moved for ANY of the seventeen. Only four faces appeared
  to work, and only because a stale duplicate of this block further down the
  scoped sheet still hardcoded those four (see the deletion in this commit).

  Specificity cannot be won here without an arms race:
  `.accordion-section.expanded .accordion-title` is already 0,3,0, and any
  number this file picks today is a number the next rule added to the scoped
  block can beat by accident.

  Custom properties do not play that game. They inherit, the element's own
  declaration wins over the inherited one, and the scoped rules opt in by
  reading them. So the picker publishes three values and the design decides
  where they land — which also means the open row can keep its own weight and
  tracking decisions where it wants them.

  Two selectors per face, and the demo one is deliberately gated on
  `[data-title-font='demo']`: without that gate a per-row variable set on the
  title element itself would beat the picker's value inherited from <main>,
  and picker mode would silently keep showing the demo assignment.
*/
const fontCss = `${selfHostedFaceCss}
${activeFonts
  .map(
    (f) => `[data-title-font='${f.id}'],
[data-title-font='demo'] .accordion-title[data-demo-font='${f.id}'] {
  --accordion-title-face: ${f.stack};
  --accordion-title-weight: ${f.weight};
  --accordion-title-tracking: ${f.tracking};
}`,
  )
  .join('\n')}`;

---

<Layout
  title="Featured Hubs"
  preloadImage={firstHero?.src}
  preloadImageSrcset={firstHero?.srcset}
  preloadImageSizes={firstHero?.sizes}
  /*
    fonts.gstatic.com is where the font FILE comes from, and with
    `display=optional` the browser only has ~100ms to get it before it gives up
    on this page load — so the handshake has to be already open or the face
    never makes the window. googleapis.com serves the stylesheet that names it.
  */
  preconnect={[
    "https://cdn.sanity.io",
    "https://i.ytimg.com",
  ]}
>
  {/* Discovered by the preload scanner, alongside the preconnect above — see
      the note on fontCss. */}
  {/* Dev only — the picker's comparison faces. Production ships the
      self-hosted @font-face above and makes no third-party request. */}
  {fontImportUrl && <link slot="head" rel="stylesheet" href={fontImportUrl} />}
  {selfHostedFile && (
    <link
      slot="head"
      rel="preload"
      as="font"
      type="font/woff2"
      href={selfHostedFile.file}
      crossorigin
    />
  )}
  <style is:inline set:html={fontCss}></style>
  <main class="featured-directory-page" data-title-font={IS_DEV ? 'demo' : PROD_FONT}>
    {/* The page is the accordion, with no visible title, but it still needs
        its one h1 (axe page-has-heading-one): the rows' h2s sit under it. */}
    <h1 class="sr-only">Featured Hubs</h1>
    {sortedCategories.length > 0 ? (
      <div
        class="accordion-container animate-on-scroll"
        style={`--rows: ${sortedCategories.length};`}
      >
        {sortedCategories.map((category, index) => {
          const categoryBrands = groupedBrands[category]; // gaming pre-sorted above

          const isExpanded = index === 0;

          return (
            <div class={`accordion-section ${isExpanded ? 'expanded' : 'collapsed'}`} data-category={category}>
              
              {/*
                A HEADING WRAPPING A BUTTON — the ARIA accordion pattern.

                This was a <div> with a click handler, which meant the three
                collapsed rows could not be reached by keyboard AT ALL: focus
                went from the open row's cards straight to the footer, and the
                closed hubs were simply unreachable without a mouse. A design
                review caught it by trying and failing to Tab to them.

                The <h2> keeps the document outline (the rows are the page's
                sections); the <button> inside it is what takes focus, fires on
                Enter and Space for free, and announces its state through
                aria-expanded. The heading owns the layout box so the button can
                fill it — `display: contents` would be tidier markup but has a
                history of dropping the heading from the accessibility tree in
                exactly the assistive tech this is for.
              */}
              <h2 class="accordion-heading">
                <button
                  type="button"
                  class="accordion-header"
                  aria-expanded={isExpanded ? 'true' : 'false'}
                  aria-controls={`hub-row-${category}`}
                >
                  <span class="accordion-header-bg" aria-hidden="true"></span>

                  <span class="accordion-title" data-demo-font={DEMO_FONTS[index % DEMO_FONTS.length].id}>
                    {categoryLabels[category] || category}
                    {IS_DEV && (
                      <span class="accordion-title-demo-label">
                        — {DEMO_FONTS[index % DEMO_FONTS.length].label}
                      </span>
                    )}
                  </span>
                </button>
              </h2>

              <div class="accordion-body" id={`hub-row-${category}`}>
                <div class="deck-view-container">
                  
                  <div class="deck-column">
                    
                    {/* AMBIENT GLOW BACKLIGHT */}
                    <div class="ambient-glow-container">
                       {categoryBrands.map((brand: Brand, bIndex: number) => {
                         const glowUrl = brand.heroImage ? urlFor(brand.heroImage).width(100).auto('format').quality(60).url() : null;
                         return (
                            <div class={`ambient-glow-layer ${bIndex === 0 ? 'active' : ''}`} data-index={bIndex} style={glowUrl ? `background-image: url(${glowUrl})` : ''}></div>
                         );
                       })}
                    </div>

                    <div class="deck-stack">
                      {categoryBrands.map((brand: Brand, bIndex: number) => {
                        /*
                          An OPEN deck card's key art is the largest unblurred
                          picture on this page, and the ladder stopped at 1200.
                          The page width steps up on wide screens now, so the
                          card measures 2240px on a 4K display — a 1.87x upscale
                          on artwork with no blur to hide it (verified: the
                          element's computed filter is `none`).
                        */
                        const deckArt = deckCardSources(brand.heroImage);
                        const heroUrl = deckArt?.src ?? null;
                        const metaCard = metaFor(brand);
                        return (
                          <a
                            class={`deck-card ${bIndex === 0 ? "active" : bIndex === 1 ? "next-1" : bIndex === 2 ? "next-2" : "hidden"}`}
                            href={`/featured/${brand.slug?.current}`}
                            aria-label={`Enter the ${brand.title} hub`}
                            data-index={bIndex}
                            data-brand-rgb={metaCard.rgb}
                            style={`--brand-rgb: ${metaCard.rgb};`}
                          >

                            <div class="peeking-spine">
                               <span class="spine-text">{brand.title}</span>
                            </div>

                            {/*
                              The FRONT card is the largest thing above the
                              fold, so it is the LCP element — and it was
                              marked lazy, which tells the browser to
                              deprioritise exactly the image the score is
                              measured on. Eager and high priority for that
                              one; everything behind it stays lazy. Only the
                              OPEN row's front card is above the fold: the
                              collapsed rows' front cards stay eager (a row
                              must not open blank) but low priority, or four
                              "high" images split the bandwidth the LCP needs.
                            */}
                            {heroUrl ? (
                              <img
                                src={heroUrl}
                                srcset={deckArt!.srcset}
                                sizes={deckArt!.sizes}
                                alt=""
                                loading={bIndex === 0 ? 'eager' : 'lazy'}
                                fetchpriority={bIndex === 0 ? (isExpanded ? 'high' : 'low') : 'auto'}
                                decoding={bIndex === 0 ? 'sync' : 'async'}
                                class="deck-card-image"
                              />
                            ) : (
                              /*
                                NOT `.article-thumb-fallback`. That shared
                                class paints `--brand-fallback-mark` — this
                                site's own logo — as a watermark, which is
                                correct on our content cards and wrong here:
                                it put BE UNCONVENTIONAL across PlayStation's
                                tile as if it were PlayStation's artwork. Same
                                mistake as backing a hub with a thumbnail of
                                the presenter's face. A hub is somebody else's
                                brand, so its empty state is its own colour and
                                nothing more.
                              */
                              <div class="deck-card-empty" aria-hidden="true"></div>
                            )}

                            {/*
                              THE KEY ART CARRIES THE BRANDING AND THE WAY IN.

                              The mark used to sit in the corner of the trailer
                              on the other side of the row, which meant a hub's
                              identity and a hub's artwork were two separate
                              objects competing to be looked at — and on a phone
                              they landed on top of each other and of the video's
                              own title overlay.

                              One surface instead: the poster IS the button, and
                              the logo sits on it bottom-left the way it does on
                              the video cards elsewhere on this site
                              (`.video-watermark` in ContentCard.astro). The
                              trailer becomes what it should always have been —
                              the plate behind the scene, with nothing to read on
                              it.
                            */}
                            <span class="deck-card-scrim" aria-hidden="true"></span>

                            <span class="deck-card-plate" aria-hidden="true">
                              {brand.logo ? (
                                /* HARD RULE 6: the shadow is on the WRAPPER,
                                   never on the <img>. */
                                <span class="deck-card-logo-wrap">
                                  <img
                                    src={urlFor(brand.logo).height(120).auto('format').url()}
                                    alt=""
                                    class="deck-card-logo"
                                    loading={bIndex === 0 ? 'eager' : 'lazy'}
                                  />
                                </span>
                              ) : (
                                <span class="deck-card-wordmark">{brand.title}</span>
                              )}
                              <span class="deck-card-desc">{metaCard.desc}</span>
                            </span>

                            <span class="deck-card-enter" aria-hidden="true">
                              <span>Enter</span>
                              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                <path d="M5 12h13M13 6l6 6-6 6" />
                              </svg>
                            </span>
                          </a>
                        );
                      })}
                      

                    </div>

                    <div class="deck-nav-track">
                      {categoryBrands.map((brand: Brand, bIndex: number) => {
                         const heroUrl = brand.heroImage ? urlFor(brand.heroImage).width(400).height(200).auto('format').quality(70).url() : null;
                         return (
                           <button
                             type="button"
                             class={`deck-nav-thumb ${bIndex === 0 ? 'active' : ''}`}
                             data-index={bIndex}
                             aria-label={`Show ${brand.title}`}
                             aria-current={bIndex === 0 ? 'true' : 'false'}
                           >
                             
                             {/* TOOLTIP. A <span>, not a <div>: a <button> may
                                 only contain phrasing content. */}
                             <span class="custom-tooltip">{brand.title}</span>

                             {heroUrl ? (
                                <img src={heroUrl} alt="" loading="lazy" class="nav-thumb-img" />
                             ) : (
                                <span class="nav-thumb-fallback">{brand.title}</span>
                             )}
                           </button>
                         );
                      })}
                    </div>
                  </div>

                  <div class="info-column">
                    <div class="info-panels-wrapper">
                      {categoryBrands.map((brand: Brand, bIndex: number) => {
                        const meta = metaFor(brand);
                        const backdrop = getHubBackdropOverride(brand.slug?.current ?? '');
                        /*
                          THE MARK IS THE ART ON THIS SIDE.

                          Reported: "way too much repetition of the same damn
                          image". It was literal — `heroImage` was painted
                          three times in one row: full size on the deck card,
                          again in the nav rail thumbnail, and a third time
                          blown up and blurred as this panel's backdrop. On a
                          hub with one asset the whole row was that one still.

                          So the right-hand side is built from the hub's OTHER
                          asset, its logo. Blown up past the panel and blurred
                          into a coloured haze it is a texture, not a second
                          reading of the same photo; the same file sits crisp
                          and large in front of it as the panel's actual
                          subject. A supplied `backdrops[0]` override still
                          wins, because that is an image chosen for this job.
                        */
                        const markUrl = brand.logo
                          ? urlFor(brand.logo).height(540).auto('format').url()
                          : null;
                        const ghostUrl = brand.logo
                          ? urlFor(brand.logo).height(300).auto('format').url()
                          : null;
                        /* HARD RULE: ids come from parseVideoId(), never inline regex. */
                        const trailerId = parseVideoId(brand.trailerUrl);
                        /* A self-hosted MP4, if one has been supplied. Wins
                           over the embed — see the note at its markup. */
                        const trailerFile: string | null = brand.trailerFile || null;

                        return (
                          <div class={`brand-info-panel ${bIndex === 0 ? 'active' : ''}`} data-index={bIndex} style={`--brand-color: ${meta.color}; --brand-rgb: ${meta.rgb};`}>
                            <div class="large-trailer-card">

                              <div class="trailer-bg-wrapper">
                                {backdrop ? (
                                  /* Deliberately small: blurred past any detail,
                                     so 640px fills a 1000px panel losing nothing
                                     and weighing a tenth as much. */
                                  <div
                                    class="backdrop-plate"
                                    aria-hidden="true"
                                    style={`background-image: url('${urlFor(backdrop.ref).width(640).auto('format').quality(70).url()}');`}
                                  ></div>
                                ) : ghostUrl ? (
                                  <div
                                    class="backdrop-plate backdrop-plate--mark"
                                    aria-hidden="true"
                                    style={`background-image: url('${ghostUrl}');`}
                                  ></div>
                                ) : null}
                              </div>

                              {/*
                                Brand-coloured wash. Independent of any asset,
                                so the thirteen hubs that have neither a logo
                                nor key art still get a lit panel rather than a
                                black rectangle.
                              */}
                              <div class="stage-wash" aria-hidden="true"></div>

                            <div class="trailer-dark-overlay"></div>
                              <div class="trailer-gradient-top"></div>
                              <div class="trailer-gradient-bottom"></div>

                              {/*
                                THE STAGE.

                                A SIBLING of .trailer-bg-wrapper, never a child
                                of it. That wrapper clips (it has to — the blur
                                would otherwise show its own weak edge behind
                                the row heading), and HARD RULE 3 forbids
                                `overflow: hidden` on ANY ancestor of a YouTube
                                iframe: iOS Safari renders a clipped iframe as a
                                black box. Nothing between here and
                                .featured-directory-page clips.
                              */}
                              <div class="brand-stage" data-trailer={(trailerFile || trailerId) ?? undefined}>
                                <div class="brand-stage-mark" aria-hidden="true">
                                  {markUrl ? (
                                    /* HARD RULE 6: no filter on the <img>. The
                                       glow is on the wrapper. */
                                    <img src={markUrl} alt="" class="brand-stage-mark-img" loading="lazy" />
                                  ) : (
                                    <span class="brand-stage-wordmark">{brand.title}</span>
                                  )}
                                </div>

                                {/*
                                  NO PLAYER ON THIS PAGE.

                                  It needed the right half of a 50/50 split to
                                  live in, and that split has moved to the hub
                                  page where it has real content to drive it.
                                  What stays is the mark above — blurred large
                                  behind the poster, which is what gives each
                                  row its colour and shape.

                                  Every problem this page had came from
                                  autoplaying somebody else's embed on a screen
                                  nobody had clicked into: the paused-player
                                  chrome, the caption track, blocked autoplay.
                                  On a hub page playback follows a click, so
                                  none of it applies there.

                                  The player's CSS and its controller are still
                                  in this file and are now unreferenced. They
                                  are the thing being lifted onto the hub page
                                  next, so they are left intact for that move
                                  rather than deleted and rewritten from
                                  memory. Nothing loads: no markup, no src.
                                */}
                              </div>
                            </div>
                          </div>
                        );
                      })}
                    </div>
                  </div>

                </div>
              </div>
            </div>
          );
        })}
      </div>
    ) : (
      <div class="container-page">
        <p class="featured-empty">Dedicated coverage hubs are coming soon.</p>
      </div>
    )}
  
    {/*
      Typeface picker — DEV ONLY. `import.meta.env.DEV` is false for
      `astro build`, so this markup, and the seven non-shipping webfonts it
      exists to compare, never reach a deployed page.
    */}
    {IS_DEV && (
      <div class="font-picker" role="group" aria-label="Preview heading typeface">
        <span class="font-picker-label">Typeface</span>
        <button type="button" class="font-picker-btn" data-font="demo" aria-pressed="true">Demo per row</button>
        {/*
          `data-family` is the face's real family name, which the picker script
          needs to ask document.fonts whether the file actually arrived. Taken
          from the stack's first entry so it can never disagree with the CSS.
        */}
        {DEMO_FONTS.map((f) => (
          <button
            type="button"
            class="font-picker-btn"
            data-font={f.id}
            data-family={f.stack.split(',')[0].trim().replace(/^'|'$/g, '')}
            data-weight={String(f.weight)}
            aria-pressed="false"
          >{f.short}</button>
        ))}
      </div>
    )}
  </main>
</Layout>

<script>
  /*
    NO SOUND ON NAVIGATION.

    Opening a row, bringing a card forward and picking a nav thumbnail each
    fired a synthesised bass thud. A design review flagged it as abrasive on a
    control people click repeatedly, and the owner has since cut it outright.
    The AudioContext went with it: keeping one alive to play nothing is a
    resource the page has no use for.
  */

  /* ══════════════════════════════════════════════════════════════════════
     THE TRAILER PLAYS ONCE, IN THE OPEN ROW ONLY.

     Removing the video outright was an overcorrection on my part — the ask was
     to stop YouTube's own branding showing, not to lose the trailer. It is
     back, with the three things that made it a problem handled in the markup
     and the CSS above (inset rather than full-bleed, a lit mark behind it, and
     no clipping ancestor), and the two that are timing handled here.

     ONE ROW AT A TIME. Every stage that is not the active panel of the
     expanded row is torn down, so at most one player exists on the page. A
     collapsed row's iframe is not merely hidden, it is unloaded — an iframe
     that is only display:none still holds its document, its script and its
     network connections.

     IT DOES NOT LOOP. Looping is what made YouTube's title bar flash back on
     screen at every restart. It plays for its span and dissolves to the mark,
     which is a deliberate end state rather than an absence.

     Teardown is `about:blank` — HARD RULE 4 — never ''.
     ══════════════════════════════════════════════════════════════════════ */
  const TRAILER_LEAD_IN_MS = 900;
  /*
    THE FRAME LOADS WHILE IT IS STILL INVISIBLE.

    Reported: "ensure the youtube ui layer never appears on the video when it
    loads in". The chrome that was showing is the START of playback — the
    title bar, the spinner, the momentary poster — and it used to be revealed
    because the fade-in fired the instant src was assigned.

    So src is set first and the reveal waits. By the time the frame becomes
    visible the video is running and YouTube's title bar has auto-hidden
    (it retracts a couple of seconds in when nothing is hovering it, and
    nothing can be: pointer-events are off across the whole stage).

    This is mitigation, not a guarantee — see the note at the markup. A
    self-hosted file is the only way to be certain, and it takes priority
    whenever one exists.
  */
  /*
    HOW LONG TO WAIT FOR THE PLAYER TO SAY IT IS PLAYING BEFORE GIVING UP.

    Replaces a fixed 2400ms settle, which was solving the wrong problem. The
    chrome in the report was not the title bar flashing during load — it was
    the player PAUSED, showing its title, its "More videos" strip and the
    YouTube logo, because autoplay had been blocked (Brave does this by
    default, and so do several extensions and Low Power Mode on iOS).

    There is no delay that fixes that: nothing was ever going to start. So the
    frame is not revealed on a timer at all any more. It is revealed only when
    the player reports PLAYING, and if it never does the video is torn down and
    the brand mark simply stays up. A hub that cannot autoplay now looks
    deliberate instead of looking like a paused YouTube page.
  */
  const TRAILER_PLAY_TIMEOUT_MS = 7000;
  const TRAILER_RUN_MS = 42000;
  const stageTimers = new WeakMap<HTMLElement, number[]>();
  const stageListeners = new WeakMap<HTMLElement, (e: MessageEvent) => void>();

  function trailersAllowed(): boolean {
    if (typeof window === 'undefined' || !window.matchMedia) return false;
    /* Same cut as the CSS that hides .brand-stage-video. Kept in sync
       deliberately: loading a player the stylesheet has hidden is the
       expensive half of the mistake. */
    if (!window.matchMedia('(min-width: 1024px)').matches) return false;
    if (window.matchMedia('(max-height: 620px)').matches) return false;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return false;
    const conn = (navigator as unknown as { connection?: { saveData?: boolean } }).connection;
    if (conn && conn.saveData) return false;
    return true;
  }

  function clearStageTimers(stage: HTMLElement) {
    const timers = stageTimers.get(stage);
    if (timers) {
      timers.forEach((t) => {
        /* The list holds both timeouts and the state-poll interval. Ids come
           from the same pool, so clearing both is correct and cheap. */
        window.clearTimeout(t);
        window.clearInterval(t);
      });
    }
    stageTimers.set(stage, []);
    const listener = stageListeners.get(stage);
    if (listener) {
      window.removeEventListener('message', listener);
      stageListeners.delete(stage);
    }
  }

  function teardownStage(stage: HTMLElement) {
    clearStageTimers(stage);
    stage.classList.remove('is-playing');

    const media = stage.querySelector<HTMLVideoElement>('.brand-stage-media');
    if (media) {
      media.pause();
      /* Safe on a <video>, unlike an iframe: removeAttribute leaves no
         resolvable URL behind. Reloading releases the buffer. */
      if (media.hasAttribute('src')) {
        media.removeAttribute('src');
        media.load();
      }
      return;
    }

    const frame = stage.querySelector<HTMLIFrameElement>('.brand-stage-iframe');
    /* HARD RULE 4: 'about:blank', never ''. */
    if (frame && frame.src !== 'about:blank') frame.src = 'about:blank';
  }

  function armStage(stage: HTMLElement) {
    const media = stage.querySelector<HTMLVideoElement>('.brand-stage-media');
    const frame = stage.querySelector<HTMLIFrameElement>('.brand-stage-iframe');
    const el = media ?? frame;
    const src = el?.dataset.src;
    if (!el || !src) return;
    if (!media && frame && frame.src === src) return; // embed already running
    if (media && media.getAttribute('src') === src) return; // file already running
    clearStageTimers(stage);

    const timers: number[] = [];
    const reveal = () => {
      /* Stop pestering the player the moment it has answered. */
      timers.forEach((t) => window.clearInterval(t));
      stage.classList.add('is-playing');
      timers.push(window.setTimeout(() => teardownStage(stage), TRAILER_RUN_MS));
    };

    timers.push(window.setTimeout(() => {
      if (media) {
        /* A file tells us exactly when it has pictures to show, so there is
           nothing to guess at: reveal on the first painted frame. */
        media.setAttribute('src', src);
        media.addEventListener('playing', reveal, { once: true });
        media.play().catch(() => {
          /* Autoplay refused (rare when muted). Leave the mark up. */
        });
        return;
      }
      /*
        THE EMBED HAS TO PROVE IT IS PLAYING.

        With `enablejsapi=1` the player answers a `listening` postMessage with
        its state, so we can wait for PLAYING (info === 1) rather than guess.
        No API script needed — this is the same channel the script would use.
        `origin` is required for the handshake and can only be known at
        runtime, so it is appended here rather than baked into the markup.
      */
      const frameEl = frame!;
      frameEl.src = `${src}&origin=${encodeURIComponent(window.location.origin)}`;

      const onMessage = (event: MessageEvent) => {
        if (event.source !== frameEl.contentWindow) return;
        let data: { event?: string; info?: unknown } | null = null;
        try {
          data = typeof event.data === 'string' ? JSON.parse(event.data) : (event.data as never);
        } catch {
          return; // not ours
        }
        const info = data && (data as { info?: unknown }).info;
        const state = typeof info === 'object' && info !== null
          ? (info as { playerState?: number }).playerState
          : info;
        if (state === 1) {
          window.removeEventListener('message', onMessage);
          reveal();
        }
      };
      window.addEventListener('message', onMessage);
      stageListeners.set(stage, onMessage);

      /* The player only answers once it has booted, so keep asking. */
      const poll = window.setInterval(() => {
        frameEl.contentWindow?.postMessage('{"event":"listening"}', '*');
      }, 250);
      timers.push(poll);

      /*
        Never started. Blocked autoplay, a blocked domain, an embed the owner
        disabled. Take it down and leave the mark up — never show a paused
        player.
      */
      timers.push(window.setTimeout(() => {
        if (!stage.classList.contains('is-playing')) teardownStage(stage);
      }, TRAILER_PLAY_TIMEOUT_MS));
    }, TRAILER_LEAD_IN_MS));

    stageTimers.set(stage, timers);
  }

  function syncTrailers() {
    const allowed = trailersAllowed();
    document.querySelectorAll<HTMLElement>('.brand-stage').forEach((stage) => {
      const panel = stage.closest<HTMLElement>('.brand-info-panel');
      const section = stage.closest<HTMLElement>('.accordion-section');
      const live =
        allowed &&
        !!stage.dataset.trailer &&
        !!panel?.classList.contains('active') &&
        !!section?.classList.contains('expanded');
      if (live) armStage(stage);
      else teardownStage(stage);
    });
  }

  function initAccordionAndDecks() {
    const sections = document.querySelectorAll<HTMLElement>('.accordion-section');
    sections.forEach(section => {
      const header = section.querySelector<HTMLElement>('.accordion-header');
      if (!header) return;

      /*
        ─── WIRE EACH ROW EXACTLY ONCE ───────────────────────────────────────

        THIS FUNCTION RUNS TWICE ON EVERY FRESH LOAD. Once when the module
        executes, and again on `astro:page-load`, which ClientRouter fires on
        the INITIAL load as well as on client-side navigations (Layout.astro
        says so where it mounts the router).

        Each run built a fresh closure with its own `activeIndex` and its own
        `renderDeck`. Whether a listener was attached twice then depended on
        whether whoever added it remembered a per-element flag, and the five
        that existed — on the header, each card, each thumb, the section and
        the nav rail — hid the fact that the gesture block had none. So the
        deck ended up with TWO touchstart, TWO touchend and TWO wheel
        listeners, driving two independent indices, while tapping a card or a
        thumb updated only the first.

        Measured on the built page, on the reporter's exact sequence:

          fresh load                active = 0
          swipe forward             active = 1   ✓ both closures moved
          tap thumb 0               active = 0   ✓ only closure #1 moved
          swipe forward             active = 2   ✗ closure #2 went 1 → 2 last

        which is "swipe, tap, swipe, and you land on the third card". Once the
        two indices are far enough apart a forward swipe can land BEHIND where
        it started (measured: 0 → 3 on a four-card row), which is the
        "sometimes I cannot swipe through at all" half of the same report.
        Desktop had it identically through the wheel listener: click a thumb,
        then trackpad-swipe.

        One flag on the row replaces all five. It lives on the element, so a
        ClientRouter navigation that swaps in a fresh <section> wires it
        normally, and re-entering this function for a row already wired does
        nothing. Anything added inside this block from now on is covered
        without having to remember.

        `syncTrailers()` at the end of the function is deliberately OUTSIDE
        this guard: it is idempotent and does have to run on every call.
      */
      if (section.dataset.deckWired === '1') return;
      section.dataset.deckWired = '1';

      header.addEventListener('click', () => {
        if (section.classList.contains('expanded')) return;
        
        sections.forEach(s => {
          s.classList.remove('expanded');
          s.classList.add('collapsed');
        });
        
        section.classList.remove('collapsed');
        section.classList.add('expanded');
        for (const s of sections) {
          s.querySelector('.accordion-header')
            ?.setAttribute('aria-expanded', s === section ? 'true' : 'false');
        }

        syncTrailers();

      });

      const cards = Array.from(section.querySelectorAll<HTMLElement>('.deck-card'));
      const navThumbs = Array.from(section.querySelectorAll<HTMLElement>('.deck-nav-thumb'));
      const infoPanels = Array.from(section.querySelectorAll<HTMLElement>('.brand-info-panel'));
      const glowLayers = Array.from(section.querySelectorAll<HTMLElement>('.ambient-glow-layer'));
      
      let activeIndex = 0;
      cards.forEach((c, idx) => {
        if (c.classList.contains('active')) activeIndex = idx;
      });

      function renderDeck() {
        cards.forEach((card, i) => {
          card.className = 'deck-card';
          /* Class transforms only. An inline one would win over them and
             strand the card off-position — see the note on the click
             handlers below. */
          card.style.transform = '';
          infoPanels[i].className = 'brand-info-panel';
          
          if (navThumbs[i]) {
            navThumbs[i].className = 'deck-nav-thumb';
            /* The class is the look; aria-current is the announcement. Both
               have to move together or a screen reader keeps naming the hub
               that used to be showing. */
            navThumbs[i].setAttribute('aria-current', 'false');
          }
          if (glowLayers[i]) glowLayers[i].className = 'ambient-glow-layer';

          if (i === activeIndex) {
            card.classList.add('active');
            infoPanels[i].classList.add('active');
            if (navThumbs[i]) {
              navThumbs[i].classList.add('active');
              navThumbs[i].setAttribute('aria-current', 'true');
              const track = navThumbs[i].closest('.deck-nav-track');
              if (track) {
                const thumbLeft = navThumbs[i].offsetLeft;
                const thumbWidth = navThumbs[i].offsetWidth;
                const trackWidth = track.clientWidth;
                const targetScrollLeft = thumbLeft - (trackWidth / 2) + (thumbWidth / 2);
                track.scrollTo({ left: targetScrollLeft, behavior: 'smooth' });
              }
            }
            if (glowLayers[i]) glowLayers[i].classList.add('active');
            

            // Set dynamic left row color
            const brandRgb = card.getAttribute('data-brand-rgb');
            if (brandRgb) {
              section.style.setProperty('--category-accent-rgb', brandRgb);
            }
          } else {
            if (i === (activeIndex + 1) % cards.length) {
              card.classList.add('next-1');
            } else if (i === (activeIndex + 2) % cards.length) {
              card.classList.add('next-2');
            } else {
              card.classList.add('hidden');
            }
            
          }
        });
        syncTrailers();
      }

      // Swipe & Drag & Scroll Gestures
      const deckStack = section.querySelector('.deck-stack') as HTMLElement;
      if (deckStack) {
        // Shared swipe logic
        const handleSwipe = (diff: number) => {
          if (Math.abs(diff) > 50) {
            if (diff > 0) {
              activeIndex = (activeIndex + 1) % cards.length;
            } else {
              activeIndex = (activeIndex - 1 + cards.length) % cards.length;
            }
            renderDeck();
          }
        };

        // Touch events (mobile/tablet)
        let touchStartX = 0;
        deckStack.addEventListener('touchstart', (e: TouchEvent) => {
          touchStartX = e.changedTouches[0].screenX;
        }, { passive: true });
        deckStack.addEventListener('touchend', (e: TouchEvent) => {
          handleSwipe(touchStartX - e.changedTouches[0].screenX);
        }, { passive: true });

        /*
          ─── TRACKPAD SWIPE, ON THE LEADING EDGE ────────────────────────────

          A two-finger horizontal swipe advances the deck by one card. This is
          the second attempt; the first was removed for being unusable, and
          the difference is WHEN it fires.

          THE FIRST VERSION FIRED ON THE TRAILING EDGE. It debounced 40ms from
          the LAST wheel event, and macOS momentum keeps emitting wheel events
          for a second or more after your fingers lift. Every one re-armed the
          timer, so nothing moved until momentum fully decayed — then a 500ms
          cooldown was added on top. Measured at one to three seconds per
          swipe.

          This fires the moment horizontal intent is unambiguous — 40px of
          accumulated deltaX — and then LOCKS until the gesture goes quiet.
          Instant response, and exactly one card per physical swipe no matter
          how long the momentum tail runs.

          The lock is released by SILENCE, not by a timer. A fixed cooldown is
          a guess about how long momentum lasts, and it is wrong in both
          directions: too short and the tail advances a second card, too long
          and a deliberate second swipe is swallowed. 120ms of no wheel events
          means the trackpad has genuinely stopped, whether that took 200ms or
          two seconds. The next swipe then fires on its first 40px.

          THE TRADE-OFF, stated: one continuous un-lifted drag moves one card,
          not several. That is the same rule as "one swipe, one card" and it
          is why momentum can never over-advance.

          preventDefault() matters for a second reason beyond stopping the
          page scrolling: on macOS a horizontal trackpad swipe is also the
          browser's back/forward gesture, and without this, swiping the deck
          would navigate away from the page.

          NO POINTER DRAG. That is what broke clicking last time —
          setPointerCapture() retargets the subsequent `click` to the
          capturing element, so it never reached the per-card listener.
          Nothing here touches pointer events, so clicking a card to select it
          is unaffected. Wheel events cannot interfere with clicks.
        */
        if (cards.length > 1) {
          const SWIPE_DELTA = 40;     // px of horizontal intent before firing
          const QUIET_MS = 120;       // silence that means the gesture ended
          const TAIL_RATIO = 0.6;     // fallen this far below peak = coasting
          const REARM_FACTOR = 2.5;   // climbed this far back above the trough
          const REARM_FLOOR = 10;     // ...and is a real push, not tail jitter
          const MIN_FIRE_GAP = 220;   // ms; no physical swipe moves two cards

          let wheelDelta = 0;
          let locked = false;
          let peak = 0;
          let tailing = false;
          let trough = Infinity;
          let lastFire = -Infinity;
          let quietTimer: ReturnType<typeof setTimeout> | undefined;

          const release = () => {
            locked = false;
            wheelDelta = 0;
            peak = 0;
            tailing = false;
            trough = Infinity;
          };

          deckStack.addEventListener(
            'wheel',
            (e: WheelEvent) => {
              // Vertical intent belongs to the page, not the deck.
              if (Math.abs(e.deltaX) <= Math.abs(e.deltaY)) return;

              e.preventDefault();
              const abs = Math.abs(e.deltaX);

              // Backstop only. It cannot be the primary release — see below.
              clearTimeout(quietTimer);
              quietTimer = setTimeout(release, QUIET_MS);

              if (locked) {
                /*
                  ─── RELEASED BY INPUT, IN TWO STAGES ─────────────────────

                  Releasing on SILENCE alone was the first bug: macOS keeps
                  delivering momentum events for a second or two after your
                  fingers lift, and each one re-armed the quiet timer, so the
                  lock was held for the whole tail. Reported as "swipe, leave
                  the pointer on the deck, and you cannot swipe again" —
                  moving the pointer off and back fixed it, because that
                  simply stopped the events reaching this element.

                  Releasing on a RISING delta was the second bug, and the
                  reason is easy to miss: the deck fires PART-WAY THROUGH the
                  push, as soon as 40px has accumulated, while your fingers
                  are still accelerating. So the rest of that same push is
                  also rising, and it read as a brand new gesture and advanced
                  a second card. Measured: one swipe moved two cards.

                  Hence two stages. A momentum tail always PEAKS and then
                  decays, so:

                    stage 1  still at or near the peak — this is the rest of
                             the push that already fired. Never releases.
                    stage 2  fallen to 60% of peak — now genuinely coasting,
                             and from here a delta that CLIMBS BACK can only
                             mean fingers are on the trackpad again.

                  ─── AND THE THIRD BUG: "CLIMBS BACK" WAS +2px ────────────

                  Stage 2 used to release on any sample 2px above the previous
                  one, and this comment used to claim that releasing early was
                  cheap because "a decaying tail will not reach SWIPE_DELTA".
                  That was simply wrong. A tail still running at 25px/event
                  reaches 40px accumulated in two events, so an early release
                  fired a second card off the FIRST swipe's own momentum.

                  It is also not a rare race. macOS momentum is quantised and
                  noisy, and jitters up by more than 2px constantly. Modelled
                  against a realistic decaying tail with ±2px of noise, six of
                  eight swipes advanced two cards. Reported as "sometimes it
                  swipes through multiple carousels rather than one".

                  The fix is to compare against the TROUGH rather than the
                  previous sample. Momentum only decays, so its trough keeps
                  falling; a real push re-accelerates and clears the trough
                  many times over. Noise cannot, because it is measured against
                  the lowest point so far rather than the last point. The floor
                  stops a tail that has decayed to 1px from re-arming on a 3px
                  blip, which is 2.5x its trough and means nothing.

                  MIN_FIRE_GAP is the backstop that makes the guarantee
                  unconditional: no physical swipe can move two cards, whatever
                  the release logic decides. At 220ms it is far below a
                  deliberate second swipe (people cannot repeat one in under
                  ~250ms) and far above the few milliseconds in which momentum
                  would re-trigger, so it never costs a real gesture.
                */
                if (abs > peak) peak = abs;

                if (!tailing) {
                  if (abs < peak * TAIL_RATIO) {
                    tailing = true;
                    trough = abs;
                  }
                  return;
                }

                if (abs < trough) trough = abs;
                if (abs < REARM_FLOOR || abs < trough * REARM_FACTOR) return;
                release();
              }

              wheelDelta += e.deltaX;
              if (Math.abs(wheelDelta) < SWIPE_DELTA) return;

              /* The unconditional half of "one swipe, one card". */
              const now = e.timeStamp || performance.now();
              if (now - lastFire < MIN_FIRE_GAP) {
                wheelDelta = 0;
                return;
              }

              locked = true;
              peak = abs;
              tailing = false;
              trough = Infinity;
              lastFire = now;
              const forward = wheelDelta > 0;
              wheelDelta = 0;
              activeIndex = forward
                ? (activeIndex + 1) % cards.length
                : (activeIndex - 1 + cards.length) % cards.length;
              renderDeck();
            },
            { passive: false },
          );
        }
      }

      // Deck Stack Clicks & Parallax
      cards.forEach((card, i) => {
        card.addEventListener('click', (e) => {
          if (i !== activeIndex) {
            // A card behind the front one means "bring me forward".
            e.preventDefault();
            e.stopPropagation();
            activeIndex = i;
            renderDeck();
            return;
          }
          /*
            The FRONT card means "go in" — and it is now a real <a>, so
            that needs no code at all. Falling through to the browser's own
            navigation is what makes the tile work for keyboards, screen
            readers, middle-click and open-in-new-tab, none of which a
            `window.location` assignment supports.

            The separate "Enter" button in the trailer corner is gone with
            it: there is one target per hub now, and it is the artwork.
          */
        });

        /*
          NO PARALLAX TILT ON THE FRONT CARD.

          This used to write an INLINE transform on every mousemove, which
          caused three separate complaints about the big artwork not sitting
          still — and one of them was a genuine bug rather than a taste
          issue. `renderDeck()` re-assigns `card.className` but cannot clear
          an inline style, and inline beats any stylesheet rule. So a tilt
          left behind by the pointer survived the next selection and
          overrode the deck's own positioning: the card that should have
          settled at translateX(0) stayed wherever the last mousemove had
          put it. That is why selecting a brand appeared to move the image
          at random.

          The front card is the largest thing on the page and the thing the
          eye fixes on. It holds still.
        */
      });

      /*
        POINTER DRIFT.

        Reports where the pointer sits inside the open row as two numbers
        from -1 to 1, and lets CSS decide what moves and how far. Keeping the
        distances in the stylesheet means the feel can be tuned without
        touching this handler.

        Gated on the EVENT's pointer type rather than a `(hover: hover)`
        media query. The media query is the usual way to do this and it is
        the wrong one here: plenty of real desktop environments report
        `hover: none` (this project's own headless test browser does), which
        silently costs those visitors the effect. The event knows what it
        actually was. It also handles a touchscreen laptop properly — drift
        with the mouse, none from a finger — which one global media query
        cannot express.
      */
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (!reducedMotion) {

        const resetDrift = () => {
          section.style.setProperty('--drift-x', '0');
          section.style.setProperty('--drift-y', '0');
        };

        section.addEventListener('pointermove', (e: PointerEvent) => {
          // A tap fires one synthetic move; acting on it would shove the
          // artwork sideways and leave it parked there.
          if (e.pointerType === 'touch') return;
          if (!section.classList.contains('expanded')) return;
          const rect = section.getBoundingClientRect();
          if (!rect.width || !rect.height) return;
          const x = (e.clientX - rect.left) / rect.width - 0.5;
          const y = (e.clientY - rect.top) / rect.height - 0.5;
          section.style.setProperty('--drift-x', String(x * 2));
          section.style.setProperty('--drift-y', String(y * 2));
        });

        section.addEventListener('pointerleave', resetDrift);
      }

      /*
        THE RAIL ONLY FADES WHERE IT CONTINUES.

        Reports which sides actually have thumbnails scrolled out of view;
        the stylesheet turns that into the edge feather. Without it the fade
        is unconditional and the first and last hub in every row look dimmed
        even when the whole rail fits.

        `scrollWidth - clientWidth` can be a fraction of a pixel off on a
        fractional-DPI display, so the ends are tested with a small tolerance
        rather than an exact comparison — otherwise the rail never quite
        admits it has reached its end and keeps a feather on a crisp edge.
      */
      const navTrack = section.querySelector<HTMLElement>('.deck-nav-track');
      if (navTrack) {

        const syncNavFade = () => {
          const max = navTrack.scrollWidth - navTrack.clientWidth;
          const atStart = navTrack.scrollLeft <= 1;
          const atEnd = navTrack.scrollLeft >= max - 1;
          navTrack.dataset.overflowStart = max > 1 && !atStart ? '1' : '0';
          navTrack.dataset.overflowEnd = max > 1 && !atEnd ? '1' : '0';
        };

        syncNavFade();
        navTrack.addEventListener('scroll', syncNavFade, { passive: true });

        // The rail's width changes when the row opens or closes, which is a
        // layout change with no scroll and no resize behind it.
        const RO = (window as { ResizeObserver?: typeof ResizeObserver }).ResizeObserver;
        if (RO) new RO(syncNavFade).observe(navTrack);
        else window.addEventListener('resize', syncNavFade);
      }

      // Quick Nav Thumb Clicks
      navThumbs.forEach((thumb, i) => {
        thumb.addEventListener('click', (e) => {
          if (i !== activeIndex) {
            e.preventDefault();
            e.stopPropagation();
            activeIndex = i;
            renderDeck();
          }
        });
      });
    });

    /*
      ARM THE ROW THAT IS ALREADY OPEN.

      syncTrailers() ran only from renderDeck() and the header click — and
      neither fires on load. The first row is expanded in the markup, so its
      trailer was never armed until you clicked something: reported as the
      video failing to start on DC until you switched to Marvel and back, at
      which point it worked. It was never a playback problem; nothing had
      asked it to play.

      Called once here, after every section is wired, so the state on screen
      and the state the trailers are synced to are the same from the first
      frame. Idempotent — armStage() returns early on a stage already running.
    */
    syncTrailers();
  }

  /* TEMPORARY typography picker — remove with DEMO_FONTS. */
  function initFontPicker() {
    const root = document.querySelector<HTMLElement>('.featured-directory-page');
    if (!root || root.dataset.fontPickerInit === '1') return;
    root.dataset.fontPickerInit = '1';

    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('.font-picker-btn'));
    for (const button of buttons) {
      button.addEventListener('click', () => {
        root.dataset.titleFont = button.dataset.font ?? 'demo';
        for (const other of buttons) {
          other.setAttribute('aria-pressed', other === button ? 'true' : 'false');
        }
      });
    }

    /*
      A FACE THAT NEVER ARRIVED MUST SAY SO.

      Every candidate except the shipping one comes from fonts.googleapis.com.
      When that request does not complete — offline, a blocked host, a proxy,
      a content blocker — the CSS is still perfectly valid and every heading
      quietly renders in the fallback stack. The picker then looks broken in a
      way that is indistinguishable from the cascade bug this file already had
      once, which is how an afternoon gets spent on the wrong thing.

      So: once the document's fonts have settled, ask which families the
      browser can actually render and strike through the buttons for the ones
      it cannot. One console line names them together. Dev only — the picker
      itself is not emitted in a build.
    */
    /*
      MEASURED, NOT ASKED. `document.fonts.check()` is the obvious API and it
      is useless here: it answers "can the browser render this text", and a
      family it has never heard of falls back to a system face and answers
      YES. Tested against a deliberately broken stylesheet, it reported all
      seventeen present.

      So compare metrics instead. Set the same string in `'Anton', monospace`
      and in plain `monospace`: if Anton arrived the widths differ, and if it
      did not, both measurements ARE monospace and match to the pixel. Two
      reference stacks, because one face agreeing with one fallback by
      coincidence is possible and agreeing with both is not.
    */
    const probe = document.createElement('canvas').getContext('2d');
    const SAMPLE = 'WHAT WE COVER 0123';
    const REFERENCES = ['monospace', 'serif'];
    const hasFace = (family: string, weight: string) => {
      if (!probe) return true; // no canvas, no opinion — do not cry wolf
      return REFERENCES.some((reference) => {
        probe.font = `${weight} 40px ${reference}`;
        const base = probe.measureText(SAMPLE).width;
        probe.font = `${weight} 40px '${family}', ${reference}`;
        return probe.measureText(SAMPLE).width !== base;
      });
    };

    document.fonts.ready.then(() => {
      const missing: string[] = [];
      for (const button of buttons) {
        const family = button.dataset.family;
        if (!family) continue; // "Demo per row" has no single family
        if (hasFace(family, button.dataset.weight ?? '400')) continue;
        missing.push(family);
        button.dataset.fontMissing = '1';
        button.title = `${family} did not load. This button previews the fallback face, not that one.`;
      }
      if (missing.length) {
        console.warn(
          `[featured] ${missing.length} preview typeface(s) did not load and will ` +
            `render in the fallback stack: ${missing.join(', ')}. ` +
            `They are fetched from fonts.googleapis.com, so this is a network or ` +
            `content-blocker problem, not a CSS one. The shipping face is ` +
            `self-hosted and is unaffected.`,
        );
      }
    });
  }

  /*
    ─── OPENING THE ACCORDION FROM A URL ─────────────────────────────────────

    The markup expands `index === 0` and nothing else, so /featured#streaming
    arrived with Streamers collapsed and the reader looking at Franchises. The
    Feed links straight into these sections, so the hash has to mean something.

    ─── THE HASH IS THE CATEGORY KEY, NOT ITS LABEL ─────────────────────────
    Sections carry `data-category` values of `universes`, `streaming`,
    `studios` and `gaming`, while the headings above them read "Franchises",
    "Streamers", "Studios" and "Games". `universes`/"Franchises" is the pair
    that catches people out, so the visible word is accepted as an alias rather
    than quietly matching nothing.

    Collapsing the others first keeps this identical to a click: the accordion
    shows one section at a time, and an opened-by-URL section that left the
    default one open would be a state no click can produce.
  */
  const HASH_TO_CATEGORY: Record<string, string> = {
    franchises: 'universes',
    streamers: 'streaming',
    games: 'gaming',
  };

  function openSectionFromHash() {
    const hash = window.location.hash.replace('#', '').toLowerCase();
    if (!hash) return;

    const category = HASH_TO_CATEGORY[hash] ?? hash;
    const target = document.querySelector<HTMLElement>(
      `.accordion-section[data-category="${CSS.escape(category)}"]`,
    );
    if (!target) return;

    document.querySelectorAll<HTMLElement>('.accordion-section').forEach((section) => {
      const isTarget = section === target;
      section.classList.toggle('expanded', isTarget);
      section.classList.toggle('collapsed', !isTarget);
      section
        .querySelector('.accordion-header')
        ?.setAttribute('aria-expanded', String(isTarget));
    });

    /* The stage owns at most one player; the section that just opened is not
       the one it was loaded for. */
    syncTrailers();

    /* After the expand transition has somewhere to scroll to. `start` is right
       here, unlike the feed's rows: an accordion section IS the heading. */
    const behavior = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';
    setTimeout(() => target.scrollIntoView({ behavior, block: 'start' }), 100);
  }

  /*
    `astro:page-load` covers ARRIVING at a hash — the Feed's "Explore Streamers"
    link, a pasted URL, a bookmark. It does not cover changing the hash while
    already here: ClientRouter treats /featured#streaming -> /featured#universes
    as an in-page anchor jump, not a navigation, so nothing re-runs and the
    previously opened section stays open under the new URL. Reached by Back and
    Forward as much as by clicking.

    Bound once and re-bound defensively: the handler lives on `window`, which
    ClientRouter does not replace between navigations.
  */
  const HASH_LISTENER_KEY = '__hqFeaturedHashListener';
  const previousHashListener = (window as any)[HASH_LISTENER_KEY];
  if (previousHashListener) window.removeEventListener('hashchange', previousHashListener);
  (window as any)[HASH_LISTENER_KEY] = openSectionFromHash;
  window.addEventListener('hashchange', openSectionFromHash);

  initAccordionAndDecks();
  initFontPicker();
  openSectionFromHash();
  document.addEventListener('astro:page-load', () => {
    initAccordionAndDecks();
    initFontPicker();
    openSectionFromHash();
  });
</script>

<style>

  /* ─── CINEMATIC OVERLAYS ─── */
  .film-grain {
    position: fixed;
    inset: 0;
    z-index: 9999;
    pointer-events: none;
    background-image: url('data:image/svg+xml;base64,');
    opacity: 0.05;
    mix-blend-mode: overlay;
  }
  .lens-vignette {
    position: fixed;
    inset: 0;
    z-index: 9998;
    pointer-events: none;
    background: radial-gradient(circle at center, transparent 30%, rgba(0,0,0,0.85) 100%);
  }

  

  /*
    HARD RULE 3: no `overflow: hidden` on any ancestor of a YouTube iframe —
    iOS Safari composites the cross-origin iframe as a black box. The right
    column's trailer iframe sits inside this element and inside
    `.accordion-section`, so BOTH lost their clip. The clipping they were
    doing is real, but it belongs to the deck side, so it moved down onto
    `.deck-column` (below), which contains no iframe. Same isolate-the-clip
    pattern as `.event-hero-bg-wrapper` on the [slug] pages.

    HEIGHT: `lvh`, not `vh`. On iOS `100vh` is the LARGEST viewport but is
    also what the page uses before the URL bar retracts, and mixing it with a
    fixed-height flex accordion leaves the last row cut off behind the bar.
    `lvh` is the unit scripts/viewport-units.test.mjs pins for exactly this.
  */
  .featured-directory-page {
    width: 100%;
    padding-top: var(--header-height, 80px);
    height: 100lvh;
    min-height: 750px;
    background: #000;
  }

  .accordion-container {
    display: flex;
    flex-direction: column;
    /*
      SIZED FROM THE VIEWPORT DIRECTLY, NOT AS A PERCENTAGE OF ITS PARENT.

      The rows below size themselves as a share of this container (see
      .accordion-section), so this height has to be right from the very first
      layout — a percentage only resolves once the parent's own height is
      known, and until then the container is auto-height and the shares are
      meaningless.

      `100lvh` matches .featured-directory-page and is what this project pins
      viewport heights to (scripts/viewport-units.test.mjs); the padding it
      subtracts is that element's own, which is what `height: 100%` used to
      resolve against.
    */
    height: calc(100lvh - var(--header-height, 80px));
    min-height: calc(750px - var(--header-height, 80px));
    width: 100%;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .accordion-section {
    /*
      EACH ROW'S HEIGHT IS ITS OWN SHARE OF THE CONTAINER, NOT WHATEVER IS LEFT
      OVER AFTER ITS SIBLINGS.

      This is the 0.276 layout shift that failed the Lighthouse gate — the worst
      metric on the site — and it is nothing to do with fonts, images or
      scripts. It is the markup streaming.

      /featured is 42kB of HTML. On a throttled connection the parser lays out
      the first row before the rest of the document has arrived, and with
      `flex: 1` / `flex: 8` a row's size depends on how many siblings it is
      sharing with. Sampled every frame: at 200ms the container held ONE row
      at 742px; by 338ms it held four at 536/69/69/69. Every row that arrived
      resized every row already painted, and each of those resizes is a layout
      shift.

      Sizing by flex-BASIS against the container instead makes each row's
      height depend only on the container, which is a definite viewport-derived
      value from the first layout. A row is then the same height whether it is
      alone in the DOM or the last of four, so the rest of the document
      arriving cannot move it.

      `--rows` comes from the template because the category count is data —
      a category with no hubs in it does not render. One expanded row at 8
      shares with (rows - 1) collapsed at 1, hence the `rows + 7` denominator.
    */
    flex: 0 0 calc(100% / (var(--rows, 4) + 7));
    /*
      A flex item's automatic minimum size is its content, and a COLLAPSED row
      still lays out its whole body — `visibility: hidden` hides but reserves.
      Without this the fixed basis above could be overridden by whatever
      happens to be inside a row.
    */
    min-height: 0;
    position: relative;
    /* No overflow clip here — hard rule 3, see .featured-directory-page.
       The collapse still hides its body: .accordion-body toggles both
       opacity and visibility, which is what actually removes it. */
    /*
      THE ROWS SNAP. THEY DO NOT ANIMATE.

      This was `transition: flex-basis 0.7s`, and flex-basis is a LAYOUT
      property — every frame of those 700ms forced a full layout and repaint of
      the accordion, underneath a full-bleed blur, which is a repaint of an
      expensive surface on geometry that will not hold still. Profiled at
      412x823 with a 4x CPU throttle, opening a row ran p95 50ms with frames as
      long as 87ms against a 16.7ms budget. Two independent review passes named
      this animation as the bottleneck.

      There is no cheap way to animate it. A height or flex animation is layout
      by definition, and faking it with `transform: scaleY` would squash the
      artwork rather than reveal it.

      So the geometry is instant and the CHOREOGRAPHY carries the motion — the
      artwork, the rail, the mark and the chip still arrive on their staged
      delays (see the staging block below), and those are opacity and transform
      only, which the compositor handles without touching layout. The row
      changing size in one frame is not something the eye tracks; the content
      arriving on a beat afterwards is.
    */
    display: flex;
    flex-direction: column;
    border-bottom: 2px solid rgba(255, 255, 255, 0.15);
    background: #050505;
  }

  .accordion-section.expanded {
    flex: 0 0 calc(800% / (var(--rows, 4) + 7));
  }

  .accordion-header-bg {
    position: absolute;
    inset: 0;
    z-index: 1;
    opacity: 0.6;
    background: linear-gradient(to right, rgba(var(--category-accent-rgb, 100, 0, 0), 0.75) 0%, rgba(0, 0, 0, 0.95) 60%);
    transition: opacity 0.4s ease, background 0.4s ease;
  }
  
  .accordion-section.collapsed:hover .accordion-header-bg {
    opacity: 1;
    background: linear-gradient(to right, rgba(var(--category-accent-rgb, 153, 0, 0), 0.95) 0%, rgba(0, 0, 0, 0.95) 60%);
  }
  
  .accordion-section.expanded .accordion-header-bg {
    opacity: 0;
    pointer-events: none;
  }


  .accordion-heading {
    position: absolute;
    inset: 0;
    z-index: 10;
    margin: 0;
    font: inherit;
  }

  .accordion-section.expanded .accordion-heading {
    position: relative;
    inset: auto;
  }

  /* Reset first: a <button> brings its own font, colour, border and background,
     and none of them belong on a full-bleed row. */
  .accordion-header {
    appearance: none;
    -webkit-appearance: none;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    height: 100%;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    padding: 0 5vw;
    cursor: pointer;
  }

  /* The focus ring the old <div> could never show. Inset so it reads as the
     row being selected rather than a box drawn around it. */
  .accordion-header:focus-visible {
    outline: 2px solid var(--color-accent-text, #ef4444);
    outline-offset: -6px;
  }

  .accordion-section.expanded .accordion-header {
    height: auto;
    padding: 1.5rem 5vw 1rem 5vw;
    background: transparent;
    cursor: default;
  }

  /* Sized in `em` so it follows the label instead of dwarfing it — at the
     old fixed clamp it was now larger than the title it annotates. */
  .accordion-title-demo-label {
    font-size: 0.7em;
    opacity: 0.45;
    font-family: monospace;
    letter-spacing: normal;
    margin-left: 1.2rem;
    vertical-align: middle;
  }

  /* The per-row labels only make sense while all four are on screen. */
  .featured-directory-page:not([data-title-font='demo']) .accordion-title-demo-label {
    display: none;
  }

  .font-picker {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 400;
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.55rem;
    background: rgba(8, 8, 8, 0.82);
    border: 1px dashed rgba(255, 255, 255, 0.22);
    backdrop-filter: blur(8px);
  }

  .font-picker-label {
    font-family: var(--font-body);
    font-size: 0.6rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-white-muted);
    margin-right: 0.25rem;
  }

  .font-picker-btn {
    padding: 0.3rem 0.6rem;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: transparent;
    color: var(--color-white-muted);
    font-family: var(--font-body);
    font-size: 0.7rem;
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease, background-color 0.2s ease;
  }

  .font-picker-btn:hover {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.45);
  }

  .font-picker-btn[aria-pressed='true'] {
    color: #fff;
    border-color: var(--color-accent-text);
    background: rgba(204, 0, 0, 0.2);
  }

  /* Set by initFontPicker() when document.fonts says the family never
     arrived. Pressing it still works, it just previews the fallback. */
  .font-picker-btn[data-font-missing='1'] {
    text-decoration: line-through;
    opacity: 0.45;
  }

  /*
    SECTION LABEL, not a headline.

    This was clamp(3rem, 7vw, 7rem) — around 90px, a word so large it filled
    the bar and made every closed row shout at the same volume as the open
    one. Dropped to roughly a fifth of that so it sits as a small plate in
    the middle of its row.

    The horizontal start is unchanged: `.accordion-header` still centres its
    contents vertically and pads 5vw from the left, so the label keeps its
    original left edge and simply shrinks in place.

    Wide tracking is doing the work that size used to. At this scale a
    tightly-set word reads as small; spaced out it reads as deliberate,
    which is how a title plate or a chapter marker is set.
  */
  .accordion-title {
    display: block;
    /* Set by the typeface picker (see fontCss above). The fallback is the
       stack this rule shipped before the picker existed, so a face that
       never arrives leaves the row exactly as it was. */
    font-family: var(
      --accordion-title-face,
      'Helvetica Neue',
      Helvetica,
      -apple-system,
      BlinkMacSystemFont,
      Arial,
      sans-serif
    );
    /*
      THE OPEN ROW IS THE LOUDEST, NOT THE QUIETEST.

      This was one size for every row, which put the tiny tracked-out label of
      the row you are IN next to three large ones for rows you are not — the
      active state read as a subtitle and the inactive ones as headlines. A
      design review named it as the single thing that most made the page look
      like a mistake rather than a decision.

      Both ends stay restrained (the labels were deliberately brought down from
      banner size and are not going back). The hierarchy is restored by taking
      the closed rows DOWN and their contrast with them, so "you are here" is
      established without anything shouting.
    */
    font-size: clamp(0.8rem, 1.15vw, 1.05rem);
    text-transform: uppercase;
    font-weight: var(--accordion-title-weight, 700);
    letter-spacing: calc(0.34em + var(--accordion-title-tracking, 0em));
    color: rgba(255, 255, 255, 0.5);
    margin: 0;
    z-index: 2;
    transition: all 0.6s cubic-bezier(0.25, 1, 0.5, 1);
    /*
      Without a line-height these headings inherit `normal`, which browsers
      compute from the ACTIVE FONT'S own ascent and descent — so the line box
      changes size if the face ever changes underneath it. A unitless value is
      a multiple of font-size and nothing else, which keeps the box identical
      whichever face is active. Belt and braces alongside the self-hosted
      `font-display: optional` face above.
    */
    line-height: 1.25;
  }
  
  .accordion-section.collapsed:hover .accordion-title {
    color: #fff;
    /* 10px was a small nudge beside 90px type and is a lurch beside 19px. */
    transform: translateX(5px);
    letter-spacing: calc(0.34em + var(--accordion-title-tracking, 0em));
  }

  /*
    THE OPEN ROW IS THE LOUDEST, NOT THE QUIETEST.

    This rule used to step the open row's title DOWN — smaller, dimmer and
    lighter than the closed rows above and below it. The reasoning was sound in
    isolation (the artwork should be the subject, not the label) but it made
    the page read as broken: the row you are IN was set as a caption while
    three rows you are not in were headlines. A design review named the
    inversion as the single thing that most made the page look like a mistake
    rather than a decision.

    The fix is not to go back to banner-sized labels — those were deliberately
    brought down and are staying down. It is that the CLOSED rows come down
    further (see .accordion-title), so the open one leads without shouting. It
    also takes the category's own colour as a rule down its left edge, which is
    the same plate the hub pages now open with.
  */
  .accordion-section.expanded .accordion-title {
    font-size: clamp(0.95rem, 1.5vw, 1.35rem);
    font-weight: var(--accordion-title-weight, 600);
    color: rgba(255, 255, 255, 0.94);
    letter-spacing: calc(0.3em + var(--accordion-title-tracking, 0em));
    transform: none;
    padding-left: 0.9rem;
    border-left: 2px solid rgba(var(--category-accent-rgb, 204, 0, 0), 0.9);
  }

  .accordion-header:focus-visible .accordion-title {
    color: rgba(255, 255, 255, 0.9);
  }

  /*
    A CLOSED ROW IS NOT DRAWN AT ALL.

    `visibility: hidden` hides a subtree but still lays it out and keeps it in
    the paint order — so three closed rows were each carrying a full deck, a
    backlight and a six-still gallery through every layout the open row caused.
    `content-visibility: hidden` skips their contents outright, and because the
    rows are sized by flex-basis rather than by their contents, skipping them
    cannot change any geometry.

    Applied to the BODY, not the section: the header stays rendered, so the
    closed rows are still visible, still hoverable and still focusable.
  */
  .accordion-section.collapsed .accordion-body {
    content-visibility: hidden;
  }

  .accordion-body {
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.5s ease;
    flex-grow: 1;
    height: 100%;
    width: 100%;
    position: relative;
  }
  .accordion-section.expanded .accordion-body {
    opacity: 1;
    visibility: visible;
    transition-delay: 0.3s;
  }

  .deck-view-container {
    display: flex;
    width: 100%;
    height: 100%;
    padding: 0 0 0 5vw; /* Full bleed on right and bottom */
  }

  .deck-column {
    flex: 0 0 50%;
    max-width: 50%;
    position: relative;
    height: 100%;
    z-index: 20;
    display: flex;
    flex-direction: column;
    /*
      NO `overflow: hidden` HERE.

      The clip that came off .accordion-section (hard rule 3) was parked on
      this column, and it landed exactly on the 50% seam — a dead straight
      vertical cut through the deck, which is the hard edge between the two
      halves. Containment is done with a mask on `.deck-stack` instead: it
      fades the cards to zero alpha BEFORE the column boundary, so nothing
      escapes into the right half and nothing is sliced to do it.
    */
  }

  /* AMBIENT GLOW */
  .ambient-glow-container {
    position: absolute;
    /*
      Bleed sideways and up, but NOT down.

      This was `inset: -20%` on all four sides. `.accordion-section` used to
      clip that overhang away, but that clip had to go (hard rule 3), and the
      bottom 20% — measured at 83px — then painted a blurred wash straight
      over the footer whenever the LAST row was the expanded one.

      Sideways and upward bleed stay: both land inside the section, which is
      where the ambient backlight is supposed to spread. Only the bottom is
      pinned to the column, because below it is somebody else's content.
    */
    inset: -20% -20% 0 -20%;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }
  .ambient-glow-layer {
    position: absolute;
    inset: -10%;
    background-size: cover;
    background-position: center;
    -webkit-filter: blur(120px) saturate(1.5);
    filter: blur(120px) saturate(1.5);
    -webkit-mask-image: radial-gradient(circle at center, rgba(0,0,0,1) 0%, rgba(0,0,0,0) 65%);
    mask-image: radial-gradient(circle at center, rgba(0,0,0,1) 0%, rgba(0,0,0,0) 65%);
    opacity: 0;
    transition: opacity 1.5s ease;
  }
  .ambient-glow-layer.active {
    opacity: 0.4; 
  }

  .deck-stack {
    position: relative;
    width: 100%;
    flex: 1;
    min-height: 0; 
    z-index: 2;
    /*
      Feather the deck out into the right column.

      Multi-stop, not the two-stop linear ramp this used to be. A linear alpha
      ramp is what the eye reads as a visible band (Mach banding): the
      derivative is constant, so the ramp's two ENDS are discontinuities and
      both show up as faint lines. These stops approximate a smoothstep, so
      the fade has no detectable start or finish.

      `mask-repeat: no-repeat` is load-bearing. mask-repeat defaults to
      `repeat`, which TILES the gradient outside the element's box — a card
      translated past the stack edge would pass under a fresh copy of the
      ramp and pop back into view. With no-repeat, everything past the box is
      masked out, and because the ramp has already reached zero alpha there,
      that cutoff is invisible.

      THE RAMP STOPS BEFORE THE CARD. It used to reach full opacity only at
      62% from the right edge — but the front card is 85% wide, so its right
      third sat inside the fade, and the "Enter" chip (which lands ~20-41%
      from that edge) was being drawn at roughly a fifth of its opacity.
      Reported as the vignette obscuring it, and it was: the feather was
      eating the card's own call to action.

      Full opacity by 18% now, which clears the chip, and the ramp still
      reaches zero exactly at the box edge so the no-repeat cutoff stays
      invisible. The cards stacked behind translate past that edge and
      dissolve into it, which is all this was ever for.
    */
    -webkit-mask-image: linear-gradient(to left,
      rgba(0,0,0,0) 0%, rgba(0,0,0,0.06) 3%, rgba(0,0,0,0.22) 6%,
      rgba(0,0,0,0.48) 9%, rgba(0,0,0,0.74) 12%, rgba(0,0,0,0.92) 15%,
      rgba(0,0,0,1) 18%);
    mask-image: linear-gradient(to left,
      rgba(0,0,0,0) 0%, rgba(0,0,0,0.06) 3%, rgba(0,0,0,0.22) 6%,
      rgba(0,0,0,0.48) 9%, rgba(0,0,0,0.74) 12%, rgba(0,0,0,0.92) 15%,
      rgba(0,0,0,1) 18%);
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
  }

  .deck-card {
    position: absolute;
    top: 50%;
    left: 0;
    /*
      ─── IT STOPS GROWING WITH THE SCREEN ─────────────────────────────────

      This was a flat `85%` of the stack, so on a 4K display the card reached
      2101x1182 and the page became one enormous poster with a row of
      thumbnails under it that had not grown at all. Reported as the image
      being too massive and the tiles far too small beside it.

      `min()` against a viewport width keeps the 85% on ordinary screens, where
      it is the smaller of the two, and caps the card past about 2100px wide.
      The filmstrip below is sized from the SAME `vw` basis, which is what
      holds the two at a fixed ratio to each other instead of letting one
      outrun the other.
    */
    width: min(85%, 48vw);
    aspect-ratio: 16 / 9;
    transform-origin: center center;
    /*
      DEAD, and left exactly as it was. Computed style on the active card at
      3840x2160 reports `position: relative; top: 0; margin-top: 0` — a later
      rule in this file re-lays the deck out and this declaration has not
      applied in a long time. Replacing it with a `translate` that DID apply
      moved the card 566px up the page. If the layout above ever comes back,
      note that -24% is half the card's height as a share of the STACK's width,
      so it is only correct while the width above is exactly 85%.
    */
    margin-top: -24%; /* Half of 16/9 height to vertically center perfectly */
    border-radius: 0; 
    overflow: hidden;
    background: #000;
    box-shadow: 0 30px 60px rgba(0,0,0,0.9);
    transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1), 
                opacity 0.6s cubic-bezier(0.2, 0.8, 0.2, 1),
                z-index 0s;
    background: #111;
    cursor: pointer;
    /*
      No hairline border. "All large elements should feather and blend" — a
      1px light rule is the single most literal way to draw a box's outline,
      and it was doing that against a panel with no hard edges left on it. The
      soft ambient shadow below carries the separation instead.
    */
    border: none;
  }

  .deck-card.active {
    z-index: 10;
    transform: translateX(0) scale(1);
    opacity: 1;
  }
  
  .deck-card.next-1 {
    z-index: 9;
    transform: translateX(25%) scale(0.9);
    opacity: 0.8;
  }
  
  .deck-card.next-2 {
    z-index: 8;
    transform: translateX(45%) scale(0.8);
    opacity: 0.5;
  }
  
  .deck-card.hidden {
    z-index: 1;
    transform: translateX(65%) scale(0.7);
    opacity: 0;
    pointer-events: none;
  }

  .peeking-spine {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: 60px;
    background: linear-gradient(90deg, transparent 0%, rgba(0,0,0,0.9) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 1;
    transition: opacity 0.5s ease;
    z-index: 5;
    pointer-events: none;
  }
  .deck-card.active .peeking-spine {
    opacity: 0; 
  }
  .spine-text {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-family: 'Helvetica Neue', Helvetica, sans-serif;
    font-weight: 800;
    color: #fff;
    font-size: 1.5rem;
    letter-spacing: 0.1em;
    white-space: nowrap;
    text-transform: uppercase;
    opacity: 0.7;
  }

  .deck-card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  /* Cards BEHIND the front one still lift slightly on hover — that is the
     affordance saying "click me to bring this forward". */
  .deck-card:hover .deck-card-image {
    transform: scale(1.05);
  }

  /* The front card does not. It is the subject of the composition, and a
     1.02 nudge on a 720px image is a visible drift for no information. */
  .deck-card.active:hover .deck-card-image {
    transform: none;
  }

  /*
     ─── AND THE PEEKING CARDS WAKE UP ──────────────────────────────────────
     The cards behind the front one sit at 0.8 and 0.5 opacity so the front
     one reads as the subject. That also makes them look inert, and with the
     trackpad gesture removed, clicking them IS the desktop interaction — so
     they have to say so. Reported as wanting to click the sliver of "Harry
     Potter" showing behind the front card.

     Opacity only, and only on hover. Moving them would fight `renderDeck()`,
     which owns their transform; the image scale above already supplies the
     motion. */
  .deck-card.next-1:hover,
  .deck-card.next-2:hover {
    opacity: 1;
    transition: opacity 0.25s ease;
  }

  .deck-card-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.4);
    transition: opacity 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none; 
  }
  .deck-card.active .deck-card-overlay {
    background: linear-gradient(to top, rgba(0,0,0,0.8) 0%, transparent 50%);
    opacity: 0;
    pointer-events: auto; 
  }
  .deck-card.active:hover .deck-card-overlay {
    opacity: 1;
  }

  .click-to-enter-pill {
    display: inline-block;
    background: var(--color-accent);
    color: #fff;
    padding: 1rem 2.5rem;
    font-weight: 900;
    border-radius: 0;
    letter-spacing: 0.1em;
    transform: translateY(20px);
    opacity: 0;
    transition: all 0.3s ease;
    text-transform: uppercase;
    text-decoration: none;
  }
  .click-to-enter-pill:hover {
    background: #fff;
    color: #000;
  }
  .deck-card.active:hover .click-to-enter-pill {
    transform: translateY(0);
    opacity: 1;
  }

  /* QUICK NAV TRACK */
  .deck-nav-track {
    width: 100%;
    box-sizing: border-box;
    /* OVERRIDDEN. A later `.deck-nav-track` rule in this file sets the height
       unconditionally, so this value never applies — see the note there. */
    height: 90px;
    margin-top: 1rem;
    display: flex;
    gap: 12px;
    align-items: center;
    overflow-x: auto;
    /*
      CENTRED, BUT ONLY WHILE IT FITS.

      The rail defaulted to flex-start, so a category with two or three hubs
      left its thumbnails jammed against the far left of a wide screen with the
      poster centred above them — the rail read as belonging to nothing.

      `safe center` is the whole trick. Plain `center` on a scrolling flex row
      is a known trap: once the contents overflow, the overflowing items are
      pushed past the container's START edge, and that direction is
      unscrollable, so the first thumbnails become permanently unreachable.
      `safe` falls back to flex-start at exactly the moment overflow begins,
      which is also the moment centring stops mattering.

      Declared twice on purpose. A browser without `safe` support drops the
      second declaration and keeps plain `center`, which is the right
      degradation: the rows that overflow are the ones with many hubs, and
      those are the rows this site does not have yet.
    */
    justify-content: center;
    justify-content: safe center;
    padding: 10px 5%; 
    z-index: 2; /* above glow */

    /* The scrollbar is browser chrome sitting across the bottom of a piece of
       set dressing. The rail says what it is by the way it fades. */
    scrollbar-width: none;
    -ms-overflow-style: none;

    /*
      FEATHERED EDGES, BUT ONLY WHERE THERE IS SOMETHING TO FEATHER.

      This was a fixed `transparent 0%, black 10%, black 90%, transparent`.
      The ramp is a share of the RAIL, not of what has scrolled out of it, so
      it dimmed the first and last thumbnail permanently — including when the
      rail was not scrolled at all and there was nothing beyond either edge to
      suggest. Five hubs in a row and two of them looked disabled.

      The ramps are variables at zero by default, and the script raises the
      one on whichever side actually has content off-screen. Scrolled to the
      start, the left edge is crisp and the right one fades; in the middle,
      both; with everything visible, neither.
    */
    --nav-fade-start: 0%;
    --nav-fade-end: 0%;
    -webkit-mask-image: linear-gradient(to right,
      transparent 0%, black var(--nav-fade-start),
      black calc(100% - var(--nav-fade-end)), transparent 100%);
    mask-image: linear-gradient(to right,
      transparent 0%, black var(--nav-fade-start),
      black calc(100% - var(--nav-fade-end)), transparent 100%);
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
  }

  .deck-nav-track::-webkit-scrollbar {
    display: none;
  }

  .deck-nav-track[data-overflow-start='1'] {
    --nav-fade-start: 9%;
  }

  .deck-nav-track[data-overflow-end='1'] {
    --nav-fade-end: 9%;
  }
  
  .deck-nav-track::-webkit-scrollbar {
    height: 4px;
  }
  .deck-nav-track::-webkit-scrollbar-track {
    background: rgba(255,255,255,0.05);
  }
  .deck-nav-track::-webkit-scrollbar-thumb {
    background: rgba(255,255,255,0.2);
  }

  /*
    A <button>, NOT A DIV — AND THE RESETS THAT COSTS.

    These were <div>s carrying a click handler, so the rail could not be
    reached with Tab at all: focus went from the row heading straight past
    the whole rail. A <div> is a plain box; browsers only put genuinely
    interactive elements in the tab order, and one that merely BEHAVES like a
    button when clicked is not one.

    It was never a dead end — the deck cards themselves are real <a>s, so
    every hub stayed reachable — but the rail is the fast way to switch and
    a keyboard user simply did not have it. WCAG 2.1.1.

    A <button> is focusable for free, fires on Enter and Space with no extra
    code, and announces its state. The price is the four resets below: user
    agents give buttons their own font, colour, alignment and radius, and
    without these the rail rendered with system-font labels and rounded
    corners. `background` and `border` were already declared, which is why
    only these four are needed.
  */
  .deck-nav-thumb {
    width: 120px;
    height: 60px;
    flex-shrink: 0;
    background: #111;
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 0;
    padding: 0;
    font: inherit;
    color: inherit;
    text-align: inherit;
    opacity: 0.4;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
    position: relative;
    overflow: visible; /* so tooltip can escape */
  }

  /*
    Being focusable is no use if you cannot see where you are. Uses
    `--color-accent-text`, not `--color-accent`: this ring has to be legible
    against the rail's near-black, and the deep red is 3.21:1 (see CLAUDE.md).
  */
  .deck-nav-thumb:focus-visible {
    outline: 2px solid var(--color-accent-text, #ef4444);
    outline-offset: 3px;
    opacity: 1;
    z-index: 3;
  }

  /* The tooltip is the accessible name's visual twin; a keyboard user
     reaching a thumb should see the same label a mouse user gets on hover. */
  .deck-nav-thumb:focus-visible .custom-tooltip {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }
  
  .deck-nav-thumb:hover {
    opacity: 0.8;
    transform: translateY(-2px);
  }
  
  .deck-nav-thumb.active {
    opacity: 1;
    border-color: var(--color-accent);
    transform: scale(1.05);
    box-shadow: 0 5px 15px rgba(204,0,0,0.4);
  }

  .nav-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .nav-thumb-fallback {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    color: #fff;
    text-transform: uppercase;
    font-weight: bold;
    padding: 0.5rem;
    text-align: center;
  }

  /* TOOLTIP */
  .custom-tooltip {
    position: absolute;
    bottom: calc(100% + 10px);
    left: 50%;
    transform: translateX(-50%) translateY(10px);
    background: rgba(0,0,0,0.9);
    border: 1px solid rgba(255,255,255,0.15);
    padding: 0.4rem 0.8rem;
    color: #fff;
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: all 0.2s ease;
    z-index: 100;
    box-shadow: 0 10px 20px rgba(0,0,0,0.8);
  }
  .deck-nav-thumb:hover .custom-tooltip {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  /* RIGHT COLUMN */
  .info-column {
    flex: 0 0 50%;
    max-width: 50%;
    position: relative;
    height: 100%;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: flex-end; 
  }

  .info-panels-wrapper {
    position: relative;
    width: 100%;
    height: 100%; 
  }

  .brand-info-panel {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transform: translateX(40px);
    transition: all 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .brand-info-panel.active {
    opacity: 1;
    visibility: visible;
    transform: translateX(0);
  }

  .large-trailer-card {
    position: relative;
    width: 100%;
    height: 100%;
    background: transparent;
    /* Removed overflow: hidden so left edge feathering can bleed cleanly if needed */
    border: none;
  }

  .trailer-bg-wrapper {
    position: absolute;
    top: 0;
    left: 50%;
    width: 150%;
    height: 100%;
    /* Legal now, and load-bearing — see .backdrop-plate. There is no iframe
       left anywhere on this page, so hard rule 3 no longer applies here. */
    overflow: hidden;
    /* Held in a custom property because the push-in keyframes below have to
       restate the whole transform, and the compact layout needs to zero the
       shift without having to redeclare the animation too. */
    --trailer-shift: -50%;
    transform: translateX(var(--trailer-shift));
    pointer-events: none;
    z-index: 1;
    /*
      The video's edges — "no hard edges, even from the video".

      HORIZONTAL: this wrapper is 150% wide and centred, so it already spans
      -25%..125% of the info column: the video bleeds a quarter of a column
      LEFT, under the deck. The old two-stop ramp hit full opacity at 15% of
      the wrapper (x = -2.5% of the column), so the whole crossfade happened
      in a narrow band right at the seam and read as an edge. Full opacity at
      29% puts it at x = +18% of the column (-25 + 150 * 0.29), so the video
      dissolves in across a band ~43% of the column wide, straddling the seam
      instead of stopping at it.

      VERTICAL: nothing. The wrapper used to be 150% TALL as well, and relied
      on a SECOND mask layer intersected with this one to claw the overhang
      back. That is what put the video 111px below the row on desktop and
      74px below it on a landscape phone — straight over the footer — because
      `mask-composite: intersect` is the one part of this construct WebKit
      does not honour reliably. With the composite gone the two layers union
      instead, and a union of "opaque from 29% rightward" with anything is
      opaque: no vertical containment at all.

      So containment is geometric now. The wrapper is exactly as tall as its
      panel, and `mask-repeat: no-repeat` on a single layer already clears
      everything outside the wrapper's own box — including the 6% the
      push-in animation scales past it. One mask layer, no compositing, and
      the containment holds even where masks are ignored entirely.

      The soft top and bottom edges that the second layer used to provide are
      painted instead, by .trailer-gradient-top / -bottom below. A scrim over
      the video is the same result as a mask under it on a black page, and it
      cannot silently stop working.
    */
    -webkit-mask-image:
      linear-gradient(to right,
        rgba(0,0,0,0) 0%, rgba(0,0,0,0.03) 6%, rgba(0,0,0,0.10) 11%,
        rgba(0,0,0,0.24) 15%, rgba(0,0,0,0.45) 19%, rgba(0,0,0,0.68) 22%,
        rgba(0,0,0,0.86) 25%, rgba(0,0,0,0.96) 27%, rgba(0,0,0,1) 29%,
        rgba(0,0,0,1) 100%);
    mask-image:
      linear-gradient(to right,
        rgba(0,0,0,0) 0%, rgba(0,0,0,0.03) 6%, rgba(0,0,0,0.10) 11%,
        rgba(0,0,0,0.24) 15%, rgba(0,0,0,0.45) 19%, rgba(0,0,0,0.68) 22%,
        rgba(0,0,0,0.86) 25%, rgba(0,0,0,0.96) 27%, rgba(0,0,0,1) 29%,
        rgba(0,0,0,1) 100%);
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
  }

  /* ══════════════════════════════════════════════════════════════════════
     THE BACKDROP PLATE

     One image, blurred, drifting. Two things about it are load-bearing.

     THE WRAPPER CLIPS. A CSS blur goes WEAK at its own element's edges — it
     samples transparent pixels from outside and mixes them in, so the outermost
     band of a blurred element is the least blurred part of it. The plate is
     also scaled up, which pushed it past its own box and out behind the row's
     heading. Together those put a strip of near-sharp artwork directly behind
     the category title: reported as "not blurred all the way to the top", and
     reproduced with a striped test image where the band is unmistakable.

     So the wrapper clips (`overflow: hidden`, which is only safe here because
     there is no longer an iframe anywhere in this subtree — see hard rule 3)
     and the plate overscans well past it. The blur's weak edge now falls
     outside the clip and is never seen; what shows is the middle of the blur,
     which is uniform.

     THE DRIFT IS A TRANSFORM ON A STATIC BLUR. The filter never changes, so the
     browser rasterises the blurred surface once and the animation is the
     compositor moving that texture. Animating the blur itself would re-raster
     every frame, which is what made this page judder before.
     ══════════════════════════════════════════════════════════════════════ */
  .backdrop-plate {
    position: absolute;
    /* Overscan: the blurred edges sit outside the wrapper's clip. */
    inset: -14%;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    filter: blur(10px) saturate(1.08);
    -webkit-filter: blur(10px) saturate(1.08);
  }

  /* ══════════════════════════════════════════════════════════════════════
     THE GHOST MARK

     The same logo that sits crisp on the stage, blown up past the panel and
     blurred into a coloured haze. `contain`, not `cover`: a logo is a shape on
     transparency and cover would crop it to an unreadable corner. Brightened
     because a 26px blur over black loses most of its luminance, and tinted by
     the brand's own colour so a monochrome wordmark still lights the panel.
     ══════════════════════════════════════════════════════════════════════ */
  .backdrop-plate--mark {
    inset: -30%;
    background-size: contain;
    background-position: 58% 50%;
    filter: blur(26px) saturate(1.4) brightness(1.45);
    -webkit-filter: blur(26px) saturate(1.4) brightness(1.45);
    opacity: 0.55;
  }

  /*
    Lit without needing a single asset. The thirteen hubs that have no logo and
    no key art get this and the wordmark, which is a designed empty state
    rather than a black rectangle.
  */
  .stage-wash {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background:
      radial-gradient(115% 85% at 72% 42%,
        rgba(var(--brand-rgb, 204,0,0), 0.20) 0%,
        rgba(var(--brand-rgb, 204,0,0), 0.10) 34%,
        rgba(var(--brand-rgb, 204,0,0), 0.03) 58%,
        transparent 78%);
  }

  /* ══════════════════════════════════════════════════════════════════════
     THE STAGE

     What the right-hand half of an open row is FOR. It was a blurred photo and
     nothing else, which read — accurately — as unfinished.

     Two layers. The mark is always there, large, and is the whole subject on a
     hub with no trailer. Where a hub has one, the trailer fades in over the
     mark, plays ONCE, and dissolves back to it; the mark is what the panel
     rests on before the video arrives and after it finishes, so the surface is
     never empty and never loops YouTube's chrome back on screen.

     Nothing in here clips (HARD RULE 3) — see the note in the markup.
     ══════════════════════════════════════════════════════════════════════ */
  /*
    ALIGNED WITH THE POSTER, NOT WITH THE ROW.

    Reported as "not in-line", and it was: the deck column is a flex column
    holding the stack AND the 90px nav rail (plus its 1rem margin), so the
    poster centres in the space ABOVE the rail while this side centred in the
    whole row. The two large objects sat ~50px apart vertically.

    Reserving the same strip here puts both in the same band. One number, in
    one place, so they cannot drift apart again.
  */
  .brand-stage {
    /* The full plate. There is no second column to align against any more. */
    position: absolute;
    inset: 0;
    z-index: 4;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .brand-stage-mark {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 88%;
    max-width: 620px;
    display: flex;
    align-items: center;
    justify-content: center;
    /* HARD RULE 6: the glow lives on the wrapper, never on the <img>. */
    filter: drop-shadow(0 0 42px rgba(var(--brand-rgb, 204,0,0), 0.42))
            drop-shadow(0 18px 44px rgba(0,0,0,0.8));
    transition: opacity 0.9s ease, transform 0.9s cubic-bezier(0.2, 0.8, 0.2, 1);
    opacity: 0.96;
  }

  .brand-stage-mark-img {
    width: 100%;
    height: auto;
    max-height: 46vh;
    object-fit: contain;
  }

  .brand-stage-wordmark {
    font-family: var(--font-display, 'Montserrat', sans-serif);
    font-size: clamp(1.6rem, 3.4vw, 3.2rem);
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-align: center;
    color: rgba(255,255,255,0.9);
    line-height: 1.15;
  }

  /*
    The trailer sits INSET, not full-bleed. Full-bleed is what put YouTube's
    centred play overlay and its auto-captions in the middle of the panel with
    no crop able to reach them; held to 84% with the mark still lit behind it,
    the frame reads as a plate on the stage and its own chrome lands inside a
    smaller, darker box.
  */
  .brand-stage-video {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 100%;
    aspect-ratio: 16 / 9;
    transform: translate(-50%, -50%) scale(1.02);
    opacity: 0;
    transition: opacity 1.1s ease, transform 1.1s cubic-bezier(0.2, 0.8, 0.2, 1);
    /* The layer read. Same shadow the poster carries. */
    box-shadow: 0 30px 70px rgba(0,0,0,0.85);
    /* NO `overflow: hidden` and no border-radius needing one. HARD RULE 3. */
  }

  /* ══════════════════════════════════════════════════════════════════════
     THE VIDEO IS A LAYER, NOT A HOLE IN THE PAGE.

     I got the last note backwards. "Feather the edges" meant the FRAME's
     edges — blend the box into the panel — and I painted a vignette over the
     picture instead, which dimmed the trailer itself. Wrong surface.

     So: nothing is drawn over the video. It is a clean rectangle with a deep
     soft shadow under it, which is exactly what the deck card does on a phone
     and exactly the "intentional layer" read that was asked for. A shadow
     separates a plane from its ground without touching what is on it.
     ══════════════════════════════════════════════════════════════════════ */

  /* ══════════════════════════════════════════════════════════════════════
     THE CAPTION GUARD — a bar on black, not a vignette on the picture.

     Captions came back the moment the overlay came off: "Beautiful face" and
     "Do you realize" burnt across the bottom of the frame. `cc_load_policy=0`
     did not stop them and cannot be made to — captions follow the VIEWER's
     own preference and the player decides, not us.

     What went wrong the first time was WHERE the paint went. A gradient across
     the whole frame dimmed the trailer itself. This is one hard-edged bar over
     the bottom 17% only.

     That band is already black. These trailers are 2.39:1 inside a 16:9
     player, so the player letterboxes them: measured on the DC frame, the
     picture occupies the middle ~70% and the caption sits in the black below
     it. The bar covers the letterbox, not the film — on a 'scope trailer it is
     invisible, and the most it can ever cost is the bottom sliver of a 16:9
     source.

     No gradient, no top bar, nothing over the picture. The title bar at the
     top is handled by TRAILER_SETTLE_MS instead, which costs no image at all.
     ══════════════════════════════════════════════════════════════════════ */
  .brand-stage-guard {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 17%;
    background: #050505;
    z-index: 2;
    pointer-events: none;
  }

  .brand-stage-iframe,
  .brand-stage-media {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
    object-fit: cover;
    /*
      A frame whose document never loads — ad blocker, corporate DNS, a
      blocked region — paints white by default, which is a white rectangle in
      the middle of a black page. Give it the page's own black.
    */
    background: #050505;
    /*
      ─── AND TELL SAFARI THE FRAME ITSELF IS DARK ─────────────────────────

      The background above paints the iframe ELEMENT. It does not reach the
      document inside it, and on iOS Safari a cross-origin frame renders its
      own `about:blank` on a white canvas until YouTube's CSS arrives, so the
      white flashed over the black we just set. `color-scheme` is the one
      property that crosses that boundary: it tells the embedded document
      which canvas colour to default to before it has said anything itself.
    */
    color-scheme: dark;
  }

  /* Playing: video up, mark down but not out — it is the glow behind it. */
  .brand-stage.is-playing .brand-stage-video {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }
  .brand-stage.is-playing .brand-stage-mark {
    opacity: 0.3;
    transform: translate(-50%, -50%) scale(1.06);
  }

  @media (prefers-reduced-motion: reduce) {
    .brand-stage-mark,
    .brand-stage-video {
      transition: none;
    }
  }

  /*
    PHONES AND SHORT VIEWPORTS GET NO TRAILER.

    The whole info column is the full-bleed plate behind the deck at these
    sizes (see the compact layout below), so a video here would play under the
    poster where it cannot be seen, having cost ~900kB of player script on the
    connection least able to afford it. The mark stays: blurred behind the
    card it is the brand's own colour and shape, which is the point of it.
  */
  @media (max-width: 1023px), (max-height: 620px) {
    .brand-stage {
      bottom: 0; /* no deck rail to align to — the column is the plate here */
    }
    .brand-stage-video {
      display: none;
    }
    .brand-stage-mark {
      width: 88%;
      opacity: 0.5;
      filter: blur(2px) drop-shadow(0 0 40px rgba(var(--brand-rgb, 204,0,0), 0.34));
    }
  }


  .trailer-fallback-img {
    width: 100%;
    height: 100%;
    border: none;
    object-fit: cover;
  }

  .trailer-dark-overlay {
    position: absolute;
    /*
      Spans -25%..125% of the panel, i.e. the SAME box as .trailer-bg-wrapper.

      Pinned to the panel (inset: 0) its full-opacity end landed exactly on
      the column boundary, so however soft the gradient was to the right of
      that line, the line itself was a step: pixel-scanning a horizontal
      slice across the seam showed a jump of 21-27 at x=756 on a 1440 render.
      A gradient cannot hide its own start — the fix is to move the start off
      the seam entirely.

      Sharing the video's box means the wash is already ~0.6 alpha and still
      falling by the time it crosses the boundary, and it keeps going into
      the deck column, where .deck-column's higher z-index paints it UNDER
      the cards — so it deepens the background the deck fades into rather
      than dimming the deck itself.
    */
    top: 0;
    bottom: 0;
    left: -25%;
    width: 150%;
    /* Lightened: peak 1 -> 0.88 and the tail pulled in from 42% to 34%.
       "The vignette is too much overall" — with the motion gone, none of
       these washes are holding anything together any more. */
    background: linear-gradient(to right,
      rgba(5,5,5,0.88) 0%, rgba(5,5,5,0.84) 5%, rgba(5,5,5,0.76) 9%,
      rgba(5,5,5,0.65) 13%, rgba(5,5,5,0.50) 17%, rgba(5,5,5,0.36) 21%,
      rgba(5,5,5,0.23) 25%, rgba(5,5,5,0.12) 29%, rgba(5,5,5,0.05) 33%,
      rgba(5,5,5,0) 38%);
    z-index: 2;
    pointer-events: none;
  }

  /*
    Softens the wrapper's top cut. The mask contains the video to its own box
    now (see .trailer-bg-wrapper), which is a clean edge rather than a fade,
    and a clean edge at the top of the row reads as a letterbox bar. This
    puts the fade back as paint.
  */
  /* ══════════════════════════════════════════════════════════════════════
     THE EDGE SCRIMS REACH ALPHA 1, AND HOLD IT.

     Reported as "visible light leaks above and below the main image… the leak
     grows as I leave the page idle". Both halves of that are one bug.

     These two scrims used to top out at rgba(5,5,5,0.95), so five per cent of
     the plate was showing at the panel's extreme top and bottom edge — a
     hard-edged bright line, because a gradient that starts at 0.95 has nothing
     to fade FROM. And it appeared to grow, because it does change: the plate
     drifts, so different parts of the artwork slide through that few-pixel
     strip and a bokeh highlight passing through it is much brighter than the
     shadow that was there before. Nothing was expanding — the strip was
     sampling a moving image.

     Alpha 1 held for the first few per cent gives the fade something to start
     from, and guarantees the extreme edge is the page's own black no matter
     what the plate does underneath it.
     ══════════════════════════════════════════════════════════════════════ */
  .trailer-gradient-top {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 18%;
    background: linear-gradient(to bottom,
      rgba(5,5,5,1) 0%, rgba(5,5,5,1) 9%, rgba(5,5,5,0.84) 24%,
      rgba(5,5,5,0.56) 44%, rgba(5,5,5,0.28) 66%, rgba(5,5,5,0.09) 84%,
      rgba(5,5,5,0) 100%);
    z-index: 3;
    pointer-events: none;
  }

  .trailer-gradient-bottom {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 38%;
    background: linear-gradient(to top,
      rgba(5,5,5,1) 0%, rgba(5,5,5,1) 6%, rgba(5,5,5,0.86) 18%,
      rgba(5,5,5,0.60) 36%, rgba(5,5,5,0.34) 56%, rgba(5,5,5,0.14) 76%,
      rgba(5,5,5,0.03) 90%, rgba(5,5,5,0) 100%);
    z-index: 3;
    /*
      This scrim is a VERTICAL gradient across the panel's full width, so its
      left edge was a flat vertical cut sitting on the seam — the second
      contributor to the step at x=756, and the one that showed up lower in
      the panel where the scrim is densest. Feathering its left edge lets it
      arrive with the video instead of announcing the panel.
    */
    -webkit-mask-image: linear-gradient(to right,
      rgba(0,0,0,0) 0%, rgba(0,0,0,0.10) 6%, rgba(0,0,0,0.32) 11%,
      rgba(0,0,0,0.60) 16%, rgba(0,0,0,0.84) 21%, rgba(0,0,0,0.96) 25%,
      rgba(0,0,0,1) 29%);
    mask-image: linear-gradient(to right,
      rgba(0,0,0,0) 0%, rgba(0,0,0,0.10) 6%, rgba(0,0,0,0.32) 11%,
      rgba(0,0,0,0.60) 16%, rgba(0,0,0,0.84) 21%, rgba(0,0,0,0.96) 25%,
      rgba(0,0,0,1) 29%);
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
  }


  /* ══════════════════════════════════════════════════════════════════════
     THE BRAND PLATE — logo, line, and way in, all ON THE ARTWORK.

     This replaces a block of trailer-corner styles (`.trailer-bottom-content`,
     `.trailer-logo-wrap`, `.trailer-text-title`, `.brand-desc`,
     `.dynamic-brand-btn`) that positioned the same three things over the
     video in the other column.

     Two reasons they moved. The first is structural: at phone widths the
     trailer panel is about 200px tall and that stack is about 165px, so it
     filled the video and collided with YouTube's own title overlay and
     control bar — the "crammed" portrait layout, and it was a collision, not
     a spacing problem. The second is compositional: a hub had its identity on
     one surface and its artwork on another, and neither could win.

     The site already solves this for video cards — `.video-watermark` in
     ContentCard.astro sits the mark bottom-left over the frame — so hubs use
     the same idea at poster scale.
     ══════════════════════════════════════════════════════════════════════ */

  /*
    A hub with no key art yet. Brand-tinted, quiet, and carrying no mark of
    ours — the wordmark in .deck-card-plate is the only thing named on it.
  */
  .deck-card-empty {
    width: 100%;
    height: 100%;
    background:
      radial-gradient(120% 90% at 50% 32%,
        rgba(var(--brand-rgb, 204,0,0), 0.22) 0%,
        rgba(var(--brand-rgb, 204,0,0), 0.08) 42%,
        transparent 72%),
      linear-gradient(150deg, #16161a 0%, #0b0b0d 62%, #050505 100%);
  }

  .deck-card-scrim {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.6s ease;
    /*
      Multi-stop rather than a two-stop ramp, for the same reason the seam
      feather is: a linear alpha ramp shows its own endpoints as faint bands
      across the artwork.
    */
    background: linear-gradient(to top,
      rgba(0,0,0,0.80) 0%, rgba(0,0,0,0.72) 12%, rgba(0,0,0,0.56) 24%,
      rgba(0,0,0,0.37) 36%, rgba(0,0,0,0.20) 48%, rgba(0,0,0,0.09) 60%,
      rgba(0,0,0,0.02) 72%, transparent 82%);
  }

  .deck-card.active .deck-card-scrim {
    opacity: 1;
  }

  .deck-card-plate {
    position: absolute;
    left: 2rem;
    bottom: 1.9rem;
    z-index: 4;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.7rem;
    /* Leaves room for the Enter chip on the opposite corner. */
    max-width: calc(100% - 2rem - 11rem);
    pointer-events: none;
  }

  /* HARD RULE 6: drop-shadow lives on the WRAPPER, never the <img>. */
  .deck-card-logo-wrap {
    display: block;
    filter: drop-shadow(0 6px 16px rgba(0,0,0,0.95));
  }

  /*
    SIZED AGAINST THE CARD, NOT IN FIXED PIXELS.

    A flat pixel height cannot be right at more than one screen size, and this
    one was 26px everywhere: 11% of the card's height on a phone, which reads
    correctly, but 4.8% on an iPad and 4% on a wide desktop, which is what
    "way too small" was describing. The phone was fine because the card is
    small there — the logo had not grown, the card had.

    .deck-stack is a size container and .deck-card already measures itself
    against it as `min(94cqw, 167cqh)`, so the card's height is
    `min(52.9cqw, 93.9cqh)`. Taking ~10.5% of that keeps the mark the same
    proportion of the artwork at every width. The floor holds the phone at
    what it already was; the ceiling stops it going silly on a very large
    display.
  */
  .deck-card-logo {
    display: block;
    height: clamp(26px, min(5.6cqw, 9.9cqh), 88px);
    width: auto;
    max-width: 100%;
    object-fit: contain;
  }

  /* Stand-in for a hub with no logo asset. Same weight on the page as a
     wordmark would be, so the layout does not shift when artwork arrives. */
  .deck-card-wordmark {
    font-family: var(--font-display);
    font-size: 1.9rem;
    line-height: 1;
    color: #fff;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    text-shadow: 0 6px 18px rgba(0,0,0,0.95);
  }

  /*
    The billing block. Small, tracked out and dim on purpose — on a poster
    this is the line nobody reads first, and that is exactly its job here.
  */
  .deck-card-desc {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.62);
    line-height: 1.6;
    text-shadow: 0 2px 8px rgba(0,0,0,0.95);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /*
    THE CHIP IS A SIGNPOST, NOT A CONTROL.

    The whole card is the link now, so this must not look like a second,
    separate target sitting on it. It is unfilled, hairline and quiet at
    rest, and it answers the card's own hover and focus rather than its own —
    which is what tells you the artwork is the thing you are pressing.

    The brand colour arrives only on that hover. Held as a TRANSLUCENT tint
    over the dark card rather than a solid fill, so the label stays legible
    whatever hex a hub is given in the CMS, white included (Apple TV+, A24,
    Universal and Sony Pictures are all set to white, and a solid fill made
    the label vanish on every one of them).
  */
  .deck-card-enter {
    position: absolute;
    right: 2rem;
    bottom: 1.9rem;
    z-index: 4;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.7rem 1.35rem;
    border: 1px solid rgba(255, 255, 255, 0.28);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.9);
    white-space: nowrap;
    pointer-events: none;
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
    transition:
      border-color 0.35s cubic-bezier(0.25, 0.8, 0.2, 1),
      background-color 0.35s cubic-bezier(0.25, 0.8, 0.2, 1),
      box-shadow 0.35s cubic-bezier(0.25, 0.8, 0.2, 1),
      color 0.35s cubic-bezier(0.25, 0.8, 0.2, 1);
  }

  .deck-card-enter svg {
    width: 15px;
    height: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.35s cubic-bezier(0.25, 0.8, 0.2, 1);
  }

  .deck-card.active:hover .deck-card-enter,
  .deck-card.active:focus-visible .deck-card-enter {
    border-color: rgba(var(--brand-rgb, 204, 0, 0), 0.85);
    background-color: rgba(var(--brand-rgb, 204, 0, 0), 0.18);
    box-shadow:
      0 0 34px rgba(var(--brand-rgb, 204, 0, 0), 0.32),
      inset 0 0 22px rgba(var(--brand-rgb, 204, 0, 0), 0.12);
    color: #fff;
  }

  .deck-card.active:hover .deck-card-enter svg,
  .deck-card.active:focus-visible .deck-card-enter svg {
    transform: translateX(4px);
  }

  /* Only the front card is branded. The ones behind it are silhouettes. */
  .deck-card:not(.active) .deck-card-plate,
  .deck-card:not(.active) .deck-card-enter {
    opacity: 0;
  }

  /* The card is an <a>; it must not inherit link chrome. */
  .deck-card {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .deck-card.active:focus-visible {
    outline: 2px solid rgba(var(--brand-rgb, 204, 0, 0), 0.9);
    outline-offset: 3px;
  }


  /*
    The front card is a link in behaviour, so it should say so on hover.
    The cards behind it still mean "bring me forward".
  */
  .deck-card.active {
    cursor: pointer;
  }


  /* ══════════════════════════════════════════════════════════════════════
     MOBILE  (issue #138, handoff item 1)

     The desktop layout is two hard 50% flex columns side by side. Below
     768px that is unusable — each column gets ~190px, the deck cards become
     illegible slivers and the trailer's bottom content has nowhere to go.

     Per the ticket this is re-fitted with real media queries, NOT reverted to
     a grid: the columns stay flex and simply stack, video on top (40%) and
     deck below (60%). DOM order is deck-then-info, so `order` does the
     reordering — CSS, not JS and not duplicated markup (hard rule 7).

     The 3D deck keeps its stacked metaphor and just compresses its spread,
     rather than flattening to a carousel, so the interaction a phone user
     gets is the same one the desktop design established.
     ══════════════════════════════════════════════════════════════════════ */
  /* ══════════════════════════════════════════════════════════════════════
     STAGING — how an open row arrives, and how it keeps moving.

     Everything below is about TIMING and MOTION rather than decoration.
     Opening a row used to reveal every part of it at the same instant, which
     is what made the page feel like a screenshot appearing rather than a
     scene starting. Now the pieces land on a beat: artwork, then the
     thumbnail strip, then the brand mark, then the words. It reads as
     something being presented to you.

     Each piece starts slightly low and faded and settles into place. The
     delays are the whole point — they are what a title sequence does.
     ══════════════════════════════════════════════════════════════════════ */

  .deck-stack,
  .deck-nav-track,
  .deck-card-plate,
  .deck-card-enter {
    opacity: 0;
    transition:
      opacity 0.7s ease,
      transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* The artwork leads, and only fades — its transform belongs to the drift
     below, and two rules fighting over one transform is how motion bugs
     start. */
  .accordion-section.expanded .deck-stack {
    opacity: 1;
    transition-delay: 0.34s;
  }

  .deck-nav-track,
  .deck-card-plate,
  .deck-card-enter {
    transform: translateY(16px);
  }

  .accordion-section.expanded .deck-nav-track {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0.52s;
  }

  /* The mark and its line ride the artwork in, a beat behind it. Scoped to
     the ACTIVE card so the silhouettes behind stay unbranded — this rule and
     the `:not(.active)` one above are the same statement from both sides. */
  .accordion-section.expanded .deck-card.active .deck-card-plate {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0.62s;
  }

  .accordion-section.expanded .deck-card.active .deck-card-enter {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0.74s;
  }

  /* ══════════════════════════════════════════════════════════════════════
     NO MOTION ON THIS SIDE OF THE ROW. NONE.

     There used to be a 32s `scale(1) -> scale(1.06)` push-in on
     .trailer-bg-wrapper, sold as a documentary-style move on a still. It was
     the light leak — reported three times, and I twice "fixed" something else.

     .trailer-bg-wrapper is the element that CLIPS. Scaling a clipping box
     scales the clip along with it, so the wrapper's own edge crept 3% above
     and below the panel and carried the plate's near-sharp, under-blurred
     border out with it. The top and bottom scrims are SIBLINGS of that
     wrapper, laid out against .large-trailer-card, so they cannot cover
     anything that leaves the wrapper's box — and a 32s ease-in-out is exactly
     why it "grows as I leave the page idle".

     A blurred plate that moves inside a clip it is also moving is not worth
     the two bugs it caused. Everything here is static now: the drift on the
     plate is gone, the push-in is gone, and the pan on the fallback image is
     gone. If motion ever comes back on this side, it moves something that is
     NOT the clip and NOT its contents.
     ══════════════════════════════════════════════════════════════════════ */

  /*
     THE DECK DRIFTS AGAINST IT.

     As the pointer moves across an open row, the artwork slides a few pixels
     one way and the backlight a little further. Because the trailer is
     pushing in on its own clock and the deck answers the pointer, the two
     halves are never moving together — which is what sells depth. The
     numbers are small on purpose: this should feel like the scene has weight,
     not like the page is wobbling.
  */
  /*
    THE ARTWORK DOES NOT DRIFT.

    The deck stack used to translate with the pointer, which meant the big
    image wandered a few pixels whenever the mouse moved anywhere in the row
    — reported as "it randomly moves without doing anything". Depth now comes
    entirely from the backlight behind it (below) and the trailer's slow push
    on the other side, both of which move while the subject stays put. That is
    the more filmic arrangement anyway: the camera moves, the subject holds.
  */
  .deck-stack {
    transition: opacity 0.7s ease;
  }

  .ambient-glow-container {
    transform: translate3d(
      calc(var(--drift-x, 0) * -22px),
      calc(var(--drift-y, 0) * -14px),
      0
    );
    transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* ══════════════════════════════════════════════════════════════════════
     COMPACT  — phones in portrait, and anything too SHORT for two columns.

     The desktop layout is two 50% columns side by side. That needs both
     width and height: a landscape phone clears the width test at 926px and
     fails the height one at 428px, which is why it was getting the desktop
     rules and overflowing them. The query asks about both.

     Stacking the columns was the old answer and it is what made portrait
     feel crammed: video 40% / deck 60% left roughly 200px for each, and the
     trailer's overlaid text (~165px of it) filled its share completely and
     spilled onto the video and onto YouTube's own title and control bars.

     So the columns do not stack any more — the trailer leaves the layout
     entirely and becomes the plate BEHIND the row, with the artwork on top
     of it. Same square footage, one thing in it instead of two, and the
     branding is on the artwork where it now lives at every size.
     ══════════════════════════════════════════════════════════════════════ */
  /* ══════════════════════════════════════════════════════════════════════
     ONE LAYOUT, EVERY SIZE.

     These rules were a phone-and-landscape-only override sitting under a 50/50
     desktop split. The split is gone, and the media query with it: the compact
     treatment was simply the better design of the two, and maintaining both
     meant every fix had to be made twice — with the desktop half accumulating
     problems the compact half never had (the embed's chrome, the seam wash,
     the deck feather eating the Enter chip).

     One object per row now, at every width: the poster centred over the hub's
     own blurred mark, its rail beneath, the next card peeking at the edge.

     The 50/50 split is not discarded — it moves to the HUB page, where it has
     real content to drive it (recent videos and articles) instead of an
     autoplaying embed nobody asked for.

     The declarations below keep their original indentation deliberately: this
     is an unwrap, not a rewrite, so the diff shows exactly one line removed at
     each end and nothing else touched.
     ══════════════════════════════════════════════════════════════════════ */
    .deck-view-container {
      flex-direction: column;
      padding: 0;
      position: relative;
    }

    /* Out of the flow, behind everything. */
    .info-column {
      position: absolute;
      inset: 0;
      flex: none;
      max-width: none;
      width: 100%;
      height: 100%;
      z-index: 0;
      display: block;
    }

    .deck-column {
      position: relative;
      z-index: 2;
      flex: 1 1 auto;
      max-width: 100%;
      width: 100%;
      height: 100%;
      min-height: 0;
      /*
        Poster and rail read as ONE object, centred in the row.

        With the stack taking all the leftover height the card was centred in
        a 389px box while the rail stayed pinned 120px below it, so the two
        halves of the same control floated apart with the row's slack sitting
        between them. Centring the pair puts the slack around the group
        instead, where it is the space the backing plate shows through.
      */
      justify-content: center;
    }

    /* ── Deck ────────────────────────────────────────────────────────────
       The card can no longer be sized from width alone. On a 926px landscape
       phone the row is only ~355px tall, so a card at 94% of the width would
       be 490px tall and simply not fit — the same "sized by one axis on a
       screen constrained by the other" mistake that put the video over the
       footer.

       So the stack becomes a size container and the card takes whichever of
       the two limits binds first: 94% of the stack's width, or the width
       that makes it 94% of the stack's HEIGHT (94 x 16/9 = 167). One
       declaration, correct in both orientations, no second breakpoint.

       Grid replaces the absolute + negative-margin centring it used to need:
       every card occupies the same cell and `place-items: center` holds them
       there, which leaves `transform` free for the deck offsets instead of
       having it fight a `margin-top` that had to be recomputed by hand
       whenever the width changed. */
    .deck-stack {
      /*
        NO `aspect-ratio` HERE, however tempting.

        Giving the stack an intrinsic 16/9 height closes the gap between the
        poster and the rail, and it also gives every COLLAPSED row a ~220px
        min-content height — their bodies are hidden but still laid out. The
        four rows then stop fitting the viewport and the page grows to 1290px
        with the last row's content running past the footer. The accordion
        only fits the screen because nothing inside it has an intrinsic
        height, and that has to stay true.

        So the stack still takes the leftover space, and the slack around the
        poster is filled by the backing plate showing through rather than by
        making the box smaller.
      */
      container-type: size;
      display: grid;
      grid-template: 1fr / 1fr;
      place-items: center;
      /* The right-edge feather aimed at a column that is no longer there. */
      -webkit-mask-image: none;
      mask-image: none;
    }

    .deck-card {
      position: relative;
      grid-area: 1 / 1;
      top: auto;
      left: auto;
      margin-top: 0;
      width: min(94cqw, 167cqh);
    }

    /* Compressed spread: the desktop 25% / 45% offsets push the second and
       third cards off a 390px screen entirely. */
    .deck-card.next-1 {
      transform: translateX(14%) scale(0.92);
    }

    .deck-card.next-2 {
      transform: translateX(25%) scale(0.85);
    }

    .deck-card.hidden {
      transform: translateX(36%) scale(0.78);
    }

    .peeking-spine {
      width: 34px;
    }

    .spine-text {
      font-size: 1rem;
      letter-spacing: 0.05em;
    }

    .deck-nav-track {
      /*
        ─── THE THUMBNAILS HAVE TO GROW WITH THE DECK ──────────────────────

        This was a flat 66px while `.deck-column` above it is `height: 100%` of
        an accordion row that expands with the viewport. Measured at 3840x2160:
        the deck is 1432px tall and the filmstrip under it was 66px — 4.6% of
        it — which reads as a control somebody forgot to scale rather than as
        navigation for the thing above it.

        THIS IS THE DECLARATION THAT COUNTS. There is an earlier
        `.deck-nav-track { height: 90px }` in this file, and despite its
        indentation this rule is NOT inside a media query: it ships
        unconditional, so it wins on source order at every viewport and the 90px
        has never applied. Verified by reading the built CSS rather than the
        source. Retune here, not there.

        Clamped rather than pure vh so it cannot collapse on a short laptop
        window or run away on a tall one.
      */
      /*
        HEIGHT COMES FROM THE THUMBNAILS NOW, not from `vh`. It was
        `clamp(66px, 7vh, 150px)` while the thumbs underneath it were a flat
        84x46 at every width, so the track grew and the pictures in it did not:
        at 3840x2160 the strip was 148px tall and each thumbnail was 46px of
        that, floating in it.
      */
      height: auto;
      margin-top: 0.5rem;
      padding: 10px 4%;
      gap: 12px;
      flex: 0 0 auto;
    }

    .deck-nav-thumb {
      /*
        ─── 20% OF THE CARD, AT EVERY WIDTH ────────────────────────────────

        `.deck-card` is `min(85%, 48vw)` and this is `9.6vw`, which is exactly
        a fifth of that — so once the card is on its vw branch, which is where
        the complaint came from, the tile is 20% of the picture above it by
        construction rather than by coincidence. Measured at 3840: card 1843
        wide, thumb 360. At 1920: 922 and 184.

        Clamped at both ends: 84px is where it started and is still right on a
        small laptop, and past ~3750px a thumbnail large enough to be a poster
        in its own right stops reading as navigation.

        `aspect-ratio` rather than a second fixed number, so the two cannot
        drift out of 16/9 the way 84x46 (1.83) already had.
      */
      width: clamp(84px, 9.6vw, 360px);
      height: auto;
      aspect-ratio: 16 / 9;
    }

    /* Hover tooltips are meaningless on touch and stick after a tap. */
    .custom-tooltip {
      display: none;
    }

    /* ── Trailer, now the backing plate ──────────────────────────────────
       Full width, no seam to feather, and pushed a long way down: it is
       behind the artwork, so anything it does with contrast is competing
       with the thing you are meant to be looking at. */
    .trailer-bg-wrapper {
      --trailer-shift: 0%;
      left: 0;
      width: 100%;
      -webkit-mask-image: none;
      mask-image: none;
    }


    .trailer-dark-overlay {
      left: 0;
      width: 100%;
      /* Dark enough that the poster stays the brightest thing in the row,
         light enough that the space around it reads as a scene rather than
         as an empty box. */
      background:
        linear-gradient(to bottom, rgba(5,5,5,0.78) 0%, rgba(5,5,5,0.46) 45%, rgba(5,5,5,0.86) 100%);
    }

    .trailer-gradient-top {
      height: 30%;
    }

    .trailer-gradient-bottom {
      height: 40%;
    }

    /* ── Brand plate on the card ─────────────────────────────────────────
       Corners pull in and the type comes down a step, but the arrangement is
       the desktop one. */
    .deck-card-plate {
      left: 1rem;
      bottom: 1rem;
      gap: 0.45rem;
      max-width: calc(100% - 1rem - 7.5rem);
    }

    /* Was a flat 26px, and after the media query was unwrapped it applied at
       EVERY width — the reason the mark read as tiny on a tablet. The rule
       above already scales with the card, so this override has nothing left
       to say. */

    .deck-card-wordmark {
      font-size: 1.15rem;
    }

    .deck-card-enter {
      right: 1rem;
      bottom: 1rem;
      padding: 0.5rem 0.9rem;
      font-size: 0.62rem;
      letter-spacing: 0.2em;
    }

    .deck-card-enter svg {
      width: 12px;
      height: 12px;
    }

    /* The blur radius is a fixed 120px, which on a 390px-wide column washes
       the whole deck out instead of backlighting the active card. */
    .ambient-glow-layer {
      -webkit-filter: blur(60px) saturate(1.5);
      filter: blur(60px) saturate(1.5);
    }

  /* ── Phone-width only ──────────────────────────────────────────────────
     Sizes that depend on a NARROW screen rather than a short one. A landscape
     phone gets the compact layout above but keeps the full-size titles and
     the billing line, because it has the width for them. */
  @media (max-width: 768px) {
    .featured-directory-page {
      /* 750px of min-height forces a scroll on nearly every phone and pushes
         the last collapsed row under the URL bar. The accordion sizes itself
         from the viewport instead. */
      min-height: 0;
      padding-top: var(--header-height, 64px);
    }

    .accordion-header {
      padding-left: 1.25rem;
      padding-right: 1.25rem;
    }

    .accordion-section.expanded .accordion-header {
      padding: 0.75rem 1.25rem 0.5rem;
    }

    .accordion-title {
      font-size: clamp(1.35rem, 6.5vw, 2.5rem);
      letter-spacing: -0.02em;
    }

    .accordion-section.expanded .accordion-title {
      font-size: clamp(1rem, 4.5vw, 1.5rem);
    }

    /* The typeface demo label is a temporary review aid and must stay visible
       (issue #138 item 2), but inline beside the title it overflows a phone.
       Its own line keeps all four readable without touching the demo itself. */
    .accordion-title span {
      display: block;
      margin-left: 0 !important;
      font-size: 0.65rem !important;
      margin-top: 0.15rem;
    }

    /* Two clamped lines of tracked-out caps is 40px of the ~200px of card
       that is not artwork. The logo already says which hub this is. */
    .deck-card-desc {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .accordion-section,
    .deck-card,
    .brand-info-panel,
    .accordion-title,
    .ambient-glow-layer,
    .ambient-glow-container,
    .deck-stack,
    .deck-nav-track,
    .deck-card-plate,
    .deck-card-enter,
    .deck-card-scrim,
    .deck-card-image {
      transition: none;
    }

    .trailer-fallback-img,
    .accordion-section.expanded .brand-info-panel.active .trailer-bg-wrapper {
      animation: none;
    }

    /* The backlight is the only thing still tracking the pointer. */
    .ambient-glow-container {
      transform: none;
    }

    /* The staged entrance is a nice-to-have; being able to read the row is
       not. With the transitions off, everything must simply BE there. */
    .accordion-section.expanded .deck-stack,
    .accordion-section.expanded .deck-nav-track,
    .accordion-section.expanded .deck-card.active .deck-card-plate,
    .accordion-section.expanded .deck-card.active .deck-card-enter {
      opacity: 1;
      transform: none;
      transition-delay: 0s;
    }
  }
</style>
