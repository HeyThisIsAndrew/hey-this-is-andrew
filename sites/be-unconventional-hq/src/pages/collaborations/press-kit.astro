---
// Self-hosted, same-origin - see Layout.astro. press.astro renders its own
// standalone <html> (bypasses Layout), so it needs its own font import; the
// Google Fonts <link> this replaced was a live external request that
// window.print() doesn't reliably wait on, so a slow/blocked fetch printed
// the whole page (both --font-display and --font-body resolve to this one
// family) in the browser's fallback sans-serif.
//
// UNLIKE media-kit.astro, this one-sheet is deliberately 100% static: every
// value below the fold is editorial copy, not a metric. It must never import
// sanity:client, channel-stats.json or social-stats.json - the press kit is
// the document handed to publicists and credentialing bodies, and it has to
// render identically whether or not the YouTube/Instagram/TikTok pipelines
// are healthy. Audience numbers live on /media-kit; keep them there.
import { site } from '../../data/site.js';
import { Image, getImage, Font } from 'astro:assets';
import logoImage from '../../assets/logo.webp';
const optimizedBg = await getImage({ src: logoImage, format: 'webp', width: 400 });

// The three COVERAGE cards carry the same hand-drawn pillar artwork the
// homepage uses, as a low-opacity watermark behind the text. Pulled from
// data/categories.js rather than re-importing the PNGs directly so the two
// surfaces can't drift: swap the homepage's film/tv/games art and this
// sheet follows. Still fully static - categories.js is a local module of
// static asset imports, no fetch of any kind.
import { categories } from '../../data/categories.js';
const categoryBySlug = Object.fromEntries(categories.map((cat) => [cat.slug, cat]));
const [filmArt, tvArt, gamesArt] = await Promise.all(
  ['film', 'tv', 'games'].map((slug) =>
    getImage({ src: categoryBySlug[slug].image, format: 'webp', width: 400 })
  )
);
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BE Unconventional HQ - Digital Press Kit</title>
    <meta name="robots" content="noindex">
    <Font cssVariable="--font-display" preload={true} />
    <style is:global>
        /* CSS reset and print setup */
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        /* Set the exact page size so it prints flawlessly to PDF */
        @page {
            size: 8.5in 11in;
            margin: 0;
        }

        :root {
            /* Brand Colors based on the site's dark mode and red accents */
            --bg-color: #0a0a0a;
            --surface-color: #111112;
            --text-main: #f0f0f0;
            --text-muted: #888888;
            --accent-red: #cc0000;
            --font-body: var(--font-display, 'Syne', sans-serif);
        }

        html, body {
            background-color: #111;
            margin: 0;
            padding: 0;
            min-height: 100vh;
        }

        /* .page::before is an ambient corner glow positioned at right: -10%,
           so it bleeds ~82px past the sheet and, on viewports between the
           breakpoint and roughly 940px, added that bleed to the scrollable
           width. It is decoration with pointer-events: none, so clipping the
           overflow costs nothing and removes the stray horizontal scrollbar.
           Scoped to `screen` so the print pipeline is untouched. */
        @media screen {
            html, body {
                overflow-x: hidden;
            }
        }

        /* The .page wrapper acts as the physical piece of paper */
        .page {
            width: 8.5in;
            height: 11in;
            margin: 3rem auto; /* Safely centers horizontally and adds 3rem margin top/bottom */
            background-color: var(--bg-color);
            color: var(--text-main);
            font-family: var(--font-body);
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
            display: flex;
            flex-direction: column;
            padding: 0.6in; /* Increased padding to ensure nothing touches the edges */
            position: relative;
            box-shadow: 0 20px 40px rgba(0,0,0,0.8); /* Drop shadow so it looks like a paper */
        }

        @media print {
            html, body {
                background-color: transparent;
            }
            .page {
                margin: 0;
                box-shadow: none;
                overflow: hidden;
            }
            .action-fab, .fab-container {
                display: none !important;
            }
            /* The ambient corner glow, title text-shadows, metric-card
               shadows, and the headshot's feathered-edge inset shadow used
               to be stripped here - all defensive fixes for a real bug
               where a visitor's own device (iOS Safari's AirPrint
               pipeline, specifically) rasterized these soft rgba effects as
               hard opaque blocks instead of a fade. That risk doesn't apply
               anymore: the downloaded PDF is now generated by headless
               Chromium directly (scripts/generate-media-kit-pdf.mjs), never
               by a visitor's own browser/OS print pipeline, and Chromium
               has never shown this bug in any test this session. Left
               un-stripped now on purpose, restoring the full design. */
        }

        /* -------------------------------------
           Mobile screen layout. Everything above this point was sized for
           an 8.5x11in printed sheet - fixed page width, in-unit type scale,
           and a viewport-fixed FAB stack that overlapped content the moment
           the canvas shrank to fit a phone. `screen` scopes all of this to
           on-screen viewing only; @media print above is a separate media
           type and is completely unaffected by anything in this block.
           ------------------------------------- */
        /* Ambient cinematic background glow in the top right */
        .page::before {
            content: '';
            position: absolute;
            top: -10%;
            right: -10%;
            width: 50%;
            height: 50%;
            background: radial-gradient(circle, rgba(204, 0, 0, 0.15) 0%, rgba(10, 10, 10, 0) 70%);
            z-index: 0;
            pointer-events: none;
        }

        /* Floating Actions Container */
        .fab-container {
            position: fixed;
            top: 50%;
            right: 2rem;
            transform: translateY(-50%);
            display: flex;
            flex-direction: column;
            gap: 1rem;
            z-index: 200;
            width: 260px; /* Fixed width so all buttons are exactly the same size */
        }

        /* Unified Action Button */
        .action-fab {
            background-color: rgba(10, 10, 10, 0.85); /* Slight cinematic backing */
            color: #fff;
            padding: 1rem 1.5rem;
            border-radius: 50px;
            font-family: var(--font-display);
            font-size: 0.75rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            border: 1px solid var(--accent-red);
            cursor: pointer;
            box-shadow: 0 0 15px rgba(204, 0, 0, 0.2);
            transition: all 0.3s cubic-bezier(0.25, 0.8, 0.2, 1);
            text-decoration: none;
            text-align: center;
            display: block;
            width: 100%;
        }

        .action-fab:hover {
            transform: translateY(-2px);
            background-color: var(--accent-red);
            color: #fff;
            box-shadow: 0 0 30px rgba(204, 0, 0, 0.6);
        }

        .container {
            position: relative;
            z-index: 1;
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 0.2in; /* Slightly tighter spacing to fit logo at bottom */
        }

        /* -------------------------------------
           1. Header Section
           ------------------------------------- */
        .header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 2px solid rgba(255, 255, 255, 0.1);
            padding-bottom: 0.25in;
        }

        .header-text {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
        }

        /* Cinematic Title Stack (matching website hero) */
        .hero-title-stack {
            display: flex;
            flex-direction: column;
            align-items: center;
            line-height: 0.85;
            text-transform: uppercase;
            font-family: var(--font-display);
        }

        .hero-title-stack span {
            display: block;
        }

        .word-be {
            font-size: 1.3rem;
            font-weight: 600;
            align-self: center;
            color: var(--text-muted);
            transform: translateX(-3.2rem);
        }

        .word-unconventional {
            font-size: 2.3rem;
            font-weight: 800;
            letter-spacing: -0.04em;
            color: var(--text-main);
            z-index: 2;
            filter: drop-shadow(0 4px 15px rgba(0, 0, 0, 0.6));
        }

        .word-hq {
            font-size: 1.8rem;
            font-weight: 800;
            align-self: center;
            margin-top: -0.7rem;
            transform: translateX(3.6rem);
            color: var(--accent-red);
            filter: drop-shadow(0 0 10px rgba(204, 0, 0, 0.5));
        }

        .hero-kicker {
            color: var(--accent-red);
            font-size: 0.65rem;
            letter-spacing: 0.3em;
            text-transform: uppercase;
            margin-bottom: 0.5rem;
            font-weight: 700;
        }

        .hero-subtitle {
            color: rgba(255, 255, 255, 0.9);
            font-size: 0.75rem;
            letter-spacing: 0.15em;
            text-transform: uppercase;
            margin-top: 0.8rem;
            font-weight: 600;
            filter: drop-shadow(0 2px 10px rgba(0, 0, 0, 0.3));
        }

        /* Image blocks */
        .header-images {
            display: flex;
            gap: 0.2in;
        }

        .image-placeholder {
            width: 1.6in;
            height: 1.6in;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* Headshot block */
        .pitch-container {
            display: flex;
            align-items: center;
            gap: 0; /* Using margin/padding for precise line placement */
            margin: 0.1in 0;
        }

        .headshot-placeholder {
            width: 1.4in; 
            height: 1.4in; /* Fixed height to match text box */
            background-size: cover;
            background-position: center top;
            background-image: url('/profile.jpg');
            flex-shrink: 0;
            position: relative;
        }

        /* Guarantee absolutely NO hard edges with aggressive feathering */
        .headshot-placeholder::after {
            content: '';
            position: absolute;
            inset: -1px; /* Cover any potential edge artifacts */
            box-shadow: inset 0 0 0.4in 0.1in var(--bg-color); 
            pointer-events: none;
        }

        /* -------------------------------------
           2. Elevator Pitch
           ------------------------------------- */
        .pitch {
            height: 1.4in; /* Match the photo's exact height */
            display: flex;
            flex-direction: column;
            justify-content: center; /* Vertically center the text */
            
            margin-left: 0.25in; /* Space between photo and the line */
            padding-left: 0.25in; /* Space between the line and the text */
            border-left: 1px solid rgba(255, 255, 255, 0.15); /* Subtle thin line */

            font-family: var(--font-display);
            font-size: 0.12in; 
            line-height: 1.6;
            font-weight: 600;
            color: rgba(255, 255, 255, 0.9);
            text-align: justify; /* Force text to be left and right justified evenly */
            text-transform: uppercase;
            letter-spacing: 0.1em;
        }

        /* -------------------------------------
           3. The Footprint (Metrics)
           ------------------------------------- */
        .section-title {
            font-family: var(--font-display);
            font-size: 0.15in; /* Further reduced to strictly fit inside the column bounds */
            font-weight: 800;
            text-transform: uppercase;
            color: var(--text-muted);
            letter-spacing: 0.05em; /* Reduced tracking to prevent overflow */
            margin-bottom: 0.15in;
            white-space: nowrap;
        }

        .metrics-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 0.2in;
        }

        .metric-card {
            background-color: var(--surface-color);
            border: 1px solid rgba(255, 255, 255, 0.05);
            padding: 0.15in 0.1in;
            text-align: center;
            position: relative;
            overflow: hidden;
            box-shadow: 0 4px 20px rgba(0,0,0,0.3);
        }

        /* Subtle glowing top border for cards */
        .metric-card::before {
            content: '';
            position: absolute;
            top: 0; left: 0; width: 100%; height: 3px;
            background: var(--accent-red);
            opacity: 0.7;
            z-index: 2; /* stays above the watermark below */
        }

        /* Pillar artwork watermark, set per card via --cardArt. The source
           PNGs are a near-black torn-paper shape with white chalk linework
           on transparency, so on this surface only the linework reads - it
           sits behind the value/label as texture, never as an image. Scaled
           past the card's height on purpose and clipped by the card's own
           overflow:hidden, which is what keeps it feeling like a watermark
           rather than a centered icon. */
        .metric-card::after {
            content: '';
            position: absolute;
            inset: 0;
            background-image: var(--cardArt);
            background-repeat: no-repeat;
            background-position: center;
            background-size: auto 190%;
            opacity: 0.18;
            z-index: 0;
            pointer-events: none;
        }

        /* 0.26in here where the media kit uses 0.35in. The media kit's card
           values are short formatted numbers (319.8K, US); this sheet's are
           words, and Syne at weight 800 is very wide - roughly 1em of advance
           per uppercase glyph. Measured off the font's own metrics (not a
           browser, which will silently substitute and under-report), against
           the 2.079in card content box: at 0.35in GAMING alone was already
           2.499in, and the longest value cannot wrap because it's a single
           word, so .metric-card's overflow:hidden clipped it mid-letter.
           0.26in puts GAMING at 1.856in, a 10% margin, and all
           three share the one size. (GAMING became GAMES in #146, one glyph
           shorter, so the cap was measured against a longer word than any
           card now carries. Left at 0.26in: it is still the constraint if a
           fourth pillar is ever added.) That in turn caps how long any value
           can be: 'TV/STREAMING' would have forced every card down to 0.144in,
           barely above the 0.13in label, so streaming lives in card two's
           label instead of its headline. */
        .metric-value {
            font-family: var(--font-display);
            font-size: 0.26in;
            font-weight: 800;
            line-height: 1;
            margin-bottom: 0.08in;
            color: var(--text-main);
            position: relative;
            z-index: 1; /* above the watermark */
        }

        .metric-label {
            font-size: 0.13in;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--text-muted);
            position: relative;
            z-index: 1;
        }

        /* -------------------------------------
           4 & 5. Audience and Capabilities Split
           ------------------------------------- */
        .split-section {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 0.2in; /* Reduced gap to give columns more width space */
            flex: 1;
        }

        /* Audience Data List */
        .data-list {
            list-style: none;
        }

        .data-list li {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0.05in 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            font-size: 0.16in;
        }

        .data-list li:last-child {
            border-bottom: none;
        }

        .data-label {
            font-size: 0.10in;
            line-height: 1.5;
            font-weight: 600;
            color: var(--text-main);
            flex: 1;
            padding-right: 0.1in;
            white-space: nowrap; /* Prevent wrapping */
        }

        .data-value {
            font-family: var(--font-display);
            font-weight: 800;
            font-size: 0.11in;
            color: var(--accent-red);
            white-space: nowrap;
            text-align: right;
        }

        /* Capabilities List */
        .capabilities-list {
            list-style: none;
            padding-top: 0.05in;
        }

        .capabilities-list li {
            position: relative;
            padding-left: 0.25in;
            margin-bottom: 0.1in;
            font-size: 0.12in; /* Reduced to fit all text on one line */
            white-space: nowrap; /* Strictly force single line */
            font-weight: 600;
            line-height: 1.5;
            color: var(--text-main);
        }

        /* Custom cinematic red bullet */
        .capabilities-list li::before {
            content: '►';
            position: absolute;
            left: 0;
            top: 50%;
            transform: translateY(-50%);
            color: var(--accent-red);
            font-size: 0.14in;
        }

        /* Gear columns. The hairline is a divider BETWEEN columns, so the
           first column in each row doesn't get one - it used to, which left
           a stray rule down the left edge with no matching rule on the right
           edge of the last column. Was four inline border-lefts; moved to a
           class so :first-child can drop it (an inline style would outrank
           any stylesheet rule). The mobile rule further down matters because
           .gear-grid drops to two columns there, which puts items 1 and 3 in
           the left position. */
        .gear-col {
            border-left: 1px solid rgba(255,255,255,0.1);
            padding-left: 0.1in;
        }

        .gear-col:first-child {
            border-left: none;
            padding-left: 0;
        }

        /* -------------------------------------
           6. Footer
           ------------------------------------- */
        .footer {
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            padding-top: 0.1in;
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            font-size: 0.095in; /* Safely reduced to guarantee no wrapping or touching edges */
            font-weight: 600;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .footer-item {
            display: flex;
            flex-direction: column;
            align-items: center; /* Center align label above the text */
            text-align: center;
            gap: 0.08in;
        }
        
        .footer a {
            color: var(--text-main);
            text-decoration: none;
        }

        .footer-logo-container {
            display: flex;
            justify-content: center;
            margin-top: 0.1in;
            padding-bottom: 0.1in;
        }

        .footer-logo {
            width: 2.5in;
            height: 0.8in;
            background-image: var(--bgUrl);
            background-size: contain;
            background-repeat: no-repeat;
            background-position: center;
        }
        .social-icon-link {
            display: flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
        }
        .social-icon-link:hover svg {
            fill: #ffffff !important;
        }

        /* 820px, not 720px. .page is a fixed 8.5in = 816px canvas, so every
           viewport between the old breakpoint and 816px rendered a sheet wider
           than the screen and scrolled sideways. The breakpoint now sits just
           above the canvas width, so any viewport that cannot fit the paper
           gets the fluid layout instead. */
        @media screen and (max-width: 820px) {
            .page {
                width: 100%;
                height: auto;
                min-height: 100vh;
                margin: 0;
                padding: 2rem 1.25rem 12rem; /* bottom clears the fixed action bar below */
                box-shadow: none;
                overflow-x: hidden; /* .page::before's ambient glow is positioned with a
                   negative right offset by design (bleeds past the edge on the
                   fixed-width desktop canvas); clip it here so it can't add
                   horizontal scroll room on a fluid-width mobile page. */
            }

            .container {
                gap: 1.5rem;
            }

            .hero-kicker {
                font-size: 0.55rem;
                letter-spacing: 0.15em;
            }

            .word-be {
                font-size: clamp(0.75rem, 4vw, 1rem);
                transform: translateX(-0.9rem);
            }

            .word-unconventional {
                font-size: clamp(0.95rem, 6.2vw, 1.3rem);
            }

            .word-hq {
                font-size: clamp(0.85rem, 5.5vw, 1.25rem);
                margin-top: -0.4rem;
                transform: translateX(0.9rem);
            }

            .hero-subtitle {
                font-size: 0.6rem;
                letter-spacing: 0.08em;
            }

            .pitch-container {
                flex-direction: column;
                align-items: flex-start;
                gap: 1rem;
            }

            .headshot-placeholder {
                width: 5rem;
                height: 5rem;
            }

            .pitch {
                height: auto;
                margin-left: 0;
                padding-left: 0;
                border-left: none;
                font-size: 0.7rem;
                text-align: left;
            }

            .metrics-grid,
            .split-section {
                grid-template-columns: 1fr;
                gap: 1rem;
            }

            .metric-value {
                font-size: 2.1rem;
            }

            .metric-label {
                font-size: 0.7rem;
            }

            .mini-platform-grid {
                grid-template-columns: repeat(3, 1fr) !important;
                gap: 0.4rem !important;
            }

            .data-label {
                white-space: normal;
                font-size: 0.65rem;
            }

            .data-value {
                font-size: 0.75rem;
            }

            .data-list li {
                font-size: 0.75rem;
            }

            .capabilities-list li {
                white-space: normal;
                font-size: 0.75rem;
            }

            .gear-grid {
                grid-template-columns: repeat(2, 1fr) !important;
                gap: 1rem !important;
            }

            /* Two columns here, so the left-hand column is items 1 and 3. */
            .gear-col:nth-child(odd) {
                border-left: none;
                padding-left: 0;
            }

            .footer {
                grid-template-columns: 1fr !important;
                gap: 0.75rem;
            }

            .footer-logo {
                width: 2in;
                height: 0.65in;
            }

            /* A viewport-fixed vertical stack over an 816px canvas overlaps
               content the instant that canvas shrinks to fit a phone.
               Collapse to a bottom action bar instead - anchored to the
               screen edge, never floating over content. Order is fixed: Download
               PDF, then the sibling one-sheet, then the collaborations hub,
               then the site. See the .action-fab rule for why it is one
               column per row on this breakpoint. */
            .fab-container {
                top: auto;
                bottom: 0;
                left: 0;
                right: 0;
                transform: none;
                display: grid;
                grid-template-columns: 1fr;
                width: 100%;
                gap: 0.4rem;
                padding: 0.6rem 0.75rem;
                padding-bottom: calc(0.6rem + env(safe-area-inset-bottom, 0px));
                background: rgba(10, 10, 10, 0.95);
                border-top: 1px solid var(--accent-red);
            }

            /* One column, not two. Measured in Syne 800 at this size,
               COLLABORATIONS needs 165px and RETURN TO SITE 148px, against a
               half-column content box of 163px at 390px wide, 148px at 360px
               and 128px at 320px - so the long labels wrapped to two lines,
               which the two-up layout then had to stretch its neighbour to
               match. Full width gives every label 278px even on a 320px
               screen. The tighter padding buys the fourth row back: this bar
               is about the same height as the old two-row one. */
            .fab-container .action-fab {
                width: auto;
                padding: 0.6rem 0.5rem;
                font-size: 0.6rem;
                border-radius: 8px;
            }
        }

    </style>
</head>
<body class="mk-body" style={`--bgUrl: url('${optimizedBg.src}')`}>
    <div class="page">
        <div class="container">
        
        <!-- 1. Header Section -->
        <div class="header" style="justify-content: center; border-bottom: none; padding-bottom: 0;">
            <div class="header-text">
                <p class="hero-kicker">Where nerd culture gets cinematic</p>
                <h1 class="hero-title-stack">
                    <span class="word-be">Be</span>
                    <span class="word-unconventional">Unconventional</span>
                    <span class="word-hq">HQ</span>
                </h1>
                <p class="hero-subtitle">Stories craft and culture through a different lens</p>
            </div>
        </div>

        <!-- 2. Elevator Pitch with Headshot -->
        <div class="pitch-container">
            <div class="headshot-placeholder"></div>
            <div class="pitch">
                BE Unconventional HQ is an independent outlet covering film, television, games, and creator culture through a cinematic editorial lens. Coverage spans reviews and criticism, industry and business analysis, and on-location premiere and convention reporting. Editorial decisions are made independently, and all provided materials are disclosed.
            </div>
        </div>

        <!-- 3. Coverage -->
        <div>
            <h2 class="section-title">COVERAGE</h2>
            <div class="metrics-grid">

                <div class="metric-card" style={`--cardArt: url('${filmArt.src}')`}>
                    <div class="metric-value">FILM</div>
                    <div class="metric-label">Reviews &amp; Criticism</div>
                </div>

                <div class="metric-card" style={`--cardArt: url('${tvArt.src}')`}>
                    <div class="metric-value">TV</div>
                    <div class="metric-label">Streaming &amp; Seasons</div>
                </div>

                <div class="metric-card" style={`--cardArt: url('${gamesArt.src}')`}>
                    <div class="metric-value">GAMES</div>
                    <div class="metric-label">Coverage &amp; Analysis</div>
                </div>

