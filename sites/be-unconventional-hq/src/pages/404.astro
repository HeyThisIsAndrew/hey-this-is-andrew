---
import { SECTIONS, MESSAGES, LABELS, META, pageTitle } from '../data/content.js';
import Layout from '../layouts/Layout.astro';
import PageTitle from '../components/PageTitle.astro';
import Button from '../components/Button.astro';

const title = pageTitle(META.notFound.title);
const description = META.notFound.description;
---

<Layout title={title} description={description}>
  <main class="notfound-page">
    <div class="notfound-inner">
      <span class="notfound-code" aria-hidden="true">404</span>
      <PageTitle as="h1" {...SECTIONS.notFound} />
      <p class="notfound-text">{MESSAGES.notFoundBody}</p>
      <div class="notfound-actions">
        <Button href="/">{LABELS.backHome}</Button>
        <a class="notfound-link" href="/feed">{LABELS.browseFeed} &rarr;</a>
      </div>
    </div>
  </main>
</Layout>

<style>
  .notfound-page {
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 6rem 1.5rem;
  }

  .notfound-inner {
    max-width: 640px;
  }

  .notfound-code {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(4rem, 18vw, 9rem);
    font-weight: 800;
    line-height: 1;
    color: var(--color-accent-text);
    letter-spacing: 0.05em;
    margin-bottom: 1rem;
  }

  .notfound-text {
    font-family: var(--font-body);
    color: var(--color-white-muted);
    font-size: 1.05rem;
    line-height: 1.6;
    margin: 1.5rem auto 2.5rem;
    max-width: 32rem;
  }

  .notfound-actions {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    align-items: center;
  }

  .notfound-link {
    position: relative;
    color: var(--color-white);
    text-decoration: none;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    padding-bottom: 4px;
    transition:
      color 0.3s ease,
      text-shadow 0.3s ease;
  }

  .notfound-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 1px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s cubic-bezier(0.25, 0.8, 0.2, 1);
  }

  .notfound-link:hover {
    color: var(--color-accent-text);
    text-shadow: 0 0 16px rgba(204, 0, 0, 0.5);
  }

  .notfound-link:hover::after {
    transform: scaleX(1);
  }
</style>
