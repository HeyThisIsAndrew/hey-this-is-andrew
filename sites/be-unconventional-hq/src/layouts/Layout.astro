---
import '../styles/global-base.css';
import '../styles/global.css';
import '../styles/theme-red.css';
import CommandPalette from '@andrew/ui/CommandPalette.astro';
import Footer from '../components/Footer.astro';
import Navbar from '../components/Navbar.astro';
import BrandGlow from '../components/BrandGlow.astro';
import VideoDebugOverlay from '../components/VideoDebugOverlay.astro';
import InAppEscape from '../components/InAppEscape.astro';
import { site } from '../data/site.js';
import { ClientRouter } from 'astro:transitions';
import { PUBLIC_TURNSTILE_SITE_KEY } from 'astro:env/client';
import logoImage from '../assets/logo.webp';
import logoMark from '../assets/logo-mark.webp';
import { getImage, Font } from 'astro:assets';
import { SOCIAL_ICONS } from '../data/icons.js';
/* Cache-buster for the tab and home-screen icons (see the note at the icon links). */
const ICON_VERSION = 2;

/* The org logo a crawler is told to fetch. `logoImage.src` is never emitted
   when compile-time image optimization is on — see the note in ContentCard. */
const organizationLogoSrc = (await getImage({ src: logoImage, width: 512, format: 'webp', quality: 80 })).src;

const {
  title = site.name,
  description = site.description,
  image = site.image,
  type = 'website',
  // Opt-in gate for work-in-progress or draft routes. When true, we emit a
  // robots meta directive that tells search engines not to index the page or
  // follow its links. Keep the default false so existing production pages are
  // unaffected.
  noindex = false,
  prevUrl,
  nextUrl,
  preloadImage,
  preloadImageSrcset,
  preloadImageSizes,

  /*
    Origins to warm before the browser discovers it needs them. Opt-in per
    page rather than global, because a preconnect to an origin a page never
    uses is a wasted TCP+TLS handshake — /, /feed and /about reference zero
    Sanity assets and must not pay for one.

    This exists because /events sat ~10 points below every other page on the
    Lighthouse gate and its LCP element is a cdn.sanity.io image. Nothing on
    the site preconnected anywhere, so that image could not even begin
    downloading until DNS, TCP and TLS had all completed against a cold
    origin — roughly three round trips, and the gate models a 150ms RTT.

    The correlation across the gate's five pages is hard to read any other
    way: /events carries 16 Sanity references and scored 88%, /featured
    carries 4 and scored 95%, and the three pages with none scored 97-98%.
  */
  preconnect = [],
} = Astro.props;

// Self-referential canonical URL: absolute, no trailing slash (except root)
// to match Cloudflare's asset html_handling: "drop-trailing-slash"
// (wrangler.jsonc) — every internal link already points to the no-slash
// form, and drop-trailing-slash serves that directly while redirecting
// the slashed form away, so the canonical tag has to agree or it points
// at a URL that immediately redirects elsewhere. og:url reuses the same
// value so search engines never see a page advertise two different
// addresses for itself.
const canonicalPath =
  Astro.url.pathname === '/' || !Astro.url.pathname.endsWith('/')
    ? Astro.url.pathname
    : Astro.url.pathname.slice(0, -1);
const url = Astro.props.url ?? new URL(canonicalPath, site.url).toString();
const isHomePage = Astro.url.pathname === '/';

// Sitewide structured data: tells search engines who this brand is and
// which social accounts are officially ours. Per-page Article/VideoObject
// schema is layered on separately. SearchAction is intentionally omitted
// until on-site search exists.
const orgId = `${site.url}#organization`;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': orgId,
      name: site.name,
      url: site.url,
      logo: new URL(organizationLogoSrc, site.url).toString(),
      description: site.description,
      sameAs: [
        site.socials.youtube,
        site.socials.instagram,
        site.socials.tiktok,
        site.socials.threads,
        site.socials.facebook,
        site.socials.twitter,
        site.socials.letterboxd,
        site.socials.substack,
      ].filter(Boolean),
    },
    {
      '@type': 'WebSite',
      '@id': `${site.url}#website`,
      name: site.name,
      url: site.url,
      description: site.description,
      publisher: { '@id': orgId },
    },
  ],
};

const disableAnalytics = import.meta.env.PUBLIC_DISABLE_ANALYTICS === 'true';
const gtmId = disableAnalytics ? undefined : import.meta.env.PUBLIC_GTM_ID;

/*
  The brand mark used behind any card that has no usable cover image.

  Put through getImage() rather than referenced straight from src/assets:
  logo-mark.webp is 414 KB at source, and a raw `url()` in a stylesheet is
  copied by the bundler WITHOUT being resized. It is drawn at ~120px, so it
  is requested here at 240 (2x) and comes out a few KB.

  Exposed as a custom property so the stylesheets can use it in a
  `background-image`. That keeps the fallback CSS-only: it has to work both
  for cards that never had an image (no <img> in the DOM at all) and for
  cards whose image turned out to be unusable (marked `data-img-failed` by
  the fail-safe in this file), and only a background covers both without
  injecting an element into every card on the page.

  One URL, so it is fetched once and cached — and only ever fetched at all if
  some card on the page actually falls back.
*/
const fallbackMark = await getImage({
  src: logoMark,
  width: 240,
  format: 'webp',
  quality: 70,
});
---

<html lang="en">
  <head>
    {/* Must be the FIRST thing in <head>. The spec requires the encoding
        declaration inside the first 1024 bytes, and Lighthouse fails the page
        otherwise. It used to sit below the GTM and view-transition blocks,
        which put it at byte 1536: ClientRouter alone emits two meta tags plus
        a module script before anything else got a chance to render. */}
    <meta charset="utf-8" />
    <meta name="robots" content="max-image-preview:large" />
    {/* Which commit this page was built from, so the deploy workflow can
        PROVE production updated (.github/workflows/deploy.yml). Set only by
        that workflow's build (PUBLIC_BUILD_SHA); absent elsewhere. A build
        stuck in Cloudflare's queue left the live site on a pre-merge version
        with nothing anywhere saying so. */}
    {import.meta.env.PUBLIC_BUILD_SHA && <meta name="build-sha" content={import.meta.env.PUBLIC_BUILD_SHA} />}
    {/*
      ─── BEFORE ANY SCRIPT THAT MEASURES THE VIEWPORT ───────────────────────
      This used to sit ~100 lines further down, after the inline script that
      seeds `--vv-height`. That script reads visualViewport.height, and until
      this tag is parsed a mobile browser is still laying out at its default
      desktop-ish viewport — so the measurement was taken against a viewport
      the page never actually renders at.

      Nothing depended on it while the hero was sized in `lvh`. The moment the
      hero was sized FROM the measurement, the hero painted at one height and
      resized to another, and Lighthouse recorded CLS 0.69 on the homepage
      with `.hero-bg-gradient` (inset 0 inside `.hero-bg`, itself inset -10%
      off `.hero`) as the single shifting element. Performance 97% to 73%.

      Keep this above the seed script. Everything that measures the viewport
      before first paint depends on it.
    */}
    <meta name="viewport" content="width=device-width, initial-scale=1, interactive-widget=resizes-content" />
    {/*
      NO `fetchpriority` HERE. Astro's <Font> destructures exactly
      `{ cssVariable, preload }` (node_modules/astro/components/Font.astro) and
      emits a fixed `<link rel="preload" as="font" type=... crossorigin>`. Any
      other prop is dropped on the floor, and passing one is a ts(2322) against
      a 0-error baseline -- it was sitting in this file as an error rather than
      as an optimisation.

      It would not have bought anything either. The premise was that the fonts
      lose a race to the Partytown third parties; measured in the built
      document, the two font preloads are at bytes 687 and 1300 -- the first
      two resources in the head -- against partytown at 7892, GTM at 8145,
      facebook at 10539 and clarity at 190123. They already win by four
      screenfuls of markup, and browsers fetch font preloads at high priority
      regardless.
    */}
    {/*
      ─── ONLY THE HEADLINE FACE IS PRELOADED ───────────────────────────────
      Inter (47 KiB) used to be preloaded too. On a phone the two preloads are
      82 KiB fetched at high priority from the first 200ms, which is exactly
      when the homepage's LCP image is downloading, and on Slow 4G they split
      the bandwidth with it: measured under DevTools throttling, the 29 KiB
      hero art took ~1.1s to arrive. Without the Inter preload the same image
      lands ~340ms sooner (real LCP 1.44s -> 1.10s, median of 5), Syne (the
      hero headline) arrives ~300ms EARLIER than before, and Inter follows
      ~150ms later than it used to, straight after the first style pass. The
      fallback faces carry metric overrides, so the swap moves nothing (CLS 0).

      Do not drop Syne's preload as well to chase more: removing both was
      faster still for a real phone but Lighthouse's simulation charged ~440ms
      to FCP for it, because it models the late-discovered font as blocking.
    */}
    <Font cssVariable="--font-display" preload={true} />
    <Font cssVariable="--font-body" preload={false} />
    {/*
      The hashed URL of the fallback brand mark, handed to CSS. A stylesheet
      cannot read Astro frontmatter, and the filename carries a content hash,
      so a custom property is how the two meet. Declaring it does not fetch
      anything — only a rule that actually paints it will.
    */}
    <style is:inline set:html={`:root{--brand-fallback-mark:url("${fallbackMark.src}")}`}></style>
    <ClientRouter />
    <script is:inline>
      document.documentElement.classList.add('js');

      /*
        ─── A BIG MONITOR IS A PROPERTY OF THE MONITOR, NOT OF THE WINDOW ────

        The root font ladder in global-base.css steps on WINDOW width, and
        window width cannot tell a 4K panel from a 1080p one. Half of a 3840px
        monitor is a 1920px window, byte for byte identical to a maximised
        window on a 1080p screen, so it took the 90% rung and rendered at
        14.4px -- on a display whose pixels are half the physical size. The
        report was that the 4K problem "is also present when the site is
        occupying half of the 4K monitor", and it was right: nothing in CSS
        could see the difference.

        `screen.width` can. It reports the panel, not the window: measured
        3840 while `innerWidth` was 1920. So it is read once here and published
        as an attribute the stylesheet can branch on.

        INLINE AND FIRST, for the same reason `--vv-height` is seeded inline
        further down: this changes the root font size, so a class arriving
        after first paint would reflow the entire page and charge it to CLS.

        Plain ES5, no TypeScript syntax: an `is:inline` script is shipped to
        the browser exactly as written and is never stripped, so a type
        annotation here is a SyntaxError that takes the whole file down.
      */
      try {
        if (window.screen && screen.width >= 3400) {
          document.documentElement.setAttribute('data-screen-4k', '');
        }
      } catch (e) {}

      /*
        ─── THE REVEAL WATCHDOG ──────────────────────────────────────────────

        `.animate-on-scroll` / `.reveal` ship content at `opacity: 0` and are
        revealed from a bundled module (initReveal, further down this file).
        If that module has not executed, the content is not slow: it is
        invisible, with nothing on screen to say so.

        Reported from an iPhone as the homepage rendering the heading
        "EXPLORE THE HQ / WHAT WE COVER" over a black section, and the navbar
        not responding to taps. It cleared on its own after a while and did
        not come back once the phone was charged. The markup and the CSS were
        never wrong: the phone was in Low Power Mode on a minutes-old build,
        so nothing was warm in the CDN or the device cache, and the module
        had simply not run yet.

        The `.js` class above cannot catch that — it was set, because THIS
        script is inline in the document and always runs. Only a timer can:
        initReveal sets a flag when it actually runs, and if it has not
        signed in by the deadline the content is un-gated by the rule in
        utilities.css.

        Deliberately generous. A healthy load runs it well inside a second
        (they fire on astro:page-load); a slow one that trips this loses its
        entrance animation and shows the content, which is the right way
        round.
      */
      window.setTimeout(function () {
        var root = document.documentElement;
        /* Only on a page that actually has revealable content, so the class
           stays a diagnostic rather than something set everywhere. */
        if (!window.__hqRevealReady && document.querySelector('.animate-on-scroll, .reveal')) {
          root.classList.add('reveal-failsafe');
        }
      }, 5000);

      if ('scrollRestoration' in history) {
        history.scrollRestoration = 'manual';
      }

      /*
        ─── THE HERO'S HEIGHT IS MEASURED, NOT GUESSED ───────────────────────

        `--vv-height` is the viewport height as it ACTUALLY is right now.
        landscape.css sizes the hero from it.

        WHY A MEASUREMENT AND NOT A VIEWPORT UNIT. Every static unit is a
        guess about the browser chrome, and each one is wrong half the time:

          svh  = smallest (chrome expanded). Arrive with the chrome already
                 retracted — which is what happens when you scrolled on the
                 previous page — and the hero is SHORTER than the screen, so
                 "EXPLORE THE HQ / WHAT WE COVER" shows underneath it.
          lvh  = largest (chrome retracted). Arrive with the chrome expanded
                 and the hero is TALLER than the screen, so its centred
                 content is pushed down out of position.
          dvh  = always correct, but re-resolves during scroll, resizing the
                 hero and forcing the blurred `.hero-bg` to re-rasterize.
                 That is the jitter hero.css rejects at length.

        Both static failures were photographed on the same device, one per
        unit. There is no third static unit to try.

        A measurement has none of those problems: it is the real height in
        whatever chrome state the reader is actually in.

        SET HERE, INLINE, BEFORE FIRST PAINT. The homepage layout is sized
        from it (home.css), so this cannot wait for a module to load or the
        page would paint once at the fallback height and then resize.

        UPDATED ONLY ON ROTATION, never on scroll — see viewport-anchor.ts.
        That is what keeps it jitter-free: it behaves like a fixed value per
        orientation, the same property `svh`/`lvh` have and `dvh` lacks, while
        being the RIGHT fixed value rather than a guess at one.
      */
      (function () {
        var vv = window.visualViewport;
        var root = document.documentElement.style;
        /* Rounded, and --vv-top seeded, to match EXACTLY what
           src/lib/viewport-anchor.ts publishes after load. Any difference
           (a fractional height on a 2.625x Android screen, or --vv-top not
           yet set) made that module rewrite a custom property on <html>
           after first paint, which restyles every element on the page. */
        var h = Math.round((vv && vv.height) || window.innerHeight);
        if (h > 0) root.setProperty('--vv-height', h + 'px');
        root.setProperty('--vv-top', Math.max(0, Math.round((vv && vv.offsetTop) || 0)) + 'px');
      })();
    </script>
    {/*
      GTM IS NOT LOADED HERE. Cloudflare's Google tag gateway injects the
      container (GTM-PDDF3D6K) into every HTML response on production and
      serves it first-party from /nlsh (see public/_routes.json). This file
      used to load a second copy through Partytown, and the two ran side by
      side: TikTok reported "Duplicate Pixel ID", and the Partytown copy was
      fetched through /api/proxy, which kept serving a container version
      Google had already replaced, so a GA4 ID fix never reached visitors.
      Do not add a gtm.js snippet back while the gateway is on.
      scripts/gtm-single-loader.test.mjs guards this.

      Consequence: local dev and preview load no GTM at all, and turning the
      gateway off in Cloudflare turns tracking off.

      THE gtm.js START EVENT IS OURS TO SEND. It is the first half of Google's
      standard snippet; the gateway (with "Set up tag" off) injects only the
      loader, not this push. Without it GA4 never loads: measured on
      production, the Google tag registered G-FWG8KL9Z5M as a bootstrap stub,
      page_view sat in the dataLayer, and no hit left the page, while TikTok
      and Meta fired normally. Pushing it made GA4 send one hit per page.
    */}

    <!-- Google Tag Manager: start event, and page_view for every navigation -->
    {gtmId && (
      <script is:inline>
        if (typeof window !== 'undefined') {
          if (!window['setup']) {
            window['setup'] = true;
            window.dataLayer = window.dataLayer || [];
            
            // Wait for window.load before pushing gtm.start so marketing pixels
            // (Meta, TikTok, Clarity) do not block the critical rendering path.
            window.addEventListener('load', function() {
              window.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
            });

            // ClientRouter swaps pages without full reloads, so this script only
            // runs once per session. astro:page-load fires on the initial load
            // AND after every client-side navigation — the GA4 tag in the GTM
            // dashboard triggers on this event (not "All Pages") to avoid
            // double-counting the first view.
            document.addEventListener('astro:page-load', function () {
              const pushGA = () => {
                window.dataLayer = window.dataLayer || [];
                window.dataLayer.push({
                  event: 'page_view',
                  page_location: window.location.href,
                  page_path: window.location.pathname,
                  page_title: document.title,
                });
              };
              // The timeout matters: without one a busy or hidden page never
              // goes idle, and the view is not counted until it does.
              if ('requestIdleCallback' in window) {
                requestIdleCallback(pushGA, { timeout: 2000 });
              } else {
                setTimeout(pushGA, 200);
              }
            });
          }
        }
      </script>
    )}

    <meta name="theme-color" content="#000000" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {prevUrl && <link rel="prev" href={prevUrl} />}
    {nextUrl && <link rel="next" href={nextUrl} />}
    {preloadImage && <link rel="preload" as="image" href={preloadImage} imagesrcset={preloadImageSrcset || undefined} imagesizes={preloadImageSizes || undefined} fetchpriority="high" />}

    {/*
      Both hints, deliberately. `preconnect` opens the connection; the
      `dns-prefetch` beside it is the fallback for browsers that ignore or
      drop the preconnect under memory pressure, and it costs a DNS lookup
      that was going to happen anyway.

      ─── NO `crossorigin` HERE, AND THE RULE IS THE OPPOSITE OF WHAT THIS
          NOTE USED TO SAY ────────────────────────────────────────────────

      It read: "`crossorigin` is required on the preconnect for image origins
      — an anonymous-CORS image fetch uses a different connection pool than a
      credentialed one". The premise is right and the conclusion is backwards.
      A plain `<img src>` with NO `crossorigin` attribute is not an
      anonymous-CORS fetch: it goes out on the ordinary credentialed pool.
      `<link rel="preconnect" crossorigin>` warms the ANONYMOUS pool, so it
      warmed a socket none of these images would ever reuse.

      Not a theory. PageSpeed Insights on the live homepage reported it
      directly, under Preconnected origins:

          https://wsrv.nl   "Unused preconnect. Check that the `crossorigin`
                             attribute is used properly."

      and then listed the same origin under Preconnect candidates with an
      estimated LCP saving of 320ms — the hint was being paid for and
      discarded in the same breath.

      Every consumer of this prop is a plain `<img>`: wsrv.nl on `/` and
      cdn.sanity.io on `/events`, neither of which carries a `crossorigin`
      attribute. If an origin is ever added here whose fetches ARE
      anonymous-CORS (a font, a `fetch()`, an `<img crossorigin>`), it needs
      its own preconnect WITH the attribute — the two pools are separate and
      one tag cannot warm both. Astro's `<Font preload>` already emits its own
      correctly-credentialed preload for the font files, which is why nothing
      here has to.
    */}
    {preconnect.map((origin: string) => (
      <>
        <link rel="preconnect" href={origin} />
        <link rel="dns-prefetch" href={origin} />
      </>
    ))}
    <link rel="canonical" href={url} />
    {/* Feed discovery. Publisher Center takes the URL by hand, but this is how
        every other reader and crawler finds it, and it costs one tag. */}
    <link rel="alternate" type="application/rss+xml" title={`${site.name} — articles`} href={new URL('/rss.xml', site.url).toString()} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
    {/* Per-page <head> additions, e.g. an article's Article JSON-LD. Renders
        nothing when unused, so existing pages are unaffected. */}
    <slot name="head" />
    {/*
      ─── ICON ORDER IS LOAD-BEARING ON SAFARI ────────────────────────────────

      REPORTED, WITH A SCREENSHOT: on iPad, after pressing "See more on
      Instagram" in the carousel rail, the tab strip paints INSTAGRAM's glyph
      next to this site's own tab — title and URL still ours — and it stays
      wrong until a full reload.

      The links themselves were never the problem. Every Instagram link on the
      site already carries `target="_blank" rel="noopener noreferrer"`, and the
      icon <link> set is provably identical before and after the navigation.
      Nothing overwrites this document's metadata.

      What was wrong is which icon Safari can actually USE. The SVG was
      declared FIRST. Safari's support for `rel="icon"` with `image/svg+xml`
      is unreliable on iOS/iPadOS — it accepts the declaration and then may
      fail to produce a rasterised tab icon from it. A tab with no icon it can
      paint does not go blank; it keeps painting whatever it last resolved,
      and a `_blank` open to Instagram is exactly how a foreign icon gets into
      that slot. A hard reload re-runs resolution from scratch, finds the .ico,
      and the crown comes back — which is precisely the reported behaviour.

      So the raster .ico is declared FIRST, with an explicit `sizes`, and the
      SVG second. This is the standard ordering for this exact reason: engines
      that genuinely support SVG icons still prefer the SVG (it is the more
      specific later match once `type` is honoured), while Safari lands
      deterministically on a bitmap it is guaranteed to be able to draw.

      Do not put the SVG back on top to "prefer the vector". The vector is
      still preferred everywhere that can use it.

      NOT VERIFIABLE HERE: there is no WebKit in the build sandbox, and
      Chromium resolves either ordering correctly, so this cannot be shown to
      fix the iPad symptom from CI. `scripts/e2e-favicon.test.mjs` holds the
      part that IS checkable — that a usable raster icon is declared before
      any SVG-only icon, and that the whole set survives client-side
      navigation, back-navigation and opening a tile in a new tab.
    */}
    {/*
      `?v=` is a cache-buster, not decoration. Safari keeps a tab icon it has
      already resolved for a site, including a FOREIGN one (a red Marvel "M"
      was reported on the production tab while a fresh preview domain showed
      the crown). A new URL is a new icon to Safari, so it fetches the real
      one again. Bump ICON_VERSION whenever the icon art changes.
    */}
    <link rel="icon" href={`/favicon.ico?v=${ICON_VERSION}`} sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href={`/favicon.svg?v=${ICON_VERSION}`} />
    {/*
      Home-screen / web app tile art (issue #66).

      Cut from src/assets/logo-mark.webp — the PRE-CROPPED mark — not logo.webp.
      logo.webp is a 2000x2000 square whose artwork fills only ~42% of the
      height, so scaling it into a 180px tile spent most of those pixels on
      transparent padding and rendered the wordmark tiny and soft. Same
      reasoning as ArticleThumb.astro.

      Flattened onto black rather than left transparent: iOS composites an
      unknown background behind a transparent icon, which on a light wallpaper
      put a black wordmark on near-white. 180x180 is the size iOS requests;
      it downsamples cleanly for the smaller slots.
    */}
    <link rel="apple-touch-icon" sizes="180x180" href={`/apple-touch-icon.png?v=${ICON_VERSION}`} />
    <meta name="apple-mobile-web-app-title" content={site.name} />
    <meta name="msapplication-TileColor" content="#000000" />
    <meta name="msapplication-TileImage" content={`/apple-touch-icon.png?v=${ICON_VERSION}`} />
    <title>{title}</title>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:url" content={url} />
    <meta property="og:type" content={type} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
  </head>
  <body transition:animate="none">
    {/* In-app-browser escape hatch (#198). Styling and behaviour live in the
        component: it owns a fixed banner, an Android button instead of an
        automatic redirect, and an `astro:page-load` binding so it survives
        the view transitions <ClientRouter /> performs. */}
    <InAppEscape />

    {/* Site-wide brand signature. Decorative, fixed, behind all content —
        see src/components/BrandGlow.astro for the performance reasoning. */}
    <BrandGlow />

    {/*
      ─── WHICH WAY IS THIS NAVIGATION GOING ──────────────────────────────────

      The nav bar is an ORDER, not a set: Feed, Intel, Events, Featured, About.
      Moving rightward along it should look like moving rightward. This stamps
      the direction on <html> before the swap, and global-base.css turns that
      into the slide.

      `is:inline` and not a module: it has to be listening before the FIRST
      navigation, and `astro:before-preparation` fires early enough that a
      deferred module can miss it.

      The direction is copied onto the INCOMING document in `before-swap`,
      because the swap replaces <html>'s attributes along with everything else
      — set it only on the outgoing one and it is gone by the time the
      animation runs.
    */}
    <script is:inline>
      (function () {
        var NAV_ORDER = ['/', '/feed', '/intel', '/events', '/featured', '/about'];

        function indexOfRoute(pathname) {
          var clean = pathname.replace(/\/+$/, '') || '/';
          var exact = NAV_ORDER.indexOf(clean);
          if (exact !== -1) return exact;
          /* A sub-route belongs to its section: /intel/some-article is Intel,
             so moving to it from Feed still reads as going right. */
          var section = '/' + clean.split('/')[1];
          var prefix = NAV_ORDER.indexOf(section);
          return prefix !== -1 ? prefix : NAV_ORDER.length;
        }

        /*
          A paginated route's page number, so /events and /events/2 can be
          recognised as the same place.
        */
        function baseOf(pathname) {
          return pathname.replace(/\/+$/, '').replace(/\/\d+$/, '') || '/';
        }

        function directionFor(fromPath, toPath, fromHash, toHash) {
          /* Same page: a hash, a filter, a spotlight swap. Not a journey. */
          if (fromPath === toPath) return 'none';

          /*
            PAGING A LIST IS NOT TRAVELLING ANYWHERE.

            /events -> /events/2 is the same page showing the next tiles, but it
            is a real navigation, so it drove the full page transition and slid
            the entire document sideways — header and all — to change a grid
            halfway down it.

            `page-rows` animates only the element that actually changed. The
            page holds still.
          */
          if (baseOf(fromPath) === baseOf(toPath)) return 'page-rows';

          /*
            A LINK THAT NAMES A SECTION GOES DOWN, NOT SIDEWAYS.

            The "What We Cover" tiles point at /feed#film, /feed#tv, /feed#games.
            Along the nav that is one step right, so it slid sideways — and then
            the feed scrolled down to the row. Two motions, two axes, reported as
            "way too jarring".

            Arriving at an anchor is a descent into the page, so it moves down.
            Leaving one moves back up. This is checked before the nav order
            because it is the more specific thing the link is saying.
          */
          if (toHash) return 'dive-down';
          if (fromHash) return 'dive-up';

          /*
            INTEL FILTERS ARE IN-PLACE CROSSFADES, NOT SPATIAL NAVIGATION.
            Navigating between /intel and /intel/topic/* changes the grid, not
            the depth of the page. It must crossfade in place ('none') rather
            than sliding sideways like an article descent.
          */
          var isIntelFilter = function(p) {
            return p === '/intel' || p === '/intel/' || p.indexOf('/intel/topic/') === 0;
          };
          if (isIntelFilter(fromPath) && isIntelFilter(toPath)) {
            return 'none';
          }

          var from = indexOfRoute(fromPath);
          var to = indexOfRoute(toPath);

          /* Within one section, depth decides: /intel -> /intel/<slug> is
             going deeper, and coming back out is going back. */
          if (from === to) {
            if (toPath.indexOf(fromPath) === 0) return 'slide-forward';
            if (fromPath.indexOf(toPath) === 0) return 'slide-backward';
            return 'slide-forward';
          }

          return from < to ? 'slide-forward' : 'slide-backward';
        }

        document.addEventListener('astro:before-preparation', function (event) {
          var direction;
          /* Back and Forward mean what the button says, whatever the nav order
             is — a reader pressing Back expects to go back. */
          if (event.navigationType === 'traverse') {
            /* Back out of an anchor the way you went in: if either end of the
               traverse names a section, it is the same descent in reverse. */
            if (event.from.hash && !event.to.hash) direction = 'dive-up';
            else if (!event.from.hash && event.to.hash) direction = 'dive-down';
            else direction = event.direction === 'back' ? 'slide-backward' : 'slide-forward';
          } else {
            direction = directionFor(
              event.from.pathname,
              event.to.pathname,
              event.from.hash,
              event.to.hash,
            );
          }
          document.documentElement.dataset.pageTransition = direction;
        });

        /*
          PAGING A LIST MUST NOT MOVE THE READER.

          Astro resets scroll to the top on navigation. For a page-rows move
          that is wrong twice over: the reader was looking at the list, and any
          animated snapshot of it gets replayed at the top of the screen,
          because a view transition positions its snapshots against the VIEWPORT
          rather than the element's place in the document. That is what drew the
          outgoing tiles over the hero.

          So the position is captured before the swap and put back after it. The
          list then updates under the reader's eyes, where it already was.
        */
        var rowsPending = false;

        document.addEventListener('astro:before-swap', function (event) {
          var direction = document.documentElement.dataset.pageTransition;
          if (direction) event.newDocument.documentElement.dataset.pageTransition = direction;
          /* A FLAG, NOT AN OFFSET. This captured window.scrollY and put it back
             after the swap, which is what threw the reader to the bottom of a
             shorter page. All the swap needs to know is that a pagination
             happened; where to land is decided from the list itself below. */
          rowsPending = direction === 'page-rows';
        });

        document.addEventListener('astro:after-swap', function () {
          if (!rowsPending) return;
          rowsPending = false;
          /* Two frames: Astro's own scroll reset lands after the swap, so a
             single rAF puts this back before it and is immediately undone. */
          requestAnimationFrame(function () {
            requestAnimationFrame(function () {
              /*
                ─── LAND ON THE LIST, DO NOT RESTORE AN OFFSET ───────────────

                This put back the exact `scrollY` captured before the swap, on
                the theory that the list should update under the reader's eyes
                where it already was. That is true only while both pages are
                the same height.

                They are not. The last page of a paginated list is usually
                shorter, so an offset that was mid-list on page 1 is past the
                end of page 2, and the browser clamps it to the bottom of the
                document. Reported as: press Next and get thrown to the footer.

                Even when it fits, restoring the offset leaves the reader
                looking at the BOTTOM of a list whose items all just changed.
                The top of the container is the honest answer to "show me the
                next page", and it is the same answer at every page height.
              */
              var target = document.querySelector('[data-rows-target]');
              if (target) target.scrollIntoView({ block: 'start', behavior: 'instant' });
              else window.scrollTo({ top: 0, behavior: 'instant' });
            });
          });
        });

        /* Cleared once the animation has run, so a later in-page change does
           not inherit the last navigation's direction. */
        document.addEventListener('astro:page-load', function () {
          setTimeout(function () {
            delete document.documentElement.dataset.pageTransition;
          }, 500);
        });
      })();
    </script>

