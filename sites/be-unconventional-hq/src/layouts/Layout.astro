    {/*
      NOT `is:inline` any more.

      This block needs `import`, and an inline script is copied verbatim into
      the HTML without going through the bundler, so imports are unavailable
      there. As a bundled module it can pull in the shared scroll-lock utility
      instead of carrying its own (broken) copy — see src/lib/scroll-lock.ts.

      Nothing here depends on running before paint: every listener below is
      delegated from `document`, so a deferred module attaches them long
      before any click can happen.
    */}
    <script>
      import { lockScroll, unlockScroll } from '../lib/scroll-lock';
      import { getYouTubeEmbedUrl } from '../lib/youtube-url';
      import { keepFixedControlsTappable, publishViewportHeight } from '../lib/viewport-anchor';
      import { initEmbedPause } from '../lib/embed-pause';
      import { initStageWatchLink } from '../lib/stage-watch-link';
      import { initStageItemTap } from '../lib/stage-item-tap';

      /* Every audible YouTube embed on the site pauses when the tab is hidden
         and resumes when it comes back. Reported as duplicate audio: opening a
         video in a NEW TAB from the homepage featured shelf left the shelf
         playing behind it. Mounted here because it is site-wide, and self
         guarded, so the page-load binding only re-sweeps for new frames. */
      initEmbedPause();
      document.addEventListener('astro:page-load', initEmbedPause);

      /* The event and hub stages' "Watch on YouTube" link. Mounted here for the
         same reason: three near-identical stages, one wiring, so it cannot land
         in two of them and look finished. Self-guarded. */
      initStageWatchLink();
      document.addEventListener('astro:page-load', initStageWatchLink);

      /* A tap on a stage pane's still or title runs that pane's own Play or
         Read control (the /feed and category heroes, hub pages, both event
         templates). Document-delegated and bound once. */
      initStageItemTap();

      /* Bound once, site-wide: iOS Safari leaves fixed elements hit-tested at
         stale coordinates after it resizes the web view (its landscape tab bar
         collapsing on scroll is the reported trigger). Self-guarded against
         double-binding, so calling it on every page load is safe. */
      keepFixedControlsTappable();
      document.addEventListener('astro:page-load', keepFixedControlsTappable);

      /*
        RE-SEED `--vv-height` ON EVERY NAVIGATION.

        It is an inline style on `<html>`, and ClientRouter swaps that
        element's attributes on a client-side navigation, which wipes it.
        Measured: `390px` on first load, `""` after navigating to /feed, still
        `""` after navigating back home — at which point the hero silently
        falls back to `100svh`, the guessed height this replaced.

        This has to be a SEPARATE call from the line above:
        `keepFixedControlsTappable()` is guarded by an "already bound" flag so
        its listeners attach once, which means every page load after the first
        returns before reaching anything. One property read and one write.
      */
      publishViewportHeight();
      document.addEventListener('astro:page-load', publishViewportHeight);

      /* The listeners below are attached to `document` once and must never be
         attached twice, so the "already bound" flags live on `window` rather
         than in module scope — module scope would reset if this script were
         ever re-evaluated, window will not. Declared here because a bundled
         script is type-checked, unlike the inline one this replaced. */
      declare global {
        interface Window {
          videoModalSetup?: boolean;
          videoModalEscSetup?: boolean;
          videoModalNavSetup?: boolean;
          /* The modal's opener, for a player that owns its own click handler
             (and so stops the delegated one below) but has to fall back to
             the modal: FeaturedHighlights when YouTube's API never loaded. */
          hqOpenVideo?: (videoId: string) => void;
        }
      }

      (function () {
        // Remembers what had focus before the modal opened, to restore it on
        // close instead of dropping keyboard users at the top of the page.
        let lastFocused: HTMLElement | null = null;

        function openModal(videoId: string) {
          const modal = document.getElementById('video-modal');
          const modalIframe = document.getElementById(
            'modal-iframe'
          ) as HTMLIFrameElement | null;

          if (videoId && modal && modalIframe) {
            if (modal.classList.contains('active')) return;

            // Save focus + trap it: inert the whole app wrapper (navbar,
            // content, footer), not just #page-content.
            lastFocused = document.activeElement as HTMLElement | null;

            /*
              Hold the page still. This replaces a hand-rolled lock that set
              `body.style.top` but left the scrollbar gutter uncompensated, so
              opening the modal shifted every desktop page sideways by the
              width of the scrollbar. The utility measures and pads that gap.
            */
            lockScroll();

            /*
              The escape hatch, pointed at THIS video, before the player is
              given a chance to refuse it. See the markup note: it is set
              unconditionally rather than in an error handler, so a reader is
              never trapped even if the refusal is never reported to us.

              youtube.com here, deliberately, NOT youtube-nocookie.com: this
              link leaves the site, and the whole point is to reach the one
              place an age-restricted video will actually play.
            */
            const watchLink = document.getElementById('modal-watch-on-youtube');
            if (watchLink) {
              watchLink.setAttribute(
                'href',
                `https://www.youtube.com/watch?v=${encodeURIComponent(videoId)}`,
              );
            }
            /* Reset the explanation: it belongs to the previous video until
               this one tells us otherwise. */
            const embedNote = document.getElementById('modal-embed-note');
            if (embedNote) embedNote.hidden = true;

            // ACTION 2.1 & 2.2: No autoplay, use rel=0 and modestbranding=1
            modalIframe.src = getYouTubeEmbedUrl(videoId);
            modal.classList.add('active');
            modal.setAttribute('aria-hidden', 'false');
            /* `inert` moves with aria-hidden: closed, the modal's Close button,
               frame and Watch link must not be reachable by Tab while a screen
               reader is told the modal is not there (axe aria-hidden-focus;
               the global QA sweep, rule 6). Removed BEFORE the focus below. */
            modal.removeAttribute('inert');
            document.getElementById('app-wrapper')?.setAttribute('inert', '');

            const closeBtn = modal.querySelector<HTMLElement>('.modal-close');
            if (closeBtn) setTimeout(() => closeBtn.focus(), 100);
          }
        }

        function closeModal() {
          const modal = document.getElementById('video-modal');
          const modalIframe = document.getElementById(
            'modal-iframe'
          ) as HTMLIFrameElement | null;

          if (modal && modalIframe) {
            /*
              Guard on THIS modal's own state, not on the global `modal-open`
              class. That class is set by whichever overlay is open — keying
              off it meant closing the video modal could release a lock the
              mobile menu or contact modal had taken.
            */
            if (!modal.classList.contains('active')) return;

            modal.classList.remove('active');
            modal.setAttribute('aria-hidden', 'true');
            modal.setAttribute('inert', '');
            document.getElementById('app-wrapper')?.removeAttribute('inert');
            // 'about:blank', NOT '' — an empty src resolves to the current
            // page URL, silently reloading the whole site inside the hidden
            // iframe on every close.
            modalIframe.src = 'about:blank';

            /*
              ─── THIS IS THE LAYOUT-SHIFT FIX ───────────────────────────────
              What was here before unpinned the body, then restored the scroll
              position inside a DOUBLE requestAnimationFrame. Those are two
              different frames: for ~32ms the body was already unpinned and
              back at offset 0, and the browser painted it there. That painted
              intermediate state IS the jump — the page visibly snapped to a
              different position and then slid back.

              unlockScroll() does both halves synchronously, in one frame, so
              there is never a paint at the wrong offset.
            */
            unlockScroll();

            /*
              `preventScroll: true` matters as much as the line above. Calling
              focus() on the card that opened the modal makes the browser
              scroll that element into view — which fought the restore and is
              why the landing position depended on WHICH video you had tapped,
              i.e. why the jump looked inconsistent rather than constant.
            */
            if (lastFocused && typeof lastFocused.focus === 'function') {
              lastFocused.focus({ preventScroll: true });
            }
            lastFocused = null;
          }
        }

        /*
          ─── WHEN YOUTUBE SAYS NO, SAY SO ─────────────────────────────────

          `enablejsapi=1` is already on the embed URL, which means the player
          will talk back over postMessage once something asks it to listen.
          The handshake is the `listening` message below; after it, the player
          posts its events, and `onError` is the one that matters here:

            2    the request contained an invalid parameter
            5    the video cannot be played in an HTML5 player
            100  the video is private, or has been removed
            101  the owner does not allow embedded playback
            150  the same as 101

          101/150 is what an age-restricted video reports, and it is the case
          that produced the trapped reader. Revealing the note turns a player
          that looks broken into one that explains itself and points at the
          link beside it.

          This is an ENHANCEMENT, not the fix. The "Watch on YouTube" link is
          set on every open regardless, because a detection that silently
          fails to fire would put the reader straight back in the trap. If
          YouTube ever changes this undocumented channel, the door still
          works and only the explanation is lost.
        */
        window.addEventListener('message', (event) => {
          /* Only the player's own origin, and only while its modal is open. */
          if (event.origin !== 'https://www.youtube-nocookie.com') return;

          const frame = document.getElementById('modal-iframe') as HTMLIFrameElement | null;
          if (!frame || event.source !== frame.contentWindow) return;

          let payload: any;
          try {
            payload = typeof event.data === 'string' ? JSON.parse(event.data) : event.data;
          } catch {
            return; // Not JSON, so not a player event. Nothing to do.
          }

          if (payload && payload.event === 'onError') {
            const note = document.getElementById('modal-embed-note');
            if (note) note.hidden = false;
          }
        });

        /*
          The handshake has to be sent AFTER the player document has loaded,
          which is why it hangs off the iframe's own load event rather than
          firing beside the `src` assignment. `about:blank` fires load too, so
          the src is checked before posting into it.
        */
        document.getElementById('modal-iframe')?.addEventListener('load', (event) => {
          const frame = event.currentTarget as HTMLIFrameElement;
          if (!frame.src.includes('youtube-nocookie.com')) return;
          frame.contentWindow?.postMessage(
            JSON.stringify({ event: 'listening', id: 1, channel: 'widget' }),
            'https://www.youtube-nocookie.com',
          );
        });

        window.hqOpenVideo = openModal;

        // Global Event Delegation for Video Triggers
        if (!window.videoModalSetup) {
          document.addEventListener('click', (e) => {
          if (!(e.target instanceof Element)) return;
          const trigger = e.target.closest('[data-action="open-video"]');
          
          if (trigger) {
            e.preventDefault();
              const videoId = trigger.getAttribute('data-video-id');
              if (videoId) openModal(videoId);
            }

            const currentModal = document.getElementById('video-modal');
            if (e.target === currentModal || e.target.closest('.modal-close')) {
              closeModal();
            }
          });
          window.videoModalSetup = true;
        }

        if (!window.videoModalEscSetup) {
          document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') closeModal();

            if (e.key === 'Enter' || e.key === ' ') {
              if (!(e.target instanceof Element)) return;
              const trigger = e.target.closest('[data-action="open-video"]');
              if (trigger) {
                e.preventDefault();
                const videoId = trigger.getAttribute('data-video-id');
                if (videoId) openModal(videoId);
              }
            }
          });
          window.videoModalEscSetup = true;
        }

        if (!window.videoModalNavSetup) {
          document.addEventListener('astro:before-preparation', closeModal);
          window.videoModalNavSetup = true;
        }
      })();
    </script>
    <script>
      /* Read by the reveal watchdog in the inline head script at the top of
         this file. Declared here because a bundled script is type-checked;
         the inline one is not. */
      declare global {
        interface Window {
          __hqRevealReady?: boolean;
        }
      }

      let isInitialLoad = true;

      function initReveal() {
        /* Signs in with the watchdog at the top of this file. Set here rather
           than at module scope, so it means "the reveal actually ran", not
           merely "the chunk downloaded" — a page-load event that never fires
           leaves the content just as invisible. */
        window.__hqRevealReady = true;
        const els = document.querySelectorAll('.reveal, .animate-on-scroll');
        const reduce = window.matchMedia(
          '(prefers-reduced-motion: reduce)'
        ).matches;
        if (reduce || !('IntersectionObserver' in window)) {
          els.forEach((elem) => {
            const el = elem as HTMLElement;
            el.setAttribute('data-state', 'in');
            el.setAttribute('data-state', 'active');
            el.style.opacity = '1';
            el.style.transform = 'none';
          });
          return;
        }
        const io = new IntersectionObserver(
          (entries, obs) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              const el = entry.target as HTMLElement;
              const delay = el.dataset.delay || '0';
              el.style.transitionDelay = `${delay}ms`;
              el.setAttribute('data-state', 'in');
              el.setAttribute('data-state', 'active');
              el.style.opacity = '1';
              el.style.transform = 'none';
              obs.unobserve(el);
              
              // Clear the delay after the animation completes so hover effects aren't permanently delayed
              setTimeout(() => {
                if (el) el.style.transitionDelay = '';
              }, parseInt(delay) + 600);
            });
          },
          { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
        );
        els.forEach((el) => io.observe(el));
      }

      // Reveal everything with no transition. `.animate-on-scroll` starts at
      // `opacity: 0; filter: blur(4px)` the instant new markup exists, so on a
      // client-side navigation this MUST run before the browser paints the
      // swapped-in page — otherwise the page paints once with the content
      // invisible and then snaps it visible, which reads as a pop-in (most
      // obvious on a large above-the-fold element like the About logo).
      function revealImmediately() {
        window.__hqRevealReady = true;
        document.querySelectorAll('.reveal, .animate-on-scroll').forEach((elem) => {
          const el = elem as HTMLElement;
          const originalTransition = el.style.transition;
          el.style.transition = 'none';
          el.setAttribute('data-state', 'in');
          el.setAttribute('data-state', 'active');
          el.style.opacity = '1';
          el.style.transform = 'none';

          // Restore transition for hover effects after rendering
          requestAnimationFrame(() => {
            requestAnimationFrame(() => {
              el.style.transition = originalTransition;
            });
          });
        });
      }

      // astro:after-swap fires after the new document replaces the old one but
      // BEFORE it is painted — the only hook that can suppress the flash.
      // astro:page-load is too late by one paint, which is what caused the
      // pop-in. Keep the page-load call as an idempotent safety net for any
      // path that reaches it without an after-swap.
      document.addEventListener('astro:after-swap', revealImmediately);

      function handlePageLoad() {
        if (isInitialLoad) {
          // A cold load has no swap: the markup is parsed with opacity 0
          // already applied, so the IntersectionObserver fade-in is the
          // intended entrance rather than a flash.
          initReveal();
          isInitialLoad = false;
        } else {
          revealImmediately();
        }
      }

      document.addEventListener('astro:page-load', handlePageLoad);
    </script>
    <script>
      import { youtubeFallbackSrc } from '../lib/card-images';

      /*
        BROKEN-IMAGE FAIL-SAFE

        Marks the container of any image that fails to load, so CSS can put a
        branded panel there instead of leaving an empty box in the grid (see
        `[data-img-failed]` in styles/modules/home-cards.css).

        Registered ONCE on `document` in the CAPTURE phase, which is the only
        way to catch this: `error` events from <img> do not bubble, so a normal
        delegated listener on document never sees them. Capture also means it
        covers images added later by the Feed's client-side filtering, without
        re-binding on every render.
      */

      /*
        ─── DOWNGRADE BEFORE GIVING UP ──────────────────────────────────────

        A missing `maxresdefault` is not a broken card, it is the wrong
        rendition — `hqdefault` exists for every video. But srcset has no
        fallback semantics: the browser picks one candidate and a dead pick
        kills the whole <img>, so nothing recovers it on its own.

        THIS IS WHY THE RECOVERY LIVES HERE rather than in an `onerror`
        attribute on each <img>. Two reasons, both learned from the version
        that did it inline and still shipped black boxes:

        1. An inline `onerror` cannot see the HTTP 200 placeholder case at
           all. YouTube answers some missing renditions with its grey 120x90
           graphic and a 200, so `error` never fires — `load` does. The
           inline handler was dead code for exactly the failure that paints
           the black box, because `isProviderPlaceholder` below then marks the
           container and `home-cards.css` sets `display: none` on the <img>.

        2. Two handlers for one condition is a race. This listener runs in
           the CAPTURE phase, so it always marks the container BEFORE an
           attribute handler on the element (target phase) gets to unmark it
           — a fix that depends on running second is a fix that depends on
           phase ordering nobody should have to reason about.

        One owner, both triggers, one retry. `data-yt-fallback` makes it
        single-shot: if hqdefault ALSO fails, this declines and the caller
        marks the container failed, which is the correct end state.
      */
      function recoverYouTubeThumb(img: HTMLImageElement) {
        if (img.dataset.ytFallback) return false;

        /*
          THE SRCSET IS THE SUSPECT, NOT THE `src`.

          `youtubeSources()` already puts the guaranteed `hqdefault` in `src`
          and offers `maxresdefault` only in `srcset`. So the risky rendition
          is the one the browser PICKED, and asking the element where it is
          now is unreliable in the case that matters: on a failed fetch the
          browser may never populate `currentSrc`, leaving only the `src`
          attribute — which is already hqdefault, reads as perfectly safe,
          and made an earlier version of this decline the recovery and brand
          the card failed instead. Measured, not assumed: it declined on
          exactly the 404 cards it existed to rescue.

          So look at the srcset itself. If it offers a rendition YouTube does
          not guarantee, that candidate is the failure whether or not the
          browser will admit to having chosen it, and dropping the srcset is
          the fix regardless.
        */
        const attrSrc = img.getAttribute('src') || '';
        const candidates = (img.getAttribute('srcset') || '')
          .split(',')
          .map((part) => part.trim().split(/\s+/)[0])
          .filter(Boolean);

        const risky = candidates.find((url) => youtubeFallbackSrc(url));
        const next = risky
          ? youtubeFallbackSrc(risky)
          : youtubeFallbackSrc(img.currentSrc || attrSrc);
        if (!next) return false;

        img.dataset.ytFallback = '1';

        /* Both must go. Leaving `srcset` in place would let the browser
           re-pick the very candidate that just failed, and a `sizes` without
           a `srcset` is meaningless. Removing them is also what makes
           `naturalWidth` un-density-corrected again, so the placeholder
           check below reads true pixels on the retry. */
        img.removeAttribute('srcset');
        img.removeAttribute('sizes');
        img.src = next;

        /* Clear a mark set earlier in this same event: the capture listener
           runs before we get here on the `error` path, and the sweep may have
           marked it on a previous pass. Without this the branded panel stays
           painted over a thumbnail that is about to load correctly. */
        containerOf(img)?.removeAttribute('data-img-failed');
        return true;
      }

      /*
        The MEDIA CONTAINER is the target, not literally the parent node. An
        <img> inside a <picture> (art-directed sources, e.g. EventCard's
        logo-on-mobile swap) has the <picture> as its parent, and marking
        that leaves the styled container — `.content-card-media` and friends
        — unmarked, so the branded panel never paints and the broken image
        stays visible. <picture> is a grouping element with no box of its
        own; step through it to the element that actually has one.
      */
      function containerOf(img: HTMLImageElement) {
        const parent = img.parentElement;
        return parent?.tagName === 'PICTURE' ? parent.parentElement : parent;
      }

      function markFailed(img: HTMLImageElement) {
        /* An image with no src is not a load failure — components render a
           branded fallback instead of an <img> when they have no cover, so
           there is nothing to rescue here. */
        if (!img.currentSrc && !img.getAttribute('src')) return;

        /*
          A DECORATIVE OVERLAY IS NOT THE COVER.

          This marker condemns the whole CONTAINER, and home-cards.css then
          hides every `> img` inside it. That is right when the cover fails,
          and catastrophic when an overlay does: a card can hold the cover
          AND `aria-hidden` decoration (ContentCard's watermark), all
          siblings in `.content-card-media`. A single broken overlay was
          therefore enough to black out a thumbnail that had loaded fine —
          which is precisely what shipped, on every video card, because the
          watermark's `src` 404'd in the production build.

          The watermark's own URL is fixed at the source now, but the
          coupling is the real defect: any future decoration dropped into a
          media container would inherit the same power to blank the card.
          Decorative images are `aria-hidden`/`alt=""` BY DEFINITION not the
          content, so a failure in one is a cosmetic loss, never a reason to
          replace the cover with a branded panel. Let it fail silently.
        */
        if (img.getAttribute('aria-hidden') === 'true') return;

        containerOf(img)?.setAttribute('data-img-failed', 'true');
      }

      /* Try the cheaper rendition first; only brand it as failed once there
         is nothing left to try. */
      function handleUnusable(img: HTMLImageElement) {
        if (recoverYouTubeThumb(img)) return;
        markFailed(img);
      }

      document.addEventListener(
        'error',
        (event) => {
          const target = event.target;
          if (target instanceof HTMLImageElement) handleUnusable(target);
        },
        true
      );

      /*
        Catch-up sweep.

        This is a bundled module and therefore DEFERRED, so images that were
        already requested during parsing can finish — and fail — before the
        listener above exists. Those errors are gone by the time we register,
        which is why a sweep is needed and not just the listener.

        `complete && naturalWidth === 0` is the standard test for "finished,
        with nothing decoded", i.e. broken. Re-run on `astro:page-load` so it
        also covers pages arriving via client-side navigation.
      */
      function sweepBrokenImages() {
        /* `[data-defer-src]` has no src YET (src/lib/deferred-images.ts), which
           reads exactly like a broken image here. */
        document.querySelectorAll<HTMLImageElement>('img:not([data-defer-src])').forEach((img) => {
          if (img.complete && img.naturalWidth === 0) handleUnusable(img);
          else if (img.complete) isProviderPlaceholder(img, (yes) => { if (yes) handleUnusable(img); });
        });
      }

      /*
        A SUCCESSFUL LOAD IS NOT THE SAME AS AN IMAGE.

        YouTube answers a request for a thumbnail it does not have with HTTP
        200 and a 120x90 grey "no thumbnail" graphic. Nothing above catches
        that: `error` never fires and naturalWidth is 90-odd rather than 0, so
        the card paints the grey box as though it were cover art.

        That is exactly what shipped — a livestream synced while it was live
        stored `maxresdefault_live.jpg`, that URL stopped resolving the moment
        the stream ended, and the card showed YouTube's placeholder instead of
        falling back to anything of ours.

        120x90 is the fixed size of that graphic, and it is a CEILING here
        rather than an equality — `naturalWidth` is density-corrected. When an
        <img> carries a srcset with `w` descriptors, the browser divides the
        decoded size by the density it computed for the chosen candidate, so
        the same 120x90 placeholder reports 120x90 on a plain <img> and 73x55
        on one whose srcset promised 480w. Measured, not assumed: an exact
        `=== 120` test caught the livestream card and silently missed every
        srcset'd card on the same page.

        Density correction only ever shrinks the reported size, so `<=` is
        safe in the other direction too. Nothing we actually request comes
        close: the smallest rendition this site ever asks for is `mqdefault`
        at 320 wide, and `hqdefault` is 480. The one genuine 120x90 rendition,
        `default.jpg`, is excluded by URL.
      */
      /*
        ─── naturalWidth IS DENSITY-CORRECTED. MEASURE THE FILE INSTEAD. ─────

        The browser divides the decoded size by the density it inferred for the
        candidate it chose: descriptor width over the slot it had to fill. The
        note on `removeAttribute('srcset')` above already knows this, and the
        threshold here was written as if the correction only ever SHRANK the
        number. It does not.

        Measured on /feed at a 1280 viewport: `#hero-bg` carries
        `sizes="100vw"`, so its slot is 1280 while the ladder's top rung is
        1200w. Density is 1200/1280 = 0.9375, BELOW 1, so YouTube's 120x90
        placeholder reported 128x96 and sailed straight over `<= 120 && <= 90`.
        The element was showing the grey "no thumbnail" box and the recovery
        never fired.

        Correcting the arithmetic back out was tried and is not reliable
        enough: it depends on matching `currentSrc` to its candidate string and
        on `clientWidth` being settled, and it silently over-corrects when
        either is not true (measured: it took detection from 10 of 11 to 7).

        A bare `Image()` has no srcset and no `sizes`, so nothing corrects it
        and `naturalWidth` is the file's true pixels. It costs no network: the
        URL is whatever the element already fetched, so it is served from
        cache. Asynchronous, which is why the callers below take a callback.
      */
      function measureTruePixels(
        img: HTMLImageElement,
        done: (w: number, h: number) => void,
      ) {
        const url = img.currentSrc || img.getAttribute('src') || '';
        if (!url) {
          done(0, 0);
          return;
        }
        const probe = new Image();
        probe.onload = () => done(probe.naturalWidth, probe.naturalHeight);
        probe.onerror = () => done(0, 0);
        probe.src = url;
      }

      function isProviderPlaceholder(img: HTMLImageElement, done: (yes: boolean) => void) {
        const src = img.currentSrc || img.getAttribute('src') || '';
        if (!src.includes('i.ytimg.com')) {
          done(false);
          return;
        }
        if (/\/default\.jpg/.test(src)) {
          done(false); // legitimately 120x90
          return;
        }
        measureTruePixels(img, (w, h) => done(w > 0 && w <= 120 && h > 0 && h <= 90));
      }

      /*
        Placeholders are only detectable once the pixels are in, and a card
        below the fold may still be loading when the sweep runs — so re-check
        each image as it finishes rather than relying on the sweep alone.
      */
      document.addEventListener(
        'load',
        (event) => {
          const target = event.target;
          if (target instanceof HTMLImageElement) {
            isProviderPlaceholder(target, (yes) => { if (yes) handleUnusable(target); });
          }
        },
        true
      );

      sweepBrokenImages();
      document.addEventListener('astro:page-load', sweepBrokenImages);
    </script>
    <script>
      import { releaseScrollLock } from '../lib/scroll-lock';

      let lastClickedLink: Element | null = null;
      document.addEventListener('click', (e) => {
        lastClickedLink = (e.target as Element).closest('a');
      }, { capture: true });

      // Step 1: Strip mobile scroll locks BEFORE Astro takes its snapshot
      document.addEventListener('astro:before-preparation', (ev: any) => {
        if (lastClickedLink && lastClickedLink.getAttribute('data-direction')) {
          ev.direction = lastClickedLink.getAttribute('data-direction');
        }
        /*
          One call replaces the hand-rolled teardown that used to live here
          (clear four inline styles, re-parse `body.style.top` to recover the
          offset, scrollTo). It also resets the lock COUNTER — without that, a
          navigation performed while an overlay was open left the count above
          zero, and the next page could never be unlocked because every
          unlockScroll() decremented to a still-positive number.

          It deliberately does NOT restore the scroll position: the page is
          being replaced, so the old offset is meaningless, and Step 2 below
          scrolls to top for the incoming page.
        */
        releaseScrollLock();

        // Never cache an OPEN modal: with the scroll lock already cleared above,
        // a cached-open modal causes a big scroll jump when closed after Back.
        // Release the focus trap and close/reset both modals.
        document.getElementById('app-wrapper')?.removeAttribute('inert');
        const videoModal = document.getElementById('video-modal');
        if (videoModal) {
          videoModal.classList.remove('active');
          videoModal.setAttribute('aria-hidden', 'true');
          videoModal.setAttribute('inert', '');
          const iframe = videoModal.querySelector('#modal-iframe') as HTMLIFrameElement | null;
          if (iframe) iframe.src = 'about:blank';
        }
        const successContainer = document.getElementById('success-message');
        if (successContainer && !successContainer.classList.contains('hidden')) {
          successContainer.classList.add('hidden');
          const iframe = document.getElementById('hidden_iframe') as HTMLIFrameElement | null;
          if (iframe) iframe.src = 'about:blank';
        }
        const calendarModal = document.getElementById('spanning-calendar-modal');
        if (calendarModal) {
          calendarModal.classList.remove('is-active');
          calendarModal.setAttribute('aria-hidden', 'true');
        }
        const modal = document.querySelector('#category-modal') as HTMLDialogElement | null;
        modal?.close();
      });

      // Step 2: Force scroll to top instantly BEFORE the DOM swaps
      document.addEventListener('astro:before-swap', () => {
        window.scrollTo({ left: 0, top: 0, behavior: 'instant' });
      });

      /*
        GTM SPA pageview tracking does NOT live here — deliberately.

        This exact `dataLayer.push({ event: 'page_view', ... })` used to be
        duplicated here AND in the <head> script above (search this file for
        "GA4 tag in the GTM dashboard triggers on this event"). Two separate
        `astro:page-load` listeners means every page view pushed 'page_view'
        TWICE, so every tag keyed off it — GA4, Clarity, Meta, TikTok — fired
        twice per view. That is the exact "multiple events on page load" bug
        reported via Meta Pixel Helper on /feed; it was not page-specific, it
        was firing twice on every page, just not necessarily noticed elsewhere.

        There must be exactly ONE source of this event, so this copy was
        deleted. See the <head> script for the one that remains — it is also
        deliberately deferred with requestIdleCallback so it does not compete
        with initial render, which this duplicate was not doing either.
      */
    </script>
  </body>
</html>
