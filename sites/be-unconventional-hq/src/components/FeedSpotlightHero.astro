---
import { getVideosUnified } from '../lib/videos-source';
import { parseVideoId } from '../lib/platforms/youtube';
import { feedSortTime } from '../lib/feed-items';
import { getDisplayTagSlots } from '../lib/tags';
import { editorialPreview } from '../lib/editorial-text';
import { getCardImageSources } from '../lib/card-images';
import { getFeaturedBrandsLocal, getEventsLocal, urlFor } from '../lib/local-content';
import { resolveEntity } from '../lib/entity-resolver';
import logoImage from '../assets/logo-mark.webp';
import { getImage } from 'astro:assets';
import { site } from '../data/site.js';
import { SOCIAL_ICONS } from '../data/icons.js';

interface Props {
  /**
   * The full feed supplies its own rail and player controller. Category feeds
   * render a static grid, so they opt into this lightweight player control.
   */
  interactive?: boolean;
}

const { interactive = false } = Astro.props;

const videos = await getVideosUnified();

/*
  TYPED LOOSE ON PURPOSE, IN ONE PLACE.

  `getVideosUnified()` is declared as returning UnifiedVideo, but this hero
  reads fields that belong to the raw feed item and are not on that type —
  url, videoId, image, snippet, brandLogo. Every one of those reads was its own
  ts(2339), which is how this file came to carry the project's only `astro
  check` errors against a 0/0/0 baseline.

  Widening once here, rather than casting at each read, keeps the count at zero
  without scattering `as any` through the markup — and leaves one obvious place
  to delete from when UnifiedVideo grows the fields for real.
*/
/*
  SORTED, NOT `videos[0]`.

  `getUnifiedVideos()` maps and filters but never sorts, so `videos[0]` was
  whichever document happens to sit first in `videos.json`. That was the newest
  video only because the sync writes newest-first, and the file is already not
  strictly in date order further down.

  It stopped being a cosmetic detail when the homepage banner's "Watch" button
  started pointing at /feed instead of at YouTube. The banner picks its item
  with `byNewest`, which honours `sortDate`; this picked file order, which does
  not. One `sortDate` — the field's whole purpose, and already used for the
  Lanterns episode ordering — and the banner would advertise one video while
  the hero it links to showed another, with the direct link that used to
  guarantee it now gone.

  Same rule, one definition, imported from feed-items.
*/
const latestVideo: Record<string, any> =
  [...videos].sort((a: any, b: any) => feedSortTime(b) - feedSortTime(a))[0] || {};
const trailerId = parseVideoId(latestVideo.url || latestVideo.link || latestVideo.videoId || '');

const isVideo = true;
const heroKind = isVideo ? 'VIDEO' : 'ARTICLE';

/*
  ─── THE SUBSCRIBE BUTTON ASKS FOR THE CONFIRMATION SHEET ──────────────────

  `?sub_confirmation=1` makes YouTube open its one-click subscribe dialog over
  the channel instead of dropping the visitor on the channel page to find the
  button themselves. CommercialRotator.astro has carried it since it was
  written; this hero did not, so the site's most prominent subscribe CTA was
  the one asking for the most work.

  Both the handle AND the parameter come from src/data/site.js, which is the
  one place either is written down. Assembling the URL here would put the
  parameter in a second place, which is how this button came to be missing it
  while the ad rotator had it: two call sites, one of them forgotten.
*/
const subscribeUrl = site.socials.youtubeSubscribe;

/*
  ─── THE STAGE NEEDS A DOOR, AND THIS IS THE PLAYER THAT NEEDED IT ─────────

  The escape hatch shipped first on #video-modal (Layout.astro), the lightbox
  a CARD opens. That was the wrong player: the reader who got trapped was on
  /feed, and /feed's hero plays in THIS stage, which had no way out at all —
  no link, no explanation, nothing but an embed that refused.

  youtube-nocookie.com deliberately withholds the viewer's YouTube session, so
  a video the player will not embed cannot be rescued by a parameter. The only
  fix is a link to the real watch page, and it is rendered ALWAYS rather than
  on detection: a detector that silently fails to fire puts the reader straight
  back in the trap.
*/
const watchUrl = trailerId
  ? `https://www.youtube.com/watch?v=${encodeURIComponent(trailerId)}`
  : '';
const heroSlots = getDisplayTagSlots(latestVideo);

/*
  The hub this item belongs to — a featuredBrand OR an event.

  The lookup that stood here searched featuredBrands only and compared a brand
  title to the item's first display tag. Conventions are `_type: 'event'`
  documents, so an L.A. Comic Con item matched nothing and the hero fell back to
  the BE Unconventional HQ crown, which is the generic mark it shows when it
  knows nothing about an item at all. `resolveEntity()` searches both types.
*/
const entity = resolveEntity(latestVideo, {
  brands: getFeaturedBrandsLocal(),
  events: getEventsLocal(),
  urlFor,
});

/*
  ─── SIZED, NOT JUST ROUTED THROUGH getImage() ──────────────────────────────

  Getting the path right is only half of it. `getImage({ src })` with no
  dimensions emits the ORIGINAL, and logo-mark.webp is 414 KB — for an element
  capped at 180px tall. That shipped as the heaviest request on /feed (405 KB,
  bigger than the hero backdrop) and helped push mobile LCP to 7.9s.

  ContentCard.astro sizes its watermark for exactly this reason and names the
  414 KB figure. Requested at 360px tall here, which is 2x the largest size this
  element is ever displayed at.
*/
const fallbackLogoSrc = (await getImage({ src: logoImage, height: 360, format: 'webp', quality: 70 })).src;

/*
  ─── THE EDITORIAL OVERRIDE, STRAIGHT THROUGH urlFor() ──────────────────────

  The override outranks the taxonomy — see the CMS hero override cascade. It
  needs no special handling for where the asset lives: `urlFor()` returns a
  cdn.sanity.io URL for a Sanity id and passes any other string through
  untouched, which is exactly what the local CMS's own uploads are.

  An earlier pass here read a bare filename out of `src/assets/partners/`,
  because the mark this was built for had no Sanity asset. That was the wrong
  home for it twice over: that folder is REFERRAL partners (Mint Mobile,
  DaVinci Resolve), and a distributor whose film we reviewed is not one, and
  CLAUDE.md is explicit that new assets upload through the CMS rather than
  being committed beside the code. The field is editable in the local CMS now,
  so there is nothing left for the shortcut to buy.

  It still fails soft: an override that resolves to nothing falls through to
  the taxonomy and then to the HQ crown, so a half-finished edit never breaks
  the page.
*/
/* Sized exactly as EventAnnouncement/EventFeatured size theirs (320px tall,
   2x the tallest this mark is shown). `.url()` alone asked for the original:
   Ketchup's is a 3364x1091 PNG, fetched at high priority beside the LCP. */
const overrideLogo = latestVideo.customHeroLogo ? urlFor(latestVideo.customHeroLogo).height(320).auto('format').url() : null;
const taxonomyLogo = entity?.logo || null;
const brandLogo = overrideLogo || taxonomyLogo || fallbackLogoSrc;

/*
  ─── THE LABEL NAMES WHICHEVER MARK ACTUALLY WON ───────────────────────────

  This is alt text on a logo, so it is not decorative: it is the only thing
  telling a screen reader whose brand is on the hero. It used to cascade
  independently of the image, which meant the two could disagree. They disagree
  in the worst direction while an editor is mid-edit: set the label, and the
  hero paints the HQ crown while announcing somebody else's brand.

  So the label follows the logo. If the override resolved to a real image, its
  label applies; if it fell through to the crown, the crown's own name does.
*/
const overrideLabel = latestVideo.customHeroBrandLabel || null;
const taxonomyLabel = entity?.title || '';
const brandLabel = overrideLogo
  ? overrideLabel || taxonomyLabel || 'BE Unconventional HQ'
  : taxonomyLogo
    ? taxonomyLabel || 'BE Unconventional HQ'
    : 'BE Unconventional HQ';

const brandHero = entity?.hero || '';
const itemBgRaw = latestVideo.thumbnail || latestVideo.image || '';
const heroBgRaw = brandHero || itemBgRaw;
const { src: itemBg, srcset: itemBgSrcset } = getCardImageSources(itemBgRaw);
const { src: heroBg, srcset: heroBgSrcset } = getCardImageSources(heroBgRaw);
const heroTitle = latestVideo.title || '';
/*
  ─── THE HERO AND THE CARDS MUST DESCRIBE AN ITEM THE SAME WAY ──────────────

  This was `latestVideo.description`, raw. ContentCard cleaned its text and this
  did not, which is the definition of two code paths for one decision, and the
  hero is the one that matters: it is the largest text on /feed and the first
  thing a PR contact reads.

  Measured on the store: 14 of 29 published videos open with a hashtag block or
  an emoji banner INSIDE the first 280 characters, which is the window this
  element displays before its 3-4 line clamp. Whenever one of those was the
  newest video it led the page with "#TheOdysseyMovie #christophernolan
  #trailerreaction #movie #tomholland".

  Same function as the cards (src/lib/editorial-text.ts). The swap handler below
  reads `data-preview`, which ContentCard fills from that same function, so the
  hero renders identical text whether it was built here or promoted from a tile.
*/
const heroDescription = editorialPreview(latestVideo);

function hexToRgbTriple(hex: string): string {
  if (!hex) return '204, 0, 0';
  const clean = hex.replace('#', '');
  if (clean.length !== 6) return '204, 0, 0';
  const r = parseInt(clean.substring(0, 2), 16);
  const g = parseInt(clean.substring(2, 4), 16);
  const b = parseInt(clean.substring(4, 6), 16);
  return `${r}, ${g}, ${b}`;
}

/* The hub's own colour, already normalised by the resolver (a brand stores it
   as `brandColor.hex`, an event sometimes as a bare string). */
const brandHex = entity?.color || '#CC0000';
const brandRgb = hexToRgbTriple(brandHex);
const fallbackGradient = `linear-gradient(135deg, rgba(${brandRgb}, 0.28) 0%, #0a0a0a 62%, #111 100%)`;


/*
  THE EYEBROW SHOWS THE ITEM'S OWN TAGS, NOT ITS FILE TYPE.

  It used to be a single hardcoded chip reading VIDEO or ARTICLE, which is the
  one thing about a hero item a visitor can already see: it is a still with a
  play button on it. The cards below say "DC | REVIEW" and the hero said
  "VIDEO", so the loudest item on the page carried the least information.

  `getDisplayTags()` is the SAME function the cards use (src/lib/tags.ts) —
  brand, then content type, then event, capped at three. Sharing it is the
  point: a tag that reads DC | REVIEW on a card cannot read something else in
  the hero, and the brand/type dictionaries stay in one file.

  The kind is the FALLBACK, not a prefix. An item that matches no brand and no
  type still needs something in the chip, and that is the only case where
  VIDEO/ARTICLE earns its place.
*/

/*
  ─── THE ACCENT BELONGS TO THE BRAND CHIP, NOT TO CHIP NUMBER ONE ───────────

  `.hero-meta-tag--type` (a 2px brand-coloured left border) was applied to
  `index === 0`. Slot 0 is the BRAND, so the class has always been misnamed,
  and worse: when no brand resolved, `getDisplayTags()` collapsed its array and
  the editorial type moved into position 0 and took the brand accent with it.
  Five of the 41 items on /feed painted a brand accent on the words REVIEW or
  ANALYSIS while naming no brand at all.

  Chips are built from the slots now, and the accent follows the brand slot
  wherever it is. An item WITH a brand renders exactly as it did; an item
  without one simply does not get a brand accent.
*/
const heroMetaChips: Array<{ label: string; slot: 'brand' | 'type' | 'extra' | 'kind' }> = [
  ...(heroSlots.brand ? [{ label: heroSlots.brand, slot: 'brand' as const }] : []),
  ...(heroSlots.type ? [{ label: heroSlots.type, slot: 'type' as const }] : []),
  ...(heroSlots.extra ? [{ label: heroSlots.extra, slot: 'extra' as const }] : []),
];
/* The kind is the FALLBACK, and only when the item resolved nothing at all. */
if (heroMetaChips.length === 0) heroMetaChips.push({ label: heroKind, slot: 'kind' });
---

<section
  class="event-hero w-full max-w-full box-border"
  data-standalone-spotlight={interactive ? '' : undefined}
  style={`--brand-color: ${brandHex}; --brand-rgb: ${brandRgb};`}
>
  <div class="event-hero-bg-wrapper">
    {heroBg ? (
      <img
        id="hero-bg"
        src={heroBg}
        srcset={heroBgSrcset || undefined}
        sizes="100vw"
        alt=""
        class="event-hero-bg-animated hero-backdrop-plate"
        loading="eager"
        fetchpriority="high"
        decoding="sync"
      />
    ) : (
      <div id="hero-bg" class="event-hero-bg-animated" style={`background-image: ${fallbackGradient};`}></div>
    )}
  </div>

  <div class="hub-stage-wash" aria-hidden="true"></div>

  <div class="event-hero-overlay flex flex-col justify-center">
    <div
      class:list={[
        'container',
        'hero-grid-container',
        'w-full',
        'max-w-full',
        'box-border',
        'lg:!px-20',
        'xl:!px-24',
        '2xl:!grid-cols-[1fr_1.2fr]',
        '3xl:!grid-cols-[1fr_1.4fr]',
        { 'has-trailer': true },
      ]}
    >
      <div class="event-hero-content hero-copy">
        
        {/* `id` is on the CONTAINER, not on a chip: the number of chips
            changes with the item (one tag, two, three), so the swap handler in
            FeedGrid rewrites the row wholesale rather than trying to keep a
            fixed set of spans in step with it. */}
        <div class="hero-eyebrow" id="hero-meta-tags">
          {heroMetaChips.map((chip) => (
            <span
              class={`hero-meta-tag${chip.slot === 'brand' ? ' hero-meta-tag--brand' : ''}`}
              data-slot={chip.slot}
            >{chip.label}</span>
          ))}
        </div>

        <div class="hero-identity">
          <img 
            id="hero-brand-logo" 
            src={brandLogo || fallbackLogoSrc} 
            alt={brandLabel} 
            class={`hero-logo`}
            data-fallback-logo={fallbackLogoSrc}
            loading="eager"
            decoding="async"
          />
          {/* h2, not h1: the page's one h1 is its own title (FeedLayout's "The
              Feed" / the category name). This is the featured STORY, which
              changes with every card clicked, and it made /feed, its two
              sub-feeds and every category page ship two h1s. */}
          <h2 id="hero-title" class="hero-title leading-tight">{heroTitle}</h2>
          <p id="hero-description" class="hero-tagline">{heroDescription}</p>
          {/*
            ─── THE ACTION ROW ─────────────────────────────────────────────────

            A real wrapper, not two loose links. `.hero-identity` above is a
            COLUMN flex with `align-items: flex-start`, so siblings dropped into
            it stack vertically: SUBSCRIBE and EXPLORE would have sat one on top
            of the other rather than beside each other. This row is also the
            element FeedGrid's swap handler looks for when it has to insert or
            remove the hub button on a card swap.
          */}
          <div class="feed-hero-actions">
          <a
            href={subscribeUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="feed-hero-youtube-btn"
          >
            <svg class="feed-hero-youtube-glyph" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0 3.897-.266 4.356-2.62 4.385-8.816-.029-6.185-.484-8.549-4.385-8.816zm-10.615 12.816v-8l8 3.993-8 4.007z" fill="currentColor"></path>
            </svg>
            <span class="feed-hero-youtube-text">SUBSCRIBE</span>
          </a>

          {/*
            ─── THE WAY OUT OF THE STAGE ───────────────────────────────────────

            SECOND in the row, directly after SUBSCRIBE. The row order is fixed
            and deliberate: SUBSCRIBE, then WATCH ON YOUTUBE, then whatever the
            item brings with it. The two YouTube actions read as a pair that
            way, and the pair does not reshuffle between items, which is what
            happened while the hub CTA sat between them: a hero with a hub put
            EXPLORE in the middle and one without it did not, so the same
            button moved depending on what was loaded.

            It lives in the COPY column rather than over the stage because the
            stage is `position: absolute; inset: 0` end to end, so anything
            added there lands on top of YouTube's own controls, and because a
            link pinned inside the frame disappears with it when the stage pops
            out to PiP.

            Rendered whenever the loaded item is a video, playing or not, for
            the reason in the watchUrl note above: detection is the enhancement,
            the door is the fix. FeedGrid's swap handler retargets, inserts and
            removes it, and inserts the hub button AFTER it.
          */}
          {isVideo && watchUrl && (
            <a
              id="hero-watch-on-youtube"
              class="feed-hero-watch-btn"
              href={watchUrl}
              target="_blank"
              rel="noopener noreferrer"
            ><span class="yt-mark" aria-hidden="true" set:html={SOCIAL_ICONS.YouTube} /><span>Watch on YouTube</span></a>
          )}
          {/* The same mark for the button the swap script builds when a card
              promotes a video into a hero that had none: cloned, so the
              script never carries its own copy of the logo. */}
          <template id="yt-mark-template"><span class="yt-mark" aria-hidden="true" set:html={SOCIAL_ICONS.YouTube} /></template>

          {/*
            ─── THE HUB CTA ────────────────────────────────────────────────────

            Sends the reader to the hero item's own hub: /featured/<slug> for a
            brand, /events/<slug> for a convention. The destination is decided
            server-side by resolveEntity(), so the two shapes of URL never have
            to be worked out in the browser.

            LAST in the row, after SUBSCRIBE and WATCH ON YOUTUBE. It is the
            one button here that depends on the item, so it goes where an
            item-dependent button can appear and disappear without moving the
            two that are always there.

            Rendered only when an entity actually resolved. It is omitted from
            the DOM entirely rather than hidden with a style, so there is no
            empty link in the tab order and no button that navigates to "#" —
            FeedGrid's swap handler inserts one when a card that HAS a hub is
            promoted into the hero, and removes it again when one does not.
          */}
          {entity && (
            <a id="hero-featured-hub-btn" href={entity.url} class="feed-hero-hub-btn">
              <span id="hero-featured-hub-text">EXPLORE {(entity.title || '').toUpperCase()}</span>
              <svg
                class="feed-hero-hub-glyph"
                viewBox="0 0 24 24"
                width="14"
                height="14"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
                focusable="false"
              >
                <path d="M5 12h14M12 5l7 7-7 7" />
              </svg>
            </a>
          )}

          </div>

          {/*
            Revealed only when the player itself reports onError. Explains a
            stage that looks broken; the link above works either way.
          */}
          <p class="feed-hero-embed-note" id="hero-embed-note" hidden>
            YouTube will not play this video in an embedded player. Watch it on
            YouTube instead.
          </p>
        </div>


        {/*
          ─── THERE IS NO PLAY BUTTON IN THIS COLUMN, DELIBERATELY ───────────

          There was one, and before that it was a full-width bar. It is gone
          rather than restyled: the stage pane on the right already carries the
          action for this exact item, over its own artwork, right next to its
          title. Two controls that start the same video, one of them beside a
          picture of what it starts and one of them not, is a choice the
          visitor should never have been asked to make.

          It also removed a whole class of bug rather than patching it. The
          button was rebuilt in JS on every tile swap, and a runtime-built node
          carries none of Astro's scoped-style attributes, so after a swap it
          lost its rectangle and its 13px glyph constraint and rendered as bare
          text under an oversized play triangle.

          If a second action ever belongs here, it goes back as a sibling of
          the identity block — not in the `cta` grid area, which stretches.
        */}
      </div>

      <div
        class="hero-trailer hub-stage is-item"
        data-trailer={trailerId || undefined}
      >
        <div class="hub-stage-mark hub-stage-mark--art">
           {/* Fallback image if no video */}
           {/* alt="" ON PURPOSE. Both are decorative: the fill is a blurred,
               darkened copy that only shows in the gutters, and the front one
               repeats artwork the headline beside it already names. An empty
               alt takes them out of the accessibility tree; omitting the
               attribute entirely leaves them in it with no name, which is what
               Lighthouse's image-alt audit was reporting. */}
           <img
              id="hero-image"
              src={itemBg || undefined}
              srcset={itemBgSrcset || undefined}
              sizes="(max-width: 1023px) 100vw, 50vw"
              alt=""
              class="hub-stage-art-fill"
              loading="eager"
              fetchpriority="high"
              decoding="sync"
           />
           <img
              id="hero-image-front"
              src={itemBg || undefined}
              srcset={itemBgSrcset || undefined}
              sizes="(max-width: 1023px) 100vw, 50vw"
              alt=""
              class="hub-stage-art-img"
              loading="eager"
              fetchpriority="high"
              decoding="sync"
           />
           
           
        </div>

        <div class="hub-stage-video">
          <iframe
            id="hero-iframe"
            class="hub-stage-iframe transition-opacity duration-500"
            src="about:blank"
            data-pending-video={trailerId || undefined}
            title=""
            tabindex="-1"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share; fullscreen"
            allowfullscreen
            style="opacity: 0; pointer-events: none;"
          ></iframe>

          {/*
            The PiP dismiss control. It lives INSIDE .hub-stage-video because
            that is the box that becomes the floating window, so it travels with
            it and needs no second set of coordinates. Hidden and inert until
            the stage is actually in PiP, so it is never a stray tab stop over
            the hero.
          */}
          <button type="button" class="hub-stage-pip-close" data-pip-close hidden>
            <span class="sr-only">Close the floating video</span>
            <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" focusable="false">
              <path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2" />
            </svg>
          </button>
        </div>

        {/*
          ─── THE STAGE STATES WHAT IT IS ABOUT TO PLAY ──────────────────────

          The same pane /featured shows when a rail tile is picked: still,
          scrim, kind, title, Play. Here it is the stage's OPENING state rather
          than a selection, because the feed hero always has exactly one item
          loaded and the visitor has not chosen it — so the stage was a bare
          thumbnail that named nothing and offered nothing, and the only way to
          start it was the button in the other column.

          Every rule this needs (.hub-stage-item and friends, including the
          `is-playing` rule that takes the pane off the frame it just started)
          was already in this file's stylesheet, written for a pane that was
          never rendered. This is that markup arriving, not a new treatment.

          Sits ABOVE .hub-stage-video in both source order and stacking: the
          video div carries `z-index: 5` inline, so a pane that merely follows
          it would be behind it, and an opacity-0 element still swallows
          clicks. That is why the pane takes 6 and the video layer gives up
          pointer events while a pane is up.
        */}
        <div class="hub-stage-item active" id="hero-stage-item" style="z-index: 6;">
          {itemBg && <img id="hero-stage-item-still" src={itemBg} srcset={itemBgSrcset || undefined} sizes="(max-width: 1023px) 100vw, 50vw" alt="" class="hub-stage-item-still" loading="eager" fetchpriority="high" decoding="sync" />}
          <span class="hub-stage-item-scrim"></span>
          <div class="hub-stage-item-copy">
            <span class="hub-stage-item-kind" id="hero-stage-item-kind">{heroKind}</span>
            <p class="hub-stage-item-title" id="hero-stage-item-title">{heroTitle}</p>
            {isVideo && trailerId ? (
              /* Same handler as the copy column's button — `data-action` is
                 what FeedGrid's play listener reads. It plays IN the stage; the
                 site-wide `open-video` action would pop the modal, and this
                 panel is already the player. */
              <button type="button" class="hub-stage-item-action" id="hero-stage-item-action" data-action="play-trailer">
                Play
              </button>
            ) : (
              <a href={latestVideo.url || latestVideo.link || '#'} class="hub-stage-item-action" id="hero-stage-item-action">
                Read
              </a>
            )}
          </div>
        </div>

      </div>

    </div>
  </div>
</section>

{
  /*
    The hero renders nothing extra here any more. Its behaviour — loading a
    clicked card into the stage, and playing it — is in the unconditional
    script at the end of this file, because it belongs to every surface that
    mounts this hero rather than to the ones that opt in.
  */
  null
}

<script>
  /*
    ─── PICTURE IN PICTURE ───────────────────────────────────────────────────

    Scroll the hero away while a video is playing and the player detaches to the
    bottom-right of the viewport; scroll back and it returns to the stage.

    ─── WHY THERE IS NO YouTube IFrame API ───────────────────────────────────
    The brief specified tracking `onStateChange`. That needs YouTube's
    iframe_api script, and scripts/third-party-critical-path.test.mjs exists to
    keep vendor scripts off this path. We do not need it: playback on this stage
    is only ever started by our own code, which marks the stage `is-playing` at
    the same moment. That class IS the play state, it is already the thing the
    stylesheet keys every other playing behaviour off, and it costs no network.

    The trade-off, stated plainly: if a visitor pauses inside the YouTube chrome
    we do not hear about it, so a paused video still pops out on scroll. Reading
    that would mean the vendor script. Dismissing the window is one click.

    ─── THE GUARDRAIL ───────────────────────────────────────────────────────
    The iframe is NEVER re-parented, re-sourced or removed. Any of the three
    restarts the video. Only a class on .hub-stage changes; CSS does the rest.
  */
  function initSpotlightPip() {
    /*
      A client-side navigation re-runs this against a NEW stage, so the previous
      page's observer and its scroll listeners have to go first. The teardown is
      a function rather than the observer itself now: the window also holds two
      listeners on `window`, which outlive the document that registered them.
    */
    const key = '__hqSpotlightPipTeardown';
    const previous = (window as any)[key] as (() => void) | undefined;
    if (typeof previous === 'function') previous();
    delete (window as any)[key];

    const stage = document.querySelector<HTMLElement>('.hub-stage');
    if (!stage) return;

    const frame = stage.querySelector<HTMLIFrameElement>('#hero-iframe');
    const closeBtn = stage.querySelector<HTMLButtonElement>('[data-pip-close]');
    if (!frame || !closeBtn) return;

    /* Set when the visitor dismisses the window, and cleared the moment the
       hero is back on screen. Without it, one dismissal is undone by the next
       scroll tick that still sees the hero off screen. */
    let dismissed = false;

    /* The ancestor whose backdrop-filter would otherwise trap the fixed
       window. Looked up once; absent on any surface that frames the hero
       differently, in which case there is nothing to neutralise. */
    const pipHost = stage.closest<HTMLElement>('.event-hero-overlay');

    /*
      ─── THE WINDOW RIDES UP ON THE FOOTER ────────────────────────────────────

      Reported: the PiP player disappears behind the footer. It is
      `position: fixed`, so it stays put while the footer scrolls up underneath
      it, and the two end up sharing the bottom-right corner of the screen.

      Raising its z-index would have swapped one wrong answer for another — the
      window would then sit ON the footer, covering the site's own navigation.
      So it is pushed instead: `--pip-lift` carries however far the footer has
      risen into the viewport, and the window's `bottom` adds it.

      Measured in a rAF and written in the same frame, which is the read/write
      split this project already uses on the feed rails: reading
      getBoundingClientRect() inside a scroll handler and writing a style
      straight after it is the layout thrash that showed up in Lighthouse.

      Listeners are attached only while a window is actually out. A scroll
      handler that runs on every page, for a feature that is off, is the kind of
      cost that does not show up until there are several of them.
    */
    const footer = document.querySelector<HTMLElement>('footer.site-footer');
    let liftFrame = 0;

    const measureLift = () => {
      liftFrame = 0;
      if (!footer) return;
      const intrusion = window.innerHeight - footer.getBoundingClientRect().top;
      /* Ceil, so a fractional pixel cannot leave a hairline of footer showing
         through under the window's own border. */
      stage.style.setProperty('--pip-lift', `${Math.max(0, Math.ceil(intrusion))}px`);
    };

    const scheduleLift = () => {
      if (!liftFrame) liftFrame = requestAnimationFrame(measureLift);
    };

    const watchFooter = (on: boolean) => {
      window.removeEventListener('scroll', scheduleLift);
      window.removeEventListener('resize', scheduleLift);
      if (!on) {
        if (liftFrame) cancelAnimationFrame(liftFrame);
        liftFrame = 0;
        /* Back to the plain inset, so the next window does not open already
           lifted by wherever the last one happened to stop. */
        stage.style.removeProperty('--pip-lift');
        return;
      }
      window.addEventListener('scroll', scheduleLift, { passive: true });
      window.addEventListener('resize', scheduleLift, { passive: true });
      measureLift();
    };

    const setPip = (on: boolean) => {
      stage.classList.toggle('is-pip', on);
      pipHost?.classList.toggle('is-pip-host', on);
      closeBtn.hidden = !on;
      watchFooter(on);
    };

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            dismissed = false;
            setPip(false);
            continue;
          }
          setPip(!dismissed && stage.classList.contains('is-playing'));
        }
      },
      /* A small negative top margin means the hero has to be properly gone, not
         merely grazing the top edge, before the window appears. */
      { threshold: 0, rootMargin: '-80px 0px 0px 0px' },
    );

    observer.observe(stage);
    (window as any)[key] = () => {
      observer.disconnect();
      watchFooter(false);
    };

    closeBtn.addEventListener('click', () => {
      dismissed = true;
      setPip(false);
      /*
        Pause rather than tear down. `enablejsapi=1` is already on the embed URL
        this stage builds, so the player accepts a command over postMessage with
        no API script loaded. Clearing the src instead would both restart the
        video on return and, if it were ever set to '', resolve to this page and
        load the site inside its own iframe (hard rule 4).
      */
      try {
        frame.contentWindow?.postMessage(
          JSON.stringify({ event: 'command', func: 'pauseVideo', args: [] }),
          '*',
        );
      } catch {
        /* Cross-origin refusal is harmless: the window is already closed. */
      }
    });
  }

  document.addEventListener('astro:page-load', initSpotlightPip);
</script>

<style>
  .event-dashboard {
    /* min-height removed to respect canonical footer spacing */
  }
  /* Page width wrapper now shared: `.container-page` in modules/layout.css */
  
  /* Hero */
  .event-hero {
    position: relative;
    z-index: 10;
    /* The ground under the backdrop. Dropped in the same commit that broke the
       comment below; an item with no artwork rendered on a transparent hero. */
    background-color: #111;
    /* NO overflow:hidden here. On iOS Safari an overflow:hidden ancestor makes
       a descendant cross-origin (YouTube) iframe render as a black box. The bg
       below is inset:0 and its image clips to its own box, so it can't spill —
       the clip was never needed.

       AND THE COMMENT TERMINATOR ON THE NEXT LINE IS LOAD-BEARING. It was
       deleted once, which ran this comment on through the closing brace and
       destroyed the whole rule: `position: relative` never applied, so
       `.event-hero-bg-wrapper`
       (position: absolute; inset: 0) escaped to the initial containing block
       and sized itself to the VIEWPORT. The hero's blurred backdrop then
       painted 2224px tall behind the entire page, under every row on the feed.
       Reported as "why is the hero image extending into the background". */
  }
  /* Clipping/coverage layer: static, fills the hero, hides the sliver the
     animated child exposes at its edges while scaled. overflow:hidden is safe
     HERE (and only here) — it contains no iframe, so the iOS black-box bug
     cannot trigger. */
  .event-hero-bg-wrapper {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: 0;
  }
  .event-hero-bg-animated {
    position: absolute;
    inset: 0;
    /* Cover the whole hero (behind the copy AND the trailer). It re-crops when
       the description expands — an accepted trade for full coverage. */
    object-fit: cover;
    /*
      CENTRED. It was `center 22%`, biased high for key art that carries its
      subject near the top. Behind 9px of blur nobody can tell what the subject
      is, and the bias simply cropped differently on every asset: the 2.35:1
      banners lost their bottom edge while the 16:9 stills lost nothing. One
      position for every image is the point.
    */
    object-position: center;
    width: 100%;
    height: 100%;
    /* translateZ(0) promotes this layer to its own compositor layer. Without
       it, the overlay's backdrop-filter blur stops the animated transform from
       repainting (issue #22 root cause) — keep it in the base AND in every
       keyframe so the promotion never lapses mid-animation. */
    transform: translateZ(0);
    /* Tuned after visual QA: the original 1.05/50s (~0.1%/s) sat below the
       perception floor and read as static. 1.08/30s is ambient but alive —
       don't retune blind; verify any change with the 2s/1.5x debug values
       (see d1db593). */
    animation: cinematic-hero-zoom 30s ease-in-out infinite alternate;
  }
  /* Scale never drops below 1, so the image always covers the wrapper — no
     exposed edges at any point in the cycle. */
  @keyframes cinematic-hero-zoom {
    from {
      transform: scale(1.08) translateZ(0);
    }
    to {
      transform: scale(1) translateZ(0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .event-hero-bg-animated {
      animation: none;
    }
  }

  /*
    THE HERO PLATE.

    Blurred, and OVERSCANNED past its clipping wrapper. A CSS blur goes weak at
    its own element's edges — it mixes in the transparent pixels outside — so
    the outermost band of a blurred element is the least blurred part of it.
    Left flush with the box, that band is what shows behind the logo and the
    copy. `.event-hero-bg-wrapper` already clips, so pushing the plate past it
    puts the weak edge outside the clip where it is never seen.

    Blurred less than the deck's, and brightened rather than dimmed: on
    /featured this sits behind a poster and must not compete with it, whereas
    here it IS the scene with only a logo and a line of type in front. Trailer
    stills are dark to begin with, and blurring a dark image and then dimming it
    is how this hero was once a black rectangle.
  */
  .hero-backdrop-plate {
    /*
      ─── OVER-CONSTRAINED IS WHAT LEFT A GAP DOWN THE RIGHT-HAND EDGE ───────

      `.event-hero-bg-animated` above sets `width: 100%; height: 100%`. When an
      absolutely positioned box has a left, a right AND a width all non-auto,
      CSS drops the `right` — so `inset: -12%` moved this plate 12% to the LEFT
      and then held it at exactly the hero's own width, leaving 12% of the hero
      bare down the right-hand side. Measured on /feed at a 1009px hero: the
      plate stopped at 928px. The same thing happened at the bottom, invisible
      only because the scrim there is nearly black.

      ─── THE OVERSCAN IS A BLUR ALLOWANCE, NOT A ZOOM ───────────────────────

      It exists for one reason: a CSS blur goes weak at its own element's edges,
      because it mixes in the transparent pixels outside, so the outermost band
      is the least blurred part of it. Pushing the plate past the clip puts that
      band where nobody sees it.

      The band is about twice the blur radius — 18px at `blur(9px)`. It was
      specified as 12% instead, which on a 1920px hero is 230px a side: ten
      times what the blur needs, and it read exactly as what it was, a backdrop
      zoomed a third of the way in. Reported as "too far zoomed in", on heroes
      whose key art sets the event's name across the full width of the artwork.

      32px is a generous allowance at this radius and costs ~3% of scale on a
      desktop hero instead of 24%. Tie any change to the blur radius above, not
      to the hero's size.

      Stated as a WIDTH rather than left to `auto` because this is an <img>, and
      the global `img { max-width: 100% }` reset clamps an auto width to the
      containing block — measured: the plate came back 1009px wide inside a
      1009px hero, still shifted, gap unchanged. `max-width: none` is what
      actually lets it overscan.
    */
    --plate-overscan: 32px;
    inset: calc(var(--plate-overscan) * -1);
    width: calc(100% + var(--plate-overscan) * 2);
    height: calc(100% + var(--plate-overscan) * 2);
    max-width: none;
    filter: blur(9px) saturate(1.15) brightness(1.16);
    -webkit-filter: blur(9px) saturate(1.15) brightness(1.16);
  }

  /*
    Shapes the plate the copy sits on. A single flat image behind white text is
    what made this hero read as a stock header — the copy had no ground of its
    own, so it floated. Darkest at the bottom left, where the mark and the line
    are, and clearing toward the trailer on the right.
  */
  .event-hero-bg-wrapper::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    /*
      TWO SCRIMS MULTIPLY. THESE ONES MULTIPLIED TO BLACK.

      A design review called this hero "mostly empty dark space next to the
      logo", and the backdrop gallery WAS behind it the whole time — it was
      just unreadable. Stacked alpha compounds: at the bottom-left corner these
      two came to 1 - (1-0.92)(1-0.88) = 0.99, and at the logo's own position
      about 0.85. A gallery under a 99% black wash is an expensive way to draw
      a black rectangle.

      The vertical one now only does what it has to — seat the bottom edge
      against the section below — and the horizontal one carries legibility for
      the copy, ending sooner and softer. At the logo the pair now comes to
      about 0.55, which is a lit scene with type on it rather than a void.
    */
    background:
      linear-gradient(to top, rgba(5,5,5,0.82) 0%, rgba(5,5,5,0.42) 18%, rgba(5,5,5,0.12) 38%, transparent 62%),
      linear-gradient(to right, rgba(5,5,5,0.62) 0%, rgba(5,5,5,0.34) 24%, rgba(5,5,5,0.10) 46%, transparent 68%);
  }
  /* In normal flow (not absolute) so the banner GROWS with its content instead
