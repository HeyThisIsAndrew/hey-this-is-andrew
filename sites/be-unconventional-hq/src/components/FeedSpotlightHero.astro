    */
    /* Removed massive empty space */
    /* min-height: 62lvh; */
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.97) 0%,
      rgba(0, 0, 0, 0.55) 55%,
      rgba(0, 0, 0, 0.35) 100%
    );
    /* Subtle blur of the background image behind the overlay (content is a child,
