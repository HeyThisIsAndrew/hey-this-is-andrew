<script>
  import { getYouTubeEmbedUrl } from '../lib/youtube-url';
  import { playWhenReady } from '../lib/youtube-start';
  /*
    ─── THE HERO OWNS ITS OWN SWAP ───────────────────────────────────────────

    Clicking a card anywhere on the page loads that item into this hero, and
    the stage plays it.

    This was in FeedGrid.astro, which tied it to one component: /category/<slug>
    mounts this hero but not that grid, so its cards did nothing and its hero
    was stuck on the newest item forever. The behaviour is the hero's, so it
    lives with the hero and every page that mounts one inherits it.

    Delegated from `document` and keyed on `window`, so it survives
    ClientRouter replacing the document, and re-binding is idempotent: the
    previous listener is removed before a new one is added.

    A page with no hero is harmless — the handlers bail on their first lookup.
  */
  document.addEventListener('astro:page-load', () => {
    // Lifecycle-protected Spotlight Swap Event Delegation
    if ((window as any)._spotlightSwapListener) {
      document.removeEventListener('click', (window as any)._spotlightSwapListener);
    }

    /*
      ─── CARRY ASTRO'S STYLE SCOPE ONTO ANYTHING BUILT AT RUNTIME ──────────

      FeedSpotlightHero's <style> is SCOPED. Astro compiles every selector in
      it to `.hero-meta-tag[data-astro-cid-7clh4sw7]` and stamps that attribute
      on each element in the template AT BUILD TIME.

      An element created here has no such attribute, so not one of those rules
      matches it. The hero did not "lose its CSS" on swap — the new nodes were
      never in scope to begin with: chips rendered as bare text with 0 padding
      and no border, and "Read article" lost its rectangle entirely. Confirmed
      by reading the attribute list before and after a swap.

      Copying it from a node that still has one keeps the hash out of this file
      (it changes whenever the component's styles change, and a hardcoded copy
      would rot silently). Applied to descendants too, since the glyph and the
      label are styled by scoped rules of their own.
    */
    const carryScope = (source: Element | null, target: Element) => {
      if (!source) return;
      for (const name of source.getAttributeNames()) {
        if (!name.startsWith('data-astro-cid-')) continue;
        const value = source.getAttribute(name) ?? '';
        target.setAttribute(name, value);
        target.querySelectorAll('*').forEach((child) => child.setAttribute(name, value));
      }
    };

    const swapHandler = (e: MouseEvent) => {
      const card = (e.target as Element).closest('[data-action^="spotlight-"]') as HTMLElement;
      if (!card) return;

      e.preventDefault();
      
      const action = card.getAttribute('data-action');
      const isVideo = action === 'spotlight-video';
      
      const heroBg = document.getElementById('hero-bg') as HTMLImageElement | HTMLDivElement;
      const heroTitle = document.getElementById('hero-title');
      const heroDesc = document.getElementById('hero-description');
      const heroBrandLogo = document.getElementById('hero-brand-logo') as HTMLImageElement;
      const heroIframe = document.getElementById('hero-iframe') as HTMLIFrameElement;
      const heroImage = document.getElementById('hero-image') as HTMLImageElement;
      const heroImageFront = document.getElementById('hero-image-front') as HTMLImageElement;

      if (!heroTitle) return; // Not on a page with the Spotlight Hero

      const title = card.getAttribute('data-title') || '';
      const preview = card.getAttribute('data-preview') || '';
      const image = card.getAttribute('data-image') || '';
      const videoId = card.getAttribute('data-video-id');
      /* Mirrors the payload ContentCard writes into `data-brand`, which is
         resolveEntity()'s output — see src/lib/entity-resolver.ts. `url` and
         `type` are what let the Explore CTA point at /featured/<slug> or
         /events/<slug> without the client re-deriving which kind it holds. */
      let parsedBrand: {
        logo?: string;
        hero?: string;
        slug?: string;
        color?: string;
        url?: string;
        type?: 'brand' | 'event';
        title?: string;
      } = {};
      try {
        const brandStr = card.getAttribute('data-brand');
        if (brandStr) {
          parsedBrand = JSON.parse(brandStr);
        }
      } catch(e) {}
      
      /*
        THE SAME CASCADE THE SERVER RENDERS: override, then hub, then crown.

        This read the hub payload alone. `data-brand` is only present when
        `resolveEntity()` found a hub, and `customHeroLogo` exists precisely
        for items that have none -- so clicking Coyote vs. Acme swapped the
        hero to the BE Unconventional crown while loading /feed fresh showed
        the Ketchup Entertainment mark. Same item, two logos, depending on how
        the reader got there.

        `brandLogo` mirrors `overrideLogo || taxonomyLogo` at the top of this
        file; the crown stays the last resort below.
      */
      const heroLogoOverride = card.getAttribute('data-hero-logo') || '';
      const heroLabelOverride = card.getAttribute('data-hero-brand-label') || '';
      const brandLogo = heroLogoOverride || parsedBrand.logo || '';
      const brandHero = parsedBrand.hero || '';
      /*
        `data-href` FIRST. A feed card is a <div role="button"> — ContentCard
        drops the anchor in this context precisely so the card can swap the
        hero instead of navigating — so `card.querySelector('a')` was null on
        every card and this fell through to '#' every time. The "Read article"
        CTA has been a link to nowhere for as long as it has existed; it only
        looked fine because clicking it reloaded the same page.

        The anchor lookup is kept as the fallback for any caller that does
        render one inside the card.
      */
      const link = card.getAttribute('data-href')
        || card.querySelector('a')?.getAttribute('href')
        || '#';

      const performDOMUpdate = () => {
        // Update Text Content
        heroTitle.textContent = title;

      /*
        THE EYEBROW TAKES THE CARD'S OWN TAGS.

        It used to overwrite a single chip with the word VIDEO or ARTICLE,
        which is why the hero said less about an item than the card that
        promoted it. The slots come straight off the card's own attributes, so
        the two cannot disagree about either the words or which slot they sit in.

        Chips are rebuilt rather than edited: an item can have one tag or
        three, so there is no fixed set of spans to keep in step. textContent
        per chip, never innerHTML on the tag text — these strings come from
        feed data.
      */
      const heroMetaRow = document.getElementById('hero-meta-tags');
      const kind = isVideo ? 'VIDEO' : 'ARTICLE';
      /*
        Read PER SLOT, not from a joined string.

        This used to split `data-tags` on "|" and give the brand accent to
        whichever chip came out first, which meant an item with no brand had
        the accent painted onto REVIEW or ANALYSIS. The card now states each
        slot separately, so the accent can follow the brand and an absent
        brand simply produces no brand chip.
      */
      const cardSlots = ([
        ['brand', card.getAttribute('data-tag-brand')],
        ['type', card.getAttribute('data-tag-type')],
        ['extra', card.getAttribute('data-tag-extra')],
      ] as Array<[string, string | null]>)
        .filter((entry): entry is [string, string] => Boolean(entry[1]));
      if (heroMetaRow) {
        heroMetaRow.textContent = '';
        const chips: Array<[string, string]> = cardSlots.length > 0 ? cardSlots : [['kind', kind]];
        for (const [slot, label] of chips) {
          const chip = document.createElement('span');
          chip.className = `hero-meta-tag${slot === 'brand' ? ' hero-meta-tag--brand' : ''}`;
          chip.setAttribute('data-slot', slot);
          chip.textContent = label;
          carryScope(heroMetaRow, chip);
          heroMetaRow.appendChild(chip);
        }
      }
      if (heroDesc) {
        heroDesc.textContent = preview;
        if (isVideo) {
          heroDesc.classList.remove('line-clamp-3');
          heroDesc.classList.add('line-clamp-2');
        } else {
          heroDesc.classList.remove('line-clamp-2');
          heroDesc.classList.add('line-clamp-3');
        }
      }

      const youtubeBtn = document.querySelector('.feed-hero-youtube-btn') as HTMLElement;
      if (youtubeBtn) {
        youtubeBtn.style.display = isVideo ? 'inline-flex' : 'none';
      }

      const brandColor = parsedBrand.color || '#CC0000';
      function hexToRgbTriple(hex: string) {
        if (!hex) return '204, 0, 0';
        const clean = hex.replace('#', '');
        if (clean.length !== 6) return '204, 0, 0';
        const r = parseInt(clean.substring(0, 2), 16);
        const g = parseInt(clean.substring(2, 4), 16);
        const b = parseInt(clean.substring(4, 6), 16);
        return `${r}, ${g}, ${b}`;
      }
      
      const heroSection = heroTitle.closest('.event-hero') as HTMLElement;
      if (heroSection) {
        heroSection.style.setProperty('--brand-color', brandColor);
        heroSection.style.setProperty('--brand-rgb', hexToRgbTriple(brandColor));
      }

      // Update Brand Logo
      if (heroBrandLogo) {
        const fallbackLogo = heroBrandLogo.getAttribute('data-fallback-logo') || '';
        heroBrandLogo.src = brandLogo || fallbackLogo;
        /* Name the mark for a screen reader. The crown fallback is the site's
           own, so it is labelled as such rather than left with whatever hub the
           previous item happened to have. */
        /* The label follows whichever mark won, or a screen reader is told the
           wrong company -- the same rule the server-rendered cascade uses. */
        heroBrandLogo.alt =
          (heroLogoOverride && (heroLabelOverride || parsedBrand.title)) ||
          (brandLogo && parsedBrand.title) ||
          'BE Unconventional HQ';
        heroBrandLogo.classList.remove('hidden');
      }

      /*
        ─── THE EXPLORE CTA FOLLOWS THE ITEM ──────────────────────────────────

        The button is server-rendered only when the opening item has a hub, so
        it may be absent from the DOM entirely. It is therefore CREATED here
        when a card that has one is promoted in, and REMOVED when a card that
        does not is — rather than being parked at `display: none`, which would
        leave a link to nowhere in the tab order for every item with no hub.

        Inserted LAST, so the row keeps its rendered order: SUBSCRIBE, then
        WATCH ON YOUTUBE, then this. It anchors off the watch link when there
        is one and falls back to SUBSCRIBE when there is not (an article has no
        watch page, so its link is removed). Anchoring off SUBSCRIBE
        unconditionally is what put EXPLORE in the MIDDLE of the two YouTube
        buttons, moving the second one depending on whether the loaded item
        happened to have a hub.

        Stamped with the hero's scoped-style attribute: a node built here
        carries none of Astro's `data-astro-cid-*`, and without it the
        `.feed-hero-hub-btn` rules simply do not match. That was the bug that
        made rebuilt hero chips render as bare text.
      */
      const hubRow = document.querySelector('.feed-hero-actions') || heroBrandLogo?.closest('.hero-copy');
      let hubBtn = document.getElementById('hero-featured-hub-btn') as HTMLAnchorElement | null;

      if (parsedBrand.url && parsedBrand.title) {
        if (!hubBtn && hubRow) {
          const subscribe = hubRow.querySelector('.feed-hero-youtube-btn');
          hubBtn = document.createElement('a');
          hubBtn.id = 'hero-featured-hub-btn';
          hubBtn.className = 'feed-hero-hub-btn';

          const label = document.createElement('span');
          label.id = 'hero-featured-hub-text';
          hubBtn.appendChild(label);

          const glyph = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
          glyph.setAttribute('class', 'feed-hero-hub-glyph');
          glyph.setAttribute('viewBox', '0 0 24 24');
          glyph.setAttribute('width', '14');
          glyph.setAttribute('height', '14');
          glyph.setAttribute('fill', 'none');
          glyph.setAttribute('stroke', 'currentColor');
          glyph.setAttribute('stroke-width', '2');
          glyph.setAttribute('aria-hidden', 'true');
          const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
          path.setAttribute('d', 'M5 12h14M12 5l7 7-7 7');
          glyph.appendChild(path);
          hubBtn.appendChild(glyph);

          carryScope(subscribe || hubRow, hubBtn);
          /* The watch link when it is there, SUBSCRIBE otherwise. */
          const after = hubRow.querySelector('.feed-hero-watch-btn') || subscribe;
          after ? after.after(hubBtn) : hubRow.appendChild(hubBtn);
        }

        if (hubBtn) {
          hubBtn.setAttribute('href', parsedBrand.url);
          const text = hubBtn.querySelector('#hero-featured-hub-text');
          /* textContent, never innerHTML: these titles are feed data. */
          if (text) text.textContent = `EXPLORE ${String(parsedBrand.title).toUpperCase()}`;
        }
      } else if (hubBtn) {
        hubBtn.remove();
      }

      /*
        ─── THE ESCAPE LINK FOLLOWS THE SWAP ──────────────────────────────────

        Same lifecycle as the hub button above, and for the same reason: left
        un-updated it would point at the PREVIOUS item, which is worse than
        being absent because it looks like it works. An article has no watch
        page at all, so the link is REMOVED rather than hidden — a `display:
        none` anchor is still a tab stop pointing at the wrong video.

        Rebuilt nodes are stamped with the hero's scoped-style attribute via
        carryScope(); without it the .feed-hero-watch-btn rules do not match
        and the link renders as bare text.
      */
      const heroNote = document.getElementById('hero-embed-note') as HTMLElement | null;
      if (heroNote) heroNote.hidden = true;

      let watchBtn = document.getElementById('hero-watch-on-youtube') as HTMLAnchorElement | null;
      if (isVideo && videoId) {
        if (!watchBtn && hubRow) {
          watchBtn = document.createElement('a');
          watchBtn.id = 'hero-watch-on-youtube';
          watchBtn.className = 'feed-hero-watch-btn';
          watchBtn.target = '_blank';
          watchBtn.rel = 'noopener noreferrer';
          /* Prefaced with the YouTube mark, like every Watch on YouTube link
             (the global QA sweep, rule 10): cloned from the template. */
          const mark = (document.getElementById('yt-mark-template') as HTMLTemplateElement | null)?.content.cloneNode(true);
          if (mark) watchBtn.appendChild(mark);
          const label = document.createElement('span');
          label.textContent = 'Watch on YouTube';
          watchBtn.appendChild(label);
          const subscribeBtn = hubRow.querySelector('.feed-hero-youtube-btn');
          carryScope(subscribeBtn || hubRow, watchBtn);
          /* Straight after SUBSCRIBE. Appending would land it after a hub
             button this same swap may have just inserted, which is the
             rendered order backwards. */
          subscribeBtn ? subscribeBtn.after(watchBtn) : hubRow.appendChild(watchBtn);
        }
        if (watchBtn) {
          watchBtn.href = `https://www.youtube.com/watch?v=${encodeURIComponent(videoId)}`;
        }
      } else if (watchBtn) {
        watchBtn.remove();
      }

      /*
        No CTA to rebuild. The copy column's Play/Read button was removed (see
        the note in FeedSpotlightHero): the stage pane below carries the action
        for whatever item is loaded, so there is only one control to keep in
        step with a swap instead of two.
      */

      // Reset iframe state
      if (heroIframe) {
        heroIframe.src = 'about:blank';
        heroIframe.style.opacity = '0';
        heroIframe.style.pointerEvents = 'none';
        heroIframe.removeAttribute('data-pending-video');
        const hubStage = document.querySelector('.hub-stage');
        if (hubStage) hubStage.classList.remove('is-playing');
      }

      /*
        ─── A NEW `src` MUST TAKE THE OLD `srcset` WITH IT ───────────────────

        `srcset` WINS over `src`. These four images are rendered with one now,
        for the LCP win on first paint, and the swap below only ever assigned
        `.src` -- so selecting a tile changed the attribute and the browser
        went on painting whichever candidate the old `srcset` had already
        chosen. Reported as "hero does not update properly when selecting new
        tile": the title, chips and copy all changed and the artwork did not,
        so the hero described one item over another one's picture.

        Clearing it costs nothing that matters. A swapped hero is the result of
        a click, so it is never the LCP element, and this is what main does
        today at every width: one URL, no ladder.
      */
      const setImageSrc = (el: HTMLImageElement | null, url: string) => {
        if (!el || !url) return;
        el.removeAttribute('srcset');
        el.removeAttribute('sizes');
        el.src = url;
      };

      const backgroundSrc = brandHero || image;
      if (heroImage && image) { setImageSrc(heroImage, image); heroImage.style.opacity = '1'; }
      if (heroImageFront && image) { setImageSrc(heroImageFront, image); heroImageFront.style.opacity = '1'; }

      /*
        THE STAGE PANE FOLLOWS THE SWAP.

        The pane is what the stage shows before anything plays — still, kind,
        title, Play. Left un-updated it would keep naming the PREVIOUS item
        over the new item's artwork, which is worse than showing nothing:
        the two halves of the hero would contradict each other.

        `is-item` goes back on because the previous item may have been played,
        and play() takes it off (see the play handler below).
      */
      const stageItemStill = document.getElementById('hero-stage-item-still') as HTMLImageElement | null;
      const stageItemKind = document.getElementById('hero-stage-item-kind');
      const stageItemTitle = document.getElementById('hero-stage-item-title');
      const stageItemAction = document.getElementById('hero-stage-item-action');
      if (stageItemStill && image) setImageSrc(stageItemStill, image);
      if (stageItemKind) stageItemKind.textContent = kind;
      if (stageItemTitle) stageItemTitle.textContent = title;
      /*
        THE PANE'S CONTROL CHANGES ELEMENT, NOT JUST ITS LABEL.

        Relabelling it "Read" leaves a <button data-action="play-trailer">
        behind the word: the play handler finds no pending video on an article
        and returns, so the control reads as a dead button. An article needs a
        real <a href>, so the element is rebuilt rather than retitled. Built
        with the DOM API and `textContent`, so a title carrying an apostrophe
        or an angle bracket cannot break out of the markup.
      */
      if (stageItemAction) {
        const nextAction = document.createElement(isVideo ? 'button' : 'a');
        nextAction.id = 'hero-stage-item-action';
        nextAction.className = 'hub-stage-item-action';
        nextAction.textContent = isVideo ? 'Play' : 'Read';
        if (isVideo) {
          (nextAction as HTMLButtonElement).type = 'button';
          nextAction.setAttribute('data-action', 'play-trailer');
        } else {
          (nextAction as HTMLAnchorElement).href = link;
        }
        carryScope(stageItemAction, nextAction);
        stageItemAction.replaceWith(nextAction);
      }
      const stageEl = document.querySelector('.hub-stage');
      if (stageEl) stageEl.classList.add('is-item');
      
      const heroGridContainer = document.querySelector('.hero-grid-container');
      if (isVideo && videoId) {
        // Step 1: Prep the video state but do not play yet!
        if (heroGridContainer) heroGridContainer.classList.add('has-trailer');
        
        if (heroIframe) {
          heroIframe.setAttribute('data-pending-video', videoId);
        }
              } else {
        // Article Mode
        // if (heroGridContainer) heroGridContainer.classList.remove('has-trailer');
                      }


      // Update background image
      if (heroBg && heroBg.tagName === 'IMG' && backgroundSrc) {
        setImageSrc(heroBg as HTMLImageElement, backgroundSrc);
        (heroBg as HTMLImageElement).srcset = '';
      } else if (heroBg && heroBg.tagName === 'DIV' && backgroundSrc) {
        (heroBg as HTMLDivElement).style.backgroundImage = `url('${backgroundSrc}')`;
      }
      };

      /*
        ─── THIS SWAP NO LONGER SUPPRESSES THE PAGE'S VIEW TRANSITIONS ────────

        What stood here stripped `data-astro-transition-scope` off EVERY element
        in the document and set `documentElement.style.viewTransitionName =
        'none'` for the duration of the swap, restoring both afterwards.

        That is what made the navbar blink. The navbar is a persistent,
        transition-scoped element; pulling its scope attribute out from under it
        and blanking the root transition name takes it out of the old snapshot
        and puts it back into the new one, so it disappears and re-enters on a
        swap that never involved it. The fix is not to restore it faster, it is
        not to touch it: nothing outside this wrapper is any of this handler's
        business.

        The crossfade is KEPT. Naming the wrapper is not suppression — it scopes
        the animation to the element actually changing, which is what the global
        blanking was a blunt substitute for. Everything else on the page,
        navbar included, is simply left alone.
      */
      const feedGridWrapper = document.getElementById('feed-grid-wrapper');
      /*
        ─── A PHONE IN LANDSCAPE IS STILL A PHONE ────────────────────────────

        This was `window.innerWidth < 768`, and a phone held sideways reports
        844 to 932. So rotating to landscape flipped it to false and the
        DESKTOP branch ran on the phone: a whole-page `startViewTransition()`
        snapshot, morphing a card from wherever it sat in the horizontal rail
        all the way to the hero, while the smooth scroll below moved the page
        under it. Reported as a "really jarring animation" that "actually
        crashed the website once" -- a full-page snapshot plus a concurrent
        scroll is exactly the shape of thing that exhausts a mobile tab.

        Width alone cannot answer this question. `pointer: coarse` can, and it
        is orientation-independent; the width test stays as the fallback for a
        narrow desktop window. Same expression CinematicGallery.astro uses.
      */
      const isMobile =
        window.matchMedia('(hover: none) and (pointer: coarse)').matches ||
        window.innerWidth <= 768;

      if (!isMobile && (document as any).startViewTransition) {
        if (feedGridWrapper) feedGridWrapper.style.viewTransitionName = 'feed-grid-manual';

        const transition = (document as any).startViewTransition(() => {
          performDOMUpdate();
        });

        transition.finished.finally(() => {
          if (feedGridWrapper) feedGridWrapper.style.viewTransitionName = '';
        });
      } else {
        performDOMUpdate();
      }

      /*
        BRING THE TAPPED CARD INTO ITS RAIL BEFORE LEAVING IT.

        The rails scroll horizontally, so a card can be tapped while it is half
        off the edge of the screen. Selecting it used to leave it there, which
        is what made the swap read as something jumping out of nowhere: the
        hero changed to an item the reader could only half see.

        DONE ON THE RAIL, NOT WITH `scrollIntoView`. That method can move any
        scrollable ancestor, including the document, and `block: 'nearest'` only
        promises it will not move one that is already in view. This runs
        alongside the scroll to the hero below, so "probably will not move the
        page" is not good enough on the path that was crashing tabs. Setting
        `scrollLeft` on the rail can move exactly one thing: the rail.
      */
      const rail = card.closest('[data-rail], .feed-row-rail') as HTMLElement | null;
      if (rail && rail.scrollWidth > rail.clientWidth) {
        const target =
          card.offsetLeft - rail.clientWidth / 2 + card.offsetWidth / 2;
        const max = rail.scrollWidth - rail.clientWidth;
        rail.scrollTo({ left: Math.max(0, Math.min(target, max)), behavior: 'smooth' });
      }

      // Smooth scroll to top so the user sees the hero
      window.scrollTo({ top: 0, behavior: 'smooth' });
    };

    (window as any)._spotlightSwapListener = swapHandler;
    document.addEventListener('click', swapHandler);

    // Step 2: The Play Action
    if ((window as any)._spotlightPlayListener) {
      document.removeEventListener('click', (window as any)._spotlightPlayListener);
    }

        const playHandler = (e: MouseEvent) => {
      const target = e.target as HTMLElement;

      /*
        The stage pane's own control is the only thing that starts this hero.
        Still delegated from the document rather than bound to the element: the
        pane's action is REPLACED on every swap (button for a video, anchor for
        an article), so a listener bound directly to it would be thrown away
        with the node it was attached to.
      */
      const isHeroCta = target.closest('#hero-stage-item-action');
      if (!isHeroCta) return;

      const isCtaVideo = isHeroCta.tagName.toLowerCase() === 'button';

      const heroIframe = document.getElementById('hero-iframe') as HTMLIFrameElement;
      
      if (!heroIframe) return;
      
      const videoId = heroIframe.getAttribute('data-pending-video');
      
      if (isCtaVideo && videoId) {
        e.preventDefault();
        /*
          ─── NO `autoplay=1`, AND THAT IS THE POINT ─────────────────────────

          A reader on Chrome/Windows hit a YouTube SIGN-IN wall in this stage,
          on a video that is not age restricted, that plays for everyone else,
          and that played fine for him in this site's OTHER player — the card
          lightbox in Layout.astro — on the same machine in the same session.

          Two players, one site, one origin, one video, and one difference:
          the lightbox asks for `?rel=0&modestbranding=1&enablejsapi=1` and
          this stage asked for the same plus `autoplay=1`. An embed that
          starts itself is the signature YouTube's bot check looks for, and
          that check is decided per viewer, which is exactly why it reproduces
          for one reader and for nobody testing it.

          So the URL is now byte-identical to the player that works, and the
          video is started through the jsapi instead (see below). If the wall
          ever comes back on this stage, the URL is no longer what separates
          the two and the next thing to look at is the viewer's side, not
          this line.

          `playsinline=1` is added, which the lightbox does not need: a full
          screen takeover on iOS would tear this stage out from under the PiP
          logic that owns it.
        */
        heroIframe.src = getYouTubeEmbedUrl(videoId, true);

        /*
          ─── ASK THE PLAYER TO TALK BACK, THEN ASK IT TO PLAY ───────────────

          `enablejsapi=1` was already on this URL and nothing had ever used it.
          One postMessage opens the channel, after which the player posts its
          events and `onError` is the one that matters:

            2    the request contained an invalid parameter
            5    the video cannot be played in an HTML5 player
            100  the video is private, or has been removed
            101  the owner does not allow embedded playback
            150  the same as 101

          `playVideo` on the same channel is what replaces `autoplay=1`, so
          dropping that parameter costs the visitor nothing: it is still one
          click on the stage's own Play button. The difference is that the
          embed no longer ANNOUNCES an unattended start in its URL.

          If YouTube refuses the command, the frame falls back to its ordinary
          poster and play button, which is a video one tap away. That is worth
          having whether or not the bot check was ever the cause, because the
          state it replaces was a sign-in wall with no way past it.

          `{ once: true }` and bound here rather than on the element at mount:
          the handshake is only valid against the document this assignment is
          loading, and the frame's previous load was `about:blank`, which fires
          the same event with nothing to talk to.

          None of this is the escape hatch. The "Watch on YouTube" link in the
          copy column is rendered whether or not this channel ever answers.
        */
        /*
          The handshake and the play command now go through
          src/lib/youtube-start.ts, which waits for the player to report
          ready before asking it to play. Sending both on `load` (as this did)
          reached the frame before YouTube's player was listening, so the
          command was dropped and the reader had to press play twice.
        */
        /* One start in flight per frame: a new play (or a swap to another
           video) cancels the last, and the reveal checks the frame still
           holds THIS video, so a stop or swap inside the wait is never
           followed by a late reveal of a frame that has moved on. */
        (window as any)._heroStartCancel?.();
        const startedSrc = heroIframe.src;
        (window as any)._heroStartCancel = playWhenReady(heroIframe, {
          onReady: () => {
            if (heroIframe.src === startedSrc) heroIframe.style.opacity = '1';
          },
        });

        /* The iframe starts transparent so its about:blank document cannot
           flash above the stage still, and it STAYS transparent until the
           player is ready (playWhenReady's onReady above, which also fires
           after 3s if the player never answers, so it cannot stay hidden).
           Revealing it at once flashed the blank frame over the hero art. */
        heroIframe.style.pointerEvents = 'auto';
        
        const hubStage = document.querySelector('.hub-stage');
        if (hubStage) {
            /*
              `is-item` HAS TO COME OFF. It takes .hub-stage-video to opacity 0,
              so leaving it on starts the video behind an invisible frame — the
              audio plays and the picture never arrives. /featured hit exactly
              this and removes the class at the same point.
            */
            hubStage.classList.remove('is-item');
            hubStage.classList.add('is-playing');
        }
      }
    };
    
    (window as any)._spotlightPlayListener = playHandler;
    document.addEventListener('click', playHandler);

    /*
      ─── WHEN YOUTUBE SAYS NO, SAY SO ──────────────────────────────────────

      Bound to `window`, which OUTLIVES a ClientRouter navigation, so it is
      registered once and guarded rather than added per page-load the way the
      two click handlers above are. It resolves #hero-iframe on every message
      instead of closing over one, so it keeps working against the next page's
      stage.

      Origin-checked twice: the message has to come from the player's own
      origin AND from this frame's contentWindow. Any page can postMessage to
      any window, so the origin alone would let a third-party frame on the
      same page raise this note.
    */
    if (!(window as any)._heroEmbedErrorBound) {
      (window as any)._heroEmbedErrorBound = true;

      window.addEventListener('message', (event: MessageEvent) => {
        if (event.origin !== 'https://www.youtube-nocookie.com') return;

        const frame = document.getElementById('hero-iframe') as HTMLIFrameElement | null;
        if (!frame || event.source !== frame.contentWindow) return;

        let payload: any;
        try {
          payload = typeof event.data === 'string' ? JSON.parse(event.data) : event.data;
        } catch {
          return; // Not JSON, so not a player event. Nothing to do.
        }

        if (payload && payload.event === 'onError') {
          const note = document.getElementById('hero-embed-note') as HTMLElement | null;
          if (note) note.hidden = false;
        }
      });
    }
  });
</script>
