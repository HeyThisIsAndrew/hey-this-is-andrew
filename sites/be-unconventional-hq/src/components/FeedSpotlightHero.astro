  }

  .event-hero-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    width: 100%;
    max-width: 900px;
  }
  .event-hero-content > * {
    max-width: 100%;
  }
  
  /*
    ─── ONE BACKDROP, NOT TWO IMAGES BLENDED ─────────────────────────────────

    `.hub-stage-bg` used to sit above this: a SECOND copy of the same picture,
    masked into the right-hand 72% of the hero, blurred 26px and brightened, so
    that it feathered across the middle into `.hero-backdrop-plate` behind it.

    It is gone because it does not survive contact with real artwork. The two
    copies are at different scales and different crops, so wherever they overlap
    the same shapes appear twice slightly out of register. Reported as "a blob
    of images meshing", on PAX Unplugged, whose key art is line work: exactly
    the kind of picture that shows a double exposure.

    `background-size: contain` made it worse on the wide banners. A contained
    plate leaves bare ground either side of itself, and the brightness lift on
    that layer meant the bare ground read as a lit panel rather than as nothing.

    The hero is ONE blurred image now, centred and covering, at every width.
    That is the owner's decision, not an oversight: whatever a second layer buys
    on a hand-picked asset, it costs on the nineteen it was not picked for.
  */
  /* Lit without needing a single asset, so a hub with no logo still reads. */
  .hub-stage-wash {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: radial-gradient(90% 80% at 76% 46%,
      rgba(var(--brand-rgb, 204,0,0), 0.20) 0%,
      rgba(var(--brand-rgb, 204,0,0), 0.09) 36%,
      rgba(var(--brand-rgb, 204,0,0), 0.02) 60%,
      transparent 78%);
  }

  /* The stage itself sits in the grid's `trailer` cell. */
  /*
    `.hero-trailer.hub-stage`, not `.hub-stage`. The stage carries BOTH classes
    and `.hero-trailer { max-width: 600px }` is declared later in this file, so
    a single-class rule here lost on source order and the stage stayed capped at
    600 however large the column got. Two classes wins on specificity instead of
    relying on where the rule happens to sit.
  */
  .hero-trailer.hub-stage {
    position: relative;
    width: 100%;
    max-width: 600px;
    margin: 0 auto;
    aspect-ratio: 16 / 9;
    /* NO overflow: hidden — HARD RULE 3, the iframe lives in here. */
  }

  .hub-stage-mark {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    /* HARD RULE 6: the glow is on the WRAPPER, never on the <img>. */
    filter: drop-shadow(0 0 38px rgba(var(--brand-rgb, 204,0,0), 0.40))
            drop-shadow(0 16px 40px rgba(0,0,0,0.8));
    transition: opacity 0.9s ease, transform 0.9s cubic-bezier(0.2, 0.8, 0.2, 1);
    opacity: 0.97;
  }

  /* A pane is up, so the frame underneath it must not take the click that was
     aimed at the pane's own Play button. `opacity: 0` hides a layer; it does
     not stand it down. */
  .hub-stage.is-item .hub-stage-video {
    pointer-events: none;
  }

  .feed-hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

