---
/**
 * The one `#hq-chalk` filter every <ChalkIcon /> points at.
 *
 * Mounted once per page. A low-frequency displacement just roughens the
 * stroke edge the way chalk drags on a board; it is decoration, so a browser
 * that skips SVG filters still draws the icon, clean.
 */
---

<svg class="chalk-filter-defs" width="0" height="0" aria-hidden="true" focusable="false">
  <filter id="hq-chalk" x="-10%" y="-10%" width="120%" height="120%">
    <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" seed="7" result="noise" />
    <feDisplacementMap in="SourceGraphic" in2="noise" scale="1.4" xChannelSelector="R" yChannelSelector="G" />
  </filter>
</svg>

<style>
  .chalk-filter-defs {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }
</style>
