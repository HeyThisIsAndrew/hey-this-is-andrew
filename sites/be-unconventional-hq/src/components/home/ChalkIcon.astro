---
/**
 * Hand-drawn "chalk" icons for the homepage.
 *
 * Authored here, not pulled from an icon library: the brief is a chalk hand,
 * and a vector set reads as clip art next to it. The paths are deliberately a
 * little off — lines overshoot their corners, closes do not quite meet — and
 * the whole icon is roughened by the `#hq-chalk` filter, defined ONCE by
 * <ChalkFilter /> on the page. Without that filter (it is purely decorative)
 * the icons still render, just clean.
 *
 * Stroke only, `currentColor`, round caps, so colour comes from the parent.
 * Always decorative: `aria-hidden`, and the label lives in adjacent text.
 */
export type ChalkIconName =
  | 'film' | 'tv' | 'games' | 'events' | 'latest'
  | 'intel' | 'featured' | 'watching' | 'instagram'
  | 'quote' | 'mic' | 'arrow-left' | 'arrow-right' | 'play' | 'pause' | 'note-arrow';

interface Props {
  name: ChalkIconName;
  size?: number | string;
  class?: string;
}

const { name, size = 28, class: className = '' } = Astro.props;

const PATHS: Record<ChalkIconName, string> = {
  film:
    'M5.2 13.4 L27.1 13.1 L26.8 27.2 L5.4 27.4 Z' +
    ' M4.6 12.6 L25.9 6.3 L27.2 10.4 L5.8 16.4' +
    ' M10.2 11.1 L12.6 14.9 M16.3 9.4 L18.6 13.2 M22.1 7.7 L24.3 11.4' +
    ' M9.4 19.3 L22.8 19.1',
  tv:
    'M4.3 11.2 C4.1 9.8 5 9.1 6.4 9.2 L25.8 9 C27.2 9 28 9.8 27.9 11.3 L27.6 24.4 C27.6 25.8 26.8 26.5 25.4 26.4 L6.6 26.7 C5.1 26.7 4.4 25.9 4.4 24.6 Z' +
    ' M8 13 L21.8 12.8 L21.6 23.1 L8.2 23.3 Z' +
    ' M11.4 4.1 L16 9 L21.3 3.6' +
    ' M24.9 14.2 L25 14.4 M24.8 18.1 L25 18.3',
  games:
    'M9.6 10.7 C6.1 10.6 4.2 13.4 3.8 18.6 C3.5 22.4 5.3 24.4 7.4 23.6 C9.3 22.9 10.2 20 12.5 19.8 L19.8 19.7 C22 19.9 22.9 22.9 24.8 23.5 C27 24.2 28.6 22 28.2 18.3 C27.7 13.2 25.8 10.5 22.3 10.6 Z' +
    ' M9.2 13.8 L9.3 18.1 M7.1 16 L11.4 15.9' +
    ' M21.6 14.1 L21.7 14.3 M24.2 16.4 L24.3 16.6',
  events:
    'M16.1 28.2 C11.6 22.3 8.2 17.6 8.3 12.6 C8.4 8 11.8 4.4 16.2 4.3 C20.6 4.4 23.9 8.1 23.8 12.6 C23.7 17.4 20.5 22.3 16.1 28.2' +
    ' M16.1 9.4 C18 9.4 19.3 10.8 19.2 12.6 C19.1 14.4 17.8 15.6 16 15.6 C14.2 15.5 12.9 14.2 13 12.4 C13.1 10.7 14.4 9.5 16.3 9.5' +
    ' M11.2 28.4 L21.4 28.1',
  latest:
    'M16.2 3.6 L18.4 12.7 L27.6 13.9 L19.6 18.2 L21.9 27.5 L16 21.4 L9.9 27.3 L12.3 18.1 L4.4 13.6 L13.7 12.6 Z',
  intel:
    'M6.1 25.9 L7.4 20.1 L21.8 5.6 L26.5 10.3 L12.1 24.7 Z' +
    ' M19.3 8.1 L24 12.8 M7.5 20.3 L11.9 24.6 M5.2 27.4 L27.1 27.1',
  featured:
    'M16 4.2 L19.3 11.6 L27.4 12.4 L21.3 17.9 L23.1 25.9 L16 21.8 L8.9 26 L10.8 17.8 L4.6 12.3 L12.8 11.5 Z',
  watching:
    'M4.2 8.3 L27.9 8 L27.6 24.2 L4.5 24.5 Z M13.4 12.4 L20.6 16.2 L13.3 20.2 Z M3.1 27.6 L28.8 27.3',
  instagram:
    'M9.3 4.6 L22.8 4.4 C25.6 4.5 27.5 6.4 27.6 9.3 L27.4 22.8 C27.3 25.6 25.4 27.5 22.6 27.5 L9.1 27.6 C6.4 27.5 4.5 25.6 4.4 22.7 L4.6 9.2 C4.7 6.5 6.5 4.7 9.3 4.6' +
    ' M16 10.7 C19.1 10.7 21.3 12.9 21.3 16 C21.2 19.1 19 21.3 15.9 21.2 C12.9 21.1 10.7 18.9 10.8 15.9 C10.9 12.8 13.1 10.6 16.1 10.8' +
    ' M23.1 8.7 L23.2 8.9',
  /* Inside the HQ: the studio mic the channel is recorded on. */
  mic:
    'M12.4 8.6 C12.5 5.8 14.1 4.2 16.1 4.2 C18.2 4.3 19.7 5.9 19.6 8.7 L19.5 15.1 C19.4 17.8 17.9 19.4 15.9 19.3 C13.8 19.3 12.3 17.6 12.4 14.9 Z' +
    ' M8.9 13.6 C8.8 19 11.9 22.6 16 22.6 C20.2 22.5 23.2 19 23.1 13.5' +
    ' M16 22.7 L16.1 27.3 M11.2 27.6 L20.9 27.4' +
    ' M12.6 9.8 L15.1 9.7 M12.6 12.7 L15 12.6',
