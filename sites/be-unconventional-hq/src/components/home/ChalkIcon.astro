    ' M18.2 21.8 C18.1 15.4 20.6 11 25.9 8.6 M18.3 21.4 C18.4 18.3 20.2 16.7 22.6 16.9 C25 17.1 26.2 18.8 26 21.1 C25.8 23.3 24.2 24.6 22.1 24.5 C20 24.4 18.5 23.3 18.3 21.4',
  'arrow-left': 'M20.3 5.8 L9.6 16.1 L20.6 26.4',
  'arrow-right': 'M11.7 5.8 L22.4 16.1 L11.4 26.4',
  play: 'M10.3 6.1 L25.4 16.2 L10.1 26.1 Z',
  pause: 'M10.6 6.4 L10.8 25.8 M21.2 6.2 L21.4 25.9',
  'note-arrow': 'M4 6 C10 7 17 12 20.5 22.5 M14.6 20.6 L20.9 23.4 L23.4 16.9',
};

const d = PATHS[name] ?? '';
---

<svg
  class:list={['chalk-icon', className]}
  width={size}
  height={size}
  viewBox="0 0 32 32"
  fill="none"
  stroke="currentColor"
  stroke-width="1.9"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <path d={d} filter="url(#hq-chalk)" />
</svg>
