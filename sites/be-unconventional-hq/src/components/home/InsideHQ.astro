---
/**
 * Inside the HQ: what the HQ is, and who founded and edits it.
 *
 * THE PUBLICATION IS THE SUBJECT; ANDREW IS THE PERSON BEHIND IT. The
 * headline, descriptor and first line are the HQ's own brand lines, worded
 * as on its Instagram bio and the About page title, so a reader arriving
 * from either sees the same three lines. The copy
 * leads with what BE Unconventional HQ covers and how, then names Andrew as
 * its Founder & Editor, with his background attributed to him. It used to
 * say "more than a decade in games and technology ... informs the coverage"
 * with no subject, which read as the HQ's own biography and tipped the
 * section toward a creator bio.
 *
 * EVERY LINE IS THE ABOUT PAGE'S (src/pages/about.astro), quoted or cut down,
 * never new claims. Change the wording there first, then here.
 *
 * The chalk frame and the motto's texture use the page's one #hq-chalk filter
 * (ChalkFilter.astro), on wrappers and text, never on the <img> (hard rule 6
 * forbids drop-shadow filters on images; nothing here filters the photo).
 */
import { Image } from 'astro:assets';
import HomeSectionHeader from './HomeSectionHeader.astro';
import headshot from '../../assets/andrew-headshot.webp';
---

<section class="home-section inside-hq" aria-labelledby="home-inside-title">
  <div class="home-container">
    <HomeSectionHeader
      icon="mic"
      id="home-inside-title"
      title="Inside the HQ"
      descriptor="Film | TV | Games | Events"
      href="/about"
      linkLabel="About the HQ"
    />

    <div class="ihq-grid">
      <figure class="ihq-portrait">
        <span class="ihq-frame" aria-hidden="true"></span>
        <Image
          src={headshot}
          alt="Andrew Baxter, founder and editor of BE Unconventional HQ"
          widths={[320, 480, 640, 960]}
          sizes="(max-width: 767px) 60vw, 320px"
          loading="lazy"
          decoding="async"
          class="ihq-photo"
        />
        <figcaption class="ihq-caption">
          <a href="/author/andrew-baxter">Andrew Baxter</a>
          <span>Founder &amp; Editor</span>
        </figcaption>
      </figure>

      <div class="ihq-copy">
        <p class="ihq-principle">
          Where nerd culture gets cinematic
        </p>
        <p class="ihq-body">
          If we talk cinema, our content should look like cinema. BE
          Unconventional HQ is an independent home for people who love the
          craft behind the stories. No clickbait, no artificial outrage: just
          coverage that slows down and looks at the details.
        </p>
        <p class="ihq-body">
          Founded and edited by Andrew Baxter. More than a decade in games and
          technology, including time at Sony Interactive Entertainment, gives
          him a working knowledge of how these things are built, tested and
          shipped.
        </p>
        <p class="ihq-motto">
          <span>Be yourself.</span>
          <span>Be passionate.</span>
          <span class="ihq-motto-last">Be unconventional.</span>
        </p>
      </div>
    </div>
  </div>
</section>
