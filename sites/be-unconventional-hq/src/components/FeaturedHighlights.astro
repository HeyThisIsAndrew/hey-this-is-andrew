---
import ContentCard from './ContentCard.astro';
import { getVideosUnified } from '../lib/videos-source';
import { getPublishedArticles, articleHref } from '../lib/articles';
import { getCardImageSources } from '../lib/card-images';
import { pickFeaturedHighlights } from '../lib/featured-highlights';

interface Props {
  /**
   * A curated set to show instead of the automatic pick below, in the order
   * given. The homepage's Featured section passes one story world (e.g.
   * Lanterns) so it gets THIS player, rows and safeguards (the escape link,
   * embed-pause) rather than a second implementation of them. Items are in
   * the feed's record shape (getVideoItems / getArticleFeedItems).
   */
  items?: any[];
  /** The lead card's image `sizes`, where this box is laid out wider than
      on production's homepage (ContentCard `imageSizes`). */
  heroImageSizes?: string;
  /** False where the box sits below the fold: its lead image is then lazy
      and normal priority, not the page's LCP candidate (ContentCard `lcp`). */
  leadIsLcp?: boolean;
}
const { items: curated, heroImageSizes, leadIsLcp = true } = Astro.props;

const allVideos = await getVideosUnified();
const allArticles = getPublishedArticles();

// The pick itself lives in src/lib/featured-highlights.ts, shared with the
// homepage hero's category panels.
const autoItems = pickFeaturedHighlights(allVideos, allArticles, articleHref);
const highlightedItems = curated && curated.length > 0 ? curated.filter(Boolean) : autoItems;

---

<div class="featured-highlights animate-on-scroll">
  <div class="fh-layout">
    <!-- Left Side: 50% width, single large focused tile -->
    <div class="fh-left">
      {highlightedItems.map((item, index) => (
        <div class={`fh-hero-card ${index === 0 ? 'active' : ''}`} data-index={index}>
          <ContentCard item={item} index={index} variant="hero" imageSizes={heroImageSizes} lcp={leadIsLcp ? undefined : false} />
        </div>
      ))}
    </div>
    
    <!-- Right Side: 50% width, vertical list -->
    <div class="fh-right">
      {highlightedItems.map((item: any, index: number) => {
        if (!item) return null;
        const title = item.title;
        const badge = item.category || (item.type === 'video' || item.contentType === 'video' ? 'Video' : 'Article');
        
        // Use the existing utility to get the best thumbnail
        const rawImage = item.image ?? item.thumbnail;
        const { src, srcset } = getCardImageSources(rawImage);

        // State matching
        const isActive = index === 0;

        const isVideo = item.type === 'video' || item.contentType === 'video';
        return (
          <button type="button" class={`fh-row ${isActive ? 'is-active' : ''} is-${isVideo ? 'video' : 'article'}`} data-index={index} aria-pressed={isActive ? 'true' : 'false'}>
            <div class="fh-row-progress"></div>
            <div class="fh-row-thumb">
              {/*
                `sizes` is not optional here. With `w` descriptors and no
                `sizes`, the spec's default source size is 100vw — so for a
                thumbnail the CSS pins at 140px the browser was computing a
                need of a full viewport width and picking `maxresdefault`
                (1280w) every time on desktop. That is ~9x the pixels the box
                can show, and it is also the rendition YouTube does not always
                generate, so the widest-possible pick was also the likeliest
                to 404. `.fh-row-thumb` is 140px at every breakpoint (no media
                query touches it), so the value is exact rather than an
                estimate — the shared CARD_IMAGE_SIZES does not apply, that
                one describes the card grid.

                Recovery when a rendition is missing anyway is owned by the
                global fail-safe in Layout.astro, NOT by an `onerror` here —
                an inline handler cannot see YouTube's HTTP 200 placeholder
                response, and it races the capture-phase listener.
              */}
              <img src={src} srcset={srcset} sizes={srcset ? '140px' : undefined} alt={title} loading="lazy" decoding="async" />
            </div>
            <div class="fh-row-info">
              <span class="fh-row-badge">{badge}</span>
              <h4 class="fh-row-title">{title}</h4>
            </div>
          </button>
        );
      })}
    </div>
  </div>
</div>

<style>
  .featured-highlights {
    width: 100%;
    margin-top: 1rem;
  }
  
  .fh-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  /* 60/40 Split on Desktop & Landscape Tablet */
  @media (min-width: 768px) {
    .fh-layout {
      grid-template-columns: 1.5fr 1fr;
      align-items: stretch; /* Forces equal height columns */
    }
  }

  .fh-left {
    display: grid; /* Stack cards via grid */
    min-width: 0; /* Prevents grid blowout */
  }

  /* Stack all cards perfectly on top of each other for a true cross-fade */
  .fh-hero-card {
    grid-area: 1 / 1;
    /*
      The same depth the rows beside it carry. It matters more here than
      anywhere: the hero card and the four rows are one component, and giving
      the small tiles a raised edge while the large one stayed flat would have
      read as the big card sitting BEHIND its own list.

      The cards are stacked in a single grid area and cross-faded, so every
      one of them carries this and the shadow fades with the card it belongs
      to rather than being painted once on the container.
    */
    box-shadow: var(--shadow-tile);
    /*
      The `min-width: 0` on .fh-left above is NOT enough on its own — this is
      the grid ITEM, and a grid item's default `min-width: auto` floors it at
      its own min-content width. ContentCard's hero variant sets
      `white-space: nowrap` on `.content-card-dynamic-tags`, so that floor is
      an entire unbreakable tag line ("WARNER BROS | REVIEW"), which measured
      478px inside a 390px phone viewport and pushed the card — and the
      headline and excerpt with it — off the right edge.

      Zeroing it lets the card shrink to its track, which is also what finally
      lets the `overflow: hidden` + `text-overflow: ellipsis` already declared
      on that tag row actually do its job instead of being overruled from
      above.
    */
    min-width: 0;
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
    transition: opacity 0.5s ease, visibility 0.5s ease;
    display: flex;
    flex-direction: column;
  }

  .fh-hero-card.active {
    opacity: 1;
    visibility: visible;
    z-index: 2;
    pointer-events: auto;
  }

  /*
    ─── THE SHARED PLAYER, BEHIND THE CARD ───────────────────────────────
    One YouTube player serves every slide (see "ONE PLAYER FOR THE WHOLE
    SHELF" in the script). It lives in `.fh-player-layer`, created by the
    script inside `.fh-left` and laid over the active card's media box, at
    z-index 1: UNDER the active card (2), so the card's gradient, play mark
    and watermark still sit on top of the video.

    Nothing between the frame and the document clips it (hard rule 3): the
    layer's only ancestors are this column and the shelf, and the card that
    used to be its clipping parent is no longer an ancestor at all.
  */
  .fh-left {
    position: relative;
  }

  .fh-left :global(.fh-player-layer) {
    position: absolute;
    z-index: 1;
    pointer-events: none;
  }

  .fh-left :global(.fh-player-layer iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    transform: translateZ(0);
    /* Transparent while it fades up; `color-scheme` stops the embedded
       document defaulting to a white canvas on iOS Safari. */
    background: transparent;
    color-scheme: dark;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.5s ease;
  }

  .fh-left :global(.fh-player-layer.is-visible iframe) {
    opacity: 1;
  }

  .fh-left :global(.fh-player-layer.is-instant iframe) {
    transition: none;
  }

  /*
    SEE-THROUGH WHILE HOSTING. The card is opaque (`.content-card` paints
    the surface colour), which would hide the player behind it. While it
    hosts the player its surface moves to the copy below the media box, and
    the media box itself goes transparent; its poster image still covers the
    player until the preview is actually playing (`is-playing-inline` hides
    the poster, ContentCard.astro).
  */
  .fh-left :global(.content-card.has-player) {
    background: transparent;
  }

  .fh-left :global(.content-card.has-player .content-card-body) {
    background: var(--color-surface);
  }

  .fh-left :global(.content-card.has-player .content-card-media) {
    background: transparent;
  }

  /*
    THE PREVIEW FADES IN BY THE POSTER FADING OUT. ContentCard drops the
    poster in 0.1s, which was invisible while the frame sat IN FRONT of it
    and faded up over it. Behind the card, the frame's own fade happens
    under an opaque poster, and the 0.1s drop read as a hard cut. So the
    frame is shown at once behind the poster (`is-instant`, see
    onPlayerStateChange) and the poster crossfades away above it. A reader's
    own press still snaps (`is-user-activated` is excluded).
  */
  .fh-left :global(.content-card.has-player .content-card-media.is-playing-inline:not(.is-user-activated) img.content-card-img),
  .fh-left :global(.content-card.has-player .content-card-media.is-playing-inline:not(.is-user-activated))::after {
    transition: opacity 0.8s ease !important;
  }

  /*
    AFTER THE READER PRESSES PLAY, the frame takes the clicks so YouTube's
    own click-to-pause works (the same hand-over `is-user-activated` made
    when the frame was inside the card). The card is on top of the frame, so
    it has to become click-through over the media box: every box in the
    card stops catching the pointer, and the copy below the media box (the
    title, the "Watch now" link) takes it back.
  */
  .fh-left :global(.fh-hero-card:has(.content-card-media.is-user-activated)),
  .fh-left :global(.fh-hero-card:has(.content-card-media.is-user-activated) *) {
    pointer-events: none;
  }

  .fh-left :global(.fh-hero-card:has(.content-card-media.is-user-activated) .content-card-body),
  .fh-left :global(.fh-hero-card:has(.content-card-media.is-user-activated) .content-card-body *) {
    pointer-events: auto;
  }

  .fh-left :global(.fh-player-layer.is-user-activated iframe) {
    pointer-events: auto;
  }

  .fh-row-progress {
    position: absolute;
    bottom: 0;
    left: 0;
    height: 4px;
    background: var(--color-accent, #cc0000);
    width: 100%;
    transform: scaleX(0);
    transform-origin: left;
    z-index: 10;
    box-shadow: 0 2px 15px rgba(204, 0, 0, 0.8);
    /* Transition applied dynamically via JS to handle pause/resume/reset */
  }

  /* Ensure the existing ContentCard fills its new 50% container nicely */
  .fh-left :global(.video-card-home) {
    flex: 1;
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .fh-right {
    display: flex;
    flex-direction: row;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    gap: 1rem;
    padding-bottom: 0.5rem; /* space for scrollbar */
    min-width: 0; /* Prevents grid blowout */
    /* Hide scrollbar for cleaner look */
    scrollbar-width: none;
  }
  .fh-right::-webkit-scrollbar {
    display: none;
  }

  /* Desktop layout */
  @media (min-width: 768px) {
    .fh-right {
      flex-direction: column;
      justify-content: space-between;
      overflow-x: visible;
      overflow-y: visible;
      scroll-snap-type: none;
      gap: 0.5rem;
      padding-bottom: 0;
    }
  }

  .fh-row {
    flex: 0 0 260px; /* Carousel fixed sizing */
    scroll-snap-align: start;
    position: relative;
    display: flex;
    flex-direction: column; /* Stack vertically on mobile */
    gap: 0.75rem;
    align-items: flex-start;
    padding: 0.75rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
    /* See --shadow-tile in global-base.css. `transition: all` below already
       picks this up; only the resting value was missing. */
    box-shadow: var(--shadow-tile);
    text-align: left;
    cursor: pointer;
    color: var(--color-white, #ffffff);
    transition: all 0.4s ease;
  }

  @media (min-width: 768px) {
    .fh-row {
      flex: 1; /* Stretch rows to evenly fill height on desktop */
      flex-direction: row; /* Side-by-side on desktop */
      gap: 1rem;
      align-items: center;
      padding: 0.5rem 0.75rem;
      scroll-snap-align: none;
    }
  }

  /*
    ─── DIM THE ARTWORK, NOT THE TEXT ──────────────────────────────────────

    The inactive state used to be `opacity: 0.6` + `grayscale(40%)` on the
    whole row. Both compose onto every descendant, so the badge was being
    rendered at 60% over a near-black background AND desaturated toward grey
    — Lighthouse measured the result as a contrast failure, and no red is
    recoverable through that: even a near-white red only reaches ~4.0:1 once
    it has been through 0.6 opacity, against a 4.5:1 requirement for text
    this size.

    Since a child cannot opt out of an ancestor's opacity or filter, the
    dimming has to move DOWN rather than be overridden. It lands on the
    thumbnail, which is the dominant visual and carries the inactive read on
    its own, while the text dims by colour instead — a value that can be
    picked to stay above threshold.
  */
  .fh-row-thumb {
    opacity: 0.6;
    filter: grayscale(40%);
    transition: opacity 0.4s ease, filter 0.4s ease;
  }

  .fh-row:hover .fh-row-thumb {
    opacity: 0.8;
    filter: grayscale(0%);
  }

  .fh-row.is-active .fh-row-thumb {
    opacity: 1;
    filter: grayscale(0%);
  }

  .fh-row::before {
    content: '';
    position: absolute;
    left: -1px; /* Align over the border */
    top: 0;
    bottom: 0;
    width: 3px;
    background: var(--color-accent, #cc0000);
    box-shadow: 0 0 10px var(--color-accent, #cc0000);
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .fh-row:hover {
    background: rgba(255, 255, 255, 0.05);
  }

  .fh-row.is-active {
    background: radial-gradient(circle at left, rgba(204, 0, 0, 0.15) 0%, rgba(255, 255, 255, 0.02) 100%);
    border-color: rgba(204, 0, 0, 0.2);
  }

  .fh-row.is-active::before {
    opacity: 1;
  }

  .fh-row-thumb {
    width: 100%; /* full width of tile on mobile */
    height: auto;
    aspect-ratio: 16 / 9;
    flex-shrink: 0;
    overflow: hidden;
    background: #111;
  }

  @media (min-width: 768px) {
    .fh-row-thumb {
      width: 140px; /* fixed width on desktop */
    }
  }

  .fh-row-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .fh-row-info {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 0; /* Prevents flexbox text blowout */
  }

  .fh-row-badge {
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 0.65rem;
    text-transform: uppercase;
    font-weight: 700;
    letter-spacing: 0.05em;
    /*
      NOT `--color-accent` (#cc0000). At 10.4px this is "normal" text and
      needs 4.5:1; brand red on this near-black row measures about 3.2:1 and
      fails on its own, before any dimming. This is the same hue lifted in
      luminance until it clears the bar (~6:1 measured), which reads as the
      brand red at badge size while actually being legible. The 3px active
      rail and the card chrome still use the true accent — large blocks of
      colour are held to 3:1, which #cc0000 does meet.
    */
    color: #ff5252;
  }

  .fh-row-title {
    margin: 0;
    font-family: var(--font-display, 'Syne', sans-serif);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    /*
      Carries the rest of the inactive read that the row's `opacity` used to
      provide, but as a COLOUR so it stays measurable: white at 72% over this
      background is ~10:1, comfortably above the 4.5:1 floor, where the old
      0.6 row opacity was applying the same visual idea in a way that also
      dragged the badge under it.
    */
    color: rgba(255, 255, 255, 0.72);
    transition: color 0.4s ease;
  }

  .fh-row:hover .fh-row-title,
  .fh-row.is-active .fh-row-title {
    color: var(--color-white, #ffffff);
  }
</style>

<script>
  /* Never trust an existing onYouTubeIframeAPIReady as a load in flight: GTM
     defines one on production and waits for US (src/lib/youtube-iframe-api.ts). */
  import { loadYouTubeAPI } from '../lib/youtube-iframe-api';

  function initFeaturedHighlights() {
    const section = document.querySelector('.featured-highlights') as HTMLElement;
    if (!section) return;

    /*
      ONCE PER SECTION ELEMENT.

      This is bound to BOTH `DOMContentLoaded` and `astro:page-load`, and on
      a first page load Astro fires the second one after the first — so
      without this guard the whole thing was built twice over the same DOM:
      two sets of click listeners on every row, and two independent autoplay
      state machines with their own `activePlayer` and their own timers.

      That is not merely wasteful. The timers advance the carousel at double
      speed, and `destroyActivePlayer()` in one closure cannot see the other
      closure's player, so switching slides orphans a live iframe that keeps
      playing underneath. It also made a single click run the activation
      handler twice, which is visible in the call log as unMute/playVideo
      pairs.

      The flag lives on the ELEMENT, not in a module variable, which is what
      keeps client-side navigation working: `astro:page-load` after a swap
      hands us a brand new section node with no flag, so it initialises
      exactly once again.
    */
    if (section.dataset.fhInit === '1') return;
    section.dataset.fhInit = '1';

    const rows = Array.from(section.querySelectorAll('.fh-row'));
    const heroCards = section.querySelectorAll('.fh-hero-card');
    if (rows.length === 0) return;

    let currentIndex = 0;
    let autoPlayTimeout: ReturnType<typeof setTimeout> | null = null;
    let isPaused = false;
    let isInteracting = false;
    /*
      ─── ONE PLAYER FOR THE WHOLE SHELF ───────────────────────────────────

      This shelf used to destroy its YouTube player and build a new one on
      every video slide, about every 15 seconds for as long as the homepage
      was open. Each build is a full embed bootstrap: the embed document,
      base.js, the player CSS, YouTube's service-worker prefetches (about 50
      requests), botguard and the ad checks. A reader's uBlock log showed the
      whole set repeating once per slide, over a hundred requests each time.

      Now ONE player is created, on the first video slide, and every later
      slide swaps the video inside it with `loadVideoById`, which re-uses the
      bootstrapped player and fetches only the new video.

      The player cannot live inside a card, because each slide is its own
      card and moving an iframe to another parent RELOADS it. So it lives in
      `.fh-player-layer`, one element in `.fh-left` BEHIND the stacked cards,
      positioned over the active card's media box. While a video plays the
      card's poster hides (`is-playing-inline`) and `has-player` makes the
      card see-through there, so the video shows through from behind while
      the card's own gradient, play mark and watermark stay ON TOP of it,
      exactly as when the iframe was inside the card.
    */
    let player: any = null;
    let playerReady = false;
    /* The media box the player is currently showing through, or null while
       the active slide is an article (or the API is unavailable). */
    let playerMedia: HTMLElement | null = null;
    let playerVideoId = '';
    let playerLayer: HTMLElement | null = null;
    let fadeInTimer: ReturnType<typeof setTimeout> | null = null;
    /* Bumped on every slide change, so a fade scheduled for one slide can
       never land on the next. */
    let slideToken = 0;
    let slideStartTime = 0;
    let accumulatedTime = 0;
    let rAF_ID = 0;
    const duration = 8000;
    
    heroCards.forEach(card => {
      const pauseHero = () => {
        isInteracting = true;
        stopAutoPlay();
      };
      card.addEventListener('touchstart', pauseHero, { passive: true });
      card.addEventListener('click', pauseHero);
    });

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (!entry.isIntersecting) {
          isInteracting = false;
          if (!isPaused) startAutoPlay();
        }
      });
    }, { threshold: 0 });
    observer.observe(section);

    const documentInteractionHandler = (e: Event) => {
      if (!section.isConnected) {
        document.removeEventListener('click', documentInteractionHandler);
        document.removeEventListener('touchstart', documentInteractionHandler);
        return;
      }
      if (!isInteracting) return;
      const target = e.target as Node;
      
      const activeCard = section.querySelector('.fh-hero-card.active');
      const fhRightNav = section.querySelector('.fh-right');
      const clickedInsideCard = activeCard?.contains(target);
      const clickedInsideNav = fhRightNav?.contains(target);
      
      if (!clickedInsideCard && !clickedInsideNav) {
        isInteracting = false;
        if (!isPaused) startAutoPlay();
      }
    };
    document.addEventListener('click', documentInteractionHandler);
    document.addEventListener('touchstart', documentInteractionHandler, { passive: true });

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        if (!isPaused) stopAutoPlay();
      } else {
        if (!isPaused && !isInteracting) startAutoPlay();
      }
    });

    function getDurationForIndex(index: number) {
      const row = rows[index];
      return row.classList.contains('is-video') ? 15000 : duration;
    }

    /* Undo every per-slide display class. Leaving `is-user-activated` set
       would hand the NEXT slide's preview the pointer while it is still a
       muted preview, which is the bug that pair of classes exists to
       prevent. */
    function resetInlineState() {
      if (fadeInTimer) {
        clearTimeout(fadeInTimer);
        fadeInTimer = null;
      }
      section.querySelectorAll('.is-playing-inline').forEach(media => media.classList.remove('is-playing-inline'));
      section.querySelectorAll('.is-user-activated').forEach(media => media.classList.remove('is-user-activated'));
      section.querySelectorAll('.has-player').forEach(card => card.classList.remove('has-player'));
      section.querySelectorAll('.video-watermark-logo').forEach((logo: any) => logo.style.opacity = '0');
      playerLayer?.classList.remove('is-visible', 'is-user-activated', 'is-instant');
    }

    /* Only at teardown (a client-side navigation away). A slide change
       never destroys the player; that is the point of this design. */
    function destroyActivePlayer() {
      resetInlineState();
      if (player && typeof player.destroy === 'function') player.destroy();
      player = null;
      playerReady = false;
      playerMedia = null;
      playerVideoId = '';
      playerLayer?.remove();
      playerLayer = null;
    }

    function ensurePlayerLayer(): HTMLElement | null {
      if (playerLayer && playerLayer.isConnected) return playerLayer;
      const host = section.querySelector('.fh-left') as HTMLElement | null;
      if (!host) return null;
      playerLayer = document.createElement('div');
      playerLayer.className = 'fh-player-layer';
      const target = document.createElement('div');
      target.className = 'fh-player-target';
      playerLayer.appendChild(target);
      host.appendChild(playerLayer);
      return playerLayer;
    }

    /* Lay the player exactly over the active card's media box. Measured
       rather than assumed: the hero card's media is not the same shape at
       every width. */
    function placePlayerLayer() {
      if (!playerLayer || !playerMedia) return;
      const host = playerLayer.parentElement as HTMLElement;
      const hostRect = host.getBoundingClientRect();
      const mediaRect = playerMedia.getBoundingClientRect();
      if (!(mediaRect.width > 0 && mediaRect.height > 0)) return;
      playerLayer.style.left = `${mediaRect.left - hostRect.left}px`;
      playerLayer.style.top = `${mediaRect.top - hostRect.top}px`;
      playerLayer.style.width = `${mediaRect.width}px`;
      playerLayer.style.height = `${mediaRect.height}px`;
    }

    /* A background preview: embed-pause pauses it when it leaves the
       viewport and resumes it on the way back (hard rule 12). Cleared when
       the reader starts the video themselves. */
    function markPreview() {
      const iframe = player?.getIframe?.();
      if (iframe) iframe.dataset.embedAmbient = '1';
    }

    function onPlayerStateChange(e: any) {
      const win = window as any;
      const media = playerMedia;
      /* An article slide, or the gap between slides: nothing to show. */
      if (!media) return;
      if (e.data === win.YT.PlayerState.PLAYING) {
        /* Wait 1.5s for YouTube's title bar to fade, then show the video. */
        if (fadeInTimer) clearTimeout(fadeInTimer);
        const token = slideToken;
        fadeInTimer = setTimeout(() => {
          fadeInTimer = null;
          if (token !== slideToken || playerMedia !== media) return;
          placePlayerLayer();
          /* Instant: it is behind the poster, which does the fading (see
             "THE PREVIEW FADES IN" in the styles). */
          playerLayer?.classList.add('is-visible', 'is-instant');
          const logo = media.querySelector('.video-watermark-logo') as HTMLElement;
          if (logo) logo.style.opacity = '0.8';
          media.classList.add('is-playing-inline');
        }, 1500);
      } else if (e.data === win.YT.PlayerState.PAUSED || e.data === win.YT.PlayerState.ENDED) {
        if (fadeInTimer) {
          clearTimeout(fadeInTimer);
          fadeInTimer = null;
        }
        /* Hide the frame at once, so YouTube's paused UI (More videos, the
           title bar) never shows, and go back to poster + play icon so the
           next click is ours again rather than YouTube's. */
        playerLayer?.classList.remove('is-visible', 'is-user-activated', 'is-instant');
        const logo = media.querySelector('.video-watermark-logo') as HTMLElement;
        if (logo) logo.style.opacity = '0';
        media.classList.remove('is-playing-inline', 'is-user-activated');

        const wasWatching = isPaused;
        isPaused = false;

        if (e.data === win.YT.PlayerState.PAUSED) {
          if (!isInteracting) startAutoPlay();
        } else if (e.data === win.YT.PlayerState.ENDED) {
          if (wasWatching) nextSlide();
        }
      }
    }

    function createPlayer(videoId: string) {
      const win = window as any;
      const layer = ensurePlayerLayer();
      const target = layer?.querySelector('.fh-player-target');
      if (!layer || !target) return;
      placePlayerLayer();
      /* Real dimensions at birth: YT.Player defaults to 640x360 when given
         none, and computes its first internal layout for that canvas (the
         iOS black band down the left, measured on an iPhone 17 Pro Max).
         CSS still owns the rendered size. */
      const rect = layer.getBoundingClientRect();
      player = new win.YT.Player(target, {
        width: rect.width > 0 ? Math.round(rect.width) : '100%',
        height: rect.height > 0 ? Math.round(rect.height) : '100%',
        videoId,
        /* No `autoplay: 1`: an embed that starts itself is what YouTube's
           bot check looks for (CLAUDE.md hard rule 11). onReady starts it,
           muted, by command. */
        playerVars: {
          controls: 0,
          mute: 1,
          modestbranding: 1,
          playsinline: 1,
          cc_load_policy: 0,
          iv_load_policy: 3,
          rel: 0,
          disablekb: 1
        },
        events: {
          onReady: (e: any) => {
            playerReady = true;
            /* The slide may have moved on while the player was loading: to
               another video (load that one), or to an article (stay idle). */
            if (!playerMedia || !playerVideoId) return;
            markPreview();
            if (playerVideoId === videoId) e.target.playVideo();
            else e.target.loadVideoById(playerVideoId);
          },
          onStateChange: onPlayerStateChange
        }
      });
    }

    /* Point the one player at this slide's video, creating it on first use. */
    function showVideo(videoId: string, mediaContainer: HTMLElement) {
      playerMedia = mediaContainer;
      playerVideoId = videoId;
      /*
        Make the card see-through over its media box (and lift its clip),
        before anything plays. See `.has-player` in this file's styles and in
        home-cards.css.
      */
      mediaContainer.closest('.content-card')?.classList.add('has-player');
      ensurePlayerLayer();
      placePlayerLayer();

      if (!player) {
        /*
          THE FIRST-PAINT LAYOUT WAIT (150ms). WebKit's grid can take longer
          than two paint cycles to settle its fractional widths on a heavy
          DOM, so the player is created once the layout has settled rather
          than measured mid-pass. Only the FIRST slide pays this; later ones
          reuse the player.
        */
        setTimeout(() => {
          if (!section.isConnected || player || !playerMedia) return;
          createPlayer(playerVideoId);
        }, 150);
        return;
      }
      if (!playerReady) return; // onReady loads playerVideoId
      player.mute?.();
      player.loadVideoById(videoId);
      markPreview();
    }

    /* The active slide is not a playable video: stop the player (not just
       pause, so it stops buffering) and keep it hidden. */
    function idlePlayer() {
      playerMedia = null;
      playerVideoId = '';
      if (player && playerReady && typeof player.stopVideo === 'function') player.stopVideo();
    }

    function activateIndex(index: number) {
      if (index < 0 || index >= rows.length) return;
      accumulatedTime = 0;
      slideStartTime = Date.now();
      
      const row = rows[index];
      const targetId = row.getAttribute('data-index');

      slideToken++;
      resetInlineState();

      rows.forEach(r => {
        r.classList.remove('is-active');
        r.setAttribute('aria-pressed', 'false');
        const progress = r.querySelector('.fh-row-progress') as HTMLElement;
        if (progress) {
          progress.style.opacity = '1';
          progress.style.transition = 'none';
          progress.style.transform = 'scaleX(0)';
        }
      });

      row.classList.add('is-active');
      row.setAttribute('aria-pressed', 'true');
      
      const container = section.querySelector('.fh-right') as HTMLElement;
      if (container && container.scrollWidth > container.clientWidth) {
        const scrollPos = (row as HTMLElement).offsetLeft - (container.clientWidth / 2) + (row.clientWidth / 2);
        container.scrollTo({
          left: scrollPos,
          behavior: 'smooth'
        });
      }

      let showing = false;
      heroCards.forEach(card => {
        if (card.getAttribute('data-index') !== targetId) {
          card.classList.remove('active');
          return;
        }
        card.classList.add('active');
        const isVideo = row.classList.contains('is-video');
        const videoBtn = card.querySelector('[data-action="inline-video"]');
        const win = window as any;
        if (!isVideo || !videoBtn || !win.YT || !win.YT.Player) return;
        const videoId = videoBtn.getAttribute('data-video-id');
        const mediaContainer = card.querySelector('.content-card-media') as HTMLElement | null;
        if (!videoId || !mediaContainer) return;
        showVideo(videoId, mediaContainer);
        showing = true;
      });
      if (!showing) idlePlayer();

      currentIndex = index;
    }

    function nextSlide() {
      const videoModal = document.getElementById('video-modal');
      if (videoModal && videoModal.classList.contains('active')) {
        accumulatedTime = 0;
        startAutoPlay();
        return;
      }
      if (isPaused) return;

      const nextIndex = (currentIndex + 1) % rows.length;
      activateIndex(nextIndex);
      startAutoPlay();
    }

    function startAutoPlay() {
      if (isPaused) return;
      if (autoPlayTimeout) return;

      const duration = getDurationForIndex(currentIndex);
      const remaining = Math.max(0, duration - accumulatedTime);
      slideStartTime = Date.now();
      
      const row = rows[currentIndex];
      const progress = row?.querySelector('.fh-row-progress') as HTMLElement;
      
      if (progress) {
        progress.style.opacity = '1';
        progress.style.transition = 'none';
        progress.style.transform = `scaleX(${accumulatedTime / duration})`;

        /*
          TWO frames, not a forced reflow. The starting scale has to be
          committed before the transition is switched on, or the bar animates
          from wherever it last was. This used to force that commit with
          getBoundingClientRect() + offsetWidth, which is a synchronous style
          and layout of whatever the page had pending: this runs at load, so it
          paid for the page's first full style pass (124ms at 4x CPU; PageSpeed
          lists it under "Forced reflow"). Waiting one rendered frame commits
          the same start value for free.
        */
        if (rAF_ID) cancelAnimationFrame(rAF_ID);
        rAF_ID = requestAnimationFrame(() => {
          rAF_ID = requestAnimationFrame(() => {
            progress.style.transition = `transform ${remaining}ms linear`;
            progress.style.transform = 'scaleX(1)';
          });
        });
      }

      autoPlayTimeout = setTimeout(() => {
        autoPlayTimeout = null;
        nextSlide();
      }, remaining);
    }

    function stopAutoPlay() {
      if (rAF_ID) {
        cancelAnimationFrame(rAF_ID);
        rAF_ID = 0;
      }
      if (autoPlayTimeout) {
        clearTimeout(autoPlayTimeout);
        autoPlayTimeout = null;
        accumulatedTime += Date.now() - slideStartTime;
      }
      const row = rows[currentIndex];
      if (row) {
        const progress = row.querySelector('.fh-row-progress') as HTMLElement;
        if (progress) {
          const duration = getDurationForIndex(currentIndex);
          progress.style.transition = 'none';
          progress.style.transform = `scaleX(${Math.min(accumulatedTime / duration, 1)})`;
        }
      }
    }

    let isHovering = false;
    section.addEventListener('pointerenter', (e: any) => {
      if (e.pointerType !== 'mouse') return;
      isHovering = true;
      stopAutoPlay();
    });
    section.addEventListener('pointerleave', (e: any) => {
      if (e.pointerType !== 'mouse') return;
      isHovering = false;
      if (!isPaused) {
        startAutoPlay();
      }
    });

    rows.forEach((row, index) => {
      row.addEventListener('click', () => {
        isInteracting = false;
        isPaused = false;
        accumulatedTime = 0;
        
        if (autoPlayTimeout) {
          clearTimeout(autoPlayTimeout);
          autoPlayTimeout = null;
        }
        
        activateIndex(index);
        if (!isHovering) {
          startAutoPlay();
        }
      });
    });

    const inlineVideoButtons = section.querySelectorAll('[data-action="inline-video"]');
    inlineVideoButtons.forEach(button => {
      button.addEventListener('click', (e) => {
        /* (A branch here used to pause the player on a click on an
           `a.watch-now-btn`. That element is a <span> in ContentCard, so the
           branch could never run; and pausing on an outbound click belongs to
           src/lib/embed-pause.ts, which does it for every target=_blank link.) */

        /* The card's "Watch now" is a real link to YouTube (the player's way
           out, hard rule 11; see isHeroPlayer in ContentCard): let it
           navigate, and do not start the inline player behind it. */
        if ((e.target as Element | null)?.closest?.('a[href]')) return;

        e.preventDefault();
        e.stopPropagation();

        /*
          No preview player to unmute: YouTube's API was blocked (an ad
          blocker, a privacy extension) or has not loaded yet, which the
          static-carousel fallback below calls a supported state. This click
          used to be swallowed right here and the tap did nothing at all, on
          the lead card's image, title and play mark alike. It opens the
          site's video modal instead: the same video, one tap, and the
          modal carries its own "Watch on YouTube" door (hard rule 11).
        */
        const mediaContainer = (button.querySelector('.content-card-media') || button.closest('.content-card')?.querySelector('.content-card-media')) as HTMLElement | null;

        /* The player must be ready AND showing this card's video; otherwise
           the modal plays it (the same fallback as a blocked API). */
        if (!player || !playerReady || typeof player.unMute !== 'function' || !mediaContainer || playerMedia !== mediaContainer) {
          const videoId = button.getAttribute('data-video-id');
          if (videoId) window.hqOpenVideo?.(videoId);
          return;
        }

        {
          player.unMute();
          player.setVolume(100);
          player.playVideo();

          /* The reader started this one, so it is no longer a background
             preview: embed-pause must not resume it on its own. */
          player.getIframe?.()?.removeAttribute('data-embed-ambient');

          /*
            Hand the pointer to YouTube only NOW. Until this click the frame
            is inert and the card sits on top of it, which is what lets this
            handler receive the click at all. `is-user-activated` makes the
            card's media box click-through and the frame clickable, so
            YouTube's own click-to-pause works (see the styles).
          */
          mediaContainer.classList.add('is-user-activated');
          placePlayerLayer();
          /* Snap instantly on manual play. */
          playerLayer?.classList.add('is-visible', 'is-user-activated', 'is-instant');

          const logo = mediaContainer.querySelector('.video-watermark-logo') as HTMLElement;
          if (logo) logo.style.opacity = '0.8';
          
          mediaContainer.classList.add('is-playing-inline');

          isPaused = true;
          stopAutoPlay();
          section.removeEventListener('mouseleave', startAutoPlay);
          
          const row = rows[currentIndex];
          if (row) {
             const progress = row.querySelector('.fh-row-progress') as HTMLElement;
             if (progress) progress.style.opacity = '0';
          }
        }
      });
    });

    /*
      ─── RE-MEASURE ON THE SETTLED FRAME, NEVER MID-ROTATION ───────────────

      CSS OWNS THE GEOMETRY. The iframe is `position: absolute; inset: 0;
      width: 100%; height: 100%`, and a stylesheet `width` beats the width
      CONTENT ATTRIBUTE that the API writes — attributes are only
      presentational hints. So `setSize()` can never move or resize the
      iframe; the fluid layout is always in charge. Its one job here is to
      hand the cross-origin player a number so it re-runs its own internal
      centring, which CSS cannot reach into.

      That distinction is what makes the previous version wrong. It batched
      on `requestAnimationFrame` LEADING-edge — first callback of a burst
      wins, every later one is dropped while a frame is pending. iOS Safari
      animates a rotation over many frames, so the value that survived was an
      early, unsettled rect measured before the safe-area insets and the
      final flex pass had been applied. The player was then centring on a
      canvas wider than the one it ended up in.

      Inverted here to a TRAILING-edge settle: every resize restarts the
      timer, and only the final one — after the burst stops — is acted on.
      That guarantees the settled rect rather than guaranteeing the stale one.
      `orientationchange` is listened to as well because iOS can finish the
      visual rotation without a further size change on the observed box, and
      a rect read in that handler is still mid-animation, so it too goes
      through the same settle rather than measuring immediately.

      Rounded, and skipped when unchanged: the API takes integers, and a
      burst that settles on the size it started at should post nothing.
    */
    if ('ResizeObserver' in window) {
      let settleTimer: ReturnType<typeof setTimeout> | null = null;
      let lastSize = '';

      /* Long enough to outlast an iOS rotation animation, short enough to be
         invisible against a correction the reader is not looking for. */
      const SETTLE_MS = 250;

      function remeasureWhenSettled() {
        /* The LAYER follows the box every frame: it is our element, and a
           frame spent over the wrong rect would show. Only the player's
           internal re-centring waits for the settle. */
        placePlayerLayer();
        if (settleTimer) clearTimeout(settleTimer);
        settleTimer = setTimeout(() => {
          settleTimer = null;
          placePlayerLayer();
          if (!player || !playerReady || typeof player.setSize !== 'function') return;
          if (!playerMedia) return;

          const { width, height } = playerMedia.getBoundingClientRect();
          if (!(width > 0 && height > 0)) return;

          const w = Math.round(width);
          const h = Math.round(height);
          const key = `${w}x${h}`;
          if (key === lastSize) return;
          lastSize = key;

          player.setSize(w, h);
        }, SETTLE_MS);
      }

      const resizeObserver = new ResizeObserver(remeasureWhenSettled);
      section.querySelectorAll('.content-card-media').forEach((box) => resizeObserver.observe(box));
      /* The layer is positioned against `.fh-left`, so a change there (the
         column resizing, or content above the media box moving) matters too. */
      const leftColumn = section.querySelector('.fh-left');
      if (leftColumn) resizeObserver.observe(leftColumn);

      window.addEventListener('orientationchange', remeasureWhenSettled);
      /* `resize` covers the desktop case and the iOS builds that report a
         rotation only as a viewport change. Passive: it never preventDefaults. */
      window.addEventListener('resize', remeasureWhenSettled, { passive: true });
    }

    /*
      Scrolled out of view: stop the CAROUSEL ROTATION; back in view: restart
      it. The VIDEO is not touched here: pausing an embed belongs to
      src/lib/embed-pause.ts and nowhere else (CLAUDE.md hard rule 12). That
      module pauses this player when it leaves the viewport and, because this
      shelf's player is a background preview (data-embed-ambient), resumes it on the way
      back; the player's own onStateChange above then restores the inline UI.
    */
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (!entry.isIntersecting) {
            if (!isPaused) {
               stopAutoPlay();
            }
          } else {
            if (!isPaused) {
              startAutoPlay();
            }
          }
        });
      }, { threshold: 0.1 }); // Trigger when less than 10% is visible
      
      observer.observe(section);
    }

    // (Hover logic is now defined above)

    /*
      THE YOUTUBE IFRAME API IS NOT PART OF THE CRITICAL PATH.

      This used to be a bare `loadYouTubeAPI()` running straight off
      `DOMContentLoaded`. That injects `youtube.com/iframe_api`, which on the
      homepage pulls ~845 KiB of YouTube JavaScript (~517 KiB of it never
      executed) across three new origins, for a section that is BELOW THE FOLD.

      On desktop nobody noticed. On PageSpeed's mobile profile (Slow 4G,
      1.6 Mbps, 4x CPU) those bytes are ~4s of bandwidth ahead of a 32 KiB
      hero image, and they landed the homepage at Performance 58 with a 10.9s
      LCP while the same run scored 84 on desktop. The LCP image was never
      slow, it was starved.

      So: paint the carousel immediately and fetch the player only once the
      section is actually approaching the viewport. `activateIndex()` already
      guards every player call behind `win.YT && win.YT.Player` (see the
      `isVideo && videoBtn && win.YT` test), and `loadYouTubeAPI()` already
      resolves `null` when the API is blocked — the static-carousel fallback
      is a supported state, not a broken one. Calling it now just makes that
      state the FIRST state instead of an error state.

      When the API does arrive we re-run `activateIndex(currentIndex)` so the
      slide that is showing upgrades in place to a real player. Re-entry is
      safe: `activateIndex` points the one shared player at the slide's
      video (creating it the first time) rather than stacking a second, and
      `startAutoPlay` no-ops while a timer is already pending.

      NOTE FOR ANYONE MEASURING THIS: no automated check in this repo will
      show you the win, so do not go looking for one and conclude the change
      did nothing. The Lighthouse gate audits `astro preview` on localhost,
      where TTFB is ~15ms and the LCP image wins its race regardless — it
      scored `/` at 94% both before and after this change. Some agent
      sandboxes additionally cannot reach youtube.com at all, so the payload
      is simply absent there; `scripts/lighthouse-check.mjs` now says so out
      loud rather than reporting a green it did not actually measure. The
      evidence for this change is the PageSpeed trace above, not a local
      number. Verify it on a deployed URL.
    */
    const startPlayers = () => {
      loadYouTubeAPI().then(() => {
        if (!section.isConnected) return;
        activateIndex(currentIndex);
        startAutoPlay();
      });
    };

    activateIndex(currentIndex);
    startAutoPlay();

    if ('IntersectionObserver' in window) {
      /* 300px of lead time: enough to have the API in flight before the
         section is on screen, short enough that a visitor who never scrolls
         down never pays for it at all. */
      const apiObserver = new IntersectionObserver((entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        apiObserver.disconnect();
        startPlayers();
      }, { rootMargin: '300px 0px' });
      apiObserver.observe(section);
      document.addEventListener('astro:before-swap', () => apiObserver.disconnect(), { once: true });
    } else {
      startPlayers();
    }

    document.addEventListener('astro:before-swap', () => {
      stopAutoPlay();
      destroyActivePlayer();
    }, { once: true });
  }

  document.addEventListener('DOMContentLoaded', initFeaturedHighlights);
  document.addEventListener('astro:page-load', initFeaturedHighlights);
</script>
