              <MiniCalendarSidebar events={Astro.props.allEvents?.filter((e: any) => (e.endDate || e.startDate).slice(0, 10) >= new Date().toISOString().split('T')[0]).sort((a: any, b: any) => a.startDate.localeCompare(b.startDate)) || []} />
            </div>

            {/*
              ─── THE FRANCHISE HUB CARD ─────────────────────────────────────

              It had `margin-bottom: 3.5rem` and no margin-top, so its heading
