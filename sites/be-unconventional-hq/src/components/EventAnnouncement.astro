---
import Layout from '../layouts/Layout.astro';
import InstagramFeed from './InstagramFeed.astro';
import SubscribeCTA from './SubscribeCTA.astro';
import ContentCard from './ContentCard.astro';
import MiniCalendarSidebar from './MiniCalendarSidebar.astro';
import ReferralLinks from './ReferralLinks.astro';
import HubCard from './HubCard.astro';

import { getHubTopicKeywords } from '../lib/instagram-topic';
import { parseVideoId } from '../lib/platforms/youtube';
import { urlFor, getFeaturedBrandsLocal, cappedWidths, getImageDimensions } from '../lib/local-content';
import { formatEventDateRange, formatLocation, getEventTypeLabel } from '../lib/events';
import { buildEventDescription, buildEventTitleName, buildEventSchema } from '../lib/event-seo';
import { pageTitle } from '../data/content.js';
import logoImage from '../assets/logo-mark.webp';
import { getImage } from 'astro:assets';
import { getCardImageSources } from '../lib/card-images';

const {
  event,
  unifiedContent,
  /*
    Coverage is capped at six by src/pages/events/[slug].astro; these three
    describe what was left behind and whether the visible six are mixed
    enough to be worth filtering. Defaults keep the component renderable on
    its own (tests, and any caller that has not been updated).
  */
  coverageTotal = unifiedContent?.length ?? 0,
  coverageHref = `/events/${event?.slug?.current ?? ''}/coverage`,
  showCoverageFilters = false,
} = Astro.props;

const relatedBrand = event.relatedBrandSlug ? getFeaturedBrandsLocal().find((b: any) => (typeof b.slug === 'string' ? b.slug : b.slug?.current) === event.relatedBrandSlug) : null;


/*
  ─── WHAT THIS PAGE TELLS GOOGLE AND A SOCIAL CARD ────────────────────────

  Four things were missing, and none of them show on the page, which is why
  they survived:

    NO OG IMAGE. Layout defaults `image` to site.image, so every event on the
    site shared one generic card. The event has key art; use it.

    NO BRAND IN THE TITLE. Layout renders `<title>` verbatim and appends
    nothing, and this passed `event.title` alone. Every other route goes
    through pageTitle(). Now so does this one, which also means nobody has to
    remember the site is called "BE Unconventional HQ" and not
    "Be Unconventional".

    A 26-CHARACTER DESCRIPTION. "Coverage of BlizzCon" is under the length
    Google will use for anything.

    NO EVENT SCHEMA. An event page is the one page type schema.org has a
    dedicated node for.

  The logic is in lib/event-seo.ts so this file and EventFeatured.astro
  cannot drift, which is how the hub card heading went wrong.
*/
const ogImage = event.heroImage
  ? urlFor(event.heroImage).width(1200).height(630).fit('crop').auto('format').url()
  : undefined;
const seoDescription = buildEventDescription(event);
const seoTitle = pageTitle(buildEventTitleName(event));
const canonicalEventUrl = event.slug?.current
  ? new URL(`/events/${event.slug.current}`, Astro.site ?? 'https://beunconventionalhq.com').href
  : undefined;
const eventSchema = buildEventSchema(event, {
  url: canonicalEventUrl,
  imageUrl: ogImage,
  description: seoDescription,
});

const brandColor = (typeof event.brandColor === 'string' ? event.brandColor : event.brandColor?.hex) || '#CC0000';

function hexToRgbTriple(hex: string): string {
  const m = /^#?([0-9a-f]{6})$/i.exec(hex.trim());
  if (!m) return '204, 0, 0';
  const int = parseInt(m[1], 16);
  return `${(int >> 16) & 255}, ${(int >> 8) & 255}, ${int & 255}`;
}
const brandRgb = hexToRgbTriple(brandColor);

/*
  CAPPED AT THE ASSET, NOT A FLAT CEILING. This was a hard `[600, 900, 1200,
  2400]`, which got it wrong at both ends of the library: 15 of the 37 hero
  assets are 1920 wide, so the top rung asked Sanity to upsample them to 2400
  and return a bigger, blurrier file (the exact failure buildImageSet's note
  in local-content.ts is about), while the two that are genuinely 3840 could
  never be asked for more than 2400 and rendered soft on a 4K screen.

  `cappedWidths` drops anything above the asset's own width and puts that width
  on top, so 1920 art tops out at 1920, 2560 art at 2560, and 3840 art now gets
  the full rung. New art at a higher resolution earns its rung by existing;
  nothing here has to be edited again.
*/
const HERO_WIDTHS = cappedWidths(event.heroImage, [600, 900, 1200, 2400, 3840]);
const heroAt = (w: number) => event.heroImage ? urlFor(event.heroImage).width(w).auto('format').url() : '';
const heroBackdropMobileUrl = heroAt(800);
const heroBackdropSrcset = event.heroImage ? HERO_WIDTHS.map((w) => `${heroAt(w)} ${w}w`).join(', ') : '';
const heroBackdropSizes = '100vw';
const heroBackdrop = event.heroImage;

const fallbackGradient = `linear-gradient(135deg, rgba(${brandRgb}, 0.28) 0%, #0a0a0a 62%, #111 100%)`;

const trailerUrl = event.trailerUrl;
const trailerId = parseVideoId(trailerUrl);

/*
  ─── THREE SLOTS, AND THEY ARE NOT ALL THE SAME MARK ──────────────────────

  The hero renders a mark in three places:

    .hero-logo        small, top left      the EVENT'S own mark
    .hub-stage-mark   large, crisp, right  the brand mark

  There were three. `.hub-stage-plate`, a blurred ghost of the stage mark, was
  removed with the second backdrop layer it lived in: see ONE BACKDROP, NOT TWO
  IMAGES BLENDED in the stylesheet below.

  The LEFT one was also that same asset, and that is what made a hero read as
  the same event three times over. Worse on a recurring series: PAX West,
  East, Aus and Unplugged all pointed `logo` at one shared PAX wordmark, so
  four different events were visually identical.

  `heroLogo` is the override for the left slot only. Unset (the common case)
  it falls back to `logo` and nothing changes.
*/
const overrideLogo = event.customHeroLogo ? urlFor(event.customHeroLogo).height(320).auto('format').url() : null;
const sourceTaxonomyLogo = event.heroLogo || event.logo || relatedBrand?.logo;
const taxonomyLogo = sourceTaxonomyLogo ? urlFor(sourceTaxonomyLogo).height(320).auto('format').url() : null;
/*
  ─── SIZED, NOT JUST ROUTED THROUGH getImage() ──────────────────────────────

  Getting the path right is only half of it. `getImage({ src })` with no
  dimensions emits the ORIGINAL, and logo-mark.webp is 414 KB — for an element
  capped at 180px tall. That shipped as the heaviest request on /feed (405 KB,
  bigger than the hero backdrop) and helped push mobile LCP to 7.9s.

  ContentCard.astro sizes its watermark for exactly this reason and names the
  414 KB figure. Requested at 360px tall here, which is 2x the largest size this
  element is ever displayed at.
*/
const fallbackLogo = await getImage({ src: logoImage, height: 360, format: 'webp', quality: 70 });
const fallbackLogoSrc = fallbackLogo.src;
const resolvedLogoSrc = overrideLogo || taxonomyLogo || fallbackLogoSrc;
/*
  The mark's intrinsic box, so the slot holds its aspect ratio before the file
  arrives. Every Sanity mark is requested at height 320, so its box is the
  asset's own ratio at that height (read from the ref, never fetched). CSS
  still decides the rendered size; these only stop the slot being 0x0.
*/
const logoBoxAt320 = (source: unknown) => {
  const dims = source ? getImageDimensions(source) : null;
  return dims ? { width: Math.round((320 * dims.width) / dims.height), height: 320 } : null;
};
const resolvedLogoBox = overrideLogo
  ? logoBoxAt320(event.customHeroLogo)
  : taxonomyLogo
    ? logoBoxAt320(sourceTaxonomyLogo)
    : { width: Number(fallbackLogo.attributes.width) || undefined, height: Number(fallbackLogo.attributes.height) || undefined };

const overrideLabel = event.customHeroBrandLabel || null;
const resolvedLabel = overrideLabel || relatedBrand?.title || event.title;

/*
  ─── "EVENT DETAILS" POINTS AT THIS PAGE ──────────────────────────────────

  It was an outbound link, and it went through two wrong destinations before
  the question got asked properly. First `signUpLink`, the REGISTRATION link:
  an Axs ticket listing for The Game Awards, a Leap Events checkout for
  L.A. Comic Con, a newsletter form for PAX East. A button reading "Event
  Details" landing on a shopping cart is a broken promise, so it was moved to
  `officialWebsite`. That fixed the destination without questioning the
  direction, and the direction was the bug: a reader clicked it and left the
  site, which is exactly what it was built to do.

  This page HAS an event-details section. `#event-details` is headed DETAILS
  and carries the dates, the venue, Tickets/RSVP, and the official website as
  a link. The button's label and that section's heading are the same words,
  so the button goes there.

  THE OUTBOUND LINK IS NOT LOST, it is repositioned. It stays in that
  section, which is the right place in the funnel: after the coverage rather
  than in front of it, and where somebody who has read the page and now wants
  tickets will look.

  IT MATTERS MOST ON A PHONE. `.article-rail-left` — the TOC that also links
  to #event-details — is hidden below 1200px, so on mobile this button is the
  only thing in the hero that says there is anything below it at all.

  No `data-event-toc`: that attribute opts an element into the rail's
  scroll-spy highlighting, and this is not part of the rail.
*/
const heroCtaHref = '#event-details';

/*
  ─── WHAT THE STAGE SHOWS WHEN NOTHING IS PLAYING ─────────────────────────

  It showed the brand mark, large and crisp, over a blown-up blurred copy of
  itself. On a page whose hero ALREADY carries that mark at the top left, and
  whose tagline falls back to the event's own name, that made three or four
  statements of the same identity stacked down one screen. Reported against
  the Doomsday premiere: "there is repeating everywhere. It's too repetitive."

  So the default idle state is the event's own KEY ART, blurred. It is the
  same image the hero backdrop uses, which is the point: blurred, it reads as
  the scene continuing through the frame rather than as a second copy of
  anything, and the frame stops being a slot that announces the event twice.

  `stageShowMark` puts the mark back for an event that wants it, and
  `stageLogo` is the third optional mark — the stage's own, where neither the
  brand logo nor the hero lockup is the right thing to blow up to 520px.

  THE GHOST FOLLOWS WHATEVER IS IN FRONT OF IT. Crisp-over-a-blurred-copy-of-
  itself is the lockup /featured uses, so in mark mode the ghost is that mark.
  In art mode it is the key art, NOT the logo: a logo-shaped glow around a
  frame with no logo in it is a leftover of a lockup that is not there any
  more, and it was one more appearance of the mark. Feathering the right half
  is what makes this read as one scene instead of two columns, so the ghost
  stays in both modes; only its source changes.
*/
const stageShowsMark = event.stageShowMark === true;
const stageMarkLogo = event.stageLogo || event.logo;
const stageMarkUrl = stageShowsMark && stageMarkLogo
  ? urlFor(stageMarkLogo).height(520).auto('format').url()
  : null;
/*
  NOT A BLURRED BACKDROP, so it is not requested like one.

  The convention elsewhere on this site is to ask for a blurred plate SMALL
  (640px on /featured, 900px on a hub page) because a blur destroys more
  detail than any upsample ever costs. This is the opposite: a crisp still
  sitting in the frame the video will play in, at that frame's exact size,
  so every pixel is on show and the request has to match the box.

  The box is 760 CSS px at its widest (the split layout's stage) and 600 when
  the hero stacks, so the ladder tops out at 1520 for a 2x screen on the
  larger of the two. `sizes` names the real widths rather than 100vw, which
  would have a phone fetch a viewport-wide image for a 343px box.
*/
const STAGE_WIDTHS = [600, 760, 1200, 1520];
const stageArtAt = (w: number) =>
  event.heroImage ? urlFor(event.heroImage).width(w).auto('format').url() : '';
const stageArtUrl = !stageMarkUrl && event.heroImage ? stageArtAt(900) : null;
const stageArtSrcset = stageArtUrl ? STAGE_WIDTHS.map((w) => `${stageArtAt(w)} ${w}w`).join(', ') : '';
const stageArtSizes = '(min-width: 820px) 760px, (min-width: 660px) 600px, 100vw';

const HERO_ITEM_LIMIT = 5;
function pickHeroItems(items: any[]) {
  return items.slice(0, HERO_ITEM_LIMIT);
}
const heroItems = pickHeroItems(unifiedContent);

/*
  ─── THE RAIL AND ITS PANES GET RENDITIONS, NEVER ORIGINALS ────────────────

  Both used `item.image ?? item.thumbnail` straight, so a Substack cover went
  out as the raw S3 upload: 3840x2160 for a ~106px rail thumbnail on the Marvel
  and Sony hubs (the site-wide audit, 2026-09). Every other card on these
  pages already goes through getCardImageSources(); this is the same helper,
  once per item, shared by the pane and the rail so they request the same
  files. The global QA sweep (scripts/e2e-global-qa-sweep.test.mjs) fails CI on a raw original.

  STAGE_PANE_SIZES: the pane fills the stage (full width on phones, 760px at
  most beside the copy). RAIL_THUMB_SIZES: a thumbnail is ~106px, and 160px
  leaves room for the widest rail layout.
*/
const heroItemArt = heroItems.map((item: any) => getCardImageSources(item.image ?? item.thumbnail ?? ''));
const STAGE_PANE_SIZES = '(max-width: 1023px) 100vw, 760px';
const RAIL_THUMB_SIZES = '160px';

const hasPlayableVideo =
  !!trailerId ||
  heroItems.some((it: any) => it.contentType === 'video' && parseVideoId(it.link || ''));


/*
  The hero's three metadata tags, resolved once here rather than inline in the
  markup. `getEventTypeLabel` replaces the hardcoded "LIVE EVENT" fallback and
  `formatEventDateRange` replaces two hand-built toLocaleDateString() calls —
  both live in src/lib/events.ts, which is the only place allowed to turn a
  "YYYY-MM-DD" string into anything (hard rule 1).
*/
const eventTypeLabel = getEventTypeLabel(event);
const eventDateLabel = formatEventDateRange(event.startDate, event.endDate);
const locationLabel = formatLocation(event.location);

/*
  ─── THE HERO LINE IS A TAGLINE, NEVER THE ABOUT COPY ─────────────────────

  This slot used to render `event.description` — the full ABOUT paragraph,
  which is already the first thing in the article body below — clamped to
  `max-height: 5em` with a "Read more" button beside it. On an event page
  that button shipped with the `hidden` attribute and NOTHING ever removed it:
  the toggle script lives in featured/[slug].astro, not in these components.
  Measured on the built page: 178px of text in a 52px box, button
  `display: none`. So the hero cut a sentence off mid-word with no affordance
  to finish it, and the same paragraph sat in full a screen below.

  A hero line should be a line. `tagline` is a short, optional field an editor
  writes for exactly this slot; with none written it falls back to the event's
  own name, which is short by construction and can never need truncating.

  The name is worth stating even under a logo: when `event.logo` exists the
  <h1> is sr-only, so nothing in the hero says what this is in readable text.
  A stylised mark a visitor cannot parse, or one that fails to load, otherwise
  leaves them with nothing.

  NO CLAMP HERE, deliberately. Truncation with no way to expand is the bug
  being fixed; a long tagline wraps instead, and `max-width: 46ch` keeps it to
  a sane measure.
*/
/*
  ─── AND IT DOES NOT FALL BACK TO THE NAME ────────────────────────────────

  It used to. With 18 of the 19 seeded events carrying no tagline, that put
  the event's own name in type directly under its own mark on all but one
  page, which is the last of the "repeating everywhere" the hero was reported
  for. D23 was the only clean one, and only because somebody wrote it a real
  tagline.

  THE FALLBACK'S REASON IS NOW SERVED BETTER, NOT DROPPED. It existed because
  the <h1> goes sr-only when a logo renders, so a stylised mark a visitor
  cannot parse — or one that fails to load — otherwise left nothing readable.
  The lockup below answers that where the problem actually is: the <h1> wraps
  the logo and the name moves to the image's `alt`, so a broken image renders
  the name as text in the mark's own place, and assistive technology reads it
  once rather than twice.

  Null, not a string, so the paragraph does not render at all. An empty <p>
  still takes its line-height and its margin.
*/
const taglineText = (typeof event.tagline === 'string' && event.tagline.trim())
  ? event.tagline.trim()
  : null;
---

<Layout
  title={seoTitle}
  description={seoDescription}
  image={ogImage}
  type="article"
  preloadImage={heroBackdropMobileUrl || undefined}
  preloadImageSrcset={heroBackdropSrcset || undefined}
  preloadImageSizes={event.heroImage ? heroBackdropSizes : undefined}
>
  {/*
    schema.org/Event, into Layout's named head slot.

    `is:inline` and the `<` escape match the site's other JSON-LD blocks: an
    unescaped "<" inside a JSON string can close the script element early.
    Renders nothing when the document has no name or start date, because a
    partial Event node is reported as an error against the page rather than
    ignored.
  */}
  {eventSchema && (
    <script
      slot="head"
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(eventSchema).replace(/</g, '\\u003c')}
    />
  )}
  <main class="event-dashboard" style={`--brand-color: ${brandColor}; --brand-rgb: ${brandRgb};`} data-trailer={trailerId}>
    
    {/* 1. TOP HALF: Featured Hub Hero Layout (e.g. DC Page) */}
    <section class="event-hero">
      {/* Two layers (issue #22): the wrapper owns clipping/coverage and stays
          static; the inner layer owns the background image and the slow Ken
          Burns transform. Animating a single element caused edge slivers. */}
      <div class="event-hero-bg-wrapper">
        {heroBackdrop ? (
          /*
            The hub's own art, blurred, with the slow push this hero has always
            had. It used to be a cross-fade of up to six stills gathered from
            the thumbnails of videos tagged to the hub — which meant a hub
            could end up backed by a photograph of the site owner. See
            getHubBackdrop(). Do not reintroduce that; a hub is somebody
            else's brand.
          */
                    <img
            src={heroBackdropMobileUrl}
            srcset={heroBackdropSrcset}
            sizes={heroBackdropSizes}
            alt=""
            class="event-hero-bg-animated hero-backdrop-plate"
            loading="eager"
            fetchpriority="high"
          />
        ) : (
          <div class="event-hero-bg-animated" style={`background-image: ${fallbackGradient};`}></div>
        )}
      </div>

      <div class="hub-stage-wash" aria-hidden="true"></div>

      <div class="event-hero-overlay flex flex-col justify-center">
        <div
          class:list={[
            'container container-page',
            'hero-grid-container',
            'lg:!px-20',
            'xl:!px-24',
            { 'has-stage': true, 'has-cta': true },
          ]}
        >
          <div class="event-hero-content hero-copy ">
            {/* See the matching note in events/[slug].astro: when a logo
                exists the visible title is an image, so without this the page
                ships with no <h1> at all. sr-only keeps the visual design
                identical while restoring the outline and SEO. */}
            {/*
              Names the row on /featured that this hub sits in. It is the one
              piece of continuity a logo alone cannot give you — you clicked
              "Franchises", so the page you land on says so, in the same
              plate the row header uses.
            */}
            {/*
              ─── THE METADATA ROW ───────────────────────────────────────────

              Three separate tags in a flex row, flush left, each in its own
              plate. It used to be ONE plate wrapping all three with bullet
              separators inside it, which rendered as a single 500px strip
              reading "LIVE EVENT • ANAHEIM, CA • SEP 12, 2026–SEP 13, 2026" and
              gave the three facts no visual hierarchy at all.

              TAG 1 IS THE EVENT'S TYPE, AND IT IS READ FROM THE DOCUMENT.
              The string "LIVE EVENT" was hardcoded as the fallback for an
              unset `category` — and `category` is a HUB category that events
              never carry, so every event page claimed to be live. It is
              `eventType` now (the Event schema's dropdown), resolved by
              getEventTypeLabel(). Whether an event is actually live is a
              derived question with its own answer: getEventStatus().

              THE DATE IS THE COMPACT RANGE, not two full dates glued
              together with an en dash: formatEventDateRange() collapses a
              same-month range to "Sep 12–13, 2026", roughly half the width,
              and it parses YYYY-MM-DD without ever constructing a Date from
              the bare string (hard rule 1).
            */}
            <div class="hero-eyebrow">
              <span class="hero-meta-tag hero-meta-tag--type">{eventTypeLabel}</span>
              {locationLabel && <span class="hero-meta-tag">{locationLabel}</span>}
              {event.startDate && (
                <time datetime={event.startDate} class="hero-meta-tag hero-meta-tag--date">
                  {eventDateLabel}
                </time>
              )}
            </div>

            {/*
              THE MARK IS ON THE STAGE NOW, so the copy does not repeat it. A
              hub with a logo names itself once, large, on the right; this side
              keeps the <h1> for the outline and for search, sr-only. A hub with
              NO logo has nothing on the stage to carry its name, so the title
              becomes visible here instead. Identity appears exactly once either
              way.
            */}
            {/*
              The mark sits HERE, under the row label — asked for directly, and
              it is the right call: the stage opposite spends most of its life
              showing coverage rather than the brand, so the hub needs a name
              that does not disappear the moment somebody picks a video.
              The <h1> stays sr-only behind it for the outline and for search.
            */}
            {/*
              MARK AND LINE SIT SIDE BY SIDE, not stacked. On a phone the
              stacked version spent most of the hero on two short elements with
              a lot of air between them; beside each other they read as one
              lockup and give the trailer below room to matter.
            */}
            <div class="hero-identity">
              {/*
                THE MARK IS THE HEADING, not a decorative image beside a
                hidden one. It was an `aria-hidden` <img alt=""> next to an
                `sr-only` <h1>, which gave the page its outline but left a
                failed image as a blank space with nothing to say what the
                page was — the very case the tagline's old name-fallback was
                there to cover, covered a screen lower down and in the wrong
                place. Naming the image and wrapping it in the <h1> puts the
                answer where the question is: the alt renders in the mark's
                own position if the image never arrives, and it is announced
                once rather than once per element.
              */}
              {/*
                A HEADING THAT IS PURELY A CONTAINER. The <h1> around the mark
                must not bring a heading's own margin, size or weight with it —
                the alt text only ever paints if the image fails, and it should
                land where the mark would have, not as a browser-default 2em
                block that moves everything under it.
              */}
              <h1 class="hero-title-lockup">
                <span class="hero-logo-wrap">
                  <img
                    src={resolvedLogoSrc}
                    alt={resolvedLabel}
                    width={resolvedLogoBox?.width}
                    height={resolvedLogoBox?.height}
                    class="hero-logo"
                    data-fallback-logo={fallbackLogoSrc}
                  />
                </span>
              </h1>

              {taglineText && <p class="hero-tagline">{taglineText}</p>}

              {trailerId && (
                /*
                  ─── WATCH IT AGAIN ─────────────────────────────────────────

                  The trailer plays once and unloads itself. Before this there
                  was no way back to it: initHubStage is guarded by `stageInit`
                  and never re-armed, so the only replay was a refresh, or
                  leaving and returning (ClientRouter swaps the DOM, which
                  clears the guard). Measured, and neither is discoverable.

                  ─── PLACEMENT, THIRD ATTEMPT ───────────────────────────────

                  It has been in two wrong places already, and both failures
                  were about WHAT THE BUTTON LOOKS LIKE IT BELONGS TO.

                  First it went over the hub's mark: click the logo, watch it
                  again. Unpressable, because the handover puts a rail pane up
                  the instant the trailer ends, so `is-item` is on from then on
                  and a control behind that pane can never be reached.

                  Then it moved to the stage's top-right corner, sharing the
                  sound toggle's slot. That is pressable and it is still wrong,
                  reported from a phone with the word "confusing". The stage
                  spends almost all of its life showing a RAIL CARD, not the
                  mark, so a pill reading TRAILER sat in the corner of the
                  Wolverine card — a card that carries its own PLAY button.
                  Two play affordances on one image, for two different videos.

                  The button was never stage chrome. It replays the HUB's
                  trailer, so it belongs with the hub's identity: under the
                  mark, beside Read more, in the column that is already about
                  "what is this hub". Out here it cannot overlap anything the
                  stage shows, at any breakpoint, in any state.

                  NAMED FROM ITS OWN CONTENT, not an aria-label. WCAG 2.5.3
                  requires the accessible name to CONTAIN the visible text, and
                  "Replay the PlayStation trailer" does not contain "Play
                  trailer". The sr-only suffix gives the hub name to a screen
                  reader while keeping the visible words inside the name.

                  Gated on `trailerId`, NOT `hasPlayableVideo`. The latter is
                  also true for a hub with no trailer that merely has a video
                  in its rail, and initHubStage bails on `!stage.dataset.trailer`
                  — so that hub would have rendered a button that does nothing.
                  Every hub happens to have a trailer today, which is exactly
                  why this would have shipped unnoticed.
                */
                <button type="button" class="hub-stage-replay">
                  <svg class="hub-stage-replay-glyph" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M8 5v14l11-7z" fill="currentColor" />
                  </svg>
                  <span class="hub-stage-replay-text">Play trailer</span>
                  <span class="sr-only"> for {event.title}</span>
                </button>
              )}
            </div>

          </div>
          
          {/*
            THE STAGE — the deck page's right-hand half, brought here.

            The mark sits crisp and large, and where the hub has a trailer the
            video fades in over it once the player CONFIRMS it is playing, then
            dissolves back. The mark is what the panel rests on before the video
            arrives and after it ends, so this side is never empty and a blocked
            autoplay degrades to a lit brand mark rather than a paused YouTube
            page.

          */}
          <div
            class="hero-trailer hub-stage "
            style="animation-delay: 0.2s;"
            data-trailer={trailerId ?? undefined}
          >
            {/*
              ONE LAYER, THREE POSSIBLE CONTENTS — deliberately not three
              layers. Every state this stage has (`is-playing` fades it to
              0.28 behind the video, `is-item` takes it to 0, reduced-motion
              drops its transition) is already written against
              `.hub-stage-mark`, so changing WHAT it holds costs no new state
              rules and cannot leave one of them behind.

              The wordmark is the last resort, for an event with neither key
              art nor a logo. It is not reachable for anything in the store
              today, and it is what keeps the stage from being an empty box
              if one ships that way.
            */}
            <div
              class:list={['hub-stage-mark', { 'hub-stage-mark--art': !!stageArtUrl }]}
              aria-hidden="true"
            >
              {stageMarkUrl ? (
                /* HARD RULE 6: no filter on the <img>. The glow is on the wrapper. */
                <img src={stageMarkUrl} alt="" class="hub-stage-mark-img" />
              ) : stageArtUrl ? (
                /*
                  TWO COPIES OF ONE FILE. Same src, same srcset, so the
                  browser fetches once and paints it twice.

                  The back one COVERS and is blurred, and it is only ever
                  visible in the gutters the front one leaves. The front one
                  CONTAINS, which is what guarantees the whole image is on
                  screen with nothing cut off.

                  An <img>, not a painted box: this started as a
                  background-image so it could be overscanned past a clip, and
                  a real element is what carries a srcset. HARD RULE 6 is
                  satisfied by `filter: none` on the wrapper — the only filter
                  here is a blur on the fill, and there is no drop-shadow
                  anywhere near either of them.
                */
                                  <img
                    src={stageArtUrl}
                    srcset={stageArtSrcset}
                    sizes={stageArtSizes}
                    alt=""
                    aria-hidden="true"
                    class="hub-stage-art-fill"
                    loading="eager"
                    decoding="async"
                  />
                  <img
                    src={stageArtUrl}
                    srcset={stageArtSrcset}
                    sizes={stageArtSizes}
                    alt=""
                    class="hub-stage-art-img"
                    loading="eager"
                    decoding="async"
                  />
              ) : (
                <span class="hub-stage-wordmark">{event.title}</span>
              )}
            </div>

            {hasPlayableVideo && (
              /*
                HARD RULE 4: the idle src is 'about:blank', NEVER ''. An empty
                src resolves to the current page and loads the whole site inside
                the frame. HARD RULE 3: nothing above this clips — the backdrop
                does the clipping and is a SIBLING, not an ancestor.
              */
              <div class="hub-stage-video">
                <iframe
                  class="hub-stage-iframe"
                  src="about:blank"
                  data-src={`https://www.youtube-nocookie.com/embed/${trailerId}?mute=1&controls=0&modestbranding=1&rel=0&playsinline=1&disablekb=1&iv_load_policy=3&cc_load_policy=0&controls=0&enablejsapi=1`}
                  title={event.title ? `${event.title} Trailer` : "Event Trailer"}
                  aria-hidden="true"
                  tabindex="-1"
                  loading="lazy"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share; fullscreen"
                  allowfullscreen
                ></iframe>
              </div>
            )}

            {hasPlayableVideo && (
              /*
                SOUND HAS TO BE ASKED FOR, AND THERE HAS TO BE SOMETHING TO ASK.

                Everything on this stage starts muted, because muted is the only
                state a browser will let start on its own. The trailer runs with
                `controls=0`, so without this button there was no way to hear it
                at all — reported as "the initial trailer doesn't have an unmute
                button, so you can never unmute it".

                A sibling of the video, never a child: HARD RULE 3 means nothing
                may wrap the iframe in a clipping box.
              */
              <button type="button" class="hub-stage-sound" data-sound="off" aria-pressed="false">
                <svg class="hub-stage-sound-glyph" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path d="M4 9v6h4l5 4V5L8 9H4z" fill="currentColor" />
                  <g class="hub-stage-sound-off" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <line x1="16" y1="9" x2="21" y2="15" />
                    <line x1="21" y1="9" x2="16" y2="15" />
                  </g>
                  <g class="hub-stage-sound-on" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round">
                    <path d="M16.5 8.8a4.5 4.5 0 0 1 0 6.4" />
                    <path d="M19 6.5a8 8 0 0 1 0 11" />
                  </g>
                </svg>
                <span class="hub-stage-sound-label">Sound</span>
              </button>
            )}

            {/*
              NO "Watch on YouTube" link on an EVENT stage (Andrew): an event
              page is the HQ's hub for that event, not a funnel to the
              event's own YouTube channel, and the link sat over the player.
              The /featured/[slug] hub stage keeps its link. The exposure this
              reopens (a refused embed has no door here) is accepted; see
              CLAUDE.md hard rule 11 and scripts/embed-escape.test.mjs.
            */}

            {/*
              ONE PANE PER FEATURED ITEM, hidden until its rail card is picked.

              A still and a title — never an autoplaying embed. Playback follows
              a CLICK here, which is the whole reason this page can carry video
              at all: a player the visitor asked for is allowed to show its own
              controls, so none of the chrome problems that plagued the deck
              page apply. Videos open in the site's existing modal via the
              global [data-action="open-video"] handler; articles are ordinary
              links.
            */}
            {heroItems.map((item: any, i: number) => {
              const isVideo = item.contentType === 'video';
              const vid = isVideo ? parseVideoId(item.link || '') : null;
              const still = item.image ?? item.thumbnail ?? null;
              /*
                `inert` AS WELL AS `aria-hidden`, and they must move together.

                A hidden pane still contains a real `Play` button or `Read`
                link. `aria-hidden` takes it out of the accessibility tree but
                leaves it in the TAB ORDER, so a keyboard user could land on a
                control inside a pane nobody can see, announced as nothing
                because the tree says it is not there. axe rates it serious
                (`aria-hidden-focus`), 13 nodes on a five-item hub.

                `inert` is the attribute that actually removes a subtree from
                focus, and it ships in the markup rather than being applied on
                init, so the page is correct before any script runs — the same
                reasoning as the reveal failsafe.

                This note sits ABOVE the return, as a plain block comment.
                An Astro-style JSX comment placed inside the return makes the
                callback return two nodes and the build fails with
                "Expected , or ) but found class". Written up two commits ago
                for the /featured rail and walked into again here.

                NOTE: astro check does NOT catch that - only npm run build
                does. Do not take a clean check as proof this file compiles.
              */
              return (
                <div class="hub-stage-item" data-index={i} aria-hidden="true" inert>
                  {still && <img src={heroItemArt[i].src || still} srcset={heroItemArt[i].srcset || undefined} sizes={heroItemArt[i].srcset ? STAGE_PANE_SIZES : undefined} alt="" class="hub-stage-item-still" loading="lazy" />}
                  <span class="hub-stage-item-scrim"></span>
                  <div class="hub-stage-item-copy">
                    <span class="hub-stage-item-kind">{isVideo ? 'Video' : 'Article'}</span>
                    <p class="hub-stage-item-title">{item.title}</p>
                    {isVideo && vid ? (
                      /*
                        `data-hub-play`, NOT `data-action="open-video"`. The
                        latter is the site's global handler and it opens the
                        full-screen modal — which is right for a card in a feed
                        and wrong here: this panel IS the player, so a video
                        launching a popup out of it reads as the page losing
                        its place. Plays in the stage instead.
                      */
                      <button type="button" class="hub-stage-item-action" data-hub-play={vid}>
                        Play
                      </button>
                    ) : (
                      <a href={item.link || '#'} class="hub-stage-item-action">Read</a>
                    )}
                  </div>
                </div>
              );
            })}
          
          {/*
            ─── THE PANE FOR AN ARTICLE CHOSEN OUTSIDE THE RAIL ───────────────

            One pane, and it lives INSIDE the panes wrapper with the mapped
            ones. It shipped duplicated, with a stray closing tag between the
            two copies, which put the second copy outside the wrapper and left
            the template with one more closing tag than opening tags. The build
            failed with "Closing tag has no matching opening tag" and
            `astro check` passed clean, which is the trap CLAUDE.md records:
            only a build catches a structural error in the template.

            It also has to be a sibling of the mapped panes for the code that
            drives it — `stage.querySelectorAll('.hub-stage-item')` toggles
            `active` across all of them, and a pane outside the wrapper is
            positioned against a different box.
          */}
          <div class="hub-stage-item hub-stage-item--dynamic" data-index="dynamic" aria-hidden="true" inert>
            <img alt="" class="hub-stage-item-still" loading="lazy" style="opacity: 0;" />
            <span class="hub-stage-item-scrim"></span>
            <div class="hub-stage-item-copy">
              <span class="hub-stage-item-kind">Article</span>
              <p class="hub-stage-item-title"></p>
              <a href="#" class="hub-stage-item-action">Read</a>
            </div>
          </div>
          </div>
            {heroItems.length > 0 && (
              /*
                THE RAIL. The hub's most recent coverage, videos and articles
                together — picking one swaps the stage to it. Real <button>s, so
                the rail is reachable and operable from a keyboard; the deck on
                /featured shipped as divs once and closed rows were unreachable.

                ─── NOTHING IS SELECTED UNTIL SOMETHING IS ──────────────────

                The first tile used to ship `i === 0 ? 'active' : ''` and
                `aria-pressed="true"`. That is one piece of state kept in two
                places, and the two halves disagreed from the first frame: the
                rail said tile 0 was chosen, the stage panes below hardcode
                NOTHING as chosen, and `show()` — the function whose whole job
                is keeping them in sync — is never called on load, only on
                click.

                So a fresh hub page highlighted "Marvel's Wolverine" while the
                stage played PlayStation's own trailer. It pointed at the wrong
                thing on every device on every load, and `aria-pressed="true"`
                told a screen reader the same lie.

                Selecting a tile also UNLOADS the trailer (see `show()`), so the
                two states are genuinely exclusive — there is no reading under
                which both were true at once.

                The rail now starts with nothing pressed, which is what is
                actually the case. Issue #150 covers the better version: the
                trailer hands over to tile 0 when it ENDS (YouTube reports
                state 0 through the postMessage channel this page already
                listens on), so the highlight appears only once it is telling
                the truth.

                This note stays OUT of the map below: a callback has to return
                a single element, so a comment beside the <button> makes it
                return two nodes and the file stops type-checking. It also has
                to be a plain block comment rather than a JSX one, because this
                is a JS expression, not JSX children. Both were tried.
              */
              <div class="hub-rail" role="group" aria-label={`Recent ${event.title || 'event'} coverage`}>
                {heroItems.map((item: any, i: number) => (
                  <button
                    type="button"
                    class="hub-rail-card"
                    data-index={i}
                    aria-pressed="false"
                  >
                    {(item.image ?? item.thumbnail) ? (
                      <img src={heroItemArt[i].src || (item.image ?? item.thumbnail)} srcset={heroItemArt[i].srcset || undefined} sizes={heroItemArt[i].srcset ? RAIL_THUMB_SIZES : undefined} alt="" class="hub-rail-thumb" loading="lazy" />
                    ) : (
                      <span class="hub-rail-thumb hub-rail-thumb--empty"></span>
                    )}
                    <span class="hub-rail-label">
                      {item.contentType === 'video' ? 'Watch' : 'Read'}
                    </span>
                    <span class="sr-only">{item.title}</span>
                  </button>
                ))}
              </div>
            )}

          {/* Placed after the trailer in the DOM so mobile stacks copy →
              trailer → button; grid-areas restore the desktop layout. */}
          {/*
            UNCONDITIONAL NOW, and that is load-bearing rather than tidy. The
            row it sits in changes the grid's track sizing, and while it was
            gated on a URL a document might not have, four events rendered a
            different grid from the rest — which is half of what moved the
            metadata row around. An in-page target always exists.

            No target="_blank" and no rel: this scrolls, it does not navigate.
          */}
          <div class="hero-info-cta">
            <a href={heroCtaHref} class="hero-rsvp-btn">
              Event Details
            </a>
          </div>
        </div>
      </div>
    </section>

    {/* 2. BOTTOM HALF: Article Layout View */}
    <div class="container event-article-wrapper" style="padding-top: 5rem; padding-bottom: 4rem;">
      <div class="article-layout">
        
        {/* LEFT RAIL: Navigation */}
        <aside class="article-rail article-rail-left">
          <nav class="article-toc" aria-label="Event Navigation">
            {/*
              No inline styling. `.article-rail-head` in styles/modules/article.css
              already sets the display font, size, tracking, uppercasing and the
              rule beneath it — the inline `margin-bottom: 1.5rem` only made this
              heading sit differently from the identical "Contents" heading on an
              article, and the `text-transform` merely restated what the class
