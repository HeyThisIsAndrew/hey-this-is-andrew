        {/* CENTER COLUMN: Event Content */}
        <article class="article-column">
          
          {/* Section: About */}
          <section id="event-description" class="scroll-mt-32 intel-break">
            <div class="intel-break-head">
              <h2 class="intel-break-title">ABOUT</h2>
            </div>
            <div class="article-body event-editorial-body">
              {event.description || event.body ? (
                <Fragment set:html={event.body || `<p>${event.description}</p>`} />
              ) : (
                <Fragment>
                  <p>
                    {event.startDate && (
