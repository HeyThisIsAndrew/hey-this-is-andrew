                  {event.endDate && event.endDate !== event.startDate && (
                    <div class="flex flex-col">
                      <dt class="font-bold text-gray-200 text-[0.7rem] tracking-[0.15em] uppercase" style="margin-bottom: 0.4rem;">End</dt>
                      <dd class="text-base text-gray-300">{new Date(event.endDate + 'T00:00:00').toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</dd>
                    </div>
