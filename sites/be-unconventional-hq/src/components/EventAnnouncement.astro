            <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-12 gap-y-12 border-b border-white/10" style="padding-top: 2.5rem; padding-bottom: 2.5rem;">
              <div>
                <dl style="display: flex; flex-direction: column; gap: 2rem;" class="text-sm text-gray-400">
                  {event.startDate && (
