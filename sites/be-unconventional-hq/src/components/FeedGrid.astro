---
import ContentCard from './ContentCard.astro';
import FeedRowBanner from './FeedRowBanner.astro';
import { getImage } from 'astro:assets';
import { rowArt } from '../lib/row-art';
import EmptyState from './EmptyState.astro';
import { LABELS, MESSAGES } from '../data/content.js';
import { getFeaturedBrandsLocal, getEventsLocal, urlFor } from '../lib/local-content';
import { resolveEntity, hexToRgbTriple } from '../lib/entity-resolver';
import { getHubMatchTags, matchVideosByTags } from '../lib/hub-coverage';
import CommercialRotator from './CommercialRotator.astro';
import FloatingPageNav from './FloatingPageNav.astro';
import {
  buildRails,
  selectCollections,
  inSeries,
  accentFor,
  seriesSlug,
  byNewest,
  HUB_CATEGORY_ORDER,
  RAIL_LIMIT,
} from '../lib/feed-rails';

export interface Props {
  page: any;
  allItems: any[];
}

/*
  `page` is still accepted so the three /feed routes keep one call shape with
  FeedLayout, which reads it for rel=prev/next. This component no longer uses
  it: the flat grid that consumed `page.data` is gone, and the rows render from
  `allItems` — the whole feed, not a page of it.
*/
const { allItems = [] } = Astro.props;
const safeAllItems = Array.isArray(allItems) ? allItems : [];

/*
  ─── THE ROWS ARE BUILT FROM `hubs`, NOT `franchises` ───────────────────────

  The brief specified `item.franchises?.includes('dc')`. That field exists on
  the type and on all 215 synced documents, and it is EMPTY on every one of
  them — `franchises: doc.franchises ?? []` in src/lib/videos.ts is defaulting,
  not carrying data, because nothing populates it yet. A row built on it renders
  zero cards, and it does so silently: an empty row looks like "no coverage",
  not like a wiring bug.

  `hubs` is the populated taxonomy, and its values are full slugs — `dc-comics`
  and `marvel-comics`, NOT `dc` and `marvel`. Counted from src/data/videos.json:
  dc-comics 29, warner-bros 29, hbo-max 26, marvel-comics 21, prime-video 9,
  netflix 6.

  Lanterns is the one match the brief got exactly right: `youtubeTags` carries a
  lowercase `lanterns` on 26 documents, so `.includes('lanterns')` finds them
  without any normalising. It is still compared case-insensitively below, since
  youtubeTags is raw YouTube data and a future upload saying "Lanterns" would
  otherwise drop out of its own row.

  Adding a row is a line in this array. Rows that match nothing are dropped
  before render, so an empty one can never ship.
*/
const hubBrands = getFeaturedBrandsLocal();
const hubEvents = getEventsLocal();

/*
  ─── A HUB ROW HOLDS EVERYTHING ABOUT THAT HUB, NOT JUST THE VIDEOS ────────

  This was `Array.isArray(item.hubs) && item.hubs.includes(slug)` and nothing
  else, which quietly made every franchise and streamer row video-only.

  `hubs` is written by the YouTube sync and exists only on video records.
  Articles come from Substack and carry `tags`, so no article could ever
  satisfy that test — the DC row dropped both DC articles, Netflix dropped
  both Netflix articles, and so on, with no error and no empty row to notice.
  A row like "DC" is a TOPIC. Media type is the concern of exactly three rows,
  all of them in The Latest.

  ─── WHY THE KEYWORDS ARE NOT LISTED HERE ─────────────────────────────────

  The obvious repair is a per-row array of fallback words in this file. It
  would work today and rot immediately: CLAUDE.md states that there is ONE tag
  list per hub, `youtubeSyncKeywords` (labelled "Tags" in the CMS), and that it
  is the list feeding both the sync and the site's own matching. A second copy
  in a component is the exact drift that note exists to prevent, and it would
  be invisible to the editor who maintains the first.

  So step 3 reads the hub's own vocabulary through `getHubMatchTags()` and
  compares with the site's `compactTag` normalisation, the same path
  /featured/<slug> and /events/<slug> use for their coverage.

  Verified against the store: dc-comics, marvel-comics, hbo-max, netflix and
  prime-video each pick up 2 articles this way. Note an item can satisfy
  SEVERAL hubs — the Lanterns article is both DC and HBO Max — which is right,
  and which `resolveEntity()` could not express on its own since it returns one
  best hub per item.
*/
const slugOfDoc = (doc: any) =>
  typeof doc?.slug === 'string' ? doc.slug : doc?.slug?.current ?? null;

const allHubDocs = [...hubBrands, ...hubEvents];

/*
  ─── A TOPIC IS NOT A HUB ──────────────────────────────────────────────────

  Film, TV and Games are the site's Tier-1 topics, and they are stored in two
  different places depending on where the item came from: the YouTube sync
  writes `topics: ['film']` on a video, and a Substack article carries
  `category: 'Film'`. An item only ever has one of them.

  `games` and `gaming` are the same topic under two names — CLAUDE.md records
  the rename, and both spellings are still in the store (videos say `gaming`,
  articles say `Games`), so the alias is read here rather than left to whoever
  writes the next row definition.
*/
const TOPIC_ALIASES: Record<string, string[]> = {
  film: ['film', 'movies'],
  tv: ['tv', 'television'],
  games: ['games', 'gaming'],
  events: ['events', 'event'],
};

const hasTopic = (item: any, topic: string) => {
  const wanted = TOPIC_ALIASES[topic] ?? [topic];
  const topics = Array.isArray(item?.topics) ? item.topics.map((t: any) => String(t).toLowerCase()) : [];
  if (topics.some((t: string) => wanted.includes(t))) return true;
  const category = String(item?.category ?? '').toLowerCase();
  return wanted.includes(category);
};

const matchesHub = (item: any, slug: string) => {
  /* 1. The sync's explicit taxonomy — videos. */
  if (Array.isArray(item?.hubs) && item.hubs.includes(slug)) return true;

  /* 2. An editor naming the hub outright. */
  if (item?.relatedBrandSlug === slug) return true;

  /* 3. The hub's own tag vocabulary — articles, and any video whose tags name
     the hub without the sync having written it into `hubs`. */
  const hub = allHubDocs.find((doc) => slugOfDoc(doc) === slug);
  if (!hub) return false;
  return matchVideosByTags([item], getHubMatchTags(hub)).length > 0;
};

/*
  The `hasTag()` helper that stood here matched an item against a literal tag
  name, and its only caller was the hardcoded Lanterns shelf. Collection
  membership is decided by `inSeries()` in src/lib/feed-rails.ts now, which
  reads the editor's `series` field first and falls back to the same two tag
  fields so an article can still join.
*/

/* --color-accent in the global tokens. The last rung of a collection's accent
   chain, so one with no accent and no usable hub colour is still lit. */
const SITE_ACCENT = '#cc0000';

/*
  ─── COLLECTION ARTWORK, RESOLVED AT BUILD TIME BY CONVENTION ──────────────

  A collection named "The Umbrella Academy" looks for
  src/assets/rows/the-umbrella-academy-key-art.(jpg|png|webp) and ...-logo.png.
  Drop the files in and the banner appears; leave them out and the shelf renders
  its text lockup like any other row. No code change either way, which is the
  whole point of a convention over a table.

  `eager` because there are at most a handful and the row needs the metadata
  (width/height) synchronously to render without layout shift. A missing file is
  not an error by design: a build that failed because an editor had not uploaded
  artwork yet would be a worse trade than a shelf that renders plain.
*/
/* rowArt() lives in src/lib/row-art.ts, shared with the homepage. */

/* seriesSlug() lives in src/lib/feed-rails.ts: the homepage links to these
   rows by it, so there is one definition of a row's anchor. */

/*
  `hubHref()` stood here, turning a row id into /featured/<slug> or
  /events/<slug>. The rails are categories rather than single hubs now, so
  their explore link goes to the matching accordion row on /featured
  (`/featured#streaming`), which is built inline where the rails are.
*/

/*
  ─── EVERY BRANDED ROW IS LIT IN ITS OWN COLOUR ────────────────────────────

  The accent is READ FROM THE HUB, not listed here: `brandColor` already exists
  on each featuredBrand (DC #0476F2, Marvel #E23636, Netflix #E50914, Prime
  Video #00A8E1, HBO Max #002BE7, Star Wars #FFE81F), so the shelf lighting is
  editor-controlled from the CMS like everything else about a hub.

  WHITE IS SKIPPED. Four brands store #FFFFFF (Sony Pictures, Universal, A24,
  Apple TV+), and a white wash over a near-black page is not an accent, it is a
  grey fog across the row with no hue to read as branding. Those rows stay
  unlit, which is the honest result for a brand whose colour is white.

  The three global rows resolve to no hub at all and so stay clean by
  construction — nothing to special-case.
*/
/*
  `buildRow()` stood here: it took a hand-written RowDef, resolved the hub's
  mark and key art for the row's bookends, and read its accent colour. Every
  one of those jobs now belongs to either `buildRails()` (the taxonomy rails,
  which need no per-row furniture) or the collection builder below (which needs
  all of it, and gets it from the series rather than from a literal).
*/

/*
  ─── NO TWO ADJACENT TILES MAY SHARE ARTWORK ───────────────────────────────

  The channel reuses one thumbnail across a run of episode reviews, so a
  chronological Lanterns row put four visually identical green-ring tiles side
  by side and read as a rendering fault rather than as four different episodes.

  This REORDERS rather than drops: an item whose artwork repeats the previous
  tile is held back and re-offered after the next distinct one, so nothing
  leaves the row and the sequence stays as close to newest-first as the
  artwork allows. Dropping duplicates would have hidden real episodes.

  Falls back to plain order when every remaining item shares one image, which
  is the only case where the constraint cannot be satisfied at all.
*/
function spreadByArtwork(items: any[]): any[] {
  const art = (item: any) => item?.thumbnail || item?.image || '';
  const queue = [...items];
  const out: any[] = [];

  while (queue.length > 0) {
    const lastArt = out.length > 0 ? art(out[out.length - 1]) : null;
    const nextIndex = queue.findIndex((item) => art(item) !== lastArt);
    out.push(...queue.splice(nextIndex === -1 ? 0 : nextIndex, 1));
  }

  return out;
}

/*
  ─── CURATED COLLECTIONS ───────────────────────────────────────────────────

  One shelf per series an editor has flagged, most recently updated first, each
  with the prestige treatment. This is the Lanterns section generalised: the
  look is unchanged, and the only thing that moved is how it learns which show
  it is about.

  `spreadByArtwork` still applies. The channel reuses one thumbnail across a run
  of episode reviews, so a chronological collection put four visually identical
  tiles side by side and read as a rendering fault rather than four episodes.
*/
const collections = selectCollections(safeAllItems).map((chosen) => {
  const members = safeAllItems.filter((item) => inSeries(item, chosen.name)).sort(byNewest);
  const hub = members.reduce<ReturnType<typeof resolveEntity>>(
    (found, item) => found ?? resolveEntity(item, { brands: hubBrands, events: hubEvents, urlFor }),
    null,
  );

  /*
    ─── THE SHELF IS THEMED FOR THE SHOW, NOT ITS STUDIO ────────────────────

    Three rungs. `seriesAccent` from any member of the collection, so the theme
    outlives the flagged document; then the hub's own CMS-editable brandColor;
    then the site accent, so a collection shelf is ALWAYS lit. An unlit row is
    right for an ordinary rail whose brand is white and wrong under a banner
    and a lockup, where it leaves a half-finished treatment.

    White is skipped at the second rung for the reason it is skipped everywhere
    on this page: over a near-black ground it is not an accent, it is grey fog.
  */
  const rawHub = (hub as any)?.color;
  const hubHex = typeof rawHub === 'string' ? rawHub : rawHub?.hex ?? null;
  const usableHub = hubHex && hubHex.toLowerCase() !== '#ffffff' ? hubHex : null;
  const accentHex = accentFor(members) || usableHub || SITE_ACCENT;

  const slug = seriesSlug(chosen.name);
  const art = rowArt(`${slug}-key-art`);

  return {
    id: slug,
    name: chosen.name,
    reason: chosen.reason,
    items: spreadByArtwork(members).slice(0, RAIL_LIMIT),
    hub,
    accentColor: accentHex,
    accentRgb: hexToRgbTriple(accentHex),
    bannerArt: art,
    /* All or nothing: there is deliberately no half state where a logo floats
       over the page with no art behind it. */
    bannerLogo: art ? rowArt(`${slug}-logo`) : null,
    eyebrow: hub ? `FEATURED SERIES \u2022 ${hub.title.toUpperCase()}` : 'FEATURED SERIES',
  };
}).filter((c) => c.items.length > 0);

/*
  ─── A COLLECTION TILE CARRIES THE SHOW, NOT THE HUB ───────────────────────

  These items resolve to their hub, so promoting one into the spotlight hero
  filled it with the hub's key art and roundel, under a banner showing the
  show's own logo. The row and the hero it drove disagreed about what you were
  looking at. Where a collection has artwork of its own, its tiles hand that to
  the hero instead, sized for a backdrop rather than shipping the 2560px master.
*/
const collectionBrands = new Map<string, { title?: string; hero: string; logo?: string }>();
for (const collection of collections) {
  if (!collection.bannerArt) continue;
  collectionBrands.set(collection.id, {
    title: collection.name,
    hero: (await getImage({ src: collection.bannerArt, width: 1600 })).src,
    logo: collection.bannerLogo
      ? (await getImage({ src: collection.bannerLogo, width: 640 })).src
      : undefined,
  });
}

/*
  ─── THE RAILS ─────────────────────────────────────────────────────────────

  Derived from `hubCategory`, the same field /featured groups its directory by,
  so re-categorising a hub in the CMS moves it on both pages and adding one
  needs no code at all. The matchers stay here: they are the page's existing
  understanding of what belongs to a hub or a topic, and the rail builder is
  handed them rather than growing a second copy.
*/
const shownInCollections = new Set(collections.flatMap((c) => c.items));

const rails = buildRails(safeAllItems, {
  hubs: hubBrands,
  matchesHub,
  hasTopic,
  alreadyShown: shownInCollections,
  hrefForCategory: (category) =>
    HUB_CATEGORY_ORDER.includes(category as any) ? `/featured#${category}` : null,
});

const hasRows = collections.length > 0 || rails.length > 0;

/*
  The floating nav lists the collections and then the rails, which is the page's
  own order. With the sections flattened there is no second level to represent.
*/
const navItems = [
  ...collections.map((c) => ({ id: c.id, text: c.name, level: 2 })),
  /*
    `r.anchor ?? r.id`, the SAME expression the section element uses below. The
    nav links by `getElementById`, so giving it the rail's internal id while the
    element carries its public anchor is a link to nothing: the Games entry
    pointed at `#gaming` against a section with `id="games"` and its handler
    returned at `if (!id || !heading) return;`, silently. Introduced here by the
    anchor change itself and caught by reading the rendered hrefs back.
  */
  ...rails.map((r) => ({ id: r.anchor ?? r.id, text: r.title, level: 2 })),
];
---

<style>
  /* ─── NETFLIX ROWS ──────────────────────────────────────────────────────── */

  /* There is one view now. The rules that swapped this wrapper between the rows
     and a hidden results grid went with the grid itself — there is no
     `is-filtered` state left to enter, and nothing to hide. */

  /* ─── OVERARCHING SECTIONS ──────────────────────────────────────────── */

  /*
    The rows now sit directly under the hero: the filter row that used to
    separate them is gone from /feed (FeedLayout's `showFilters`). That row
    carried `margin: 4rem 0 3rem`, and it took the gap with it, so the first
    row had nothing holding it off the bottom of the hero. This is the standard
    editorial spacing, owned by the thing that actually needs it rather than
    inherited from a neighbour that might be removed again.
  */
  #feed-rows {
    padding-top: 3rem; 
  }
  
  /*
    ─── WHY THE SEAM MOVED WITH THE WINDOW ───────────────────────────────────

    This pulled the rows up over the hero with `margin-top: -6vh`, and the hero
    below it used to carry a mask fading its bottom edge out. The mask was
    removed; the overlap was not, only reduced. What was left is a hard-edged
    hero with the rows still sliding under it by an amount nobody can predict.

    `vh` is a fraction of the window's HEIGHT. The hero's height is set by its
    CONTENT: how many lines the headline wraps to, how tall the stage is. Those
    two numbers have nothing to do with each other, so the overlap was a
    different fraction of the hero at every window size. Measured on this page:

      1440 x 900    hero 654px   overlap  54px    8.3% of the hero
      1440 x 1800   hero 654px   overlap 108px   16.5% of the hero
      3840 x 2160   hero 632px   overlap 130px   20.5% of the hero

    The first two are the SAME page at the same width. Only the window's height
    changed, and the overlap doubled. At 4K it is worse than either: the hero is
    actually shorter there, while the overlap is largest, so the two move in
    opposite directions.

    That is the whole of "it's different at different window sizes", and no
    amount of retuning the number fixes it — any `vh` value has the same
    problem. So the overlap is gone. The hero ends where it ends and the banner
    begins, which is identical at every size because neither measurement
    depends on the other.
  */
  :global(.has-spotlight-hero) #feed-rows {
    position: relative;
    z-index: 1; /* Sits under the hero's z-index: 10 */
    margin-top: 0;
  }

  /*
    A full-bleed banner directly under a full-bleed hero reads as one cinematic
    block, so there is no gap between them to pay for. Without a banner the
    first row is type on the page ground and still needs its air.
  */
  :global(.has-spotlight-hero) #feed-rows[data-hero-banner] {
    padding-top: 0;
  }

  @media (max-width: 768px) {
    #feed-rows {
      padding-top: 2rem;
    }
    :global(.has-spotlight-hero) #feed-rows {
      margin-top: 0;
    }
  }

  /* The rotator brings its own internal padding, so this only owns the gap
     between it and the shelves either side of it. */
  .feed-rotator-break {
    margin-block: 1rem 2.5rem;
  }

  /*
    ─── RAILS ────────────────────────────────────────────────────────────────

    A rail is a `.feed-row` with a plain heading. It reuses the row metrics, the
    rail scrolling, the snapping and the chevrons exactly as they were; the only
    new rule is the heading size, which steps up from a row title because a rail
    IS a section now rather than one row inside one.

    ─── WHAT WAS REMOVED HERE ────────────────────────────────────────────────

    Every `.feed-section*` rule: the heads, the titles, the row wrappers and the
    whole collapsed-section treatment (toggle, chevron, count). They styled six
    collapsible SECTIONS containing fourteen rows. There are no sections any
    more, so nothing matched them, and dead CSS on a page in the Lighthouse gate
    is not free.
  */
  .feed-rail {
    margin-bottom: 3rem;
  }

  .feed-rail-title {
    font-size: clamp(1.05rem, 1.7vw, 1.45rem);
    letter-spacing: 0.06em;
    color: var(--color-white, #f0f0f0);
  }

  /*
    ONE EXPLORE LINK, USED AT THREE DEPTHS — the tentpole shelf, a section
    heading and a row heading. `.prestige-hub-link` keeps its emerald tint on
    the lit shelf; everything else reads in the neutral one. Same metrics, same
    glyph, same hover, so the three never drift apart.
  */
  .feed-hub-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    flex-shrink: 0;
    font-family: var(--font-body);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    color: rgba(255, 255, 255, 0.62);
    transition: color 0.25s ease;
  }

  .feed-hub-link:hover,
  .feed-hub-link:focus-visible {
    color: var(--color-white, #f0f0f0);
  }

  .feed-hub-link:focus-visible {
    color: var(--color-white, #f0f0f0);
  }

  .feed-row-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-shrink: 0;
  }

  .feed-row {
    margin-bottom: 2.75rem;
  }

  .feed-row-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.85rem;
  }

  .feed-row-title {
    font-family: var(--font-display, sans-serif);
    font-size: clamp(1rem, 1.6vw, 1.35rem);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-white, #f0f0f0);
    margin: 0;
  }

  /*
    THE RAIL.

    `overflow-x: auto` with mandatory snapping, and the scrollbar hidden on all
    three engines — WebKit needs a pseudo-element, Firefox needs
    `scrollbar-width`, old Edge needs `-ms-overflow-style`. Hiding it is only
    safe because the chevrons exist on desktop and touch scrolls natively.

    `overscroll-behavior-x: contain` stops a rail that has hit its end from
    handing the gesture to the browser, which on iOS is the back-swipe: without
    it, flicking the last card sideways navigates away from the feed.
  */
  /*
    ─── THE RAIL RUNS EDGE TO EDGE, THE HEADINGS DO NOT ───────────────────────

    `.container-page` gives this page a 25.6px gutter and a 1536px max-width.
    The section and row headings want both. The rail wants neither: a card
    should scroll past the edge of the screen, not stop short of it inside an
    invisible box.

    `margin-inline: calc(50% - 50vw)` is the break-out. `50%` is half the
    element's own containing block and `50vw` is half the viewport, so the
    negative margin is exactly the distance from the container's edge to the
    viewport's on each side — it works at any width, including above the
    container's max-width where the gap is much larger than the gutter.

    `padding-inline` then puts that distance straight back as PADDING rather
    than margin, which is the whole trick: the scrollable area now spans the
    viewport, but the first card still starts on the same vertical line as the
    heading above it, and the last one can scroll fully off the right edge.

    KNOWN AND ACCEPTED: `vw` includes the scrollbar, 15px here, so the rail
    overshoots the layout viewport by 7.5px a side. `body` is `overflow-x:
    clip` (verified: the document's horizontal overflow is 0), so this is
    clipped rather than scrollable, and it costs about a tenth of the feather
    width below. Correcting it would mean publishing the scrollbar width from
    JS and making a layout rule depend on a script having run.
  */
  .feed-row-rail {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    list-style: none;
    margin-block: 0;
    margin-inline: calc(50% - 50vw);
    /*
      ─── ROOM FOR THE HOVER LIFT ──────────────────────────────────────────

      A scroll container cannot clip one axis and show the other: `overflow-x:
      auto` forces `overflow-y` to clip too, whatever it is set to. The slate
      lifts 4px and casts a 28px shadow on hover, and both were being cut off
      flush at the rail's edges.

      Padding, not margin: it is inside the scrollport, so the lifted card has
      somewhere to go.
    */
    padding-block: 0.75rem 1.5rem;
    padding-inline: calc(50vw - 50%);

    /*
      ─── SNAPPING IGNORES `padding`, SO THE GUTTER HAS TO BE DECLARED TWICE ──

      `scroll-snap-align: start` aligns a card to the SNAPPORT, and the
      snapport starts at the scroll container's padding-box edge unless
      `scroll-padding` says otherwise. So the snap engine treated the gutter
      above as empty space to be scrolled away: the rail loaded at
      `scrollLeft: 32` on a phone, putting the first card flush against the
      screen edge, 32px to the left of the heading it is supposed to line up
      with. It looked like the padding had not applied at all. It had; the
      scroll position was hiding it.

      It CANNOT be fixed in this rule, which is why it is set from the script
      below instead. `scroll-padding`'s percentages resolve against the
      scrollport — this element's own, now full-bleed, padding box — while
      `padding`'s resolve against the containing block. The identical
      expression therefore means two different things on the two properties:
      `calc(50vw - 50%)` computes to 32px as padding here and to exactly 0 as
      scroll-padding, which is the value that was doing nothing. `sync()` copies
      the resolved padding across, so the two can never disagree, and it
      already re-runs on resize.
    */

    /*
      ─── THE FEATHER IS SCROLL-AWARE, NOT ALWAYS ON ──────────────────────────

      A flat `linear-gradient(to right, transparent 0%, black 5%, black 95%,
      transparent 100%)` fades BOTH edges permanently, and the first card sits
      at the left edge — so the card a reader looks at first is always half
      faded, before anything has scrolled anywhere. The effect is meant to say
      "this continues past the edge"; on a rail resting at position 0 nothing
      continues past the left edge, and saying so is a lie the eye reads as a
      rendering fault.

      So each side's feather is a variable, and `sync()` in the script below
      turns it on only for a side that genuinely has content beyond it. Both
      default to 0, which makes the gradient fully opaque — that is also the
      correct no-JS state, since without script there is no scroll position to
      reason about and a permanently faded card would be the only visible
      result.
    */
    --feed-fade: clamp(28px, 5vw, 96px);
    --fade-start: 0px;
    --fade-end: 0px;
    -webkit-mask-image: linear-gradient(
      to right,
