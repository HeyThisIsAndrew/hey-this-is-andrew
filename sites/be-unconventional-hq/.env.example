# Copy to .env for local development. In production these live in the
# Cloudflare environment (Settings → Environment variables, encrypted).

# --- YouTube Data API v3 (issues #20/#21) ---
# Google Cloud Console → enable "YouTube Data API v3" → create API key.
# Used by: scripts/sync-youtube.mjs (video ingestion) and
#          /api/live-status.json (live detection).
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Optional — defaults to the BE Unconventional HQ channel.
# YOUTUBE_CHANNEL_ID=UCXqU6781pQgYXDExLvMw2Og

# --- Twitch live detection (optional — endpoint ignores Twitch until all
#     three are set; see scripts/live-status.md) ---
# dev.twitch.tv → register an application → client id + secret.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_CHANNEL_LOGIN=

# --- Sanity (write access; NEVER needed by the site itself) ---
# manage.sanity.io → project → API → Tokens → "Editor" token.
# Used by the Sanity Studio at /admin (image hosting + the legacy schema) AND
# by the Local CMS's image upload endpoint (/api/local-cms/upload in
# astro.config.mjs — dev-only, never runs in production) to upload images
# straight to Sanity's asset store. Required for the Upload button on
# ImageUploadField to work; without it that button fails with a clear error.
# NOT used by scripts/sync-youtube.mjs --execute — that script writes
# straight to src/data/videos.json since the local-JSON pivot (epic #34).
SANITY_WRITE_TOKEN=

# Cloudflare Turnstile
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Running the e2e suites locally? Build with Cloudflare's ALWAYS-PASSES test
# keys instead of the production pair, exactly as CI does:
#
#   PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
#
# The test site key is valid on any domain, so it issues a token on
# localhost:4321 where the production key answers 600010 ("sitekey not valid
# for this domain"). The test secret then verifies whatever it is handed. This
# is what replaced the old `e2e-test-` email prefix, which skipped the bot
# check for anyone who used it. Never put a bypass in the code again.

# Resend API
RESEND_API_KEY=

# RANDOM WEBSUB
WEBSUB_SECRET=

# --- RapidAPI (for TikTok Scraper) ---
https://rapidapi.com/tikwm-tikwm-default/api/tiktok-scraper7/playground/apiendpoint_6fe68a56-45a9-4404-9086-be8e92f35d30
RAPIDAPI_KEY=

# --- Meta (Facebook) ---
# https://developers.facebook.com/tools/explorer/
META_ACCESS_TOKEN=
# --- Google Indexing API (scripts/notify-indexing-api.mjs) ---
# The ENTIRE service account JSON key file, pasted as one value.
# Google Cloud Console → IAM & Admin → Service Accounts → Keys → Add key
# (JSON). The same value goes in the GOOGLE_INDEXING_CREDENTIALS repo secret
# used by .github/workflows/sync-articles.yml.
# Absent = the notifier skips, loudly and non-fatally. See scripts/indexing-api.md.
GOOGLE_INDEXING_CREDENTIALS=
