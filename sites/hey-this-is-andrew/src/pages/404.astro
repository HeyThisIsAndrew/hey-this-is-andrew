---
import BaseLayout from '../layouts/BaseLayout.astro';
import { homeUrl } from '../data/nav';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase === '/' ? '' : rawBase.replace(/\/$/, '');
---
<BaseLayout title="Page not found · HEY_THISISANDREW" description="This page does not exist.">
  <section class="container not-found" aria-labelledby="nf-heading">
    <p class="nf-code font-mono">404</p>
    <h1 id="nf-heading" class="nf-title">Page not found</h1>
    <p class="nf-lede">This page does not exist, or it moved.</p>
    <p class="nf-links">
      <a class="btn btn-primary" href={homeUrl}>Home</a>
      <a class="btn btn-secondary" href={`${base}/sitemap/`}>Sitemap</a>
    </p>
  </section>
</BaseLayout>

<style>
  .not-found {
    min-height: 60vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .nf-code {
    margin: 0 0 1rem;
    font-size: 0.8rem;
    letter-spacing: 0.3em;
    color: var(--muted);
  }
  .nf-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: clamp(2.2rem, 6vw, 4.5rem);
    line-height: 1.02;
  }
  .nf-lede {
    margin: 1rem 0 2rem;
    color: var(--muted);
  }
  .nf-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin: 0;
  }
</style>
