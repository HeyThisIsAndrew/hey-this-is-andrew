---
import ArchiveLayout from '../layouts/ArchiveLayout.astro';
import GoalsChecklist from '../components/GoalsChecklist.astro';
import ViewAllLink from '@andrew/ui/ViewAllLink.astro';
import { getCollection } from 'astro:content';

const goals = (await getCollection('goals')).sort((a, b) => a.data.order - b.data.order);
const rawBase = import.meta.env.BASE_URL;
const base = rawBase === '/' ? '' : rawBase.replace(/\/$/, '');
---
<ArchiveLayout
  title="Goals · HEY_THISISANDREW"
  description="Andrew Baxter's public goals and milestones, checked off as they happen. Building in public."
  heading="Goals"
  kicker="Building in public"
  lede="Public milestones, checked off as they happen."
>
  <div class="container">
    <GoalsChecklist groups={goals} />
    <ViewAllLink href={`${base}/build/`} label="The full build roadmap" />
  </div>
</ArchiveLayout>
