---
/**
 * Hero concept D: B's statement hero, shortened so the brands heading and
 * the top of the accordion sit inside the first viewport (the way HQ keeps
 * its panels on screen). The wordmark and the one line appear once; the
 * line is new so it does not repeat the Meet the Creator headline. A
 * PREVIEW: noindex, excluded from the sitemap, linked from nowhere.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomeSections from '../../components/HomeSections.astro';
import Hero from '../../components/hero/HeroStatement.astro';
---
<BaseLayout title="Hero concept D (preview) · HEY_THISISANDREW" description="Hero concept preview: D: statement hero with the brands in the first screen." noindex>
  <h1 class="vh">HEY_THISISANDREW: Creator, Photographer, Coffee Drinker</h1>
  <HomeSections skipBrands={false} brandsTight>
    <Hero slot="hero" peek line="One founder. Three brands. Pick a lane." />
  </HomeSections>
</BaseLayout>
