---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '@andrew/ui/SectionHeader.astro';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase === '/' ? '' : rawBase.replace(/\/$/, '');

// The Core Engine milestones and Andrew's ACTUAL status for each. This is
// the only source of the tracker: the boxes are display-only (they were
// visitor checkboxes saved to the visitor's own browser, so anyone could
// "complete" Andrew's milestones). Update a status here to change the page.
type MilestoneStatus = 'done' | 'in-progress' | 'queued';
const MILESTONES: { id: string; title: string; desc: string; status: MilestoneStatus }[] = [
  { id: 'm1', title: 'System Automation', desc: 'Build self-hosted n8n infrastructure for automated social media distribution.', status: 'in-progress' },
  { id: 'm2', title: 'Creator Tech Authority', desc: 'Establish workflow and gear catalog bridging creator tools and production systems.', status: 'in-progress' },
  { id: 'm3', title: 'Revenue & Partnerships', desc: 'Scale direct UGC brand partnerships and affiliate pipelines.', status: 'in-progress' },
  { id: 'm4', title: 'Industry Access', desc: 'Secure accreditation and invitations to Sony Kando, Apple Keynote, and Meta Connect.', status: 'queued' },
];
const STATUS_LABEL: Record<MilestoneStatus, string> = { done: 'Done', 'in-progress': 'In Progress', queued: 'Queued' };
const doneCount = MILESTONES.filter((m) => m.status === 'done').length;
const donePercent = Math.round((doneCount / MILESTONES.length) * 100);
---

<BaseLayout
  title="Build in Public & Goals · HEY_THISISANDREW"
  description="Brand roadmap, interactive milestone checklists, and multi-stage sub-brand progression meters for Hey This Is Andrew, BE Unconventional HQ, and Capture Create Caffeinate."
>
  <div class="container build-page">
    <div class="build-header">
      <span class="mono-tag">Verified Milestones</span>
      <h1 class="build-title">Build in Public &amp; Goals</h1>
      <p class="build-lede">
        Brand roadmap, interactive milestone checklists, and multi-stage sub-brand progression meters for Hey This Is Andrew, BE Unconventional HQ, and Capture Create Caffeinate.
      </p>
    </div>

    <!-- 1. Primary Focus: HEY_THISISANDREW (Interactive Checklist) -->
    <section id="brand-roadmap-dashboard" aria-label="Brand Roadmap & Objectives" class="roadmap-section">
      <SectionHeader
        id="core-engine-heading"
        index="01"
        kicker="Primary Milestones · HEY_THISISANDREW"
        title="Core Engine"
        lede="Active targets across infrastructure, authority, revenue, and industry access."
      />

      <div class="milestones-progress-wrap">
        <div class="milestones-progress-header">
          <span class="milestones-progress-label font-mono">Verified Execution Tracker</span>
          <span class="milestones-progress-stat font-mono">{doneCount} of {MILESTONES.length} Completed ({donePercent}%)</span>
        </div>
        <div class="milestones-progress-bar-bg" role="progressbar" aria-valuenow={doneCount} aria-valuemin="0" aria-valuemax={MILESTONES.length} aria-label="Milestones completed">
          <div class="milestones-progress-fill" style={`width: ${donePercent}%;`}></div>
        </div>
      </div>

      <ul class="checklist-container">
        {MILESTONES.map((m) => (
          <li class:list={['checklist-card', { completed: m.status === 'done' }]} data-milestone-card={m.id}>
            <div class="checklist-left">
              <span class:list={['checklist-mark', { 'is-done': m.status === 'done' }]} aria-hidden="true">
                {m.status === 'done' && (
                  <svg viewBox="0 0 16 16" width="12" height="12" fill="none"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="2" stroke-linecap="square" /></svg>
                )}
              </span>
              <div class="checklist-info">
                <h3 class="checklist-title">{m.title}</h3>
                <p class="checklist-desc">{m.desc}</p>
              </div>
            </div>
            <div class:list={['status-badge', m.status === 'done' ? 'achieved' : m.status]}>
              {m.status === 'in-progress' && <span class="pulse-indicator"></span>}
              <span class="badge-text">{STATUS_LABEL[m.status]}</span>
            </div>
          </li>
        ))}
      </ul>

      <!-- 2. Sub-Brand Roadmap: BE Unconventional HQ -->
      <div class="sub-brand-block">
        <SectionHeader
          id="be-heading"
          index="02"
          kicker="BE Unconventional HQ"
          title="Sub-Brand Roadmap: Entertainment Outlet"
          lede="Objective: Scale into a credentialed entertainment outlet covering film, TV, gaming, and pop culture."
        />

        <div class="brand-progression-card">
          <div class="brand-progression-head">
            <h3 class="brand-progression-title">BE Unconventional HQ</h3>
            <p class="brand-objective">
              <strong>Objective:</strong> Scale into a credentialed entertainment outlet covering film, TV, gaming, and pop culture.
            </p>
          </div>

          <div class="progression-rail-wrapper">
            <div class="progression-stages-grid">
              <div class="progression-stage-item">
                <div class="stage-bar achieved"></div>
                <div class="stage-meta">
                  <span class="stage-num font-mono">Stage 01</span>
                  <span class="stage-badge achieved">Achieved</span>
                </div>
                <h4 class="stage-name">Foundation</h4>
                <p class="stage-detail">Independent editorial calendar and breaking coverage system.</p>
              </div>

              <div class="progression-stage-item">
                <div class="stage-bar active"></div>
                <div class="stage-meta">
                  <span class="stage-num font-mono">Stage 02</span>
                  <span class="stage-badge active">Active Target</span>
                </div>
                <h4 class="stage-name">On-Site Access</h4>
                <p class="stage-detail">Major event press credentials and live floor coverage.</p>
              </div>

              <div class="progression-stage-item">
                <div class="stage-bar upcoming"></div>
                <div class="stage-meta">
                  <span class="stage-num font-mono">Stage 03</span>
                  <span class="stage-badge upcoming">Upcoming</span>
                </div>
                <h4 class="stage-name">Commercial Integration</h4>
                <p class="stage-detail">Paid event photography and marketing partnerships.</p>
              </div>

              <div class="progression-stage-item">
                <div class="stage-bar target"></div>
                <div class="stage-meta">
                  <span class="stage-num font-mono">Stage 04</span>
                  <span class="stage-badge target">Target</span>
                </div>
                <h4 class="stage-name">Industry Milestone</h4>
                <p class="stage-detail">Critics Choice Association (CCA) accreditation.</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- 3. Sub-Brand Roadmap: Capture Create Caffeinate -->
      <div class="sub-brand-block">
        <SectionHeader
          id="ccc-heading"
          index="03"
          kicker="Capture Create Caffeinate"
          title="Sub-Brand Roadmap: Commercial Beverage"
          lede="Objective: Commercial beverage, coffee, and cocktail photography paired with native 9:16 video production."
        />

        <div class="brand-progression-card">
          <div class="brand-progression-head">
            <h3 class="brand-progression-title">Capture Create Caffeinate</h3>
            <p class="brand-objective">
              <strong>Objective:</strong> Commercial beverage, coffee, and cocktail photography and 9:16 video production.
            </p>
          </div>

          <div class="progression-rail-wrapper">
            <div class="progression-stages-grid">
              <div class="progression-stage-item">
                <div class="stage-bar achieved"></div>
                <div class="stage-meta">
                  <span class="stage-num font-mono">Stage 01</span>
                  <span class="stage-badge achieved">Achieved</span>
                </div>
                <h4 class="stage-name">System Setup</h4>
                <p class="stage-detail">Native 9:16 capture pipeline and portfolio build.</p>
              </div>

              <div class="progression-stage-item">
                <div class="stage-bar active"></div>
                <div class="stage-meta">
                  <span class="stage-num font-mono">Stage 02</span>
                  <span class="stage-badge active">Active Target</span>
                </div>
                <h4 class="stage-name">Local Penetration</h4>
                <p class="stage-detail">San Diego roasters and cocktail lounge retainers.</p>
              </div>

              <div class="progression-stage-item">
                <div class="stage-bar upcoming"></div>
                <div class="stage-meta">
                  <span class="stage-num font-mono">Stage 03</span>
                  <span class="stage-badge upcoming">Upcoming</span>
                </div>
                <h4 class="stage-name">Digital Products</h4>
                <p class="stage-detail">Lightroom drink presets and lighting recipe guides.</p>
              </div>

              <div class="progression-stage-item">
                <div class="stage-bar target"></div>
                <div class="stage-meta">
                  <span class="stage-num font-mono">Stage 04</span>
                  <span class="stage-badge target">Target</span>
                </div>
                <h4 class="stage-name">National Campaigns</h4>
                <p class="stage-detail">Commercial beverage brand contracts and licensing.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>


<style>
  .build-page {
    padding-top: clamp(2rem, 4vw, 4rem);
    padding-bottom: clamp(4rem, 8vw, 7rem);
  }
  .build-header {
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }
  .mono-tag {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border);
    padding: 0.3rem 0.65rem;
    display: inline-block;
    margin-bottom: 0.75rem;
  }
  .build-title {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    color: var(--ink);
    margin: 0 0 0.75rem;
    line-height: 1.05;
  }
  .build-lede {
    font-size: 1.05rem;
    color: var(--muted);
    max-width: 65ch;
    line-height: 1.7;
    margin: 0;
  }
  .roadmap-section {
    padding-top: 1rem;
  }
  .milestones-progress-wrap {
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 1rem 1.5rem;
    margin-bottom: 1.5rem;
  }
  .milestones-progress-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.65rem;
    gap: 1rem;
  }
  .milestones-progress-label {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .milestones-progress-stat {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: #f5f5f5;
  }
  .milestones-progress-bar-bg {
    width: 100%;
    height: 4px;
    background: rgba(255, 255, 255, 0.1);
    position: relative;
    overflow: hidden;
  }
  .milestones-progress-fill {
    height: 100%;
    background: #f5f5f5;
    box-shadow: 0 0 8px rgba(255, 255, 255, 0.5);
    transition: width 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .checklist-container {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin: 0 0 3.5rem;
    padding: 0;
    list-style: none;
  }
  .checklist-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.25rem 1.5rem;
    background: var(--surface);
    border: 1px solid var(--border);
    transition: border-color 0.25s ease, background-color 0.25s ease;
  }
  .checklist-card.completed {
    border-color: rgba(255, 255, 255, 0.4);
    background: rgba(255, 255, 255, 0.03);
  }
  .checklist-card.completed .checklist-title {
    color: rgba(255, 255, 255, 0.85);
  }
  .checklist-left {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    flex: 1 1 auto;
  }
  /* Display-only status mark (not a control). */
  .checklist-mark {
    display: inline-grid;
    place-items: center;
    margin-top: 0.2rem;
    width: 1.2rem;
    height: 1.2rem;
    flex-shrink: 0;
    border: 1px solid rgba(255, 255, 255, 0.35);
    color: #080808;
  }
  .checklist-mark.is-done {
    background: var(--ink);
    border-color: var(--ink);
  }
  .checklist-title {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--ink);
    margin: 0;
  }
  .checklist-desc {
    font-size: 0.92rem;
    color: var(--muted);
    margin: 0.35rem 0 0;
    line-height: 1.5;
  }
  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    border: 1px solid var(--border);
    white-space: nowrap;
  }
  .status-badge.in-progress {
    color: #bdbdbd;
    border-color: rgba(189, 189, 189, 0.35);
    background: rgba(189, 189, 189, 0.08);
  }
  .status-badge.queued {
    color: var(--muted);
    background: rgba(255, 255, 255, 0.03);
  }
  .status-badge.achieved {
    color: #f5f5f5;
    border-color: rgba(255, 255, 255, 0.35);
    background: rgba(255, 255, 255, 0.08);
  }
  .pulse-indicator {
    width: 6px;
    height: 6px;
    background: #bdbdbd;
    border-radius: 50%;
    box-shadow: 0 0 8px #bdbdbd;
  }
  .sub-brand-block {
    margin-top: 3.5rem;
  }
  .brand-progression-card {
    background: var(--surface);
    border: 1px solid var(--border);
    padding: clamp(1.5rem, 3vw, 2.5rem);
    margin-top: 1.5rem;
  }
  .brand-progression-head {
    margin-bottom: 2rem;
  }
  .brand-progression-title {
    font-family: var(--font-display);
    font-weight: 800;
    /* 4.2vw: "UNCONVENTIONAL" fits its card on a 375px phone. */
    font-size: clamp(0.95rem, 4.2vw, 1.25rem);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ink);
    margin: 0 0 0.5rem;
  }
  .brand-objective {
    font-size: 0.95rem;
    color: var(--muted);
    margin: 0;
    line-height: 1.6;
  }
  .brand-objective strong {
    color: var(--ink);
  }
  .progression-stages-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
  }
  @media (max-width: 900px) {
    .progression-stages-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }
  }
  @media (max-width: 540px) {
    .progression-stages-grid {
      grid-template-columns: 1fr;
    }
    .checklist-card {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
  }
  .progression-stage-item {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }
  .stage-bar {
    height: 4px;
    width: 100%;
    background: rgba(255, 255, 255, 0.1);
  }
  .stage-bar.achieved {
    background: #f5f5f5;
    box-shadow: 0 0 8px rgba(255, 255, 255, 0.4);
  }
  .stage-bar.active {
    background: #bdbdbd;
    box-shadow: 0 0 8px rgba(189, 189, 189, 0.4);
  }
  .stage-bar.upcoming {
    background: rgba(255, 255, 255, 0.25);
  }
  .stage-bar.target {
    background: rgba(255, 255, 255, 0.15);
  }
  .stage-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .stage-num {
    font-size: 0.72rem;
    color: var(--muted);
    letter-spacing: 0.1em;
  }
  .stage-badge {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--border);
  }
  .stage-badge.achieved {
    color: #f5f5f5;
    border-color: rgba(255, 255, 255, 0.35);
  }
  .stage-badge.active {
    color: #bdbdbd;
    border-color: rgba(189, 189, 189, 0.35);
  }
  .stage-badge.upcoming,
  .stage-badge.target {
    color: var(--muted);
  }
  .stage-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--ink);
    margin: 0;
  }
  .stage-detail {
    font-size: 0.85rem;
    color: var(--muted);
    line-height: 1.5;
    margin: 0;
  }
  /* This page's section titles carry long words ("ENTERTAINMENT" needs
     16em at the site's tracked display face), so on phones they set
     smaller than the site default to stay on screen. */
  @media (max-width: 560px) {
    .build-page :global(.section-title) {
      font-size: 5.4vw;
    }
  }
</style>
