---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '@andrew/ui/SectionHeader.astro';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase === '/' ? '' : rawBase.replace(/\/$/, '');
---

<BaseLayout
  title="Build in Public & Goals · HEY_THISISANDREW"
  description="Brand roadmap, interactive milestone checklists, and multi-stage sub-brand progression meters for Hey This Is Andrew, BE Unconventional HQ, and Capture Create Caffeinate."
>
  <div class="container build-page">
    <div class="build-header">
      <span class="mono-tag">Verified Milestones</span>
      <h1 class="build-title">Build in Public &amp; Goals</h1>
      <p class="build-lede">
        Brand roadmap, interactive milestone checklists, and multi-stage sub-brand progression meters for Hey This Is Andrew, BE Unconventional HQ, and Capture Create Caffeinate.
      </p>
    </div>

    <!-- 1. Primary Focus: HEY_THISISANDREW (Interactive Checklist) -->
    <section id="brand-roadmap-dashboard" aria-label="Brand Roadmap & Objectives" class="roadmap-section">
      <SectionHeader
        id="core-engine-heading"
        index="01"
        kicker="Primary Milestones · HEY_THISISANDREW"
        title="Core Engine"
        lede="Active targets across infrastructure, authority, revenue, and industry access."
      />

      <div class="milestones-progress-wrap" aria-live="polite">
        <div class="milestones-progress-header">
          <span class="milestones-progress-label font-mono">Verified Execution Tracker</span>
          <span class="milestones-progress-stat font-mono" id="milestones-stat">0 of 4 Completed (0%)</span>
        </div>
        <div class="milestones-progress-bar-bg" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="4" aria-label="Milestone completion progress">
          <div class="milestones-progress-fill" id="milestones-fill" style="width: 0%;"></div>
        </div>
      </div>

      <div class="checklist-container">
        <!-- Milestone 1 -->
        <div class="checklist-card" data-milestone-card="m1">
          <div class="checklist-left">
            <input type="checkbox" id="m1" class="checklist-checkbox" aria-label="Toggle System Automation milestone" />
            <div class="checklist-info">
              <label for="m1" class="checklist-title">System Automation</label>
              <p class="checklist-desc">Build self-hosted n8n infrastructure for automated social media distribution.</p>
            </div>
          </div>
          <div class="status-badge in-progress" data-status-badge="m1" data-default-text="In Progress" data-default-class="in-progress">
            <span class="pulse-indicator"></span>
            <span class="badge-text">In Progress</span>
          </div>
        </div>

        <!-- Milestone 2 -->
        <div class="checklist-card" data-milestone-card="m2">
          <div class="checklist-left">
            <input type="checkbox" id="m2" class="checklist-checkbox" aria-label="Toggle Creator Tech Authority milestone" />
            <div class="checklist-info">
              <label for="m2" class="checklist-title">Creator Tech Authority</label>
              <p class="checklist-desc">Establish workflow and gear catalog bridging creator tools and production systems.</p>
            </div>
          </div>
          <div class="status-badge in-progress" data-status-badge="m2" data-default-text="In Progress" data-default-class="in-progress">
            <span class="pulse-indicator"></span>
            <span class="badge-text">In Progress</span>
          </div>
        </div>

        <!-- Milestone 3 -->
        <div class="checklist-card" data-milestone-card="m3">
          <div class="checklist-left">
            <input type="checkbox" id="m3" class="checklist-checkbox" aria-label="Toggle Revenue & Partnerships milestone" />
            <div class="checklist-info">
              <label for="m3" class="checklist-title">Revenue &amp; Partnerships</label>
              <p class="checklist-desc">Scale direct UGC brand partnerships and affiliate pipelines.</p>
            </div>
          </div>
          <div class="status-badge in-progress" data-status-badge="m3" data-default-text="In Progress" data-default-class="in-progress">
            <span class="pulse-indicator"></span>
            <span class="badge-text">In Progress</span>
          </div>
        </div>

        <!-- Milestone 4 -->
        <div class="checklist-card" data-milestone-card="m4">
          <div class="checklist-left">
            <input type="checkbox" id="m4" class="checklist-checkbox" aria-label="Toggle Industry Access milestone" />
            <div class="checklist-info">
              <label for="m4" class="checklist-title">Industry Access</label>
              <p class="checklist-desc">Secure accreditation and invitations to Sony Kando, Apple Keynote, and Meta Connect.</p>
            </div>
          </div>
          <div class="status-badge queued" data-status-badge="m4" data-default-text="Queued" data-default-class="queued">
            <span class="badge-text">Queued</span>
          </div>
        </div>
      </div>

      <!-- 2. Sub-Brand Roadmap: BE Unconventional HQ -->
      <div class="sub-brand-block">
        <SectionHeader
          id="be-heading"
          index="02"
          kicker="BE Unconventional HQ"
          title="Sub-Brand Roadmap: Entertainment Outlet"
          lede="Objective: Scale into a credentialed entertainment outlet covering film, TV, gaming, and pop culture."
        />

        <div class="brand-progression-card">
          <div class="brand-progression-head">
            <h3 class="brand-progression-title">BE Unconventional HQ</h3>
            <p class="brand-objective">
              <strong>Objective:</strong> Scale into a credentialed entertainment outlet covering film, TV, gaming, and pop culture.
            </p>
          </div>

          <div class="progression-rail-wrapper">
            <div class="progression-stages-grid">
              <div class="progression-stage-item">
                <div class="stage-bar achieved"></div>
                <div class="stage-meta">
                  <span class="stage-num font-mono">Stage 01</span>
                  <span class="stage-badge achieved">Achieved</span>
                </div>
                <h4 class="stage-name">Foundation</h4>
                <p class="stage-detail">Independent editorial calendar and breaking coverage system.</p>
              </div>

              <div class="progression-stage-item">
                <div class="stage-bar active"></div>
                <div class="stage-meta">
                  <span class="stage-num font-mono">Stage 02</span>
                  <span class="stage-badge active">Active Target</span>
                </div>
                <h4 class="stage-name">On-Site Access</h4>
                <p class="stage-detail">Major event press credentials and live floor coverage.</p>
              </div>

              <div class="progression-stage-item">
                <div class="stage-bar upcoming"></div>
                <div class="stage-meta">
                  <span class="stage-num font-mono">Stage 03</span>
                  <span class="stage-badge upcoming">Upcoming</span>
                </div>
                <h4 class="stage-name">Commercial Integration</h4>
                <p class="stage-detail">Paid event photography and marketing partnerships.</p>
              </div>

              <div class="progression-stage-item">
                <div class="stage-bar target"></div>
                <div class="stage-meta">
                  <span class="stage-num font-mono">Stage 04</span>
                  <span class="stage-badge target">Target</span>
                </div>
                <h4 class="stage-name">Industry Milestone</h4>
                <p class="stage-detail">Critics Choice Association (CCA) accreditation.</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- 3. Sub-Brand Roadmap: Capture Create Caffeinate -->
      <div class="sub-brand-block">
        <SectionHeader
          id="ccc-heading"
          index="03"
          kicker="Capture Create Caffeinate"
          title="Sub-Brand Roadmap: Commercial Beverage"
          lede="Objective: Commercial beverage, coffee, and cocktail photography paired with native 9:16 video production."
        />

        <div class="brand-progression-card">
          <div class="brand-progression-head">
            <h3 class="brand-progression-title">Capture Create Caffeinate</h3>
            <p class="brand-objective">
              <strong>Objective:</strong> Commercial beverage, coffee, and cocktail photography and 9:16 video production.
            </p>
          </div>

          <div class="progression-rail-wrapper">
            <div class="progression-stages-grid">
              <div class="progression-stage-item">
                <div class="stage-bar achieved"></div>
                <div class="stage-meta">
                  <span class="stage-num font-mono">Stage 01</span>
                  <span class="stage-badge achieved">Achieved</span>
                </div>
                <h4 class="stage-name">System Setup</h4>
                <p class="stage-detail">Native 9:16 capture pipeline and portfolio build.</p>
              </div>

              <div class="progression-stage-item">
                <div class="stage-bar active"></div>
                <div class="stage-meta">
                  <span class="stage-num font-mono">Stage 02</span>
                  <span class="stage-badge active">Active Target</span>
                </div>
                <h4 class="stage-name">Local Penetration</h4>
                <p class="stage-detail">San Diego roasters and cocktail lounge retainers.</p>
              </div>

              <div class="progression-stage-item">
                <div class="stage-bar upcoming"></div>
                <div class="stage-meta">
                  <span class="stage-num font-mono">Stage 03</span>
                  <span class="stage-badge upcoming">Upcoming</span>
                </div>
                <h4 class="stage-name">Digital Products</h4>
                <p class="stage-detail">Lightroom drink presets and lighting recipe guides.</p>
              </div>

              <div class="progression-stage-item">
                <div class="stage-bar target"></div>
                <div class="stage-meta">
                  <span class="stage-num font-mono">Stage 04</span>
                  <span class="stage-badge target">Target</span>
                </div>
                <h4 class="stage-name">National Campaigns</h4>
                <p class="stage-detail">Commercial beverage brand contracts and licensing.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  // Milestone state persistence & execution tracking
  const STORAGE_KEY = 'hey_andrew_milestones_state_v1';

  function initMilestones() {
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.checklist-card'));
    const statEl = document.getElementById('milestones-stat');
    const fillEl = document.getElementById('milestones-fill');
    if (!cards.length) return;

    let savedState: Record<string, boolean> = {};
    try {
      const stored = localStorage.getItem(STORAGE_KEY);
      if (stored) {
        savedState = JSON.parse(stored);
      }
    } catch {
      savedState = {};
    }

    function updateTracker() {
      let completedCount = 0;
      cards.forEach((card) => {
        const checkbox = card.querySelector<HTMLInputElement>('.checklist-checkbox');
        if (checkbox && checkbox.checked) {
          completedCount++;
        }
      });

      const total = cards.length;
      const percent = Math.round((completedCount / total) * 100);
      if (statEl) {
        statEl.textContent = `${completedCount} of ${total} Completed (${percent}%)`;
      }
      if (fillEl) {
        fillEl.style.width = `${percent}%`;
        fillEl.setAttribute('aria-valuenow', String(completedCount));
      }
    }

    function applyCardState(card: HTMLElement, checked: boolean) {
      const badge = card.querySelector<HTMLElement>('.status-badge');
      const badgeText = card.querySelector<HTMLElement>('.badge-text');
      const pulse = card.querySelector<HTMLElement>('.pulse-indicator');

      if (checked) {
        card.classList.add('completed');
        if (badge) {
          badge.className = 'status-badge achieved';
        }
        if (badgeText) {
          badgeText.textContent = 'Verified / Done';
        }
        if (pulse) {
          pulse.style.display = 'none';
        }
      } else {
        card.classList.remove('completed');
        const defaultClass = badge?.dataset.defaultClass || 'in-progress';
        const defaultText = badge?.dataset.defaultText || 'In Progress';
        if (badge) {
          badge.className = `status-badge ${defaultClass}`;
        }
        if (badgeText) {
          badgeText.textContent = defaultText;
        }
        if (pulse && defaultClass === 'in-progress') {
          pulse.style.display = '';
        }
      }
    }

    cards.forEach((card) => {
      const checkbox = card.querySelector<HTMLInputElement>('.checklist-checkbox');
      if (!checkbox) return;
      const id = checkbox.id;

      // Check both new store and legacy goal_m* key
      const isSaved = savedState[id] !== undefined 
        ? savedState[id] 
        : localStorage.getItem('goal_' + id) === 'true';

      if (isSaved) {
        checkbox.checked = true;
        applyCardState(card, true);
      } else {
        applyCardState(card, false);
      }

      const save = () => {
        savedState[id] = checkbox.checked;
        try {
          localStorage.setItem(STORAGE_KEY, JSON.stringify(savedState));
          localStorage.setItem('goal_' + id, String(checkbox.checked));
        } catch {
          // ignore localStorage quota errors
        }
        applyCardState(card, checkbox.checked);
        updateTracker();
      };

      checkbox.addEventListener('change', save);

      // Card-level click toggles checkbox if not clicking label/link directly
      card.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (target === checkbox || target.closest('label, a')) return;
        checkbox.checked = !checkbox.checked;
        save();
      });
    });

    updateTracker();
  }

  // Support initial load and Astro view transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMilestones);
  } else {
    initMilestones();
  }
  document.addEventListener('astro:page-load', initMilestones);
</script>

<style>
  .build-page {
    padding-top: clamp(2rem, 4vw, 4rem);
    padding-bottom: clamp(4rem, 8vw, 7rem);
  }
  .build-header {
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }
  .mono-tag {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border);
    padding: 0.3rem 0.65rem;
    display: inline-block;
    margin-bottom: 0.75rem;
  }
  .build-title {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    color: var(--ink);
    margin: 0 0 0.75rem;
    line-height: 1.05;
  }
  .build-lede {
    font-size: 1.05rem;
    color: var(--muted);
    max-width: 65ch;
    line-height: 1.7;
    margin: 0;
  }
  .roadmap-section {
    padding-top: 1rem;
  }
  .milestones-progress-wrap {
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 1rem 1.5rem;
    margin-bottom: 1.5rem;
  }
  .milestones-progress-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.65rem;
    gap: 1rem;
  }
  .milestones-progress-label {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .milestones-progress-stat {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: #f5f5f5;
  }
  .milestones-progress-bar-bg {
    width: 100%;
    height: 4px;
    background: rgba(255, 255, 255, 0.1);
    position: relative;
    overflow: hidden;
  }
  .milestones-progress-fill {
    height: 100%;
    background: #f5f5f5;
    box-shadow: 0 0 8px rgba(255, 255, 255, 0.5);
    transition: width 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .checklist-container {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 3.5rem;
  }
  .checklist-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.25rem 1.5rem;
    background: var(--surface);
    border: 1px solid var(--border);
    cursor: pointer;
    transition: border-color 0.25s ease, background-color 0.25s ease;
  }
  .checklist-card:hover {
    border-color: rgba(255, 255, 255, 0.35);
    background: var(--surface-2);
  }
  .checklist-card.completed {
    border-color: rgba(255, 255, 255, 0.4);
    background: rgba(255, 255, 255, 0.03);
  }
  .checklist-card.completed .checklist-title {
    color: rgba(255, 255, 255, 0.85);
  }
  .checklist-left {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    flex: 1 1 auto;
  }
  .checklist-checkbox {
    margin-top: 0.25rem;
    width: 1.2rem;
    height: 1.2rem;
    accent-color: var(--ink);
    cursor: pointer;
    flex-shrink: 0;
  }
  .checklist-title {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--ink);
    cursor: pointer;
  }
  .checklist-desc {
    font-size: 0.92rem;
    color: var(--muted);
    margin: 0.35rem 0 0;
    line-height: 1.5;
  }
  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    border: 1px solid var(--border);
    white-space: nowrap;
  }
  .status-badge.in-progress {
    color: #bdbdbd;
    border-color: rgba(189, 189, 189, 0.35);
    background: rgba(189, 189, 189, 0.08);
  }
  .status-badge.queued {
    color: var(--muted);
    background: rgba(255, 255, 255, 0.03);
  }
  .status-badge.achieved {
    color: #f5f5f5;
    border-color: rgba(255, 255, 255, 0.35);
    background: rgba(255, 255, 255, 0.08);
  }
  .pulse-indicator {
    width: 6px;
    height: 6px;
    background: #bdbdbd;
    border-radius: 50%;
    box-shadow: 0 0 8px #bdbdbd;
  }
  .sub-brand-block {
    margin-top: 3.5rem;
  }
  .brand-progression-card {
    background: var(--surface);
    border: 1px solid var(--border);
    padding: clamp(1.5rem, 3vw, 2.5rem);
    margin-top: 1.5rem;
  }
  .brand-progression-head {
    margin-bottom: 2rem;
  }
  .brand-progression-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.25rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ink);
    margin: 0 0 0.5rem;
  }
  .brand-objective {
    font-size: 0.95rem;
    color: var(--muted);
    margin: 0;
    line-height: 1.6;
  }
  .brand-objective strong {
    color: var(--ink);
  }
  .progression-stages-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
  }
  @media (max-width: 900px) {
    .progression-stages-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }
  }
  @media (max-width: 540px) {
    .progression-stages-grid {
      grid-template-columns: 1fr;
    }
    .checklist-card {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
  }
  .progression-stage-item {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }
  .stage-bar {
    height: 4px;
    width: 100%;
    background: rgba(255, 255, 255, 0.1);
  }
  .stage-bar.achieved {
    background: #f5f5f5;
    box-shadow: 0 0 8px rgba(255, 255, 255, 0.4);
  }
  .stage-bar.active {
    background: #bdbdbd;
    box-shadow: 0 0 8px rgba(189, 189, 189, 0.4);
  }
  .stage-bar.upcoming {
    background: rgba(255, 255, 255, 0.25);
  }
  .stage-bar.target {
    background: rgba(255, 255, 255, 0.15);
  }
  .stage-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .stage-num {
    font-size: 0.72rem;
    color: var(--muted);
    letter-spacing: 0.1em;
  }
  .stage-badge {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--border);
  }
  .stage-badge.achieved {
    color: #f5f5f5;
    border-color: rgba(255, 255, 255, 0.35);
  }
  .stage-badge.active {
    color: #bdbdbd;
    border-color: rgba(189, 189, 189, 0.35);
  }
  .stage-badge.upcoming,
  .stage-badge.target {
    color: var(--muted);
  }
  .stage-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--ink);
    margin: 0;
  }
  .stage-detail {
    font-size: 0.85rem;
    color: var(--muted);
    line-height: 1.5;
    margin: 0;
  }
</style>
