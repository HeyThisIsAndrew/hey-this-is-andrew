---
const rawBase = import.meta.env.BASE_URL;
const base = rawBase === '/' ? '' : rawBase.replace(/\/$/, '');
const writingBase = `${base}/writing/`;
const target = `${writingBase}#goals`;
const canonicalTarget = Astro.site ? new URL(target, Astro.site).href : target;
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <title>Redirecting to Build in Public</title>
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <link rel="canonical" href={canonicalTarget} />
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <script is:inline define:vars={{ writingBase, defaultTarget: target }}>
      const hash = window.location.hash;
      window.location.replace(hash ? `${writingBase}${hash}` : defaultTarget);
    </script>
    <p>Redirecting to <a href={target}>Build in Public</a>.</p>
  </body>
</html>
