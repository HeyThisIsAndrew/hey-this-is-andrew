---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '@andrew/ui/SectionHeader.astro';
import FlipCard from '@andrew/ui/FlipCard.astro';
import { CLIENT_WORK, CLIENT_WORK_TIERS } from '../data/client-work';
import { CONTACT } from '../data/contact';
import { SERVICES, SERVICES_LEDE } from '../data/services';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase === '/' ? '' : rawBase.replace(/\/$/, '');

const depositText = '50% before build, 50% before launch.';
const shortIntakeNote = 'Fill out the form first.';

const SHARED_EXCLUSIONS = new Set([
  'Photography (separate service)',
  'Photography',
  'Shop or checkout',
  'Domain purchase',
]);

const STEP_TERMS = ['Send', 'Wording List', 'Approve', 'Build', 'Deliver'] as const;

function cleanRevisions(revisions: string): string {
  return revisions.replace(/,\s*extra\s+(?:round|page).*$/i, '.');
}

function cleanRetainer(retainer: string): string {
  const s = retainer.replace(/^\$900 per month\s*/i, '');
  return s.charAt(0).toUpperCase() + s.slice(1);
}

function filterIncluded(items: readonly string[], tierIndex: number): string[] {
  return items.filter((item) => {
    if (tierIndex <= 1) {
      if (item === 'Wording list sign-off before build') return false;
      if (/^Delivery with proof/i.test(item)) return false;
    }
    if (tierIndex === 1) {
      if (item === 'Cloudflare Pages launch') return false;
      if (item === 'Mobile and desktop, light and dark if the brand needs it') return false;
    }
    return true;
  });
}

function filterNotIncluded(items: readonly string[]): string[] {
  return items.filter((item) => !SHARED_EXCLUSIONS.has(item));
}

const cleanWordingChanges = CLIENT_WORK.wordingChanges
  .replace(/\s*Inside the included revision rounds,\s*no extra charge\./i, '')
  .replace(/\s*After the rounds are used,\s*\$75 per change round,\s*up to 5 lines\./i, '')
  .trim();
---

<BaseLayout title="Work With Me · HEY_THISISANDREW" description={CLIENT_WORK.paragraph} pane="Work With Me">
  <div class="container client-work">
    <h1 class="vh sr-only">Work With Me</h1>

    {/* Every service, above the website build tiers: the five from
        services.json, front and back copy as written there. */}
    <section id="services" class="client-work-services" aria-labelledby="services-heading" data-pn-top data-pn-label="What I do">
      <SectionHeader variant="chip" id="services-heading" title="What I do" lede={SERVICES_LEDE} />
      <p class="client-work-press">
        <a class="btn btn-secondary" href={`${base}/about/#press`}>Visit the press kit <span aria-hidden="true">&rarr;</span></a>
      </p>
      <ul class="client-work-service-list" role="list">
        {SERVICES.map((service, index) => (
          <li class="client-work-service-item">
            <FlipCard
              value={service.title}
              desc={service.frontDesc}
              backText={service.desc}
              idPrefix="service-flip"
              index={index}
            />
          </li>
        ))}
      </ul>
    </section>

    <section class="client-work-tiers" id="website-builds" aria-label="Website build tiers" data-pn-label="Website builds">
      {CLIENT_WORK_TIERS.map((tier, index) => (
        <article class="client-work-card" aria-labelledby={`tier-${index + 1}`}>
          <div class="tier-heading">
            <p class="tier-index font-mono">Tier {index + 1}</p>
            <h2 id={`tier-${index + 1}`}>{tier.name}</h2>
          </div>
          <dl class="tier-logistics">
            <div><dt>Timeline</dt><dd>{tier.timeline}</dd></div>
            <div><dt>Revisions</dt><dd>{cleanRevisions(tier.revisions)}</dd></div>
          </dl>
          <div class="tier-list">
            <h3>{'monthlyIncluded' in tier ? 'Included in the build' : 'Included'}</h3>
            <ul>{filterIncluded(tier.included, index).map((item) => <li>{item}</li>)}</ul>
          </div>
          {'monthlyIncluded' in tier && (
            <div class="tier-list">
              <h3>Monthly retainer</h3>
              <p>{cleanRetainer(tier.retainer)}</p>
              <ul>{tier.monthlyIncluded.map((item) => <li>{item}</li>)}</ul>
            </div>
          )}
          <div class="tier-list tier-exclusions">
            <h3>Not included</h3>
            <ul>{filterNotIncluded(tier.notIncluded).map((item) => <li>{item}</li>)}</ul>
          </div>
        </article>
      ))}
    </section>

    <section id="terms" class="client-work-terms-section" aria-label="Terms for all tiers">
      <div class="client-work-terms-notes">
        <p class="client-work-term-line"><span class="term-line-label">Deposit:</span> {depositText}</p>
        <p class="client-work-term-line"><span class="term-line-label">Not included in any tier:</span> Photography (separate service), Shop or checkout, Domain purchase.</p>
      </div>
      <div class="client-work-terms">
        <FlipCard
          value="Payment"
          backText={CLIENT_WORK.paymentMethods}
          idPrefix="term-payment"
          index={0}
        />
        <FlipCard
          value="Wording Changes"
          backText={cleanWordingChanges}
          idPrefix="term-wording"
          index={1}
        />
      </div>
    </section>

    <section id="how-it-works" class="client-work-process" aria-labelledby="process-heading">
      <SectionHeader variant="chip" id="process-heading" title="How it works" />
      <ul class="client-work-steps" role="list">
        {CLIENT_WORK.steps.map((step, index) => (
          <li class="client-work-step-item">
            <FlipCard
              value={STEP_TERMS[index]}
              backText={step}
              idPrefix="step-flip"
              index={index}
            />
          </li>
        ))}
      </ul>
    </section>

    <section id="get-started" class="client-work-start" aria-labelledby="start-heading">
      <SectionHeader variant="chip" id="start-heading" title="Get started" />
      <p class="client-work-lede">{CLIENT_WORK.paragraph}</p>
      <div class="btn-group client-work-actions">
        <a class="btn btn-secondary" href={CLIENT_WORK.intakeUrl} target="_blank" rel="noopener noreferrer">Sign up</a>
        <a class="btn btn-secondary" href={CLIENT_WORK.wordingListUrl} target="_blank" rel="noopener noreferrer">Wording list</a>
        <a class="btn btn-secondary client-work-email" href={`mailto:${CONTACT.personal}`}>Email</a>
      </div>
      <p class="client-work-intake-note">{shortIntakeNote}</p>
    </section>
  </div>
</BaseLayout>

<style>
  .client-work { --cw-section-pad: clamp(3rem, 5vw, 4.75rem); padding-block: clamp(2rem, 3.5vw, 3.5rem) 0; }
  .client-work-services { padding: 0 0 var(--cw-section-pad); margin-bottom: var(--cw-section-pad); border-bottom: 1px solid var(--line); }
  .client-work-press { margin: 0 0 2rem; }
  .client-work-service-list { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 1.25rem; list-style: none; margin: 0; padding: 0; align-items: stretch; --flip-value-size: clamp(0.85rem, 1.02vw, 1.2rem); }
  .client-work-service-item { display: flex; flex-direction: column; min-width: 0; }
  .client-work-service-list :global(.stat-card.flip-card) { min-height: 200px; }
  .client-work-tiers { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; padding: 0 0 var(--cw-section-pad); align-items: stretch; grid-auto-rows: 1fr; }
  .client-work-card { min-width: 0; padding: clamp(1.5rem, 2.4vw, 2.75rem); border: 1px solid var(--line); background: var(--surface); display: flex; flex-direction: column; }
  .tier-index { color: var(--muted); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.18em; margin: 0 0 1rem; }
  .tier-heading h2 { font-family: var(--font-display); font-size: clamp(1rem, 1.25vw, 1.65rem); font-weight: 800; line-height: 1.15; text-transform: uppercase; margin: 0; }
  @media (min-width: 1100px) {
    .tier-heading {
      min-height: 7.5rem;
    }
  }
  .tier-logistics { display: grid; gap: 1.25rem; padding-block: 1.75rem; margin: 1.75rem 0 0; border-top: 1px solid var(--line); }
  .client-work h3, .tier-logistics dt { margin: 0 0 0.5rem; font: 700 0.8rem / 1.5 var(--font-display); letter-spacing: 0.1em; text-transform: uppercase; }
  .tier-logistics dd { margin: 0; color: var(--muted); }
  .tier-list { border-top: 1px solid var(--line); padding-top: 1.5rem; margin-top: 1.5rem; }
  .tier-list ul { padding-left: 1.1rem; margin: 0; }
  .tier-list li + li { margin-top: 0.65rem; }
  .tier-list p { margin: 0 0 1rem; }
  .tier-exclusions { color: var(--muted); }
  .tier-exclusions h3 { color: var(--ink); }
  .client-work-terms-section { padding-block: var(--cw-section-pad); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .client-work-terms-notes { display: grid; gap: 0.65rem; padding: clamp(1rem, 2vw, 1.5rem) clamp(1.25rem, 2.5vw, 2rem); margin: 0 0 1.5rem; border: 1px solid var(--line); background: var(--surface); }
  .client-work-term-line { margin: 0; color: var(--muted); font-size: 0.95rem; line-height: 1.55; }
  .term-line-label { color: var(--ink); font: 700 0.78rem / 1.4 var(--font-display); letter-spacing: 0.1em; text-transform: uppercase; margin-right: 0.45rem; }
  .client-work-terms { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; padding: 0; margin: 0; border: 0; align-items: stretch; }
  .client-work-process, .client-work-start { padding-block: var(--cw-section-pad); }
  .client-work-steps { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 1.25rem; list-style: none; margin: 2rem 0 0; padding: 0; width: 100%; align-items: stretch; --flip-value-size: clamp(0.85rem, 1.02vw, 1.25rem); }
  .client-work-steps :global(.stat-value) {
    white-space: normal;
    overflow: visible;
    text-overflow: clip;
    text-wrap: balance;
    line-height: 1.25;
  }
  .client-work-step-item { display: flex; flex-direction: column; height: 100%; min-width: 0; }
  .client-work-start { border-top: 1px solid var(--line); }
  .client-work-lede { max-width: 72ch; margin: 0 0 1.75rem; color: var(--muted); font-size: clamp(1rem, 1.25vw, 1.15rem); line-height: 1.65; }
  .client-work-intake-note { max-width: 70ch; color: var(--muted); margin: 1.5rem 0 0; }
  .client-work-actions { width: 100%; grid-template-columns: repeat(3, minmax(0, 1fr)); align-items: stretch; }
  @media (max-width: 1099px) {
    .client-work-tiers { grid-template-columns: 1fr; }
    .client-work-steps { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .client-work-service-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 600px) and (max-width: 1099px) {
    .tier-heading h2 { font-size: 1.7rem; }
  }
  @media (max-width: 600px) {
    .client-work-terms { grid-template-columns: 1fr; gap: 1.25rem; }
    .client-work-steps { grid-template-columns: 1fr; gap: 1.25rem; }
    .client-work-service-list { grid-template-columns: 1fr; }
    .client-work-actions { grid-template-columns: minmax(0, 1fr); grid-auto-flow: row; }
  }
</style>
