---
/**
 * /gear: the full kit, from the `gear` content collection (src/data/gear.json).
 * This page used to hardcode its own, diverged copy of the kit; it now
 * renders the same collection-driven GearGrid the homepage used, so the kit
 * is edited in one place.
 */
import ArchiveLayout from '../layouts/ArchiveLayout.astro';
import GearGrid from '../components/GearGrid.astro';
import StorefrontCTA from '../components/StorefrontCTA.astro';
import { getCollection } from 'astro:content';

const gear = (await getCollection('gear')).sort((a, b) => a.data.order - b.data.order);
---
<ArchiveLayout
  title="Gear · HEY_THISISANDREW"
  description="The exact kit behind commercial shoots, beverage captures, and YouTube productions. Zero sponsored bloat: strictly equipment actively deployed in the studio."
  heading="Gear"
  kicker="Verified inventory"
  lede="The exact kit behind commercial shoots, beverage captures, and YouTube productions. Zero sponsored bloat: strictly equipment actively deployed in the studio."
  crumb="Gear"
>
  <section id="cafe" aria-hidden="true"></section>
  <section id="kit" aria-label="The kit">
    <div class="container">
      <h2 class="vh">The kit</h2>
      <GearGrid categories={gear} />
      <div id="storefront">
        <StorefrontCTA />
      </div>
    </div>
  </section>
</ArchiveLayout>
