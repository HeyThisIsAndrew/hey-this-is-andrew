---
/**
 * /gear: the full kit, its own page (every nav item is a page). The
 * homepage keeps a short Gear section (the storefront) that links here.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import GearGrid from '../components/GearGrid.astro';
import StorefrontCTA from '../components/StorefrontCTA.astro';
import SectionHeader from '@andrew/ui/SectionHeader.astro';
import { getCollection } from 'astro:content';
import path from 'node:path';
import { sampleAccent, NEUTRAL_ACCENT } from '../lib/gear-accent';

const gear = (await getCollection('gear')).sort((a, b) => a.data.order - b.data.order);

// Andrew's Amazon collection pages: one per shelf of the kit, each with a sharp studio lead photo.
const COLLECTIONS = [
  { label: 'Camera Gear', url: 'https://a.co/d/00WeFxoS', image: '/gear/sony-a7iv.jpg' },
  { label: 'Cafe Bar', url: 'https://a.co/d/0fSswpx1', image: '/gear/ascaso-steel-duo.jpg' },
  { label: 'Command Station Desk', url: 'https://a.co/d/070Rc6h9', image: '/gear/shure-mv6.jpg' },
];

const rawBase = import.meta.env.BASE_URL;
const siteBase = rawBase.endsWith('/') ? rawBase.slice(0, -1) : rawBase;
const collectionTiles = await Promise.all(
  COLLECTIONS.map(async (c) => {
    const accent = c.image ? await sampleAccent(path.join(process.cwd(), 'public', c.image)) : NEUTRAL_ACCENT;
    return { ...c, accent, imageSrc: `${siteBase}${c.image}` };
  })
);
---

<BaseLayout
  title="Gear · HEY_THISISANDREW"
  description="The kit behind the work: cameras, lenses, lighting, support, audio, the cafe bar, and gaming. Updated as it evolves."
  pane="Gear & Kit"
  topLabel="The Kit"
>
  <div class="gear-page">
    <div class="container">
      <header class="gear-header">
        <h1 class="vh">Gear</h1>
        <p class="gear-lede">Behind the work. Updated as it evolves.</p>
        <p class="gear-disclosure font-mono" data-affiliate-disclosure>
          As an Amazon Associate, I earn from qualifying purchases.
        </p>
      </header>
    </div>

    <h2 class="vh">Camera and studio kit</h2>
    <GearGrid categories={gear} />

    <div class="container">
      <section class="gear-collections" aria-labelledby="gear-collections-heading">
        <SectionHeader variant="chip" id="gear-collections-heading" title="Shop the lists" />
        <ul class="gear-collection-tiles" role="list">
          {collectionTiles.map((c) => (
            <li>
              <a
                class="gear-collection-tile"
                href={c.url}
                target="_blank"
                rel="noopener sponsored"
                style={`--accent: ${c.accent};`}
              >
                <span class="gear-collection-glow" aria-hidden="true"></span>
                <img class="gear-collection-img" src={c.imageSrc} alt="" loading="lazy" decoding="async" />
                <span class="gear-collection-scrim" aria-hidden="true"></span>
                <span class="gear-collection-name">{c.label}</span>
                <span class="gear-collection-arrow" aria-hidden="true">&#8599;</span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <div class="gear-shop">
        <StorefrontCTA label="Referrals and kit" eyebrow="Referrals & Kit" modalId="gear-referrals-modal" />
      </div>

      <!-- DISTINCT BOTTOM AFFILIATE DISCLOSURE BANNER -->
      <aside class="gear-bottom-disclosure" aria-label="Affiliate Disclosure" data-bottom-disclosure>
        <div class="disclosure-card font-mono">
          <p class="disclosure-text">
            As an Amazon Associate, I earn from qualifying purchases. When you purchase through links on this page, I may earn an affiliate commission at no extra cost to you. The Viltrox store link is an affiliate link as well. Unmarked items are the gear actually owned, tested, and utilized in commercial beverage production and content creation.
          </p>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .gear-page {
    width: 100%;
    padding-top: clamp(2rem, 4vw, 4rem);
    padding-bottom: clamp(4rem, 8vw, 7rem);
  }
  /* The header is the lede and the disclosure; the page title is the
     screen-reader h1 (the nav already says where you are). */
  .gear-header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.9rem;
    margin-bottom: clamp(2rem, 3vw, 3rem);
  }
  .mono-tag {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border);
    padding: 0.3rem 0.65rem;
    display: inline-block;
  }
  .gear-lede {
    font-size: 1.05rem;
    color: var(--muted);
    max-width: 65ch;
    line-height: 1.7;
    margin: 0;
  }
  .gear-disclosure {
    margin: 0.25rem 0 0;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .gear-collections {
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
  }
  .gear-collection-tiles {
    list-style: none;
    margin: clamp(1.5rem, 3vw, 2.25rem) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(0.75rem, 1.4vw, 1.25rem);
  }
  .gear-collection-tile {
    --hover-ease: cubic-bezier(0.25, 1, 0.5, 1);
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    aspect-ratio: 16 / 9;
    padding: clamp(1.1rem, 2vw, 1.75rem);
    box-sizing: border-box;
    background: #0d0d0d;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 0;
    color: #fff;
    text-decoration: none;
    transition:
      border-color 0.8s var(--hover-ease),
      box-shadow 0.8s var(--hover-ease);
  }
  .gear-collection-glow {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: radial-gradient(ellipse 65% 65% at 50% 42%, rgba(var(--accent), 0.24), transparent 72%);
    opacity: 0.85;
    transition: opacity 0.6s var(--hover-ease);
    pointer-events: none;
  }
  .gear-collection-img {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center 42%;
    padding: clamp(0.9rem, 1.8vw, 1.5rem) clamp(1.25rem, 2.5vw, 2rem) clamp(2.8rem, 4.5vw, 3.8rem);
    box-sizing: border-box;
    pointer-events: none;
    transition: transform 0.8s var(--hover-ease);
  }
  .gear-collection-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(180deg, rgba(13, 13, 13, 0) 35%, rgba(8, 8, 8, 0.88) 100%);
    pointer-events: none;
  }
  .gear-collection-name {
    position: relative;
    z-index: 2;
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 2.1vw, 1.9rem);
    font-weight: 800;
    line-height: 1.05;
    text-transform: uppercase;
    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.85);
  }
  .gear-collection-arrow {
    position: relative;
    z-index: 2;
    flex: 0 0 auto;
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid rgba(255, 255, 255, 0.35);
    background: rgba(10, 10, 10, 0.55);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    font-size: 1rem;
    transition: background 0.2s ease, color 0.2s ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .gear-collection-tile:hover {
      border-color: rgba(var(--accent), 0.7);
      box-shadow:
        0 22px 50px rgba(0, 0, 0, 0.6),
        0 0 34px rgba(var(--accent), 0.28);
    }
    .gear-collection-tile:hover .gear-collection-glow {
      opacity: 1;
    }
    .gear-collection-tile:hover .gear-collection-img {
      transform: scale(1.04);
    }
  }
  .gear-collection-tile:is(:hover, :focus-visible) .gear-collection-arrow {
    background: #fff;
    color: #000;
  }
  .gear-collection-tile:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }
  @media (max-width: 760px) {
    .gear-collection-tiles {
      grid-template-columns: 1fr;
    }
    .gear-collection-tile {
      aspect-ratio: auto;
      min-height: 8.5rem;
    }
    .gear-collection-img {
      object-position: right center;
      padding: 0.75rem 3.75rem 0.75rem 1rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .gear-collection-tile,
    .gear-collection-glow,
    .gear-collection-img {
      transition: none;
    }
  }
  .gear-shop {
    margin-top: clamp(2rem, 4vw, 3rem);
  }
  .gear-shop :global(.storefront) {
    margin-top: 0;
  }
  .gear-bottom-disclosure {
    margin-top: 2rem;
  }
  .disclosure-card {
    background: #0f0f0f;
    border: 1px solid var(--border);
    padding: 1.25rem 1.5rem;
  }
  .disclosure-text {
    font-size: 0.8rem;
    line-height: 1.6;
    color: #a0a0a0;
    margin: 0;
  }
</style>
