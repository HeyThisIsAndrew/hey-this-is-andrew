---
/**
 * /gear: the full kit, its own page (every nav item is a page). The
 * homepage keeps a short Gear section (the storefront) that links here.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import GearGrid from '../components/GearGrid.astro';
import StorefrontCTA from '../components/StorefrontCTA.astro';
import { getCollection } from 'astro:content';
import { PROJECT_INQUIRY_HREF } from '../data/services';

const gear = (await getCollection('gear')).sort((a, b) => a.data.order - b.data.order);

// Andrew's Amazon collection pages: one per shelf of the kit.
const COLLECTIONS = [
  { label: 'Camera Gear', url: 'https://a.co/d/00WeFxoS' },
  { label: 'Cafe Bar', url: 'https://a.co/d/0fSswpx1' },
  { label: 'Command Station Desk', url: 'https://a.co/d/070Rc6h9' },
];
---

<BaseLayout
  title="Gear · HEY_THISISANDREW"
  description="The kit behind the work: cameras, lenses, lighting, support, audio, the cafe bar, and gaming. Updated as it evolves."
>
  <div class="container gear-page">
    <header class="gear-header">
      <span class="mono-tag">The kit</span>
      <h1 class="gear-title">Gear</h1>
      <p class="gear-lede">Behind the work. Updated as it evolves.</p>
      <p class="gear-disclosure font-mono" data-affiliate-disclosure>
        As an Amazon Associate, I earn from qualifying purchases.
      </p>
    </header>

    <h2 class="vh">Camera and studio kit</h2>
    <GearGrid categories={gear} />

    <nav class="gear-collections" aria-label="Amazon collections">
      <span class="gear-collections-label font-mono">Shop the lists</span>
      {COLLECTIONS.map((c) => (
        <a class="gear-collection-link font-mono" href={c.url} target="_blank" rel="noopener sponsored">
          {c.label}
          <span aria-hidden="true">&#8599;</span>
        </a>
      ))}
    </nav>

    <div class="gear-shop">
      <StorefrontCTA />
    </div>

    <!-- DISTINCT BOTTOM AFFILIATE DISCLOSURE BANNER -->
    <aside class="gear-bottom-disclosure" aria-label="Affiliate Disclosure" data-bottom-disclosure>
      <div class="disclosure-card font-mono">
        <span class="disclosure-badge">AFFILIATE NOTICE</span>
        <p class="disclosure-text">
          As an Amazon Associate, I earn from qualifying purchases. When you purchase through links on this page, I may earn an affiliate commission at no extra cost to you. The Viltrox store link is an affiliate link as well. Unmarked items are the gear actually owned, tested, and utilized in commercial beverage production and content creation. Items marked Recommended are product recommendations.
        </p>
      </div>
    </aside>

    <div class="gear-project-cta">
      <a class="btn btn-secondary" href={PROJECT_INQUIRY_HREF}>
        Start a project <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </div>
</BaseLayout>

<style>
  .gear-page {
    padding-top: clamp(2rem, 4vw, 4rem);
    padding-bottom: clamp(4rem, 8vw, 7rem);
  }
  /* Same header unit as /build: tag, title, lede, small fixed steps. */
  .gear-header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.9rem;
    margin-bottom: clamp(2rem, 3vw, 3rem);
  }
  .mono-tag {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border);
    padding: 0.3rem 0.65rem;
    display: inline-block;
  }
  .gear-title {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    color: var(--ink);
    margin: 0;
    line-height: 1.05;
  }
  .gear-lede {
    font-size: 1.05rem;
    color: var(--muted);
    max-width: 65ch;
    line-height: 1.7;
    margin: 0;
  }
  .gear-disclosure {
    margin: 0.25rem 0 0;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .gear-collections {
    margin-top: clamp(2rem, 4vw, 3rem);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
  }
  .gear-collections-label {
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    margin-right: 0.25rem;
  }
  .gear-collection-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    padding: 0.45rem 0.85rem;
    border: 1px solid var(--border);
    color: var(--ink);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.2s ease, color 0.2s ease;
  }
  .gear-collection-link:hover {
    background: #fff;
    color: #000;
  }
  .gear-shop {
    margin-top: clamp(2rem, 4vw, 3rem);
  }
  .gear-shop :global(.storefront) {
    margin-top: 0;
  }
  .gear-bottom-disclosure {
    margin-top: 2rem;
  }
  .disclosure-card {
    background: #0f0f0f;
    border: 1px solid var(--border);
    padding: 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .disclosure-badge {
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .disclosure-text {
    font-size: 0.8rem;
    line-height: 1.6;
    color: #a0a0a0;
    margin: 0;
  }
  .gear-project-cta {
    margin-top: clamp(2rem, 4vw, 3rem);
    display: flex;
    align-items: center;
  }
</style>
