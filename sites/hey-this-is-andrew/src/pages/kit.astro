---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandAccordion from '@andrew/ui/BrandAccordion.astro';
import ExpandSection from '@andrew/ui/ExpandSection.astro';
import FilterTabs from '@andrew/ui/FilterTabs.astro';
import NewTag from '@andrew/ui/NewTag.astro';
import QuoteBand from '@andrew/ui/QuoteBand.astro';
import SectionHeader from '@andrew/ui/SectionHeader.astro';
import ViewAllLink from '@andrew/ui/ViewAllLink.astro';
import PhotoElevator from '@andrew/ui/PhotoElevator.astro';
import { homeUrl } from '../data/nav';

import brandsData from '../data/brands.json';
import { getInstagramPhotos } from '../lib/instagram';
const instagramPhotos = await getInstagramPhotos(8);
const categoryLabels = { cocktails: 'Cocktails', bar: 'Bars', product: 'Product' };
const elevatorPhotos = instagramPhotos.map((p) => ({
  id: p.id, image: p.image, caption: p.caption, category: p.category,
  location: p.location || (p.category === 'bar' ? 'Bar & Venue' : categoryLabels[p.category]),
  venue: p.venue, event: p.event, permalink: p.permalink,
  video: p.mediaType === 'VIDEO' && Boolean(p.permalink)
}));

// We don't render Nav/Footer or PageNav as they disrupt the page flow.
---
<BaseLayout title="UI Kit · HEY_THISISANDREW" description="Showroom for UI kit components" noindex={true}>
  <h1 class="vh">UI Kit</h1>
  <div class="container kit-page">
    <SectionHeader index="01" kicker="Design System" title="UI Kit Showroom" lede="A preview of all components in @andrew/ui." />

    <section class="kit-section">
      <h3>BrandAccordion</h3>
      <p class="kit-caption">Clients change the JSON store to feature their own sub-brands or collections.</p>
      <div style="padding:2rem; background:var(--surface);">
        <BrandAccordion panels={brandsData} />
      </div>
    </section>

    <section class="kit-section">
      <h3>ExpandSection</h3>
      <p class="kit-caption">Clients use this to hide long lists of projects or posts behind a toggle.</p>
      <ExpandSection id="kit-expand" expandLabel="Click to Expand" collapseLabel="Click to Collapse">
        <p style="padding: 1rem; border: 1px dashed var(--line);">This is the expanded content inside ExpandSection.</p>
      </ExpandSection>
    </section>

    <section class="kit-section">
      <h3>FilterTabs</h3>
      <p class="kit-caption">Clients change the categories to filter their portfolio (e.g. Weddings, Portraits).</p>
      <div id="filter-target">
        <FilterTabs target="filter-target" label="Filter items" tabs={[{key: 'all', label: 'All'}, {key: 'film', label: 'Film'}, {key: 'photo', label: 'Photo'}]} />
        <div style="margin-top: 1rem; display: flex; gap: 1rem;">
          <div data-kind="film" style="padding:1rem; border:1px solid var(--line);">Film Content</div>
          <div data-kind="photo" style="padding:1rem; border:1px solid var(--line);">Photo Content</div>
        </div>
      </div>
    </section>

    <section class="kit-section">
      <h3>NewTag</h3>
      <p class="kit-caption">Clients use this tag to highlight recent additions; it vanishes automatically after 24 hours.</p>
      <div style="display:flex; gap:1rem;">
        <NewTag published={new Date().toISOString()} label="NEW" />
      </div>
    </section>

    <section class="kit-section">
      <h3>QuoteBand</h3>
      <p class="kit-caption">Clients edit the quote and attribution to display a featured testimonial.</p>
      <QuoteBand eyebrow="Testimonial" quote="The most impactful creative partner we've had." attribution="A Real Client" />
    </section>

    <section class="kit-section">
      <h3>SectionHeader</h3>
      <p class="kit-caption">Clients change the index, kicker, title, and lede for every major page section.</p>
      <SectionHeader index="02" kicker="Component" title="SectionHeader Title" lede="This is a sample lede for the SectionHeader component." />
    </section>

    <section class="kit-section">
      <h3>ViewAllLink</h3>
      <p class="kit-caption">Clients change the URL and label to link users to full archive pages.</p>
      <ViewAllLink href={homeUrl} label="View all items" />
    </section>

    <section class="kit-section">
      <h3>PhotoElevator</h3>
      <p class="kit-caption">Clients sync their own Instagram or CMS gallery to populate the infinite scrolling reels.</p>
      <PhotoElevator photos={elevatorPhotos} />
    </section>
  </div>
</BaseLayout>

<style>
  .kit-page { padding-top: 4rem; padding-bottom: 8rem; }
  .kit-section { margin: 4rem 0; border-top: 1px solid var(--line); padding-top: 2rem; }
  .kit-section h3 { font-family: var(--font-mono); font-size: 1rem; margin-bottom: 0.5rem; color: var(--muted); }
  .kit-caption { font-size: 0.9rem; color: var(--muted); margin-bottom: 1.5rem; max-width: 60ch; }
</style>
