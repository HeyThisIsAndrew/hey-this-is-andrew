---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandAccordion from '@andrew/ui/BrandAccordion.astro';
import ExpandSection from '@andrew/ui/ExpandSection.astro';
import FilterTabs from '@andrew/ui/FilterTabs.astro';
import NewTag from '@andrew/ui/NewTag.astro';
import QuoteBand from '@andrew/ui/QuoteBand.astro';
import SectionHeader from '@andrew/ui/SectionHeader.astro';
import ViewAllLink from '@andrew/ui/ViewAllLink.astro';
import PhotoElevator from '@andrew/ui/PhotoElevator.astro';
import { homeUrl } from '../data/nav';
import portrait from '../assets/hero-media/portrait.jpg';
import beStill from '../assets/hero-media/be-hq-still.jpg';
import cccPour from '../assets/hero-media/ccc-pour.jpg';

const dummyPhotos = [
  { id: '1', image: portrait, caption: 'Portrait', category: 'Portrait', location: 'Studio', video: false },
  { id: '2', image: beStill, caption: 'BE HQ', category: 'HQ', location: 'Office', video: false },
  { id: '3', image: cccPour, caption: 'Pour', category: 'coffee', location: 'Cafe', video: false },
  { id: '4', image: portrait, caption: 'Portrait 2', category: 'Portrait', location: 'Studio', video: false },
];


// We won't render Nav/Footer or PageNav as they disrupt the page flow, or require global context.
---
<BaseLayout title="UI Kit · HEY_THISISANDREW" description="Showroom for UI kit components" noindex={true}>
  <h1 class="vh">UI Kit</h1>
  <div class="container kit-page">
    <SectionHeader index="01" kicker="Design System" title="UI Kit Showroom" lede="A preview of all components in @andrew/ui." />

    <section class="kit-section">
      <h3>BrandAccordion</h3>
      <div style="padding:2rem; background:var(--surface);">
        <BrandAccordion panels={[{ id: 'demo1', name: 'Brand One', kicker: 'Kicker', headline: 'Brand One Headline', deck: 'Deck', wordmark: 'BRAND 1', comingSoon: false }]} />
      </div>
    </section>

    <section class="kit-section">
      <h3>ExpandSection</h3>
      <ExpandSection id="kit-expand" expandLabel="Click to Expand" collapseLabel="Click to Collapse">
        <p style="padding: 1rem; border: 1px dashed var(--line);">This is the expanded content inside ExpandSection.</p>
      </ExpandSection>
    </section>

    <section class="kit-section">
      <h3>FilterTabs</h3>
      <div id="filter-target">
        <FilterTabs target="filter-target" label="Filter items" tabs={[{key: 'all', label: 'All'}, {key: 'film', label: 'Film'}, {key: 'photo', label: 'Photo'}]} />
        <div style="margin-top: 1rem;">
          <div data-kind="film" style="padding:1rem; border:1px solid var(--line); margin-bottom:0.5rem;">Film Content</div>
          <div data-kind="photo" style="padding:1rem; border:1px solid var(--line); margin-bottom:0.5rem;">Photo Content</div>
          <div data-kind="code" style="padding:1rem; border:1px solid var(--line); margin-bottom:0.5rem;">Code Content</div>
        </div>
      </div>
    </section>

    <section class="kit-section">
      <h3>NewTag</h3>
      <div style="display:flex; gap:1rem;">
        <NewTag published={new Date().toISOString()} label="NEW" />
        <NewTag published={new Date().toISOString()} label="UPDATED" />
      </div>
    </section>

    <section class="kit-section">
      <h3>QuoteBand</h3>
      <QuoteBand eyebrow="Testimonial" quote="This is a very good quote." attribution="- Test User" />
    </section>

    <section class="kit-section">
      <h3>SectionHeader</h3>
      <SectionHeader index="02" kicker="Component" title="SectionHeader Title" lede="This is a sample lede for the SectionHeader component." />
    </section>

    <section class="kit-section">
      <h3>ViewAllLink</h3>
      <ViewAllLink href={homeUrl} label="View all items" />
    </section>

    <section class="kit-section">
      <h3>PhotoElevator</h3>
      <PhotoElevator photos={dummyPhotos} />
    </section>
  </div>
</BaseLayout>

<style>
  .kit-page {
    padding-top: 4rem;
    padding-bottom: 8rem;
  }
  .kit-section {
    margin: 4rem 0;
    border-top: 1px solid var(--line);
    padding-top: 2rem;
  }
  .kit-section h3 {
    font-family: var(--font-mono);
    font-size: 1rem;
    margin-bottom: 1.5rem;
    color: var(--muted);
  }
</style>
