---
import BaseLayout from '../layouts/BaseLayout.astro';
import AboutSection from '../components/AboutSection.astro';
import QuoteBand from '@andrew/ui/QuoteBand.astro';
import WritingSection from '../components/WritingSection.astro';
import GoalsChecklist from '../components/GoalsChecklist.astro';
import StorefrontCTA from '../components/StorefrontCTA.astro';
import SectionHeader from '@andrew/ui/SectionHeader.astro';
import { getCollection } from 'astro:content';

const goals = (await getCollection('goals')).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout
  title="About · HEY_THISISANDREW"
  description="HEY_THISISANDREW: Andrew Baxter, creator, photographer, coffee drinker, building in public and figuring it out as I go."
>
  <h1 class="vh">About Andrew Baxter</h1>
  <div class="page-head" aria-hidden="true"></div>
  <section id="story" aria-hidden="true"></section>
  <section id="brands" aria-hidden="true"></section>
  <section id="press" aria-hidden="true"></section>
  <section id="contact" aria-hidden="true"></section>

  <AboutSection full />

  <QuoteBand
    eyebrow="A quote I live by"
    label="A quote Andrew lives by"
    quote="Nothing is ever as good or as bad as it seems, and when you look back on your life, you won't be upset about the thing that happened to you; you'll be upset about how you responded to it."
    attribution="Scott Galloway"
  />

  <WritingSection index="01" />

  <section id="goals" aria-labelledby="goals-heading" class="goals-section">
    <div class="container">
      <SectionHeader id="goals-heading" kicker="Transparent by default" title="Goals I'm chasing" lede="Public milestones, checked off as they happen." />
      <GoalsChecklist groups={goals} />
    </div>
  </section>

  <div class="container shop-wrap">
    <StorefrontCTA />
  </div>
</BaseLayout>

<style>
  /* Fixed nav clearance. */
  .page-head { height: clamp(4.5rem, 8vw, 6rem); }
  .goals-section {
    padding: clamp(4rem, 8vw, 7rem) 0;
    border-top: 1px solid var(--line);
  }
  .shop-wrap { padding-bottom: clamp(4rem, 8vw, 7rem); }
  .shop-wrap .storefront { margin-top: 0; }
</style>
