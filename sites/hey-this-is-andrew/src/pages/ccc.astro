    .ccc-strip-chevron {
      transition: none;
    }
    .ccc-panel-body.is-entering {
      transform: none;
    }
  }
</style>

<script>
  function initCccStack() {
    const stack = document.getElementById('ccc-stack');
    if (!stack || stack.dataset.cccStackWired === '1') return;
    stack.dataset.cccStackWired = '1';

    const panels = Array.from(stack.querySelectorAll<HTMLElement>('[data-ccc-panel]'));
    if (panels.length === 0) return;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let activeIdx = 0;
    let isInView = false;
    let rafId = 0;
    let lastScrollY = window.scrollY;
    let lockUntil = 0;

    function getNavHeight(): number {
      const nav = document.querySelector<HTMLElement>('.site-nav');
      const h = nav ? Math.round(nav.getBoundingClientRect().height) : 72;
      stack!.style.setProperty('--ccc-nav-h', `${h}px`);
      return h;
    }

    getNavHeight();
    window.addEventListener('resize', getNavHeight, { passive: true });

    function activatePanel(nextIdx: number, { animate = true, scrollAlign = false }: { animate?: boolean; scrollAlign?: boolean } = {}) {
      if (nextIdx < 0 || nextIdx >= panels.length) return;
      const changed = nextIdx !== activeIdx;
      activeIdx = nextIdx;

      const html = document.documentElement;
      const prevAnchor = html.style.overflowAnchor;
      html.style.overflowAnchor = 'none';

      panels.forEach((panel, i) => {
        const open = i === activeIdx;
        const passed = i < activeIdx;
        panel.classList.toggle('is-expanded', open);
        panel.classList.toggle('is-collapsed', !open);
        panel.classList.toggle('is-passed', passed);

        const btn = panel.querySelector<HTMLButtonElement>('[data-ccc-strip]');
        const body = panel.querySelector<HTMLElement>('[data-ccc-body]');
        btn?.setAttribute('aria-expanded', String(open));
        if (body) {
          body.inert = !open;
          if (open && changed && animate && !reducedMotion.matches) {
            body.classList.add('is-entering');
            requestAnimationFrame(() => {
              requestAnimationFrame(() => {
                body.classList.remove('is-entering');
              });
            });
          } else {
            body.classList.remove('is-entering');
          }
        }
      });

      if (scrollAlign) {
        const navH = getNavHeight();
        const stackDocTop = stack!.getBoundingClientRect().top + window.scrollY;
        const targetY = Math.max(0, stackDocTop - navH);
        lockUntil = performance.now() + 360;
        window.scrollTo({
          top: targetY,
          behavior: 'instant' as ScrollBehavior,
        });
        lastScrollY = window.scrollY;
      }

      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          html.style.overflowAnchor = prevAnchor;
        });
      });
    }

    // Strip click handler: tapping any strip expands only that panel and collapses the others
    panels.forEach((panel, idx) => {
      const btn = panel.querySelector<HTMLButtonElement>('[data-ccc-strip]');
      btn?.addEventListener('click', () => {
        const navH = getNavHeight();
        activatePanel(idx, { animate: !reducedMotion.matches, scrollAlign: false });
        lockUntil = performance.now() + 450;
        requestAnimationFrame(() => {
          const stackDocTop = stack!.getBoundingClientRect().top + window.scrollY;
          const targetY = Math.max(0, stackDocTop - navH);
          const behavior: ScrollBehavior = reducedMotion.matches ? 'auto' : 'smooth';
          window.scrollTo({ top: targetY, behavior });
          lastScrollY = targetY;
        });
      });
    });

    // Hash deep-link support (#why, #where, #work, #video, #how)
    function checkHash() {
      const hash = window.location.hash.slice(1);
      if (!hash) return;
      const idx = panels.findIndex((p) => p.id === hash);
      if (idx !== -1) {
        activatePanel(idx, { animate: false, scrollAlign: true });
      }
    }
    checkHash();
    window.addEventListener('hashchange', checkHash);

    // IntersectionObserver gates scroll tracking to when stack is on screen
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            isInView = entry.isIntersecting;
          }
        },
        { rootMargin: '10% 0px 10% 0px' }
      );
      io.observe(stack);
    } else {
      isInView = true;
    }

    function onScrollFrame() {
      rafId = 0;
      if (reducedMotion.matches || !isInView) {
        lastScrollY = window.scrollY;
        return;
      }

      const now = performance.now();
      const currentY = window.scrollY;
      const dy = currentY - lastScrollY;
      lastScrollY = currentY;

      if (now < lockUntil || Math.abs(dy) < 2) return;

      const currentPanel = panels[activeIdx];
      if (!currentPanel) return;

      const vh = window.innerHeight;
      const navH = getNavHeight();

      if (dy > 0 && activeIdx < panels.length - 1) {
        // Scrolling down: when the next panel's strip rises into the viewport trigger zone,
        // collapse the active panel to its strip and expand the next panel.
        const nextPanel = panels[activeIdx + 1];
        const nextTop = nextPanel.getBoundingClientRect().top;
        if (nextTop <= vh * 0.62) {
          activatePanel(activeIdx + 1, { animate: true, scrollAlign: true });
        }
      } else if (dy < 0 && activeIdx > 0) {
        // Scrolling up: when the user scrolls above the top of the current panel's aligned position,
        // expand the previous panel.
        const stackDocTop = stack!.getBoundingClientRect().top + currentY;
        const alignedTop = stackDocTop - navH;
        if (currentY < alignedTop - 32) {
          activatePanel(activeIdx - 1, { animate: true, scrollAlign: true });
        }
      }
    }

    window.addEventListener(
      'scroll',
      () => {
        if (!rafId && !reducedMotion.matches) {
          rafId = requestAnimationFrame(onScrollFrame);
        }
      },
      { passive: true }
    );
  }

  initCccStack();
  document.addEventListener('astro:page-load', initCccStack);
</script>
