---
/**
 * /ccc/: Capture Create Caffeinate.
 * Short, visual, collapsible section stack with an in-page project inquiry modal.
 * No embeds, no third-party scripts, no public prices on the page.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import CccPhoto from '../components/ccc/CccPhoto.astro';
import CccInquiryModal from '../components/ccc/CccInquiryModal.astro';
import { Image } from 'astro:assets';
import {
  CCC_DECK,
  CCC_PORTFOLIO,
  CCC_REEL_URL,
} from '../data/ccc';

import logo from '../assets/ccc/s01-logo.png';
import whyCoupe from '../assets/ccc/s02-why-1-coupe.jpg';
import whyShelves from '../assets/ccc/s03-why-2-bar-shelves.jpg';
import whereInstagram from '../assets/ccc/s04-where-1-instagram.jpg';
import whereWebsite from '../assets/ccc/s04-where-2-website.jpg';
import whereGoogle from '../assets/ccc/s04-where-3-google.jpg';
import wherePress from '../assets/ccc/s04-where-4-press.jpg';
import drinksPour from '../assets/ccc/s05-work-drinks-1-pour.jpg';
import drinksLineup from '../assets/ccc/s05-work-drinks-2-lineup.jpg';
import drinksMood from '../assets/ccc/s05-work-drinks-3-mood.jpg';
import nightWide from '../assets/ccc/s06-work-night-wide.jpg';
import night1 from '../assets/ccc/s06-work-night-1.jpg';
import night2 from '../assets/ccc/s06-work-night-2.jpg';
import night3 from '../assets/ccc/s06-work-night-3-beer.jpg';
import night4 from '../assets/ccc/s06-work-night-4.jpg';
import workRoom from '../assets/ccc/s07-work-room.jpg';
import workDetail from '../assets/ccc/s07-work-detail.jpg';
import desert1 from '../assets/ccc/s08-video-desert-1-opening.jpg';
import desert2 from '../assets/ccc/s08-video-desert-2-marquee.jpg';
import desert3 from '../assets/ccc/s08-video-desert-3-dj.jpg';
import desert4 from '../assets/ccc/s08-video-desert-4-layback.jpg';
import real1 from '../assets/ccc/s09-video-real-1-pool.jpg';
import real2 from '../assets/ccc/s09-video-real-2-dj.jpg';
import real3 from '../assets/ccc/s09-video-real-3-marios.jpg';
import howCrew from '../assets/ccc/s10-how-crew.jpg';
import howCocktails from '../assets/ccc/s11-how-easy-cocktails.jpg';
import closerBg from '../assets/ccc/s13-closer-bg.jpg';

const where = [
  { title: 'Instagram and TikTok', line: 'Posts, reels, and stories for weeks', img: whereInstagram, alt: 'A dark drink topped with a lace tuile on a black napkin, candlelight behind it' },
  { title: 'Your website', line: 'Photos that sell the room', img: whereWebsite, alt: 'A venue entrance under a striped awning, MAKE in large white letters above it' },
  { title: 'Google and Yelp', line: 'The first thing people see', img: whereGoogle, alt: 'A red beer in a stemmed tulip glass on a wooden bar top' },
  { title: 'Press and partners', line: 'Ready when someone asks for photos', img: wherePress, alt: 'Three bottles of spirits lit on a white shelf' },
];

const drinks = [
  { cap: 'The pour', img: drinksPour, alt: 'Two cocktails on a bar top, one dark red and one glowing orange' },
  { cap: 'The lineup', img: drinksLineup, alt: 'Three dark cocktails with orange peel lined up on the bar' },
  { cap: 'The mood', img: drinksMood, alt: 'A stemmed glass in black and white against soft blurred light' },
];

const nightTiles = [
  { img: night1, alt: 'A tall glass with a pale drink in warm candlelight' },
  { img: night2, alt: 'Two cocktails on the bar with warm orange light behind them' },
  { img: night3, alt: 'A red beer in a stemmed glass, close up' },
  { img: night4, alt: 'Cocktails with orange peel on the bar, a bartender at work behind them' },
];

const desert = [
  { cap: 'The opening shot', img: desert1, alt: 'A desert hotel pool with palm trees and mountains behind, titled Spirit of Hospitality' },
  { cap: 'The marquee', img: desert2, alt: 'The Ace Hotel and Swim Club marquee announcing Desert Escape 2026' },
  { cap: 'The DJ', img: desert3, alt: 'A DJ at the decks in front of a wood-slat wall at the Ace Hotel and Swim Club' },
  { cap: 'The layback', img: desert4, alt: 'Guests laughing together in front of an Angeleno booth' },
];

const real = [
  { cap: 'The crowd', img: real1, alt: 'A crowd around a hotel pool under yellow Topo Chico umbrellas' },
  { cap: 'The pour', img: real2, alt: 'A DJ in a patterned shirt at the decks, captioned This guy can dance' },
  { cap: 'The brands behind the bar', img: real3, alt: "A Mario's Hard Espresso table with a Nitro Espresso Martini sign" },
];

const steps = [
  { n: '01', title: 'A quick call', body: 'We talk through what you want to show off: the menu, the room, the people, anything new.' },
  { n: '02', title: 'Drinks and food first', body: "I shoot your best items while they're fresh, before service picks up." },
  { n: '03', title: 'Then the night', body: 'Guests, crew, and atmosphere as service happens. I stay small and out of the way.' },
  { n: '04', title: 'Ready to post', body: '15 selects the next day so you can post right away. The full gallery follows within a week.' },
];

const easy = [
  { title: 'Small footprint', body: "A light kit that stays out of your guests' way. No blocking the floor during service." },
  { title: 'Every good shot', body: "No cap on photos. If it's a keeper, it gets edited and it's yours." },
  { title: 'Sized to post', body: 'Delivered ready for your feed, stories, website, and Google listing.' },
  { title: 'Next-day selects', body: '15 selects the next day, so you can post while the night is fresh. The full gallery within a week.' },
];
---

<BaseLayout
  title="Capture Create Caffeinate · HEY_THISISANDREW"
  description="Photo and video for bars, restaurants, and events. One shoot, everywhere you post."
  image="/ccc/og.jpg"
>
  <div class="page-head" aria-hidden="true"></div>

  <!-- 1. Hero: Logo + "Bars. Restaurants. Events" + coupe cocktail image -->
  <section class="ccc-hero" aria-labelledby="ccc-title">
    <div class="container ccc-hero-inner">
      <Image
        src={logo}
        alt="Capture Create Caffeinate logo"
        width={340}
        densities={[1, 2]}
        class="ccc-hero-logo"
        loading="eager"
        fetchpriority="high"
      />
      <h1 id="ccc-title" class="ccc-hero-sub">Bars. Restaurants. Events</h1>
      <div class="ccc-hero-media">
        <CccPhoto
          src={whyCoupe}
          alt="A coupe cocktail glass on a dark bar, warm light glowing behind it"
          sizes="(min-width: 900px) 460px, 88vw"
          eager
        />
      </div>
      <div class="ccc-actions btn-group">
        <button type="button" class="btn btn-primary" data-open-ccc-modal>
          Start a project <span aria-hidden="true">&rarr;</span>
        </button>
        <a class="btn btn-secondary" href={CCC_DECK.href} download>
          {CCC_DECK.label} <span aria-hidden="true">&darr;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Collapsible Section Stack (01 through 05) -->
  <div class="ccc-stack" id="ccc-stack" data-ccc-stack>
    <!-- 01 Why it matters -->
    <section
      id="why"
      class="ccc-panel is-expanded"
      data-ccc-panel
      data-panel-index="0"
      style="--panel-index: 0;"
      aria-labelledby="ccc-strip-why"
    >
      <h2 class="ccc-strip-heading">
        <button
          type="button"
          id="ccc-strip-why"
          class="ccc-strip-btn"
          data-ccc-strip
          aria-expanded="true"
          aria-controls="ccc-body-why"
        >
          <span class="ccc-strip-num font-mono">01</span>
          <span class="ccc-strip-title">Why it matters</span>
          <span class="ccc-strip-chevron" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </span>
        </button>
      </h2>
      <div id="ccc-body-why" class="ccc-panel-body" data-ccc-body role="region" aria-labelledby="ccc-strip-why">
        <div class="container ccc-panel-inner">
          <p class="ccc-lead">
            If the photos don't look like the night you actually deliver, you lose people before they ever walk in.
          </p>
          <div class="ccc-split is-flip">
            <div class="ccc-split-media">
              <CccPhoto
                src={whyShelves}
                alt="Bar shelves of bottles and records under glowing copper pendant lights, a reel-to-reel deck in front"
                sizes="(min-width: 900px) 45vw, 100vw"
                eager
              />
            </div>
            <div class="ccc-split-copy">
              <h3 class="ccc-subtitle">You're busy running the place</h3>
              <p>
                Nobody behind the bar has time to stop and shoot the pour, the room at 9pm, or the crew in the middle of a rush. I come in, stay out of the way, and catch the good stuff your guests already love.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 02 Where it goes -->
    <section
      id="where"
      class="ccc-panel is-collapsed"
      data-ccc-panel
      data-panel-index="1"
      style="--panel-index: 1;"
      aria-labelledby="ccc-strip-where"
    >
      <h2 class="ccc-strip-heading">
        <button
          type="button"
          id="ccc-strip-where"
          class="ccc-strip-btn"
          data-ccc-strip
          aria-expanded="false"
          aria-controls="ccc-body-where"
        >
          <span class="ccc-strip-num font-mono">02</span>
          <span class="ccc-strip-title">Where it goes</span>
          <span class="ccc-strip-chevron" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </span>
        </button>
      </h2>
      <div id="ccc-body-where" class="ccc-panel-body" data-ccc-body role="region" aria-labelledby="ccc-strip-where" inert>
        <div class="container ccc-panel-inner">
          <ul class="ccc-cards4" role="list">
            {where.map((w) => (
              <li class="ccc-card">
                <div class="ccc-card-media">
                  <CccPhoto src={w.img} alt={w.alt} sizes="(min-width: 900px) 22vw, 46vw" />
                </div>
                <h3 class="ccc-card-title">{w.title}</h3>
                <p class="ccc-card-line">{w.line}</p>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- 03 The work -->
    <section
      id="work"
      class="ccc-panel is-collapsed"
      data-ccc-panel
      data-panel-index="2"
      style="--panel-index: 2;"
      aria-labelledby="ccc-strip-work"
    >
      <h2 class="ccc-strip-heading">
        <button
          type="button"
          id="ccc-strip-work"
          class="ccc-strip-btn"
          data-ccc-strip
          aria-expanded="false"
          aria-controls="ccc-body-work"
        >
          <span class="ccc-strip-num font-mono">03</span>
          <span class="ccc-strip-title">The work</span>
          <span class="ccc-strip-chevron" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </span>
        </button>
      </h2>
      <div id="ccc-body-work" class="ccc-panel-body" data-ccc-body role="region" aria-labelledby="ccc-strip-work" inert>
        <div class="container ccc-panel-inner">
          <ul class="ccc-grid3" role="list">
            {drinks.map((d) => (
              <li>
                <figure class="ccc-fig">
                  <CccPhoto src={d.img} alt={d.alt} sizes="(min-width: 900px) 30vw, 100vw" />
                  <figcaption>{d.cap}</figcaption>
                </figure>
              </li>
            ))}
          </ul>

          <div class="ccc-mosaic">
            <div class="ccc-mosaic-wide">
              <CccPhoto src={nightWide} alt="A drink being poured into a glass, close up" sizes="(min-width: 900px) 55vw, 100vw" />
            </div>
            {nightTiles.map((t) => (
              <div class="ccc-mosaic-tile">
                <CccPhoto src={t.img} alt={t.alt} sizes="(min-width: 900px) 14vw, 48vw" />
              </div>
            ))}
          </div>

          <div class="ccc-room">
            <figure class="ccc-fig ccc-room-wide">
              <CccPhoto src={workRoom} alt="A warm wood-panelled bar room under glowing pendant lights" sizes="(min-width: 900px) 62vw, 100vw" />
              <figcaption>The room</figcaption>
            </figure>
            <figure class="ccc-fig">
              <CccPhoto src={workDetail} alt="A hand setting a garnish on a dark drink topped with a lace tuile" sizes="(min-width: 900px) 34vw, 100vw" />
              <figcaption>The detail</figcaption>
            </figure>
          </div>

          <p class="ccc-credit">Photographs by Andrew Baxter. Shot for Capture Create Caffeinate.</p>
        </div>
      </div>
    </section>

    <!-- 04 Real nights -->
    <section
      id="video"
      class="ccc-panel is-collapsed"
      data-ccc-panel
      data-panel-index="3"
      style="--panel-index: 3;"
      aria-labelledby="ccc-strip-video"
    >
      <h2 class="ccc-strip-heading">
        <button
          type="button"
          id="ccc-strip-video"
          class="ccc-strip-btn"
          data-ccc-strip
          aria-expanded="false"
          aria-controls="ccc-body-video"
        >
          <span class="ccc-strip-num font-mono">04</span>
          <span class="ccc-strip-title">Real nights</span>
          <span class="ccc-strip-chevron" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </span>
        </button>
      </h2>
      <div id="ccc-body-video" class="ccc-panel-body" data-ccc-body role="region" aria-labelledby="ccc-strip-video" inert>
        <div class="container ccc-panel-inner">
          <ul class="ccc-grid4" role="list">
            {desert.map((d) => (
              <li>
                <figure class="ccc-fig ccc-fig--wide">
                  <CccPhoto src={d.img} alt={d.alt} sizes="(min-width: 900px) 22vw, 46vw" />
                  <figcaption>{d.cap}</figcaption>
                </figure>
              </li>
            ))}
          </ul>

          <div class="ccc-real">
            <div class="ccc-real-copy">
              <p>
                I move through the room like a guest would, so the reel carries the pace and sound of a real night.
              </p>
              {CCC_REEL_URL && (
                <a class="btn btn-ghost ccc-reel-link" href={CCC_REEL_URL} target="_blank" rel="noopener">
                  Watch the reel <span aria-hidden="true">&#8599;</span>
                </a>
              )}
            </div>
            <div class="ccc-real-frames">
              <figure class="ccc-fig ccc-real-main">
                <CccPhoto src={real[0].img} alt={real[0].alt} sizes="(min-width: 900px) 50vw, 100vw" />
                <figcaption>{real[0].cap}</figcaption>
              </figure>
              <figure class="ccc-fig">
                <CccPhoto src={real[1].img} alt={real[1].alt} sizes="(min-width: 900px) 25vw, 50vw" />
                <figcaption>{real[1].cap}</figcaption>
              </figure>
              <figure class="ccc-fig">
                <CccPhoto src={real[2].img} alt={real[2].alt} sizes="(min-width: 900px) 25vw, 50vw" />
                <figcaption>{real[2].cap}</figcaption>
              </figure>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 05 How it works -->
    <section
      id="how"
      class="ccc-panel is-collapsed"
      data-ccc-panel
      data-panel-index="4"
      style="--panel-index: 4;"
      aria-labelledby="ccc-strip-how"
    >
      <h2 class="ccc-strip-heading">
        <button
          type="button"
          id="ccc-strip-how"
          class="ccc-strip-btn"
          data-ccc-strip
          aria-expanded="false"
          aria-controls="ccc-body-how"
        >
          <span class="ccc-strip-num font-mono">05</span>
          <span class="ccc-strip-title">How it works</span>
          <span class="ccc-strip-chevron" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </span>
        </button>
      </h2>
      <div id="ccc-body-how" class="ccc-panel-body" data-ccc-body role="region" aria-labelledby="ccc-strip-how" inert>
        <div class="container ccc-panel-inner">
          <div class="ccc-split">
            <div class="ccc-split-media">
              <CccPhoto src={howCrew} alt="Kitchen crew at work at the pass of a busy restaurant" sizes="(min-width: 900px) 40vw, 100vw" />
            </div>
            <ol class="ccc-steps" role="list">
              {steps.map((s) => (
                <li>
                  <span class="ccc-step-n" aria-hidden="true">{s.n}</span>
                  <div>
                    <h3 class="ccc-step-title">{s.title}</h3>
                    <p>{s.body}</p>
                  </div>
                </li>
              ))}
            </ol>
          </div>

          <h3 class="ccc-subtitle ccc-subtitle--spaced">Easy on your end</h3>
          <div class="ccc-split is-flip">
            <div class="ccc-split-media">
              <CccPhoto src={howCocktails} alt="A bartender setting two cocktails down on a bar mat" sizes="(min-width: 900px) 40vw, 100vw" />
            </div>
            <ul class="ccc-easy" role="list">
              {easy.map((e) => (
                <li class="ccc-easy-card">
                  <h4 class="ccc-step-title">{e.title}</h4>
                  <p>{e.body}</p>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- Close: standalone final block after the panels -->
  <section id="contact" class="ccc-closer" aria-labelledby="ccc-closer">
    <div class="ccc-closer-bg" aria-hidden="true">
      <CccPhoto src={closerBg} alt="" sizes="100vw" />
    </div>
    <div class="container ccc-closer-inner">
      <Image src={logo} alt="Capture Create Caffeinate logo" width={150} densities={[1, 2]} class="ccc-closer-logo" />
      <p class="ccc-closer-eyebrow">Let's get you on the calendar</p>
      <h2 id="ccc-closer" class="ccc-closer-title">Show people what they're missing</h2>
      <p class="ccc-closer-body">One shoot. Weeks of content. A better reason for people to come see you.</p>
      <div class="ccc-actions btn-group">
        <button type="button" class="btn btn-primary" data-open-ccc-modal>
          Start a project <span aria-hidden="true">&rarr;</span>
        </button>
        <a class="btn btn-secondary" href={CCC_DECK.href} download>
          {CCC_DECK.label} <span aria-hidden="true">&darr;</span>
        </a>
        <a class="btn btn-secondary" href={CCC_PORTFOLIO} target="_blank" rel="noopener">
          Portfolio <span aria-hidden="true">&#8599;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Start a Project Modal -->
  <CccInquiryModal />
</BaseLayout>

<style>
  /* Fixed nav clearance */
  .page-head {
    height: clamp(4.5rem, 8vw, 6rem);
  }

  /* Hero: Logo is the largest element, followed by "Bars. Restaurants. Events" and the coupe image */
  .ccc-hero {
    padding: clamp(2rem, 5vw, 4rem) 0 clamp(2.5rem, 6vw, 4.5rem);
    text-align: center;
  }
  .ccc-hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }
  .ccc-hero-logo {
    width: clamp(280px, 78vw, 380px);
    height: auto;
  }
  .ccc-hero-sub {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .ccc-hero-media {
    width: 100%;
    max-width: 460px;
    margin-top: 0.25rem;
  }
  .ccc-hero-media :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .ccc-actions {
    margin: 0.5rem auto 0;
  }

  /* Collapsible Stack */
  .ccc-stack {
    --ccc-nav-h: 72px;
    --ccc-strip-h: 48px;
    position: relative;
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--line);
  }
  .ccc-panel {
    position: relative;
    background: var(--bg, #080808);
    border-bottom: 1px solid var(--line);
  }
  /* Collapsed panels stick in order at the top so passed sections stay visible */
  .ccc-panel.is-collapsed {
    position: sticky;
    top: calc(var(--ccc-nav-h) + (var(--panel-index, 0) * var(--ccc-strip-h)));
    z-index: calc(30 - var(--panel-index, 0));
  }
  .ccc-strip-heading {
    margin: 0;
    font: inherit;
  }
  .ccc-panel.is-expanded .ccc-strip-heading {
    position: sticky;
    top: calc(var(--ccc-nav-h) + (var(--panel-index, 0) * var(--ccc-strip-h)));
    z-index: calc(30 - var(--panel-index, 0));
    background: #0e0e0e;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .ccc-strip-btn {
    appearance: none;
    width: 100%;
    min-height: var(--ccc-strip-h);
    height: var(--ccc-strip-h);
    padding: 0 max(1.25rem, calc((100vw - var(--maxw, 1200px)) / 2 + 1.25rem));
    display: flex;
    align-items: center;
    gap: 1rem;
    background: #0e0e0e;
    border: none;
    color: var(--ink, #fff);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }
  .ccc-strip-btn:hover {
    background: #151515;
  }
  .ccc-strip-btn:focus-visible {
    outline: 2px solid var(--focus-ring, #fff);
    outline-offset: -2px;
  }
  .ccc-strip-num {
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted, #888);
    min-width: 2ch;
  }
  .ccc-strip-title {
    flex: 1;
    font-family: var(--font-display);
    font-size: clamp(1rem, 2vw, 1.35rem);
    font-weight: 800;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--ink, #fff);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .ccc-strip-chevron {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    color: var(--muted, #888);
    transition: transform 0.24s ease-out, color 0.2s ease;
  }
  .ccc-panel.is-expanded .ccc-strip-chevron {
    transform: rotate(180deg);
    color: var(--ink, #fff);
  }

  .ccc-panel-body {
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(2.5rem, 6vw, 4.5rem) 0;
    transform: translate3d(0, 0, 0);
    transition: transform 0.24s ease-out;
  }
  .ccc-panel-body.is-entering {
    transform: translate3d(0, 14px, 0);
  }
  .ccc-panel.is-collapsed .ccc-panel-body {
    display: none;
    min-height: 0;
  }
