---
/**
 * /ccc/: Capture Create Caffeinate.
 * Full-width collapsed section rows with 1:1 production scaling and layout.
 *
 * Each section occupies the entire width of the page with:
 * - Left: Number and kicker (e.g. "01 Why it matters")
 * - Right: Large display title (e.g. "People decide with their eyes")
 * - Collapsible body preserving exact original internal layouts, grids, and aspect ratios.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '@andrew/ui/SectionHeader.astro';
import FlipCard from '@andrew/ui/FlipCard.astro';
import CccPhoto from '../components/ccc/CccPhoto.astro';
import CccInquiryModal from '../components/ccc/CccInquiryModal.astro';
import { Image } from 'astro:assets';
import {
  CCC_PRICING as P,
  CCC_PORTFOLIO,
  CCC_INQUIRY_HREF,
  CCC_SHOW_VIDEO,
  CCC_REEL_URL,
} from '../data/ccc';

import logo from '../assets/ccc/s01-logo.png';
import whyCoupe from '../assets/ccc/s02-why-1-coupe.jpg';
import whyShelves from '../assets/ccc/s03-why-2-bar-shelves.jpg';
import whereInstagram from '../assets/ccc/s04-where-1-instagram.jpg';
import whereWebsite from '../assets/ccc/s04-where-2-website.jpg';
import whereGoogle from '../assets/ccc/s04-where-3-google.jpg';
import wherePress from '../assets/ccc/s04-where-4-press.jpg';
import drinksPour from '../assets/ccc/s05-work-drinks-1-pour.jpg';
import drinksLineup from '../assets/ccc/s05-work-drinks-2-lineup.jpg';
import drinksMood from '../assets/ccc/s05-work-drinks-3-mood.jpg';
import nightWide from '../assets/ccc/s06-work-night-wide.jpg';
import night1 from '../assets/ccc/s06-work-night-1.jpg';
import night2 from '../assets/ccc/s06-work-night-2.jpg';
import night3 from '../assets/ccc/s06-work-night-3-beer.jpg';
import night4 from '../assets/ccc/s06-work-night-4.jpg';
import workRoom from '../assets/ccc/s07-work-room.jpg';
import workDetail from '../assets/ccc/s07-work-detail.jpg';
import desert1 from '../assets/ccc/s08-video-desert-1-opening.jpg';
import desert2 from '../assets/ccc/s08-video-desert-2-marquee.jpg';
import desert3 from '../assets/ccc/s08-video-desert-3-dj.jpg';
import desert4 from '../assets/ccc/s08-video-desert-4-layback.jpg';
import real1 from '../assets/ccc/s09-video-real-1-pool.jpg';
import real2 from '../assets/ccc/s09-video-real-2-dj.jpg';
import real3 from '../assets/ccc/s09-video-real-3-marios.jpg';
import howCrew from '../assets/ccc/s10-how-crew.jpg';
import howCocktails from '../assets/ccc/s11-how-easy-cocktails.jpg';
import pricingCoupe from '../assets/ccc/s12-pricing-coupe.jpg';
import closerBg from '../assets/ccc/s13-closer-bg.jpg';

const where = [
  { title: 'Instagram and TikTok', line: 'Posts, reels, and stories for weeks', img: whereInstagram, alt: 'A dark drink topped with a lace tuile on a black napkin, candlelight behind it' },
  { title: 'Your website', line: 'Photos that sell the room', img: whereWebsite, alt: 'A venue entrance under a striped awning, MAKE in large white letters above it' },
  { title: 'Google and Yelp', line: 'The first thing people see', img: whereGoogle, alt: 'A red beer in a stemmed tulip glass on a wooden bar top' },
  { title: 'Press and partners', line: 'Ready when someone asks for photos', img: wherePress, alt: 'Three bottles of spirits lit on a white shelf' },
];
const drinks = [
  { cap: 'The pour', img: drinksPour, alt: 'Two cocktails on a bar top, one dark red and one glowing orange' },
  { cap: 'The lineup', img: drinksLineup, alt: 'Three dark cocktails with orange peel lined up on the bar' },
  { cap: 'The mood', img: drinksMood, alt: 'A stemmed glass in black and white against soft blurred light' },
];
const nightTiles = [
  { img: night1, alt: 'A tall glass with a pale drink in warm candlelight' },
  { img: night2, alt: 'Two cocktails on the bar with warm orange light behind them' },
  { img: night3, alt: 'A red beer in a stemmed glass, close up' },
  { img: night4, alt: 'Cocktails with orange peel on the bar, a bartender at work behind them' },
];
const nightList = ['The signature drinks', 'The little details', 'The room', 'Your crew', 'The front door'];
const desert = [
  { cap: 'The opening shot', img: desert1, alt: 'A desert hotel pool with palm trees and mountains behind, titled Spirit of Hospitality' },
  { cap: 'The marquee', img: desert2, alt: 'The Ace Hotel and Swim Club marquee announcing Desert Escape 2026' },
  { cap: 'The DJ', img: desert3, alt: 'A DJ at the decks in front of a wood-slat wall at the Ace Hotel and Swim Club' },
  { cap: 'The layback', img: desert4, alt: 'Guests laughing together in front of an Angeleno booth' },
];
const real = [
  { img: real1, alt: 'A crowd around a hotel pool under yellow Topo Chico umbrellas' },
  { img: real2, alt: 'A DJ in a patterned shirt at the decks, captioned This guy can dance' },
  { img: real3, alt: "A Mario's Hard Espresso table with a Nitro Espresso Martini sign" },
];
const steps = [
  { n: '01', title: 'A quick call', body: 'We talk through what you want to show off: the menu, the room, the people, anything new.' },
  { n: '02', title: 'Drinks and food first', body: "I shoot your best items while they're fresh, before service picks up." },
  { n: '03', title: 'Then the night', body: 'Guests, crew, and atmosphere as service happens. I stay small and out of the way.' },
  { n: '04', title: 'Ready to post', body: '15 selects the next day so you can post right away. The full gallery follows within a week.' },
];
const easy = [
  { title: 'Small footprint', body: "A light kit that stays out of your guests' way. No blocking the floor during service." },
  { title: 'Every good shot', body: "No cap on photos. If it's a keeper, it gets edited and it's yours." },
  { title: 'Sized to post', body: 'Delivered ready for your feed, stories, website, and Google listing.' },
  { title: 'Next-day selects', body: '15 selects the next day, so you can post while the night is fresh. The full gallery within a week.' },
];
const packages = [
  {
    id: 'photo',
    value: 'PHOTO SESSION',
    label: 'Half-Day Coverage',
    desc: '4 hrs on site \u00b7 15 next-day selects \u00b7 No photo cap',
    backText:
      'Four hours on site capturing your signature drinks, the room, and service as it happens. Every keeper edited with no cap on photos. 15 selects delivered the next day so you can post immediately, with your full high-res gallery within a week.',
  },
  {
    id: 'reel',
    value: 'REEL ADD-ON',
    label: 'Vertical Video',
    desc: 'Native 9:16 vertical \u00b7 Sound & color graded',
    backText:
      'Add vertical video shot natively for Instagram Reels and TikTok. Captures the movement, ambient sound, and raw energy of a real night without staged disruptions, edited and color-matched to your venue with revisions included.',
  },
  {
    id: 'bundle',
    value: 'PHOTO + REEL',
    label: 'Complete Package',
    desc: 'Photo + vertical video \u00b7 Weeks of content',
    backText:
      'The all-in-one package for venues that want complete coverage. Both photography and vertical video captured together in a single shoot with matched tone and color, delivering weeks of ready-to-post content across your feed, stories, and website.',
  },
];
---

<BaseLayout
  title="Capture Create Caffeinate · HEY_THISISANDREW"
  description="Photo and video for bars, restaurants, and events. One shoot, everywhere you post."
  image="/ccc/og.jpg"
  pane="Capture Create Caffeinate"
  topLabel="Overview"
>
  <div class="ccc-route">
    <div class="page-head" aria-hidden="true"></div>

    <!-- Persistent Docked Top Bar: Only the hero row collapses here on scroll and remains available as a quick return to top -->
    <div id="ccc-pinned-stack" class="ccc-pinned-stack" aria-label="Quick return to top">
      <div class="ccc-dock-row ccc-dock-row--hero" data-target="hero" inert>
        <button type="button" class="ccc-dock-btn ccc-dock-btn--hero" aria-label="Scroll back to top" tabindex="-1">
          <span class="ccc-row-kicker font-mono">Bars &middot; Restaurants &middot; Events</span>
        </button>
      </div>
    </div>

    <!-- 00 Hero -->
    <section id="hero" class="ccc-hero" aria-labelledby="ccc-hero-title">
      <div class="container ccc-hero-inner">
        <Image src={logo} alt="Capture Create Caffeinate logo" width={520} densities={[1, 2]} class="ccc-hero-logo" loading="eager" fetchpriority="high" />
        <h1 id="ccc-hero-title" class="ccc-hero-title">
          <span class="ccc-hero-line">Content that brings people</span><br /><span class="ccc-hero-line">through your door</span>
        </h1>
        <p class="ccc-hero-sub">Bars · Restaurants · Events</p>
        <div class="ccc-actions btn-group btn-group--row">
          <a class="btn btn-primary" href={CCC_INQUIRY_HREF} data-open-ccc-modal>Contact <span aria-hidden="true">&rarr;</span></a>
          <a class="btn btn-secondary" href={CCC_PORTFOLIO} target="_blank" rel="noopener">Portfolio <span aria-hidden="true">&#8599;</span></a>
        </div>
      </div>
    </section>

    <!-- 01 Why it matters -->
    <section id="why" class="ccc-section" aria-labelledby="ccc-why">
      <div class="container">
        <SectionHeader kicker="Why it matters" title="People decide with their eyes" id="ccc-why" />
        <div class="ccc-why-stage" id="ccc-why-stage">
          <div class="ccc-why-pair ccc-why-pair--top" id="ccc-why-top">
            <div class="ccc-why-media">
              <CccPhoto src={whyCoupe} alt="A coupe cocktail glass on a dark bar, warm light glowing behind it" sizes="(min-width: 1920px) 810px, (min-width: 900px) 38vw, 94vw" />
            </div>
            <div class="ccc-why-copy">
              <p>Before anyone books a table, they've already scrolled your feed, your Google listing, and every post you've been tagged in. If the photos don't look like the night you actually deliver, you lose them before they ever walk in.</p>
            </div>
          </div>
          <div class="ccc-why-pair ccc-why-pair--bottom" id="ccc-why-bottom">
            <div class="ccc-why-copy">
              <h3 class="ccc-subtitle">You're busy running the place</h3>
              <p>Nobody behind the bar has time to stop and shoot the pour, the room at 9pm, or the crew in the middle of a rush. That's my job. I come in, stay out of the way, and catch the good stuff your guests already love.</p>
            </div>
            <div class="ccc-why-media">
              <CccPhoto src={whyShelves} alt="Bar shelves of bottles and records under glowing copper pendant lights, a reel-to-reel deck in front" sizes="(min-width: 1920px) 810px, (min-width: 900px) 38vw, 94vw" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 02 Where it goes -->
    <section id="where" class="ccc-section" aria-labelledby="ccc-where">
      <div class="container">
        <SectionHeader kicker="Where it goes" title="One shoot, everywhere you post" id="ccc-where" />
        <ul class="ccc-cards4" id="ccc-where-grid">
          {where.map((w, idx) => (
            <li class="ccc-card" data-card-index={idx}>
              <div class="ccc-card-media"><CccPhoto src={w.img} alt={w.alt} sizes="(min-width: 900px) 22vw, 46vw" /></div>
              <h3 class="ccc-card-title">{w.title}</h3>
              <p class="ccc-card-line">{w.line}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 03 The work -->
    <section id="work" class="ccc-section" aria-labelledby="ccc-work">
      <div class="container">
        <SectionHeader kicker="The work" title="Drinks people want to order" id="ccc-work" />
        <ul class="ccc-grid3" id="ccc-work-trio">
          {drinks.map((d, idx) => (
            <li class="ccc-work-item" data-drink-index={idx}>
              <figure class="ccc-fig">
                <CccPhoto src={d.img} alt={d.alt} sizes="(min-width: 900px) 30vw, (min-width: 640px) 31vw, 94vw" />
                <figcaption>{d.cap}</figcaption>
              </figure>
            </li>
          ))}
        </ul>

        <div class="ccc-night" id="ccc-work-night">
          <div class="ccc-night-copy">
            <h3 class="ccc-subtitle">Every part of your night</h3>
            <ul class="ccc-dotlist">
              {nightList.map((t) => <li>{t}</li>)}
            </ul>
          </div>
          <div class="ccc-mosaic">
            <div class="ccc-mosaic-wide">
              <CccPhoto src={nightWide} alt="A drink being poured into a glass, close up" sizes="(min-width: 900px) 56vw, 94vw" />
            </div>
            {nightTiles.map((t, idx) => (
              <div class="ccc-mosaic-tile" data-tile-index={idx}><CccPhoto src={t.img} alt={t.alt} sizes="(min-width: 900px) 13vw, (min-width: 640px) 22vw, 46vw" /></div>
            ))}
          </div>
        </div>

        <h3 class="ccc-subtitle ccc-subtitle--spaced">The room and the details</h3>
        <div class="ccc-room" id="ccc-work-room">
          <figure class="ccc-fig ccc-room-wide">
            <CccPhoto src={workRoom} alt="A warm wood-panelled bar room under glowing pendant lights" sizes="(min-width: 900px) 56vw, 94vw" />
            <figcaption>The room</figcaption>
          </figure>
          <figure class="ccc-fig ccc-room-detail">
            <CccPhoto src={workDetail} alt="A hand setting a garnish on a dark drink topped with a lace tuile" sizes="(min-width: 900px) 36vw, 94vw" />
            <figcaption>The detail</figcaption>
          </figure>
        </div>

        <p class="ccc-credit">All photographs by Andrew. The cocktails and dishes pictured are the bar's. The photography is mine.</p>
      </div>
    </section>

    <!-- 04 Video -->
    {CCC_SHOW_VIDEO && (
      <section id="video" class="ccc-section" aria-labelledby="ccc-video">
        <div class="container">
          <SectionHeader kicker="Video" title="Desert Escape, shot by shot" id="ccc-video" />
          <ul class="ccc-grid4">
            {desert.map((d) => (
              <li>
                <figure class="ccc-fig ccc-fig--wide">
                  <CccPhoto src={d.img} alt={d.alt} sizes="(min-width: 900px) 22vw, 46vw" />
                  <figcaption>{d.cap}</figcaption>
                </figure>
              </li>
            ))}
          </ul>

          <div class="ccc-real">
            <div class="ccc-real-copy">
              <h3 class="ccc-subtitle">Real nights, nothing staged</h3>
              <p>I move through the room like a guest would, so the reel carries the pace and sound of a real night.</p>
              <ul class="ccc-dotlist">
                <li>The crowd</li>
                <li>The pour</li>
                <li>The brands behind the bar</li>
              </ul>
              {CCC_REEL_URL && (
                <a class="btn btn-ghost ccc-reel-link" href={CCC_REEL_URL} target="_blank" rel="noopener">
                  Watch the reel <span aria-hidden="true">&#8599;</span>
                </a>
              )}
            </div>
            <div class="ccc-real-frames">
              <div class="ccc-real-main"><CccPhoto src={real[0].img} alt={real[0].alt} sizes="(min-width: 900px) 52vw, 94vw" /></div>
              <div><CccPhoto src={real[1].img} alt={real[1].alt} sizes="(min-width: 900px) 25vw, 46vw" /></div>
              <div><CccPhoto src={real[2].img} alt={real[2].alt} sizes="(min-width: 900px) 25vw, 46vw" /></div>
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- 05 How it works -->
    <section id="how" class="ccc-section" aria-labelledby="ccc-how">
      <div class="container">
        <SectionHeader kicker="How it works" title="Four hours, no disruption" id="ccc-how" />
        <div class="ccc-split">
          <div class="ccc-split-media">
            <CccPhoto src={howCrew} alt="Kitchen crew at work at the pass of a busy restaurant" sizes="(min-width: 1920px) 735px, (min-width: 900px) 36vw, 94vw" />
          </div>
          <ol class="ccc-steps">
            {steps.map((s) => (
              <li>
                <span class="ccc-step-n" aria-hidden="true">{s.n}</span>
                <div>
                  <h3 class="ccc-step-title">{s.title}</h3>
                  <p>{s.body}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>

        <h3 class="ccc-subtitle ccc-subtitle--spaced">Easy on your end</h3>
        <div class="ccc-split is-flip">
          <div class="ccc-split-media">
            <CccPhoto src={howCocktails} alt="A bartender setting two cocktails down on a bar mat" sizes="(min-width: 1920px) 735px, (min-width: 900px) 36vw, 94vw" />
          </div>
          <ul class="ccc-easy">
            {easy.map((e) => (
              <li class="ccc-easy-card">
                <h4 class="ccc-step-title">{e.title}</h4>
                <p>{e.body}</p>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- 06 Packages -->
    <section id="pricing" class="ccc-section" aria-labelledby="ccc-pricing">
      <div class="container">
        <SectionHeader kicker="Packages" title="Pick what you need" id="ccc-pricing" />
        <div class="ccc-pricing">
          <div class="ccc-pricing-media">
            <CccPhoto src={pricingCoupe} alt="A coupe cocktail with a green garnish, warm light behind it" sizes="(min-width: 1920px) 735px, (min-width: 900px) 28vw, 94vw" />
          </div>
          <div class="ccc-pricing-list">
            <div class="ccc-pricing-cards">
              {packages.map((pkg, idx) => (
                <FlipCard
                  value={pkg.value}
                  label={pkg.label}
                  desc={pkg.desc}
                  backText={pkg.backText}
                  idPrefix="ccc-pkg-back"
                  index={idx}
                  dataCccPackage={pkg.id}
                  actionLabel="Contact"
                  class="ccc-pkg-card"
                />
              ))}
            </div>
            <p class="ccc-price-foot">Rush delivery: full gallery in 48 hours · Events and custom projects quoted by scope</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 8. Closer (slide 13) -->
    <section id="contact" class="ccc-closer" aria-labelledby="ccc-closer">
      <div class="ccc-closer-bg" aria-hidden="true">
        <CccPhoto src={closerBg} alt="" sizes="100vw" />
      </div>
      <div class="container ccc-closer-inner">
        <Image src={logo} alt="Capture Create Caffeinate logo" width={300} densities={[1, 2]} class="ccc-closer-logo" />
        <p class="ccc-closer-eyebrow">Let's get you on the calendar</p>
        <h2 id="ccc-closer" class="ccc-closer-title">Show people what they're missing</h2>
        <p class="ccc-closer-body">One shoot. Weeks of content. A better reason for people to come see you.</p>
        <p class="ccc-closer-price">Photo sessions · Vertical reels · Complete packages</p>
        <div class="ccc-actions btn-group btn-group--row">
          <a class="btn btn-primary" href={CCC_INQUIRY_HREF} data-open-ccc-modal>Contact <span aria-hidden="true">&rarr;</span></a>
          <a class="btn btn-secondary" href={CCC_PORTFOLIO} target="_blank" rel="noopener">Portfolio <span aria-hidden="true">&#8599;</span></a>
        </div>
      </div>
    </section>
  </div>

  <!-- Contact Modal -->
  <CccInquiryModal />
</BaseLayout>

<style>
  /* CCC-02: Route-scoped proportional unit (--ccc-u) and continuous wide-screen geometry.
     Preserves exact 1512px laptop geometry (--ccc-u: 1px) and scales smoothly across
     1919 -> 1920 -> 2560 -> 3840 without any abrupt 1920px root-font jump or container shrink. */
  .ccc-route {
    --ccc-font-display: 'Cinzel', Georgia, 'Times New Roman', serif;
    --ccc-font-accent: 'Bodoni Moda', Georgia, 'Times New Roman', serif;
    --ccc-font-serif: 'Newsreader', Georgia, 'Times New Roman', serif;
    --ccc-font-mono: 'JetBrains Mono', ui-monospace, 'SF Mono', monospace;
    --ccc-gold: #c9a96e;
    --ccc-gold-light: #e5cb9e;
    --ccc-gold-dim: rgba(201, 169, 110, 0.4);
    --ccc-cream: #fbf7f0;
    --ccc-cream-soft: #ede7dc;
    --ccc-cream-dim: #d8d0c2;
    --ccc-muted: #9e9689;

    --ccc-u: 1px;
    --page-max: min(94vw, 3600px);
    --maxw: var(--page-max);
  }

  @media (min-width: 1512px) {
    .ccc-route {
      --ccc-u: clamp(1px, calc(100vw / 1512), 2.54px);
    }
  }

  /* Fixed nav clearance (same as /about). */
  .page-head { height: clamp(4.5rem, 6vw, calc(76 * var(--ccc-u))); }

  .ccc-hero-body {
    text-align: center;
  }
  .ccc-hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: calc(15 * var(--ccc-u));
    transform-origin: center top;
    will-change: transform, opacity;
  }
  .ccc-hero-logo {
    width: clamp(150px, 17.2vw, calc(260 * var(--ccc-u)));
    height: auto;
    transform-origin: center center;
    will-change: transform, opacity;
  }
  .ccc-hero-title {
    margin: calc(9 * var(--ccc-u)) auto 0;
    width: 100%;
    max-width: 100%;
    font-family: var(--ccc-font-display);
    font-size: clamp(0.88rem, 2.54vw, calc(38.4 * var(--ccc-u)));
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--ccc-cream);
    text-align: center;
  }
  .ccc-hero-line {
    display: inline-block;
    white-space: nowrap;
    text-align: center;
  }
  @media (max-width: 480px) {
    .ccc-hero-title {
      font-size: clamp(0.82rem, 4.4vw, 1.35rem);
    }
  }
  .ccc-hero-sub {
    margin: 0;
    font-family: var(--ccc-font-accent);
    font-style: italic;
    font-size: clamp(0.95rem, 1.27vw, calc(19.2 * var(--ccc-u)));
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ccc-gold);
    white-space: nowrap;
  }
  .ccc-actions {
    --ui-u: var(--ccc-u);
    --btn-h-md: calc(44 * var(--ccc-u));
    --btn-px-md: calc(24 * var(--ccc-u));
    --btn-fs-md: calc(12 * var(--ccc-u));
    margin: calc(9 * var(--ccc-u)) auto 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: calc(9 * var(--ccc-u));
    width: 100%;
    max-width: calc(380 * var(--ccc-u));
  }
  .ccc-actions .btn {
    width: 100%;
    min-width: 0;
    padding-inline: calc(12 * var(--ccc-u));
    justify-content: center;
    text-align: center;
    white-space: nowrap;
    box-sizing: border-box;
  }

  .ccc-hero {
    position: relative;
    z-index: 1;
    padding: clamp(3rem, 5.2vw, calc(72 * var(--ccc-u))) 0 clamp(5rem, 7.5vw, calc(96 * var(--ccc-u)));
    text-align: center;
  }

  .ccc-section {
    position: relative;
    padding: clamp(4rem, 6.5vw, calc(84 * var(--ccc-u))) 0;
    margin-top: calc(-1 * clamp(2.5rem, 3.8vw, calc(54 * var(--ccc-u))));
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: clamp(18px, 2vw, calc(28 * var(--ccc-u))) clamp(18px, 2vw, calc(28 * var(--ccc-u))) 0 0;
    background: var(--bg, #080808);
    box-shadow: 0 -30px 65px -10px rgba(0, 0, 0, 0.98), 0 -12px 28px -5px rgba(0, 0, 0, 0.9);
  }

  .ccc-section > .container {
    transform-origin: center top;
    will-change: transform, opacity;
  }

  #why { z-index: 2; }
  #where { z-index: 3; }
  #work { z-index: 4; }
  #video { z-index: 5; }
  #how { z-index: 6; }
  #pricing { z-index: 7; }
  #contact { z-index: 8; }

  /* Section header typography overrides for cinematic elegance */
  .ccc-section :global(.sec-head) {
