---
/**
 * /ccc/: Capture Create Caffeinate.
 * High-impact, visual, low-friction client presentation for hospitality venues.
 *
 * Hero: CCC logo, reduced-size headline ("Content that brings people through your door",
 * max 2 lines), category line, and CTA buttons.
 *
 * Sections:
 *   01 Why it matters
 *   02 Where it goes
 *   03 The work
 *   04 Real nights
 *   05 How it works
 *
 * Pricing: removed from page body, relocated to the "Start a project" inquiry modal.
 *
 * Zero em dashes across all visible copy and markup.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '@andrew/ui/SectionHeader.astro';
import CccPhoto from '../components/ccc/CccPhoto.astro';
import CccInquiryModal from '../components/ccc/CccInquiryModal.astro';
import { Image } from 'astro:assets';
import {
  CCC_DECK,
  CCC_PORTFOLIO,
  CCC_SHOW_VIDEO,
  CCC_REEL_URL,
} from '../data/ccc';

import logo from '../assets/ccc/s01-logo.png';
import whyCoupe from '../assets/ccc/s02-why-1-coupe.jpg';
import whyShelves from '../assets/ccc/s03-why-2-bar-shelves.jpg';
import whereInstagram from '../assets/ccc/s04-where-1-instagram.jpg';
import whereWebsite from '../assets/ccc/s04-where-2-website.jpg';
import whereGoogle from '../assets/ccc/s04-where-3-google.jpg';
import wherePress from '../assets/ccc/s04-where-4-press.jpg';
import drinksPour from '../assets/ccc/s05-work-drinks-1-pour.jpg';
import drinksLineup from '../assets/ccc/s05-work-drinks-2-lineup.jpg';
import drinksMood from '../assets/ccc/s05-work-drinks-3-mood.jpg';
import nightWide from '../assets/ccc/s06-work-night-wide.jpg';
import night1 from '../assets/ccc/s06-work-night-1.jpg';
import night2 from '../assets/ccc/s06-work-night-2.jpg';
import night3 from '../assets/ccc/s06-work-night-3-beer.jpg';
import night4 from '../assets/ccc/s06-work-night-4.jpg';
import workRoom from '../assets/ccc/s07-work-room.jpg';
import workDetail from '../assets/ccc/s07-work-detail.jpg';
import desert1 from '../assets/ccc/s08-video-desert-1-opening.jpg';
import desert2 from '../assets/ccc/s08-video-desert-2-marquee.jpg';
import desert3 from '../assets/ccc/s08-video-desert-3-dj.jpg';
import desert4 from '../assets/ccc/s08-video-desert-4-layback.jpg';
import real1 from '../assets/ccc/s09-video-real-1-pool.jpg';
import real2 from '../assets/ccc/s09-video-real-2-dj.jpg';
import real3 from '../assets/ccc/s09-video-real-3-marios.jpg';
import howCrew from '../assets/ccc/s10-how-crew.jpg';
import howCocktails from '../assets/ccc/s11-how-easy-cocktails.jpg';
import closerBg from '../assets/ccc/s13-closer-bg.jpg';

const where = [
  {
    title: 'Instagram and TikTok',
    line: 'Posts, reels, and stories for weeks',
    img: whereInstagram,
    alt: 'A dark drink topped with a lace tuile on a black napkin, candlelight behind it',
  },
  {
    title: 'Your website',
    line: 'Photos that sell the room',
    img: whereWebsite,
    alt: 'A venue entrance under a striped awning, MAKE in large white letters above it',
  },
  {
    title: 'Google and Yelp',
    line: 'The first thing people see',
    img: whereGoogle,
    alt: 'A red beer in a stemmed tulip glass on a wooden bar top',
  },
  {
    title: 'Press and partners',
    line: 'Ready when someone asks for photos',
    img: wherePress,
    alt: 'Three bottles of spirits lit on a white shelf',
  },
];

const drinks = [
  { cap: 'The pour', img: drinksPour, alt: 'Two cocktails on a bar top, one dark red and one glowing orange' },
  { cap: 'The lineup', img: drinksLineup, alt: 'Three dark cocktails with orange peel lined up on the bar' },
  { cap: 'The mood', img: drinksMood, alt: 'A stemmed glass in black and white against soft blurred light' },
];

const nightTiles = [
  { img: night1, alt: 'A tall glass with a pale drink in warm candlelight' },
  { img: night2, alt: 'Two cocktails on the bar with warm orange light behind them' },
  { img: night3, alt: 'A red beer in a stemmed glass, close up' },
  { img: night4, alt: 'Cocktails with orange peel on the bar, a bartender at work behind them' },
];

const desert = [
  { cap: 'The opening shot', img: desert1, alt: 'A desert hotel pool with palm trees and mountains behind, titled Spirit of Hospitality' },
  { cap: 'The marquee', img: desert2, alt: 'The Ace Hotel and Swim Club marquee announcing Desert Escape 2026' },
  { cap: 'The DJ', img: desert3, alt: 'A DJ at the decks in front of a wood-slat wall at the Ace Hotel and Swim Club' },
  { cap: 'The layback', img: desert4, alt: 'Guests laughing together in front of an Angeleno booth' },
];

const real = [
  { img: real1, alt: 'A crowd around a hotel pool under yellow Topo Chico umbrellas' },
  { img: real2, alt: 'A DJ in a patterned shirt at the decks, captioned This guy can dance' },
  { img: real3, alt: "A Mario's Hard Espresso table with a Nitro Espresso Martini sign" },
];

const steps = [
  { n: '01', title: 'A quick call', body: 'We talk through what you want to show off: the menu, the room, the people, anything new.' },
  { n: '02', title: 'Drinks and food first', body: "I shoot your best items while they're fresh, before service picks up." },
  { n: '03', title: 'Then the night', body: 'Guests, crew, and atmosphere as service happens. I stay small and out of the way.' },
  { n: '04', title: 'Ready to post', body: '15 selects the next day so you can post right away. The full gallery follows within a week.' },
];

const easy = [
  { title: 'Small footprint', body: "A light kit that stays out of your guests' way. No blocking the floor during service." },
  { title: 'Every good shot', body: "No cap on photos. If it's a keeper, it gets edited and it's yours." },
  { title: 'Sized to post', body: 'Delivered ready for your feed, stories, website, and Google listing.' },
  { title: 'Next-day selects', body: '15 selects the next day, so you can post while the night is fresh. The full gallery within a week.' },
];
---

<BaseLayout
  title="Capture Create Caffeinate · HEY_THISISANDREW"
  description="Photo and video for bars, restaurants, and events. One shoot, everywhere you post."
  image="/ccc/og.jpg"
>
  <div class="page-head" aria-hidden="true"></div>

  <!-- 1. Hero: Logo + Headline reduced to max 2 lines + Category line + CTAs (no image in hero) -->
  <section class="ccc-hero" aria-labelledby="ccc-title">
    <div class="container ccc-hero-inner">
      <Image
        src={logo}
        alt="Capture Create Caffeinate logo"
        width={240}
        densities={[1, 2]}
        class="ccc-hero-logo"
        loading="eager"
        fetchpriority="high"
      />
      <h1 id="ccc-title" class="ccc-hero-title">Content that brings people through your door</h1>
      <p class="ccc-hero-sub font-mono">Bars · Restaurants · Events</p>
      <div class="ccc-actions btn-group">
        <button type="button" class="btn btn-primary" data-open-ccc-modal>
          Start a project <span aria-hidden="true">&rarr;</span>
        </button>
        <a class="btn btn-secondary" href={CCC_DECK.href} download>
          {CCC_DECK.label} <span aria-hidden="true">&darr;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 01 Why it matters -->
  <section id="why" class="ccc-section" aria-labelledby="ccc-why">
    <div class="container">
      <SectionHeader id="ccc-why" index="01" kicker="Why it matters" title="People decide with their eyes" />
      <div class="ccc-split">
        <div class="ccc-split-media">
          <CccPhoto
            src={whyCoupe}
            alt="A coupe cocktail glass on a dark bar, warm light glowing behind it"
            sizes="(min-width: 900px) 45vw, 100vw"
            eager
          />
        </div>
        <div class="ccc-split-copy">
          <p>Before anyone books a table, they've already scrolled your feed, your Google listing, and every post you've been tagged in. If the photos don't look like the night you actually deliver, you lose them before they ever walk in.</p>
        </div>
      </div>
      <div class="ccc-split is-flip">
        <div class="ccc-split-media">
          <CccPhoto
            src={whyShelves}
            alt="Bar shelves of bottles and records under glowing copper pendant lights, a reel-to-reel deck in front"
            sizes="(min-width: 900px) 45vw, 100vw"
          />
        </div>
        <div class="ccc-split-copy">
          <h3 class="ccc-subtitle">You're busy running the place</h3>
          <p>Nobody behind the bar has time to stop and shoot the pour, the room at 9pm, or the crew in the middle of a rush. That's my job. I come in, stay out of the way, and catch the good stuff your guests already love.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 02 Where it goes -->
  <section id="where" class="ccc-section" aria-labelledby="ccc-where">
    <div class="container">
      <SectionHeader id="ccc-where" index="02" kicker="Where it goes" title="One shoot, everywhere you post" />
      <ul class="ccc-cards4" role="list">
        {where.map((w) => (
          <li class="ccc-card">
            <div class="ccc-card-media">
              <CccPhoto src={w.img} alt={w.alt} sizes="(min-width: 900px) 22vw, 46vw" />
            </div>
            <h3 class="ccc-card-title">{w.title}</h3>
            <p class="ccc-card-line">{w.line}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 03 The work -->
  <section id="work" class="ccc-section" aria-labelledby="ccc-work">
    <div class="container">
      <SectionHeader id="ccc-work" index="03" kicker="The work" title="Drinks people want to order" />
      <ul class="ccc-grid3" role="list">
        {drinks.map((d) => (
          <li>
            <figure class="ccc-fig">
              <CccPhoto src={d.img} alt={d.alt} sizes="(min-width: 900px) 30vw, 100vw" />
              <figcaption>{d.cap}</figcaption>
            </figure>
          </li>
        ))}
      </ul>

      <div class="ccc-night">
        <div class="ccc-mosaic">
          <div class="ccc-mosaic-wide">
            <CccPhoto src={nightWide} alt="A drink being poured into a glass, close up" sizes="(min-width: 900px) 55vw, 100vw" />
          </div>
          {nightTiles.map((t) => (
            <div class="ccc-mosaic-tile">
              <CccPhoto src={t.img} alt={t.alt} sizes="(min-width: 900px) 14vw, 48vw" />
            </div>
          ))}
        </div>
      </div>

      <h3 class="ccc-subtitle ccc-subtitle--spaced">The room and the details</h3>
      <div class="ccc-room">
        <figure class="ccc-fig ccc-room-wide">
          <CccPhoto src={workRoom} alt="A warm wood-panelled bar room under glowing pendant lights" sizes="(min-width: 900px) 62vw, 100vw" />
          <figcaption>The room</figcaption>
        </figure>
        <figure class="ccc-fig">
          <CccPhoto src={workDetail} alt="A hand setting a garnish on a dark drink topped with a lace tuile" sizes="(min-width: 900px) 34vw, 100vw" />
          <figcaption>The detail</figcaption>
        </figure>
      </div>

      <p class="ccc-credit">Photographs by Andrew Baxter. Shot for Capture Create Caffeinate.</p>
    </div>
  </section>

  <!-- 04 Real nights -->
  {CCC_SHOW_VIDEO && (
    <section id="video" class="ccc-section" aria-labelledby="ccc-video">
      <div class="container">
        <SectionHeader id="ccc-video" index="04" kicker="Video" title="Desert Escape, shot by shot" />
        <ul class="ccc-grid4" role="list">
          {desert.map((d) => (
            <li>
              <figure class="ccc-fig ccc-fig--wide">
                <CccPhoto src={d.img} alt={d.alt} sizes="(min-width: 900px) 22vw, 46vw" />
                <figcaption>{d.cap}</figcaption>
              </figure>
            </li>
          ))}
        </ul>

        <div class="ccc-real">
          <div class="ccc-real-copy">
            <h3 class="ccc-subtitle">Real nights, nothing staged</h3>
            <p>I move through the room like a guest would, so the reel carries the pace and sound of a real night.</p>
            <ul class="ccc-dotlist" role="list">
              <li>The crowd</li>
              <li>The pour</li>
              <li>The brands behind the bar</li>
            </ul>
            {CCC_REEL_URL && (
              <a class="btn btn-ghost ccc-reel-link" href={CCC_REEL_URL} target="_blank" rel="noopener">
                Watch the reel <span aria-hidden="true">&#8599;</span>
              </a>
            )}
          </div>
          <div class="ccc-real-frames">
            <div class="ccc-real-main">
              <CccPhoto src={real[0].img} alt={real[0].alt} sizes="(min-width: 900px) 50vw, 100vw" />
            </div>
            <div>
              <CccPhoto src={real[1].img} alt={real[1].alt} sizes="(min-width: 900px) 25vw, 50vw" />
            </div>
            <div>
              <CccPhoto src={real[2].img} alt={real[2].alt} sizes="(min-width: 900px) 25vw, 50vw" />
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- 05 How it works -->
  <section id="how" class="ccc-section" aria-labelledby="ccc-how">
    <div class="container">
      <SectionHeader id="ccc-how" index="05" kicker="How it works" title="Four hours, no disruption" />
      <div class="ccc-split">
        <div class="ccc-split-media">
          <CccPhoto src={howCrew} alt="Kitchen crew at work at the pass of a busy restaurant" sizes="(min-width: 900px) 40vw, 100vw" />
        </div>
        <ol class="ccc-steps">
          {steps.map((s) => (
            <li>
              <span class="ccc-step-n" aria-hidden="true">{s.n}</span>
              <div>
                <h3 class="ccc-step-title">{s.title}</h3>
                <p>{s.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>

      <h3 class="ccc-subtitle ccc-subtitle--spaced">Easy on your end</h3>
      <div class="ccc-split is-flip">
        <div class="ccc-split-media">
          <CccPhoto src={howCocktails} alt="A bartender setting two cocktails down on a bar mat" sizes="(min-width: 900px) 40vw, 100vw" />
        </div>
        <ul class="ccc-easy" role="list">
          {easy.map((e) => (
            <li class="ccc-easy-card">
              <h4 class="ccc-step-title">{e.title}</h4>
              <p>{e.body}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Closer (slide 13): No pricing on page -->
  <section id="contact" class="ccc-closer" aria-labelledby="ccc-closer">
    <div class="ccc-closer-bg" aria-hidden="true">
      <CccPhoto src={closerBg} alt="" sizes="100vw" />
    </div>
    <div class="container ccc-closer-inner">
      <Image src={logo} alt="Capture Create Caffeinate logo" width={150} densities={[1, 2]} class="ccc-closer-logo" />
      <p class="ccc-closer-eyebrow">Let's get you on the calendar</p>
      <h2 id="ccc-closer" class="ccc-closer-title">Show people what they're missing</h2>
      <p class="ccc-closer-body">One shoot. Weeks of content. A better reason for people to come see you.</p>
      <div class="ccc-actions btn-group">
        <button type="button" class="btn btn-primary" data-open-ccc-modal>
          Start a project <span aria-hidden="true">&rarr;</span>
        </button>
        <a class="btn btn-secondary" href={CCC_DECK.href} download>
          {CCC_DECK.label} <span aria-hidden="true">&darr;</span>
        </a>
        <a class="btn btn-secondary" href={CCC_PORTFOLIO} target="_blank" rel="noopener">
          Portfolio <span aria-hidden="true">&#8599;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Start a Project Modal -->
  <CccInquiryModal />
</BaseLayout>

<style>
  /* Fixed nav clearance */
  .page-head {
    height: clamp(4.5rem, 8vw, 6rem);
  }

  /* Hero: Logo + Headline reduced to max 2 lines + Category line */
  .ccc-hero {
    padding: clamp(2.5rem, 6vw, 4.5rem) 0 clamp(3rem, 7vw, 5.5rem);
    text-align: center;
  }
  .ccc-hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
  }
  .ccc-hero-logo {
    width: clamp(160px, 28vw, 250px);
    height: auto;
  }
  .ccc-hero-title {
    margin: 0.25rem 0 0;
    max-width: 26ch;
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 2.5vw, 1.55rem);
    font-weight: 700;
    line-height: 1.25;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .ccc-hero-sub {
    margin: 0;
    font-size: 0.76rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .ccc-actions {
    margin: 0.75rem auto 0;
  }

  /* Standard Sections */
  .ccc-section {
    padding: clamp(3.5rem, 8vw, 6.5rem) 0;
    border-top: 1px solid var(--line);
  }
  .ccc-section :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .ccc-subtitle {
    margin: 0 0 1rem;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.6vw, 1.9rem);
    font-weight: 800;
    line-height: 1.1;
    text-transform: uppercase;
    color: var(--ink);
  }
  .ccc-subtitle--spaced {
    margin-top: clamp(3rem, 6vw, 5rem);
  }
  @media (max-width: 480px) {
    .ccc-section :global(.sec-head .section-title) {
      font-size: 4.8vw;
    }
    .ccc-hero-title {
      font-size: clamp(1.1rem, 4.8vw, 1.35rem);
    }
    .ccc-closer-title {
      font-size: 7.6vw;
    }
  }
  .ccc-section p {
    color: var(--text, #d6d6d6);
    line-height: 1.7;
  }

  /* Image and copy side by side */
  .ccc-split {
    display: grid;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
  }
  .ccc-split-copy p {
    margin: 0;
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    max-width: 52ch;
  }
  @media (min-width: 900px) {
    .ccc-split {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      grid-template-areas: 'media copy';
    }
    .ccc-split.is-flip {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      grid-template-areas: 'copy media';
    }
    .ccc-split > :first-child {
      grid-area: media;
    }
    .ccc-split > :last-child {
      grid-area: copy;
    }
  }
  .ccc-split-media {
    max-width: 520px;
    width: 100%;
    justify-self: center;
  }

  /* 02 Where it goes: 2x2 on phones, 4 across on desktop */
  .ccc-cards4,
  .ccc-grid3,
  .ccc-grid4,
  .ccc-easy,
  .ccc-steps,
  .ccc-dotlist {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .ccc-cards4 {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(0.75rem, 2vw, 1.5rem);
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
  }
  @media (min-width: 900px) {
    .ccc-cards4 {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .ccc-card-media {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: #0d0d0d;
  }
  .ccc-card-media :global(img) {
    height: 100%;
    object-fit: cover;
  }
  .ccc-card-title {
    margin: 0.9rem 0 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .ccc-card-line {
    margin: 0;
    font-size: 0.92rem;
  }

  /* 03 The work */
  .ccc-grid3 {
    display: grid;
    gap: clamp(0.75rem, 2vw, 1.5rem);
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
  }
  @media (min-width: 640px) {
    .ccc-grid3 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .ccc-fig {
    margin: 0;
  }
  .ccc-fig figcaption {
    margin-top: 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .ccc-dotlist {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0;
  }
  .ccc-dotlist li {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .ccc-dotlist li:not(:last-child)::after {
    content: '·';
    margin: 0 0.6rem;
    color: var(--muted);
  }

  .ccc-night {
    margin-top: clamp(3rem, 6vw, 5rem);
  }
  .ccc-mosaic {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(0.5rem, 1.2vw, 0.9rem);
  }
  @media (min-width: 640px) {
    .ccc-mosaic {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .ccc-mosaic-wide {
    grid-column: 1 / -1;
  }
  .ccc-mosaic-tile {
    aspect-ratio: 252 / 464;
    overflow: hidden;
  }
  .ccc-mosaic-tile :global(img) {
    height: 100%;
    object-fit: cover;
  }

  .ccc-room {
    display: grid;
    gap: clamp(0.75rem, 2vw, 1.5rem);
  }
  @media (min-width: 900px) {
    .ccc-room {
      grid-template-columns: minmax(0, 1.75fr) minmax(0, 1fr);
      align-items: start;
    }
  }
  .ccc-credit {
    margin: clamp(2rem, 4vw, 3rem) 0 0;
    font-size: 0.82rem;
    color: var(--muted) !important;
  }

  /* 04 Video / Real nights */
  .ccc-grid4 {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(0.75rem, 2vw, 1.25rem);
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
  }
  @media (min-width: 900px) {
    .ccc-grid4 {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .ccc-fig--wide :global(img) {
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .ccc-real {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    margin-top: clamp(3rem, 6vw, 5rem);
    align-items: center;
  }
  @media (min-width: 900px) {
    .ccc-real {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    }
  }
  .ccc-real-copy p {
    margin: 0 0 1rem;
    max-width: 46ch;
  }
  .ccc-reel-link {
    margin-top: 1.25rem;
  }
  .ccc-real-frames {
    display: grid;
