<script>
  function initCccCollapsible() {
    document.querySelectorAll<HTMLButtonElement>('[data-ccc-toggle]').forEach((btn) => {
      if (btn.dataset.wired === '1') return;
      btn.dataset.wired = '1';

      btn.addEventListener('click', () => {
        const sec = btn.closest('.ccc-collapsible');
        if (!sec) return;
        const bodyId = btn.getAttribute('aria-controls');
        const body = bodyId ? document.getElementById(bodyId) : sec.querySelector('.ccc-section-body');

        const isOpen = sec.classList.toggle('is-open');
        btn.setAttribute('aria-expanded', String(isOpen));

        if (body) {
          if (isOpen) {
            body.removeAttribute('inert');
          } else {
            body.setAttribute('inert', '');
          }
        }
      });
    });
  }

  function initHeroParallax() {
    const heroSection = document.getElementById('hero');
    const heroLogo = document.querySelector<HTMLElement>('.ccc-hero-logo');
    if (!heroSection || !heroLogo) return;

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      heroSection.style.setProperty('--hero-scroll-progress', '1');
      return;
    }

    let ticking = false;
    function onScroll() {
      if (!heroSection) return;
      if (!heroSection.classList.contains('is-open')) return;

      const scrollY = window.scrollY;
      const range = 240;
      const progress = Math.min(1, Math.max(0, scrollY / range));

      heroSection.style.setProperty('--hero-scroll-progress', progress.toFixed(3));

      if (heroLogo) {
        heroLogo.style.opacity = (1 - progress).toFixed(3);
        heroLogo.style.transform = `translate3d(0, -${(progress * 50).toFixed(1)}px, 0) scale(${(1 - progress * 0.35).toFixed(3)})`;
      }

      ticking = false;
    }

    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(onScroll);
        ticking = true;
      }
    }, { passive: true });

    onScroll();
  }

  function init() {
    initCccCollapsible();
    initHeroParallax();
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>
