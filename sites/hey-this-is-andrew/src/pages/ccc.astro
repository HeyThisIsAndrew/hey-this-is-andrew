  .ccc-closer {
    position: relative;
    min-height: calc(100vh - var(--nav-bar-h, 76px) - 200px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(6rem, 9.5vw, calc(144 * var(--ccc-u))) 0;
    margin-top: calc(-1 * clamp(2.5rem, 3.8vw, calc(54 * var(--ccc-u))));
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: clamp(18px, 2vw, calc(28 * var(--ccc-u))) clamp(18px, 2vw, calc(28 * var(--ccc-u))) 0 0;
    box-shadow: 0 -30px 65px -10px rgba(0, 0, 0, 0.98), 0 -12px 28px -5px rgba(0, 0, 0, 0.9);
    text-align: center;
    isolation: isolate;
    overflow: hidden;
  }
  .ccc-closer-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
  }
  .ccc-closer-bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform-origin: center center;
    will-change: transform;
    transition: transform 0.15s ease-out;
  }
  .ccc-closer-bg::after { content: ''; position: absolute; inset: 0; background: rgba(0, 0, 0, 0.72); }
  .ccc-closer-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: calc(11 * var(--ccc-u));
    transform-origin: center center;
    will-change: transform;
    transition: transform 0.15s ease-out;
  }
  .ccc-closer-logo {
    width: clamp(100px, 10vw, calc(150 * var(--ccc-u))) !important;
    max-width: calc(150 * var(--ccc-u));
    height: auto;
    transform-origin: center center;
    will-change: transform;
    transition: transform 0.15s ease-out;
  }
  .ccc-closer-eyebrow {
    margin: calc(6 * var(--ccc-u)) 0 0;
    font-family: var(--ccc-font-mono);
    font-size: clamp(0.75rem, 0.65vw, calc(9.6 * var(--ccc-u)));
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--ccc-gold);
  }
  .ccc-closer-title {
    margin: 0;
    max-width: 18ch;
    font-family: var(--ccc-font-display);
    font-size: clamp(2.2rem, 3.5vw, calc(52.8 * var(--ccc-u)));
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--ccc-cream);
    transform-origin: center center;
    will-change: transform;
  }
  .ccc-closer-body {
    margin: 0;
    max-width: 44ch;
    font-family: var(--ccc-font-serif);
    font-size: clamp(1.35rem, 1.55vw, calc(23.4 * var(--ccc-u)));
    line-height: 1.6;
    color: var(--ccc-cream-soft);
  }
  .ccc-closer-price {
    margin: 0;
    font-family: var(--ccc-font-display);
    font-style: italic;
    font-size: clamp(1.1rem, 1.15vw, calc(16.8 * var(--ccc-u)));
    letter-spacing: 0.1em;
    color: var(--ccc-gold-light);
  }

  @media (max-width: 900px) {
    .ccc-closer {
      min-height: 100svh;
      padding: clamp(3.5rem, 8vw, 5rem) 1.25rem clamp(4rem, 10vw, 6rem);
      box-sizing: border-box;
    }
    .ccc-closer-title {
      font-size: clamp(2rem, 7.5vw, 3.2rem);
    }
    .ccc-closer-body {
      font-size: clamp(1.2rem, 4.2vw, 1.55rem);
      max-width: 32ch;
    }
    .ccc-closer-price {
      font-size: clamp(0.95rem, 3.4vw, 1.2rem);
    }
    .ccc-closer .ccc-actions {
      margin: 0.85rem auto 0;
    }
  }

  @media (orientation: landscape) and (max-height: 600px) {
    .ccc-closer {
      min-height: 100svh;
      padding: 2rem 1.5rem 2.5rem;
    }
    .ccc-closer-logo {
      width: clamp(65px, 10vw, 90px) !important;
    }
    .ccc-closer-title {
      font-size: clamp(1.5rem, 4.5vw, 2.2rem);
    }
    .ccc-closer-body {
      font-size: clamp(0.95rem, 2.4vw, 1.15rem);
      max-width: 44ch;
    }
    .ccc-closer-price {
      font-size: 0.8rem;
    }
  }
</style>

<script>
  function pageTop(el: HTMLElement): number {
    let y = 0;
    for (let n: HTMLElement | null = el; n; n = n.offsetParent as HTMLElement | null) {
      y += n.offsetTop;
    }
    return y;
  }

  function initPinnedScrollStack() {
    const stack = document.getElementById('ccc-pinned-stack');
    if (!stack || stack.dataset.cccStackWired === '1') return;
    stack.dataset.cccStackWired = '1';

    const heroSection = document.getElementById('hero');
    const heroInner = heroSection?.querySelector<HTMLElement>('.ccc-hero-inner') ?? null;
    const heroBigLogo = heroSection?.querySelector<HTMLElement>('.ccc-hero-logo') ?? null;
    const heroActions = heroSection?.querySelector<HTMLElement>('.ccc-actions') ?? null;
    const heroDockRow = stack.querySelector<HTMLElement>('.ccc-dock-row[data-target="hero"]');
    const heroBtn = stack.querySelector<HTMLButtonElement>('.ccc-dock-btn--hero');

    const closerSection = document.getElementById('contact');
    const closerInner = closerSection?.querySelector<HTMLElement>('.ccc-closer-inner') ?? null;
    const closerLogo = closerSection?.querySelector<HTMLElement>('.ccc-closer-logo') ?? null;
    const closerTitle = closerSection?.querySelector<HTMLElement>('.ccc-closer-title') ?? null;
    const closerBgImg = closerSection?.querySelector<HTMLElement>('.ccc-closer-bg img') ?? null;

    // Section 01 elements (independent pair subjects)
    const whyTop = document.getElementById('ccc-why-top');
    const whyTopMedia = whyTop?.querySelector<HTMLElement>('.ccc-why-media') ?? null;
    const whyTopCopy = whyTop?.querySelector<HTMLElement>('.ccc-why-copy') ?? null;
    const whyBottom = document.getElementById('ccc-why-bottom');
    const whyBottomMedia = whyBottom?.querySelector<HTMLElement>('.ccc-why-media') ?? null;
    const whyBottomCopy = whyBottom?.querySelector<HTMLElement>('.ccc-why-copy') ?? null;

    // Section 02 elements (grid wrapper as subject)
    const whereGrid = document.getElementById('ccc-where-grid');
    const whereCards = Array.from(document.querySelectorAll<HTMLElement>('#ccc-where-grid .ccc-card'));

    // Section 03 elements (independent trio, mosaic, and room subjects)
    const workTrio = document.getElementById('ccc-work-trio');
    const workItems = Array.from(document.querySelectorAll<HTMLElement>('#ccc-work-trio .ccc-work-item'));
    const workNight = document.getElementById('ccc-work-night');
    const workTiles = Array.from(document.querySelectorAll<HTMLElement>('#ccc-work-night .ccc-mosaic-tile'));
    const workRoom = document.getElementById('ccc-work-room');
    const workRoomWide = document.querySelector<HTMLElement>('#ccc-work-room .ccc-room-wide');
    const workRoomDetail = document.querySelector<HTMLElement>('#ccc-work-room .ccc-room-detail');

    // Consecutive sections for card-stacking overlap parallax (animated on inner .container so section box stays in normal flow)
    const allSectionIds = ['why', 'where', 'work', 'video', 'how', 'pricing', 'contact'];
    const allSections = allSectionIds
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => !!el)
      .map((sec) => ({
        sec,
        inner: sec.querySelector<HTMLElement>(':scope > .container'),
        head: sec.querySelector<HTMLElement>('.sec-head, .ccc-closer-inner'),
      }));

    const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');

    function setDockInteractive(interactive: boolean) {
      if (!heroDockRow || !heroBtn) return;
      if (interactive) {
        heroDockRow.removeAttribute('inert');
        heroBtn.removeAttribute('tabindex');
      } else {
        // If focus was inside the dock when it hides/dismisses, move focus to a sensible visible destination
        if (stack.contains(document.activeElement)) {
          const fallback =
            closerSection && closerSection.getBoundingClientRect().top < window.innerHeight * 0.85
              ? closerSection.querySelector<HTMLElement>('a, button')
              : heroSection?.querySelector<HTMLElement>('a, button');
          (fallback ?? document.querySelector<HTMLElement>('.site-nav a'))?.focus({ preventScroll: true });
        }
        heroDockRow.setAttribute('inert', '');
        heroBtn.setAttribute('tabindex', '-1');
      }
    }

    if (heroBtn) {
      heroBtn.addEventListener('click', () => {
        if (motionQuery.matches) {
          const html = document.documentElement;
          const prev = html.style.scrollBehavior;
          html.style.scrollBehavior = 'auto';
          window.scrollTo(0, 0);
          html.style.scrollBehavior = prev;
        } else {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }
      });
    }

    function clearVisualStyles() {
      if (heroBigLogo) {
        heroBigLogo.style.opacity = '';
        heroBigLogo.style.transform = '';
      }
      if (heroInner) {
        heroInner.style.opacity = '';
        heroInner.style.transform = '';
      }
      allSections.forEach(({ sec, inner }) => {
        sec.style.transform = '';
        sec.style.opacity = '';
        if (inner) {
          inner.style.transform = '';
          inner.style.opacity = '';
        }
      });
      [whyTopMedia, whyTopCopy, whyBottomMedia, whyBottomCopy, workRoomWide, workRoomDetail, closerLogo, closerTitle, closerInner, closerBgImg].forEach((el) => {
        if (el) {
          el.style.transform = '';
          el.style.opacity = '';
        }
      });
      whereCards.forEach((c) => {
        c.style.transform = '';
        c.style.opacity = '';
      });
      workItems.forEach((item) => {
        item.style.transform = '';
      });
      workTiles.forEach((tile) => {
        tile.style.transform = '';
      });
    }

    let ticking = false;

    function updateFrame() {
      ticking = false;
      const scrollY = window.scrollY;
      const winW = window.innerWidth;
      const winH = window.innerHeight;
      const prefersReducedMotion = motionQuery.matches;

      // ─── PHASE 1: GEOMETRY READS (Normal-flow anchors only) ─────────────────
      const navEl = document.querySelector<HTMLElement>('.site-nav');
      const navH = navEl ? navEl.offsetHeight : (parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--nav-bar-h')) || 76);

      // Stable dock bar target height without reading mid-transition offsetHeight
      const isLandscapeShort = winH <= 560 || (winW > winH && winH <= 620);
      const scaleU = winW >= 1512 ? Math.min(2.54, winW / 1512) : 1;
      const targetDockH = isLandscapeShort ? 38 : (winW <= 640 ? 46 : Math.round(52 * scaleU));

      // Hero handoff geometry: compute from stable layout offset of hero actions / hero bottom
      const heroTopDoc = heroSection ? pageTop(heroSection) : 0;
      const heroH = heroSection ? heroSection.offsetHeight : 600;
      const actionsBottomDoc = heroActions ? pageTop(heroActions) + heroActions.offsetHeight : heroTopDoc + heroH * 0.78;
      // Keep copy & actions 100% readable while in view; fade only as the action row approaches the header
      const fadeStartScroll = Math.max(40, actionsBottomDoc - navH - Math.min(winH * 0.32, 260));
      const handoffScroll = Math.max(fadeStartScroll + 80, actionsBottomDoc - navH - 24);

      const isDocked = scrollY >= handoffScroll;
      const activeDockH = isDocked ? targetDockH : 0;
      const dockBottom = navH + activeDockH;

      // Read normal-flow section positions
      const sectionGeometries = allSections.map(({ sec, inner, head }) => {
        const secTop = pageTop(sec) - scrollY;
        const secBottom = secTop + sec.offsetHeight;
        const headTop = head ? pageTop(head) - scrollY : secTop;
        return { sec, inner, secTop, secBottom, headTop };
      });

      const closerGeo = sectionGeometries[sectionGeometries.length - 1];
      const closerTop = closerGeo ? closerGeo.secTop : winH * 2;

      // Subject top positions (in viewport coordinates from normal flow)
      const whyTopY = whyTop ? pageTop(whyTop) - scrollY : winH * 2;
      const whyBottomY = whyBottom ? pageTop(whyBottom) - scrollY : winH * 2;
      const whereGridY = whereGrid ? pageTop(whereGrid) - scrollY : winH * 2;
      const workTrioY = workTrio ? pageTop(workTrio) - scrollY : winH * 2;
      const workNightY = workNight ? pageTop(workNight) - scrollY : winH * 2;
      const workRoomY = workRoom ? pageTop(workRoom) - scrollY : winH * 2;

      // Helper for bounded reversible progress: starts when subject enters bottom of viewport (winH * 0.92),
      // settles when subject reaches comfortable reading zone (Math.max(dockBottom + 48, winH * 0.38))
      const subjectProgress = (subjectViewportTop: number) => {
        const enterY = winH * 0.92;
        const settleY = Math.max(dockBottom + 48, winH * 0.38);
        const span = Math.max(1, enterY - settleY);
        return Math.min(1, Math.max(0, (enterY - subjectViewportTop) / span));
      };

      // ─── PHASE 2: VISUAL WRITES ─────────────────────────────────────────────
      // Dock state & closer push-up
      const closerStartTrigger = winH * 0.85;
      const closerPushRange = Math.max(1, winH * 0.45);
      const closerPushRaw = closerTop < closerStartTrigger ? (closerStartTrigger - closerTop) / closerPushRange : 0;
      const closerPushProgress = Math.min(1, Math.max(0, closerPushRaw));
      const isDockDismissed = closerPushProgress > 0.15;

      if (heroDockRow) {
        heroDockRow.classList.toggle('is-docked', isDocked);
      }
      stack.classList.toggle('is-dismissed', isDockDismissed);
      setDockInteractive(isDocked && !isDockDismissed);

      if (prefersReducedMotion) {
        clearVisualStyles();
        // Discrete dock visibility in reduced motion
        stack.style.transform = '';
        stack.style.opacity = isDocked && !isDockDismissed ? '1' : '0';
        stack.style.pointerEvents = isDocked && !isDockDismissed ? '' : 'none';
        return;
      }

      // 1. Hero exit animation (starts at fadeStartScroll, completes at handoffScroll)
      const heroProgress = Math.min(
        1,
        Math.max(0, (scrollY - fadeStartScroll) / Math.max(1, handoffScroll - fadeStartScroll))
      );
      if (heroBigLogo) {
        heroBigLogo.style.opacity = (1 - heroProgress).toFixed(3);
        heroBigLogo.style.transform = `translate3d(0, -${(heroProgress * 32).toFixed(1)}px, 0) scale(${(1 - heroProgress * 0.18).toFixed(3)})`;
      }
      if (heroInner) {
        heroInner.style.opacity = (1 - heroProgress * 0.82).toFixed(3);
      }

      // 2. Closer push-up on the pinned dock bar
      if (closerPushProgress > 0) {
        const eased = 1 - Math.pow(1 - closerPushProgress, 3);
        const pushY = eased * (activeDockH + navH + 20);
        stack.style.transform = `translate3d(0, -${pushY.toFixed(1)}px, 0)`;
        const fadeProgress = Math.min(1, Math.max(0, closerPushProgress / 0.85));
        const opacity = 1 - Math.pow(fadeProgress, 1.4);
        stack.style.opacity = Math.max(0, opacity).toFixed(3);
        stack.style.pointerEvents = isDockDismissed ? 'none' : '';
      } else {
        stack.style.transform = '';
        stack.style.opacity = '1';
        stack.style.pointerEvents = '';
      }

      // 3. Consecutive section card-stacking overlap (applied to inner .container so section box never shifts)
      for (let i = 0; i < sectionGeometries.length - 1; i++) {
        const curr = sectionGeometries[i];
        const next = sectionGeometries[i + 1];
        if (!curr.inner) continue;

        if (curr.headTop >= dockBottom - 4) {
          curr.inner.style.transform = '';
          curr.inner.style.opacity = '1';
          continue;
        }

        const overlapStart = winH * 0.85;
        const overlapRange = Math.max(1, overlapStart - dockBottom);
        if (next.secTop < overlapStart && next.secBottom > dockBottom) {
          const progress = Math.min(1, Math.max(0, (overlapStart - next.secTop) / overlapRange));
          const scale = 1 - progress * 0.04;
          const opacity = 1 - progress * 0.55;
          const driftY = progress * 20;
          curr.inner.style.transform = `translate3d(0, -${driftY.toFixed(1)}px, 0) scale(${scale.toFixed(3)})`;
          curr.inner.style.opacity = Math.max(0.35, opacity).toFixed(3);
        } else if (next.secTop >= overlapStart) {
          curr.inner.style.transform = '';
          curr.inner.style.opacity = '1';
        } else {
          curr.inner.style.transform = 'translate3d(0, -20px, 0) scale(0.96)';
          curr.inner.style.opacity = '0.45';
        }
      }

      // 4. Section 01 (Why it matters): Independent progress per pair
      const pWhyTop = subjectProgress(whyTopY);
      if (whyTopMedia) {
        const imgScale = 0.92 + pWhyTop * 0.08;
        const imgShiftX = (1 - pWhyTop) * 32;
        whyTopMedia.style.transform = `translate3d(-${imgShiftX.toFixed(1)}px, 0, 0) scale(${imgScale.toFixed(3)})`;
      }
      if (whyTopCopy) {
        const textScale = 0.96 + pWhyTop * 0.04;
        const textShiftX = (1 - pWhyTop) * 24;
        const textOpacity = 0.45 + pWhyTop * 0.55;
        whyTopCopy.style.opacity = textOpacity.toFixed(3);
        whyTopCopy.style.transform = `translate3d(${textShiftX.toFixed(1)}px, 0, 0) scale(${textScale.toFixed(3)})`;
      }

      const pWhyBottom = subjectProgress(whyBottomY);
      if (whyBottomMedia) {
        const imgScale = 0.92 + pWhyBottom * 0.08;
        const imgShiftX = (1 - pWhyBottom) * 32;
        whyBottomMedia.style.transform = `translate3d(${imgShiftX.toFixed(1)}px, 0, 0) scale(${imgScale.toFixed(3)})`;
      }
      if (whyBottomCopy) {
        const textScale = 0.96 + pWhyBottom * 0.04;
        const textShiftX = (1 - pWhyBottom) * 24;
        const textOpacity = 0.45 + pWhyBottom * 0.55;
        whyBottomCopy.style.opacity = textOpacity.toFixed(3);
        whyBottomCopy.style.transform = `translate3d(-${textShiftX.toFixed(1)}px, 0, 0) scale(${textScale.toFixed(3)})`;
      }

      // 5. Section 02 (Where it goes): Fold-out tied to #ccc-where-grid
      if (whereCards.length === 4) {
        const pWhere = subjectProgress(whereGridY);
        const isNarrow = winW < 900;
        const offsets = isNarrow ? [32, -32, 32, -32] : [96, 32, -32, -96];
        const rotations = isNarrow ? [-1.5, 1.5, -1.5, 1.5] : [-2.2, -0.9, 0.9, 2.2];
        const cardScale = 0.90 + pWhere * 0.10;
        const cardOpacity = 0.45 + pWhere * 0.55;

        whereCards.forEach((card, idx) => {
          const currX = (1 - pWhere) * (offsets[idx] || 0);
          const currRot = (1 - pWhere) * (rotations[idx] || 0);
          card.style.transform = `translate3d(${currX.toFixed(1)}px, 0, 0) rotate(${currRot.toFixed(2)}deg) scale(${cardScale.toFixed(3)})`;
          card.style.opacity = cardOpacity.toFixed(3);
        });
      }

      // 6. Section 03 (The work): Independent progress for Trio, Night Mosaic, and Room
      if (workItems.length > 0) {
        const pTrio = subjectProgress(workTrioY);
        const floatOffsets = [24, 44, 18];
        workItems.forEach((item, idx) => {
          const yOffset = (1 - pTrio) * (floatOffsets[idx] || 24);
          item.style.transform = `translate3d(0, ${yOffset.toFixed(1)}px, 0)`;
        });
      }

      if (workTiles.length > 0) {
        const pNight = subjectProgress(workNightY);
        const tileFloats = [18, 32, 14, 28];
        workTiles.forEach((tile, idx) => {
          const yOffset = (1 - pNight) * (tileFloats[idx] || 20);
          tile.style.transform = `translate3d(0, ${yOffset.toFixed(1)}px, 0)`;
        });
      }

      if (workRoomWide || workRoomDetail) {
        const pRoom = subjectProgress(workRoomY);
        if (workRoomWide) {
          const roomScale = 0.95 + pRoom * 0.05;
          workRoomWide.style.transform = `scale(${roomScale.toFixed(3)})`;
        }
        if (workRoomDetail) {
          const detailY = (1 - pRoom) * -20;
          workRoomDetail.style.transform = `translate3d(0, ${detailY.toFixed(1)}px, 0)`;
        }
      }

      // 7. Closer reveal & background crop
      if (closerSection) {
        const enterY = winH;
        const finishY = Math.max(navH + 40, winH * 0.22);
        const closerProgress = Math.min(1, Math.max(0, (enterY - closerTop) / Math.max(1, enterY - finishY)));

        if (closerLogo) {
          const logoScale = 0.88 + closerProgress * 0.16;
          closerLogo.style.transform = `scale(${logoScale.toFixed(3)})`;
        }
        if (closerTitle) {
          const titleScale = 0.92 + closerProgress * 0.08;
          closerTitle.style.transform = `scale(${titleScale.toFixed(3)})`;
        }
        if (closerInner) {
          const translateY = (1 - closerProgress) * 32;
          closerInner.style.transform = `translate3d(0, ${translateY.toFixed(1)}px, 0)`;
        }
        if (closerBgImg) {
          const bgScale = 1.0 + closerProgress * 0.12;
          closerBgImg.style.transform = `scale(${bgScale.toFixed(3)})`;
        }
      }
    }

    const requestUpdate = () => {
      if (!ticking) {
        requestAnimationFrame(updateFrame);
        ticking = true;
      }
    };

    window.addEventListener('scroll', requestUpdate, { passive: true });
    window.addEventListener('resize', requestUpdate, { passive: true });
    window.addEventListener('orientationchange', () => {
      setTimeout(updateFrame, 120);
    }, { passive: true });
    motionQuery.addEventListener('change', updateFrame);

    updateFrame();
  }

  function init() {
    initPinnedScrollStack();
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>
