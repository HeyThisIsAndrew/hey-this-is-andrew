    text-align: left;
    box-sizing: border-box;
    transition: background-color 0.15s ease;
  }

  .ccc-dock-btn:hover {
    background: rgba(255, 255, 255, 0.05);
  }

  .ccc-dock-btn:focus-visible {
    outline: 2px solid var(--focus-ring, #fff);
    outline-offset: -2px;
  }

  .ccc-dock-btn--hero {
