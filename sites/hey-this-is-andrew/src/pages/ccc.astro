<script>
  function pageTop(el: HTMLElement): number {
    let y = 0;
    for (let n: HTMLElement | null = el; n; n = n.offsetParent as HTMLElement | null) {
      y += n.offsetTop;
    }
    return y;
  }

  function initPinnedScrollStack() {
    const stackEl = document.getElementById('ccc-pinned-stack');
    if (!stackEl || stackEl.dataset.cccStackWired === '1') return;
    stackEl.dataset.cccStackWired = '1';
    const stack: HTMLElement = stackEl;

    const heroSection = document.getElementById('hero');
    const heroBigLogo = heroSection?.querySelector<HTMLElement>('.ccc-hero-logo') ?? null;
    const heroPhoto = heroSection?.querySelector<HTMLElement>('.ccc-hero-media img') ?? null;
    const heroActions = heroSection?.querySelector<HTMLElement>('.ccc-actions') ?? null;
    const heroDockRow = stack.querySelector<HTMLElement>('.ccc-dock-row[data-target="hero"]');
    const heroBtn = stack.querySelector<HTMLButtonElement>('.ccc-dock-btn--hero');

    const closerSection = document.getElementById('contact');
    const closerLogo = closerSection?.querySelector<HTMLElement>('.ccc-closer-logo') ?? null;
    const closerTitle = closerSection?.querySelector<HTMLElement>('.ccc-closer-title') ?? null;
    const closerInner = closerSection?.querySelector<HTMLElement>('.ccc-closer-inner') ?? null;
    const closerBgImg = closerSection?.querySelector<HTMLElement>('.ccc-closer-bg img') ?? null;

    // Why it matters elements (independent pair subjects)
    const whyTop = document.getElementById('ccc-why-top');
    const whyTopMedia = whyTop?.querySelector<HTMLElement>('.ccc-why-media') ?? null;
    const whyTopImg = whyTopMedia?.querySelector<HTMLElement>('img') ?? null;
    const whyTopCopy = whyTop?.querySelector<HTMLElement>('.ccc-why-copy') ?? null;
    const whyBottom = document.getElementById('ccc-why-bottom');
    const whyBottomMedia = whyBottom?.querySelector<HTMLElement>('.ccc-why-media') ?? null;
    const whyBottomImg = whyBottomMedia?.querySelector<HTMLElement>('img') ?? null;
    const whyBottomCopy = whyBottom?.querySelector<HTMLElement>('.ccc-why-copy') ?? null;

    // Where it goes elements (grid wrapper as subject)
    const whereGrid = document.getElementById('ccc-where-grid');
    const whereCards = Array.from(document.querySelectorAll<HTMLElement>('#ccc-where-grid .ccc-card'));
    const whereCardImgs = whereCards.map((c) => c.querySelector<HTMLElement>('.ccc-card-media img')).filter(Boolean) as HTMLElement[];

    // The work elements (independent trio, mosaic, and room subjects)
    const workTrio = document.getElementById('ccc-work-trio');
    const workItems = Array.from(document.querySelectorAll<HTMLElement>('#ccc-work-trio .ccc-work-item'));
    const workItemImgs = workItems.map((item) => item.querySelector<HTMLElement>('img')).filter(Boolean) as HTMLElement[];

    const workNight = document.getElementById('ccc-work-night');
    const workNightWideImg = workNight?.querySelector<HTMLElement>('.ccc-mosaic-wide img') ?? null;
    const workTiles = Array.from(document.querySelectorAll<HTMLElement>('#ccc-work-night .ccc-mosaic-tile'));
    const workTileImgs = workTiles.map((tile) => tile.querySelector<HTMLElement>('img')).filter(Boolean) as HTMLElement[];

    const workRoom = document.getElementById('ccc-work-room');
    const workRoomWide = document.querySelector<HTMLElement>('#ccc-work-room .ccc-room-wide');
    const workRoomWideImg = workRoomWide?.querySelector<HTMLElement>('img') ?? null;
    const workRoomDetail = document.querySelector<HTMLElement>('#ccc-work-room .ccc-room-detail');
    const workRoomDetailImg = workRoomDetail?.querySelector<HTMLElement>('img') ?? null;

    // Video elements
    const videoSec = document.getElementById('video');
    const videoDesertImgs = Array.from(document.querySelectorAll<HTMLElement>('#video .ccc-grid4 .ccc-crop img'));
    const videoRealImgs = Array.from(document.querySelectorAll<HTMLElement>('#video .ccc-real-frames img'));

    // How elements
    const howSec = document.getElementById('how');
    const howSplits = Array.from(document.querySelectorAll<HTMLElement>('#how .ccc-split'));
    const howCrewImg = howSplits[0]?.querySelector<HTMLElement>('.ccc-split-media img') ?? null;
    const howCocktailsImg = howSplits[1]?.querySelector<HTMLElement>('.ccc-split-media img') ?? null;

    // Pricing elements
    const pricingSec = document.getElementById('pricing');
    const pricingImg = document.querySelector<HTMLElement>('#pricing .ccc-pricing-media img') ?? null;

    const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    const subjectState = new Map<string, number>();
    const lifecycle = new AbortController();
    const { signal } = lifecycle;
    const html = document.documentElement;
    const priorScrollPadding = html.style.scrollPaddingTop;
    let scrollPadding = '';
    let hadMotion = false;

    // Active IntersectionObserver gating for will-change optimization
    const inViewSections = new Set<string>();
    const sectionMap: Record<string, HTMLElement[]> = {
      hero: [heroPhoto, heroBigLogo].filter(Boolean) as HTMLElement[],
      whyTop: [whyTopMedia, whyTopImg, whyTopCopy].filter(Boolean) as HTMLElement[],
      whyBottom: [whyBottomMedia, whyBottomImg, whyBottomCopy].filter(Boolean) as HTMLElement[],
      where: [...whereCards, ...whereCardImgs],
      workTrio: [...workItems, ...workItemImgs],
      workNight: [workNightWideImg, ...workTiles, ...workTileImgs].filter(Boolean) as HTMLElement[],
      workRoom: [workRoomWide, workRoomWideImg, workRoomDetail, workRoomDetailImg].filter(Boolean) as HTMLElement[],
      video: [...videoDesertImgs, ...videoRealImgs],
      how: [howCrewImg, howCocktailsImg].filter(Boolean) as HTMLElement[],
      pricing: [pricingImg].filter(Boolean) as HTMLElement[],
      closer: [closerBgImg, closerLogo, closerTitle, closerInner].filter(Boolean) as HTMLElement[],
    };

    function setSectionWillChange(key: string, active: boolean) {
      const els = sectionMap[key];
      if (!els) return;
      for (const el of els) {
        el.style.willChange = active ? (el === heroBigLogo ? 'transform, opacity' : 'transform') : '';
      }
    }

    const observerTargets: [string, HTMLElement | null][] = [
      ['hero', heroSection],
      ['whyTop', whyTop],
      ['whyBottom', whyBottom],
      ['where', whereGrid],
      ['workTrio', workTrio],
      ['workNight', workNight],
      ['workRoom', workRoom],
      ['video', videoSec],
      ['how', howSec],
      ['pricing', pricingSec],
      ['closer', closerSection],
    ];

    const io = typeof IntersectionObserver !== 'undefined'
      ? new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              const id = entry.target.getAttribute('data-ccc-motion-id');
              if (!id) continue;
              if (entry.isIntersecting) {
                inViewSections.add(id);
                if (!motionQuery.matches) setSectionWillChange(id, true);
              } else {
                inViewSections.delete(id);
                setSectionWillChange(id, false);
              }
            }
          },
          { rootMargin: '20% 0px 20% 0px' }
        )
      : null;

    observerTargets.forEach(([id, el]) => {
      if (el) {
        el.setAttribute('data-ccc-motion-id', id);
        io?.observe(el);
      }
    });

    function setDockInteractive(interactive: boolean, navBottom = 76) {
      if (!heroDockRow || !heroBtn) return;
      if (interactive === !heroDockRow.hasAttribute('inert')) return;
      if (interactive) {
        heroDockRow.removeAttribute('inert');
        heroBtn.removeAttribute('tabindex');
      } else {
        // If focus was inside the dock when it hides/dismisses, move focus to a sensible visible destination
        if (stack.contains(document.activeElement)) {
          const isVisible = (el: HTMLElement | null | undefined): el is HTMLElement => {
            if (!el) return false;
            const r = el.getBoundingClientRect();
            return r.width > 0 && r.height > 0 && r.top >= navBottom && r.bottom <= window.innerHeight;
          };
          const closerCta = closerSection?.querySelector<HTMLElement>('.ccc-actions a, a, button') ?? null;
          const heroCta = heroSection?.querySelector<HTMLElement>('.ccc-actions a, a, button') ?? null;
          let fallback: HTMLElement | null = null;
          if (isVisible(closerCta)) {
            fallback = closerCta;
          } else if (isVisible(heroCta)) {
            fallback = heroCta;
          } else {
            const navControls = Array.from(
              document.querySelectorAll<HTMLElement>('.site-nav .wordmark, .site-nav .nav-link, .site-nav .menu-btn')
            );
            fallback =
              navControls.find((el) => {
                const r = el.getBoundingClientRect();
                return r.width > 0 && r.height > 0;
              }) ?? null;
          }
          fallback?.focus({ preventScroll: true });
        }
        heroDockRow.setAttribute('inert', '');
        heroBtn.setAttribute('tabindex', '-1');
      }
    }

    if (heroBtn) {
      heroBtn.addEventListener('click', () => {
        if (motionQuery.matches) {
          const prev = html.style.scrollBehavior;
          html.style.scrollBehavior = 'auto';
          window.scrollTo(0, 0);
          html.style.scrollBehavior = prev;
        } else {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }
      }, { signal });
    }

    function clearVisualStyles() {
      subjectState.clear();
      Object.keys(sectionMap).forEach((key) => setSectionWillChange(key, false));
      [
        heroPhoto,
        heroBigLogo,
        whyTopMedia,
        whyTopImg,
        whyTopCopy,
        whyBottomMedia,
        whyBottomImg,
        whyBottomCopy,
        workNightWideImg,
        workRoomWide,
        workRoomWideImg,
        workRoomDetail,
        workRoomDetailImg,
        howCrewImg,
        howCocktailsImg,
        pricingImg,
        closerBgImg,
        closerLogo,
        closerTitle,
        closerInner,
      ].forEach((el) => {
        if (el) {
          el.style.transform = '';
          el.style.opacity = '';
        }
      });
      whereCards.forEach((c) => {
        c.style.transform = '';
        c.style.opacity = '';
      });
      whereCardImgs.forEach((img) => {
        img.style.transform = '';
      });
      workItems.forEach((item) => {
        item.style.transform = '';
      });
      workItemImgs.forEach((img) => {
        img.style.transform = '';
      });
      workTiles.forEach((tile) => {
        tile.style.transform = '';
      });
      workTileImgs.forEach((img) => {
        img.style.transform = '';
      });
      videoDesertImgs.forEach((img) => {
        img.style.transform = '';
      });
      videoRealImgs.forEach((img) => {
        img.style.transform = '';
      });
    }

    let frameRequest = 0;

    function updateFrame() {
      frameRequest = 0;
      const scrollY = window.scrollY;
      const winW = window.innerWidth;
      const winH = window.innerHeight;
      const prefersReducedMotion = motionQuery.matches;
      const isMobile = winW < 900;

      // PHASE 1: GEOMETRY READS (Normal-flow anchors only)
      const navEl = document.querySelector<HTMLElement>('.site-nav');
      const navH = navEl ? navEl.offsetHeight : (parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--nav-bar-h')) || 76);

      // Stable dock bar target height without reading mid-transition offsetHeight
      const isLandscapeShort = winH <= 560 || (winW > winH && winH <= 620);
      const scaleU = winW >= 1512 ? Math.min(1.3333, winW / 1512) : 1;
      const measuredDockBtnH = heroBtn ? heroBtn.offsetHeight : 0;
      const targetDockH =
        measuredDockBtnH > 10
          ? measuredDockBtnH + 1
          : isLandscapeShort
            ? 38
            : winW <= 640
              ? 46
              : Math.round(52 * scaleU);
      // Hero handoff geometry: compute from stable layout offset of hero actions / hero bottom
      const heroTopDoc = heroSection ? pageTop(heroSection) : 0;
      const heroH = heroSection ? heroSection.offsetHeight : 600;
      const actionsBottomDoc = heroActions ? pageTop(heroActions) + heroActions.offsetHeight : heroTopDoc + heroH * 0.78;
      const handoffScroll = Math.max(0, actionsBottomDoc - navH);

      const isDocked = scrollY >= handoffScroll;
      const activeDockH = isDocked ? targetDockH : 0;
      const dockBottom = navH + activeDockH;

      const closerTop = closerSection ? pageTop(closerSection) - scrollY : winH * 2;

      // Subject top positions (in viewport coordinates from normal flow)
      const whyTopY = whyTop ? pageTop(whyTop) - scrollY : winH * 2;
      const whyBottomY = whyBottom ? pageTop(whyBottom) - scrollY : winH * 2;
      const whereGridY = whereGrid ? pageTop(whereGrid) - scrollY : winH * 2;
      const workTrioY = workTrio ? pageTop(workTrio) - scrollY : winH * 2;
      const workNightY = workNight ? pageTop(workNight) - scrollY : winH * 2;
      const workRoomY = workRoom ? pageTop(workRoom) - scrollY : winH * 2;
      const videoY = videoSec ? pageTop(videoSec) - scrollY : winH * 2;
      const pricingY = pricingSec ? pageTop(pricingSec) - scrollY : winH * 2;

      // Helper for bounded reversible progress: starts when subject enters bottom of viewport (winH * 0.92),
      // settles when subject reaches comfortable reading zone (Math.max(dockBottom + 48, winH * 0.38))
      const subjectProgress = (subjectViewportTop: number) => {
        const enterY = winH * 0.92;
        const settleY = Math.max(dockBottom + 48, winH * 0.38);
        const span = Math.max(1, enterY - settleY);
        return Math.min(1, Math.max(0, (enterY - subjectViewportTop) / span));
      };

      // PHASE 2: VISUAL WRITES
      const nextPadding = `${Math.round(navH + targetDockH + 28)}px`;
      if (nextPadding !== scrollPadding) {
        html.style.scrollPaddingTop = nextPadding;
        scrollPadding = nextPadding;
      }
      // Dock state & closer push-up
      const closerStartTrigger = winH * 0.85;
      const closerPushRange = Math.max(1, winH * 0.45);
      const closerPushRaw = closerTop < closerStartTrigger ? (closerStartTrigger - closerTop) / closerPushRange : 0;
      const closerPushProgress = Math.min(1, Math.max(0, closerPushRaw));
      const easedPush = 1 - Math.pow(1 - closerPushProgress, 3);
      const pushY = easedPush * (activeDockH + navH + 20);
      const isDockDismissed = pushY > 4 || closerPushProgress > 0.04;

      if (heroDockRow) {
        heroDockRow.classList.toggle('is-docked', isDocked);
      }
      stack.classList.toggle('is-dismissed', isDockDismissed);
      setDockInteractive(isDocked && !isDockDismissed, navH);

      if (prefersReducedMotion) {
        if (hadMotion) clearVisualStyles();
        hadMotion = false;
        // Discrete dock visibility in reduced motion
        stack.style.transform = '';
        stack.style.opacity = isDocked && !isDockDismissed ? '1' : '0';
        stack.style.pointerEvents = isDocked && !isDockDismissed ? '' : 'none';
        return;
      }
      hadMotion = true;

      const motionScale = isLandscapeShort ? 0.35 : isMobile ? 0.5 : Math.min(1.4, winW / 1512);

      // 00. Hero: Zoom out 1.12 -> 1.0 (mobile 1.06 -> 1.0) as hero leaves viewport, logo fade and rise
      const heroProgress = Math.min(1, Math.max(0, (scrollY - heroTopDoc + navH) / heroH));
      const heroTravel = Math.round(heroProgress * 66 * motionScale * 10) / 10;
      const heroMaxZoom = isMobile ? 1.06 : 1.12;
      const heroZoom = heroMaxZoom - heroProgress * (heroMaxZoom - 1.0);
      const logoFadeStart = handoffScroll * 0.35;
      const logoFade = scrollY > logoFadeStart ? Math.max(0, 1 - (scrollY - logoFadeStart) / Math.max(1, handoffScroll - logoFadeStart)) : 1;

      if (subjectState.get('hero') !== heroTravel) {
        subjectState.set('hero', heroTravel);
        if (heroPhoto) {
          heroPhoto.style.transform = `translate3d(0, ${heroTravel}px, 0) scale(${heroZoom.toFixed(3)})`;
        }
        if (heroBigLogo) {
          heroBigLogo.style.transform = `translate3d(0, ${(heroTravel * 0.2).toFixed(1)}px, 0)`;
          heroBigLogo.style.opacity = logoFade.toFixed(3);
        }
      }

      // Dock push-up when closer enters
      if (closerPushProgress > 0) {
        stack.style.transform = `translate3d(0, -${pushY.toFixed(1)}px, 0)`;
        const fadeProgress = Math.min(1, Math.max(0, closerPushProgress / 0.85));
        const opacity = 1 - Math.pow(fadeProgress, 1.4);
        stack.style.opacity = Math.max(0, opacity).toFixed(3);
        stack.style.pointerEvents = isDockDismissed ? 'none' : '';
      } else {
        stack.style.transform = '';
        stack.style.opacity = '1';
        stack.style.pointerEvents = '';
      }

      // 01. Why it matters: Two images zoom out 1.10 -> 1.0 (mobile 1.06 -> 1.0) as each pair crosses viewport
      const whyZoomStart = isMobile ? 1.06 : 1.10;
      const pWhyTop = subjectProgress(whyTopY);
      if (subjectState.get('whyTop') !== pWhyTop) {
        subjectState.set('whyTop', pWhyTop);
        if (whyTopMedia) {
          const imgScale = 0.92 + pWhyTop * 0.08;
          const imgShiftX = (1 - pWhyTop) * 32;
          whyTopMedia.style.transform = `translate3d(-${imgShiftX.toFixed(1)}px, 0, 0) scale(${imgScale.toFixed(3)})`;
        }
        if (whyTopImg) {
          const zoom = whyZoomStart - pWhyTop * (whyZoomStart - 1.0);
          whyTopImg.style.transform = `scale(${zoom.toFixed(3)})`;
        }
        if (whyTopCopy) {
          const textShiftX = (1 - pWhyTop) * 12 * motionScale;
          whyTopCopy.style.transform = `translate3d(${textShiftX.toFixed(1)}px, 0, 0)`;
        }
      }

      const pWhyBottom = subjectProgress(whyBottomY);
      if (subjectState.get('whyBottom') !== pWhyBottom) {
        subjectState.set('whyBottom', pWhyBottom);
        if (whyBottomMedia) {
          const imgScale = 0.92 + pWhyBottom * 0.08;
          const imgShiftX = (1 - pWhyBottom) * 32;
          whyBottomMedia.style.transform = `translate3d(${imgShiftX.toFixed(1)}px, 0, 0) scale(${imgScale.toFixed(3)})`;
        }
        if (whyBottomImg) {
          const zoom = whyZoomStart - pWhyBottom * (whyZoomStart - 1.0);
          whyBottomImg.style.transform = `scale(${zoom.toFixed(3)})`;
        }
        if (whyBottomCopy) {
          const textShiftX = (1 - pWhyBottom) * 12 * motionScale;
          whyBottomCopy.style.transform = `translate3d(-${textShiftX.toFixed(1)}px, 0, 0)`;
        }
      }

      // 02. Where it goes: Fold-out container and four cards zoom in 1.0 -> 1.08 (mobile 1.0 -> 1.06), staggered
      if (whereCards.length === 4) {
        const pWhere = subjectProgress(whereGridY);
        const isNarrow = winW < 900 ? 1 : 0;
        const whereState = pWhere + isNarrow * 10;
        if (subjectState.get('where') !== whereState) {
          subjectState.set('where', whereState);
          const offsets = isNarrow ? [14, -14, 14, -14] : [28, 12, -12, -28];
          const rotations = isNarrow ? [-1.5, 1.5, -1.5, 1.5] : [-2.2, -0.9, 0.9, 2.2];
          const cardScale = 0.90 + pWhere * 0.10;
          const whereZoomTarget = isMobile ? 1.06 : 1.08;

          whereCards.forEach((card, idx) => {
            const currX = (1 - pWhere) * (offsets[idx] || 0);
            const currRot = (1 - pWhere) * (rotations[idx] || 0);
            card.style.transform = `translate3d(${currX.toFixed(1)}px, 0, 0) rotate(${currRot.toFixed(2)}deg) scale(${cardScale.toFixed(3)})`;
            const img = whereCardImgs[idx];
            if (img) {
              const stagger = idx * 0.08;
              const pCard = Math.min(1, Math.max(0, (pWhere - stagger) / Math.max(0.01, 1 - stagger)));
              const zoom = 1.0 + pCard * (whereZoomTarget - 1.0);
              img.style.transform = `scale(${zoom.toFixed(3)})`;
            }
          });
        }
      }

      // 03. The work: Trio zooms out 1.10 -> 1.0; Night wide zooms in 1.0 -> 1.08; 4 tiles alternate out and in; Room wide zooms out 1.10 -> 1.0, detail zooms in 1.0 -> 1.08
      if (workItems.length > 0) {
        const pTrio = subjectProgress(workTrioY);
        if (subjectState.get('workTrio') !== pTrio) {
          subjectState.set('workTrio', pTrio);
          const floatOffsets = [24, 44, 18];
          const trioZoomStart = isMobile ? 1.06 : 1.10;
          const trioZoom = trioZoomStart - pTrio * (trioZoomStart - 1.0);
          workItems.forEach((item, idx) => {
            const yOffset = (1 - pTrio) * (floatOffsets[idx] || 24);
            item.style.transform = `translate3d(0, ${yOffset.toFixed(1)}px, 0)`;
          });
          workItemImgs.forEach((img) => {
            img.style.transform = `scale(${trioZoom.toFixed(3)})`;
          });
        }
      }

      if (workTiles.length > 0 || workNightWideImg) {
        const pNight = subjectProgress(workNightY);
        if (subjectState.get('workNight') !== pNight) {
          subjectState.set('workNight', pNight);
          if (workNightWideImg) {
            const nightWideTarget = isMobile ? 1.06 : 1.08;
            const nightWideZoom = 1.0 + pNight * (nightWideTarget - 1.0);
            workNightWideImg.style.transform = `scale(${nightWideZoom.toFixed(3)})`;
          }
          const tileFloats = [18, 32, 14, 28];
          const tileZoomOutStart = isMobile ? 1.06 : 1.10;
          const tileZoomInTarget = isMobile ? 1.06 : 1.08;
          const tileZoomOut = tileZoomOutStart - pNight * (tileZoomOutStart - 1.0);
          const tileZoomIn = 1.0 + pNight * (tileZoomInTarget - 1.0);
          workTiles.forEach((tile, idx) => {
            const yOffset = (1 - pNight) * (tileFloats[idx] || 20);
            tile.style.transform = `translate3d(0, ${yOffset.toFixed(1)}px, 0)`;
            const img = workTileImgs[idx];
            if (img) {
              const zoom = idx % 2 === 0 ? tileZoomOut : tileZoomIn;
              img.style.transform = `scale(${zoom.toFixed(3)})`;
            }
          });
        }
      }

      if (workRoomWide || workRoomDetail) {
        const pRoom = subjectProgress(workRoomY);
        if (subjectState.get('workRoom') !== pRoom) {
          subjectState.set('workRoom', pRoom);
          if (workRoomWide) {
            const roomScale = 0.95 + pRoom * 0.05;
            workRoomWide.style.transform = `scale(${roomScale.toFixed(3)})`;
          }
          if (workRoomWideImg) {
            const roomWideZoomStart = isMobile ? 1.06 : 1.10;
            const roomWideZoom = roomWideZoomStart - pRoom * (roomWideZoomStart - 1.0);
            workRoomWideImg.style.transform = `scale(${roomWideZoom.toFixed(3)})`;
          }
          if (workRoomDetail) {
            const detailY = (1 - pRoom) * -20;
            workRoomDetail.style.transform = `translate3d(0, ${detailY.toFixed(1)}px, 0)`;
          }
          if (workRoomDetailImg) {
            const roomDetailZoomTarget = isMobile ? 1.06 : 1.08;
            const roomDetailZoom = 1.0 + pRoom * (roomDetailZoomTarget - 1.0);
            workRoomDetailImg.style.transform = `scale(${roomDetailZoom.toFixed(3)})`;
          }
        }
      }

      // 04. Video: Four desert frames zoom out 1.10 -> 1.0 staggered, real frames zoom in 1.0 -> 1.08
      if (videoSec && (videoDesertImgs.length > 0 || videoRealImgs.length > 0)) {
        const pVideo = subjectProgress(videoY);
        if (subjectState.get('video') !== pVideo) {
          subjectState.set('video', pVideo);
          const desertZoomStart = isMobile ? 1.06 : 1.10;
          videoDesertImgs.forEach((img, idx) => {
            const stagger = idx * 0.06;
            const pDesert = Math.min(1, Math.max(0, (pVideo - stagger) / Math.max(0.01, 1 - stagger)));
            const zoom = desertZoomStart - pDesert * (desertZoomStart - 1.0);
            img.style.transform = `scale(${zoom.toFixed(3)})`;
          });
          const realZoomTarget = isMobile ? 1.06 : 1.08;
          const realZoom = 1.0 + pVideo * (realZoomTarget - 1.0);
          videoRealImgs.forEach((img) => {
            img.style.transform = `scale(${realZoom.toFixed(3)})`;
          });
        }
      }

      // 05. How it works: Two images zoom out 1.10 -> 1.0
      if (howSplits.length > 0) {
        const howZoomStart = isMobile ? 1.06 : 1.10;
        howSplits.forEach((split, idx) => {
          const splitY = pageTop(split) - scrollY;
          const pSplit = subjectProgress(splitY);
          const cacheKey = `howSplit_${idx}`;
          if (subjectState.get(cacheKey) !== pSplit) {
            subjectState.set(cacheKey, pSplit);
            const zoom = howZoomStart - pSplit * (howZoomStart - 1.0);
            if (idx === 0 && howCrewImg) howCrewImg.style.transform = `scale(${zoom.toFixed(3)})`;
            if (idx === 1 && howCocktailsImg) howCocktailsImg.style.transform = `scale(${zoom.toFixed(3)})`;
          }
        });
      }

      // 06. Packages: Coupe image zooms in 1.0 -> 1.08
      if (pricingImg) {
        const pPricing = subjectProgress(pricingY);
        if (subjectState.get('pricing') !== pPricing) {
          subjectState.set('pricing', pPricing);
          const pricingZoomTarget = isMobile ? 1.06 : 1.08;
          const zoom = 1.0 + pPricing * (pricingZoomTarget - 1.0);
          pricingImg.style.transform = `scale(${zoom.toFixed(3)})`;
        }
      }

      // Closer: Logo and title grow, background zoom capped at 1.05
      if (closerSection) {
        const enterY = winH;
        const finishY = Math.max(navH + 40, winH * 0.22);
        const closerProgress = Math.min(1, Math.max(0, (enterY - closerTop) / Math.max(1, enterY - finishY)));
        const travel = Math.min(42 * motionScale, closerSection.offsetHeight * 0.05);
        const y = Math.round((1 - closerProgress) * travel * 10) / 10;
        const closerState = closerProgress * 1000 + y;
        if (subjectState.get('closer') !== closerState) {
          subjectState.set('closer', closerState);
          if (closerLogo) {
            const logoScale = 0.88 + closerProgress * 0.16;
            closerLogo.style.transform = `scale(${logoScale.toFixed(3)})`;
          }
          if (closerTitle) {
            const titleScale = 0.92 + closerProgress * 0.08;
            closerTitle.style.transform = `scale(${titleScale.toFixed(3)})`;
          }
          if (closerInner) {
            const translateY = (1 - closerProgress) * 32;
            closerInner.style.transform = `translate3d(0, ${translateY.toFixed(1)}px, 0)`;
          }
          if (closerBgImg) {
            const closerMaxZoom = isMobile ? 1.04 : 1.05;
            const bgScale = 1.0 + closerProgress * (closerMaxZoom - 1.0);
            closerBgImg.style.transform = `translate3d(0, ${y}px, 0) scale(${bgScale.toFixed(3)})`;
          }
        }
      }
    }

    const requestUpdate = () => {
      if (!frameRequest && !signal.aborted) frameRequest = requestAnimationFrame(updateFrame);
    };

    window.addEventListener('scroll', requestUpdate, { passive: true, signal });
    window.addEventListener('resize', requestUpdate, { passive: true, signal });
    window.addEventListener('orientationchange', requestUpdate, { passive: true, signal });
    motionQuery.addEventListener('change', () => {
      if (motionQuery.matches) clearVisualStyles();
      requestUpdate();
    }, { signal });
    document.fonts?.ready.then(requestUpdate).catch(() => {});

    const observer = typeof ResizeObserver !== 'undefined' ? new ResizeObserver(requestUpdate) : null;
    const navEl = document.querySelector<HTMLElement>('.site-nav');
    const route = stack.closest('.ccc-route');
    if (navEl) observer?.observe(navEl);
    if (route) observer?.observe(route);

    document.addEventListener('astro:before-swap', () => {
      lifecycle.abort();
      observer?.disconnect();
      io?.disconnect();
      cancelAnimationFrame(frameRequest);
      clearVisualStyles();
      if (html.style.scrollPaddingTop === scrollPadding) html.style.scrollPaddingTop = priorScrollPadding;
    }, { once: true });

    updateFrame();
  }

  function init() {
    initPinnedScrollStack();
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>
