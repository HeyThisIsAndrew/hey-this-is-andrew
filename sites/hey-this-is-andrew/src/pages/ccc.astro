  }

  .ccc-section :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .ccc-subtitle {
    margin: 0 0 1.25rem;
    font-family: var(--ccc-font-display);
    font-size: clamp(1.65rem, 3.2vw, 2.5rem);
