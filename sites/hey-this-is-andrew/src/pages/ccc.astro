    color: var(--muted, #888);
    transition: transform 0.2s ease, color 0.2s ease;
  }

  .ccc-dock-btn:hover .ccc-row-chevron {
    color: var(--ink, #fff);
    transform: translateY(-2px);
  }

  @media (max-width: 640px) {
    .ccc-dock-row.is-docked {
      max-height: 44px;
