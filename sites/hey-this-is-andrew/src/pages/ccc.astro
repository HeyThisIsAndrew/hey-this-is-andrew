    margin: 0.5rem 0 0 !important;
    font-family: var(--font-mono);
    font-size: 0.72rem !important;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted) !important;
  }

  /* Closer */
  .ccc-closer {
    position: relative;
    min-height: calc(100vh - var(--nav-bar-h, 76px) - 200px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(6rem, 14vw, 12rem) 0;
    border-top: 1px solid var(--line);
    text-align: center;
    isolation: isolate;
    overflow: hidden;
  }
  .ccc-closer-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
  }
  .ccc-closer-bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform-origin: center center;
    will-change: transform;
    transition: transform 0.15s ease-out;
  }
  .ccc-closer-bg::after { content: ''; position: absolute; inset: 0; background: rgba(0, 0, 0, 0.72); }
  .ccc-closer-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
    transform-origin: center center;
    will-change: transform;
    transition: transform 0.15s ease-out;
  }
  .ccc-closer-logo {
    width: clamp(100px, 18vw, 150px) !important;
    max-width: 150px;
    height: auto;
    transform-origin: center center;
    will-change: transform;
    transition: transform 0.15s ease-out;
  }
  .ccc-closer-eyebrow {
    margin: 0.5rem 0 0;
    font-family: var(--ccc-font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--ccc-gold);
  }
  .ccc-closer-title {
    margin: 0;
    max-width: 18ch;
    font-family: var(--ccc-font-display);
    font-size: clamp(2.4rem, 6.2vw, 4.4rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--ccc-cream);
    transform-origin: center center;
    will-change: transform;
  }
  .ccc-closer-body {
    margin: 0;
    max-width: 44ch;
    font-family: var(--ccc-font-serif);
    font-size: clamp(1.45rem, 2.4vw, 1.95rem);
    line-height: 1.6;
    color: var(--ccc-cream-soft);
  }
  .ccc-closer-price {
    margin: 0;
    font-family: var(--ccc-font-display);
    font-style: italic;
    font-size: clamp(1.15rem, 1.8vw, 1.4rem);
    letter-spacing: 0.1em;
    color: var(--ccc-gold-light);
  }

  @media (max-width: 900px) {
    .ccc-closer {
      min-height: 100svh;
      padding: clamp(3.5rem, 8vw, 5rem) 1.25rem clamp(4rem, 10vw, 6rem);
      box-sizing: border-box;
    }
    .ccc-closer-title {
      font-size: clamp(2rem, 7.5vw, 3.2rem);
    }
    .ccc-closer-body {
      font-size: clamp(1.2rem, 4.2vw, 1.55rem);
      max-width: 32ch;
    }
    .ccc-closer-price {
      font-size: clamp(0.95rem, 3.4vw, 1.2rem);
    }
    .ccc-closer .ccc-actions {
      display: flex;
      flex-direction: column;
      width: 100%;
      max-width: 340px;
      gap: 0.65rem;
      margin: 0.85rem auto 0;
    }
    .ccc-closer .ccc-actions .btn {
      width: 100%;
      justify-content: center;
      text-align: center;
    }
  }

  @media (orientation: landscape) and (max-height: 600px) {
    .ccc-closer {
      min-height: 100svh;
      padding: 2rem 1.5rem 2.5rem;
    }
    .ccc-closer-logo {
      width: clamp(65px, 10vw, 90px) !important;
    }
    .ccc-closer-title {
      font-size: clamp(1.5rem, 4.5vw, 2.2rem);
    }
    .ccc-closer-body {
      font-size: clamp(0.95rem, 2.4vw, 1.15rem);
      max-width: 44ch;
    }
    .ccc-closer-price {
      font-size: 0.8rem;
    }
    .ccc-closer .ccc-actions {
      flex-direction: row !important;
      flex-wrap: wrap;
      justify-content: center;
      max-width: 560px !important;
      gap: 0.5rem;
    }
    .ccc-closer .ccc-actions .btn {
      width: auto !important;
      min-width: 140px;
    }
  }
</style>

<script>
  function initPinnedScrollStack() {
    const stack = document.getElementById('ccc-pinned-stack');
    if (!stack) return;

    const heroSection = document.getElementById('hero');
    const heroInner = heroSection?.querySelector<HTMLElement>('.ccc-hero-inner');
    const heroBigLogo = heroSection?.querySelector<HTMLElement>('.ccc-hero-logo');
    const heroDockRow = stack.querySelector<HTMLElement>('.ccc-dock-row[data-target="hero"]');

    const closerSection = document.getElementById('contact');
    const closerInner = closerSection?.querySelector<HTMLElement>('.ccc-closer-inner');
    const closerLogo = closerSection?.querySelector<HTMLElement>('.ccc-closer-logo');
    const closerTitle = closerSection?.querySelector<HTMLElement>('.ccc-closer-title');
    const closerBgImg = closerSection?.querySelector<HTMLElement>('.ccc-closer-bg img');

    // Section 01 elements
    const whySection = document.getElementById('why');
    const whyTop = document.getElementById('ccc-why-top');
    const whyTopMedia = whyTop?.querySelector<HTMLElement>('.ccc-why-media');
    const whyTopCopy = whyTop?.querySelector<HTMLElement>('.ccc-why-copy');
    const whyBottom = document.getElementById('ccc-why-bottom');
    const whyBottomMedia = whyBottom?.querySelector<HTMLElement>('.ccc-why-media');
    const whyBottomCopy = whyBottom?.querySelector<HTMLElement>('.ccc-why-copy');

    // Section 02 elements
    const whereSection = document.getElementById('where');
    const whereCards = Array.from(document.querySelectorAll<HTMLElement>('#ccc-where-grid .ccc-card'));

    // Section 03 elements
    const workSection = document.getElementById('work');
    const workItems = Array.from(document.querySelectorAll<HTMLElement>('#ccc-work-trio .ccc-work-item'));
    const workTiles = Array.from(document.querySelectorAll<HTMLElement>('#ccc-work-night .ccc-mosaic-tile'));
    const workRoomWide = document.querySelector<HTMLElement>('#ccc-work-room .ccc-room-wide');
    const workRoomDetail = document.querySelector<HTMLElement>('#ccc-work-room .ccc-room-detail');

    const sectionIds = ['why', 'where', 'work', 'video', 'how', 'pricing'];

    const sections = sectionIds
      .map((id) => ({
        id,
        el: document.getElementById(id),
        dockRow: stack.querySelector<HTMLElement>(`.ccc-dock-row[data-target="${id}"]`),
      }))
      .filter((s): s is { id: string; el: HTMLElement; dockRow: HTMLElement } => !!s.el && !!s.dockRow);

    // Wire click on each dock row to smoothly scroll back to that section
    stack.querySelectorAll<HTMLButtonElement>('.ccc-dock-btn').forEach((btn) => {
      if (btn.dataset.wired === '1') return;
      btn.dataset.wired = '1';

      btn.addEventListener('click', () => {
        const row = btn.closest<HTMLElement>('.ccc-dock-row');
        const targetId = row?.getAttribute('data-target');
        if (!targetId) return;

        if (targetId === 'hero') {
          window.scrollTo({ top: 0, behavior: 'smooth' });
          return;
        }

        const targetEl = document.getElementById(targetId);
        if (!targetEl) return;

        const navH = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--nav-bar-h')) || 76;
        const isLandscapeShort = window.innerHeight <= 560 ||
          (window.matchMedia('(orientation: landscape)').matches && window.innerHeight <= 620);

        // Height of rows that stay docked above targetId
        let dockedAboveH = 0;
        if (!isLandscapeShort) {
          if (heroDockRow) {
            dockedAboveH += heroDockRow.offsetHeight || 60;
          }
          for (const s of sections) {
            if (s.id === targetId) break;
            dockedAboveH += s.dockRow.offsetHeight || 44;
          }
        }

        const rect = targetEl.getBoundingClientRect();
        const targetY = Math.max(0, rect.top + window.scrollY - navH - dockedAboveH - 12);
        window.scrollTo({ top: targetY, behavior: 'smooth' });
      });
    });

    let ticking = false;

    function onScroll() {
      const scrollY = window.scrollY;
      const navH = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--nav-bar-h')) || 76;
      const winH = window.innerHeight;
      const isNearBottom = (scrollY + winH) >= (document.documentElement.scrollHeight - 50);

      const isLandscapeShort = winH <= 560 ||
        (window.matchMedia('(orientation: landscape)').matches && winH <= 620);
      const isMobile = window.innerWidth <= 900 || isLandscapeShort;

      // 1. Hero scroll parallax & dock trigger
      const heroThreshold = 140;
      const heroProgress = Math.min(1, Math.max(0, scrollY / heroThreshold));

      if (heroBigLogo) {
        heroBigLogo.style.opacity = (1 - heroProgress).toFixed(3);
        heroBigLogo.style.transform = `translate3d(0, -${(heroProgress * 40).toFixed(1)}px, 0) scale(${(1 - heroProgress * 0.25).toFixed(3)})`;
      }
      if (heroInner) {
        heroInner.style.opacity = (1 - heroProgress * 0.85).toFixed(3);
      }

      if (heroDockRow) {
        if (scrollY >= heroThreshold) {
          heroDockRow.classList.add('is-docked');
        } else {
          heroDockRow.classList.remove('is-docked');
        }
      }

      // 2. Cumulative section docking triggers and smooth exit movement
      let currentStackH = (heroDockRow && heroDockRow.classList.contains('is-docked')) ? (heroDockRow.offsetHeight || 60) : 0;

      for (let i = 0; i < sections.length; i++) {
        const s = sections[i];
        const rect = s.el.getBoundingClientRect();

        // In landscape short view, only 1 slim row (~38px) is visible at a time, so stack offset does not accumulate
        const stackOffset = isLandscapeShort ? (currentStackH > 0 ? 38 : 0) : currentStackH;

        let shouldDock = false;
        if (s.id === 'pricing') {
          // Final section collapses when scrolling past stack or near bottom
          shouldDock = isNearBottom ||
            rect.bottom <= (navH + stackOffset + (isLandscapeShort ? 25 : 45));
        } else {
          shouldDock = rect.bottom <= (navH + stackOffset + (isLandscapeShort ? 20 : 40));
        }

        // Smooth in-page exit animation as section approaches collapsed view
        const exitTriggerDist = isLandscapeShort ? 70 : 150;
        const stackBottom = navH + stackOffset;
        if (rect.bottom < stackBottom + exitTriggerDist) {
          const exitProgress = Math.min(1, Math.max(0, (stackBottom + exitTriggerDist - rect.bottom) / exitTriggerDist));
          s.el.style.opacity = (1 - exitProgress * 0.85).toFixed(3);
          s.el.style.transform = `translate3d(0, -${(exitProgress * 18).toFixed(1)}px, 0)`;
        } else {
          s.el.style.opacity = '1';
          s.el.style.transform = '';
        }

        if (shouldDock) {
          s.dockRow.classList.add('is-docked');
          if (isLandscapeShort) {
            currentStackH = 38;
          } else {
            currentStackH += s.dockRow.offsetHeight || 44;
          }
        } else {
          s.dockRow.classList.remove('is-docked');
        }
      }

      // 2.1 Identify the most recently docked row to mark as is-active-docked
      let latestDockedRow: HTMLElement | null = null;
      if (heroDockRow && heroDockRow.classList.contains('is-docked')) {
        latestDockedRow = heroDockRow;
      }
      for (let i = 0; i < sections.length; i++) {
        if (sections[i].dockRow.classList.contains('is-docked')) {
          latestDockedRow = sections[i].dockRow;
        }
      }

      if (heroDockRow) {
        heroDockRow.classList.toggle('is-active-docked', heroDockRow === latestDockedRow);
      }
      for (let i = 0; i < sections.length; i++) {
        sections[i].dockRow.classList.toggle('is-active-docked', sections[i].dockRow === latestDockedRow);
      }

      // 2.2 Mobile & Landscape stack push-up: When user scrolls into the final view (#contact),
      // push the collapsed stack up off the screen so #contact becomes full screen,
      // all collapsed views disappear, and scrolling further displays the footer.
      if (isMobile && closerSection && stack) {
        const contactRect = closerSection.getBoundingClientRect();
        // In landscape / short viewports, only 1 slim row is active at a time
        const effectiveStackH = isLandscapeShort
          ? (latestDockedRow ? (latestDockedRow.offsetHeight || 38) : 0)
          : Math.max(currentStackH, (sections.length * 44 + 58));
        const stackBottom = navH + effectiveStackH;

        const pushRange = effectiveStackH + navH + 40;
        // Trigger push-up slightly earlier as contact approaches so the entry is soft and eased
        const startTrigger = stackBottom + 40;

        if (contactRect.top < startTrigger) {
          const rawProgress = (startTrigger - contactRect.top) / pushRange;
          const progress = Math.min(1, Math.max(0, rawProgress));

          // Smooth cubic ease-out curve (starts gently, accelerates gracefully)
          const eased = 1 - Math.pow(1 - progress, 3);
          const pushY = eased * (effectiveStackH + navH + 40);

          stack.style.transform = `translate3d(0, -${pushY.toFixed(1)}px, 0)`;

          // Smooth curved fade out
          const fadeProgress = Math.min(1, Math.max(0, progress / 0.85));
          const opacity = 1 - Math.pow(fadeProgress, 1.4);
          stack.style.opacity = Math.max(0, opacity).toFixed(3);
          stack.style.pointerEvents = progress > 0.15 ? 'none' : '';
        } else {
          stack.style.transform = '';
          stack.style.opacity = '1';
          stack.style.pointerEvents = '';
        }
      } else if (stack) {
        stack.style.transform = '';
        stack.style.opacity = '1';
        stack.style.pointerEvents = '';
      }

      // 2.5 Dynamic in-section parallax mechanics (Section 01, 02, 03)
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (!prefersReducedMotion) {
        // Section 01 (Why it matters): Overlap dual-axis shift, fade in, and scale
        if (whySection) {
          const whyRect = whySection.getBoundingClientRect();
          const enterY = winH;
          const settleY = navH + currentStackH + 40;
          const dist = Math.max(1, enterY - settleY);
          const whyProgress = Math.min(1, Math.max(0, (enterY - whyRect.top) / dist));

          if (whyRect.bottom > 0 && whyRect.top < winH) {
            if (whyTopMedia) {
              const imgScale = 0.90 + whyProgress * 0.10;
              const imgShiftX = (1 - whyProgress) * 35;
              whyTopMedia.style.transform = `translate3d(-${imgShiftX.toFixed(1)}px, 0, 0) scale(${imgScale.toFixed(3)})`;
            }
            if (whyTopCopy) {
              const textScale = 0.96 + whyProgress * 0.08;
              const textShiftX = (1 - whyProgress) * 25;
              const textOpacity = 0.45 + whyProgress * 0.55;
              whyTopCopy.style.opacity = textOpacity.toFixed(3);
              whyTopCopy.style.transform = `translate3d(${textShiftX.toFixed(1)}px, 0, 0) scale(${textScale.toFixed(3)})`;
            }

            if (whyBottomMedia) {
              const imgScale = 0.90 + whyProgress * 0.10;
              const imgShiftX = (1 - whyProgress) * 35;
              whyBottomMedia.style.transform = `translate3d(${imgShiftX.toFixed(1)}px, 0, 0) scale(${imgScale.toFixed(3)})`;
            }
            if (whyBottomCopy) {
              const textScale = 0.96 + whyProgress * 0.08;
              const textShiftX = (1 - whyProgress) * 25;
              const textOpacity = 0.45 + whyProgress * 0.55;
              whyBottomCopy.style.opacity = textOpacity.toFixed(3);
              whyBottomCopy.style.transform = `translate3d(-${textShiftX.toFixed(1)}px, 0, 0) scale(${textScale.toFixed(3)})`;
            }
          }
        }

        // Section 02 (Where it goes): Center fold-out into 4-column row
        if (whereSection && whereCards.length === 4) {
          const whereRect = whereSection.getBoundingClientRect();
          const enterY = winH;
          const settleY = navH + currentStackH + 40;
          const dist = Math.max(1, enterY - settleY);
          const whereProgress = Math.min(1, Math.max(0, (enterY - whereRect.top) / dist));

          if (whereRect.bottom > 0 && whereRect.top < winH) {
            const offsets = [110, 35, -35, -110];
            const rotations = [-2.5, -1.0, 1.0, 2.5];
            const cardScale = 0.88 + whereProgress * 0.12;
            const cardOpacity = 0.40 + whereProgress * 0.60;

            whereCards.forEach((card, idx) => {
              const currX = (1 - whereProgress) * (offsets[idx] || 0);
              const currRot = (1 - whereProgress) * (rotations[idx] || 0);
              card.style.transform = `translate3d(${currX.toFixed(1)}px, 0, 0) rotate(${currRot.toFixed(2)}deg) scale(${cardScale.toFixed(3)})`;
              card.style.opacity = cardOpacity.toFixed(3);
            });
          }
        }

        // Section 03 (The work): Decompressed editorial float & depth
        if (workSection) {
          const workRect = workSection.getBoundingClientRect();
          const enterY = winH;
          const settleY = navH + currentStackH + 40;
          const dist = Math.max(1, enterY - settleY);
          const workProgress = Math.min(1, Math.max(0, (enterY - workRect.top) / dist));

          if (workRect.bottom > 0 && workRect.top < winH) {
            if (workItems.length > 0) {
              const floatOffsets = [24, 48, 18];
              workItems.forEach((item, idx) => {
                const yOffset = (1 - workProgress) * (floatOffsets[idx] || 25);
                item.style.transform = `translate3d(0, ${yOffset.toFixed(1)}px, 0)`;
              });
            }

            if (workTiles.length > 0) {
              const tileFloats = [18, 32, 14, 28];
              workTiles.forEach((tile, idx) => {
                const yOffset = (1 - workProgress) * (tileFloats[idx] || 20);
                tile.style.transform = `translate3d(0, ${yOffset.toFixed(1)}px, 0)`;
              });
            }

            if (workRoomWide) {
              const roomScale = 0.95 + workProgress * 0.05;
              workRoomWide.style.transform = `scale(${roomScale.toFixed(3)})`;
            }
            if (workRoomDetail) {
              const detailY = (1 - workProgress) * -20;
              workRoomDetail.style.transform = `translate3d(0, ${detailY.toFixed(1)}px, 0)`;
            }
          }
        }
      }

      // 3. Bottom-most section (closer) parallax increase in size as it scrolls into view
      if (closerSection) {
        const closerRect = closerSection.getBoundingClientRect();
        // Progress runs from when closer top enters the bottom of the viewport
        // to when closer top reaches near the bottom of the pinned stack
        const enterY = winH;
        const finishY = navH + currentStackH + 40;
        const totalDist = Math.max(1, enterY - finishY);
        const closerProgress = Math.min(1, Math.max(0, (enterY - closerRect.top) / totalDist));

        if (closerLogo) {
          // Logo increases in size like a parallax (0.82 -> 1.25)
          const logoScale = 0.82 + closerProgress * 0.43;
          closerLogo.style.transform = `scale(${logoScale.toFixed(3)})`;
        }

        if (closerTitle) {
          // Title increases in size (0.88 -> 1.10)
          const titleScale = 0.88 + closerProgress * 0.22;
          closerTitle.style.transform = `scale(${titleScale.toFixed(3)})`;
        }

        if (closerInner) {
          // Content slides smoothly up with parallax depth
          const translateY = (1 - closerProgress) * 40;
          closerInner.style.transform = `translate3d(0, ${translateY.toFixed(1)}px, 0)`;
        }

        if (closerBgImg) {
          // Background zooms smoothly (1.0 -> 1.15)
          const bgScale = 1.0 + closerProgress * 0.15;
          closerBgImg.style.transform = `scale(${bgScale.toFixed(3)})`;
        }
      }

      ticking = false;
    }

    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(onScroll);
        ticking = true;
      }
    }, { passive: true });

    window.addEventListener('resize', () => {
      if (!ticking) {
        requestAnimationFrame(onScroll);
        ticking = true;
      }
    }, { passive: true });

    window.addEventListener('orientationchange', () => {
      setTimeout(onScroll, 120);
    }, { passive: true });

    onScroll();
  }

  function init() {
    initPinnedScrollStack();
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>
