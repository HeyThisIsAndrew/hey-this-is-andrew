  .ccc-section {
    padding: clamp(4rem, 9vw, 7rem) 0;
    border-top: 1px solid var(--line);
    background: var(--bg, #080808);
    transition: opacity 0.25s ease-out, transform 0.25s ease-out;
    transform-origin: center top;
  }

  /* Section header typography overrides for cinematic elegance */
  .ccc-section :global(.section-title) {
    font-family: var(--ccc-font-display);
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--ccc-cream);
  }
  .ccc-section :global(.sec-kicker) {
    font-family: var(--ccc-font-mono);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--ccc-gold);
  }
  .ccc-section :global(.sec-eyebrow) {
    margin-bottom: 0.85rem;
  }

  /* Persistent Docked Stack: Each section collapses here on scroll and ALWAYS remains visible at the top */
  .ccc-pinned-stack {
    position: fixed;
    top: var(--nav-bar-h, 76px);
    left: 0;
    right: 0;
    width: 100%;
    z-index: 90;
    pointer-events: none;
    display: flex;
    flex-direction: column;
    will-change: transform, opacity;
    transition: transform 0.22s cubic-bezier(0.2, 0.8, 0.25, 1),
                opacity 0.22s ease-out;
  }

  .ccc-dock-row {
    width: 100%;
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    pointer-events: none;
    background: #080808;
    border-bottom: 1px solid transparent;
    transform: translateY(-10px) scale(0.99);
    transform-origin: center top;
    transition: max-height 0.45s cubic-bezier(0.16, 1, 0.3, 1),
                opacity 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.45s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.3s ease;
    will-change: max-height, opacity, transform;
  }

  .ccc-dock-row.is-docked {
    max-height: 52px;
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
    border-bottom: 1px solid var(--line, rgba(255, 255, 255, 0.12));
  }

  .ccc-dock-row--hero.is-docked {
    max-height: 84px;
  }

  /* Horizontal / Landscape View: in landscape on phones or short viewports (height <= 560px),
     cumulative vertical stacking would swallow the short screen. We display only the single
     active/latest docked row as a slim top bar (38px high), preventing overlap entirely. */
  @media (max-height: 560px), (orientation: landscape) and (max-height: 620px) {
    .ccc-pinned-stack {
      top: var(--nav-bar-h, 52px);
    }
    .ccc-dock-row {
      display: none !important;
    }
    .ccc-dock-row.is-active-docked {
      display: block !important;
      max-height: 40px !important;
      opacity: 1 !important;
      transform: translateY(0) !important;
      pointer-events: auto !important;
      border-bottom: 1px solid var(--line, rgba(255, 255, 255, 0.15)) !important;
    }
    .ccc-dock-btn {
      min-height: 36px !important;
      padding: 0.25rem 1.25rem !important;
    }
    .ccc-dock-btn--hero {
      min-height: 38px !important;
      padding: 0.25rem 1.25rem !important;
    }
    .ccc-dock-hero-logo {
      width: 26px !important;
      height: auto;
    }
    .ccc-row-kicker {
      font-size: 0.65rem !important;
    }
    .ccc-row-title {
      font-size: clamp(0.75rem, 1.6vw, 0.95rem) !important;
    }
    .ccc-row-chevron {
      font-size: 0.85rem !important;
    }
  }

  .ccc-dock-btn {
    appearance: none;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(1rem, 2.5vw, 2.5rem);
