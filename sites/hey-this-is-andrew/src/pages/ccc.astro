  /* Persistent Docked Top Bar: Single bar collapses here on scroll and serves as quick return to top */
  .ccc-pinned-stack {
    position: fixed;
    top: var(--nav-bar-h, 76px);
    left: 0;
    right: 0;
    width: 100%;
    z-index: 90;
    pointer-events: none;
    display: flex;
    flex-direction: column;
    will-change: transform, opacity;
    transition: transform 0.22s cubic-bezier(0.2, 0.8, 0.25, 1),
                opacity 0.22s ease-out;
  }

  .ccc-dock-row {
    width: 100%;
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    pointer-events: none;
    background: #080808;
    border-bottom: 1px solid transparent;
    transform: translateY(-10px) scale(0.99);
    transform-origin: center top;
    transition: max-height 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.3s ease;
    will-change: max-height, opacity, transform;
  }

  .ccc-dock-row.is-docked {
    max-height: calc(52 * var(--ccc-u));
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
    border-bottom: 1px solid var(--line, rgba(255, 255, 255, 0.12));
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.7);
  }

  .ccc-pinned-stack.is-dismissed,
  .ccc-pinned-stack.is-dismissed .ccc-dock-row,
  .ccc-pinned-stack.is-dismissed .ccc-dock-btn {
    pointer-events: none !important;
  }

