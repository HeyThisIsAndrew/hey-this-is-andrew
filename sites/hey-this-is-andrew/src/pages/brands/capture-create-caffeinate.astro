---
/**
 * Brand hub: Capture Create Caffeinate.
 * A portfolio page for brand deal pitches. The hospitality content
 * brand: photography and video for bars, restaurants, and events.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '@andrew/ui/SectionHeader.astro';
import { Image } from 'astro:assets';
import cccLogo from '../../assets/brand-logos/ccc-logo.png';
import cccMedia from '../../assets/hero-media/ccc-pour.jpg';

const INQUIRY_EMAIL = 'capturecreatecaffeinate@gmail.com';
const SUBJECT = encodeURIComponent('Content shoot inquiry');

const OFFERS = [
  {
    title: 'Photography',
    desc: 'Menus, drinks, interiors, and process. Shot for the way people actually scroll.',
  },
  {
    title: 'Short-form video',
    desc: 'Pours, plating, and atmosphere cut for Reels, TikTok, and Shorts.',
  },
  {
    title: 'Four-hour shoots',
    desc: 'One session, a full library. No disruption to service, no multi-day production.',
  },
];
---

<BaseLayout
  title="Capture Create Caffeinate · HEY_THISISANDREW"
  description="Capture Create Caffeinate: content that brings people through your door. Hospitality photography and video for bars, restaurants, and events."
>
  <div class="container">
    <section class="hub-hero" aria-labelledby="hub-heading">
      <p class="hub-kicker">Bars · Restaurants · Events · A Hey This Is Andrew lane</p>
      <div class="hub-lockup">
        <Image class="hub-logo" src={cccLogo} alt="Capture Create Caffeinate logo" widths={[220, 440]} sizes="220px" format="webp" />
      </div>
      <h1 class="hub-headline" id="hub-heading">CONTENT THAT BRINGS PEOPLE THROUGH YOUR DOOR</h1>
      <p class="hub-deck">
        People decide with their eyes. One shoot, everywhere you post.
        Four hours, no disruption.
      </p>
      <p class="hub-actions">
        <a class="hub-cta" href="https://the.fotoapp.co/capturecreatecaffeinate" target="_blank" rel="noopener">
          Visit Capture Create Caffeinate
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M1 11L11 1M11 1H3M11 1V9" stroke="currentColor" stroke-width="1.5" />
          </svg>
        </a>
        <a class="hub-inquiry" href={`mailto:${INQUIRY_EMAIL}?subject=${SUBJECT}`}>
          Book a shoot <span aria-hidden="true">→</span>
        </a>
      </p>
    </section>

    <section class="hub-media" aria-label="Capture Create Caffeinate still">
      <Image src={cccMedia} alt="A pour captured for Capture Create Caffeinate" widths={[640, 960, 1280, 1600]} sizes="(max-width: 72rem) 100vw, 72rem" format="webp" loading="lazy" />
    </section>

    <section class="hub-about" aria-labelledby="hub-about-heading">
      <SectionHeader
        id="hub-about-heading"
        index="01"
        kicker="The brand"
        title="What it does"
        lede="Hospitality content, built for the feed and the front door."
      />
      <ul class="hub-offers">
        {OFFERS.map((o) => (
          <li class="hub-offer">
            <h3 class="hub-offer-title">{o.title}</h3>
            <p class="hub-offer-desc">{o.desc}</p>
          </li>
        ))}
      </ul>
      <div class="hub-copy">
        <p>
          Capture Create Caffeinate is a hospitality content brand for bars,
          restaurants, and events. The work is photography and short-form
          video that makes a room look like the best version of itself,
          delivered fast enough to post the same week.
        </p>
        <p>
          Every shoot is built around one idea: your food and drinks are the
          marketing. Great photos are presented as the photographer's work,
          never as the kitchen's claim.
        </p>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .hub-hero {
    padding-top: clamp(3rem, 6vw, 5rem);
    padding-bottom: clamp(2rem, 4vw, 3rem);
    text-align: center;
    max-width: 56rem;
    margin-inline: auto;
  }

  .hub-kicker {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 1.75rem;
  }

  .hub-lockup {
    display: flex;
    justify-content: center;
    margin-bottom: 1.75rem;
  }

  .hub-logo {
    max-width: 220px;
    width: 60%;
    height: auto;
    display: block;
  }

  .hub-headline {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.2rem, 1.9vw + 1.6rem, 3.4rem);
    line-height: 1.06;
    letter-spacing: 0.01em;
    margin: 0 0 1.25rem;
  }

  .hub-deck {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.7;
    color: var(--muted);
    margin: 0 0 2rem;
  }

  .hub-actions {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    justify-content: center;
  }

  /* A brand CTA: the button standard's md size (@andrew/ui cta.css). */
  .hub-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: var(--btn-h-md);
    font-family: var(--font-mono);
    font-size: var(--btn-fs-md);
    letter-spacing: var(--btn-ls);
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
    border: 1px solid var(--line);
    border-radius: var(--btn-radius);
    padding: calc(8 * var(--ui-u)) var(--btn-px-md);
    transition: border-color 160ms ease, background 160ms ease;
  }

  .hub-cta:hover {
    border-color: var(--key);
    background: var(--surface);
  }

  /* The inquiry is the quieter, secondary action beside the brand's own
     (the button standard's text size: no box, a 44px hit area). */
  .hub-inquiry {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: var(--btn-hit);
    font-family: var(--font-mono);
    font-size: var(--btn-fs-md);
    letter-spacing: var(--btn-ls);
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 4px;
    transition: color 160ms ease, text-decoration-color 160ms ease;
  }

  .hub-inquiry:hover,
  .hub-inquiry:focus-visible {
    color: var(--ink);
    text-decoration-color: currentColor;
  }

  .hub-media {
    max-width: 72rem;
    margin: 0 auto clamp(3rem, 6vw, 5rem);
  }

  .hub-media img {
    width: 100%;
    height: auto;
    display: block;
  }

  .hub-about {
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }

  .hub-offers {
    list-style: none;
    margin: 0 0 2.5rem;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }

  @media (min-width: 720px) {
    .hub-offers {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .hub-offer {
    background: var(--bg);
    padding: 1.5rem 1.25rem;
  }

  .hub-offer-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.15rem;
    margin: 0 0 0.5rem;
  }

  .hub-offer-desc {
    font-family: var(--font-body);
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--muted);
    margin: 0;
  }

  .hub-copy {
    max-width: 44rem;
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.75;
    color: var(--muted);
  }

  .hub-copy p {
    margin: 0 0 1.25rem;
  }
</style>
