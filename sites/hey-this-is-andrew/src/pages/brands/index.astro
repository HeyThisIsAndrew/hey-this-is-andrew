---
/** Full-height brand cards in a single viewport deck. */
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { childBrands } from '../../data/brands';
import { homeUrl } from '../../data/nav';
import type { ImageMetadata } from 'astro';
import type { RemoteImage } from '@andrew/ui/types';

const sources = (image: ImageMetadata | RemoteImage) =>
  'remote' in image ? { src: image.src, width: image.width, height: image.height } : { src: image };
---

<BaseLayout
  title="Brands · HEY_THISISANDREW"
  description="Explore the brands Andrew is building: BE Unconventional HQ, Capture Create Caffeinate, and Sip the Magic."
>
  <link
    rel="preconnect"
    href="https://fonts.googleapis.com"
  />
  <link
    rel="preconnect"
    href="https://fonts.gstatic.com"
    crossorigin
  />
  <link
    href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800&family=Syncopate:wght@700&display=swap"
    rel="stylesheet"
  />

  <div class="brands-cinematic-wrap" data-brand-deck role="region" aria-labelledby="brands-deck-heading" aria-roledescription="carousel">
    <h1 class="vh" id="brands-deck-heading">Brands</h1>
    <div class="brand-tiles" data-brand-tiles>
      {childBrands.map((brand, i) => {
        const isComingSoon = Boolean(brand.comingSoon);
        const Tag = brand.url && !isComingSoon ? 'a' : 'article';
        const href = brand.id === 'ccc' ? `${homeUrl}ccc/` : brand.url;
        const visual = brand.mediaSrc ?? brand.logoSrc;
        return (
          <Tag
            class:list={['brand-tile', { 'is-link': Tag === 'a', 'is-coming-soon': isComingSoon }]}
            href={Tag === 'a' ? href : undefined}
            draggable="false"
            aria-label={Tag === 'a' ? `Explore ${brand.name}` : `${brand.name} - Coming Soon`}
            data-accent={brand.accent}
            data-brand-id={brand.id}
            data-depth={i}
          >
            <div class="brand-tile-visual" aria-hidden="true">
              {visual ? (
                <Image
                  {...sources(visual)}
                  alt=""
                  widths={[640, 960, 1280]}
                  sizes="(max-width: 1023px) 85vw, 33vw"
                  class="brand-tile-image"
                  loading={i === 0 ? 'eager' : 'lazy'}
                />
              ) : (
                <span class="brand-tile-teaser" set:html={brand.teaserSvg || ''} />
              )}
            </div>
            <div class="brand-tile-scrim" aria-hidden="true" />
            <div class="brand-tile-tint" aria-hidden="true" />
            <div class="brand-tile-tags" aria-hidden="true">
              <span class="brand-tag brand-tag--name">{brand.name}</span>
              <span class="brand-tag">{brand.kicker}</span>
            </div>
            <div class="brand-tile-footer">
              <div class:list={['brand-tile-brand', `brand-tile-brand--${brand.id}`]}>
                {brand.logoSrc && (
                  <div class="brand-logo-frame">
                    <Image
                      {...sources(brand.logoSrc)}
                      alt=""
                      widths={[160, 240, 360]}
                      sizes="(max-width: 899px) 160px, 220px"
                      class="brand-logo-img"
                    />
                  </div>
                )}
                {brand.id === 'be' && (
                  <span class="brand-door-wordmark font-be">BE UNCONVENTIONAL HQ</span>
                )}
                {brand.id === 'ccc' && (
                  <span class="brand-door-wordmark font-ccc">CAPTURE CREATE CAFFEINATE</span>
                )}
                {brand.id === 'sip-the-magic' && (
                  <span class="brand-door-wordmark font-stm">SIP THE MAGIC</span>
                )}
                {isComingSoon && (
                  <span class="brand-door-status font-mono">Coming Soon</span>
                )}
              </div>
            </div>
          </Tag>
        );
      })}
    </div>
    <div class="brand-deck-indicators" role="group" aria-label="Choose a brand">
      {childBrands.map((brand, i) => (
        <button type="button" class="brand-deck-indicator" data-brand-index={i} aria-label={brand.name} aria-current={i === 0 ? 'true' : undefined}></button>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .brands-cinematic-wrap {
    --peek-room: clamp(34px, 5vw, 56px);
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    justify-items: center;
    flex: 1 1 0%;
    min-height: 0;
    padding: 15px 16px 0;
    box-sizing: border-box;
  }

  .brand-tiles {
    position: relative;
    isolation: isolate;
    width: min(100%, calc(450px + var(--peek-room)));
    min-height: 0;
    box-sizing: border-box;
    touch-action: pan-y pinch-zoom;
    user-select: none;
  }

  .brand-deck-indicators {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .brand-deck-indicator {
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
  }

  .brand-deck-indicator::before {
    content: '';
    width: 18px;
    height: 3px;
    background: currentColor;
  }

  .brand-deck-indicator:is([aria-current], :hover, :focus-visible) {
    color: #fff;
  }

  .brand-deck-indicator:focus-visible {
    outline: 2px solid var(--focus-ring, #fff);
    outline-offset: -4px;
  }

  .brand-tile {
    position: absolute;
    inset: 0 var(--peek-room) 0 0;
    overflow: hidden;
    border: 1px solid var(--line, rgba(255, 255, 255, 0.12));
    border-radius: 0;
    background: #080808;
    color: #f0f0f0;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    -webkit-tap-highlight-color: transparent;
    transition: border-color 0.3s ease, box-shadow 0.3s ease, transform 0.45s ease-in-out, opacity 0.45s ease-in-out;
  }

  .brand-tile[data-depth="0"] {
    z-index: 3;
    transform: translateX(var(--drag-x, 0px));
  }

  .brand-tile[data-depth="1"] {
    z-index: 2;
    transform: translateX(calc(var(--peek-room) * 0.65)) scale(0.96);
    opacity: 0.8;
    pointer-events: none;
  }

  .brand-tile[data-depth="2"] {
    z-index: 1;
    transform: translateX(calc(var(--peek-room) + 3%)) scale(0.94);
    opacity: 0.58;
    pointer-events: none;
  }

  .brand-tiles.is-dragging .brand-tile[data-depth="0"] {
    cursor: grabbing;
    transition: none;
  }

  .brand-tile.is-link {
    cursor: pointer;
  }

  .brand-tile.is-coming-soon {
    cursor: default;
  }

  a.brand-tile:focus-visible {
    outline: 2px solid var(--focus-ring, #ffffff);
    outline-offset: 4px;
  }

  .brand-tile-visual {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    overflow: hidden;
  }

  .brand-tile-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .brand-tile-teaser {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    background: radial-gradient(circle at center, #18181f 0%, #0a0a0d 70%);
    color: #888888;
    padding: 2rem;
    box-sizing: border-box;
  }

  .brand-tile-teaser :global(svg) {
    width: clamp(100px, 10vw, 150px);
    height: clamp(100px, 10vw, 150px);
    opacity: 0.45;
  }

  .brand-tile-image,
  .brand-tile-teaser {
    transition: transform 0.8s cubic-bezier(0.25, 1, 0.5, 1), filter 0.4s ease;
  }

  .brand-tile:is(:hover, :focus-visible) :is(.brand-tile-image, .brand-tile-teaser) {
    transform: scale(1.03);
  }

  .brand-tile-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.78) 0%,
      rgba(0, 0, 0, 0.12) 35%,
      rgba(0, 0, 0, 0.25) 60%,
      rgba(0, 0, 0, 0.9) 100%
    );
  }

  .brand-tile-tint {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    opacity: 0.75;
    transition: opacity 0.4s ease;
  }

  .brand-tile[data-accent="be-red"] {
    --brand-rgb: 230, 0, 0;
  }

  .brand-tile[data-accent="ccc-gold"] {
    --brand-rgb: 201, 169, 110;
  }

  .brand-tile[data-accent="slate"] {
    --brand-rgb: 130, 130, 160;
    --tint-opacity: 0.2;
  }

  .brand-tile-tint {
    background: radial-gradient(circle at 50% 100%, rgba(var(--brand-rgb, 245, 245, 245), var(--tint-opacity, 0.28)) 0%, transparent 68%);
  }

  .brand-tile:is(:hover, :focus-visible) .brand-tile-tint {
    opacity: 1;
  }

  .brand-tile:is(:hover, :focus-visible) {
    border-color: rgba(var(--brand-rgb, 245, 245, 245), 0.65);
    box-shadow: 0 0 30px rgba(var(--brand-rgb, 245, 245, 245), 0.28);
  }

  /* Metadata tags in upper left corner */
  .brand-tile-tags {
    position: absolute;
    top: clamp(1.25rem, 2.2vw, 2rem);
    left: clamp(1.25rem, 2.2vw, 2rem);
    right: clamp(1.25rem, 2.2vw, 2rem);
    z-index: 3;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .brand-tag {
    display: inline-flex;
    align-items: center;
    max-width: 100%;
    box-sizing: border-box;
    padding: 0.35rem 0.65rem;
    border: 1px solid rgba(255, 255, 255, 0.15);
    background: rgba(10, 10, 10, 0.65);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: rgba(255, 255, 255, 0.75);
    font-family: var(--font-body, sans-serif);
    font-weight: 600;
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    line-height: 1.2;
    white-space: normal;
    overflow-wrap: break-word;
  }

  .brand-tag--name {
    border-left: 2px solid #f0f0f0;
    color: rgba(255, 255, 255, 0.95);
  }

  [data-brand-id="be"] .brand-tag--name {
    border-left-color: var(--be-red, #e60000);
  }

  [data-brand-id="ccc"] .brand-tag--name {
    border-left-color: var(--ccc-gold, #c9a96e);
  }

  [data-brand-id="ccc"] .brand-tag:not(.brand-tag--name) {
    color: var(--ccc-gold, #c9a96e);
  }

  [data-brand-id="sip-the-magic"] .brand-tag--name {
    border-left-color: rgba(255, 255, 255, 0.6);
  }

  /* Brand logo and wordmark in lower left corner */
  .brand-tile-footer {
    position: absolute;
    bottom: clamp(1.5rem, 2.5vw, 2.25rem);
    left: clamp(1.5rem, 2.5vw, 2.25rem);
    right: clamp(1.5rem, 2.5vw, 2.25rem);
    z-index: 3;
    pointer-events: none;
  }

  .brand-tile-brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .brand-logo-frame {
    max-height: 48px;
    display: flex;
    align-items: flex-end;
  }

  .brand-logo-img {
    max-height: 48px;
    width: auto;
    max-width: 200px;
    object-fit: contain;
    object-position: left bottom;
    display: block;
    filter: drop-shadow(0 2px 10px rgba(0, 0, 0, 0.8));
  }

  .brand-door-wordmark {
    display: block;
    line-height: 1.15;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.9);
  }

  .font-be {
    font-family: 'Syncopate', sans-serif;
    font-weight: 700;
    font-size: clamp(0.85rem, 1.1vw, 1.15rem);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #ffffff;
  }

  .font-ccc {
    font-family: 'Cinzel', Georgia, serif;
    font-weight: 700;
    font-size: clamp(0.95rem, 1.2vw, 1.25rem);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ccc-gold, #c9a96e);
  }

  .font-stm {
    font-family: 'Cinzel', Georgia, serif;
    font-weight: 700;
    font-size: clamp(1rem, 1.25vw, 1.35rem);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #f0f0f0;
  }

  .brand-door-status {
    padding: 0.25rem 0.55rem;
    border: 1px solid rgba(255, 255, 255, 0.28);
    background: rgba(10, 10, 10, 0.65);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: #dedede;
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-top: 0.25rem;
  }

  :global(body:has(.brands-cinematic-wrap) .client-work-footer-contact),
  :global(body:has(.brands-cinematic-wrap) #scroll-progress) {
    display: none !important;
  }

  :global(html:has(.brands-cinematic-wrap)),
  :global(body:has(.brands-cinematic-wrap)) {
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    scrollbar-gutter: auto;
  }

  :global(body:has(.brands-cinematic-wrap) .site-camera-stage),
  :global(body:has(.brands-cinematic-wrap) #main-content) {
    flex: 1 1 0%;
    min-height: 0;
    overflow: clip;
    display: flex;
    flex-direction: column;
  }

  :global(body:has(.brands-cinematic-wrap) .site-footer) {
    margin-top: 0;
    padding: 0.75rem clamp(1.5rem, 3vw, 3rem);
    flex-shrink: 0;
    border-top: 1px solid var(--line, rgba(255, 255, 255, 0.08));
  }

  :global(body:has(.brands-cinematic-wrap) .footer-inner) {
    gap: 1.5rem;
    padding-bottom: 0;
  }

  :global(body:has(.brands-cinematic-wrap) .footer-bottom) {
    margin-top: 0.5rem;
    padding-top: 0.4rem;
  }

  @media (max-width: 1023px) {
    .brands-cinematic-wrap {
      padding-top: 12px;
    }

    .brand-tiles {
      max-height: clamp(480px, 72dvh, 600px);
      align-self: center;
      height: 100%;
    }

    :global(body:has(.brands-cinematic-wrap) .site-footer) {
      padding: 0 10px 8px;
    }

    :global(body:has(.brands-cinematic-wrap) .footer-inner) {
      display: block;
    }

    :global(body:has(.brands-cinematic-wrap) :is(.footer-brand, .footer-nav, .footer-label, .footer-bottom > p:nth-child(n + 3))) {
      display: none;
    }

    :global(body:has(.brands-cinematic-wrap) .footer-socials-col) {
      max-width: none;
      width: 100%;
    }

    :global(#site:has(.brands-cinematic-wrap) .socials) {
      gap: 0;
      max-width: none;
      width: 100%;
    }

    :global(body:has(.brands-cinematic-wrap) .footer-bottom) {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: center;
      gap: 4px 12px;
      margin-top: 0;
      padding-top: 0;
    }

    :global(body:has(.brands-cinematic-wrap) .footer-legal-links) {
      gap: 8px;
    }
  }

  @media (min-width: 1024px) {
    .brands-cinematic-wrap {
      display: flex;
      flex-direction: column;
      flex: 1 1 0%;
      min-height: 0;
      width: 100%;
      padding: 15px 3vw;
      box-sizing: border-box;
    }

    .brand-tiles {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2.5vw;
      width: 100%;
      max-width: none;
      flex: 1 1 0%;
      min-height: 0;
      height: 100%;
      touch-action: auto;
      user-select: auto;
    }

    .brand-tile,
    .brand-tile[data-depth="0"],
    .brand-tile[data-depth="1"],
    .brand-tile[data-depth="2"] {
      position: relative;
      inset: auto;
      z-index: 1;
      width: 100%;
      height: 100%;
      min-height: 0;
      transform: none;
      opacity: 1;
      pointer-events: auto;
    }

    .brand-deck-indicators {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .brand-tile,
    .brand-tile-image,
    .brand-tile-teaser,
    .brand-tile-tint {
      transition: none;
    }
  }
</style>

<script>
  import { createPageScope } from '@andrew/ui/scripts/page-scope.ts';

  function initBrandDeck() {
    const root = document.querySelector<HTMLElement>('[data-brand-deck]');
    const stack = root?.querySelector<HTMLElement>('[data-brand-tiles]');
    if (!root || !stack || root.dataset.ready) return;
    root.dataset.ready = 'true';

    const cards = Array.from(stack.querySelectorAll<HTMLElement>('.brand-tile'));
    const indicators = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-brand-index]'));
    if (cards.length < 2) return;

    const { on } = createPageScope(root);
    const desktopMq = window.matchMedia('(min-width: 1024px)');
    let active = 0;
    let drag: { id: number; x: number; y: number; started: boolean } | null = null;
    let suppressClick = false;

    function syncInert() {
      cards.forEach((card, i) => {
        card.inert = !desktopMq.matches && i !== active;
      });
    }

    function showCard(index: number) {
      const next = (index + cards.length) % cards.length;
      const moveFocus = cards[active].contains(document.activeElement);
      active = next;
      cards.forEach((card, i) => {
        card.dataset.depth = String((i - active + cards.length) % cards.length);
      });
      syncInert();
      indicators.forEach((indicator, i) => {
        if (i === active) indicator.setAttribute('aria-current', 'true');
        else indicator.removeAttribute('aria-current');
      });
      if (moveFocus) indicators[active].focus({ preventScroll: true });
    }

    syncInert();
    on(desktopMq, 'change', syncInert);
    on(window, 'resize', syncInert, { passive: true });

    indicators.forEach((indicator, i) => on(indicator, 'click', () => showCard(i)));

    on(document, 'keydown', (event) => {
      if (desktopMq.matches) return;
      if (event.defaultPrevented || event.altKey || event.ctrlKey || event.metaKey) return;
      if (document.documentElement.matches('.menu-open, .modal-open')) return;
      if (!(event.target instanceof HTMLElement)) return;
      if (!root.contains(event.target) && !event.target.matches('body, #main-content')) return;
      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
      event.preventDefault();
      showCard(active + (event.key === 'ArrowRight' ? 1 : -1));
    });

    on(stack, 'dragstart', (event) => event.preventDefault());

    on(stack, 'pointerdown', (event) => {
      if (desktopMq.matches) return;
      if (!event.isPrimary || event.button !== 0) return;
      suppressClick = false;
      drag = { id: event.pointerId, x: event.clientX, y: event.clientY, started: false };
    });

    on(window, 'pointermove', (event) => {
      if (!drag || drag.id !== event.pointerId) return;
      const dx = event.clientX - drag.x;
      if (!drag.started) {
        if (Math.abs(dx) < 10 || Math.abs(dx) <= Math.abs(event.clientY - drag.y)) return;
        drag.started = true;
        suppressClick = true;
        stack.setPointerCapture(event.pointerId);
        stack.classList.add('is-dragging');
      }
      stack.style.setProperty('--drag-x', `${Math.max(-80, Math.min(80, dx * 0.55))}px`);
    });

    const finishDrag = (event: PointerEvent) => {
      if (!drag || drag.id !== event.pointerId) return;
      const dx = event.clientX - drag.x;
      if (event.type === 'pointerup' && drag.started && Math.abs(dx) >= 40) {
        showCard(active + (dx < 0 ? 1 : -1));
      }
      drag = null;
      stack.classList.remove('is-dragging');
      stack.style.removeProperty('--drag-x');
    };

    on(window, 'pointerup', finishDrag);
    on(window, 'pointercancel', finishDrag);
    on(stack, 'click', (event) => {
      if (!suppressClick || event.detail === 0) return;
      event.preventDefault();
      event.stopPropagation();
    }, true);
  }

  initBrandDeck();
  document.addEventListener('astro:page-load', initBrandDeck);
</script>
