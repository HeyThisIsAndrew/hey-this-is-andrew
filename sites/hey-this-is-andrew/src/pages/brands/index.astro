---
/** The three brand cards rendered as full-height cinematic doors into each brand. */
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { childBrands } from '../../data/brands';
import { homeUrl } from '../../data/nav';
import type { ImageMetadata } from 'astro';
import type { RemoteImage } from '@andrew/ui/types';

const sources = (image: ImageMetadata | RemoteImage) =>
  'remote' in image ? { src: image.src, width: image.width, height: image.height } : { src: image };
---

<BaseLayout
  title="Brands · HEY_THISISANDREW"
  description="Explore the brands Andrew is building: BE Unconventional HQ, Capture Create Caffeinate, and Sip the Magic."
>
  <link
    rel="preconnect"
    href="https://fonts.googleapis.com"
  />
  <link
    rel="preconnect"
    href="https://fonts.gstatic.com"
    crossorigin
  />
  <link
    href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800&family=Syncopate:wght@700&display=swap"
    rel="stylesheet"
  />

  <div class="brands-cinematic-wrap">
    <h1 class="vh">Brands</h1>
    <div class="brand-tiles" data-brand-tiles>
      {childBrands.map((brand, i) => {
        const isComingSoon = Boolean(brand.comingSoon);
        const Tag = brand.url && !isComingSoon ? 'a' : 'article';
        const href = brand.id === 'ccc' ? `${homeUrl}ccc/` : brand.url;
        const visual = brand.mediaSrc ?? brand.logoSrc;
        return (
          <Tag
            class:list={['brand-tile', { 'is-link': Tag === 'a', 'is-coming-soon': isComingSoon }]}
            href={Tag === 'a' ? href : undefined}
            aria-label={Tag === 'a' ? `Explore ${brand.name}` : `${brand.name} - Coming Soon`}
            data-accent={brand.accent}
            data-brand-id={brand.id}
          >
            <div class="brand-tile-visual" aria-hidden="true">
              {visual ? (
                <Image
                  {...sources(visual)}
                  alt=""
                  widths={[640, 960, 1280]}
                  sizes="(max-width: 899px) 100vw, 33vw"
                  class="brand-tile-image"
                  loading={i === 0 ? 'eager' : 'lazy'}
                />
              ) : (
                <span class="brand-tile-teaser" set:html={brand.teaserSvg || ''} />
              )}
            </div>
            <div class="brand-tile-scrim" aria-hidden="true" />
            <div class="brand-tile-tint" aria-hidden="true" />
            <div class="brand-tile-tags" aria-hidden="true">
              <span class="brand-tag brand-tag--name">{brand.name}</span>
              <span class="brand-tag">{brand.kicker}</span>
            </div>
            <div class="brand-tile-footer">
              <div class:list={['brand-tile-brand', `brand-tile-brand--${brand.id}`]}>
                {brand.logoSrc && (
                  <div class="brand-logo-frame">
                    <Image
                      {...sources(brand.logoSrc)}
                      alt=""
                      widths={[160, 240, 360]}
                      sizes="(max-width: 899px) 160px, 220px"
                      class="brand-logo-img"
                    />
                  </div>
                )}
                {brand.id === 'be' && (
                  <span class="brand-door-wordmark font-be">BE UNCONVENTIONAL HQ</span>
                )}
                {brand.id === 'ccc' && (
                  <span class="brand-door-wordmark font-ccc">CAPTURE CREATE CAFFEINATE</span>
                )}
                {brand.id === 'sip-the-magic' && (
                  <span class="brand-door-wordmark font-stm">SIP THE MAGIC</span>
                )}
                {isComingSoon && (
                  <span class="brand-door-status font-mono">Coming Soon</span>
                )}
              </div>
            </div>
          </Tag>
        );
      })}
    </div>
  </div>
</BaseLayout>

<style>
  .brands-cinematic-wrap {
    width: 100%;
    box-sizing: border-box;
  }

  .brand-tiles {
    display: grid;
    box-sizing: border-box;
  }

  .brand-tile {
    position: relative;
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--line, rgba(255, 255, 255, 0.12));
    background: #080808;
    color: #f0f0f0;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    -webkit-tap-highlight-color: transparent;
    transition: border-color 0.3s ease, box-shadow 0.3s ease, transform 0.3s ease;
  }

  .brand-tile.is-link {
    cursor: pointer;
  }

  .brand-tile.is-coming-soon {
    cursor: default;
  }

  a.brand-tile:focus-visible {
    outline: 2px solid var(--focus-ring, #ffffff);
    outline-offset: 4px;
  }

  .brand-tile-visual {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    overflow: hidden;
  }

  .brand-tile-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.8s cubic-bezier(0.25, 1, 0.5, 1), filter 0.4s ease;
  }

  a.brand-tile:hover .brand-tile-image {
    transform: scale(1.03);
  }

  .brand-tile-teaser {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    background: radial-gradient(circle at center, #18181f 0%, #0a0a0d 70%);
    color: #888888;
    padding: 2rem;
    box-sizing: border-box;
  }

  .brand-tile-teaser :global(svg) {
    width: clamp(100px, 10vw, 150px);
    height: clamp(100px, 10vw, 150px);
    opacity: 0.45;
  }

  .brand-tile-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.78) 0%,
      rgba(0, 0, 0, 0.12) 35%,
      rgba(0, 0, 0, 0.25) 60%,
      rgba(0, 0, 0, 0.9) 100%
    );
  }

  .brand-tile-tint {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    opacity: 0.75;
    transition: opacity 0.4s ease;
  }

  [data-brand-id="be"] .brand-tile-tint {
    background: radial-gradient(circle at 50% 100%, rgba(230, 0, 0, 0.28) 0%, transparent 68%);
  }

  [data-brand-id="ccc"] .brand-tile-tint {
    background: radial-gradient(circle at 50% 100%, rgba(201, 169, 110, 0.28) 0%, transparent 68%);
  }

  [data-brand-id="sip-the-magic"] .brand-tile-tint {
    background: radial-gradient(circle at 50% 100%, rgba(130, 130, 160, 0.2) 0%, transparent 68%);
  }

  a.brand-tile:hover .brand-tile-tint {
    opacity: 1;
  }

  a.brand-tile[data-brand-id="be"]:hover {
    border-color: rgba(230, 0, 0, 0.65);
    box-shadow: 0 0 30px rgba(230, 0, 0, 0.28);
  }

  a.brand-tile[data-brand-id="ccc"]:hover {
    border-color: rgba(201, 169, 110, 0.65);
    box-shadow: 0 0 30px rgba(201, 169, 110, 0.28);
  }

  /* Metadata tags in upper left corner */
  .brand-tile-tags {
    position: absolute;
    top: clamp(1.25rem, 2.2vw, 2rem);
    left: clamp(1.25rem, 2.2vw, 2rem);
    z-index: 3;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .brand-tag {
    display: inline-flex;
    align-items: center;
    padding: 0.35rem 0.65rem;
    border: 1px solid rgba(255, 255, 255, 0.15);
    background: rgba(10, 10, 10, 0.65);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: rgba(255, 255, 255, 0.75);
    font-family: var(--font-body, sans-serif);
    font-weight: 600;
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    line-height: 1.2;
  }

  .brand-tag--name {
    border-left: 2px solid #f0f0f0;
    color: rgba(255, 255, 255, 0.95);
  }

  [data-brand-id="be"] .brand-tag--name {
    border-left-color: var(--be-red, #e60000);
  }

  [data-brand-id="ccc"] .brand-tag--name {
    border-left-color: var(--ccc-gold, #c9a96e);
  }

  [data-brand-id="ccc"] .brand-tag:not(.brand-tag--name) {
    color: var(--ccc-gold, #c9a96e);
  }

  [data-brand-id="sip-the-magic"] .brand-tag--name {
    border-left-color: rgba(255, 255, 255, 0.6);
  }

  /* Brand logo and wordmark in lower left corner */
  .brand-tile-footer {
    position: absolute;
    bottom: clamp(1.5rem, 2.5vw, 2.25rem);
    left: clamp(1.5rem, 2.5vw, 2.25rem);
    right: clamp(1.5rem, 2.5vw, 2.25rem);
    z-index: 3;
    pointer-events: none;
  }

  .brand-tile-brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .brand-logo-frame {
    max-height: 48px;
    display: flex;
    align-items: flex-end;
  }

  .brand-logo-img {
    max-height: 48px;
    width: auto;
    max-width: 200px;
    object-fit: contain;
    object-position: left bottom;
    display: block;
    filter: drop-shadow(0 2px 10px rgba(0, 0, 0, 0.8));
  }

  .brand-door-wordmark {
    display: block;
    line-height: 1.15;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.9);
  }

  .font-be {
    font-family: 'Syncopate', sans-serif;
    font-weight: 700;
    font-size: clamp(0.85rem, 1.1vw, 1.15rem);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #ffffff;
  }

  .font-ccc {
    font-family: 'Cinzel', Georgia, serif;
    font-weight: 700;
    font-size: clamp(0.95rem, 1.2vw, 1.25rem);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ccc-gold, #c9a96e);
  }

  .font-stm {
    font-family: 'Cinzel', Georgia, serif;
    font-weight: 700;
    font-size: clamp(1rem, 1.25vw, 1.35rem);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #f0f0f0;
  }

  .brand-door-status {
    padding: 0.25rem 0.55rem;
    border: 1px solid rgba(255, 255, 255, 0.28);
    background: rgba(10, 10, 10, 0.65);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: #dedede;
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-top: 0.25rem;
  }

  /* Remove the Work With Me footer button from the brands page */
  :global(body:has(.brands-cinematic-wrap) .client-work-footer-contact) {
    display: none !important;
  }

  /* Desktop layout: full height viewport, side by side pillars, no scroll */
  @media (min-width: 900px) {
    :global(html:has(.brands-cinematic-wrap)),
    :global(body:has(.brands-cinematic-wrap)) {
      height: 100vh;
      height: 100dvh;
      max-height: 100dvh;
      overflow: hidden;
    }

    :global(body:has(.brands-cinematic-wrap) .site-camera-stage) {
      flex: 1 1 0%;
      min-height: 0;
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }

    :global(body:has(.brands-cinematic-wrap) #main-content) {
      flex: 1 1 0%;
      min-height: 0;
      height: 100%;
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }

    :global(body:has(.brands-cinematic-wrap) .site-footer) {
      margin-top: 0;
      padding: 0.75rem clamp(1.5rem, 3vw, 3rem);
      flex-shrink: 0;
      border-top: 1px solid var(--line, rgba(255, 255, 255, 0.08));
    }

    :global(body:has(.brands-cinematic-wrap) .footer-inner) {
      gap: 1.5rem;
    }

    :global(body:has(.brands-cinematic-wrap) .footer-bottom) {
      margin-top: 0.5rem;
      padding-top: 0.4rem;
    }

    .brands-cinematic-wrap {
      flex: 1 1 0%;
      min-height: 0;
      height: 100%;
      display: flex;
      flex-direction: column;
    }

    .brand-tiles {
      flex: 1 1 0%;
      min-height: 0;
      height: 100%;
      width: 100%;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.25rem;
      padding: 1.25rem clamp(1.25rem, 3vw, 2.5rem);
      max-width: 1800px;
      margin: 0 auto;
    }

    .brand-tile {
      height: 100%;
      min-height: 0;
      border-radius: 4px;
    }
  }

  /* Mobile layout: stacked cinematic cards, full width, natural scroll */
  @media (max-width: 899px) {
    .brands-cinematic-wrap {
      width: 100%;
      padding: 1.25rem 1rem 3rem;
      max-width: 620px;
      margin: 0 auto;
    }

    .brand-tiles {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
      width: 100%;
    }

    .brand-tile {
      width: 100%;
      min-height: clamp(480px, 72vh, 600px);
      height: clamp(480px, 72vh, 600px);
      border-radius: 6px;
    }
  }
</style>
