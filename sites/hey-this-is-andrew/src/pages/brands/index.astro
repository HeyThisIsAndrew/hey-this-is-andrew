---
/** The three brand tiles share content rows; brand artwork stays inside its visual area. */
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { childBrands } from '../../data/brands';
import { homeUrl } from '../../data/nav';
import type { ImageMetadata } from 'astro';
import type { RemoteImage } from '@andrew/ui/types';
const sources = (image: ImageMetadata | RemoteImage) => 'remote' in image ? { src: image.src, width: image.width, height: image.height } : { src: image };
---
<BaseLayout title="Brands · HEY_THISISANDREW" description="Explore the brands Andrew is building: BE Unconventional HQ, Capture Create Caffeinate, and Sip the Magic.">
  <section class="brands-overview" aria-labelledby="brands-title">
    <header class="brands-intro"><p class="font-mono">The lanes</p><h1 id="brands-title">Brands</h1><p>Different worlds. One creator.</p></header>
    <div class="brand-tiles" data-brand-tiles>
      {childBrands.map((brand, i) => {
        const Tag = brand.url && !brand.comingSoon ? 'a' : 'article';
        const href = brand.id === 'ccc' ? `${homeUrl}ccc/` : brand.url;
        const visual = brand.id === 'be' ? brand.logoSrc : brand.mediaSrc;
        return (
          <Tag
            class="brand-tile reveal"
            href={Tag === 'a' ? href : undefined}
            aria-label={Tag === 'a' ? `Explore ${brand.name}` : undefined}
            data-accent={brand.accent}
            data-brand-id={brand.id}
            style={`--rd: ${i * 90}ms`}
          >
            <div class="brand-tile-tags">
              <span class="brand-tag brand-tag--name">{brand.name}</span>
              <span class="brand-tag">{brand.kicker}</span>
              {brand.comingSoon && <span class="brand-status">Coming Soon</span>}
            </div>
            <div class="brand-tile-visual" aria-hidden="true">
              {visual ? (
                <Image {...sources(visual)} alt="" widths={[480, 800, 1200]} sizes="(max-width: 767px) 92vw, 32vw" class:list={['brand-tile-image', { 'brand-tile-image--logo': brand.id === 'be' }]} />
              ) : <span class="brand-tile-teaser" set:html={brand.teaserSvg || ''} />}
            </div>
            <h2 class="brand-tile-heading">{brand.name}</h2>
            <p class="brand-tile-description">{brand.deck}</p>
            <div class="brand-tile-link-row">
              {!brand.comingSoon && <span class="brand-tile-action font-mono">Explore brand <span class="brand-tile-arrow" aria-hidden="true">↗</span></span>}
            </div>
          </Tag>
        );
      })}
    </div>
  </section>
</BaseLayout>
<style>
  .brands-overview { width: var(--page-max); max-width: 1800px; margin: 0 auto; padding: clamp(2rem, 5vw, 5rem) 0 2rem; }
  .brands-intro { margin-bottom: 2rem; }
  .brands-intro > .font-mono { color: var(--muted); text-transform: uppercase; letter-spacing: 0.15em; font-size: 0.75rem; }
  .brands-intro h1 { font-size: clamp(2.8rem, 6vw, 5.5rem); margin: 0.25rem 0; line-height: 1.05; }
  .brands-intro > p:last-child { color: var(--muted); }
  .brand-tiles { --brand-visual-size: clamp(9rem, 12vw, 12rem); display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; }
  .brand-tile {
    min-width: 0;
    display: grid;
    grid-row: span 5;
    grid-template-rows: subgrid;
    row-gap: 1.25rem;
    padding: 1.5rem;
    border: 1px solid var(--line);
    background: #0a0a0a;
    color: #f0f0f0;
    text-decoration: none;
    overflow-wrap: anywhere;
    -webkit-tap-highlight-color: transparent;
  }
  /* These are the homepage panel's boxed metadata pills, without artwork behind them. */
  .brand-tile-tags { display: flex; align-content: start; align-items: start; flex-wrap: wrap; gap: calc(6.4 * var(--acc-u, 1px)); }
  .brand-tag {
    display: inline-block;
    max-width: 100%;
    padding: calc(5.12 * var(--acc-u, 1px)) calc(10.24 * var(--acc-u, 1px));
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(10, 10, 10, 0.55);
    color: rgba(255, 255, 255, 0.62);
    font: 600 calc(8.704 * var(--acc-u, 1px)) / 1.2 var(--font-body);
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .brand-tag--name { border-left: 2px solid var(--accordion-edge, #f0f0f0); color: rgba(255, 255, 255, 0.9); }
  [data-brand-id="ccc"] .brand-tag:not(.brand-tag--name) { color: var(--ccc-gold); }
  .brand-status { padding: 0.32rem 0.4rem; border: 1px solid rgba(255, 255, 255, 0.3); color: #f5f5f5; font: 600 0.625rem / 1.2 var(--font-body); letter-spacing: 0.05em; text-transform: none; }
  .brand-tile-visual { height: var(--brand-visual-size); display: grid; place-items: center; overflow: hidden; }
  .brand-tile-image { display: block; width: 100%; height: 100%; object-fit: cover; }
  .brand-tile-image--logo { width: min(80%, 240px); height: 100%; object-fit: contain; }
  .brand-tile-teaser { display: grid; place-items: center; width: var(--brand-visual-size); height: var(--brand-visual-size); color: #aaa; }
  .brand-tile-teaser :global(svg) { width: 100%; height: 100%; }
  .brand-tile-heading { align-self: start; margin: 0; font: 700 clamp(1.4rem, 2vw, 2rem) / 1.15 var(--font-body); text-transform: none; letter-spacing: 0.01em; }
  .brand-tile-description { align-self: start; margin: 0; max-width: 48ch; color: #bbb; font-size: 1rem; line-height: 1.6; }
  .brand-tile-link-row { min-height: 44px; display: flex; align-items: center; border-top: 1px solid #555; }
  .brand-tile-action { display: inline-flex; align-items: center; gap: 0.5em; font-size: 0.7rem; letter-spacing: 0.08em; text-transform: uppercase; }
  .brand-tile:focus-visible { outline-offset: 4px; }
  a.brand-tile:hover .brand-tile-action { text-decoration: underline; text-underline-offset: 4px; }
  /* The original centered Work With Me action stays directly below the cards. */
  :global(body:has(.brands-overview) .site-camera-stage) { flex: 0 0 auto; }
  :global(body:has(.brands-overview) .client-work-footer-contact) { padding-top: 0; }
  :global(body:has(.brands-overview) .site-footer) { margin-top: 2rem; }
  @media (max-width: 767px) {
    .brand-tiles { grid-template-columns: minmax(0, 1fr); }
    .brand-tile-tags { min-height: 4rem; }
    .brand-tag { font-size: 0.68rem; }
    .brand-tile-heading { min-height: 2.3em; }
    .brand-tile-description { min-height: 4.8em; }
  }
</style>
