---
/** The three brand cards rendered as full-bleed cinematic image cards with overlaid metadata. */
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { childBrands } from '../../data/brands';
import { homeUrl } from '../../data/nav';
import type { ImageMetadata } from 'astro';
import type { RemoteImage } from '@andrew/ui/types';
const sources = (image: ImageMetadata | RemoteImage) => 'remote' in image ? { src: image.src, width: image.width, height: image.height } : { src: image };
---
<BaseLayout title="Brands · HEY_THISISANDREW" description="Explore the brands Andrew is building: BE Unconventional HQ, Capture Create Caffeinate, and Sip the Magic.">
  <section class="brands-overview" aria-labelledby="brands-title">
    <header class="brands-intro"><h1 id="brands-title">Brands</h1><p>Different worlds. One creator.</p></header>
    <div class="brand-tiles" data-brand-tiles>
      {childBrands.map((brand, i) => {
        const Tag = brand.url && !brand.comingSoon ? 'a' : 'article';
        const href = brand.id === 'ccc' ? `${homeUrl}ccc/` : brand.url;
        const visual = brand.mediaSrc ?? brand.logoSrc;
        return (
          <Tag
            class="brand-tile reveal"
            href={Tag === 'a' ? href : undefined}
            aria-label={Tag === 'a' ? `Explore ${brand.name}` : undefined}
            data-accent={brand.accent}
            data-brand-id={brand.id}
            style={`--rd: ${i * 90}ms`}
          >
            <div class="brand-tile-visual" aria-hidden="true">
              {visual ? (
                <Image {...sources(visual)} alt="" widths={[480, 800, 1200]} sizes="(max-width: 767px) 92vw, 32vw" class="brand-tile-image" />
              ) : <span class="brand-tile-teaser" set:html={brand.teaserSvg || ''} />}
            </div>
            <div class="brand-tile-scrim" aria-hidden="true" />
            <div class="brand-tile-content">
              <div class="brand-tile-tags">
                <span class="brand-tag brand-tag--name">{brand.name}</span>
                <span class="brand-tag">{brand.kicker}</span>
              </div>
              <div class="brand-tile-body">
                <h2 class="brand-tile-heading">{brand.name}</h2>
                <p class="brand-tile-description">{brand.deck}</p>
                <div class="brand-tile-link-row">
                  {brand.comingSoon && <span class="brand-status">Coming Soon</span>}
                  {!brand.comingSoon && <span class="btn btn-primary brand-tile-action font-mono">Explore brand <span class="brand-tile-arrow" aria-hidden="true">↗</span></span>}
                </div>
              </div>
            </div>
          </Tag>
        );
      })}
    </div>
  </section>
</BaseLayout>
<style>
  .brands-overview { width: var(--page-max); max-width: 1800px; margin: 0 auto; padding: clamp(2rem, 5vw, 5rem) 0 2rem; }
  .brands-intro { margin-bottom: 2rem; }
  .brands-intro > .font-mono { color: var(--muted); text-transform: uppercase; letter-spacing: 0.15em; font-size: 0.75rem; }
  .brands-intro h1 { font-size: clamp(2.8rem, 6vw, 5.5rem); margin: 0.25rem 0; line-height: 1.05; }
  .brands-intro > p:last-child { color: var(--muted); }
  .brand-tiles { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; }
  .brand-tile {
    position: relative;
    min-width: 0;
    min-height: clamp(480px, 48vh, 580px);
    border: 1px solid var(--line, rgba(255, 255, 255, 0.12));
    background: #0a0a0a;
    color: #f0f0f0;
    text-decoration: none;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    -webkit-tap-highlight-color: transparent;
    transition: border-color 0.25s ease, transform 0.25s ease;
  }
  a.brand-tile:hover {
    border-color: rgba(255, 255, 255, 0.4);
    transform: translateY(-2px);
  }
  [data-brand-id="be"] a.brand-tile:hover {
    border-color: var(--hq-red, #cc0000);
  }
  .brand-tile-visual {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    overflow: hidden;
  }
  .brand-tile-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.8s cubic-bezier(0.25, 1, 0.5, 1), filter 0.4s ease;
  }
  a.brand-tile:hover .brand-tile-image {
    transform: scale(1.04);
  }
  .brand-tile-teaser {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    background: radial-gradient(circle at center, #1a1a1a 0%, #0a0a0a 70%);
    color: #888;
    padding: 2rem;
  }
  .brand-tile-teaser :global(svg) {
    width: clamp(120px, 12vw, 160px);
    height: clamp(120px, 12vw, 160px);
    opacity: 0.65;
  }
  .brand-tile-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.94) 0%,
      rgba(0, 0, 0, 0.72) 45%,
      rgba(0, 0, 0, 0.2) 75%,
      rgba(0, 0, 0, 0.55) 100%
    );
  }
  .brand-tile-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    box-sizing: border-box;
    flex: 1;
  }
  .brand-tile-tags {
    display: flex;
    align-content: start;
    align-items: start;
    flex-wrap: wrap;
    gap: calc(6.4 * var(--acc-u, 1px));
  }
  .brand-tag {
    display: inline-block;
    max-width: 100%;
    padding: calc(5.12 * var(--acc-u, 1px)) calc(10.24 * var(--acc-u, 1px));
    border: 1px solid rgba(255, 255, 255, 0.15);
    background: rgba(10, 10, 10, 0.65);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: rgba(255, 255, 255, 0.7);
    font: 600 calc(8.704 * var(--acc-u, 1px)) / 1.2 var(--font-body);
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .brand-tag--name {
    border-left: 2px solid var(--accordion-edge, #f0f0f0);
    color: rgba(255, 255, 255, 0.95);
  }
  [data-brand-id="be"] .brand-tag--name {
    border-left-color: var(--hq-red, #cc0000);
  }
  [data-brand-id="ccc"] .brand-tag:not(.brand-tag--name) {
    color: var(--ccc-gold, #c6a052);
  }
  .brand-tile-body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .brand-tile-heading {
    margin: 0;
    font: 800 clamp(1.4rem, 2vw, 1.9rem) / 1.15 var(--font-display, var(--font-body));
    color: #ffffff;
    letter-spacing: 0.01em;
  }
  .brand-tile-description {
    margin: 0;
    max-width: 44ch;
    color: rgba(240, 240, 240, 0.82);
    font-size: 0.95rem;
    line-height: 1.55;
  }
  .brand-tile-link-row {
    margin-top: 0.5rem;
    min-height: 44px;
    display: flex;
    align-items: center;
  }
  .brand-tile-action {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.55rem 1.25rem;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 600;
  }
  .brand-status {
    padding: 0.35rem 0.65rem;
    border: 1px solid rgba(255, 255, 255, 0.35);
    background: rgba(10, 10, 10, 0.65);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: #f5f5f5;
    font: 600 0.68rem / 1.2 var(--font-body);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .brand-tile:focus-visible { outline-offset: 4px; }
  /* The original centered Work With Me action stays directly below the cards. */
  :global(body:has(.brands-overview) .site-camera-stage) { flex: 0 0 auto; }
  :global(body:has(.brands-overview) .client-work-footer-contact) { padding-top: 0; }
  :global(body:has(.brands-overview) .site-footer) { margin-top: 2rem; }
  @media (max-width: 900px) {
    .brand-tiles { grid-template-columns: minmax(0, 1fr); gap: 1.25rem; }
    .brand-tile { min-height: 440px; }
  }
</style>
