---
/**
 * /brands/sip-the-magic/: Unlisted dev preview page for Sip the Magic.
 *
 * Excluded from HTML/XML sitemaps and navigation until launch, with
 * <meta name="robots" content="noindex, nofollow" /> via BaseLayout.
 * Uses the shared PhotoElevator full-scale directly under the hero and
 * includes only real photos from src/assets/sip-the-magic/ that exist.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PhotoElevator from '@andrew/ui/PhotoElevator.astro';
import SectionHeader from '@andrew/ui/SectionHeader.astro';

const SUPPLIED_PHOTOS = import.meta.glob<ImageMetadata>(
  '../../assets/sip-the-magic/*.{jpg,jpeg,png,webp}',
  { eager: true, import: 'default' },
);

const photoFor = (filename: string): ImageMetadata | undefined =>
  SUPPLIED_PHOTOS[`../../assets/sip-the-magic/${filename}`];

const heroFilename = 'king-arthur-carrousel.jpg';
const heroPhoto = photoFor(heroFilename);

const PHOTO_DIARY_SPECS = [
  {
    id: 'king-arthur-carrousel',
    filename: 'king-arthur-carrousel.jpg',
    caption: 'King Arthur Carrousel, Fantasyland, Mar 3, 2026, Sony A7C R, 16-35 GM II.',
    location: 'Fantasyland · Mar 3, 2026',
  },
  {
    id: 'flos-v8-cafe-carousel',
    filename: 'flos-v8-cafe-carousel.jpg',
    caption: "Flo's V8 Cafe, Cars Land, May 7, 2025, Sony A7C R, 16-35 GM II, Moment Cinebloom 20 percent.",
    location: 'Cars Land · May 7, 2025',
  },
  {
    id: 'flos-v8-cafe-single',
    filename: 'flos-v8-cafe-single.jpg',
    caption: "Flo's V8 Cafe, Cars Land, May 7, 2025 (single image).",
    location: 'Cars Land · May 7, 2025',
  },
  {
    id: 'disneyland-reintroduction',
    filename: 'disneyland-reintroduction.jpg',
    caption: '"Finally made it to Disneyland!" reintroduction, Apr 7, 2025.',
    location: 'Disneyland · Apr 7, 2025',
  },
] as const;

const elevatorPhotos = PHOTO_DIARY_SPECS.flatMap((entry) => {
  const image = photoFor(entry.filename);
  if (!image) return [];
  return [
    {
      id: entry.id,
      image,
      caption: entry.caption,
      category: 'disneyland',
      location: entry.location,
      video: false,
    },
  ];
});

const DRINK_DIARY_PLACES = [
  {
    name: 'Disneyland',
    status: 'Diary entries for Disneyland are coming.',
  },
  {
    name: 'Disney California Adventure',
    status: 'Diary entries for Disney California Adventure are coming.',
  },
  {
    name: 'Downtown Disney',
    status: 'Diary entries for Downtown Disney are coming.',
  },
] as const;

const YOUTUBE_CHANNEL_URL = 'https://www.youtube.com/@sipthemagic';

const SOCIAL_LINKS = [
  { label: 'Instagram', href: 'https://www.instagram.com/sipthemagic/' },
  { label: 'YouTube', href: YOUTUBE_CHANNEL_URL },
  { label: 'TikTok', href: 'https://www.tiktok.com/@sipthemagic' },
] as const;
---

<BaseLayout
  title="Sip the Magic · HEY_THISISANDREW"
  description="A Little Bit of Magic, A Lot of Booze. And Coffee! A Grown-Up's Guide to Disneyland."
  pane="Sip the Magic"
  topLabel="Overview"
  noindex={true}
>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800&display=swap"
    rel="stylesheet"
  />

  <div class="stm-page">
    <section id="hero" class="stm-hero" aria-labelledby="stm-hero-title" data-pn-top>
      <div class="stm-hero-media" aria-hidden="true">
        {heroPhoto ? (
          <Image
            src={heroPhoto}
            alt="King Arthur Carrousel, Fantasyland"
            widths={[640, 960, 1280, 1600, 2400]}
            sizes="100vw"
            class="stm-hero-img"
            loading="eager"
            fetchpriority="high"
          />
        ) : (
          <div class="stm-hero-pending" data-photo-pending={heroFilename}>
            <span class="stm-pending-badge font-mono">
              Hero photo pending: src/assets/sip-the-magic/{heroFilename}
            </span>
          </div>
        )}
        <div class="stm-hero-scrim"></div>
        <div class="stm-hero-tint"></div>
      </div>

      <div class="container stm-hero-inner">
        <p class="stm-wordmark">SIP THE MAGIC</p>
        <p class="stm-age-notice font-mono">21+ Drink Responsibly.</p>
        <h1 id="stm-hero-title" class="stm-hero-title">
          A Little Bit of Magic, A Lot of Booze. And Coffee!
        </h1>
        <p class="stm-hero-sub">A Grown-Up's Guide to Disneyland.</p>
      </div>
    </section>

    <div class="stm-elevator-wrap">
      <PhotoElevator
        photos={elevatorPhotos}
        kicker="Photography"
        title="The Disney Drink Diaries."
        lede="Disneyland photography. The work behind Sip the Magic."
        showBrandCredit={false}
      />
    </div>

    <section id="drink-diaries" class="stm-section section-hairline" aria-labelledby="stm-diaries-heading">
      <div class="container">
        <SectionHeader
          id="stm-diaries-heading"
          title="The Guide"
          lede="A guide to drinks at Disneyland, Disney California Adventure, and Downtown Disney."
        />

        <div class="stm-places-grid">
          {DRINK_DIARY_PLACES.map((place, index) => (
            <article class="stm-place-card">
              <span class="stm-place-index font-mono">0{index + 1}</span>
              <h3 class="stm-place-title">{place.name}</h3>
              <p class="stm-place-status">{place.status}</p>
            </article>
          ))}
        </div>
        <p class="stm-places-note">The photos above are the content for now.</p>
      </div>
    </section>

    <section id="video" class="stm-section section-hairline" aria-labelledby="stm-video-heading">
      <div class="container">
        <SectionHeader
          id="stm-video-heading"
          kicker="YouTube"
          title="Video"
        />

        <div class="stm-video-card">
          <div class="stm-video-copy">
            <span class="stm-video-kicker font-mono">@sipthemagic on YouTube</span>
            <h3 class="stm-video-title">
              Welcome To Sip The Magic! Live Photo Editing Session! + Disney Trip Recap!
            </h3>
          </div>
          <div class="stm-video-actions btn-group btn-group--row">
            <a
              class="btn btn-primary"
              href={YOUTUBE_CHANNEL_URL}
              target="_blank"
              rel="noopener noreferrer"
            >
              YouTube <span aria-hidden="true">&#8599;</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <section id="connect" class="stm-section section-hairline" aria-labelledby="stm-connect-heading">
      <div class="container">
        <SectionHeader
          id="stm-connect-heading"
          kicker="Connect"
          title="Socials & Contact"
        />

        <div class="stm-connect-grid">
          <div class="stm-connect-block">
            <h3 class="stm-block-heading font-mono">Social Channels</h3>
            <div class="stm-social-actions btn-group">
              {SOCIAL_LINKS.map((social) => (
                <a
                  class="btn btn-secondary"
                  href={social.href}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {social.label} <span aria-hidden="true">&#8599;</span>
                </a>
              ))}
            </div>
          </div>

          <div class="stm-connect-block stm-contact-block">
            <h3 class="stm-block-heading font-mono">Contact</h3>
            <p class="stm-contact-line">Available for collaborations</p>
            <div class="stm-contact-actions btn-group btn-group--row">
              <a class="btn btn-primary stm-email-btn" href="mailto:SipTheMagic@gmail.com">
                SipTheMagic@gmail.com
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .stm-page {
    --stm-rgb: 130, 130, 160;
    --stm-tint: rgba(130, 130, 160, 0.2);
    --stm-border: rgba(130, 130, 160, 0.35);
    --stm-ink-accent: #c7c7dc;
    color: var(--ink, #f5f5f5);
  }

  .stm-hero {
    position: relative;
    min-height: clamp(32rem, 72dvh, 48rem);
    padding-top: calc(var(--nav-h, 6.9rem) + clamp(3rem, 7vw, 5.5rem));
    padding-bottom: clamp(3.5rem, 7vw, 6rem);
    display: flex;
    align-items: flex-end;
    border-bottom: 1px solid var(--stm-border);
    background: #070709;
    overflow: hidden;
  }

  .stm-hero-media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .stm-hero-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    border-radius: 0;
  }

  .stm-hero-pending {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: flex-start;
    justify-content: flex-end;
    padding: calc(var(--nav-h, 6.9rem) + 1.25rem) clamp(1rem, 3vw, 2.5rem);
    background:
      linear-gradient(135deg, rgba(130, 130, 160, 0.2) 0%, rgba(12, 12, 16, 0.92) 55%, #070709 100%);
    box-sizing: border-box;
  }

  .stm-pending-badge {
    display: inline-block;
    padding: 0.4rem 0.7rem;
    border: 1px solid var(--stm-border);
    background: rgba(8, 8, 10, 0.85);
    color: var(--stm-ink-accent);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border-radius: 0;
  }

  .stm-hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.68) 0%,
      rgba(0, 0, 0, 0.28) 45%,
      rgba(0, 0, 0, 0.9) 100%
    );
    pointer-events: none;
  }

  .stm-hero-tint {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 22% 85%, rgba(130, 130, 160, 0.2) 0%, transparent 62%);
    pointer-events: none;
  }

  .stm-hero-inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }

  .stm-wordmark {
    margin: 0;
    font-family: 'Cinzel', Georgia, serif;
    font-weight: 700;
    font-size: clamp(1.15rem, 2.2vw, 1.85rem);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #f5f5f5;
  }

  .stm-age-notice {
    margin: 0;
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--stm-border);
    background: var(--stm-tint);
    color: #f5f5f5;
    font-size: 0.74rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    border-radius: 0;
  }

  .stm-hero-title {
    margin: 0;
    max-width: 24ch;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2rem, 4.8vw, 3.85rem);
    line-height: 1.04;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    color: #ffffff;
  }

  .stm-hero-sub {
    margin: 0;
    font-size: clamp(1.05rem, 1.5vw, 1.35rem);
    color: #dedee8;
    max-width: 48ch;
  }

  /* Full-scale edge-to-edge photo elevator section */
  .stm-elevator-wrap {
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--stm-border);
  }

  .stm-elevator-wrap :global(.photo-section) {
    width: 100%;
    max-width: none;
    margin: 0;
  }

  .stm-elevator-wrap :global(.photo-grid-container) {
    width: 100%;
    max-width: none;
    margin: 2rem 0 0;
    padding-inline: 0;
  }

  .stm-elevator-wrap :global(.photo-wall) {
    height: clamp(720px, 100vh, 2000px);
    min-height: 720px;
  }

  @media (prefers-reduced-motion: reduce) {
    .stm-elevator-wrap :global(.photo-wall) {
      height: auto;
      min-height: 0;
    }
  }

  .stm-section {
    padding-block: clamp(3.5rem, 7vw, 6rem);
  }

  .stm-places-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .stm-place-card {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: clamp(1.5rem, 2.5vw, 2.25rem);
    border: 1px solid var(--stm-border);
    background: linear-gradient(180deg, rgba(130, 130, 160, 0.12) 0%, #0b0b0e 100%);
    border-radius: 0;
  }

  .stm-place-index {
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    color: var(--stm-ink-accent);
  }

  .stm-place-title {
    margin: 0;
    font-family: 'Cinzel', Georgia, serif;
    font-weight: 700;
    font-size: clamp(1.25rem, 1.8vw, 1.65rem);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #ffffff;
  }

  .stm-place-status {
    margin: 0;
    color: var(--muted, #b5b5c0);
    line-height: 1.6;
  }

  .stm-places-note {
    margin: 1.5rem 0 0;
    color: var(--muted, #b5b5c0);
    font-size: 0.92rem;
  }

  .stm-video-card {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 2rem;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    border: 1px solid var(--stm-border);
    background: rgba(130, 130, 160, 0.12);
    border-radius: 0;
  }

  .stm-video-copy {
    flex: 1 1 28rem;
    min-width: 0;
  }

  .stm-video-kicker {
    display: block;
    margin-bottom: 0.55rem;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--stm-ink-accent);
  }

  .stm-video-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.15rem, 2vw, 1.65rem);
    line-height: 1.25;
    color: #ffffff;
  }

  .stm-video-actions {
    margin-inline: 0;
  }

  .stm-connect-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.75rem;
  }

  .stm-connect-block {
    padding: clamp(1.5rem, 2.5vw, 2.25rem);
    border: 1px solid var(--stm-border);
    background: #0b0b0e;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.15rem;
    border-radius: 0;
  }

  .stm-contact-block {
    background: linear-gradient(180deg, rgba(130, 130, 160, 0.16) 0%, #0b0b0e 100%);
  }

  .stm-block-heading {
    margin: 0;
    font-size: 0.74rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--stm-ink-accent);
  }

  .stm-social-actions,
  .stm-contact-actions {
    margin-inline: 0;
  }

  .stm-contact-line {
    margin: 0;
    font-size: 1.05rem;
    color: #f5f5f5;
  }

  .stm-email-btn {
    text-transform: none;
  }

  .stm-age-notice,
  .stm-place-card,
  .stm-video-actions .btn,
  .stm-social-actions .btn,
  .stm-contact-actions .btn {
    max-width: 100%;
    height: auto;
    white-space: normal;
    overflow-wrap: anywhere;
  }

  @media (max-width: 1180px) {
    .stm-connect-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 960px) {
    .stm-places-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .stm-social-actions,
    .stm-contact-actions,
    .stm-video-actions {
      width: 100%;
    }
  }
</style>
