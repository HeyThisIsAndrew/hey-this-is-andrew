---
/**
 * /brands/be-unconventional-hq/: BE Unconventional HQ brand showcase & hub page.
 *
 * Shares the scroll-driven card-stacking parallax, pinned subbar, and monorepo
 * @andrew/ui components (SectionHeader, FlipCard, PageNav) with /ccc/, themed
 * in BE Unconventional HQ's signature crimson-and-obsidian editorial palette.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '@andrew/ui/SectionHeader.astro';
import FlipCard from '@andrew/ui/FlipCard.astro';
import { Image } from 'astro:assets';

import logoMark from '../../assets/brands/hq/logo-mark.webp';
import heroStill from '../../assets/hero-media/be-hq-still.jpg';
import lanternsArt from '../../assets/brands/hq/lanterns-key-art.jpg';
import andrewHeadshot from '../../assets/brands/hq/andrew-headshot.webp';
import filmImg from '../../assets/brands/hq/movies.png';
import tvImg from '../../assets/brands/hq/tv.png';
import gamesImg from '../../assets/brands/hq/gaming.png';
import eventsImg from '../../assets/brands/hq/events.png';

const HQ_SITE_URL = 'https://beunconventionalhq.com/';
const HQ_YOUTUBE_URL = 'https://www.youtube.com/@BeUnconventionalHQ';
const HQ_SUBSTACK_URL = 'https://thisiscoffeetalk.substack.com/';
const HQ_PRESS_MAILTO = 'mailto:press@beunconventionalhq.com?subject=BE%20Unconventional%20HQ%20Press%20Inquiry';

const coverageLanes = [
  {
    title: 'Film',
    line: 'Reviews, cinematography breakdowns, and festival dispatches',
    img: filmImg,
    alt: 'Illustrated cinema camera and film reels for BE Unconventional HQ Film coverage',
  },
  {
    title: 'Television',
    line: 'Season coverage, streaming analysis, and showrunner craft',
    img: tvImg,
    alt: 'Illustrated television screen and broadcast visual for BE Unconventional HQ TV coverage',
  },
  {
    title: 'Games',
    line: 'Narrative design, technical performance, and industry analysis',
    img: gamesImg,
    alt: 'Illustrated controller and gaming emblem for BE Unconventional HQ Games coverage',
  },
  {
    title: 'Events',
    line: 'On-location reporting from premieres, showcases, and conventions',
    img: eventsImg,
    alt: 'Illustrated press credential and spotlight for BE Unconventional HQ Events coverage',
  },
];

const pillars = [
  {
    value: 'FILM \u00b7 TV \u00b7 GAMES',
    label: 'Coverage',
    desc: 'Reviews, analysis, and event reporting',
    backText:
      'Film, television, and games, plus on-location reporting from the premieres, festivals, and conventions where that work gets shown.',
    longValue: true,
  },
  {
    value: '2026',
    label: 'Founded',
    desc: 'Independent, no publisher',
    backText:
      'Founded in 2026 and run independently. No publisher, no network, and no editorial mandate from anyone else.',
  },
  {
    value: 'WEEKLY',
    label: 'Publishing Cadence',
    desc: 'New coverage every week',
    backText:
      'New written criticism and video coverage every week, so what we publish keeps pace with what is actually releasing.',
  },
  {
    value: '4K',
    label: 'Production Standard',
    desc: 'Sony Alpha, DaVinci Resolve, Shure',
    backText:
      'Shot on Sony Alpha bodies, recorded with Shure microphones, and graded in DaVinci Resolve. Finished in 4K.',
  },
];

const standards = [
  {
    n: '01',
    title: 'Editorial independence',
    body: 'Every review, essay, and dispatch is written without sponsor interference or publisher mandates.',
  },
  {
    n: '02',
    title: 'Full disclosure',
    body: 'Screeners, review copies, travel, and event credentials are always disclosed plainly on the record.',
  },
  {
    n: '03',
    title: 'Craft-first perspective',
    body: 'Informed by more than a decade in games and technology, including software engineering and QA at Sony Interactive Entertainment.',
  },
  {
    n: '04',
    title: 'Multi-platform publishing',
    body: 'Long-form essays and reviews on the web and Substack alongside 4K video breakdowns and shorts on YouTube, Instagram, and TikTok.',
  },
];
---

<BaseLayout
  title="BE Unconventional HQ · HEY_THISISANDREW"
  description="An independent small press publication covering film, television, games, and live events with a focus on the craft behind the stories."
  pane="BE Unconventional HQ"
  topLabel="Overview"
>
  <div class="page-head" aria-hidden="true"></div>

  <!-- Persistent Docked Top Bar -->
  <div id="hq-pinned-stack" class="hq-pinned-stack" aria-label="Quick return to top">
    <div class="hq-dock-row hq-dock-row--hero" data-target="hero">
      <button type="button" class="hq-dock-btn hq-dock-btn--hero" aria-label="Scroll back to top">
        <span class="hq-row-kicker font-mono">Film &middot; TV &middot; Games &middot; Events</span>
      </button>
    </div>
  </div>

  <!-- 00 Hero -->
  <section id="hero" class="hq-hero" aria-labelledby="hq-hero-title">
    <div class="hq-hero-bg" aria-hidden="true">
      <Image src={heroStill} alt="" widths={[640, 1280, 1920]} sizes="100vw" class="hq-hero-bg-img" loading="eager" />
    </div>
    <div class="container hq-hero-inner">
      <Image
        src={logoMark}
        alt="BE Unconventional HQ logo"
        width={300}
        densities={[1, 2]}
        class="hq-hero-logo"
        loading="eager"
        fetchpriority="high"
      />
      <p class="hq-hero-eyebrow font-mono">Independent Small Press</p>
      <h1 id="hq-hero-title" class="hq-hero-title">
        <span class="hq-hero-line">Where nerd culture</span><br /><span class="hq-hero-line">gets cinematic</span>
      </h1>
      <p class="hq-hero-sub">Film &middot; TV &middot; Games &middot; Events</p>
      <div class="hq-actions btn-group btn-group--row">
        <a class="btn btn-primary hq-btn-primary" href={HQ_SITE_URL} target="_blank" rel="noopener">
          Visit site <span aria-hidden="true">&#8599;</span>
        </a>
        <a class="btn btn-secondary hq-btn-secondary" href={HQ_YOUTUBE_URL} target="_blank" rel="noopener">
          YouTube <span aria-hidden="true">&#8599;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 01 The Publication -->
  <section id="mission" class="hq-section" aria-labelledby="hq-mission">
    <div class="container">
      <SectionHeader kicker="The publication" title="If we talk cinema, it should look like cinema" id="hq-mission" />
      <div class="hq-why-stage" id="hq-why-stage">
        <div class="hq-why-pair hq-why-pair--top" id="hq-why-top">
          <div class="hq-why-media">
            <Image
              src={heroStill}
              alt="Andrew Baxter in the studio recording for BE Unconventional HQ"
              widths={[640, 960, 1280]}
              sizes="(min-width: 900px) 48vw, 100vw"
              class="hq-photo"
            />
          </div>
          <div class="hq-why-copy">
            <h3 class="hq-subtitle">Built for the craft behind the stories</h3>
            <p>
              <strong>BE Unconventional HQ</strong> is an independent small press outlet covering film, television, games, and live events. From breaking down the cinematography of a new release to exploring game design and reporting on location, our goal is to slow down, appreciate the details, and have genuine conversations.
            </p>
          </div>
        </div>
        <div class="hq-why-pair hq-why-pair--bottom" id="hq-why-bottom">
          <div class="hq-why-copy">
            <h3 class="hq-subtitle">No clickbait, no artificial outrage</h3>
            <p>
              We operate without a parent network or publisher mandate. That means unfiltered honesty, expertise-driven analysis, and coverage that treats creative work with the seriousness it deserves.
            </p>
            <p class="hq-motto font-mono">
              BE YOURSELF &middot; BE PASSIONATE &middot; BE UNCONVENTIONAL
            </p>
          </div>
          <div class="hq-why-media">
            <Image
              src={lanternsArt}
              alt="Featured editorial key art from BE Unconventional HQ coverage"
              widths={[640, 960, 1280]}
              sizes="(min-width: 900px) 48vw, 100vw"
              class="hq-photo"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 02 Coverage Lanes -->
  <section id="coverage" class="hq-section" aria-labelledby="hq-coverage">
    <div class="container">
      <SectionHeader kicker="What we cover" title="Four lanes, one editorial standard" id="hq-coverage" />
      <ul class="hq-cards4" id="hq-coverage-grid">
        {coverageLanes.map((lane, idx) => (
          <li class="hq-card" data-card-index={idx}>
            <div class="hq-card-media">
              <Image src={lane.img} alt={lane.alt} widths={[320, 640]} sizes="(min-width: 900px) 22vw, 46vw" class="hq-card-img" />
            </div>
            <h3 class="hq-card-title">{lane.title}</h3>
            <p class="hq-card-line">{lane.line}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 03 Standards & Masthead -->
  <section id="standards" class="hq-section" aria-labelledby="hq-standards">
    <div class="container">
      <SectionHeader kicker="Editorial ethos" title="How the newsroom runs" id="hq-standards" />
      <div class="hq-split">
        <div class="hq-masthead-card">
          <div class="hq-masthead-top">
            <Image
              src={andrewHeadshot}
              alt="Andrew Baxter, Founder and Editor of BE Unconventional HQ"
              width={160}
              height={160}
              class="hq-founder-img"
            />
            <div>
              <p class="hq-founder-kicker font-mono">Masthead</p>
              <h3 class="hq-founder-name">Andrew Baxter</h3>
              <p class="hq-founder-role">Founder &amp; Editor</p>
            </div>
          </div>
          <p class="hq-founder-bio">
            Andrew spent more than a decade in games and technology, including time at Sony Interactive Entertainment as a software engineer and in quality assurance. That working knowledge of how products are built, tested, and shipped shapes every piece of coverage at the HQ.
          </p>
          <div class="hq-platform-strip">
            <a href={HQ_SITE_URL} target="_blank" rel="noopener" class="hq-platform-pill">
              <span class="hq-platform-name">WEB</span>
              <span class="hq-platform-sub">Articles &amp; Reviews &#8599;</span>
            </a>
            <a href={HQ_YOUTUBE_URL} target="_blank" rel="noopener" class="hq-platform-pill">
              <span class="hq-platform-name">YOUTUBE</span>
              <span class="hq-platform-sub">4K Essays &amp; Shorts &#8599;</span>
            </a>
            <a href={HQ_SUBSTACK_URL} target="_blank" rel="noopener" class="hq-platform-pill">
              <span class="hq-platform-name">SUBSTACK</span>
              <span class="hq-platform-sub">Written Criticism &#8599;</span>
            </a>
          </div>
        </div>

        <ol class="hq-steps">
          {standards.map((s) => (
            <li class="hq-step">
              <span class="hq-step-n font-mono">{s.n}</span>
              <div class="hq-step-body">
                <h3 class="hq-step-title">{s.title}</h3>
                <p>{s.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- 04 Pillars Flip Cards -->
  <section id="pillars" class="hq-section" aria-labelledby="hq-pillars">
    <div class="container">
      <SectionHeader kicker="At a glance" title="Built like a studio, run like a press room" id="hq-pillars" />
      <div class="hq-pillars-grid">
        {pillars.map((pillar, idx) => (
          <FlipCard
            value={pillar.value}
            label={pillar.label}
            desc={pillar.desc}
            backText={pillar.backText}
            longValue={pillar.longValue}
            idPrefix="hq-pillar-back"
            index={idx}
            class="hq-pillar-card"
          />
        ))}
      </div>
      <p class="hq-pillars-foot font-mono">
        Screeners &middot; Review copies &middot; Event credentials &middot; Direct press contact: <a href={HQ_PRESS_MAILTO}>press@beunconventionalhq.com</a>
      </p>
    </div>
  </section>

  <!-- 05 Closer -->
  <section id="visit" class="hq-closer" aria-labelledby="hq-closer-title">
    <div class="hq-closer-bg" aria-hidden="true">
      <Image src={lanternsArt} alt="" widths={[640, 1280, 1920]} sizes="100vw" class="hq-closer-bg-img" />
    </div>
    <div class="container hq-closer-inner">
      <Image src={logoMark} alt="BE Unconventional HQ logo" width={200} densities={[1, 2]} class="hq-closer-logo" />
      <p class="hq-closer-eyebrow font-mono">Be yourself &middot; Be passionate &middot; Be unconventional</p>
      <h2 id="hq-closer-title" class="hq-closer-title">Read the latest at the HQ</h2>
      <p class="hq-closer-body">
        Reviews, industry analysis, video breakdowns, and festival coverage live on BE Unconventional HQ.
      </p>
      <p class="hq-closer-tags font-mono">Film Reviews &middot; TV Breakdowns &middot; Game Analysis &middot; Press Dispatches</p>
      <div class="hq-actions btn-group btn-group--row">
        <a class="btn btn-primary hq-btn-primary" href={HQ_SITE_URL} target="_blank" rel="noopener">
          Visit site <span aria-hidden="true">&#8599;</span>
        </a>
        <a class="btn btn-secondary hq-btn-secondary" href={HQ_PRESS_MAILTO}>
          Press inquiry <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  :global(:root) {
    --hq-red: #cc0000;
    --hq-red-bright: #ef4444;
    --hq-red-soft: rgba(204, 0, 0, 0.28);
    --hq-surface: #111112;
    --hq-bg: #0a0a0a;
    --hq-white: #f5f5f5;
    --hq-muted: #9a9a9e;
  }

  /* Docked Pinned Subbar */
  .hq-pinned-stack {
    position: fixed;
    top: var(--nav-bar-h, 76px);
    left: 0;
    right: 0;
    z-index: 90;
    pointer-events: none;
    will-change: transform, opacity;
  }

  .hq-dock-row {
    background: rgba(10, 10, 10, 0.92);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid rgba(204, 0, 0, 0.35);
    overflow: hidden;
    max-height: 0;
    opacity: 0;
    transform: translateY(-8px);
    pointer-events: none;
    transition:
      max-height 0.32s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.26s ease,
      transform 0.28s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .hq-dock-row.is-docked {
    max-height: 54px;
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .hq-dock-btn {
    width: 100%;
    min-height: 44px;
    padding: 0.55rem 1.25rem;
    background: transparent;
    border: 0;
    color: var(--hq-white);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    text-align: center;
  }

  .hq-row-kicker {
    font-size: 0.72rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--hq-red-bright);
    font-weight: 600;
  }

  /* Hero */
  .hq-hero {
    position: relative;
    min-height: calc(100svh - var(--nav-bar-h, 76px));
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: clamp(2.5rem, 6vh, 5rem) 0;
    overflow: hidden;
    background: radial-gradient(circle at 50% 25%, rgba(204, 0, 0, 0.16), rgba(10, 10, 10, 0.96) 68%);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .hq-hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    opacity: 0.22;
  }

  .hq-hero-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(10, 10, 10, 0.55) 0%, rgba(10, 10, 10, 0.92) 75%, #0a0a0a 100%);
  }

  .hq-hero-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.85) contrast(1.1);
  }

  .hq-hero-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 56rem;
    margin-inline: auto;
  }

  .hq-hero-logo {
    width: clamp(190px, 28vw, 300px);
    height: auto;
    margin-bottom: clamp(1rem, 2.2vh, 1.5rem);
    filter: drop-shadow(0 12px 32px rgba(204, 0, 0, 0.28));
    will-change: transform, opacity;
  }

  .hq-hero-eyebrow {
    font-size: 0.72rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--hq-red-bright);
    margin: 0 0 0.65rem;
    font-weight: 600;
  }

  .hq-hero-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.85rem, 4.2vw, 3.6rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: #ffffff;
    margin: 0 0 1rem;
    text-wrap: balance;
    text-shadow: 0 10px 40px rgba(0, 0, 0, 0.7);
  }

  .hq-hero-sub {
    font-family: var(--font-mono);
    font-size: clamp(0.78rem, 1.2vw, 0.95rem);
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: rgba(245, 245, 245, 0.82);
    margin: 0 0 1.75rem;
  }

  .hq-actions {
    width: 100%;
    max-width: 420px;
    margin-inline: auto;
  }

  .hq-btn-primary {
    background: var(--hq-red) !important;
    border-color: var(--hq-red) !important;
    color: #ffffff !important;
  }

  .hq-btn-primary:hover,
  .hq-btn-primary:focus-visible {
    background: #e60000 !important;
    border-color: #ff3333 !important;
    box-shadow: 0 0 24px rgba(204, 0, 0, 0.45);
  }

  /* Card-Stacking Sections */
  .hq-section {
    position: relative;
    z-index: 2;
    background: var(--hq-bg);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-block: clamp(3.5rem, 7vw, 6rem);
    transform-origin: center top;
    will-change: transform, opacity;
    box-shadow: 0 -20px 50px rgba(0, 0, 0, 0.85);
  }

  .hq-section :global(.sec-kicker) {
    color: var(--hq-red-bright);
  }

  /* Section 01: Mission split pairs */
  .hq-why-stage {
    display: flex;
    flex-direction: column;
    gap: clamp(2.5rem, 5vw, 4.5rem);
  }

  .hq-why-pair {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(1.5rem, 3.5vw, 3rem);
    align-items: center;
  }

  .hq-why-pair--bottom {
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
  }

  .hq-why-media {
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: #111;
    will-change: transform;
  }

  .hq-photo {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .hq-why-copy {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    will-change: transform, opacity;
  }

  .hq-subtitle {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2vw, 1.6rem);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: #ffffff;
    margin: 0;
  }

  .hq-why-copy p {
    font-size: clamp(0.98rem, 1.15vw, 1.12rem);
    line-height: 1.65;
    color: rgba(240, 240, 240, 0.86);
    margin: 0;
  }

  .hq-motto {
    font-size: 0.76rem !important;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--hq-red-bright) !important;
    font-weight: 700;
    padding-top: 0.4rem;
  }

  /* Section 02: Coverage 4-column grid */
  .hq-cards4 {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.5rem);
  }

  .hq-card {
    background: var(--hq-surface);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: clamp(1.1rem, 2vw, 1.5rem);
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
    will-change: transform, opacity;
  }

  .hq-card:hover {
    border-color: var(--hq-red);
    box-shadow: 0 12px 32px rgba(204, 0, 0, 0.14);
  }

  .hq-card-media {
    aspect-ratio: 4 / 3;
    display: flex;
    align-items: center;
    justify-content: center;
    background: radial-gradient(circle, rgba(204, 0, 0, 0.12) 0%, rgba(15, 15, 16, 0.95) 75%);
    border: 1px solid rgba(255, 255, 255, 0.06);
    overflow: hidden;
    padding: 0.75rem;
  }

  .hq-card-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .hq-card-title {
    font-family: var(--font-display);
    font-size: clamp(1rem, 1.3vw, 1.2rem);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #ffffff;
    margin: 0.25rem 0 0;
  }

  .hq-card-line {
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--hq-muted);
    margin: 0;
  }

  /* Section 03: Standards & Masthead */
  .hq-split {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: clamp(1.75rem, 3.5vw, 3rem);
    align-items: start;
  }

  .hq-masthead-card {
    background: var(--hq-surface);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-left: 3px solid var(--hq-red);
    padding: clamp(1.35rem, 2.5vw, 2rem);
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }

  .hq-masthead-top {
    display: flex;
    align-items: center;
    gap: 1.1rem;
  }

  .hq-founder-img {
    width: 76px;
    height: 76px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--hq-red);
    flex-shrink: 0;
  }

  .hq-founder-kicker {
    font-size: 0.68rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--hq-red-bright);
    margin: 0 0 0.25rem;
  }

  .hq-founder-name {
    font-family: var(--font-display);
