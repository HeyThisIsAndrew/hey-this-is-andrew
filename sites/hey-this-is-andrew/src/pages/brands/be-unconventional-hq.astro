<script>
  function pageTop(el: HTMLElement): number {
    let y = 0;
    for (let n: HTMLElement | null = el; n; n = n.offsetParent as HTMLElement | null) {
      y += n.offsetTop;
    }
    return y;
  }

  function initHqParallax() {
    const stackEl = document.getElementById('hq-pinned-stack');
    if (!stackEl || stackEl.dataset.hqStackWired === '1') return;
    stackEl.dataset.hqStackWired = '1';
    const stack: HTMLElement = stackEl;

    const heroSection = document.getElementById('hero');
    const heroDockRow = stack.querySelector<HTMLElement>('.hq-dock-row--hero');
    const heroDockBtn = stack.querySelector<HTMLButtonElement>('.hq-dock-btn--hero');
    const heroBigLogo = heroSection?.querySelector<HTMLElement>('.hq-hero-logo') ?? null;
    const heroInner = heroSection?.querySelector<HTMLElement>('.hq-hero-inner') ?? null;
    const heroActions = heroSection?.querySelector<HTMLElement>('.hq-actions') ?? null;
    const closerSection = document.getElementById('visit');
    const allSections = Array.from(
      document.querySelectorAll<HTMLElement>('.hq-section')
    );

    const reducedMotionMq = window.matchMedia('(prefers-reduced-motion: reduce)');
    let prefersReduced = reducedMotionMq.matches;

    function syncDockAccessibility(isInteractive: boolean) {
      if (!heroDockRow || !heroDockBtn) return;
      if (isInteractive) {
        heroDockRow.removeAttribute('inert');
        heroDockBtn.removeAttribute('tabindex');
        stack.style.pointerEvents = '';
      } else {
        if (stack.contains(document.activeElement)) {
          const closerCta = closerSection?.querySelector<HTMLElement>('.hq-actions a, .hq-actions button');
          const closerRect = closerCta?.getBoundingClientRect();
          const navEl = document.querySelector<HTMLElement>('.site-nav');
          const navBottom = navEl ? navEl.getBoundingClientRect().bottom : 76;
          const isCloserCtaVisible = Boolean(
            closerRect &&
              closerRect.top >= navBottom &&
              closerRect.bottom <= window.innerHeight
          );
          const fallback = isCloserCtaVisible
            ? closerCta
            : document.querySelector<HTMLElement>(
                '.site-nav .wordmark, .site-nav .nav-link, .site-nav .menu-btn'
              );
          if (fallback) {
            fallback.focus({ preventScroll: true });
          } else {
            (document.activeElement as HTMLElement | null)?.blur();
          }
        }
        heroDockRow.setAttribute('inert', '');
        heroDockBtn.setAttribute('tabindex', '-1');
        stack.style.pointerEvents = 'none';
      }
    }

    heroDockBtn?.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: prefersReduced ? 'auto' : 'smooth' });
    });

    let ticking = false;

    function onScroll() {
      ticking = false;
      prefersReduced = reducedMotionMq.matches;
      const scrollY = window.scrollY;
      const winH = window.innerHeight;
      const navEl = document.querySelector<HTMLElement>('.site-nav');
      const navH = navEl ? navEl.offsetHeight : 76;
      const settledDockH = (heroDockBtn?.offsetHeight || 44) + 1;
      document.documentElement.style.scrollPaddingTop = `${Math.round(navH + settledDockH + 28)}px`;

      const actionsBottomDoc = heroActions
        ? pageTop(heroActions) + heroActions.offsetHeight
        : (heroSection ? pageTop(heroSection) + heroSection.offsetHeight * 0.65 : winH * 0.65);
      const heroThreshold = Math.max(140, actionsBottomDoc - navH);
      const heroStart = Math.min(heroThreshold - 40, Math.max(150, heroThreshold * 0.42));
      const heroProgress = Math.min(
        1,
        Math.max(0, (scrollY - heroStart) / Math.max(1, heroThreshold - heroStart))
      );

      if (prefersReduced) {
        if (heroBigLogo) {
          heroBigLogo.style.opacity = '';
          heroBigLogo.style.transform = '';
        }
        if (heroInner) {
          heroInner.style.opacity = '';
          heroInner.style.transform = '';
        }
      } else {
        if (heroBigLogo) {
          heroBigLogo.style.opacity = (1 - heroProgress).toFixed(3);
          heroBigLogo.style.transform = `translate3d(0, -${(heroProgress * 36).toFixed(1)}px, 0) scale(${(1 - heroProgress * 0.22).toFixed(3)})`;
        }
        if (heroInner) {
          heroInner.style.opacity = (1 - heroProgress * 0.85).toFixed(3);
        }
      }

      const shouldDock = scrollY >= heroThreshold;
      if (heroDockRow) {
        heroDockRow.classList.toggle('is-docked', shouldDock);
      }

      const currentStackH = shouldDock ? settledDockH : 0;
      const dockBottom = navH + currentStackH;

      for (let i = 0; i < allSections.length; i++) {
        const sec = allSections[i];
        const container = sec.querySelector<HTMLElement>(':scope > .container');
        if (!container) continue;

        if (prefersReduced) {
          container.style.transform = '';
          container.style.opacity = '';
          continue;
        }

        const secTopVp = pageTop(sec) - scrollY;
        const enterStart = winH * 0.98;
        const enterEnd = winH * 0.78;
        const rawProg = (enterStart - secTopVp) / Math.max(1, enterStart - enterEnd);
        const prog = Math.min(1, Math.max(0, rawProg));

        if (prog >= 1) {
          container.style.transform = '';
          container.style.opacity = '1';
        } else {
          const translateY = (1 - prog) * 28;
          const scale = 0.97 + 0.03 * prog;
          const opacity = 0.25 + 0.75 * prog;
          container.style.transform = `translate3d(0, ${translateY.toFixed(1)}px, 0) scale(${scale.toFixed(3)})`;
          container.style.opacity = opacity.toFixed(3);
        }
      }

      let pushY = 0;
      let isDismissedByCloser = false;
      if (closerSection) {
        const closerTopVp = pageTop(closerSection) - scrollY;
        const startTrigger = winH * 0.85;
        const pushRange = Math.max(1, winH * 0.45);

        if (closerTopVp < startTrigger) {
          const rawProgress = (startTrigger - closerTopVp) / pushRange;
          const progress = Math.min(1, Math.max(0, rawProgress));
          const eased = 1 - Math.pow(1 - progress, 3);
          pushY = eased * (currentStackH + navH + 20);
          isDismissedByCloser = pushY > 4 || progress > 0.08;

          if (prefersReduced) {
            stack.style.transform = '';
            stack.style.opacity = isDismissedByCloser ? '0' : '1';
          } else {
            stack.style.transform = `translate3d(0, -${pushY.toFixed(1)}px, 0)`;
            const fadeProgress = Math.min(1, Math.max(0, progress / 0.85));
            const opacity = 1 - Math.pow(fadeProgress, 1.4);
            stack.style.opacity = Math.max(0, opacity).toFixed(3);
          }
        } else {
          stack.style.transform = '';
          stack.style.opacity = '1';
        }
      }

      syncDockAccessibility(shouldDock && !isDismissedByCloser);
    }

    function scheduleUpdate() {
      if (!ticking) {
        ticking = true;
        window.requestAnimationFrame(onScroll);
      }
    }

    window.addEventListener('scroll', scheduleUpdate, { passive: true });
    window.addEventListener('resize', scheduleUpdate, { passive: true });
    window.addEventListener('orientationchange', scheduleUpdate, { passive: true });
    if (typeof reducedMotionMq.addEventListener === 'function') {
      reducedMotionMq.addEventListener('change', scheduleUpdate);
    }
    document.fonts?.ready.then(scheduleUpdate);

    onScroll();
  }

  initHqParallax();
  document.addEventListener('astro:page-load', initHqParallax);
</script>
