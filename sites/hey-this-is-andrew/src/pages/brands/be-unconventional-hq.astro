</style>

<script>
  function initHqParallax() {
    const stack = document.getElementById('hq-pinned-stack');
    const heroSection = document.getElementById('hero');
    const heroDockRow = stack?.querySelector<HTMLElement>('.hq-dock-row--hero');
    const heroDockBtn = stack?.querySelector<HTMLButtonElement>('.hq-dock-btn--hero');
    const heroBigLogo = heroSection?.querySelector<HTMLElement>('.hq-hero-logo');
    const heroInner = heroSection?.querySelector<HTMLElement>('.hq-hero-inner');
    const closerSection = document.getElementById('visit');
    const allSections = Array.from(
      document.querySelectorAll<HTMLElement>('#hero, .hq-section, #visit')
    );

    heroDockBtn?.addEventListener('click', () => {
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reduced ? 'auto' : 'smooth' });
    });

    let ticking = false;

    function onScroll() {
      ticking = false;
      const scrollY = window.scrollY;
      const winH = window.innerHeight;
      const navEl = document.querySelector<HTMLElement>('.site-nav');
      const navH = navEl ? navEl.offsetHeight : 76;

      const heroH = heroSection ? heroSection.offsetHeight : winH;
      const heroThreshold = Math.max(120, heroH * 0.55);
      const heroProgress = Math.min(1, Math.max(0, scrollY / heroThreshold));

      if (heroBigLogo) {
        heroBigLogo.style.opacity = (1 - heroProgress).toFixed(3);
        heroBigLogo.style.transform = `translate3d(0, -${(heroProgress * 36).toFixed(1)}px, 0) scale(${(1 - heroProgress * 0.22).toFixed(3)})`;
      }
      if (heroInner) {
        heroInner.style.opacity = (1 - heroProgress * 0.85).toFixed(3);
      }

      if (heroDockRow) {
        if (scrollY >= heroThreshold) {
          heroDockRow.classList.add('is-docked');
        } else {
          heroDockRow.classList.remove('is-docked');
        }
      }

      const currentStackH =
        heroDockRow && heroDockRow.classList.contains('is-docked')
          ? heroDockRow.offsetHeight || 48
          : 0;
      const dockBottom = navH + currentStackH;

      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!prefersReducedMotion) {
        for (let i = 0; i < allSections.length - 1; i++) {
          const curr = allSections[i];
          const next = allSections[i + 1];
          const nextRect = next.getBoundingClientRect();
          const currHead = curr.querySelector<HTMLElement>('.sec-head, .hq-hero-inner');
          const currHeadTop = currHead
            ? currHead.getBoundingClientRect().top
            : curr.getBoundingClientRect().top;

          if (currHeadTop >= dockBottom - 4) {
            curr.style.transform = '';
            curr.style.opacity = '1';
            continue;
          }

          const overlapStart = winH * 0.85;
          const overlapRange = Math.max(1, overlapStart - dockBottom);
          if (nextRect.top < overlapStart && nextRect.bottom > dockBottom) {
            const rawProgress = (overlapStart - nextRect.top) / overlapRange;
            const progress = Math.min(1, Math.max(0, rawProgress));
            const scale = 1 - progress * 0.05;
            const opacity = 1 - progress * 0.65;
            const driftY = progress * 24;

            curr.style.transform = `translate3d(0, -${driftY.toFixed(1)}px, 0) scale(${scale.toFixed(3)})`;
            curr.style.opacity = Math.max(0.2, opacity).toFixed(3);
          } else if (nextRect.top >= overlapStart) {
            curr.style.transform = '';
            curr.style.opacity = '1';
          } else {
            curr.style.transform = 'translate3d(0, -24px, 0) scale(0.95)';
            curr.style.opacity = '0.35';
          }
        }
      }

      if (closerSection && stack) {
        const closerRect = closerSection.getBoundingClientRect();
        const startTrigger = winH * 0.85;
        const pushRange = winH * 0.45;

        if (closerRect.top < startTrigger) {
          const rawProgress = (startTrigger - closerRect.top) / pushRange;
          const progress = Math.min(1, Math.max(0, rawProgress));
          const eased = 1 - Math.pow(1 - progress, 3);
          const pushY = eased * (currentStackH + navH + 20);

          stack.style.transform = `translate3d(0, -${pushY.toFixed(1)}px, 0)`;
          const fadeProgress = Math.min(1, Math.max(0, progress / 0.85));
          const opacity = 1 - Math.pow(fadeProgress, 1.4);
          stack.style.opacity = Math.max(0, opacity).toFixed(3);
          stack.style.pointerEvents = progress > 0.15 ? 'none' : '';
        } else {
          stack.style.transform = '';
          stack.style.opacity = '1';
          stack.style.pointerEvents = '';
        }
      }
    }

    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          window.requestAnimationFrame(onScroll);
          ticking = true;
        }
      },
      { passive: true }
    );

    onScroll();
  }

  initHqParallax();
  document.addEventListener('astro:page-load', initHqParallax);
</script>
