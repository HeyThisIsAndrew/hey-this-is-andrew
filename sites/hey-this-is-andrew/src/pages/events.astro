---
/**
 * /events: event coverage and appearances.
 * Upcoming events are added as data below; each entry renders a card.
 * Past coverage links out to the full breakdowns.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '@andrew/ui/SectionHeader.astro';
import eventsData from '../data/events.json';

interface EventItem {
  name: string;
  location: string;
  dates: string;
  blurb: string;
  url?: string;
}

// Upcoming events: add entries here as they are confirmed. The section
// renders an honest empty state when the list is empty.
const UPCOMING: EventItem[] = eventsData.upcoming;
const PAST: EventItem[] = eventsData.past;
---

<BaseLayout
  title="Events · HEY_THISISANDREW"
  description="Event coverage and appearances from Hey This Is Andrew: conventions, premieres, and creator meetups."
>
  <h1 class="vh">Events from HEY_THISISANDREW</h1>
  <div class="container">
    <section class="events-head" aria-labelledby="events-heading">
      <SectionHeader
        id="events-heading"
        index="01"
        kicker="Out in the field"
        title="Events"
        lede="Conventions, premieres, and creator meetups. Where the coverage happens."
      />
    </section>

    <section class="events-section" aria-labelledby="upcoming-heading">
      <h2 class="events-subhead" id="upcoming-heading">Upcoming</h2>
      {UPCOMING.length === 0 ? (
        <div class="events-empty">
          <p class="events-empty-title">No upcoming events scheduled</p>
          <p class="events-empty-desc">
            Nothing on the calendar right now. When the next convention,
            premiere, or meetup is locked in, it will be listed here.
          </p>
        </div>
      ) : (
        <ul class="events-list">
          {UPCOMING.map((e) => (
            <li class="event-card">
              <p class="event-meta">{e.dates} · {e.location}</p>
              <h3 class="event-name">{e.name}</h3>
              <p class="event-blurb">{e.blurb}</p>
              {e.url && (
                <a class="event-link" href={e.url} target="_blank" rel="noopener">
                  Details
                  <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                    <path d="M1 11L11 1M11 1H3M11 1V9" stroke="currentColor" stroke-width="1.5" />
                  </svg>
                </a>
              )}
            </li>
          ))}
        </ul>
      )}
    </section>

    <section class="events-section" aria-labelledby="past-heading">
      <h2 class="events-subhead" id="past-heading">Past coverage</h2>
      {PAST.length === 0 ? (
        <div class="events-empty">
          <p class="events-empty-title">Coverage archive coming soon</p>
          <p class="events-empty-desc">
            Breakdowns and recaps from past events will live here once the
            first one ships.
          </p>
        </div>
      ) : (
        <ul class="events-list">
          {PAST.map((e) => (
            <li class="event-card">
              <p class="event-meta">{e.dates} · {e.location}</p>
              <h3 class="event-name">{e.name}</h3>
              <p class="event-blurb">{e.blurb}</p>
              {e.url && (
                <a class="event-link" href={e.url} target="_blank" rel="noopener">
                  Read the breakdown
                  <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                    <path d="M1 11L11 1M11 1H3M11 1V9" stroke="currentColor" stroke-width="1.5" />
                  </svg>
                </a>
              )}
            </li>
          ))}
        </ul>
      )}
    </section>
  </div>
</BaseLayout>

<style>
  .events-head {
    padding-top: clamp(3rem, 6vw, 5rem);
  }

  .events-section {
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }

  .events-subhead {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.5rem;
    margin: 0 0 1.5rem;
  }

  .events-empty {
    border: 1px dashed var(--line);
    padding: 2.5rem 2rem;
    text-align: center;
    max-width: 40rem;
  }

  .events-empty-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.15rem;
    margin: 0 0 0.6rem;
  }

  .events-empty-desc {
    font-family: var(--font-body);
    font-size: 0.92rem;
    line-height: 1.65;
    color: var(--muted);
    margin: 0;
  }

  .events-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 720px) {
    .events-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .event-card {
    background: var(--surface);
    border: 1px solid var(--line);
    padding: 1.5rem;
  }

  .event-meta {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 0.75rem;
  }

  .event-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.3rem;
    margin: 0 0 0.6rem;
  }

  .event-blurb {
    font-family: var(--font-body);
    font-size: 0.92rem;
    line-height: 1.65;
    color: var(--muted);
    margin: 0 0 1rem;
  }

  .event-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--key-dim);
    padding-bottom: 0.25rem;
  }

  .event-link:hover {
    border-color: var(--ink);
  }
</style>
