---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GoalsSection from '../../components/GoalsSection.astro';
import {
  SUBSTACK_PUBLICATION_URL,
  articleHref,
  getAllArticles,
  isExternalArticle,
  resolveLocalRendition,
  sanitizeVisibleCopy,
} from '../../lib/articles';
import { formatFeedDate } from '../../lib/dates';

const allArticles = getAllArticles();
---

<BaseLayout
  title="Writing · HEY_THISISANDREW"
  description="Notes from the build, essays, and Coffee Talk dispatches by Andrew Baxter."
  pane="Writing"
>
  <div class="container writing-page">
    <h1 class="vh">Build in Public</h1>

    <section id="writing" class="writing-articles-section" aria-labelledby="writing-heading">
      <div class="writing-pill-row" data-sec-head>
        <h2 id="writing-heading" class="writing-pill">Coffee Talk</h2>
      </div>
      {allArticles.length > 0 ? (
        <ul class="writing-card-grid" role="list">
          {allArticles.map((article, index) => {
            const href = articleHref(article);
            const external = isExternalArticle(article);
            const title = sanitizeVisibleCopy(article.title) || article.title;
            const excerpt = sanitizeVisibleCopy(article.excerpt);
            const formattedDate = formatFeedDate(article.isoDate, {
              month: 'short',
              day: 'numeric',
              year: 'numeric',
            });
            const localImg = resolveLocalRendition(article.image);
            const imgSrc = localImg?.src || article.image;
            return (
              <li class="writing-card-item">
                <a
                  class="writing-card-link"
                  href={href}
                  target={external ? '_blank' : undefined}
                  rel={external ? 'noopener noreferrer' : undefined}
                >
                  <article class="writing-card">
                    {imgSrc && (
                      <div class="writing-card-media">
                        <img
                          src={imgSrc}
                          srcset={localImg?.srcset || undefined}
                          sizes={localImg?.srcset ? '(max-width: 767px) 92vw, 660px' : undefined}
                          alt=""
                          width="1456"
                          height="816"
                          loading={index < 2 ? 'eager' : 'lazy'}
                          decoding="async"
                        />
                      </div>
                    )}
                    <div class="writing-card-body">
                      <h3 class="writing-card-title">{title}</h3>
                      {formattedDate && (
                        <time
                          class="writing-card-date font-mono"
                          datetime={article.isoDate || undefined}
                        >
                          {formattedDate}
                        </time>
                      )}
                      {excerpt && <p class="writing-card-excerpt">{excerpt}</p>}
                    </div>
                  </article>
                </a>
              </li>
            );
          })}
        </ul>
      ) : (
        <p class="writing-empty">No articles imported yet. Run sync:articles to populate the snapshot.</p>
      )}
    </section>

    <section id="goals" class="writing-goals-section" aria-labelledby="goals-heading">
      <GoalsSection />
    </section>

    <div class="writing-page-actions">
      <a
        class="btn btn-primary"
        href={SUBSTACK_PUBLICATION_URL}
        target="_blank"
        rel="noopener noreferrer"
      >
        Read on Substack <span aria-hidden="true">&nearr;</span>
      </a>
      <a
        class="btn btn-ghost"
        href={`${SUBSTACK_PUBLICATION_URL}/subscribe`}
        target="_blank"
        rel="noopener noreferrer"
      >
        Subscribe
      </a>
    </div>
  </div>
</BaseLayout>

<style>
  .writing-page {
    --writing-measure: 1360px;
    padding-block: clamp(24px, 3vw, 40px) clamp(48px, 6vw, 96px);
    min-inline-size: 0;
    border-radius: 0;
  }

  .writing-articles-section,
  .writing-goals-section {
    inline-size: 100%;
    max-inline-size: var(--writing-measure);
    margin-inline: auto;
    border: 0;
    border-radius: 0;
    min-inline-size: 0;
    scroll-margin-top: calc(var(--nav-bar-h, 76px) + 1rem);
  }

  .writing-articles-section {
    padding-block: 0 clamp(40px, 4.5vw, 64px);
  }

  .writing-goals-section {
    padding-block: 0 clamp(36px, 4vw, 56px);
  }

  .writing-pill-row {
    display: flex;
    align-items: center;
    margin-block-end: clamp(16px, 2vw, 24px);
    min-inline-size: 0;
  }

  .writing-pill {
    display: inline-flex;
    align-items: center;
    max-inline-size: 100%;
    box-sizing: border-box;
    margin: 0;
    padding: 0.35rem 0.65rem;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-inline-start: 2px solid var(--accordion-edge, #f0f0f0);
    border-radius: 0;
    background: rgba(10, 10, 10, 0.65);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    font-family: var(--font-body, sans-serif);
    font-weight: 600;
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    line-height: 1.2;
    color: rgba(255, 255, 255, 0.95);
    white-space: normal;
    overflow-wrap: break-word;
  }

  .writing-page-actions {
    inline-size: 100%;
    max-inline-size: min(100%, var(--writing-measure));
    margin: 0;
    margin-inline: auto;
    padding: 0;
    border: 0;
    border-radius: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 18px;
    min-inline-size: 0;
  }

  .writing-card-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(20px, 2.2vw, 28px);
    list-style: none;
    margin: 0;
    padding: 0;
    border-radius: 0;
  }

  @media (max-width: 767px) {
    .writing-card-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
    }
  }

  .writing-card-item {
    display: flex;
    min-inline-size: 0;
  }

  .writing-card-link {
    display: flex;
    inline-size: 100%;
    min-inline-size: 0;
    text-decoration: none;
    color: var(--ink);
    border-radius: 0;
  }

  .writing-card {
    display: flex;
    flex-direction: column;
    inline-size: 100%;
    min-inline-size: 0;
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-radius: 0;
    transition:
      border-color 0.22s ease-in-out,
      background-color 0.22s ease-in-out;
  }

  .writing-card-media {
    inline-size: 100%;
    aspect-ratio: 16 / 9;
    overflow: clip;
    background: var(--surface-2);
    border-block-end: 1px solid var(--hairline);
    border-radius: 0;
  }

  .writing-card-media img {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 0;
    transition: transform 0.6s ease-in-out;
  }

  .writing-card-body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: clamp(18px, 1.8vw, 24px);
    min-inline-size: 0;
    flex: 1 1 auto;
  }

  .writing-card-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(18px, 1.5vw, 22px);
    font-weight: 700;
    line-height: 1.25;
    color: var(--ink);
    overflow-wrap: break-word;
  }

  .writing-card-date {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    line-height: 1.3;
  }

  .writing-card-excerpt {
    margin: 0;
    font-family: var(--font-body);
    color: var(--muted);
    font-size: clamp(14.5px, 1.05vw, 15.5px);
    line-height: 1.6;
    overflow-wrap: break-word;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    line-clamp: 3;
    overflow: clip;
  }

  .writing-empty {
    margin: 0;
    font-family: var(--font-body);
    color: var(--muted);
    font-size: 15px;
    line-height: 1.6;
  }

  @media (hover: hover) and (pointer: fine) {
    .writing-card-link:hover .writing-card {
      border-color: var(--ink);
      background: var(--surface-2);
    }

    .writing-card-link:hover .writing-card-media img {
      transform: scale(1.03);
    }

    .writing-card-link:hover .writing-card-title {
      text-decoration: underline;
      text-underline-offset: 0.22em;
      text-decoration-thickness: 1px;
    }
  }

  .writing-card-link:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
    border-radius: 0;
  }

  .writing-page-actions :global(.btn) {
    border-radius: 0;
    transition-timing-function: ease-in-out;
  }

  @media (prefers-reduced-motion: reduce) {
    .writing-card,
    .writing-card-media img,
    .writing-page-actions :global(.btn) {
      transition: none;
    }

    .writing-card-link:hover .writing-card-media img {
      transform: none;
    }
  }
</style>
