---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GoalsSection from '../../components/GoalsSection.astro';
import MagazineSpread from '@andrew/ui/MagazineSpread.astro';
import {
  SUBSTACK_PUBLICATION_URL,
  articleHref,
  getAllArticles,
  isExternalArticle,
  resolveLocalRendition,
  sanitizeVisibleCopy,
  toMagazineCard,
} from '../../lib/articles';
import { formatFeedDate } from '../../lib/dates';

const MAGAZINE_LIMIT = 4;
const allArticles = getAllArticles();
const magazineCards = allArticles.slice(0, MAGAZINE_LIMIT).map(toMagazineCard);
const remainingArticles = allArticles.slice(MAGAZINE_LIMIT);
---

<BaseLayout
  title="Writing · HEY_THISISANDREW"
  description="Notes from the build, essays, and Coffee Talk dispatches by Andrew Baxter."
  pane="Writing"
>
  <div class="container writing-page">
    <header class="writing-page-head">
      <p class="writing-kicker font-mono">Coffee Talk · Substack</p>
      <h1 class="writing-page-title">Notes from the build</h1>
      <p class="writing-page-lede">
        Longer thoughts on building in public, creator tools, and learning out loud, published on Coffee Talk and mirrored here.
      </p>
      <div class="writing-page-actions">
        <a
          class="btn btn-primary"
          href={SUBSTACK_PUBLICATION_URL}
          target="_blank"
          rel="noopener noreferrer"
        >
          Read on Substack
          <span aria-hidden="true">&nearr;</span>
        </a>
        <a
          class="btn btn-ghost"
          href={`${SUBSTACK_PUBLICATION_URL}/subscribe`}
          target="_blank"
          rel="noopener noreferrer"
        >
          Subscribe
        </a>
      </div>
    </header>

    <section
      id="writing"
      class="writing-spread-section"
      aria-labelledby="writing-heading"
      data-magazine-scroll-anchor
    >
      <header class="writing-section-head">
        <h2 id="writing-heading" class="writing-section-heading">Writing</h2>
      </header>
      {magazineCards.length > 0 ? (
        <div class="writing-spread-wrap">
          <MagazineSpread articles={magazineCards} compact readMoreLabel="Read Article" />
        </div>
      ) : (
        <p class="writing-empty">No articles imported yet. Run sync:articles to populate the snapshot.</p>
      )}
    </section>

    <section id="goals" class="writing-goals-section" aria-labelledby="goals-heading">
      <GoalsSection />
    </section>

    <section id="articles" class="writing-articles-section" aria-labelledby="articles-heading">
      <header class="writing-section-head">
        <h2 id="articles-heading" class="writing-section-heading">Articles</h2>
      </header>
      {remainingArticles.length > 0 ? (
        <ul class="writing-archive-list" role="list">
          {remainingArticles.map((article) => {
            const href = articleHref(article);
            const external = isExternalArticle(article);
            const title = sanitizeVisibleCopy(article.title) || article.title;
            const excerpt = sanitizeVisibleCopy(article.excerpt);
            const formattedDate = formatFeedDate(article.isoDate, {
              month: 'short',
              day: 'numeric',
              year: 'numeric',
            });
            const localImg = resolveLocalRendition(article.image);
            const imgSrc = localImg?.src || article.image;
            return (
              <li class="writing-archive-item">
                <a
                  class="writing-archive-row"
                  href={href}
                  target={external ? '_blank' : undefined}
                  rel={external ? 'noopener noreferrer' : undefined}
                >
                  <div class="writing-archive-body">
                    {formattedDate && (
                      <time
                        class="writing-archive-meta font-mono"
                        datetime={article.isoDate || undefined}
                      >
                        {formattedDate}
                      </time>
                    )}
                    <h3 class="writing-archive-title">{title}</h3>
                    {excerpt && <p class="writing-archive-excerpt">{excerpt}</p>}
                  </div>
                  {imgSrc && (
                    <div class="writing-archive-thumb">
                      <img
                        src={imgSrc}
                        srcset={localImg?.srcset || undefined}
                        alt=""
                        loading="lazy"
                        decoding="async"
                      />
                    </div>
                  )}
                </a>
              </li>
            );
          })}
        </ul>
      ) : (
        <p class="writing-empty">More articles coming soon.</p>
      )}
    </section>
  </div>
</BaseLayout>

<style>
  .writing-page {
    --writing-measure: 1360px;
    padding-block-end: clamp(48px, 6vw, 96px);
    min-inline-size: 0;
    border-radius: 0;
  }

  .writing-page-head {
    inline-size: 100%;
    max-inline-size: var(--writing-measure);
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    padding-block: clamp(32px, 4vw, 60px) clamp(24px, 3vw, 42px);
    min-inline-size: 0;
    border-radius: 0;
  }

  .writing-kicker {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
    line-height: 1.3;
  }

  .writing-page-title {
    font-family: var(--font-display);
    font-size: clamp(32px, 4vw, 54px);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    color: var(--ink);
    margin: 0;
    line-height: 1.06;
    overflow-wrap: break-word;
  }

  .writing-page-lede {
    font-family: var(--font-body);
    font-size: clamp(15.5px, 1.25vw, 18px);
    color: var(--muted);
    max-inline-size: 60ch;
    margin: 0;
    line-height: 1.62;
    overflow-wrap: break-word;
  }

  .writing-page-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 18px;
    margin-block-start: 6px;
    max-inline-size: 100%;
  }

  .writing-page-actions :global(.btn) {
    border-radius: 0;
    transition-timing-function: ease-in-out;
  }

  .writing-spread-section,
  .writing-goals-section,
  .writing-articles-section {
    inline-size: 100%;
    max-inline-size: var(--writing-measure);
    margin-inline: auto;
    padding-block: clamp(32px, 3.8vw, 54px);
    border-block-start: 1px solid var(--hairline);
    border-radius: 0;
    min-inline-size: 0;
  }

  .writing-spread-section {
    scroll-margin-top: calc(var(--nav-bar-h, 76px) + 1rem);
  }

  .writing-section-head {
    inline-size: 100%;
    margin-block-end: clamp(20px, 2.2vw, 30px);
    min-inline-size: 0;
  }

  .writing-section-heading {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(24px, 2.4vw, 34px);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink);
    line-height: 1.12;
    overflow-wrap: break-word;
  }

  .writing-spread-wrap {
    inline-size: 100%;
    min-inline-size: 0;
    border-radius: 0;
  }

  /* Match BE Unconventional HQ's compact MagazineSpread framing inside the 1360px column. */
  .writing-spread-wrap :global(.magazine-spread--compact) {
    margin: 0;
    border-radius: 0;
  }

  .writing-spread-wrap :global(.magazine-spread--compact .magazine-feature-image),
  .writing-spread-wrap :global(.magazine-spread--compact .magazine-feature-image img),
  .writing-spread-wrap :global(.magazine-spread--compact .magazine-rail-thumb),
  .writing-spread-wrap :global(.magazine-spread--compact .magazine-rail-thumb img) {
    border-radius: 0;
  }

  .writing-spread-wrap :global(.magazine-spread--compact .magazine-rail-item),
  .writing-spread-wrap :global(.magazine-spread--compact .magazine-rail-title),
  .writing-spread-wrap :global(.magazine-spread--compact .magazine-rail-thumb img),
  .writing-spread-wrap :global(.magazine-spread--compact .magazine-feature-image img),
  .writing-spread-wrap :global(.magazine-spread--compact .magazine-feature-cta),
  .writing-spread-wrap :global(.magazine-spread--compact .magazine-feature-cta::after) {
    transition-timing-function: ease-in-out;
  }

  .writing-spread-wrap :global(.magazine-spread--compact .magazine-feature-excerpt) {
    --excerpt-lines: 4;
  }

  .writing-spread-wrap :global(.magazine-spread--compact .magazine-feature-title) {
    font-size: clamp(1.3rem, 1.9vw, 1.9rem);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .writing-spread-wrap :global(.magazine-spread--compact .magazine-feature-copy) {
    padding-block: 1.5rem 1.75rem;
  }

  .writing-spread-wrap :global(.magazine-spread--compact :focus-visible) {
    outline-offset: -3px;
    border-radius: 0;
  }

  @media (min-width: 1101px) {
    .writing-spread-wrap :global(.magazine-spread--compact .magazine-feature) {
      contain: size;
    }

    .writing-spread-wrap :global(.magazine-spread--compact .magazine-feature-image) {
      aspect-ratio: auto;
      flex: 1 1 0;
      min-height: 0;
    }

    .writing-spread-wrap :global(.magazine-spread--compact .magazine-feature-image img) {
      height: 100%;
      object-fit: cover;
    }

    .writing-spread-wrap :global(.magazine-spread--compact .magazine-feature-copy) {
      flex: 0 0 auto;
      justify-content: flex-start;
    }
  }

  @media (max-width: 767px) {
    .writing-spread-wrap :global(.magazine-spread--compact .magazine-feature-excerpt) {
      --excerpt-lines: 3;
    }

    .writing-spread-wrap :global(.magazine-spread--compact .magazine-rail) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .writing-spread-wrap :global(.magazine-spread--compact .magazine-rail-item) {
      padding: 1rem 0.75rem;
    }

    .writing-spread-wrap :global(.magazine-spread--compact .magazine-rail-title) {
      font-size: 0.9rem;
    }

    .writing-spread-wrap :global(.magazine-spread--compact .magazine-rail-meta) {
      display: block;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
  }

  .writing-empty {
    inline-size: 100%;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.6;
    padding-block: 24px;
    margin: 0;
  }

  .writing-archive-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    border-block-start: 1px solid var(--hairline);
    border-radius: 0;
  }

  .writing-archive-item {
    border-block-end: 1px solid var(--hairline);
    border-radius: 0;
    min-inline-size: 0;
  }

  .writing-archive-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    gap: 16px 24px;
    padding-block: clamp(18px, 1.6vw, 24px);
    padding-inline: 0;
    text-decoration: none;
    color: var(--ink);
    border-radius: 0;
    transition: background-color 0.22s ease-in-out, border-color 0.22s ease-in-out;
  }

  .writing-archive-row:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 4px;
    border-radius: 0;
  }

  @media (hover: hover) and (pointer: fine) {
    .writing-archive-row:hover .writing-archive-title {
      text-decoration: underline;
      text-underline-offset: 0.22em;
      text-decoration-thickness: 1px;
    }

    .writing-archive-row:hover .writing-archive-thumb {
      border-color: var(--ink);
    }
  }

  .writing-archive-body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-inline-size: 0;
  }

  .writing-archive-meta {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    line-height: 1.3;
  }

  .writing-archive-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(18px, 1.5vw, 22px);
    font-weight: 700;
    line-height: 1.28;
    color: var(--ink);
    overflow-wrap: break-word;
  }

  .writing-archive-excerpt {
    margin: 0;
    font-family: var(--font-body);
    color: var(--muted);
    font-size: clamp(14.5px, 1.05vw, 15.5px);
    line-height: 1.6;
    max-inline-size: 68ch;
    overflow-wrap: break-word;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .writing-archive-thumb {
    inline-size: 168px;
    aspect-ratio: 16 / 9;
    overflow: clip;
    background: var(--surface-2);
    border: 1px solid var(--hairline);
    border-radius: 0;
    flex: 0 0 auto;
    transition: border-color 0.22s ease-in-out;
  }

  .writing-archive-thumb img {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 0;
  }

  @media (max-width: 600px) {
    .writing-archive-row {
      grid-template-columns: minmax(0, 1fr);
      gap: 14px;
    }

    .writing-archive-thumb {
      inline-size: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .writing-archive-row,
    .writing-archive-thumb {
      transition: none;
    }
  }
</style>
