---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GoalsSection from '../../components/GoalsSection.astro';
import MagazineSpread from '@andrew/ui/MagazineSpread.astro';
import {
  SUBSTACK_PUBLICATION_URL,
  articleHref,
  getAllArticles,
  isExternalArticle,
  resolveLocalRendition,
  sanitizeVisibleCopy,
  toMagazineCard,
} from '../../lib/articles';
import { formatFeedDate } from '../../lib/dates';

const MAGAZINE_LIMIT = 8;
const allArticles = getAllArticles();
const magazineCards = allArticles.slice(0, MAGAZINE_LIMIT).map(toMagazineCard);
const archiveArticles = allArticles.slice(MAGAZINE_LIMIT);
---

<BaseLayout
  title="Writing · HEY_THISISANDREW"
  description="Notes from the build, essays, and Coffee Talk dispatches by Andrew Baxter."
  pane="Writing"
>
  <div class="container writing-page">
    <header class="writing-page-head">
      <p class="writing-kicker font-mono">Coffee Talk · Substack</p>
      <h1 class="writing-page-title">Notes from the build</h1>
      <p class="writing-page-lede">
        Longer thoughts on building in public, creator tools, and learning out loud, published on Coffee Talk and mirrored here.
      </p>
      <div class="writing-page-actions">
        <a
          class="btn btn-primary"
          href={SUBSTACK_PUBLICATION_URL}
          target="_blank"
          rel="noopener noreferrer"
        >
          Read on Substack
          <span aria-hidden="true">&nearr;</span>
        </a>
        <a
          class="btn btn-ghost"
          href={`${SUBSTACK_PUBLICATION_URL}/subscribe`}
          target="_blank"
          rel="noopener noreferrer"
        >
          Subscribe
        </a>
      </div>
    </header>

    <section id="goals" class="writing-goals-section" aria-labelledby="goals-heading">
      <GoalsSection />
    </section>

    <section id="writing" class="writing-list-section" aria-labelledby="writing-heading">
      <header class="writing-section-head">
        <h2 id="writing-heading" class="writing-section-heading">Writing</h2>
      </header>

      {magazineCards.length > 0 ? (
        <div class="writing-spread-wrap">
          <MagazineSpread articles={magazineCards} readMoreLabel="Read Article" />
        </div>
      ) : (
        <p class="writing-empty">No articles imported yet. Run sync:articles to populate the snapshot.</p>
      )}

      {archiveArticles.length > 0 && (
        <div class="writing-archive" aria-labelledby="writing-archive-heading">
          <header class="writing-archive-head">
            <h2 id="writing-archive-heading" class="writing-archive-heading">Archive</h2>
            <p class="writing-archive-lede">Earlier dispatches and notes.</p>
          </header>
          <ul class="writing-archive-list" role="list">
            {archiveArticles.map((article) => {
              const href = articleHref(article);
              const external = isExternalArticle(article);
              const title = sanitizeVisibleCopy(article.title) || article.title;
              const excerpt = sanitizeVisibleCopy(article.excerpt);
              const formattedDate = formatFeedDate(article.isoDate, {
                month: 'short',
                day: 'numeric',
                year: 'numeric',
              });
              const localImg = resolveLocalRendition(article.image);
              const imgSrc = localImg?.src || article.image;
              return (
                <li class="writing-archive-item">
                  <a
                    class="writing-archive-row"
                    href={href}
                    target={external ? '_blank' : undefined}
                    rel={external ? 'noopener noreferrer' : undefined}
                  >
                    <div class="writing-archive-body">
                      {formattedDate && (
                        <time
                          class="writing-archive-meta font-mono"
                          datetime={article.isoDate || undefined}
                        >
                          {formattedDate}
                        </time>
                      )}
                      <h3 class="writing-archive-title">{title}</h3>
                      {excerpt && <p class="writing-archive-excerpt">{excerpt}</p>}
                    </div>
                    {imgSrc && (
                      <div class="writing-archive-thumb">
                        <img
                          src={imgSrc}
                          srcset={localImg?.srcset || undefined}
                          alt=""
                          loading="lazy"
                          decoding="async"
                        />
                      </div>
                    )}
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      )}
    </section>
  </div>
</BaseLayout>

<style>
  .writing-page {
    --substack-measure: 700px;
    padding-block-end: clamp(4rem, 8vw, 7rem);
    min-inline-size: 0;
    border-radius: 0;
  }

  .writing-page-head {
    inline-size: 100%;
    max-inline-size: var(--substack-measure);
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.9rem;
    padding-block: clamp(2.5rem, 5vw, 4.5rem) clamp(2rem, 4vw, 3.25rem);
    min-inline-size: 0;
    border-radius: 0;
  }

  .writing-kicker {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
    line-height: 1.3;
  }

  .writing-page-title {
    font-family: var(--font-display);
    font-size: clamp(2.1rem, 4.8vw, 3.6rem);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    color: var(--ink);
    margin: 0;
    line-height: 1.06;
    overflow-wrap: break-word;
  }

  .writing-page-lede {
    font-family: var(--font-body);
    font-size: 1.05rem;
    color: var(--muted);
    max-inline-size: 58ch;
    margin: 0;
    line-height: 1.65;
    overflow-wrap: break-word;
  }

  .writing-page-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.15rem;
    margin-block-start: 0.35rem;
    max-inline-size: 100%;
  }

  .writing-page-actions :global(.btn) {
    border-radius: 0;
  }

  .writing-goals-section,
  .writing-list-section {
    padding-block: clamp(2.5rem, 5vw, 4.25rem);
    border-block-start: 1px solid var(--hairline);
    border-radius: 0;
    min-inline-size: 0;
  }

  .writing-section-head {
    inline-size: 100%;
    max-inline-size: var(--substack-measure);
    margin-inline: auto;
    margin-block-end: clamp(1.75rem, 3.5vw, 2.5rem);
    min-inline-size: 0;
  }

  .writing-section-heading {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink);
    line-height: 1.12;
    overflow-wrap: break-word;
  }

  .writing-spread-wrap {
    inline-size: 100%;
    min-inline-size: 0;
    overflow: clip;
    border-radius: 0;
  }

  .writing-spread-wrap :global(.magazine-spread) {
    padding-block: 0;
    border-radius: 0;
  }

  .writing-spread-wrap :global(.magazine-feature-image),
  .writing-spread-wrap :global(.magazine-feature-image img),
  .writing-spread-wrap :global(.magazine-rail-thumb),
  .writing-spread-wrap :global(.magazine-rail-thumb img) {
    border-radius: 0;
  }

  .writing-empty {
    inline-size: 100%;
    max-inline-size: var(--substack-measure);
    margin-inline: auto;
    color: var(--muted);
    padding-block: 2.5rem;
    margin-block: 0;
  }

  .writing-archive {
    inline-size: 100%;
    max-inline-size: var(--substack-measure);
    margin-inline: auto;
    margin-block-start: clamp(3rem, 6vw, 4.5rem);
    min-inline-size: 0;
    border-radius: 0;
  }

  .writing-archive-head {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    margin-block-end: 1.5rem;
    min-inline-size: 0;
  }

  .writing-archive-heading {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.25rem, 2.2vw, 1.65rem);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink);
    line-height: 1.18;
    overflow-wrap: break-word;
  }

  .writing-archive-lede {
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.96rem;
    line-height: 1.55;
    color: var(--muted);
  }

  .writing-archive-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    border-block-start: 1px solid var(--hairline);
    border-radius: 0;
  }

  .writing-archive-item {
    border-block-end: 1px solid var(--hairline);
    border-radius: 0;
    min-inline-size: 0;
  }

  .writing-archive-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    gap: 1rem 1.5rem;
    padding-block: 1.4rem;
    padding-inline: 0;
    text-decoration: none;
    color: var(--ink);
    border-radius: 0;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .writing-archive-row:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 4px;
    border-radius: 0;
  }

  @media (hover: hover) and (pointer: fine) {
    .writing-archive-row:hover .writing-archive-title {
      text-decoration: underline;
      text-underline-offset: 0.22em;
      text-decoration-thickness: 1px;
    }

    .writing-archive-row:hover .writing-archive-thumb {
      border-color: var(--hairline-strong);
    }
  }

  .writing-archive-body {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    min-inline-size: 0;
  }

  .writing-archive-meta {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    line-height: 1.3;
  }

  .writing-archive-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 1.8vw, 1.3rem);
    font-weight: 700;
    line-height: 1.3;
    color: var(--ink);
    overflow-wrap: break-word;
  }

  .writing-archive-excerpt {
    margin: 0;
    font-family: var(--font-body);
    color: var(--muted);
    font-size: 0.94rem;
    line-height: 1.58;
    overflow-wrap: break-word;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .writing-archive-thumb {
    inline-size: 168px;
    aspect-ratio: 16 / 9;
    overflow: clip;
    background: var(--surface-2);
    border: 1px solid var(--hairline);
    border-radius: 0;
    flex: 0 0 auto;
    transition: border-color 0.2s ease;
  }

  .writing-archive-thumb img {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 0;
  }

  @media (max-width: 600px) {
    .writing-archive-row {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.9rem;
    }

    .writing-archive-thumb {
      inline-size: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .writing-archive-row,
    .writing-archive-thumb {
      transition: none;
    }
  }
</style>
