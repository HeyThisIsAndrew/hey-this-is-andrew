---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GoalsSection from '../../components/GoalsSection.astro';
import MagazineSpread from '@andrew/ui/MagazineSpread.astro';
import {
  SUBSTACK_PUBLICATION_URL,
  articleHref,
  getAllArticles,
  isExternalArticle,
  resolveLocalRendition,
  sanitizeVisibleCopy,
  toMagazineCard,
} from '../../lib/articles';
import { formatFeedDate } from '../../lib/dates';

const MAGAZINE_LIMIT = 4;
const allArticles = getAllArticles();
const magazineCards = allArticles.slice(0, MAGAZINE_LIMIT).map(toMagazineCard);
const remainingArticles = allArticles.slice(MAGAZINE_LIMIT);
---

<BaseLayout
  title="Writing · HEY_THISISANDREW"
  description="Notes from the build, essays, and Coffee Talk dispatches by Andrew Baxter."
  pane="Writing"
>
  <div class="container writing-page">
    <h1 class="vh">Build in Public</h1>

    <section
      id="writing"
      class="writing-spread-section"
      aria-labelledby="writing-heading"
      data-magazine-scroll-anchor
    >
      <div class="writing-pill-row" data-sec-head>
        <h2 id="writing-heading" class="writing-pill">Coffee Talk</h2>
      </div>
      {magazineCards.length > 0 ? (
        <div class="writing-spread-wrap">
          <MagazineSpread articles={magazineCards} readMoreLabel="Read Article" />
        </div>
      ) : (
        <p class="writing-empty">No articles imported yet. Run sync:articles to populate the snapshot.</p>
      )}
    </section>

    <section id="goals" class="writing-goals-section" aria-labelledby="goals-heading">
      <GoalsSection />
    </section>

    {remainingArticles.length > 0 && (
      <section id="articles" class="writing-articles-section" aria-label="More articles">
        <ul class="writing-card-grid" role="list">
          {remainingArticles.map((article, index) => {
            const href = articleHref(article);
            const external = isExternalArticle(article);
            const title = sanitizeVisibleCopy(article.title) || article.title;
            const excerpt = sanitizeVisibleCopy(article.excerpt);
            const formattedDate = formatFeedDate(article.isoDate, {
              month: 'short',
              day: 'numeric',
              year: 'numeric',
            });
            const localImg = resolveLocalRendition(article.image);
            const imgSrc = localImg?.src || article.image;
            const cardTags = (article.tags ?? [])
              .map((tag) => sanitizeVisibleCopy(tag))
              .filter(Boolean)
              .slice(0, 2);
            const tagLine = cardTags.length > 0 ? cardTags.join(' | ') : article.category || '';
            return (
              <li class="writing-card-item">
                <a
                  class="writing-card-link"
                  href={href}
                  target={external ? '_blank' : undefined}
                  rel={external ? 'noopener noreferrer' : undefined}
                >
                  <article class="writing-card">
                    {imgSrc && (
                      <div class="writing-card-media">
                        <img
                          src={imgSrc}
                          srcset={localImg?.srcset || undefined}
                          sizes={localImg?.srcset ? '(max-width: 560px) 92vw, (max-width: 1100px) 46vw, 24vw' : undefined}
                          alt=""
                          width="1456"
                          height="816"
                          loading={index < 3 ? 'eager' : 'lazy'}
                          decoding="async"
                        />
                        <span class="writing-card-format" aria-hidden="true">Article</span>
                      </div>
                    )}
                    <div class="writing-card-body">
                      {(tagLine || formattedDate) && (
                        <div class="writing-card-meta">
                          {tagLine && <span class="writing-card-tags">{tagLine}</span>}
                          {tagLine && formattedDate && <span class="writing-card-sep" aria-hidden="true">|</span>}
                          {formattedDate && (
                            <time class="writing-card-date" datetime={article.isoDate || undefined}>
                              {formattedDate}
                            </time>
                          )}
                        </div>
                      )}
                      <h3 class="writing-card-title">{title}</h3>
                      {excerpt && <p class="writing-card-excerpt">{excerpt}</p>}
                    </div>
                  </article>
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    )}

    <div class="writing-page-actions">
      <a
        class="btn btn-primary"
        href={SUBSTACK_PUBLICATION_URL}
        target="_blank"
        rel="noopener noreferrer"
      >
        Read on Substack
        <span aria-hidden="true">&nearr;</span>
      </a>
      <a
        class="btn btn-ghost"
        href={`${SUBSTACK_PUBLICATION_URL}/subscribe`}
        target="_blank"
        rel="noopener noreferrer"
      >
        Subscribe
      </a>
    </div>
  </div>
</BaseLayout>

<style>
  :global(html:has(.writing-page)) {
    --writing-measure: 1536px;
  }

  @media (min-width: 1920px) {
    :global(html:has(.writing-page)) {
      --writing-measure: 1920px;
    }
  }

  @media (min-width: 2560px) {
    :global(html:has(.writing-page)) {
      --writing-measure: 2240px;
    }
  }

  @media (min-width: 3400px) {
    :global(html:has(.writing-page)) {
      --writing-measure: 2600px;
      font-size: 115%;
    }
  }

  @media (min-width: 1600px) {
    :global(html[data-screen-4k]:has(.writing-page)) {
      font-size: 115%;
    }
  }

  .writing-page {
    width: min(100% - clamp(2rem, 4vw, 5rem), var(--writing-measure));
    max-inline-size: var(--writing-measure);
    margin-inline: auto;
    padding-block: clamp(1.5rem, 2.5vw, 2.5rem) clamp(3rem, 5vw, 6rem);
    min-inline-size: 0;
    border-radius: 0;
  }

  .writing-spread-section,
  .writing-goals-section,
  .writing-articles-section {
    inline-size: 100%;
    max-inline-size: var(--writing-measure);
    margin-inline: auto;
    border: 0;
    border-radius: 0;
    min-inline-size: 0;
  }

  .writing-spread-section,
  .writing-goals-section {
    scroll-margin-top: calc(var(--nav-bar-h, 76px) + 1rem);
  }

  .writing-spread-section {
    padding-block: 0 clamp(2.5rem, 4vw, 4rem);
  }

  .writing-goals-section {
    padding-block: 0 clamp(2.25rem, 3.8vw, 3.75rem);
  }

  .writing-articles-section {
    padding-block: 0 clamp(2.25rem, 3.8vw, 3.75rem);
  }

  .writing-pill-row {
    display: flex;
    align-items: center;
    margin-block-end: clamp(1rem, 1.5vw, 1.5rem);
    min-inline-size: 0;
  }

  /* Match BrandAccordion .bacc-chip + .bacc-chip--brand, scaled in rem. */
  .writing-pill {
    display: inline-flex;
    align-items: center;
    max-inline-size: 100%;
    box-sizing: border-box;
    margin: 0;
    padding: 0.4rem 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-inline-start: 2px solid var(--accordion-edge, #f0f0f0);
    border-radius: 0;
    background: rgba(10, 10, 10, 0.65);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    font-family: var(--font-body, sans-serif);
    font-weight: 600;
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    line-height: 1.2;
    color: rgba(255, 255, 255, 0.95);
    white-space: normal;
    overflow-wrap: break-word;
  }

  .writing-spread-wrap {
    inline-size: 100%;
    min-inline-size: 0;
    border-radius: 0;
  }

  /* Reset global section padding so MagazineSpread sits flush inside its frame. */
  .writing-spread-wrap :global(.magazine-spread) {
    margin: 0;
    padding-block: 0;
    border-radius: 0;
  }

  .writing-spread-wrap :global(.magazine-spread .magazine-feature-image),
  .writing-spread-wrap :global(.magazine-spread .magazine-feature-image img),
  .writing-spread-wrap :global(.magazine-spread .magazine-rail-thumb),
  .writing-spread-wrap :global(.magazine-spread .magazine-rail-thumb img) {
    border-radius: 0;
  }

  .writing-spread-wrap :global(.magazine-spread .magazine-rail-item),
  .writing-spread-wrap :global(.magazine-spread .magazine-rail-title),
  .writing-spread-wrap :global(.magazine-spread .magazine-rail-thumb img),
  .writing-spread-wrap :global(.magazine-spread .magazine-feature-image img),
  .writing-spread-wrap :global(.magazine-spread .magazine-feature-cta),
  .writing-spread-wrap :global(.magazine-spread .magazine-feature-cta::after) {
    transition-timing-function: ease-in-out;
  }

  .writing-spread-wrap :global(.magazine-spread .magazine-feature-copy) {
    justify-content: flex-start;
  }

  .writing-spread-wrap :global(.magazine-spread .magazine-feature-title) {
    text-transform: none;
    letter-spacing: -0.01em;
  }

  .writing-spread-wrap :global(.magazine-spread .magazine-rail-title) {
    text-transform: none;
    letter-spacing: 0;
  }

  .writing-spread-wrap :global(.magazine-spread .magazine-feature-excerpt) {
    --excerpt-lines: 6;
  }

  @media (min-width: 2560px) {
    .writing-spread-wrap :global(.magazine-spread .magazine-feature-excerpt) {
      --excerpt-lines: 8;
    }
  }

  @media (min-width: 3400px) {
    .writing-spread-wrap :global(.magazine-spread .magazine-feature-excerpt) {
      --excerpt-lines: 10;
    }
  }

  .writing-spread-wrap :global(.magazine-spread :focus-visible) {
    outline-offset: -3px;
    border-radius: 0;
  }

  @media (max-width: 767px) {
    .writing-spread-wrap :global(.magazine-spread .magazine-feature-excerpt) {
      --excerpt-lines: 4;
    }

    .writing-spread-wrap :global(.magazine-spread .magazine-rail) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .writing-spread-wrap :global(.magazine-spread .magazine-rail-item) {
      padding: 1rem 0.75rem;
    }

    .writing-spread-wrap :global(.magazine-spread .magazine-rail-title) {
      font-size: 0.9rem;
    }

    .writing-spread-wrap :global(.magazine-spread .magazine-rail-meta) {
      display: block;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
  }

  .writing-empty {
    inline-size: 100%;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.6;
    padding-block: 1.5rem;
    margin: 0;
  }

  .writing-card-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
    border-radius: 0;
  }

  @media (max-width: 1100px) {
    .writing-card-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem;
    }
  }

  @media (max-width: 560px) {
    .writing-card-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.25rem;
    }
  }

  .writing-card-item {
    display: flex;
    min-inline-size: 0;
  }

  .writing-card-link {
    display: flex;
    inline-size: 100%;
    min-inline-size: 0;
    text-decoration: none;
    color: var(--ink);
    border-radius: 0;
  }

  .writing-card-link:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
    border-radius: 0;
  }

  .writing-card {
    display: flex;
    flex-direction: column;
    inline-size: 100%;
    min-inline-size: 0;
    background: var(--surface);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 0;
    overflow: hidden;
    transition: transform 0.25s ease-in-out, border-color 0.25s ease-in-out, box-shadow 0.25s ease-in-out;
  }

  .writing-card-media {
    position: relative;
    inline-size: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--surface-2);
    border-radius: 0;
  }

  .writing-card-media img {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 0;
    filter: brightness(1);
    transition: transform 0.45s ease-in-out, filter 0.35s ease-in-out;
  }

  .writing-card-format {
    position: absolute;
    left: 0.5rem;
    bottom: 0.5rem;
    z-index: 2;
    padding: 0.15rem 0.5rem;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 0;
    background: rgba(0, 0, 0, 0.68);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    font-family: var(--font-body, sans-serif);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    line-height: 1.3;
    color: rgba(255, 255, 255, 0.92);
    pointer-events: none;
  }

  .writing-card-body {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    gap: 0.35rem;
    padding: 0.85rem 1rem;
    background: var(--surface);
    border-block-start: 1px solid rgba(255, 255, 255, 0.05);
    min-inline-size: 0;
  }

  @media (max-width: 640px) {
    .writing-card-body {
      padding: 0.65rem 0.75rem;
      gap: 0.25rem;
    }
  }

  .writing-card-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    line-height: 1.35;
  }

  .writing-card-sep {
    opacity: 0.45;
  }

  .writing-card-date {
    font-family: inherit;
    font-size: inherit;
    font-weight: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    color: inherit;
    line-height: inherit;
  }

  .writing-card-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: 0;
    text-transform: none;
    color: var(--ink);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    overflow-wrap: break-word;
    min-block-size: calc(2 * 1.35em);
    transition: color 0.25s ease-in-out;
  }

  .writing-card-excerpt {
    margin: 0.15rem 0 0;
    font-family: var(--font-body);
    color: var(--muted);
    font-size: 0.82rem;
    line-height: 1.45;
    overflow-wrap: break-word;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (hover: hover) and (pointer: fine) {
    .writing-card-link:hover .writing-card,
    .writing-card-link:focus-visible .writing-card {
      transform: translateY(-6px);
      border-color: var(--ink);
      box-shadow: 0 18px 38px rgba(0, 0, 0, 0.8), inset 0 0 0 1px rgba(255, 255, 255, 0.15);
    }

    .writing-card-link:hover .writing-card-media img {
      transform: scale(1.06);
      filter: brightness(1.12);
    }

    .writing-card-link:hover .writing-card-title {
      color: #fff;
    }
  }

  .writing-page-actions {
    inline-size: 100%;
    max-inline-size: var(--writing-measure);
    margin: 0;
    margin-inline: auto;
    padding: 0;
    border: 0;
    border-radius: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.85rem 1.25rem;
  }

  .writing-page-actions :global(.btn) {
    border-radius: 0;
    transition-timing-function: ease-in-out;
  }

  @media (prefers-reduced-motion: reduce) {
    .writing-card,
    .writing-card-media img,
    .writing-card-title {
      transition: none;
    }

    .writing-card-link:hover .writing-card,
    .writing-card-link:focus-visible .writing-card {
      transform: none;
    }

    .writing-card-link:hover .writing-card-media img {
      transform: none;
    }
  }
</style>
