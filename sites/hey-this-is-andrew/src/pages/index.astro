---
/**
 * Homepage: a funnel (Prompt 2). Every topic gets one overall section here;
 * the depth lives on its archive page behind "View all".
 *
 *   hero (BrandCarousel, pending the hero exploration) -> brands (#directory)
 *   -> meet the creator + now -> selected work (/work) -> latest (/latest)
 *   -> goals (/goals) -> what I do (/services) -> the kit (#gear, /gear)
 *   -> newsletter -> footer
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeSections from '../components/HomeSections.astro';
import BrandCarousel from '../components/BrandCarousel.astro';
import { getLatestVideos } from '../lib/latest-content';

const videos = await getLatestVideos(3);
---
<BaseLayout
  title="HEY_THISISANDREW · Creator, Photographer, Coffee Drinker"
  description="Andrew Baxter documents the messy middle of building creative brands: the shoots, the edits, the gear, and everything learned along the way."
>
  <h1 class="vh">HEY_THISISANDREW: Creator, Photographer, Coffee Drinker</h1>
  <HomeSections>
    <BrandCarousel slot="hero" videos={videos} />
  </HomeSections>
</BaseLayout>
