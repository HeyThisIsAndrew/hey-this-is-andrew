---
import ArchiveLayout from '../layouts/ArchiveLayout.astro';
import SectionHeader from '@andrew/ui/SectionHeader.astro';
import PhotographyPortfolio from '../components/PhotographyPortfolio.astro';
import LatestCard from '../components/LatestCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import WorkflowStrip from '../components/WorkflowStrip.astro';
import { getCollection } from 'astro:content';
import { getLatestVideos } from '../lib/latest-content';
import { getInstagramPhotos } from '../lib/instagram';

const videos = await getLatestVideos(3);
const projects = (await getCollection('projects'))
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || +b.data.date - +a.data.date);
const hasPhotos = (await getInstagramPhotos(1)).length > 0;
---
<ArchiveLayout
  title="Work · HEY_THISISANDREW"
  description="Selected work from Andrew Baxter: bar and beverage photography, videos, and projects built in public."
  heading="Work"
  kicker="Proof of process"
  lede="Work behind the scenes: shoots, edits, and building in public."
>
  {hasPhotos ? <PhotographyPortfolio /> : <span id="photography" class="anchor-alias" aria-hidden="true"></span>}

  <section id="videos" aria-labelledby="videos-heading">
    <div class="container">
      <SectionHeader id="videos-heading" kicker="YouTube" title="Videos" />
      <div class="work-videos">
        {videos.map((v) => <LatestCard item={v} />)}
      </div>
    </div>
  </section>

  <section id="projects" aria-labelledby="projects-heading">
    <div class="container">
      <SectionHeader id="projects-heading" kicker="Proof of process" title="Projects" />
      <div class="work-projects">
        {projects.map((p) => <ProjectCard project={p} />)}
      </div>
      <div id="workflow">
        <WorkflowStrip />
      </div>
    </div>
  </section>
</ArchiveLayout>

<style>
  .anchor-alias { display: block; }
  .work-videos {
    display: grid;
    gap: var(--gap);
  }
  .work-projects {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: var(--gap);
  }
</style>
