---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import QrDialog from '@andrew/ui/QrDialog.astro';
import { SOCIAL_ICONS } from '@andrew/ui/icons';
import LatestCard from '../components/LatestCard.astro';
import headshot from '../assets/brands/hq/andrew-headshot.webp';
import { PERSONAL_BRAND } from '../data/brand';
import { SOCIALS, homeUrl } from '../data/nav';
import { CONTACT } from '../data/contact';
import { getLatestArticles, getLatestVideos, type LatestItem } from '../lib/latest-content';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const [videos, articles] = await Promise.all([getLatestVideos(1), getLatestArticles(1)]);
const recent: LatestItem[] = [
  ...videos.slice(0, 1),
  ...articles.slice(0, 1).map((article): LatestItem => ({ kind: 'article', label: 'Latest writing', title: article.title, description: article.subtitle, image: article.image, date: article.date, url: article.url })),
];
---
<BaseLayout title="Links · HEY_THISISANDREW" description="Videos, writing, gear, and everywhere to find Andrew Baxter." minimal>
  <div class="links-hub">
    <section class="links-profile" aria-label="Profile">
      <Image src={headshot} alt="" width={160} height={160} class="links-avatar" loading="eager" />
      <button type="button" class="links-logo-trigger" data-qr-open="andrew-links-qr" aria-haspopup="dialog" aria-controls="andrew-links-qr" aria-label="Open my links QR code">
        <Image src={PERSONAL_BRAND.logo} alt={PERSONAL_BRAND.name} widths={[280, 560]} sizes="280px" format="png" loading="eager" />
      </button>
      <p class="links-tagline">Creator · Photographer · Coffee Drinker</p>
    </section>

    <nav class="links-socials" aria-label="Find me on social media">
      {SOCIALS.map((social) => (
        <a href={social.href} target="_blank" rel="noopener noreferrer" aria-label={social.label} title={social.label} set:html={SOCIAL_ICONS[social.label]} />
      ))}
    </nav>

    <nav class="links-actions" aria-label="Explore">
      <a class="links-home" href={homeUrl}>Explore the full site <span aria-hidden="true">↗</span></a>
    </nav>

    <section class="links-recent" aria-labelledby="links-recent-title">
      <div class="links-section-head"><h2 id="links-recent-title">From the build</h2><a href={`${homeUrl}#latest`}>More posts <span aria-hidden="true">↗</span></a></div>
      <div class="links-content-grid">{recent.map((item) => <LatestCard item={item} compact />)}</div>
    </section>

    <a class="links-gear" href={`${base}/gear/`}><span>The kit behind the work</span><strong>Explore my gear <span aria-hidden="true">↗</span></strong></a>
    <footer class="links-footer"><span>© 2026 Andrew Baxter</span><a href={`${base}/privacy/`}>Privacy</a></footer>
  </div>
  <QrDialog id="andrew-links-qr" url={PERSONAL_BRAND.linksUrl} title="Keep in touch" label="Open my links" description="Scan to find my videos, writing, and social links." contact={{ href: `mailto:${CONTACT.personal}`, label: 'Contact' }} />
</BaseLayout>
<style>
  .links-hub { width: min(100% - 2rem, 860px); margin: 0 auto; padding: clamp(2rem, 5vw, 4rem) 0 1.5rem; }
  .links-profile { padding: 0; margin: 0; text-align: center; display: grid; justify-items: center; gap: 0.75rem; }
  .links-avatar { width: 120px; height: 120px; object-fit: cover; border-radius: 50%; border: 1px solid var(--line); }
  /* The CCC modal close pattern (CccInquiryModal.astro, .ccc-modal-close):
     no box, border, background, outline or tap highlight in any state from a
     mouse or a tap. Only a keyboard gets a thin 1px line (:focus-visible),
     white here because this site is monochrome. */
  .links-logo-trigger { appearance: none; width: min(74vw, 280px); min-height: 44px; border: none; border-radius: 0; background: none; padding: 0.25rem; cursor: pointer; outline: none; box-shadow: none; -webkit-tap-highlight-color: transparent; touch-action: manipulation; transition: opacity 0.2s ease; }
  .links-logo-trigger:hover { opacity: 0.7; }
  .links-logo-trigger:focus-visible { outline: 1px solid #fff; outline-offset: 2px; }
  .links-logo-trigger img { width: 100%; height: auto; }
  .links-tagline { margin: 0; color: var(--muted); font: 0.66rem/1.6 var(--font-mono); text-transform: uppercase; letter-spacing: 0.1em; }
  .links-socials { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.25rem; margin: 1rem 0 1.35rem; }
  .links-socials a { display: grid; place-items: center; width: 44px; height: 44px; color: #aaa; transition: color 0.2s ease, transform 0.2s ease; }
  .links-socials a:hover { color: white; transform: translateY(-2px); }
  .links-socials :global(svg) { width: 23px; height: 23px; }
  .links-actions { display: grid; grid-template-columns: minmax(0, 1fr); margin: 0 0 2rem; }
  .links-actions a { min-width: 0; min-height: 70px; display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; padding: 1rem 1.25rem; border: 1px solid var(--line); text-decoration: none; background: #101010; }
  .links-actions a:hover { border-color: #777; background: #181818; }
  .links-actions a > span { flex-shrink: 0; }
  .links-home { font: 0.8rem var(--font-mono); text-transform: uppercase; letter-spacing: 0.1em; }
  .links-recent { padding: 0; margin: 0; }
  .links-section-head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; border-top: 1px solid var(--line); padding-top: 1.25rem; margin-bottom: 1rem; }
  .links-section-head h2 { margin: 0; font: 500 0.8rem var(--font-mono); text-transform: uppercase; letter-spacing: 0.13em; }
  .links-section-head a { min-height: 44px; display: flex; align-items: center; gap: 0.5rem; font: 0.7rem var(--font-mono); color: #aaa; text-decoration: none; }
  .links-content-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .links-gear { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-top: 1rem; padding: 1.15rem; border: 1px solid var(--line); text-decoration: none; }
  .links-gear > span { color: #aaa; font-size: 0.85rem; }
  .links-gear strong { font: 0.7rem var(--font-mono); text-transform: uppercase; letter-spacing: 0.08em; }
  .links-footer { display: flex; justify-content: space-between; gap: 1rem; padding-top: 2rem; color: #777; font-size: 0.75rem; }
  .links-footer a { min-height: 44px; display: flex; align-items: center; }
  @media (max-width: 600px) {
    .links-content-grid { grid-template-columns: minmax(0, 1fr); }
    .links-actions a { min-width: 0; min-height: 64px; padding: 0.85rem; }
    .links-gear { align-items: flex-start; flex-direction: column; gap: 0.4rem; }
  }
  @media (prefers-reduced-motion: reduce) { .links-socials a, .links-logo-trigger { transition: none; } }
</style>
