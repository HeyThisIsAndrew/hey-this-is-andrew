---
// Shared building blocks first (tokens, then this site's theme, then the
// shared base layer), then this site's own globals.
import '@andrew/tokens/tokens.css';
import '../styles/theme.css';
import '@andrew/ui/styles/base.css';
import '@andrew/ui/styles/chips.css';
import '../styles/global.css';
import '@andrew/ui/styles/cta.css';
import '../styles/parallax.css';
import Nav from '@andrew/ui/Nav.astro';
import Footer from '@andrew/ui/Footer.astro';
import SiteSearch from '../components/SiteSearch.astro';
import LiveBanner from '../components/LiveBanner.astro';
import VideoPlayer from '../components/VideoPlayer.astro';
// Andrew's own logo file (restored from b9cc358) is the nav logo, shown
// as-is: one PNG at 2x the nav's largest height (3rem), never redrawn.
// The footer uses it too, at 2x its 5rem height.
import logoPng from '../assets/brand-logos/hey-thisisandrew.png';
import { getImage } from 'astro:assets';
import { NAV_LINKS, FOOTER_EXPLORE, SOCIALS, PRIVACY_HREF, SEARCH_TRIGGER, homeUrl } from '../data/nav';
const navLogo = await getImage({ src: logoPng, height: 96, format: 'png' });
const footerLogo = await getImage({ src: logoPng, height: 160, format: 'png' });

interface Props {
  title: string;
  description?: string;
  /** Keep the page out of search engines (hero concept previews). */
  noindex?: boolean;
}

const {
  title,
  description = 'Andrew Baxter: creator, photographer, and coffee drinker building brands in public.',
  noindex = false,
} = Astro.props;

// Link preview image and canonical URLs: production GitHub Pages path
const siteUrl = 'https://heythisisandrew.github.io/hey-this-is-andrew';
const ogImage = `${siteUrl}/og-image.png`;
const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
// Canonical: the production origin plus this page's path (which already
// carries the base path on the production build).
const canonical = new URL(Astro.url.pathname, 'https://heythisisandrew.github.io').href;
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, interactive-widget=resizes-content" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <title>{title}</title>
    <!-- Dark-mode only (decision 6). The theme toggle is hidden, so the
         stored/OS preference is no longer read; <html> ships data-theme="dark".
         To bring the light theme back, restore this script and the toggle in
         Nav.astro:
    <script is:inline>
      (function() {
        try {
          const stored = localStorage.getItem('theme');
          const theme = stored ? stored : (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {}
      })();
    </script>
    -->
    <link rel="sitemap" type="application/xml" href={`${siteUrl}/sitemap-index.xml`} />
    <link rel="alternate" type="application/rss+xml" title="HEY_THISISANDREW: writing" href={`${baseUrl}rss.xml`} />
    <style>
      .site-camera-stage {
        position: relative;
        margin: 0;
        padding: 0;
      }
      #main-content {
        margin: 0;
        padding: 0;
      }
    </style>
    <!-- Favicon: white H_ on #080808, Syne 800 (scripts/build-brand-marks.mjs) -->
    <link rel="icon" href={`${baseUrl}favicon.ico`} sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${baseUrl}favicon-16.png`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${baseUrl}favicon-32.png`} />
    <link rel="icon" type="image/png" sizes="64x64" href={`${baseUrl}favicon-64.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${baseUrl}apple-touch-icon.png`} />
    <meta name="theme-color" content="#080808" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Syne:wght@600;700;800&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- Scroll Progress Indicator Bar -->
    <a class="skip-link" href="#main-content">Skip to content</a>
    <!-- Decorative: the browser's own scrollbar already says where you are. -->
    <div id="scroll-progress" class="scroll-progress-bar" aria-hidden="true"></div>
    <Nav
      logo={{ src: navLogo.src, width: Number(navLogo.attributes.width), height: Number(navLogo.attributes.height), alt: 'HEY_THISISANDREW' }}
      homeHref={homeUrl}
      links={NAV_LINKS}
      search={SEARCH_TRIGGER}
    >
      <SiteSearch />
    </Nav>
    <LiveBanner />
    <div id="site-camera-stage" class="site-camera-stage">
      <main id="main-content" tabindex="-1">
        <slot />
      </main>
    </div>
    <Footer
      logo={{ src: footerLogo.src, width: Number(footerLogo.attributes.width), height: Number(footerLogo.attributes.height), alt: 'HEY_THISISANDREW' }}
      tagline="Creator, photographer, coffee drinker."
      explore={FOOTER_EXPLORE}
      socials={SOCIALS}
      copyright="© 2026 Andrew Baxter. All rights reserved."
      privacyHref={PRIVACY_HREF}
      notes={['Built in public with Astro.', 'All process, no perfectionism.']}
    />
    <VideoPlayer />
    <script>
      // Complete the incoming half of a route zoom (About <-> Home).
      import { handleRouteEnter, initReveals, initRouteTransitions } from '../lib/spatial.ts';
      import { initParallaxFallback } from '../lib/parallax.ts';
      import { initSectionAnchors } from '@andrew/ui/scripts/section-anchors.ts';
      // Route zoom: About <-> Home expand from the tapped element.
      initRouteTransitions('a[data-route-zoom]');
      handleRouteEnter('main');
      initReveals();
      initSectionAnchors();
      // CSS view() timelines drive parallax where supported; this is the
      // rAF fallback for older browsers. No-op when native support exists.
      initParallaxFallback();

      // Single authoritative in-page anchor navigation system.
      // Reliability beats spectacle: smoothly lands on the requested section
      // with exact offset for the sticky navbar, coherent URL hash state,
      // and no conflicting transforms, duplicate listeners, or bounce sequences.
      (function () {
        function getNavHeight() {
          const nav = document.querySelector('.site-nav');
          return nav ? nav.getBoundingClientRect().height : 72;
        }

        function scrollToTarget(target: Element, pushHash = false, hash = '') {
          if (!target) return;
          const isTop = hash === '#top' || hash === '#overview' || target.id === 'overview' || target.id === 'top';
          const navH = getNavHeight();
          const targetTop = isTop ? 0 : Math.max(0, target.getBoundingClientRect().top + window.scrollY - navH);
          if (pushHash && hash) {
            history.pushState(null, '', hash);
          }
          window.scrollTo({
            top: targetTop,
            behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
          });
        }

        // Intercept internal anchor link clicks
        document.addEventListener('click', (e) => {
          if (e.metaKey || e.ctrlKey || e.shiftKey || e.button === 1) return;
          const targetEl = e.target as Element | null;
          if (!targetEl || typeof targetEl.closest !== 'function') return;
          const link = targetEl.closest('a[href*="#"]') as HTMLAnchorElement | null;
          if (!link) return;
          const href = link.getAttribute('href') || '';
          const hashIndex = href.indexOf('#');
          if (hashIndex === -1) return;
          const hash = href.slice(hashIndex);
          if (!hash || hash === '#') return;

          // Only intercept same-page hashes.
          const linkPath = href.slice(0, hashIndex);
          const currentPath = window.location.pathname;
          if (linkPath && linkPath !== currentPath && linkPath !== currentPath.replace(/\/$/, '') && linkPath !== '/') {
            return;
          }

          const target = document.querySelector(hash);
          if (!target) return;

          e.preventDefault();
          scrollToTarget(target, true, hash);
        });

        // Initial hash load
        if (window.location.hash) {
          const target = document.querySelector(window.location.hash);
          if (target) {
            setTimeout(() => scrollToTarget(target, false), 150);
          }
        }

        // Browser back / forward
        window.addEventListener('popstate', () => {
          if (window.location.hash) {
            const target = document.querySelector(window.location.hash);
            if (target) scrollToTarget(target, false);
          } else if (window.location.pathname === '/' || window.location.pathname === '') {
            window.scrollTo({ top: 0, behavior: 'smooth' });
          }
        });
      })();

      // Hero entrance transition: triggers only once on page load
      (function () {
        let heroTriggered = false;
        function triggerHeroEntrance() {
          if (heroTriggered) return;
          heroTriggered = true;
          const heroElements = document.querySelectorAll('.hero-content');
          heroElements.forEach((el) => {
            el.classList.add('hero-entered');
          });
        }

        if (document.readyState === 'loading') {
          window.addEventListener('DOMContentLoaded', () => {
            requestAnimationFrame(() => {
              requestAnimationFrame(triggerHeroEntrance);
            });
          }, { once: true });
        } else {
          requestAnimationFrame(() => {
            requestAnimationFrame(triggerHeroEntrance);
          });
        }
      })();

      // Scroll progress indicator for main content
      (function () {
        const progressBar = document.getElementById('scroll-progress') as HTMLElement | null;
        const main = (document.getElementById('main-content') || document.querySelector('main')) as HTMLElement | null;
        if (!progressBar || !main) return;

        const targetBar = progressBar;
        const targetMain = main;

        let ticking = false;
        function updateProgress() {
          const mainRect = targetMain.getBoundingClientRect();
          const mainTop = mainRect.top + window.scrollY;
          const mainHeight = targetMain.offsetHeight || mainRect.height;
          const viewportHeight = window.innerHeight;
          const maxScroll = mainHeight - viewportHeight;

          if (maxScroll <= 0) {
            targetBar.style.transform = 'scaleX(1)';
            ticking = false;
            return;
          }

          const currentScroll = window.scrollY - mainTop;
          const progress = Math.min(Math.max(currentScroll / maxScroll, 0), 1);
          targetBar.style.transform = `scaleX(${progress.toFixed(4)})`;
          ticking = false;
        }

        function onScroll() {
          if (!ticking) {
            requestAnimationFrame(updateProgress);
            ticking = true;
          }
        }

        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll, { passive: true });
        updateProgress();
      })();

      // Back to top floating button logic
      (function () {
        const btn = document.getElementById('back-to-top-btn');
        if (!btn) return;

        // The button never covers content marked [data-avoid-fab] (the brand
        // accordion, full-bleed to the right edge): while such a block sits
        // under the button's corner, the button steps out of the way.
        const avoid = Array.from(document.querySelectorAll<HTMLElement>('[data-avoid-fab]'));
        const coversAvoided = () => {
          const b = btn.getBoundingClientRect();
          const zoneTop = b.top - 8;
          return avoid.some((el) => {
            const r = el.getBoundingClientRect();
            return r.top < window.innerHeight && r.bottom > zoneTop;
          });
        };
        const update = () => {
          btn.classList.toggle('visible', window.scrollY > 600 && !coversAvoided());
        };
        window.addEventListener('scroll', update, { passive: true });
        window.addEventListener('resize', update, { passive: true });

        btn.addEventListener('click', () => {
          window.scrollTo({
            top: 0,
            behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
          });
        });
      })();
    </script>
    <button type="button" class="back-to-top" id="back-to-top-btn" aria-label="Back to top" title="Back to top">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M18 15l-6-6-6 6"/>
      </svg>
    </button>
  </body>
</html>
