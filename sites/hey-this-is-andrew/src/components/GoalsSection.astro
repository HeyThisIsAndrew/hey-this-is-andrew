---
import { getCollection } from 'astro:content';
import { CCC_PAGE } from '../data/ccc';
import GoalModal, {
  type GoalModalGroup,
  type GoalStageItem,
  type NormalizedStatus,
} from './GoalModal.astro';

const goalsCollection = await getCollection('goals');
const bigGoalsEntry = goalsCollection.find((group) => group.id === 'big-goals') ?? goalsCollection[0];

// The Core Engine milestones and Andrew's ACTUAL status for each. Every one
// serves a Big Goal (goals.json): m1 Build the Reelay tool, m2 Get
// monetized, m3 Be a full-time UGC creator, m4 Be consistent with posting
// content (queued, secondary). This is
// the only source of the tracker: the boxes are display-only (they were
// visitor checkboxes saved to the visitor's own browser, so anyone could
// "complete" Andrew's milestones). Update a status here to change the page.
type MilestoneStatus = 'done' | 'in-progress' | 'queued';
const MILESTONES: { id: string; title: string; desc: string; status: MilestoneStatus }[] = [
  { id: 'm1', title: 'Build the Reelay tool', desc: "I'm building Reelay so I can prep, schedule, and post every video to every platform from one place.", status: 'in-progress' },
  { id: 'm2', title: 'Share my gear and workflow', desc: "I'm showing the cameras, lights, and software I use, so you can see how I work. The gear links help me get monetized.", status: 'in-progress' },
  { id: 'm3', title: 'Revenue & Partnerships', desc: "I'm growing direct UGC brand partnerships and affiliate income.", status: 'in-progress' },
  { id: 'm4', title: 'Press access', desc: 'I want press passes to the events I cover, so I have more to film and post.', status: 'queued' },
];
const doneCount = MILESTONES.filter((m) => m.status === 'done').length;

type GoalStatus = 'done' | 'in-progress' | 'queued' | 'next';

const normalizeStatus = (status: GoalStatus): NormalizedStatus =>
  status === 'next' ? 'queued' : status;

const formatStatusLabel = (status: GoalStatus): string => {
  const key = normalizeStatus(status);
  if (key === 'done') return 'Done';
  if (key === 'in-progress') return 'In progress';
  return 'Queued';
};

const BE_STAGES: GoalStageItem[] = [
  {
    status: 'achieved',
    statusLabel: 'Achieved',
    name: 'Foundation',
    detail: 'Independent editorial calendar and breaking coverage system.',
  },
  {
    status: 'active',
    statusLabel: 'Active',
    name: 'On-Site Access',
    detail: 'Major event press credentials and live floor coverage.',
  },
  {
    status: 'upcoming',
    statusLabel: 'Upcoming',
    name: 'Commercial Integration',
    detail: 'Paid event photography and marketing partnerships.',
  },
  {
    status: 'target',
    statusLabel: 'Target',
    name: 'Industry Milestone',
    detail: 'Critics Choice Association (CCA) accreditation.',
  },
];

const CCC_STAGES: GoalStageItem[] = [
  {
    status: 'achieved',
    statusLabel: 'Achieved',
    name: 'System Setup',
    detail: 'Native 9:16 capture pipeline and portfolio build.',
  },
  {
    status: 'active',
    statusLabel: 'Active',
    name: 'Local Penetration',
    detail: 'Orange County bars and restaurants.',
  },
  {
    status: 'upcoming',
    statusLabel: 'Upcoming',
    name: 'Digital Products',
    detail: 'Lightroom drink presets and lighting recipe guides.',
  },
  {
    status: 'target',
    statusLabel: 'Target',
    name: 'National Campaigns',
    detail: 'Commercial beverage brand contracts and licensing.',
  },
];

const formatStageProgress = (stages: GoalStageItem[]): string => {
  const activeIndex = stages.findIndex((stage) => stage.status === 'active');
  const currentStage =
    activeIndex >= 0
      ? activeIndex + 1
      : stages.filter((stage) => stage.status === 'achieved').length;
  return `${currentStage} / ${stages.length} stages`;
};

const bigGoalsItems = bigGoalsEntry
  ? bigGoalsEntry.data.items.map((item) => ({
      title: item.label,
      desc: item.note,
      status: normalizeStatus(item.status),
      statusLabel: formatStatusLabel(item.status),
    }))
  : [];
const bigGoalsDone = bigGoalsItems.filter((item) => item.status === 'done').length;

const coreEngineItems = MILESTONES.map((m) => ({
  title: m.title,
  desc: m.desc,
  status: normalizeStatus(m.status),
  statusLabel: formatStatusLabel(m.status),
  milestoneId: m.id,
}));

const modalGroups: GoalModalGroup[] = [
  {
    id: bigGoalsEntry?.id ?? 'big-goals',
    kind: 'checklist',
    title: bigGoalsEntry?.data.title ?? 'The Big Goals',
    progressText: `${bigGoalsDone} / ${bigGoalsItems.length}`,
    items: bigGoalsItems,
  },
  {
    id: 'core-engine',
    kind: 'checklist',
    title: 'Core Engine',
    progressText: `${doneCount} / ${MILESTONES.length}`,
    items: coreEngineItems,
  },
  {
    id: 'be',
    kind: 'stages',
    kicker: 'BE Unconventional HQ',
    title: 'Press Outlet',
    progressText: formatStageProgress(BE_STAGES),
    stages: BE_STAGES,
  },
  {
    id: 'ccc',
    kind: 'stages',
    kicker: 'Capture Create Caffeinate',
    title: 'Cocktail Photography',
    progressText: formatStageProgress(CCC_STAGES),
    stages: CCC_STAGES,
  },
];

interface PreviewGoal {
  label: string;
  statusLabel: string;
  checklistStatus?: NormalizedStatus;
  stageNumber?: string;
  stageStatus?: GoalStageItem['status'];
  totalCount: number;
}

const previewForGroup = (group: GoalModalGroup): PreviewGoal => {
  if (group.kind === 'checklist') {
    const picked =
      group.items.find((item) => item.status === 'in-progress') ??
      group.items.find((item) => item.status !== 'done') ??
      group.items[0];
    return {
      label: picked?.title ?? group.title,
      statusLabel: picked?.statusLabel ?? 'Queued',
      checklistStatus: picked?.status ?? 'queued',
      totalCount: group.items.length,
    };
  }
  const activeIdx = group.stages.findIndex((stage) => stage.status === 'active');
  const achievedIdx = group.stages.findIndex((stage) => stage.status === 'achieved');
  const pickedIdx = activeIdx >= 0 ? activeIdx : achievedIdx >= 0 ? achievedIdx : 0;
  const picked = group.stages[pickedIdx] ?? group.stages[0];
  return {
    label: picked?.name ?? group.title,
    statusLabel: picked?.statusLabel ?? 'Active',
    stageNumber: String(pickedIdx + 1).padStart(2, '0'),
    stageStatus: picked?.status ?? 'active',
    totalCount: group.stages.length,
  };
};
---

<div class="goals-column">
  <div class="goals-pill-row" data-sec-head>
    <h2 id="goals-heading" class="goals-pill">Goals</h2>
  </div>

  <div class="goals-row" role="list" aria-label="Goal groups">
    {modalGroups.map((group) => {
      const preview = previewForGroup(group);
      return (
        <div class="goals-row-item" role="listitem" id={group.id}>
          <button
            type="button"
            class="goal-box"
            data-goal-trigger={group.id}
            aria-haspopup="dialog"
            aria-controls="goal-modal"
          >
            <span class="goal-box-head">
              <span class="goal-box-title-wrap">
                {group.kicker && <span class="goal-box-kicker font-mono">{group.kicker}</span>}
                <span class="goal-box-title">{group.title}</span>
              </span>
              <span class="goal-box-progress font-mono">{group.progressText}</span>
            </span>

            <span class="goal-box-preview">
              <span class="goal-preview-row">
                {preview.checklistStatus ? (
                  <span
                    class:list={['preview-mark', `is-${preview.checklistStatus}`]}
                    aria-hidden="true"
                  >
                    {preview.checklistStatus === 'done' && (
                      <svg viewBox="0 0 16 16" width="10" height="10" fill="none">
                        <path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="2" stroke-linecap="square" />
                      </svg>
                    )}
                  </span>
                ) : (
                  <span class="preview-stage-num font-mono">{preview.stageNumber}</span>
                )}
                <span class="goal-preview-label">{preview.label}</span>
              </span>
              <span class="goal-preview-badge font-mono" data-status={preview.checklistStatus || preview.stageStatus}>
                {preview.statusLabel}
              </span>
            </span>

            <span class="goal-box-cta font-mono">
              View all {preview.totalCount} <span class="goal-box-arrow" aria-hidden="true">&rarr;</span>
            </span>
          </button>
        </div>
      );
    })}
  </div>

  <GoalModal groups={modalGroups} cccPageHref={CCC_PAGE} />
</div>

<style>
  .goals-column {
    inline-size: 100%;
    max-inline-size: var(--writing-measure, var(--maxw));
    margin-inline: auto;
    min-inline-size: 0;
    border-radius: 0;
  }

  .goals-pill-row {
    display: flex;
    align-items: center;
    margin-block-end: clamp(1rem, 1.5vw, 1.5rem);
    min-inline-size: 0;
  }

  .goals-pill {
    display: inline-flex;
    align-items: center;
    max-inline-size: 100%;
    box-sizing: border-box;
    margin: 0;
    padding: 0.4rem 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-inline-start: 2px solid var(--accordion-edge, #f0f0f0);
    border-radius: 0;
    background: rgba(10, 10, 10, 0.65);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    font-family: var(--font-body, sans-serif);
    font-weight: 600;
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    line-height: 1.2;
    color: rgba(255, 255, 255, 0.95);
    white-space: normal;
    overflow-wrap: break-word;
  }

  .goals-row {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1rem, 1.25vw, 1.5rem);
    inline-size: 100%;
    max-inline-size: 100%;
    min-inline-size: 0;
    border-radius: 0;
  }

  .goals-row-item {
    display: flex;
    min-inline-size: 0;
    border-radius: 0;
    scroll-margin-top: calc(var(--nav-bar-h, 76px) + 1.5rem);
  }

  .goal-box {
    appearance: none;
    inline-size: 100%;
    block-size: 100%;
    min-block-size: 13.5rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.35rem;
    padding-inline: 1.35rem;
    border: 1px solid var(--hairline);
    border-radius: 0;
    background: var(--surface);
    color: var(--ink);
    text-align: start;
    cursor: pointer;
    box-sizing: border-box;
    min-inline-size: 0;
    transition: border-color 0.22s ease-in-out, background-color 0.22s ease-in-out, color 0.22s ease-in-out;
  }

  @media (hover: hover) and (pointer: fine) {
    .goal-box:hover {
      border-color: var(--ink);
      background: var(--surface-2);
    }

    .goal-box:hover .goal-box-cta {
      color: var(--ink);
    }

    .goal-box:hover .goal-box-arrow {
      transform: translateX(3px);
    }
  }

  .goal-box:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
    border-color: var(--ink);
    border-radius: 0;
  }

  .goal-box-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
    inline-size: 100%;
    min-inline-size: 0;
  }

  .goal-box-title-wrap {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
    min-inline-size: 0;
  }

  .goal-box-kicker {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    line-height: 1.3;
    overflow-wrap: break-word;
  }

  .goal-box-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1rem, 1.15vw, 1.35rem);
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--ink);
    line-height: 1.22;
    overflow-wrap: break-word;
  }

  .goal-box-progress {
    flex: 0 0 auto;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    line-height: 1.3;
    white-space: nowrap;
    margin-block-start: 0.125rem;
  }

  .goal-box-preview {
    inline-size: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6rem;
    padding-block-start: 0.85rem;
    border-block-start: 1px solid var(--hairline);
    border-radius: 0;
    min-inline-size: 0;
  }

  .goal-preview-row {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    inline-size: 100%;
    min-inline-size: 0;
  }

  .preview-mark {
    display: inline-grid;
    place-items: center;
    margin-block-start: 0.2rem;
    inline-size: 0.95rem;
    block-size: 0.95rem;
    flex: 0 0 auto;
    border: 1px solid var(--hairline-strong);
    border-radius: 0;
    color: var(--bg);
    background: transparent;
  }

  .preview-mark.is-done {
    background: var(--ink);
    border-color: var(--ink);
  }

  .preview-mark.is-in-progress {
    border-color: var(--ink);
  }

  .preview-mark.is-in-progress::after {
    content: '';
    inline-size: 0.35rem;
    block-size: 0.35rem;
    background: var(--ink);
    border-radius: 0;
  }

  .preview-stage-num {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--muted);
    line-height: 1.45;
    flex: 0 0 auto;
  }

  .goal-preview-label {
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 500;
    line-height: 1.4;
    color: var(--ink);
    overflow-wrap: break-word;
    min-inline-size: 0;
  }

  .goal-preview-badge {
    display: inline-block;
    padding-block: 0.25rem;
    padding-inline: 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    line-height: 1.2;
    border: 1px solid var(--hairline-strong);
    border-radius: 0;
    color: var(--ink);
    background: transparent;
    white-space: nowrap;
  }

  .goal-preview-badge[data-status='done'] {
    background: var(--surface-2);
  }

  .goal-box-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    line-height: 1.2;
    transition: color 0.22s ease-in-out;
  }

  .goal-box-arrow {
    display: inline-block;
    transition: transform 0.22s ease-in-out;
  }

  @media (max-width: 960px) {
    .goals-row {
      display: flex;
      flex-wrap: nowrap;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      gap: 0.75rem;
      padding-block-end: 6px;
      scrollbar-width: thin;
      scrollbar-color: var(--hairline-strong) transparent;
    }

    .goals-row-item {
      flex: 0 0 min(78vw, 290px);
      scroll-snap-align: start;
    }

    .goal-box {
      min-block-size: 11.5rem;
      padding-block: 1rem;
      padding-inline: 1rem;
    }

    .goal-box-title {
      font-size: 0.95rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .goal-box,
    .goal-box-cta,
    .goal-box-arrow {
      transition: none;
    }

    .goal-box:hover .goal-box-arrow {
      transform: none;
    }
  }
</style>
