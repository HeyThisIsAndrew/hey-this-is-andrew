---
import { getCollection } from 'astro:content';
import { CCC_PAGE } from '../data/ccc';

const goalsCollection = await getCollection('goals');
goalsCollection.sort((a, b) => a.data.order - b.data.order);

// The Core Engine milestones and Andrew's ACTUAL status for each. Every one
// serves a Big Goal (goals.json): m1 Build the Reelay tool, m2 Get
// monetized, m3 Be a full-time UGC creator, m4 Be consistent with posting
// content (queued, secondary). This is
// the only source of the tracker: the boxes are display-only (they were
// visitor checkboxes saved to the visitor's own browser, so anyone could
// "complete" Andrew's milestones). Update a status here to change the page.
type MilestoneStatus = 'done' | 'in-progress' | 'queued';
const MILESTONES: { id: string; title: string; desc: string; status: MilestoneStatus }[] = [
  { id: 'm1', title: 'Build the Reelay tool', desc: "I'm building Reelay so I can prep, schedule, and post every video to every platform from one place.", status: 'in-progress' },
  { id: 'm2', title: 'Share my gear and workflow', desc: "I'm showing the cameras, lights, and software I use, so you can see how I work. The gear links help me get monetized.", status: 'in-progress' },
  { id: 'm3', title: 'Revenue & Partnerships', desc: "I'm growing direct UGC brand partnerships and affiliate income.", status: 'in-progress' },
  { id: 'm4', title: 'Press access', desc: 'I want press passes to the events I cover, so I have more to film and post.', status: 'queued' },
];
const doneCount = MILESTONES.filter((m) => m.status === 'done').length;

type GoalStatus = 'done' | 'in-progress' | 'queued' | 'next';
type NormalizedStatus = 'done' | 'in-progress' | 'queued';

const normalizeStatus = (status: GoalStatus): NormalizedStatus =>
  status === 'next' ? 'queued' : status;

const formatStatusLabel = (status: GoalStatus): string => {
  const key = normalizeStatus(status);
  if (key === 'done') return 'Done';
  if (key === 'in-progress') return 'In progress';
  return 'Queued';
};

type StageStatus = 'achieved' | 'active' | 'upcoming' | 'target';
interface BrandStage {
  status: StageStatus;
  statusLabel: string;
  name: string;
  detail: string;
}

const BE_STAGES: BrandStage[] = [
  {
    status: 'achieved',
    statusLabel: 'Achieved',
    name: 'Foundation',
    detail: 'Independent editorial calendar and breaking coverage system.',
  },
  {
    status: 'active',
    statusLabel: 'Active',
    name: 'On-Site Access',
    detail: 'Major event press credentials and live floor coverage.',
  },
  {
    status: 'upcoming',
    statusLabel: 'Upcoming',
    name: 'Commercial Integration',
    detail: 'Paid event photography and marketing partnerships.',
  },
  {
    status: 'target',
    statusLabel: 'Target',
    name: 'Industry Milestone',
    detail: 'Critics Choice Association (CCA) accreditation.',
  },
];

const CCC_STAGES: BrandStage[] = [
  {
    status: 'achieved',
    statusLabel: 'Achieved',
    name: 'System Setup',
    detail: 'Native 9:16 capture pipeline and portfolio build.',
  },
  {
    status: 'active',
    statusLabel: 'Active',
    name: 'Local Penetration',
    detail: 'Orange County bars and restaurants.',
  },
  {
    status: 'upcoming',
    statusLabel: 'Upcoming',
    name: 'Digital Products',
    detail: 'Lightroom drink presets and lighting recipe guides.',
  },
  {
    status: 'target',
    statusLabel: 'Target',
    name: 'National Campaigns',
    detail: 'Commercial beverage brand contracts and licensing.',
  },
];
---

<div class="goals-column">
  <header class="goals-head">
    <h2 id="goals-heading" class="goals-heading">Goals</h2>
    <p class="goals-lede">My goals, and where each of my three brands stands. I check things off here as they happen.</p>
  </header>

  <div class="goals-groups">
    {goalsCollection.map((group) => {
      const groupDoneCount = group.data.items.filter((i) => i.status === 'done').length;
      const total = group.data.items.length;
      return (
        <div class="goal-group" id={group.id}>
          <div class="goal-group-head">
            <h3 class="goal-group-title">{group.data.title}</h3>
            <span class="goal-progress font-mono">{groupDoneCount} / {total}</span>
          </div>

          <ul class="checklist-container" role="list">
            {group.data.items.map((item) => {
              const statusKey = normalizeStatus(item.status);
              const statusLabel = formatStatusLabel(item.status);
              return (
                <li class:list={['checklist-card', { completed: item.status === 'done' }]}>
                  <div class="checklist-left">
                    <span
                      class:list={['checklist-mark', `is-${statusKey}`, { 'is-done': item.status === 'done' }]}
                      aria-hidden="true"
                    >
                      {item.status === 'done' && (
                        <svg viewBox="0 0 16 16" width="12" height="12" fill="none">
                          <path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="2" stroke-linecap="square" />
                        </svg>
                      )}
                    </span>
                    <div class="checklist-info">
                      <h4 class="checklist-title">{item.label}</h4>
                      {item.note && <p class="checklist-desc">{item.note}</p>}
                    </div>
                  </div>
                  <span class="status-badge font-mono" data-status={statusKey}>{statusLabel}</span>
                </li>
              );
            })}
          </ul>
        </div>
      );
    })}

    <div class="goal-group" id="core-engine">
      <div class="goal-group-head">
        <h3 class="goal-group-title">Core Engine</h3>
        <span class="goal-progress font-mono">{doneCount} / {MILESTONES.length}</span>
      </div>

      <ul class="checklist-container" role="list">
        {MILESTONES.map((m) => {
          const statusKey = normalizeStatus(m.status);
          const statusLabel = formatStatusLabel(m.status);
          return (
            <li
              class:list={['checklist-card', { completed: m.status === 'done' }]}
              data-milestone-card={m.id}
            >
              <div class="checklist-left">
                <span
                  class:list={['checklist-mark', `is-${statusKey}`, { 'is-done': m.status === 'done' }]}
                  aria-hidden="true"
                >
                  {m.status === 'done' && (
                    <svg viewBox="0 0 16 16" width="12" height="12" fill="none">
                      <path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="2" stroke-linecap="square" />
                    </svg>
                  )}
                </span>
                <div class="checklist-info">
                  <h4 class="checklist-title">{m.title}</h4>
                  <p class="checklist-desc">{m.desc}</p>
                </div>
              </div>
              <span class="status-badge font-mono" data-status={statusKey}>{statusLabel}</span>
            </li>
          );
        })}
      </ul>
    </div>

    <div class="goal-group" id="be">
      <div class="goal-group-head goal-group-head--brand">
        <p class="goal-group-kicker font-mono">BE Unconventional HQ</p>
        <h3 class="goal-group-title">Press Outlet</h3>
      </div>

      <ol class="progression-stages-list" role="list">
        {BE_STAGES.map((stage) => (
          <li class="progression-stage-item" data-stage-status={stage.status}>
            <div class="stage-head">
              <div class:list={['stage-bar', stage.status]} aria-hidden="true"></div>
              <span class:list={['stage-badge', 'font-mono', stage.status]}>{stage.statusLabel}</span>
            </div>
            <div class="stage-body">
              <h4 class="stage-name">{stage.name}</h4>
              <p class="stage-detail">{stage.detail}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>

    <div class="goal-group" id="ccc">
      <div class="goal-group-head goal-group-head--brand">
        <p class="goal-group-kicker font-mono">Capture Create Caffeinate</p>
        <h3 class="goal-group-title">Cocktail Photography</h3>
      </div>

      <ol class="progression-stages-list" role="list">
        {CCC_STAGES.map((stage) => (
          <li class="progression-stage-item" data-stage-status={stage.status}>
            <div class="stage-head">
              <div class:list={['stage-bar', stage.status]} aria-hidden="true"></div>
              <span class:list={['stage-badge', 'font-mono', stage.status]}>{stage.statusLabel}</span>
            </div>
            <div class="stage-body">
              <h4 class="stage-name">{stage.name}</h4>
              <p class="stage-detail">{stage.detail}</p>
            </div>
          </li>
        ))}
      </ol>

      <p class="ccc-page-link">
        <a class="btn btn-ghost" href={CCC_PAGE}>CCC <span aria-hidden="true">&rarr;</span></a>
      </p>
    </div>
  </div>
</div>

<style>
  .goals-column {
    --substack-measure: 700px;
    inline-size: 100%;
    max-inline-size: var(--substack-measure);
    margin-inline: auto;
    min-inline-size: 0;
    border-radius: 0;
    overflow: clip;
  }

  .goals-head {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    margin-block-end: clamp(2rem, 4vw, 2.75rem);
    min-inline-size: 0;
  }

  .goals-heading {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink);
    line-height: 1.12;
    overflow-wrap: break-word;
  }

  .goals-lede {
    margin: 0;
    font-family: var(--font-body);
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--muted);
    max-inline-size: 62ch;
    overflow-wrap: break-word;
  }

  .goals-groups {
    display: flex;
    flex-direction: column;
    gap: clamp(2.25rem, 4vw, 3rem);
    min-inline-size: 0;
  }

  .goal-group {
    padding-block-start: clamp(1.75rem, 3.2vw, 2.25rem);
    border-block-start: 1px solid var(--hairline);
    border-radius: 0;
    min-inline-size: 0;
    scroll-margin-top: calc(var(--nav-bar-h, 76px) + 1.5rem);
  }

  .goal-group:first-child {
    padding-block-start: 0;
    border-block-start: 0;
  }

  .goal-group-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.45rem 1rem;
    margin-block-end: 1.1rem;
    min-inline-size: 0;
  }

  .goal-group-head--brand {
    flex-direction: column;
    align-items: flex-start;
    gap: 0.3rem;
  }

  .goal-group-kicker {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    line-height: 1.3;
  }

  .goal-group-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.1rem, 1.9vw, 1.35rem);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink);
    line-height: 1.22;
    min-inline-size: 0;
    overflow-wrap: break-word;
  }

  .goal-progress {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
  }

  .checklist-container {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    border-block-start: 1px solid var(--hairline);
    border-radius: 0;
  }

  .checklist-card {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem 1.25rem;
    padding-block: 1rem;
    padding-inline: 0;
    border-block-end: 1px solid var(--hairline);
    border-radius: 0;
    min-inline-size: 0;
  }

  .checklist-left {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    flex: 1 1 auto;
    min-inline-size: 0;
  }

  .checklist-mark {
    display: inline-grid;
    place-items: center;
    margin-block-start: 0.22rem;
    inline-size: 1.05rem;
    block-size: 1.05rem;
    flex: 0 0 auto;
    border: 1px solid var(--hairline-strong);
    border-radius: 0;
    color: var(--bg);
    background: transparent;
  }

  .checklist-mark.is-done {
    background: var(--ink);
    border-color: var(--ink);
  }

  .checklist-mark.is-in-progress {
    border-color: var(--ink);
  }

  .checklist-mark.is-in-progress::after {
    content: '';
    inline-size: 5px;
    block-size: 5px;
    background: var(--ink);
    border-radius: 0;
  }

  .checklist-info {
    flex: 1 1 auto;
    min-inline-size: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .checklist-title {
    margin: 0;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 1rem;
    line-height: 1.42;
    color: var(--ink);
    overflow-wrap: break-word;
  }

  .checklist-card.completed .checklist-title {
    color: var(--muted);
  }

  .checklist-desc {
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--muted);
    overflow-wrap: break-word;
  }

  .status-badge {
    flex: 0 0 auto;
    align-self: flex-start;
    margin-block-start: 0.1rem;
    padding-block: 0.22rem;
    padding-inline: 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    line-height: 1.25;
    border: 1px solid var(--border);
    border-radius: 0;
    color: var(--muted);
    background: transparent;
    white-space: nowrap;
  }

  .status-badge[data-status='done'] {
    color: var(--ink);
    border-color: var(--hairline-strong);
    background: var(--surface-2);
  }

  .status-badge[data-status='in-progress'] {
    color: var(--ink);
    border-color: var(--hairline-strong);
    background: var(--surface);
  }

  .progression-stages-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    border-block-start: 1px solid var(--hairline);
    border-radius: 0;
  }

  .progression-stage-item {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding-block: 1rem;
    padding-inline: 0;
    border-block-end: 1px solid var(--hairline);
    border-radius: 0;
    min-inline-size: 0;
  }

  .stage-head {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    min-inline-size: 0;
  }

  .stage-bar {
    flex: 1 1 auto;
    min-inline-size: 0;
    block-size: 3px;
    border-radius: 0;
    background: var(--hairline);
  }

  .stage-bar.achieved {
    background: var(--ink);
  }

  .stage-bar.active {
    background: linear-gradient(
      to right,
      var(--ink) 0%,
      var(--ink) 55%,
      var(--hairline) 55%,
      var(--hairline) 100%
    );
  }

  .stage-bar.upcoming {
    background: var(--hairline-strong);
  }

  .stage-bar.target {
    background: var(--hairline);
  }

  .stage-badge {
    flex: 0 0 auto;
    padding-block: 0.2rem;
    padding-inline: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    line-height: 1.25;
    border: 1px solid var(--border);
    border-radius: 0;
    color: var(--muted);
    background: transparent;
    white-space: nowrap;
  }

  .stage-badge.achieved {
    color: var(--ink);
    border-color: var(--hairline-strong);
    background: var(--surface-2);
  }

  .stage-badge.active {
    color: var(--ink);
    border-color: var(--hairline-strong);
    background: var(--surface);
  }

  .stage-body {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-inline-size: 0;
  }

  .stage-name {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.98rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink);
    line-height: 1.3;
    overflow-wrap: break-word;
  }

  .stage-detail {
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--muted);
    overflow-wrap: break-word;
  }

  .ccc-page-link {
    margin-block: 1.15rem 0;
    margin-inline: 0;
    display: flex;
    flex-wrap: wrap;
  }

  .ccc-page-link :global(.btn) {
    border-radius: 0;
  }

  @media (max-width: 540px) {
    .checklist-card {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.55rem;
    }

    .status-badge {
      margin-block-start: 0;
      margin-inline-start: calc(1.05rem + 0.85rem);
    }
  }
</style>
