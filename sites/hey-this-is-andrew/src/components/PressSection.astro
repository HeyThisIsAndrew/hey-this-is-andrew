---
import SectionHeader from '@andrew/ui/SectionHeader.astro';
import pressData from '../data/press.json';

const CONTACT_EMAIL = pressData.email;
const rawBase = import.meta.env.BASE_URL;
const base = rawBase === '/' ? '' : rawBase.replace(/\/$/, '');
const STATS = pressData.stats;
const ASSETS = pressData.assets.map(a => ({...a, href: `${base}${a.href}`}));
---
  <section id="press" class="press-section" aria-labelledby="press-heading">
    <div class="container">
      <SectionHeader
        id="press-heading"
        index="04"
        kicker="Press & partnerships"
        title="Press kit"
        lede="Everything a brand or outlet needs to feature Andrew. For anything else, reach out directly."
      />

      <div class="press-grid">
        <div class="press-bio reveal">
          <h2 class="press-subhead">Bio</h2>
          {pressData.bio.map(pText => (
            <p set:html={pText.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')} />
          ))}
        </div>

        <div class="press-stats reveal" style="--rd: 80ms">
          <h2 class="press-subhead">Audience</h2>
          <dl class="stats-list">
            {STATS.map((s) => (
              <div class="stat-row">
                <dt class="stat-value">
                  {s.value ?? (<><span class="stat-pending" aria-hidden="true"></span><span class="vh">Not yet confirmed</span></>)}
                </dt>
                <dd class="stat-label">{s.label}</dd>
                <dd class="stat-note">{s.note}</dd>
              </div>
            ))}
          </dl>
          <p class="stats-footnote">
            Numbers are updated as they are confirmed. No estimates published here.
          </p>
        </div>
      </div>

      <div class="press-assets reveal" style="--rd: 120ms">
        <h2 class="press-subhead">Brand assets</h2>
        <ul class="asset-list">
          {ASSETS.map((a) => (
            <li class="asset-item">
              <div class="asset-copy">
                <h3 class="asset-name">{a.name}</h3>
                <p class="asset-desc">{a.desc}</p>
              </div>
              <a class="btn btn-ghost asset-btn" href={a.href} download={a.filename}>
                Download
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                  <path d="M7 1v9m0 0L3 6m4 4l4-4M1 13h12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </li>
          ))}
        </ul>
        <p class="assets-footnote">
          High resolution versions, product shots, and additional formats are available on request.
        </p>
      </div>

      <div class="press-partners reveal" style="--rd: 160ms">
        <h2 class="press-subhead">Past partnerships</h2>
        <p class="empty-state">
          No brand partnerships to list yet. The first ones will be documented
          here, the same way everything else on this site is documented.
        </p>
      </div>

      <div class="press-contact reveal" style="--rd: 200ms">
        <h2 class="press-subhead">Press contact</h2>
        <p class="contact-copy">
          For screeners, review copies, event credentials, partnerships, and
          media inquiries, email works best.
        </p>
        <a class="btn btn-primary" href={'mailto:' + CONTACT_EMAIL + '?subject=' + encodeURIComponent('Press inquiry')}>
          {CONTACT_EMAIL}
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M2 12L12 2M12 2H5M12 2v7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

<style>
  .press-section {
    padding: clamp(2rem, 5vw, 4rem) 0 clamp(4rem, 8vw, 7rem);
  }
  .press-grid {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    margin-top: clamp(2rem, 5vw, 3.5rem);
  }
  @media (min-width: 900px) {
    .press-grid { grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); }
  }
  .press-subhead {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.05rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin: 0 0 1.25rem;
  }
  .press-bio p {
    color: rgba(245, 245, 245, 0.78);
    font-size: 1rem;
    line-height: 1.75;
    margin: 0 0 1.25rem;
    max-width: 58ch;
  }
  .press-bio p strong { color: var(--ink); }
  .stats-list {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .stat-row {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    gap: 0.25rem 1rem;
    align-items: baseline;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--line);
  }
  .stat-value {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.75rem;
    color: var(--ink);
    margin: 0;
    line-height: 1;
  }
  .stat-pending {
    display: inline-block;
    width: 1.5rem;
    height: 2px;
    background: var(--muted);
    vertical-align: middle;
  }
  .stat-label {
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink);
    margin: 0;
    grid-column: 2;
  }
  .stat-note {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    color: var(--muted);
    margin: 0;
    grid-column: 2;
  }
  .stats-footnote {
    margin: 1rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .press-assets,
  .press-partners,
  .press-contact {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--line);
  }
  .asset-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .asset-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--line);
  }
  .asset-name {
    margin: 0 0 0.35rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1rem;
  }
  .asset-desc {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.6;
  }
  .asset-btn {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }
  .assets-footnote {
    margin: 1rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .empty-state {
    border: 1px solid var(--line);
    background: var(--surface);
    padding: clamp(1.5rem, 4vw, 2.5rem);
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.7;
    max-width: 62ch;
    margin: 0;
  }
  .contact-copy {
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.7;
    margin: 0 0 1.5rem;
    max-width: 52ch;
  }
  .press-contact .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    word-break: break-all;
  }
</style>
