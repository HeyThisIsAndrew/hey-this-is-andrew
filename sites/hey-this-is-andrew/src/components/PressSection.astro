---
import SectionHeader from '@andrew/ui/SectionHeader.astro';
import pressData from '../data/press.json';

import { CONTACT } from '../data/contact';
import { WORK_WITH_ME_HREF } from '../data/nav';
import { getSocialLatest } from '../lib/social-latest';
const CONTACT_EMAIL = CONTACT.press;
const rawBase = import.meta.env.BASE_URL;
const base = rawBase === '/' ? '' : rawBase.replace(/\/$/, '');
const socialTotals = getSocialLatest().totals;
const formatCount = (n: number) => new Intl.NumberFormat('en-US').format(n);
const LIVE_STAT_VALUES: Record<string, string | undefined> = {
  YouTube: typeof socialTotals.youtube?.subscribers === 'number' ? formatCount(socialTotals.youtube.subscribers) : undefined,
  Instagram: typeof socialTotals.instagram?.followers === 'number' ? formatCount(socialTotals.instagram.followers) : undefined,
};
const STATS = pressData.stats.map((s) => ({
  ...s,
  value: LIVE_STAT_VALUES[s.label] ?? s.value,
}));
const ASSETS = pressData.assets.map(a => ({...a, href: `${base}${a.href}`}));
const PRIMARY_ASSET = ASSETS[0];
// Keep the Past partnerships block hidden until confirmed brand partnerships are added.
const PARTNERSHIPS: Array<{ name: string; note?: string; href?: string }> = [];
---
  <section id="press" class="press-section" aria-labelledby="press-heading">
    <div class="container">
      <SectionHeader variant="chip"
        id="press-heading"
        title="Press kit"
      />

      <div class="press-stats reveal" style="--rd: 80ms">
        <dl class="stats-list">
          {/* Only confirmed numbers are listed; a row with no value yet
              (Newsletter, Monthly reach) stays out until it has one. */}
          {STATS.filter((s) => s.value).map((s) => (
            <div class="stat-row">
              <dt class="stat-value">
                {s.value ?? (<><span class="stat-pending" aria-hidden="true"></span><span class="vh">Not yet confirmed</span></>)}
              </dt>
              <dd class="stat-label">{s.label}</dd>
              <dd class="stat-note">{s.note}</dd>
            </div>
          ))}
        </dl>
        <p class="stats-footnote">
          Numbers are updated as they are confirmed. No estimates published here.
        </p>
      </div>

      {PARTNERSHIPS.length > 0 && (
        <div class="press-partners reveal" style="--rd: 120ms">
          <ul class="stats-list">
            {PARTNERSHIPS.map((partner) => (
              <li class="stat-row">
                <span class="stat-label">{partner.name}</span>
                {partner.note && <span class="stat-note">{partner.note}</span>}
              </li>
            ))}
          </ul>
        </div>
      )}

      <div class="press-contact reveal" id="contact" style="--rd: 140ms">
        <p class="contact-copy">
          For brand partnerships, UGC, photography, or video, start with Work with me. For screeners, review copies, and event credentials, reach out through the press contact. Brand assets are below.
        </p>
        <div class="btn-group press-contact-actions">
          <a
            class="btn btn-primary"
            href={'mailto:' + CONTACT_EMAIL + '?subject=' + encodeURIComponent('Press inquiry')}
            title={CONTACT_EMAIL}
          >
            Press contact
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M2 12L12 2M12 2H5M12 2v7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
          {PRIMARY_ASSET && (
            <a class="btn btn-secondary" href={PRIMARY_ASSET.href} download={PRIMARY_ASSET.filename}>
              Brand assets
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M7 1v9m0 0L3 6m4 4l4-4M1 13h12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          )}
          <a class="btn btn-secondary" href={WORK_WITH_ME_HREF}>
            Work with me
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M2 12L12 2M12 2H5M12 2v7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
        <p class="assets-footnote">
          {CONTACT_EMAIL} · High resolution versions, product shots, and additional formats are available on request.
        </p>
      </div>
    </div>
  </section>

<style>
  .press-section {
    padding: clamp(2.25rem, 4.5vw, 4rem) 0 clamp(4rem, 7vw, 6.5rem);
  }
  .press-stats {
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
  }
  .stats-list {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  @media (min-width: 720px) {
    .stats-list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: clamp(2rem, 4vw, 3.5rem);
    }
  }
  .stat-row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.25rem 1.25rem;
    align-items: baseline;
    padding: 1.15rem 0;
    border-bottom: 1px solid var(--line);
  }
  .stat-value {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.65rem, 1.4rem + 0.5vw, 2.25rem);
    color: var(--ink);
    margin: 0;
    line-height: 1;
    min-width: 4.5rem;
  }
  .stat-pending {
    display: inline-block;
    width: 1.5rem;
    height: 2px;
    background: var(--muted);
    vertical-align: middle;
  }
  .stat-label {
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink);
    margin: 0;
    grid-column: 2;
  }
  .stat-note {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.1em;
    color: var(--muted);
    margin: 0;
    grid-column: 2;
  }
  .stats-footnote {
    margin: 1rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .press-partners,
  .press-contact {
    margin-top: clamp(2.25rem, 4vw, 3.25rem);
    padding-top: clamp(1.75rem, 3.5vw, 2.75rem);
    border-top: 1px solid var(--line);
  }
  .assets-footnote {
    margin: 1rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    overflow-wrap: anywhere;
  }
  .contact-copy {
    color: var(--muted);
    font-size: clamp(0.95rem, 0.9rem + 0.18vw, 1.1rem);
    line-height: 1.7;
    text-wrap: pretty;
    margin: 0 0 1.5rem;
    max-width: 62ch;
  }
  :global(#site) .press-contact .press-contact-actions {
    margin-inline: 0;
    justify-content: start;
    gap: 0.75rem;
  }
  .press-contact-actions .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    width: 100%;
    border-radius: 0;
    white-space: nowrap;
    transition: background-color 180ms ease-in-out, color 180ms ease-in-out, border-color 180ms ease-in-out;
  }
  @media (min-width: 2560px) {
    :global(#site) .press-contact .press-contact-actions .btn {
      min-height: 52px;
      padding: 0.85rem 1.65rem;
      font-size: 15px;
    }
  }
  @media (max-width: 640px) {
    .press-contact {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
    :global(#site) .press-contact .press-contact-actions {
      grid-auto-flow: row;
      width: 100%;
      justify-content: stretch;
    }
    .press-contact-actions .btn {
      white-space: normal;
    }
  }
</style>
