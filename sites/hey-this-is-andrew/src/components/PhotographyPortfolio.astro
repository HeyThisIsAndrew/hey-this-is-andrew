import drinksLineup from '../assets/ccc/s05-work-drinks-2-lineup.jpg';
import drinksMood from '../assets/ccc/s05-work-drinks-3-mood.jpg';
import night1 from '../assets/ccc/s06-work-night-1.jpg';
import night2 from '../assets/ccc/s06-work-night-2.jpg';
import night3 from '../assets/ccc/s06-work-night-3-beer.jpg';
import night4 from '../assets/ccc/s06-work-night-4.jpg';
import nightWide from '../assets/ccc/s06-work-night-wide.jpg';
import room from '../assets/ccc/s07-work-room.jpg';
import detail from '../assets/ccc/s07-work-detail.jpg';
import desertOpening from '../assets/ccc/s08-video-desert-1-opening.jpg';
import desertMarquee from '../assets/ccc/s08-video-desert-2-marquee.jpg';
import desertDj from '../assets/ccc/s08-video-desert-3-dj.jpg';
import realPool from '../assets/ccc/s09-video-real-1-pool.jpg';
import realDj from '../assets/ccc/s09-video-real-2-dj.jpg';
import realMarios from '../assets/ccc/s09-video-real-3-marios.jpg';
import crew from '../assets/ccc/s10-how-crew.jpg';
import cocktails from '../assets/ccc/s11-how-easy-cocktails.jpg';
import coupe from '../assets/ccc/s12-pricing-coupe.jpg';
import coupeWhy from '../assets/ccc/s02-why-1-coupe.jpg';
import shelvesWhy from '../assets/ccc/s03-why-2-bar-shelves.jpg';

const instagramPhotos = await getInstagramPhotos(32);
const categoryLabels: Record<'cocktails' | 'bar' | 'product', string> = {
  cocktails: 'Cocktails',
  bar: 'Bars',
  product: 'Product',
};

const rawDisplayPhotos = instagramPhotos.map((p) => ({
  id: p.id,
  image: p.image,
  caption: p.caption,
  category: p.category,
  location: p.location || (p.category === 'bar' ? 'Bar & Venue' : categoryLabels[p.category]),
  venue: p.venue,
  event: p.event,
  permalink: p.permalink,
  duration: (p as any).duration,
  // A reel the sync found removed from Instagram stays on the wall as a
  // photo (it is still the work) unless its file was saved: no dead embed.
  video: p.mediaType === 'VIDEO' && Boolean(p.permalink) && (!p.removed || Boolean(p.videoSrc)),
  videoSrc: p.videoSrc,
}));

const seenIds = new Set<string>();
const seenUrls = new Set<string>();
const seenCaps = new Set<string>();
const displayPhotos = [];

for (const p of rawDisplayPhotos) {
  if (seenIds.has(p.id) || seenUrls.has(p.image.src)) continue;
  if (p.caption && p.caption !== 'Capture Create Caffeinate' && seenCaps.has(p.caption)) continue;
  seenIds.add(p.id);
  seenUrls.add(p.image.src);
  if (p.caption) seenCaps.add(p.caption);
  displayPhotos.push(p);
}

// Resilient self-hosted portfolio photos for when Instagram sync files are unavailable
