---
import { Image } from 'astro:assets';
import ExpandSection from '@andrew/ui/ExpandSection.astro';
import portraitImg from '../assets/hero-media/portrait.jpg';
import { SUBSTACK_URL } from '../lib/latest-content';
import { NOW_MONTH, NOW_ITEMS } from '../data/now';

interface Props {
  /** Full version (About page): the longer telling, Substack kicker link. */
  full?: boolean;
}
const { full = false } = Astro.props;
const rawBase = import.meta.env.BASE_URL;
const base = rawBase === '/' ? '' : rawBase.replace(/\/$/, '');
---
<section id="about" aria-labelledby="about-heading" class="about-section">
  <div class="container">
    <!-- BE-style section bar: icon + title + categories + rule, one line.
         No link here: "More about me" below is the one read-more. -->
    <div class="about-bar">
      <span class="about-bar-icon" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="3"></circle>
          <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
        </svg>
      </span>
      <h2 class="about-bar-title" id="about-heading">{full ? 'About Andrew' : 'Meet The Creator'}</h2>
      <span class="about-bar-cats font-mono">Creator | Photographer | Coffee drinker</span>
      <span class="about-bar-rule" aria-hidden="true"></span>
    </div>

    <div class="about-grid">
      <figure class="about-portrait">
        <span class="tape" aria-hidden="true"></span>
        <span class="headshot-crop">
          <Image src={portraitImg} alt="" widths={[400, 600, 800, 1200, 1600]} sizes="(max-width: 767px) 60vw, (min-width: 1920px) 27rem, 320px" format="webp" loading="lazy" decoding="async" class="headshot-img" />
        </span>
        <figcaption>
          <strong>Andrew Baxter</strong>
          <span>Creator &amp; photographer</span>
        </figcaption>
      </figure>

      <div class="about-copy">
        <h3 class="display about-headline">WHERE THE MESSY MIDDLE<br />GETS BUILT IN PUBLIC</h3>
        {full ? (
          /* The fuller telling (About page): the approved copy, with the
             YouTube channel's own description of the work folded in. */
          <>
            <p class="about-body">If you want to build something real, you have to show the work. Hey This Is Andrew is an independent hub for the creative process, where building three brands, commercial beverage photography, and creative automation happen out in the open. No shortcuts, no artificial templates: just honest documentation of the messy middle.</p>
            <p class="about-body">Documenting the messy reality of building a brand means pushing past perfectionism, learning new technical workflows (Sony Alpha, DaVinci Resolve, AI tools), and building a creative ecosystem in public. No hyper-polished fake expertise, just raw behind-the-scenes progress, figured out along the way.</p>
            <p class="about-body">Founded and documented by Andrew Baxter. More than a decade across technology, creative production, and hospitality photography gives him a grounded, working knowledge of how ideas are actually built, tested, and shipped.</p>
          </>
        ) : (
          /* The homepage preview: short, so "More about me" earns the
             click. Drawn from Andrew's Instagram and YouTube bios and the
             approved About copy (draft, 2026-10-04; Andrew to revise). */
          <p class="about-body">I'm building three brands and the creative automation behind them, out in the open. No polished fake expertise, just the messy, behind-the-scenes progress of pushing past perfectionism and figuring it out as I go.</p>
        )}
        <p class="about-punchline">BUILDING IN PUBLIC.</p>
        {!full && (
          /* The Now band, folded in as one line (full list at /now). */
          <div class="about-now">
            <h3 class="about-now-label font-mono">Now <span class="about-now-month">{NOW_MONTH}</span></h3>
            <span class="about-now-items">
              {NOW_ITEMS.slice(0, 2).map((n, i) => (
                <span class="about-now-item"><span class="about-now-key">{n.label}:</span> <span class="about-now-val">{n.value.replace(/\.$/, '')}</span> <span class="about-now-sep" aria-hidden="true"> / </span></span>
              ))}
            </span>
            <ExpandSection id="now" expandLabel="Show more" collapseLabel="Show less">
              <span class="about-now-items">
                {NOW_ITEMS.slice(2).map((n, i) => (
                  <span class="about-now-item"><span class="about-now-key">{n.label}:</span> <span class="about-now-val">{n.value.replace(/\.$/, '')}</span>{i < NOW_ITEMS.length - 3 && <span class="about-now-sep" aria-hidden="true"> / </span>}</span>
                ))}
              </span>
            </ExpandSection>
          </div>
        )}

        <div class="about-ctas">
          {full ? (
            <>
              <a class="btn btn-primary" href={SUBSTACK_URL} target="_blank" rel="noopener">
                Read the Substack
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                  <path d="M2 12L12 2M12 2H5M12 2v7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
              <a class="btn btn-ghost" href="#writing">Latest articles</a>
            </>
          ) : (
            <>
              
              {/* One primary next step (More about me); the Substack is the
                  quieter, external one. */}
              <a class="btn btn-ghost" href={SUBSTACK_URL} target="_blank" rel="noopener">
                Read the Substack
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                  <path d="M2 12L12 2M12 2H5M12 2v7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </>
          )}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Spacing and type scale: BE Unconventional HQ's "Inside the HQ"
     (home.css .ihq-*, .hsh-*), measured at 1512 and 390. HQ's root is
     12.8px from 768 up and this site's is not (16px to 1099, 12px to 1919,
     then scaled with the window), so from 768 up the values are HQ's own
     pixels times --u: 1px, growing above 1920 as the rest of this site does.
     Below 768 both roots are 16px and HQ's rem values carry over as they are.
     Monochrome: no HQ red. */
  .about-section {
    --u: 1px;
    /* The site's one section rhythm (--space-section), like every other
       section: HQ's 96 to 128px left the lower half of this section empty
       on a laptop (Andrew, 2026-10-02). */
    --about-gap: var(--space-section);
    padding: var(--about-gap) 0;
    border-top: 1px solid var(--line);
    position: relative;
    z-index: 2;
    clear: both;
  }

  /* BE-style section bar: icon, title, categories, rule.
     Single horizontal line, HQ's "INSIDE THE HQ" pattern in monochrome.
     HEY_THISISANDREW wordmark (Syne 800) is the logo. */
  @media (min-width: 768px) {
    .about-section { --about-gap: var(--space-section); }
  }
  @media (min-width: 1920px) {
    .about-section { --u: calc(100vw / 1512); }
  }
  .about-bar {
    display: flex;
    align-items: center;
    column-gap: calc(11.52 * var(--u));
    row-gap: calc(5.12 * var(--u));
    margin-bottom: clamp(calc(19.2 * var(--u)), 3vw, calc(32 * var(--u)));
    flex-wrap: wrap;
  }
  .about-logo {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.05rem;
    letter-spacing: 0.02em;
    color: var(--ink);
    white-space: nowrap;
  }
  .about-bar-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(calc(16.64 * var(--u)), 2.1vw, calc(23.68 * var(--u)));
    line-height: 1;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink);
    margin: 0;
    white-space: nowrap;
  }
  .about-bar-cats {
    font-family: var(--font-mono);
    font-size: calc(8.96 * var(--u));
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
  }
  .about-bar-rule {
    flex: 1 1 2rem;
    height: 1px;
    background: var(--border);
    min-width: 2rem;
  }
  /* Phones, as HQ: icon and title on the first row, the categories on the
     second, no rule. */
  @media (max-width: 767px) {
    .about-bar {
      margin-bottom: 24px;
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      grid-template-areas:
        'icon title'
        'cats cats';
      column-gap: 0.7rem;
      row-gap: 0.55rem;
    }
    .about-bar-icon { grid-area: icon; }
    /* HQ's 1.15rem, held to the row on a 375 phone ("Meet The Creator" is
       longer than "Inside the HQ"), and free to wrap if it ever must. */
    .about-bar-title { grid-area: title; font-size: min(1.15rem, 4.4vw); letter-spacing: 0.06em; white-space: normal; }
    .about-bar-cats { grid-area: cats; font-size: 0.62rem; letter-spacing: 0.18em; white-space: normal; }
    .about-bar-rule { display: none; }
  }

  .about-bar-icon {
    display: flex;
    align-items: center;
    color: var(--ink);
  }
  .about-bar-icon svg {
    width: calc(30 * var(--u));
    height: calc(30 * var(--u));
  }

  /* The portrait and the copy, side by side from 768 up. */
  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, calc(320 * var(--u))) minmax(0, 1fr);
    gap: clamp(calc(25.6 * var(--u)), 5vw, calc(64 * var(--u)));
    align-items: center;
  }
  @media (max-width: 767px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 2.25rem;
    }
    /* .about-grid prefix: the base .about-portrait rule further down sets
       width: 100% and used to win, so the phone size never applied. */
    .about-grid .about-portrait {
      width: min(60vw, 260px);
      max-width: none;
      margin-left: auto;
      margin-right: auto;
      justify-self: center;
      transform: none;
    }
    .about-portrait figcaption { text-align: center; }
    .about-grid .about-portrait figcaption strong { font-size: 1rem; }
    .about-grid .about-portrait figcaption span { font-size: 0.7rem; }
  }

  /* Taped portrait frame, HQ style: vertical portrait format.
     Shows Andrew's head, shoulders, and hands in perspective with dramatic
     cinematic lighting — authentic composition matching BE HQ. */
  .about-portrait {
    position: relative;
    margin: 0;
    max-width: calc(320 * var(--u));
    width: 100%;
    transform: rotate(-2deg);
    border: 1px solid rgba(255, 255, 255, 0.25);
    background: #0b0b0b;
    padding: 0.65rem 0.65rem 0;
  }
  .headshot-crop {
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    background: #060606;
    position: relative;
  }
  .headshot-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
    filter: grayscale(0.12) contrast(1.05);
  }
  .tape {
    position: absolute;
    top: -0.85rem;
    left: 8%;
    width: 5.5rem;
    height: 1.7rem;
    background: rgba(205, 205, 205, 0.3);
    border-left: 1px dashed rgba(255,255,255,0.25);
    border-right: 1px dashed rgba(255,255,255,0.25);
    transform: rotate(-6deg);
    z-index: 2;
  }
  .about-portrait figcaption {
    padding: calc(12.8 * var(--u)) 0.4rem 1rem;
  }
  .about-portrait figcaption strong {
    display: block;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: calc(12.8 * var(--u));
    line-height: 1.1;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .about-portrait figcaption span {
    display: block;
    margin-top: calc(3.2 * var(--u));
    font-size: calc(8.96 * var(--u));
    line-height: 1.2;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .about-headline {
    font-size: clamp(calc(21.76 * var(--u)), 2.6vw, calc(40.96 * var(--u)));
    font-weight: 800;
    line-height: 1.04;
    letter-spacing: normal;
    text-transform: uppercase;
    color: var(--ink);
    margin: 0;
    max-width: 24ch;
    text-wrap: balance;
  }
  /* Body: HQ's .ihq-body. Scales with the window like the headline does
     (16px at 1512, 16.8px on a phone), in a 78ch column. */
  .about-body {
    margin: calc(17.92 * var(--u)) 0 0;
    max-width: 78ch;
    font-size: max(calc(13.44 * var(--u)), min(1.05vw, calc(19 * var(--u))));
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.68);
  }
  /* The tagline: HQ's motto, set the same size and weight, in white. It had
     been losing to the body paragraph rule and rendering as body text. */
  .about-punchline {
    display: flex;
    flex-wrap: wrap;
    column-gap: calc(14.08 * var(--u));
    row-gap: calc(2.56 * var(--u));
    margin: calc(25.6 * var(--u)) 0 0;
    font-family: var(--font-display);
    font-size: clamp(calc(12.8 * var(--u)), 1.6vw, calc(19.2 * var(--u)));
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink);
  }
  /* Phones: HQ's rem values, both roots being 16px here. */
  @media (max-width: 767px) {
    .about-headline { font-size: clamp(1.6rem, 7.5vw, 2.2rem); }
    .about-body { margin-top: 1.4rem; font-size: 1.05rem; }
    .about-punchline { margin-top: 2rem; font-size: 1rem; }
    .about-portrait figcaption { padding-top: 1rem; }
    .about-portrait figcaption span { margin-top: 0.25rem; }
  }
  /* Now line (the former Now band, folded into Meet the Creator). */
  .about-now {
    margin: 2rem 0 0;
    padding: 0.9rem 0 0;
    border-top: 1px solid var(--line);
    font-size: 0.85rem;
    line-height: 1.7;
    color: var(--muted);
  }
  .about-now-label {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: var(--tap-min);
    margin-right: 0.75rem;
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
  }
  .about-now-label:hover,
  .about-now-label:focus-visible {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .about-now-month {
    color: var(--muted);
  }
  .about-now-key {
    color: var(--ink);
  }
  .about-now-sep {
    color: var(--line);
  }
  /* Phones: one item per row, label and value on the same row, hairlines
     between, no slashes (inline, the five items wrapped into a ragged
     block). Desktop stays inline. */
  @media (max-width: 767px) {
    .about-now-items {
      display: block;
      margin-top: 0.35rem;
    }
    .about-now-item {
      display: flex;
      align-items: baseline;
      gap: 0.75rem;
      padding: 0.6rem 0;
      border-top: 1px solid var(--line);
    }
    .about-now-item:first-child {
      border-top: 0;
    }
    .about-now-key {
      flex: none;
      min-width: 8.5rem;
    }
    .about-now-val {
      min-width: 0;
    }
    .about-now-sep {
      display: none;
    }
  }
  .about-ctas {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 2rem;
  }

  @media (max-width: 640px) {
    .about-kicker-tags { display: none; }
    .about-kicker-title { font-size: 0.95rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .about-kicker-link { transition: none; }
  }
</style>

<style>
  .about-now-full {
    margin-top: 1.5rem;
  }
</style>
