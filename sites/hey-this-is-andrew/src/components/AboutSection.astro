---
import { Image } from 'astro:assets';
import portraitImg from '../assets/hero-media/portrait.jpg';
import { SUBSTACK_URL } from '../lib/latest-content';
import { NOW_MONTH, NOW_ITEMS } from '../data/now';

interface Props {
  /** Full version (About page): the longer telling, Substack kicker link. */
  full?: boolean;
}
const { full = false } = Astro.props;

/* Andrew's own words (2026-10-29), word for word: change them only with
   him. The About page tells it in full; the homepage shows an open editorial
   dossier (What I'm building, How I work, Now), so the two never disagree. */
const STORY = {
  building: "Hey, I'm building three brands: my personal brand, a small press outlet called BE Unconventional HQ, and Capture Create Caffeinate, photo and video for bars, restaurants, and events. My goal is to turn my passions into my career, and I want to do it in public. This is the site where you can follow my journey and see the messy reality of trying to become a full-time content creator.",
  how: [
    "My workflow uses professional cameras and lighting equipment: Sony Alpha, DaVinci Resolve, Lightroom, and Photoshop. I use AI tools to teach me how to master them, not to create content for me, but to help me grow as a creator and push past my own limitations. AI is how I learn faster. Before AI, I was a jack of all trades, master of none. Now I'm a jack of all trades, and I can do anything.",
  ],
};
---
<section id="about" aria-labelledby="about-heading" class="section-hairline about-section">
  <div class="container">
    <!-- BE-style section bar: icon + title + categories + rule, one line.
         No link here: Read the Substack below is the primary CTA. -->
    <div class="about-bar">
      <span class="about-bar-icon" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="3"></circle>
          <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
        </svg>
      </span>
      <h2 class="about-bar-title" id="about-heading">{full ? 'About Andrew' : 'Meet The Creator'}</h2>
      <span class="about-bar-cats font-mono">Creator | Photographer | Coffee drinker</span>
      <span class="about-bar-rule" aria-hidden="true"></span>
    </div>

    <div class="about-grid">
      <figure class="about-portrait">
        <span class="tape" aria-hidden="true"></span>
        <span class="headshot-crop">
          <Image src={portraitImg} alt="Andrew Baxter" widths={[400, 600, 800, 1200, 1600]} sizes="(max-width: 767px) 60vw, (min-width: 1920px) 27rem, 320px" format="webp" loading="lazy" decoding="async" class="headshot-img" />
        </span>
        <figcaption>
          <strong>Andrew Baxter</strong>
          <span>Creator &amp; photographer</span>
        </figcaption>
      </figure>

      <div class="about-copy">
        <h3 class="display about-headline">The reality of it all.</h3>
        {full && (
          <>
            <p class="about-body">{STORY.building}</p>
            {STORY.how.map((para) => <p class="about-body">{para}</p>)}
          </>
        )}
        <p class="about-punchline">BUILDING IN PUBLIC.</p>
        {!full && (
          <div class="about-panels">
            <div class="about-dossier-grid">
              <article class="about-dossier-col" id="about-building">
                <p class="about-dossier-kicker font-mono">What I'm building</p>
                <p class="about-body">{STORY.building}</p>
              </article>
              <article class="about-dossier-col" id="about-how">
                <p class="about-dossier-kicker font-mono">How I work</p>
                {STORY.how.map((para) => <p class="about-body">{para}</p>)}
              </article>
            </div>
            <div class="about-now-ledger" id="now">
              <p class="about-dossier-kicker font-mono">Now &middot; {NOW_MONTH}</p>
              <ul class="about-now-list">
                {NOW_ITEMS.map((n) => (
                  <li class="about-now-item">
                    <span class="about-now-key">{n.label}</span>
                    <span class="about-now-val">{n.value.replace(/\.$/, '')}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        )}

        <div class:list={['about-ctas', { 'btn-group': full }]}>
          {full ? (
            <>
              <a class="btn btn-primary" href={SUBSTACK_URL} target="_blank" rel="noopener">
                Read the Substack
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                  <path d="M2 12L12 2M12 2H5M12 2v7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
              <a class="btn btn-ghost" href="#writing">Latest articles</a>
            </>
          ) : (
            <a class="btn btn-primary" href={SUBSTACK_URL} target="_blank" rel="noopener">
              Read the Substack
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M2 12L12 2M12 2H5M12 2v7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          )}
        </div>
      </div>
    </div>

    {!full && (
      <p class="section-handoff font-mono">
        <a href="#photos">Next: Shot on the job <span aria-hidden="true">&darr;</span></a>
      </p>
    )}
  </div>
</section>

<style>
  /* Spacing and type scale: BE Unconventional HQ's "Inside the HQ"
     (home.css .ihq-*, .hsh-*), measured at 1512 and 390. */
  .about-section {
    --u: 1px;
    position: relative;
    z-index: 2;
    clear: both;
  }

  @media (min-width: 1920px) {
    .about-section { --u: calc(100vw / 1512); }
  }
  .about-bar {
    display: flex;
    align-items: center;
    column-gap: calc(11.52 * var(--u));
    row-gap: calc(5.12 * var(--u));
    margin-bottom: clamp(calc(19.2 * var(--u)), 3vw, calc(32 * var(--u)));
    flex-wrap: wrap;
  }
  .about-bar-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(calc(16.64 * var(--u)), 2.1vw, calc(23.68 * var(--u)));
    line-height: 1;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink);
    margin: 0;
    white-space: nowrap;
  }
  .about-bar-cats {
    font-family: var(--font-mono);
    font-size: calc(8.96 * var(--u));
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
  }
  .about-bar-rule {
    flex: 1 1 2rem;
    height: 1px;
    background: var(--border);
    min-width: 2rem;
  }
  @media (max-width: 767px) {
    .about-bar {
      margin-bottom: 24px;
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      grid-template-areas:
        'icon title'
        'cats cats';
      column-gap: 0.7rem;
      row-gap: 0.55rem;
    }
    .about-bar-icon { grid-area: icon; }
    .about-bar-title { grid-area: title; font-size: min(1.15rem, 4.4vw); letter-spacing: 0.06em; white-space: normal; }
    .about-bar-cats { grid-area: cats; font-size: 0.62rem; letter-spacing: 0.18em; white-space: normal; }
    .about-bar-rule { display: none; }
  }

  .about-bar-icon {
    display: flex;
    align-items: center;
    color: var(--ink);
  }
  .about-bar-icon svg {
    width: calc(30 * var(--u));
    height: calc(30 * var(--u));
  }

  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, calc(320 * var(--u))) minmax(0, 1fr);
    gap: clamp(calc(25.6 * var(--u)), 5vw, calc(64 * var(--u)));
    align-items: start;
  }
  @media (max-width: 767px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 2.25rem;
    }
    .about-grid .about-portrait {
      width: min(60vw, 260px);
      max-width: none;
      margin-left: auto;
      margin-right: auto;
      justify-self: center;
      transform: none;
    }
    .about-portrait figcaption { text-align: center; }
    .about-grid .about-portrait figcaption strong { font-size: 1rem; }
    .about-grid .about-portrait figcaption span { font-size: 0.7rem; }
  }

  /* Taped portrait frame, HQ style: vertical portrait format. */
  .about-portrait {
    position: relative;
    margin: 0.5rem 0 0;
    max-width: calc(320 * var(--u));
    width: 100%;
    transform: rotate(-2deg);
    border: 1px solid rgba(255, 255, 255, 0.25);
    background: #0b0b0b;
    padding: 0.65rem 0.65rem 0;
  }
  .headshot-crop {
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    background: #060606;
    position: relative;
  }
  .headshot-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
    filter: grayscale(0.12) contrast(1.05);
  }
  .tape {
    position: absolute;
    top: -0.85rem;
    left: 8%;
    width: 5.5rem;
    height: 1.7rem;
    background: rgba(205, 205, 205, 0.3);
    border-left: 1px dashed rgba(255,255,255,0.25);
    border-right: 1px dashed rgba(255,255,255,0.25);
    transform: rotate(-6deg);
    z-index: 2;
  }
  .about-portrait figcaption {
    padding: calc(12.8 * var(--u)) 0.4rem 1rem;
  }
  .about-portrait figcaption strong {
    display: block;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: calc(12.8 * var(--u));
    line-height: 1.1;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .about-portrait figcaption span {
    display: block;
    margin-top: calc(3.2 * var(--u));
    font-size: calc(8.96 * var(--u));
    line-height: 1.2;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .about-copy {
    min-width: 0;
  }
  .about-headline {
    font-size: clamp(calc(21.76 * var(--u)), 2.6vw, calc(40.96 * var(--u)));
    font-weight: 800;
    line-height: 1.04;
    letter-spacing: normal;
    text-transform: uppercase;
    color: var(--ink);
    margin: 0;
    max-width: 24ch;
    text-wrap: balance;
  }
  .about-body {
    margin: calc(17.92 * var(--u)) 0 0;
    max-width: 78ch;
    font-size: max(calc(13.44 * var(--u)), min(1.05vw, calc(19 * var(--u))));
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.68);
  }
  .about-punchline {
    display: flex;
    flex-wrap: wrap;
    column-gap: calc(14.08 * var(--u));
    row-gap: calc(2.56 * var(--u));
    margin: calc(25.6 * var(--u)) 0 0;
    font-family: var(--font-display);
    font-size: clamp(calc(12.8 * var(--u)), 1.6vw, calc(19.2 * var(--u)));
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink);
  }
  @media (max-width: 767px) {
    .about-headline { font-size: clamp(1.6rem, 7.5vw, 2.2rem); }
    .about-body { margin-top: 1.4rem; font-size: 1.05rem; }
    .about-punchline { margin-top: 2rem; font-size: 1rem; }
    .about-portrait figcaption { padding-top: 1rem; }
    .about-portrait figcaption span { margin-top: 0.25rem; }
  }

  /* Open editorial dossier (homepage) */
  .about-panels {
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }
  .about-dossier-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem 2rem;
  }
  @media (max-width: 759px) {
    .about-dossier-grid {
      grid-template-columns: 1fr;
    }
  }
  .about-dossier-col {
    border-top: 1px solid var(--hairline-strong);
    padding-top: 1rem;
    min-width: 0;
    scroll-margin-top: calc(var(--nav-bar-h, 76px) + 1rem);
  }
  .about-dossier-kicker {
    margin: 0;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .about-dossier-col .about-body {
    margin-top: 0.75rem;
    font-size: 0.94rem;
    line-height: 1.65;
  }
  @media (max-width: 767px) {
    .about-dossier-col .about-body {
      margin-top: 0.65rem;
      font-size: 0.96rem;
    }
  }

  .about-now-ledger {
    border: 1px solid var(--line);
    background: var(--surface);
    padding: 1.25rem 1.5rem;
    scroll-margin-top: calc(var(--nav-bar-h, 76px) + 1rem);
  }
  .about-now-ledger .about-dossier-kicker {
    margin-bottom: 1rem;
  }
  .about-now-list {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--muted);
  }
  .about-now-item {
    display: grid;
    grid-template-columns: minmax(7rem, 11rem) minmax(0, 1fr);
    gap: 1rem;
    padding: 0.6rem 0;
    border-top: 1px solid var(--line);
  }
  .about-now-item:first-child {
    border-top: 0;
    padding-top: 0;
  }
  .about-now-item:last-child {
    padding-bottom: 0;
  }
  .about-now-key {
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding-top: 0.15rem;
  }
  @media (max-width: 480px) {
    .about-now-ledger {
      padding: 1.1rem 1.15rem;
    }
    .about-now-item {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
  }
  .about-ctas {
    --btn-group-gap: 1rem;
    margin-top: 2rem;
  }
</style>
