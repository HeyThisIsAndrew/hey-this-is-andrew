---
import { Image } from 'astro:assets';
import portraitImg from '../assets/hero-media/portrait.jpg';
import { SUBSTACK_URL } from '../lib/latest-content';
import { NOW_MONTH, NOW_ITEMS } from '../data/now';
import Accordion from '@andrew/ui/Accordion.astro';
import AccordionRow from '@andrew/ui/AccordionRow.astro';
import SectionHeader from '@andrew/ui/SectionHeader.astro';

interface Props {
  /** Full version (About page): the longer telling, Substack kicker link. */
  full?: boolean;
}
const { full = false } = Astro.props;

/* Andrew's own words (2026-10-29), word for word: change them only with
   him. The About page tells it in full; the homepage shows an open editorial
   dossier (What I'm building, How I work, Now), so the two never disagree. */
const STORY = {
  building: "Hey, I'm building three brands: my personal brand, a small press outlet called BE Unconventional HQ, and Capture Create Caffeinate, photo and video for bars, restaurants, and events. My goal is to turn my passions into my career, and I want to do it in public. This is the site where you can follow my journey and see the messy reality of trying to become a full-time content creator.",
  how: [
    "My workflow uses professional cameras and lighting equipment: Sony Alpha, DaVinci Resolve, Lightroom, and Photoshop. I use AI tools to teach me how to master them, not to create content for me, but to help me grow as a creator and push past my own limitations. AI is how I learn faster. Before AI, I was a jack of all trades, master of none. Now I'm a jack of all trades, and I can do anything.",
  ],
};

/* Consolidated bio for the About page (full=true): merges STORY and press.json
   bio using only existing words, approved by Andrew Nov 25, 2026. */
const FULL_BIO = [
  "Hey, I'm Andrew Baxter, a creator, photographer, and coffee drinker building three brands in public and figuring it out as I go. My personal brand is HEY_THISISANDREW. BE Unconventional HQ is a small press outlet covering movies, TV, games, and events. Capture Create Caffeinate is beverage photo and video for bars, restaurants, and events. Everything runs through this site as the hub. My goal is to turn my passions into my career, and this is where you follow the journey and see the messy reality of trying to become a full-time content creator.",
  "I shoot on Sony Alpha cameras with professional lighting, and I edit in DaVinci Resolve, Lightroom, and Photoshop. I use AI to teach me how to master my tools, not to create content for me. AI is how I learn faster and push past my own limitations. Before AI, I was a jack of all trades, master of none. Now I'm a jack of all trades, and I can do anything.",
  "The through line is simple: be yourself, put the work out there, and show the process, not just the result.",
];
---
<section id="about" aria-labelledby="about-heading" class="section-hairline about-section">
  <div class="container">
    <!-- BE-style section bar: icon + title + categories + rule, one line.
         No link here: Read the Substack below is the primary CTA. -->
    <SectionHeader variant="chip" id="about-heading" title={full ? 'About Andrew' : 'Meet The Creator'} />

    <div class="about-grid">
      <figure class="about-portrait">
        <span class="tape" aria-hidden="true"></span>
        <span class="headshot-crop">
          <Image src={portraitImg} alt="Andrew Baxter" widths={[400, 600, 800, 1200, 1600]} sizes="(max-width: 767px) 60vw, (min-width: 1920px) 27rem, 320px" format="webp" loading="lazy" decoding="async" class="headshot-img" />
        </span>
        <figcaption>
          <strong>Andrew Baxter</strong>
          <span>Creator &amp; photographer</span>
        </figcaption>
      </figure>

      <div class="about-copy">
        {!full && <h3 class="display about-headline">The reality of it all.</h3>}
        {full && FULL_BIO.map((para) => <p class="about-body">{para}</p>)}
        <p class="about-punchline">BUILDING IN PUBLIC.</p>
        {!full && (
          <div class="about-panels">
            <Accordion exclusive>
              <AccordionRow chip
                id="about-building"
                title="What I'm building"
                subtitle="Hey, I'm building three brands: my personal brand, BE Unconventional HQ, and CCC."
                open={false}
                level={3}
                size="md"
              >
                <p class="about-body">{STORY.building}</p>
              </AccordionRow>
              <AccordionRow chip
                id="about-how"
                title="How I work"
                subtitle="My workflow uses professional cameras and lighting equipment: Sony Alpha, DaVinci Resolve, Lightroom..."
                open={false}
                level={3}
                size="md"
              >
                {STORY.how.map((para) => <p class="about-body">{para}</p>)}
              </AccordionRow>
              <AccordionRow chip
                id="now"
                title={`Now · ${NOW_MONTH}`}
                subtitle={`${NOW_ITEMS[0].label}: ${NOW_ITEMS[0].value.replace(/\.$/, '')}`}
                open={false}
                level={3}
                size="md"
              >
                <div class="about-now-ledger-inner">
                  <ul class="about-now-list">
                    {NOW_ITEMS.map((n) => (
                      <li class="about-now-item">
                        <span class="about-now-key">{n.label}</span>
                        <span class="about-now-val">{n.value.replace(/\.$/, '')}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </AccordionRow>
            </Accordion>
          </div>
        )}

        {!full && (
          <div class="about-ctas">
            <a class="btn btn-primary" href={SUBSTACK_URL} target="_blank" rel="noopener">
              Substack
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M2 12L12 2M12 2H5M12 2v7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </div>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  /* Spacing and type scale: BE Unconventional HQ's "Inside the HQ"
     (home.css .ihq-*, .hsh-*), measured at 1512 and 390. */
  .about-section {
    --u: 1px;
    position: relative;
    z-index: 2;
    clear: both;
    padding-block: clamp(2.25rem, 4.5vw, 4rem);
  }

  @media (min-width: 1920px) {
    .about-section { --u: clamp(1px, calc(100vw / 1512), 1.25px); }
  }

  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, clamp(240px, 19vw, 360px)) minmax(0, 1fr);
    gap: clamp(1.75rem, 3.5vw, 3.5rem);
    align-items: start;
  }
  @media (max-width: 767px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 2.25rem;
    }
    .about-grid .about-portrait {
      width: min(60vw, 260px);
      max-width: none;
      margin-left: auto;
      margin-right: auto;
      justify-self: center;
      transform: none;
    }
    .about-portrait figcaption { text-align: center; }
    .about-grid .about-portrait figcaption strong { font-size: 0.95rem; }
    .about-grid .about-portrait figcaption span { font-size: 0.68rem; }
  }

  /* Taped portrait frame, HQ style: vertical portrait format. */
  .about-portrait {
    position: relative;
    margin: 0.25rem 0 0;
    max-width: clamp(240px, 19vw, 360px);
    width: 100%;
    transform: rotate(-2deg);
    border: 1px solid rgba(255, 255, 255, 0.25);
    background: #0b0b0b;
    padding: 0.65rem 0.65rem 0;
  }
  .headshot-crop {
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    background: #060606;
    position: relative;
  }
  .headshot-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
    filter: grayscale(0.12) contrast(1.05);
  }
  .tape {
    position: absolute;
    top: -0.85rem;
    left: 8%;
    width: 5.5rem;
    height: 1.7rem;
    background: rgba(205, 205, 205, 0.3);
    border-left: 1px dashed rgba(255,255,255,0.25);
    border-right: 1px dashed rgba(255,255,255,0.25);
    transform: rotate(-6deg);
    z-index: 2;
  }
  .about-portrait figcaption {
    padding: 0.85rem 0.4rem 0.95rem;
  }
  .about-portrait figcaption strong {
    display: block;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.9rem;
    line-height: 1.1;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .about-portrait figcaption span {
    display: block;
    margin-top: 0.22rem;
    font-size: 0.68rem;
    line-height: 1.2;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .about-copy {
    min-width: 0;
  }
  .about-copy > .about-body:first-child {
    margin-top: 0;
  }
  .about-headline {
    font-size: clamp(1.35rem, 1.1rem + 1vw, 2.35rem);
    font-weight: 800;
    line-height: 1.04;
    letter-spacing: normal;
    text-transform: uppercase;
    color: var(--ink);
    margin: 0;
    max-width: 24ch;
    text-wrap: balance;
  }
  .about-body {
    margin: 1.15rem 0 0;
    max-width: none;
    font-size: clamp(1rem, 0.95rem + 0.22vw, 1.18rem);
    line-height: 1.7;
    text-wrap: pretty;
    color: rgba(255, 255, 255, 0.72);
  }
  .about-punchline {
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.85rem;
    row-gap: 0.2rem;
    margin: 1.65rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(0.95rem, 0.85rem + 0.25vw, 1.2rem);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink);
  }
  @media (max-width: 767px) {
    .about-headline { font-size: clamp(1.6rem, 7.5vw, 2.2rem); }
    .about-body { margin-top: 1.15rem; font-size: 1rem; }
    .about-copy > .about-body:first-child { margin-top: 0; }
    .about-punchline { margin-top: 1.5rem; font-size: 0.95rem; }
    .about-portrait figcaption { padding-top: 0.85rem; }
    .about-portrait figcaption span { margin-top: 0.22rem; }
  }

  /* Open editorial dossier (homepage) */
  .about-panels {
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }
  .about-dossier-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem 2rem;
  }
  @media (max-width: 759px) {
    .about-dossier-grid {
      grid-template-columns: 1fr;
    }
  }
  .about-dossier-col {
    border-top: 1px solid var(--hairline-strong);
    padding-top: 1rem;
    min-width: 0;
    scroll-margin-top: calc(var(--nav-bar-h, 76px) + 1rem);
  }
  .about-dossier-col .about-body {
    margin-top: 0;
    font-size: 0.94rem;
    line-height: 1.65;
  }
  .about-dossier-col .about-body + .about-body {
    margin-top: 0.75rem;
  }
  @media (max-width: 767px) {
    .about-dossier-col .about-body {
      margin-top: 0;
      font-size: 0.96rem;
    }
    .about-dossier-col .about-body + .about-body {
      margin-top: 0.65rem;
    }
  }

  .about-now-ledger {
    border: 1px solid var(--line);
    background: var(--surface);
    padding: 1.25rem 1.5rem;
    scroll-margin-top: calc(var(--nav-bar-h, 76px) + 1rem);
  }
  .about-now-list {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--muted);
  }
  .about-now-item {
    display: grid;
    grid-template-columns: minmax(7rem, 11rem) minmax(0, 1fr);
    gap: 1rem;
    padding: 0.6rem 0;
    border-top: 1px solid var(--line);
  }
  .about-now-item:first-child {
    border-top: 0;
    padding-top: 0;
  }
  .about-now-item:last-child {
    padding-bottom: 0;
  }
  .about-now-key {
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding-top: 0.15rem;
  }
  @media (max-width: 480px) {
    .about-now-ledger {
      padding: 1.1rem 1.15rem;
    }
    .about-now-item {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
  }
  .about-ctas {
    --btn-group-gap: 1rem;
    margin-top: 2rem;
  }
  @media (max-width: 600px) {
    /* Stacked, one row height for both (the Substack icon made its row
       2px taller): equal rows, the house rule for a button group. */
    .about-ctas {
      width: 100%;
      display: grid;
      grid-auto-rows: 1fr;
      justify-items: stretch;
    }
    .about-ctas > .btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
