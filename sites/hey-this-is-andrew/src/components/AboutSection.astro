---
import { Image } from 'astro:assets';
import portraitImg from '../assets/hero-media/portrait.jpg';
import { SUBSTACK_URL } from '../lib/latest-content';
import { NOW_MONTH, NOW_ITEMS } from '../data/now';

interface Props {
  /** Full version (About page): all seven paragraphs, Substack kicker link. */
  full?: boolean;
}
const { full = false } = Astro.props;
const rawBase = import.meta.env.BASE_URL;
const base = rawBase === '/' ? '' : rawBase.replace(/\/$/, '');
---
<section id="about" aria-labelledby="about-heading" class="about-section">
  <div class="container">
    <!-- BE-style section bar: logo + title + categories + rule + link, one line.
         HEY_THISISANDREW is the logo (Syne 800 wordmark). Monochrome. -->
    <div class="about-bar">
      <span class="about-bar-icon" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="3"></circle>
          <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
        </svg>
      </span>
      <h2 class="about-bar-title" id="about-heading">{full ? 'About Andrew' : 'Meet The Creator'}</h2>
      <span class="about-bar-cats font-mono">Creator | Photographer | Coffee drinker</span>
      <span class="about-bar-rule" aria-hidden="true"></span>
      {!full && (
        <a class="about-bar-link font-mono" href={`${base}/about/`} data-route-zoom>
          About Andrew <span aria-hidden="true">&rarr;</span>
        </a>
      )}
    </div>

    <div class="about-grid">
      <figure class="about-portrait">
        <span class="tape" aria-hidden="true"></span>
        <span class="headshot-crop">
          <Image src={portraitImg} alt="Andrew Baxter" widths={[400, 600, 800, 1200, 1600]} sizes="(max-width: 767px) 80vw, (min-width: 1920px) 28.5rem, 340px" format="webp" loading="lazy" decoding="async" class="headshot-img" />
        </span>
        <figcaption>
          <strong>Andrew Baxter</strong>
          <span>Creator &amp; photographer</span>
        </figcaption>
      </figure>

      <div class="about-copy">
        <h3 class="display about-headline">WHERE THE MESSY MIDDLE<br />GETS BUILT IN PUBLIC</h3>
        <p>If you want to build something real, you have to show the work. Hey This Is Andrew is an independent hub for the creative process, where building three brands, commercial beverage photography, and creative automation happen out in the open. No shortcuts, no artificial templates: just honest documentation of the messy middle.</p>
        {full && <p>Founded and documented by Andrew Baxter. More than a decade across technology, creative production, and hospitality photography gives him a grounded, working knowledge of how ideas are actually built, tested, and shipped.</p>}
        <p class="about-punchline font-display">BE HONEST. BUILD IN PUBLIC. <strong>HEY_THISISANDREW.</strong></p>
        {!full && (
          /* The Now band, folded in as one line (full list at /now). */
          <p class="about-now">
            <a class="about-now-label font-mono" href={`${base}/now/`}>Now <span class="about-now-month">{NOW_MONTH}</span> <span aria-hidden="true">&rarr;</span></a>
            <span class="about-now-items">
              {NOW_ITEMS.map((n, i) => (
                <span class="about-now-item"><span class="about-now-key">{n.label}:</span> {n.value.replace(/\.$/, '')}{i < NOW_ITEMS.length - 1 && <span class="about-now-sep" aria-hidden="true"> / </span>}</span>
              ))}
            </span>
          </p>
        )}

        <div class="about-ctas">
          {full ? (
            <>
              <a class="btn btn-primary" href={SUBSTACK_URL} target="_blank" rel="noopener">
                Read the Substack
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                  <path d="M2 12L12 2M12 2H5M12 2v7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
              <a class="btn btn-ghost" href="#writing">Latest articles</a>
            </>
          ) : (
            <>
              <a class="btn btn-primary" href={`${base}/about`} data-route-zoom>More about me</a>
              <a class="btn btn-primary" href={SUBSTACK_URL} target="_blank" rel="noopener">Read the Substack</a>
            </>
          )}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about-section {
    padding: clamp(4rem, 8vw, 7rem) 0;
    border-top: 1px solid var(--line);
    position: relative;
    z-index: 2;
    clear: both;
  }

  /* BE-style section bar: logo | title | categories — rule — link.
     Single horizontal line, HQ's "INSIDE THE HQ" pattern in monochrome.
     HEY_THISISANDREW wordmark (Syne 800) is the logo. */
  .about-bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: clamp(2rem, 4vw, 3.25rem);
    flex-wrap: wrap;
  }
  .about-logo {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.05rem;
    letter-spacing: 0.02em;
    color: var(--ink);
    white-space: nowrap;
  }
  .about-bar-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.05rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink);
    margin: 0;
    white-space: nowrap;
  }
  .about-bar-cats {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
  }
  .about-bar-rule {
    flex: 1 1 2rem;
    height: 1px;
    background: var(--border);
    min-width: 2rem;
  }
  @media (max-width: 640px) {
    .about-bar-cats { display: none; }
    .about-bar { gap: 0.75rem; }
  }

  .about-bar-icon {
    display: flex;
    align-items: center;
    color: var(--ink);
  }
  .about-bar-icon svg {
    width: 1.15rem;
    height: 1.15rem;
  }
  .about-bar-link {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.2s ease;
  }
  .about-bar-link:hover {
    color: var(--ink);
  }

  /* Kicker row: icon + title + tags + rule + link, HQ's "INSIDE THE HQ" bar. */
  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 28.333rem) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }
  @media (max-width: 767px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 2.25rem;
    }
    .about-portrait {
      width: min(75vw, 300px);
      max-width: none;
      margin-left: auto;
      margin-right: auto;
      justify-self: center;
      transform: none;
    }
    .about-portrait figcaption { text-align: center; }
  }

  /* Taped portrait frame, HQ style: vertical portrait format.
     Shows Andrew's head, shoulders, and hands in perspective with dramatic
     cinematic lighting — authentic composition matching BE HQ. */
  .about-portrait {
    position: relative;
    margin: 0;
    max-width: 28.333rem;
    width: 100%;
    transform: rotate(-1.5deg);
    border: 1px solid rgba(255, 255, 255, 0.25);
    background: #0b0b0b;
    padding: 0.65rem 0.65rem 0;
  }
  .headshot-crop {
    display: block;
    aspect-ratio: 3.8 / 5;
    overflow: hidden;
    background: #060606;
    position: relative;
  }
  .headshot-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 52% 20%;
    filter: grayscale(0.12) contrast(1.05);
  }
  .tape {
    position: absolute;
    top: -0.85rem;
    left: 8%;
    width: 5.5rem;
    height: 1.7rem;
    background: rgba(205, 205, 205, 0.3);
    border-left: 1px dashed rgba(255,255,255,0.25);
    border-right: 1px dashed rgba(255,255,255,0.25);
    transform: rotate(-6deg);
    z-index: 2;
  }
  .about-portrait figcaption {
    padding: 1rem 0.4rem 1rem;
  }
  .about-portrait figcaption strong {
    display: block;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1rem;
    line-height: 1.1;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .about-portrait figcaption span {
    display: block;
    margin-top: 0.35rem;
    font-size: 0.7rem;
    line-height: 1.2;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .about-headline {
    font-size: clamp(2rem, 3.8vw, 3.2rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: var(--ink);
    margin: 0 0 1.5rem;
    text-wrap: balance;
  }
  .about-copy p {
    color: rgba(245, 245, 245, 0.78);
    font-size: 1.02rem;
    line-height: 1.75;
    margin: 0 0 1.25rem;
    max-width: 62ch;
  }
  .about-copy p strong { color: var(--ink); }
  .about-punchline {
    font-size: 1.05rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 1.75rem 0 2rem;
  }
  .about-punchline strong {
    color: var(--ink);
    font-weight: 800;
  }
  /* Now line (the former Now band, folded into Meet the Creator). */
  .about-now {
    margin: -0.75rem 0 2rem;
    padding: 0.9rem 0 0;
    border-top: 1px solid var(--line);
    font-size: 0.85rem;
    line-height: 1.7;
    color: var(--muted);
  }
  .about-now-label {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: var(--tap-min);
    margin-right: 0.75rem;
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
  }
  .about-now-label:hover,
  .about-now-label:focus-visible {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .about-now-month {
    color: var(--muted);
  }
  .about-now-key {
    color: var(--ink);
  }
  .about-now-sep {
    color: var(--line);
  }
  .about-ctas {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 2rem;
  }

  @media (max-width: 640px) {
    .about-kicker-tags { display: none; }
    .about-kicker-title { font-size: 0.95rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .about-kicker-link { transition: none; }
  }
</style>
