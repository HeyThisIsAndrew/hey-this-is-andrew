---
/**
 * The kit (homepage, #gear): the storefront CTA (revenue), then a link to
 * the full gear inventory on its own page, /gear (every nav item is a page).
 */
import SectionHeader from '@andrew/ui/SectionHeader.astro';
import ViewAllLink from '@andrew/ui/ViewAllLink.astro';
import StorefrontCTA from './StorefrontCTA.astro';
import { PROJECT_INQUIRY_HREF } from '../data/services';

const rawBase = import.meta.env.BASE_URL;
const gearUrl = `${rawBase === '/' ? '' : rawBase.replace(/\/$/, '')}/gear/`;
---
<section id="gear" aria-labelledby="gear-heading" class="section-hairline kit-section">
  <div class="container">
    <SectionHeader id="gear-heading" kicker="The kit" title="Gear" lede="Behind the work. Updated as it evolves." />

    <div id="gear-storefront">
      <StorefrontCTA />
      <p class="kit-disclosure font-mono">As an Amazon Associate, I earn from qualifying purchases.</p>
    </div>

    <div class="kit-actions">
      <ViewAllLink href={gearUrl} label="See all gear" what="on the Gear page" />
      <a class="btn btn-secondary" href={PROJECT_INQUIRY_HREF}>
        Start a project <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </div>
</section>

<style>
  .kit-section {
    padding: var(--space-section) 0;
    border-top: 1px solid var(--line);
  }
  .kit-disclosure {
    margin: 0.85rem 0 0;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .kit-actions {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
  }
  .kit-actions :global(.view-all) {
    margin-top: 0;
  }
</style>
