---
/**
 * The kit (homepage, #gear): full-width flush GearCarousel spotlight
 * directly beneath the divider line (with "See all gear" integrated into its
 * transport bar) and Amazon affiliate disclosure. Full kit + DaVinci Resolve
 * live in BannerRotator on /gear/, while Referrals live on /about/.
 */
import GearCarousel from './GearCarousel.astro';
import SectionHeader from '@andrew/ui/SectionHeader.astro';
---
<section id="gear" aria-labelledby="gear-heading" data-pn-entry data-pn-label="Gear" class="section-hairline kit-section">
  <div class="container kit-head">
    <SectionHeader id="gear-heading" title="Gear" variant="chip" />
  </div>

  <GearCarousel />

  <div class="container kit-footer">
    <p class="kit-disclosure font-mono">As an Amazon Associate, I earn from qualifying purchases.</p>
  </div>
</section>

<style>
  .section-hairline.kit-section {
    padding-top: clamp(1.25rem, 2.5vw, 2rem);
    padding-bottom: clamp(1.25rem, 2.5vw, 2rem);
  }
  .kit-footer {
    margin-top: 0.65rem;
  }
  .kit-disclosure {
    margin: 0;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
</style>
