---
/**
 * The kit (homepage, #gear): the storefront CTA (revenue) with a door to the
 * full gear inventory at /gear. The storefront lives with gear and goals.
 */
import SectionHeader from '@andrew/ui/SectionHeader.astro';
import ViewAllLink from '@andrew/ui/ViewAllLink.astro';
import StorefrontCTA from './StorefrontCTA.astro';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase === '/' ? '' : rawBase.replace(/\/$/, '');
---
<section id="gear" aria-labelledby="gear-heading">
  <div class="container">
    <SectionHeader id="gear-heading" index="06" kicker="The kit" title="Gear" lede="Behind the work. Updated as it evolves." />
    <div id="gear-storefront">
      <StorefrontCTA />
    </div>
    <ViewAllLink href={`${base}/gear/`} what="gear" />
  </div>
</section>
