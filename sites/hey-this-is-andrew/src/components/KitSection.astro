---
/**
 * The kit (homepage, #gear), in reading order:
 * 1. GearCarousel: the seven gear sections, one at a time, each card
 *    opening that section on /gear/.
 * 2. "See all gear": the whole inventory, on /gear/.
 * 3. The gear storefront picks (static) with the Amazon disclosure.
 * Referrals (Mint Mobile) are not gear: they live on /about/.
 */
import SectionHeader from '@andrew/ui/SectionHeader.astro';
import ViewAllLink from '@andrew/ui/ViewAllLink.astro';
import StorefrontCTA from './StorefrontCTA.astro';
import GearCarousel from './GearCarousel.astro';

const rawBase = import.meta.env.BASE_URL;
const gearUrl = `${rawBase === '/' ? '' : rawBase.replace(/\/$/, '')}/gear/`;
---
<section id="gear" aria-labelledby="gear-heading" class="section-hairline kit-section">
  <div class="container">
    <SectionHeader id="gear-heading" kicker="The kit" title="Gear" lede="Behind the work. Updated as it evolves." />

    <GearCarousel />

    <div class="kit-actions">
      <ViewAllLink href={gearUrl} label="See all gear" what="on the Gear page" />
    </div>

    <div id="gear-storefront">
      <StorefrontCTA />
      <p class="kit-disclosure font-mono">As an Amazon Associate, I earn from qualifying purchases.</p>
    </div>
  </div>
</section>

<style>
  .kit-section {
    padding: var(--space-section) 0;
    border-top: 1px solid var(--line);
  }
  .kit-disclosure {
    margin: 0.85rem 0 0;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .kit-actions {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
  }
  .kit-actions :global(.view-all) {
    margin-top: 0;
  }
</style>
