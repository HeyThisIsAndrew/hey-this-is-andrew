---
/**
 * The kit (homepage, #gear): full-width flush GearCarousel spotlight
 * directly beneath the divider line, followed by the "See all gear" action
 * and Amazon affiliate disclosure. Full kit + DaVinci Resolve live in
 * BannerRotator on /gear/, while Referrals live in BannerRotator on /about/.
 */
import GearCarousel from './GearCarousel.astro';

const rawBase = import.meta.env.BASE_URL;
const gearUrl = `${rawBase === '/' ? '' : rawBase.replace(/\/$/, '')}/gear/`;
---
<section id="gear" aria-labelledby="gear-heading" data-pn-entry data-pn-label="Gear" class="section-hairline kit-section">
  <h2 id="gear-heading" class="vh">Gear</h2>

  <GearCarousel />

  <div class="container kit-footer">
    <div class="kit-actions">
      <a class="btn btn-primary" href={gearUrl}>See all gear <span aria-hidden="true">&rarr;</span></a>
    </div>
    <p class="kit-disclosure font-mono">As an Amazon Associate, I earn from qualifying purchases.</p>
  </div>
</section>

<style>
  .section-hairline.kit-section {
    padding-top: 0;
  }
  .kit-footer {
    margin-top: clamp(1.25rem, 2.2vw, 2rem);
  }
  .kit-disclosure {
    margin: 0.85rem 0 0;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .kit-actions {
    margin-top: 0;
    display: flex;
    justify-content: flex-start;
  }
  :global(#site) .kit-actions > .btn {
    background: #080808;
  }
  :global(#site) .kit-actions > .btn:is(:hover, :focus-visible) {
    background: #f5f5f5;
  }
  @media (max-width: 600px) {
    .kit-actions > .btn {
      width: 100%;
    }
  }
</style>
