---
/**
 * The kit (homepage, #gear): the storefront CTA (revenue), then a link to
 * the full gear inventory on its own page, /gear (every nav item is a page).
 */
import SectionHeader from '@andrew/ui/SectionHeader.astro';
import ViewAllLink from '@andrew/ui/ViewAllLink.astro';
import StorefrontCTA from './StorefrontCTA.astro';

const rawBase = import.meta.env.BASE_URL;
const gearUrl = `${rawBase === '/' ? '' : rawBase.replace(/\/$/, '')}/gear/`;
---
<section id="gear" aria-labelledby="gear-heading" class="kit-section">
  <div class="container">
    <SectionHeader id="gear-heading" index="06" kicker="The kit" title="Gear" lede="Behind the work. Updated as it evolves." />

    <div id="gear-storefront">
      <StorefrontCTA />
    </div>

    <ViewAllLink href={gearUrl} label="See all gear" what="on the Gear page" />
  </div>
</section>

<style>
  .kit-section {
    padding: var(--space-section) 0;
    border-top: 1px solid var(--line);
  }
</style>
