---
/**
 * LatestFeed: the merged "Latest" list (was "Notes from the Build" +
 * "Activity across the brands"). Videos, writing (Substack and BE Unconventional
 * HQ articles) and projects, newest first. Each row carries data-kind for
 * FilterTabs (video / writing / project) and a NEW tag while it is fresh.
 * Used on the homepage (condensed) and on /latest (everything).
 */
import NewTag from '@andrew/ui/NewTag.astro';
import { NETWORK_BRANDS, NETWORK_KIND_LABELS } from '../lib/network';
import type { NetworkItem } from '../lib/network';

interface Props {
  items: NetworkItem[];
  /** id of the <ol>, the FilterTabs target. */
  id: string;
}

const { items, id } = Astro.props;

/** "New" for a week after publishing: HQ uses 24 hours, but this site
    publishes weekly, so a day would almost never show. */
const NEW_HOURS = 24 * 7;

const kindOf = (item: NetworkItem) =>
  item.kind === 'video' ? 'video' : item.kind === 'project' ? 'project' : 'writing';

const fmtDate = (iso: string) => {
  const d = new Date(iso);
  if (Number.isNaN(+d)) return '';
  return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
};
---
{items.length > 0 ? (
  <ol class="network-list" id={id}>
    {items.map((item, i) => (
      <li class="network-row reveal" style={`--rd: ${(i % 4) * 60}ms`} data-kind={kindOf(item)}>
        <a
          class="network-link"
          href={item.url}
          target={item.external ? '_blank' : undefined}
          rel={item.external ? 'noopener' : undefined}
        >
          <span class="network-meta">
            <span class="network-brand">{NETWORK_BRANDS[item.brand]}</span>
            <span class="network-kind">{NETWORK_KIND_LABELS[item.kind]}</span>
            {!item.dateEstimated && <NewTag published={item.date} hours={NEW_HOURS} />}
          </span>
          <span class="network-title">{item.title}</span>
          <span class="network-date">{item.dateEstimated ? '' : fmtDate(item.date)}</span>
          <span class="network-arrow" aria-hidden="true">→</span>
        </a>
      </li>
    ))}
  </ol>
) : (
  <p class="network-empty">The feeds are quiet right now. Check back after the next build.</p>
)}

<style>
  .network-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .network-row {
    border-bottom: 1px solid var(--line);
  }
  .network-link {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      "meta date"
      "title arrow";
    gap: 0.35rem 1rem;
    align-items: baseline;
    padding: 1.1rem 0.25rem;
    color: var(--ink);
    text-decoration: none;
    transition: background-color 0.2s ease, padding-left 0.25s ease;
  }
  .network-link:hover,
  .network-link:focus-visible {
    background: rgba(255, 255, 255, 0.03);
    padding-left: 0.75rem;
  }
  .network-link:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: -2px;
  }
  .network-row[hidden] {
    display: none;
  }
  .network-meta {
    grid-area: meta;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: baseline;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .network-brand { color: var(--ink); }
  .network-kind { color: var(--muted); }
  .network-kind::before {
    content: "/";
    margin-right: 0.75rem;
    color: var(--line);
  }
  .network-title {
    grid-area: title;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.05rem, 2.2vw, 1.5rem);
    line-height: 1.25;
    letter-spacing: 0.01em;
  }
  .network-date {
    grid-area: date;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    color: var(--muted);
    white-space: nowrap;
  }
  .network-arrow {
    grid-area: arrow;
    color: var(--muted);
    transition: transform 0.25s ease, color 0.25s ease;
  }
  .network-link:hover .network-arrow,
  .network-link:focus-visible .network-arrow {
    transform: translateX(4px);
    color: var(--ink);
  }
  .network-empty {
    color: var(--muted);
    font-size: 0.95rem;
    padding: 2rem 0;
  }
  @media (min-width: 760px) {
    .network-link {
      grid-template-columns: 240px minmax(0, 1fr) auto auto;
      grid-template-areas: "meta title date arrow";
      gap: 1.5rem;
      align-items: baseline;
    }
    .network-meta { flex-direction: column; gap: 0.25rem; }
    .network-kind::before { content: none; margin: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .network-link, .network-arrow { transition: none; }
  }
</style>
