---
/**
 * Selected Work (homepage, condensed): the latest video, the featured
 * projects and the pipeline, then View all -> /work. No photo strip: the
 * photo elevator ("Shot on the job") sits right above it on the homepage,
 * so a strip here showed the same photos twice (removed 2026-10-01).
 * Keeps #projects as a landing anchor for old links (#photography is the
 * photo elevator itself, which sits on the homepage after About).
 */
import { getCollection } from 'astro:content';
import SectionHeader from '@andrew/ui/SectionHeader.astro';
import ViewAllLink from '@andrew/ui/ViewAllLink.astro';
import LatestCard from './LatestCard.astro';
import ProjectCard from './ProjectCard.astro';
import WorkflowStrip from './WorkflowStrip.astro';
import { getLatestVideo } from '../lib/latest-content';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase === '/' ? '' : rawBase.replace(/\/$/, '');

const latestVideo = await getLatestVideo();
const projects = (await getCollection('projects'))
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || +b.data.date - +a.data.date)
  .slice(0, 2);
---
<section id="projects" aria-labelledby="work-heading" class="selected-work">
  <div class="container">
    <SectionHeader id="work-heading" index="02" kicker="Proof of process" title="Selected work" lede="Work behind the scenes: shoots, edits, and building in public." />

    {latestVideo && (
      <div class="sw-feature">
        <LatestCard item={latestVideo} />
      </div>
    )}

    {projects.length > 0 && (
      <div class="sw-projects">
        {projects.map((p) => <ProjectCard project={p} />)}
      </div>
    )}

    <WorkflowStrip />

    <ViewAllLink href={`${base}/work/`} what="work" />
  </div>
</section>

<style>
  .selected-work {
    position: relative;
  }
  .sw-feature {
    display: grid;
    gap: var(--gap);
    margin-top: 2.5rem;
  }
  .sw-projects {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: var(--gap);
    margin-top: var(--gap);
  }
</style>
