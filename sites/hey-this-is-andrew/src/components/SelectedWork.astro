---
/**
 * Homepage proof: the photography portfolio, featured video and projects,
 * the remaining work, and the production workflow.
 */
import SectionHeader from '@andrew/ui/SectionHeader.astro';
import LatestCard from './LatestCard.astro';
import ProjectCard from './ProjectCard.astro';
import WorkflowStrip from './WorkflowStrip.astro';
import { getCollection } from 'astro:content';
import { getLatestVideos } from '../lib/latest-content';
import { getHomeFeatured } from '../lib/home-featured';
import { youtubeId } from '../lib/youtube-id';

const { latestVideo, projects: featuredProjects } = await getHomeFeatured();

const videos = await getLatestVideos(3);
const allProjects = (await getCollection('projects'))
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || +b.data.date - +a.data.date);

// The featured items lead; remaining videos and projects display directly below.
const restProjects = allProjects.filter((p) => !featuredProjects.some((fp) => fp.id === p.id));

const featuredVideoId = youtubeId(latestVideo?.url);
const seenVideoIds = new Set(featuredVideoId ? [featuredVideoId] : []);
const videoRows = videos.flatMap((v) => {
  const id = youtubeId(v.url);
  if (!id || seenVideoIds.has(id)) return [];
  seenVideoIds.add(id);
  return [{ v, id }];
});
const projectRows = restProjects.map((p) => ({ p }));
---
<section id="work" aria-labelledby="work-heading" class="section-hairline selected-work">
  <div class="container">
    <SectionHeader id="work-heading" title="Work" lede="Work behind the scenes: shoots, edits, and building in public." />
  </div>

  <slot />

  <div class="container">
    <div class="sw-preview">
      {latestVideo && (
        <div class="sw-feature">
          <LatestCard item={latestVideo} />
        </div>
      )}

      {featuredProjects.length > 0 && (
        <div class="sw-projects">
          {featuredProjects.map((p) => <ProjectCard project={p} />)}
        </div>
      )}
    </div>

    {(videoRows.length > 0 || projectRows.length > 0) && (
      <div class="sw-grid">
        {videoRows.map(({ v, id }) => (
          <div id={`work-${id}`} class="sw-card-slot">
            <LatestCard item={v} compact />
          </div>
        ))}
        {projectRows.map(({ p }) => (
          <div id={`work-${p.id}`} class="sw-card-slot">
            <ProjectCard project={p} />
          </div>
        ))}
      </div>
    )}

    <div id="workflow" class="sw-workflow">
      <WorkflowStrip />
    </div>
  </div>
</section>

<style>
  .selected-work {
    position: relative;
  }
  .sw-feature {
    display: grid;
    gap: var(--gap);
  }
  .sw-projects {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: var(--gap);
    margin-top: var(--gap);
  }
  .sw-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--gap);
    margin-top: var(--gap);
  }
  @media (max-width: 759px) {
    .sw-grid {
      grid-template-columns: 1fr;
    }
  }
  .sw-card-slot {
    display: grid;
    min-width: 0;
    scroll-margin-top: calc(var(--nav-bar-h, 76px) + 1rem);
  }
  .sw-workflow {
    scroll-margin-top: calc(var(--nav-bar-h, 76px) + 1rem);
  }
</style>
