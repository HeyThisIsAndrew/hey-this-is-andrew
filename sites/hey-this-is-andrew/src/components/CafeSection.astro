---
import SectionHeader from '@andrew/ui/SectionHeader.astro';
---

<div id="brew" class="cafe-section">
  <div class="cafe-header">
    <span class="mono-tag">Specialty Coffee</span>
    <h3 class="cafe-title">The Cafe Bar</h3>
    <p class="cafe-lede">The commercial espresso and pour over bar that fuels the studio.</p>
  </div>

  <div class="cafe-layout-grid">
    <div class="cafe-equipment-col">
      <SectionHeader
        id="espresso-heading"
        index="01"
        kicker="Equipment"
        title="Espresso & Brew Bar"
        lede="Prosumer hardware for milk drinks and filter coffee."
      />
      <div class="cafe-cards-grid">
        <div class="cafe-card">
          <div>
            <div class="cafe-meta-row">
              <span class="mono-tag">Espresso Machine</span>
              <span class="cafe-spec font-mono">Dual Thermoblock</span>
            </div>
            <h4 class="cafe-card-name">Ascaso Steel Duo PID</h4>
            <p class="cafe-card-desc">Spain-built espresso machine with volumetric controls and precise thermal stability for commercial-grade extraction.</p>
          </div>
          <a href="https://a.co/d/0i9uWbMj" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">Storefront Link <span aria-hidden="true">↗</span></a>
        </div>
        
        <div class="cafe-card">
          <div>
            <div class="cafe-meta-row">
              <span class="mono-tag">Pour Over</span>
              <span class="cafe-spec font-mono">PID Control</span>
            </div>
            <h4 class="cafe-card-name">Fellow Stagg EKG</h4>
            <p class="cafe-card-desc">Variable temperature gooseneck kettle, vital for repeatable pour over extraction temperatures.</p>
          </div>
          <a href="https://a.co/d/0i9uWbMj" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">Storefront Link <span aria-hidden="true">↗</span></a>
        </div>

        <div class="cafe-card">
          <div>
            <div class="cafe-meta-row">
              <span class="mono-tag">Filter Brewer</span>
              <span class="cafe-spec font-mono">Immersion + Drip</span>
            </div>
            <h4 class="cafe-card-name">Hario Switch</h4>
            <p class="cafe-card-desc">Hybrid immersion and percolation brewer delivering the heavy body of a French press with the clean cup of a V60.</p>
          </div>
          <a href="https://a.co/d/0i9uWbMj" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">Storefront Link <span aria-hidden="true">↗</span></a>
        </div>

        <div class="cafe-card">
          <div>
            <div class="cafe-meta-row">
              <span class="mono-tag">Grinder</span>
              <span class="cafe-spec font-mono">64mm Flat Burrs</span>
            </div>
            <h4 class="cafe-card-name">Fellow Ode Gen 2</h4>
            <p class="cafe-card-desc">Dedicated filter coffee grinder with anti-static technology and improved burr geometry for high-clarity pour overs.</p>
          </div>
          <a href="https://a.co/d/0i9uWbMj" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">Storefront Link <span aria-hidden="true">↗</span></a>
        </div>

        <div class="cafe-card">
          <div>
            <div class="cafe-meta-row">
              <span class="mono-tag">Precision Scale</span>
              <span class="cafe-spec font-mono">0.1g Resolution</span>
            </div>
            <h4 class="cafe-card-name">Fellow Scale</h4>
            <p class="cafe-card-desc">Fast response ratio timer and gram-accurate scale keeping espresso brew recipes dialed in to within 0.1g tolerances.</p>
          </div>
          <a href="https://a.co/d/0i9uWbMj" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">Storefront Link <span aria-hidden="true">↗</span></a>
        </div>

        <div class="cafe-card">
          <div>
            <div class="cafe-meta-row">
              <span class="mono-tag">Specialty Beverage</span>
              <span class="cafe-spec font-mono">Nitro Infusion</span>
            </div>
            <h4 class="cafe-card-name">Nitro Press</h4>
            <p class="cafe-card-desc">Rapid nitrogen infusion dispenser for silky cold brew head, cocktail cascades, and craft beverage creations.</p>
          </div>
          <a href="https://a.co/d/0i9uWbMj" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">Storefront Link <span aria-hidden="true">↗</span></a>
        </div>

        <div id="beans" class="cafe-card full-span">
          <div>
            <div class="cafe-meta-row">
              <span class="mono-tag">Roaster of Choice</span>
              <span class="cafe-spec font-mono">San Diego, CA</span>
            </div>
            <h4 class="cafe-card-name">James Coffee Co.</h4>
            <p class="cafe-card-desc">Single origins and house espresso blends crafted in Little Italy, San Diego. The daily driver fueling all content production.</p>
          </div>
          <div class="cafe-btn-group">
            <a href="https://jamescoffeeco.com" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">Visit Roaster <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </div>
    </div>

    <aside id="reels" class="cafe-reel-col">
      <SectionHeader
        id="reel-heading"
        index="02"
        kicker="Media"
        title="9:16 Reel Note"
        lede="Vertical beverage cinematography captured on Sony a7 IV with the Sony 90mm f/2.8 Macro lens."
      />
      <div class="vertical-reel-card">
        <div class="reel-note">
          <span class="mono-tag reel-note-badge">Project note</span>
          <p class="reel-caption font-display">Ascaso Espresso Extraction &amp; Latte Art Workflow</p>
        </div>
        <div class="reel-body">
          <p class="reel-desc">Native 9:16 vertical cinematography captured on Sony a7 IV with the Sony 90mm f/2.8 Macro lens.</p>
          <a href="https://a.co/d/0i9uWbMj" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-block">Shop Beverage Kit on Amazon <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </aside>
  </div>
</div>

<style>
  .cafe-section {
    padding: 3rem 0;
    margin-top: 3rem;
    border-top: 1px solid var(--border);
  }
  .cafe-header { margin-bottom: 2.5rem; }
  .mono-tag {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border);
    padding: 0.3rem 0.65rem;
    display: inline-block;
    margin-bottom: 0.75rem;
  }
  .cafe-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    color: var(--ink);
    margin: 0 0 0.75rem;
    line-height: 1.05;
  }
  .cafe-lede {
    font-size: 1.05rem;
    color: var(--muted);
    max-width: 65ch;
    line-height: 1.7;
    margin: 0;
  }
  .cafe-layout-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: start;
  }
  @media (max-width: 960px) { .cafe-layout-grid { grid-template-columns: 1fr; } }
  .cafe-cards-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
    margin-top: 1.5rem;
  }
  @media (max-width: 640px) { .cafe-cards-grid { grid-template-columns: 1fr; } }
  .cafe-card {
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.25rem;
    transition: border-color 0.25s ease, background-color 0.25s ease;
  }
  .cafe-card:hover {
    border-color: rgba(255, 255, 255, 0.35);
    background: var(--surface-2);
  }
  .cafe-card.full-span { grid-column: 1 / -1; }
  .cafe-meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .cafe-spec {
    font-size: 0.72rem;
    color: var(--muted);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .cafe-card-name {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--ink);
    margin: 0.75rem 0 0.5rem;
  }
  .cafe-card-desc { font-size: 0.88rem; color: var(--muted); line-height: 1.6; margin: 0; }
  .cafe-btn-group { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-top: 1rem; }
  .vertical-reel-card {
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-top: 1.5rem;
  }
  .reel-note {
    background: #0a0a0a;
    border: 1px solid var(--border);
    padding: clamp(1.25rem, 3vw, 1.75rem) 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .reel-note-badge { align-self: flex-start; letter-spacing: 0.18em; text-transform: uppercase; }
  .reel-caption { font-weight: 700; font-size: 1.15rem; margin: 0; color: #fff; line-height: 1.3; }
  .reel-body { display: flex; flex-direction: column; gap: 0.75rem; }
  .reel-desc { font-size: 0.85rem; color: var(--muted); line-height: 1.5; margin: 0; }
  .btn-block { width: 100%; justify-content: center; }
</style>
