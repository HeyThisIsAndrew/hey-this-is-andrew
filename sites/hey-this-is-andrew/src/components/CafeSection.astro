---
import SectionHeader from '@andrew/ui/SectionHeader.astro';

const CAFE_ITEMS = [
  {
    name: 'Ascaso Steel Duo PID',
    category: 'Espresso Machine',
    spec: 'Dual Thermoblock',
    desc: 'Spain-built espresso machine with volumetric controls and precise thermal stability for commercial-grade extraction.',
    url: 'https://link.amazon/B0cCrykft',
    ctaText: 'Product Link',
    ariaLabel: 'View Ascaso Steel Duo PID on Amazon',
    isRoaster: false,
  },
  {
    name: 'Fellow Stagg EKG',
    category: 'Pour Over',
    spec: 'PID Control',
    desc: 'Variable temperature gooseneck kettle, vital for repeatable pour over extraction temperatures.',
    url: 'https://link.amazon/B0fbGKgld',
    ctaText: 'Product Link',
    ariaLabel: 'View Fellow Stagg EKG on Amazon',
    isRoaster: false,
  },
  {
    name: 'Fellow Mighty Small Carafe',
    category: 'Pour Over',
    spec: 'Borosilicate Glass',
    desc: 'Hand-blown smoke grey borosilicate glass carafe with no-drip spout and heat-resistant silicone lid for pour-over service.',
    url: 'https://link.amazon/B01DJcTby',
    ctaText: 'Product Link',
    ariaLabel: 'View Fellow Mighty Small Carafe on Amazon',
    isRoaster: false,
  },
  {
    name: 'Fellow Scale',
    category: 'Precision Scale',
    spec: '0.1g Resolution',
    desc: 'Fast response ratio timer and gram-accurate scale keeping espresso brew recipes dialed in to within 0.1g tolerances.',
    url: 'https://link.amazon/B06NamWQ9',
    ctaText: 'Product Link',
    ariaLabel: 'View Fellow Scale on Amazon',
    isRoaster: false,
  },
  {
    name: 'Nitro Press',
    category: 'Specialty Beverage',
    spec: 'Nitro Infusion',
    desc: 'Rapid nitrogen infusion dispenser for silky cold brew head, cocktail cascades, and craft beverage creations.',
    url: 'https://link.amazon/B04f3JDzo',
    ctaText: 'Product Link',
    ariaLabel: 'View Nitro Press on Amazon',
    isRoaster: false,
  },
  {
    name: 'James Coffee Co.',
    category: 'Roaster of Choice',
    spec: 'San Diego, CA',
    desc: 'Single origins and house espresso blends crafted in Little Italy, San Diego. The daily driver fueling all content production.',
    url: 'https://jamescoffeeco.com',
    ctaText: 'Visit Roaster',
    ariaLabel: 'Visit James Coffee Co. website',
    isRoaster: true,
  },
];
---

<div id="brew" class="cafe-section" data-pn-entry data-pn-label="Cafe Bar">
  <div class="cafe-header">
    <span class="mono-tag">Specialty Coffee</span>
    <h2 class="cafe-title">The Cafe Bar</h2>
    <p class="cafe-lede">The commercial espresso and pour over bar that fuels the studio.</p>
  </div>

  <div class="cafe-layout-grid">
    <!-- LEFT: EQUIPMENT CAROUSEL & FULL GRID -->
    <div class="cafe-equipment-col">
      <div class="cafe-section-header-wrap">
        <SectionHeader
          id="espresso-heading"
          index="01"
          kicker="Equipment"
          title="Espresso & Brew Bar"
          as="h3"
          lede="Prosumer hardware for milk drinks and filter coffee."
        />
        <button
          type="button"
          class="btn-cafe-view-toggle font-mono"
          id="btn-cafe-view-toggle"
          aria-expanded="false"
          aria-controls="cafe-all-grid"
        >
          <span class="cafe-toggle-label">Grid View (6)</span>
          <span class="cafe-toggle-icon" aria-hidden="true">⊞</span>
        </button>
      </div>

      <!-- CAROUSEL DECK VIEW (HERO CARD + PEEKING SLATS + THUMBNAILS + ARROWS) -->
      <div class="cafe-carousel-wrap" id="cafe-carousel-view">
        <div class="cafe-deck-stage" id="cafe-deck-stage">
          <!-- HERO CARD -->
          <div class="cafe-hero-card" id="cafe-hero-card">
            <div class="cafe-card-top-meta">
              <span class="mono-tag" id="cafe-hero-category">{CAFE_ITEMS[0].category}</span>
              <span class="cafe-spec font-mono" id="cafe-hero-spec">{CAFE_ITEMS[0].spec}</span>
              <span class="cafe-card-counter font-mono" id="cafe-hero-counter">01 / 06</span>
            </div>

            <div class="cafe-hero-content">
              <h4 class="cafe-hero-name" id="cafe-hero-name">{CAFE_ITEMS[0].name}</h4>
              <p class="cafe-hero-desc" id="cafe-hero-desc">{CAFE_ITEMS[0].desc}</p>
            </div>

            <div class="cafe-hero-cta-wrap">
              <a
                href={CAFE_ITEMS[0].url}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-secondary cafe-hero-cta"
                id="cafe-hero-cta"
                aria-label={CAFE_ITEMS[0].ariaLabel}
              >
                <span id="cafe-hero-cta-text">{CAFE_ITEMS[0].ctaText}</span>
                <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>

          <!-- PEEKING VERTICAL SLATS (HQ FEATURED PATTERN) -->
          <div class="cafe-slats-stack" aria-hidden="true">
            {CAFE_ITEMS.map((item, idx) => (
              <div
                class={`cafe-slat ${idx === 1 ? 'next-1' : idx === 2 ? 'next-2' : 'hidden'}`}
                data-cafe-slat={idx}
                title={`Click to view ${item.name}`}
              >
                <div class="peeking-spine">
                  <span class="spine-text">{item.name}</span>
                </div>
              </div>
            ))}
          </div>

          <!-- FLANKING PREV / NEXT ARROWS -->
          <div class="cafe-arrows-wrap">
            <button
              type="button"
              class="cafe-nav-arrow cafe-nav-prev"
              id="cafe-prev-btn"
              aria-label="Previous coffee equipment item"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 18 9 12 15 6"></polyline>
              </svg>
            </button>
            <button
              type="button"
              class="cafe-nav-arrow cafe-nav-next"
              id="cafe-next-btn"
              aria-label="Next coffee equipment item"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </button>
          </div>
        </div>

        <!-- THUMBNAIL ROTATION TRACK -->
        <div class="cafe-thumb-track" role="tablist" aria-label="Cafe equipment rotation">
          {CAFE_ITEMS.map((item, idx) => (
            <button
              type="button"
              class={`cafe-thumb-tile ${idx === 0 ? 'is-active' : ''}`}
              role="tab"
              tabindex="0"
              aria-selected={idx === 0 ? 'true' : 'false'}
              aria-label={`Select ${item.name}`}
              data-cafe-tile={idx}
              data-item-name={item.name}
              data-item-category={item.category}
              data-item-spec={item.spec}
              data-item-desc={item.desc}
              data-item-url={item.url}
              data-item-cta={item.ctaText}
              data-item-aria={item.ariaLabel}
            >
              <span class="cafe-thumb-category font-mono">{item.category}</span>
              <span class="cafe-thumb-name">{item.name}</span>
            </button>
          ))}
        </div>
      </div>

      <!-- FULL GRID VIEW (PRESERVES 2-COLUMN FULL-WIDTH DESCRIPTIONS & ALL ACCESSIBLE LINKS) -->
      <div class="cafe-cards-grid" id="cafe-all-grid" hidden>
        {CAFE_ITEMS.map((item) => (
          <div class={`cafe-card ${item.isRoaster ? 'full-span' : ''}`}>
            <div>
              <div class="cafe-meta-row">
                <span class="mono-tag">{item.category}</span>
                <span class="cafe-spec font-mono">{item.spec}</span>
              </div>
              <h4 class="cafe-card-name">{item.name}</h4>
              <p class="cafe-card-desc">{item.desc}</p>
            </div>
            <a
              href={item.url}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-secondary"
              aria-label={item.ariaLabel}
            >
              {item.ctaText} <span aria-hidden="true">↗</span>
            </a>
          </div>
        ))}
      </div>
    </div>

    <!-- RIGHT: 9:16 VERTICAL REEL NOTE (PRESERVED IN FULL) -->
    <aside id="reels" class="cafe-reel-col">
      <SectionHeader
        id="reel-heading"
        index="02"
        kicker="Media"
        title="9:16 Reel Note"
        as="h3"
        lede="Vertical beverage cinematography captured on Sony a7 IV with the Sony 90mm f/2.8 Macro lens."
      />
      <div class="vertical-reel-card">
        <div class="reel-note">
          <span class="mono-tag reel-note-badge">Project note</span>
          <p class="reel-caption font-display">Ascaso Espresso Extraction &amp; Latte Art Workflow</p>
        </div>
        <div class="reel-body">
          <p class="reel-desc">Native 9:16 vertical cinematography captured on Sony a7 IV with the Sony 90mm f/2.8 Macro lens.</p>
          <a href="https://jamescoffeeco.com" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-block" aria-label="Explore beverage equipment workflow">
            Explore Beverage Kit <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </aside>
  </div>
</div>

<style>
  .cafe-section {
    padding: 3rem 0;
    margin-top: 3rem;
    border-top: 1px solid var(--border, rgba(255, 255, 255, 0.12));
  }
  .cafe-header {
    margin-bottom: 2.5rem;
  }
  .mono-tag {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted, #888888);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border, rgba(255, 255, 255, 0.14));
    padding: 0.3rem 0.65rem;
    display: inline-block;
    margin-bottom: 0.75rem;
  }
  .cafe-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    color: var(--ink, #ffffff);
    margin: 0 0 0.75rem;
    line-height: 1.05;
  }
  .cafe-lede {
    font-size: 1.05rem;
    color: var(--muted, #888888);
    max-width: 65ch;
    line-height: 1.7;
    margin: 0;
  }

  .cafe-layout-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.65fr) minmax(0, 1fr);
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: start;
  }
  @media (max-width: 960px) {
    .cafe-layout-grid {
      grid-template-columns: 1fr;
    }
  }

  .cafe-section-header-wrap {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }

  .btn-cafe-view-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 0.85rem;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: var(--ink, #ffffff);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .btn-cafe-view-toggle:hover {
    background: #ffffff;
    color: #000000;
    border-color: #ffffff;
  }

  /* --------------------------------------------------------------------------
     CAFE CAROUSEL DECK (MATCHING HQ PATTERN WITH PEEKING SLATS)
     -------------------------------------------------------------------------- */
  .cafe-carousel-wrap {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    width: 100%;
  }

  .cafe-deck-stage {
    position: relative;
    width: 100%;
    display: flex;
    align-items: stretch;
    min-height: 250px;
    gap: 0.75rem;
  }

  .cafe-hero-card {
    flex: 1;
    min-width: 0;
    background: var(--surface, #111111);
    border: 1px solid var(--border, rgba(255, 255, 255, 0.14));
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.5rem;
    position: relative;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
  }
  .cafe-card-top-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .cafe-card-top-meta .mono-tag {
    margin-bottom: 0;
  }
  .cafe-spec {
    font-size: 0.72rem;
    color: var(--muted, #888888);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .cafe-card-counter {
    font-size: 0.68rem;
    color: var(--muted, #888888);
    letter-spacing: 0.08em;
  }

  .cafe-hero-content {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }
  .cafe-hero-name {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 2vw, 1.75rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--ink, #ffffff);
    margin: 0;
    line-height: 1.2;
  }
  .cafe-hero-desc {
    font-size: 0.95rem;
    color: var(--muted, #a0a0a0);
    line-height: 1.65;
    margin: 0;
    max-width: 100%; /* Full-width readable description */
  }

  .cafe-hero-cta-wrap {
    display: flex;
    align-items: center;
    padding-top: 0.5rem;
  }

  /* PEEKING SLATS */
  .cafe-slats-stack {
    display: flex;
    gap: 0.4rem;
    align-items: stretch;
    flex-shrink: 0;
  }
  @media (max-width: 720px) {
    .cafe-slats-stack {
      display: none;
    }
  }

  .cafe-slat {
    position: relative;
    width: 44px;
    background: #141414;
    border: 1px solid rgba(255, 255, 255, 0.1);
    overflow: hidden;
    cursor: pointer;
    transition: all 0.25s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .cafe-slat.next-1 { opacity: 0.85; z-index: 2; }
  .cafe-slat.next-2 { opacity: 0.55; z-index: 1; }
  .cafe-slat.hidden { display: none; }
  .cafe-slat:hover {
    opacity: 1;
    width: 58px;
    background: #1c1c1c;
    border-color: rgba(255, 255, 255, 0.35);
  }
  .peeking-spine {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }
  .spine-text {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    color: #ffffff;
    white-space: nowrap;
    text-transform: uppercase;
    opacity: 0.8;
  }

  /* ARROWS WRAP */
  .cafe-arrows-wrap {
    position: absolute;
    right: 1.25rem;
    top: 1.25rem;
    display: flex;
    gap: 0.35rem;
    z-index: 10;
  }
  .cafe-nav-arrow {
    width: 32px;
    height: 32px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: rgba(15, 15, 15, 0.85);
    color: var(--ink, #ffffff);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
    backdrop-filter: blur(4px);
  }
  .cafe-nav-arrow:hover {
    background: #ffffff;
    color: #000000;
    border-color: #ffffff;
  }

  /* THUMBNAIL TRACK */
  .cafe-thumb-track {
    display: flex;
    gap: 0.65rem;
    overflow-x: auto;
    padding: 0.5rem 0.25rem 0.75rem;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .cafe-thumb-track::-webkit-scrollbar {
    display: none;
  }
  .cafe-thumb-tile {
    flex: 0 0 auto;
    width: 155px;
    background: #111111;
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 0.65rem 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    cursor: pointer;
    text-align: left;
    color: inherit;
    font: inherit;
    opacity: 0.55;
    transition: all 0.2s ease;
  }
  .cafe-thumb-tile:hover {
    opacity: 0.9;
    border-color: rgba(255, 255, 255, 0.3);
    background: #161616;
  }
  .cafe-thumb-tile.is-active {
    opacity: 1;
    border-color: #ffffff;
    background: #1a1a1a;
    box-shadow: 0 4px 14px rgba(255, 255, 255, 0.12);
  }
  .cafe-thumb-category {
    font-size: 0.62rem;
    color: var(--key-ink, #c0c0c0);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .cafe-thumb-name {
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--ink, #ffffff);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* --------------------------------------------------------------------------
     GRID VIEW (READABLE TWO-COLUMN FULL-WIDTH DESCRIPTIONS PRESERVED)
     -------------------------------------------------------------------------- */
  .cafe-carousel-wrap[hidden],
  .cafe-cards-grid[hidden] {
    display: none !important;
  }
  .cafe-cards-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
    margin-top: 0.5rem;
  }
  @media (max-width: 640px) {
    .cafe-cards-grid {
      grid-template-columns: 1fr;
    }
  }
  .cafe-card {
    background: var(--surface, #111111);
    border: 1px solid var(--border, rgba(255, 255, 255, 0.14));
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.25rem;
    transition: border-color 0.25s ease, background-color 0.25s ease;
  }
  .cafe-card:hover {
    border-color: rgba(255, 255, 255, 0.35);
    background: var(--surface-2, #181818);
  }
  .cafe-card.full-span {
    grid-column: 1 / -1;
  }
  .cafe-meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .cafe-card-name {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--ink, #ffffff);
    margin: 0.75rem 0 0.5rem;
  }
  .cafe-card-desc {
    font-size: 0.88rem;
    color: var(--muted, #a0a0a0);
    line-height: 1.6;
    margin: 0;
  }

  /* --------------------------------------------------------------------------
     REEL NOTE ASIDE
     -------------------------------------------------------------------------- */
  .vertical-reel-card {
    background: var(--surface, #111111);
    border: 1px solid var(--border, rgba(255, 255, 255, 0.14));
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-top: 1.5rem;
  }
  .reel-note {
    background: #0a0a0a;
    border: 1px solid var(--border, rgba(255, 255, 255, 0.14));
    padding: clamp(1.25rem, 3vw, 1.75rem) 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .reel-note-badge {
    align-self: flex-start;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .reel-caption {
    font-weight: 700;
    font-size: 1.15rem;
    margin: 0;
    color: #ffffff;
    line-height: 1.3;
  }
  .reel-body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .reel-desc {
    font-size: 0.85rem;
    color: var(--muted, #888888);
    line-height: 1.5;
    margin: 0;
  }
  .btn-block {
    width: 100%;
    justify-content: center;
  }
</style>

<script>
  (() => {
    function initCafeCarousel() {
      const carouselWrap = document.getElementById('cafe-carousel-view');
      const allGrid = document.getElementById('cafe-all-grid');
      const toggleBtn = document.getElementById('btn-cafe-view-toggle');
      if (!carouselWrap || carouselWrap.dataset.cafeWired === '1') return;
      carouselWrap.dataset.cafeWired = '1';

      const tiles = Array.from(carouselWrap.querySelectorAll<HTMLElement>('.cafe-thumb-tile'));
      const slats = Array.from(carouselWrap.querySelectorAll<HTMLElement>('.cafe-slat'));
      const prevBtn = document.getElementById('cafe-prev-btn');
      const nextBtn = document.getElementById('cafe-next-btn');

      const heroCategory = document.getElementById('cafe-hero-category');
      const heroSpec = document.getElementById('cafe-hero-spec');
      const heroCounter = document.getElementById('cafe-hero-counter');
      const heroName = document.getElementById('cafe-hero-name');
      const heroDesc = document.getElementById('cafe-hero-desc');
      const heroCta = document.getElementById('cafe-hero-cta') as HTMLAnchorElement | null;
      const heroCtaText = document.getElementById('cafe-hero-cta-text');

      let activeIndex = 0;
      const total = tiles.length;

      function render(index: number) {
        activeIndex = (index + total) % total;
        const currentTile = tiles[activeIndex];
        if (!currentTile) return;

        tiles.forEach((t, i) => {
          const isActive = i === activeIndex;
          t.classList.toggle('is-active', isActive);
          t.setAttribute('aria-selected', isActive ? 'true' : 'false');
        });

        currentTile.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });

        if (heroCounter) heroCounter.textContent = `0${activeIndex + 1} / 0${total}`;
        if (heroCategory) heroCategory.textContent = currentTile.dataset.itemCategory || '';
        if (heroSpec) heroSpec.textContent = currentTile.dataset.itemSpec || '';
        if (heroName) heroName.textContent = currentTile.dataset.itemName || '';
        if (heroDesc) heroDesc.textContent = currentTile.dataset.itemDesc || '';

        if (heroCta) {
          heroCta.href = currentTile.dataset.itemUrl || 'https://jamescoffeeco.com';
          heroCta.setAttribute('aria-label', currentTile.dataset.itemAria || 'View item');
        }
        if (heroCtaText) {
          heroCtaText.textContent = currentTile.dataset.itemCta || 'Product Link';
        }

        // Slats update
        const next1 = (activeIndex + 1) % total;
        const next2 = (activeIndex + 2) % total;
        slats.forEach((slat, idx) => {
          slat.className = 'cafe-slat';
          if (idx === next1) slat.classList.add('next-1');
          else if (idx === next2) slat.classList.add('next-2');
          else slat.classList.add('hidden');
        });
      }

      tiles.forEach((tile, idx) => {
        tile.addEventListener('click', () => render(idx));
        tile.addEventListener('keydown', (e: KeyboardEvent) => {
          if (e.key === 'ArrowRight') { e.preventDefault(); render(activeIndex + 1); }
          else if (e.key === 'ArrowLeft') { e.preventDefault(); render(activeIndex - 1); }
        });
      });

      slats.forEach((slat, idx) => {
        slat.addEventListener('click', () => render(idx));
      });

      prevBtn?.addEventListener('click', () => render(activeIndex - 1));
      nextBtn?.addEventListener('click', () => render(activeIndex + 1));

      // Touch swipe
      const stage = document.getElementById('cafe-deck-stage');
      if (stage) {
        let startX = 0;
        stage.addEventListener('touchstart', (e: TouchEvent) => {
          startX = e.changedTouches[0].screenX;
        }, { passive: true });
        stage.addEventListener('touchend', (e: TouchEvent) => {
          const diff = startX - e.changedTouches[0].screenX;
          if (Math.abs(diff) > 40) {
            if (diff > 0) render(activeIndex + 1);
            else render(activeIndex - 1);
          }
        }, { passive: true });
      }

      // View toggle between carousel and grid
      toggleBtn?.addEventListener('click', () => {
        const isGridVisible = !allGrid?.hidden;
        if (isGridVisible) {
          if (allGrid) allGrid.hidden = true;
          if (carouselWrap) carouselWrap.hidden = false;
          toggleBtn.setAttribute('aria-expanded', 'false');
          const label = toggleBtn.querySelector('.cafe-toggle-label');
          const icon = toggleBtn.querySelector('.cafe-toggle-icon');
          if (label) label.textContent = 'Grid View (6)';
          if (icon) icon.textContent = '⊞';
        } else {
          if (carouselWrap) carouselWrap.hidden = true;
          if (allGrid) allGrid.hidden = false;
          toggleBtn.setAttribute('aria-expanded', 'true');
          const label = toggleBtn.querySelector('.cafe-toggle-label');
          const icon = toggleBtn.querySelector('.cafe-toggle-icon');
          if (label) label.textContent = 'Carousel View';
          if (icon) icon.textContent = '⊟';
        }
      });
    }

    initCafeCarousel();
    document.addEventListener('astro:page-load', initCafeCarousel);
  })();
</script>
