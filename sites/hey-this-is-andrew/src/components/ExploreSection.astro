---
import FlipCard from '@andrew/ui/FlipCard.astro';
import SectionHeader from '@andrew/ui/SectionHeader.astro';
import { homeUrl, WORK_WITH_ME_HREF } from '../data/nav';

const pages = [
  {
    name: 'Goals',
    line: 'My goals, and where each of my three brands stands.',
    href: `${homeUrl}build/`,
    action: 'View goals',
  },
  {
    name: 'Gear',
    line: 'The kit behind the work.',
    href: `${homeUrl}gear/`,
    action: 'See all gear',
  },
  {
    name: 'Latest',
    line: 'Recent videos, articles, and dispatches across BE, CCC, and the build.',
    href: `${homeUrl}latest/`,
    action: 'View latest',
  },
  {
    name: 'Work With Me',
    line: 'I build websites for small businesses and creators.',
    href: WORK_WITH_ME_HREF,
    action: 'Work With Me',
  },
];
---

<section id="explore" aria-labelledby="explore-heading" class="section-hairline">
  <div class="container">
    <SectionHeader variant="chip" id="explore-heading" title="Explore" />
    <div class="flip-card-grid explore-grid">
      {pages.map((page, index) => (
        <FlipCard
          value={page.name}
          backText={page.line}
          actionLabel={page.action}
          actionHref={page.href}
          actionTarget="_self"
          clickOnly
          idPrefix="explore-card"
          index={index}
        />
      ))}
    </div>
  </div>
</section>

<style>
  .explore-grid {
    --flip-accent-border: var(--hairline-strong);
    --flip-accent-shadow: 0 8px 30px rgb(255 255 255 / 0.1);
    --flip-value-size: clamp(1rem, 1.15vw, 1.75rem);
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1rem, 1.6vw, 1.75rem);
    width: 100%;
    margin-inline: 0;
  }

  .explore-grid :global(.stat-card.flip-card) {
    min-height: clamp(220px, 16vw, 340px);
  }

  .explore-grid :global(.stat-value) {
    white-space: normal;
    overflow: visible;
    text-overflow: clip;
    text-wrap: balance;
    line-height: 1.25;
  }

  @media (max-width: 1024px) {
    .explore-grid.flip-card-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      width: 100%;
      margin-inline: 0;
      gap: 1rem;
    }
  }

  @media (max-width: 560px) {
    .explore-grid.flip-card-grid {
      grid-template-columns: 1fr;
    }

    .explore-grid :global(.stat-card.flip-card) {
      min-height: 185px;
    }
  }
</style>
