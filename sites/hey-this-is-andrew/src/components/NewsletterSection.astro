---
/** The homepage's one newsletter signup (defect 35), as its own block. */
import SectionHeader from '@andrew/ui/SectionHeader.astro';
import NewsletterSignup from './NewsletterSignup.astro';
---
<section id="newsletter" aria-labelledby="newsletter-sec-heading" class="section-hairline newsletter-section">
  <div class="container">
    <SectionHeader id="newsletter-sec-heading" title="Newsletter" variant="chip" />
    <NewsletterSignup />
  </div>
</section>

<style>
  /* The homepage flows section to section: a small, even gap. */
  .newsletter-section {
    padding-top: clamp(1.25rem, 2.5vw, 2rem);
  }
</style>
