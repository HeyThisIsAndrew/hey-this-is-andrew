---
import type { CollectionEntry } from 'astro:content';
import SectionHeader from '@andrew/ui/SectionHeader.astro';

interface Props { groups: CollectionEntry<'goals'>[] }
const { groups } = Astro.props;

const count = (g: CollectionEntry<'goals'>) => {
  const done = g.data.items.filter((i) => i.status === 'done').length;
  return { done, total: g.data.items.length };
};

const rawBase = import.meta.env.BASE_URL;
const buildUrl = rawBase === '/' ? '/build/' : `${rawBase.replace(/\/$/, '')}/build/`;
---
<section class="section-hairline" id="goals" aria-labelledby="goals-heading">
  <div class="container">
    <SectionHeader variant="chip" id="goals-heading" title="Goals" />

    <div class="goals-board" role="region" aria-label="Goals by group">
      {groups.map((group) => {
        const { done, total } = count(group);
        const pct = total > 0 ? Math.round((done / total) * 100) : 0;
        return (
          <article class="goal-card" id={`home-goal-${group.id}`}>
            <header class="goal-card-head">
              <h3 class="goal-card-title">{group.data.title}</h3>
              <div class="goal-card-progress" aria-label={`Progress: ${done} of ${total}`}>
                <div class="goal-progress-bar" aria-hidden="true">
                  <div class="goal-progress-fill" style={`width: ${pct}%`}></div>
                </div>
                <span class="goal-progress-count font-mono">{done} of {total}</span>
              </div>
            </header>

            <ul class="goal-ledger-list">
              {group.data.items.map((item) => {
                const statusKey = item.status === 'next' ? 'queued' : item.status;
                const statusText = item.status === 'done' ? 'Done' : item.status === 'in-progress' ? 'In Progress' : 'Queued';
                return (
                  <li class:list={['goal-ledger-item', 'checklist-card', { 'is-done': item.status === 'done', completed: item.status === 'done' }]}>
                    <span class:list={['checklist-mark', { 'is-done': item.status === 'done', 'is-active': item.status === 'in-progress' }]} aria-hidden="true">
                      {item.status === 'done' && (
                        <svg viewBox="0 0 16 16" width="11" height="11" fill="none"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="2" stroke-linecap="square" /></svg>
                      )}
                    </span>
                    <div class="goal-ledger-info">
                      <span class="goal-ledger-label checklist-title">{item.label}</span>
                      {item.note && <span class="goal-ledger-note checklist-desc">{item.note}</span>}
                    </div>
                    <span class="goal-status-badge font-mono" data-status={statusKey}>
                      {statusText}
                    </span>
                  </li>
                );
              })}
            </ul>
          </article>
        );
      })}
    </div>

    <div class="goals-actions">
      <a href={buildUrl} class="btn btn-primary">Goals <span aria-hidden="true">&rarr;</span></a>
    </div>
  </div>
</section>

<style>
  /* Mobile: horizontal swipe row with scroll-snap */
  .goals-board {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: clamp(1rem, 2vw, 2.5rem);
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    gap: 1.25rem;
    padding-bottom: 0.75rem;
    scrollbar-width: none;
    margin-inline: calc(-1 * clamp(1rem, 2vw, 2.5rem));
    padding-inline: clamp(1rem, 2vw, 2.5rem);
  }
  .goals-board::-webkit-scrollbar {
    display: none;
  }
  .goal-card {
    flex: 0 0 min(85vw, 360px);
    width: min(85vw, 360px);
    max-width: min(85vw, 360px);
    scroll-snap-align: start;
    border: 1px solid var(--line, rgba(255, 255, 255, 0.12));
    background: var(--surface, #101010);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    min-width: 0;
    box-sizing: border-box;
  }

  /* Desktop (min-width: 960px): 3-column grid, equal height, tops aligned */
  @media (min-width: 960px) {
    .goals-board {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.5rem;
      margin-inline: 0;
      padding-inline: 0;
      overflow-x: visible;
      scroll-snap-type: none;
      padding-bottom: 0;
    }
    .goal-card {
      flex: initial;
      width: auto;
      max-width: none;
      scroll-snap-align: none;
    }
  }

  .goal-card-head {
    border-bottom: 1px solid var(--line, rgba(255, 255, 255, 0.1));
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
  }
  .goal-card-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(0.95rem, 1.35vw, 1.15rem);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink, #fff);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: 1.2;
  }
  .goal-card-progress {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-top: 0.65rem;
  }
  .goal-progress-bar {
    flex: 1 1 auto;
    height: 3px;
    background: rgba(255, 255, 255, 0.12);
    border-radius: 2px;
    overflow: hidden;
  }
  .goal-progress-fill {
    height: 100%;
    background: var(--ink, #fff);
    border-radius: 2px;
    transition: width 0.3s ease;
  }
  .goal-progress-count {
    flex: 0 0 auto;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted, rgba(255, 255, 255, 0.6));
    font-weight: 500;
    white-space: nowrap;
  }

  .goal-ledger-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    flex: 1 1 auto;
  }
  .goal-ledger-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--hairline, rgba(255, 255, 255, 0.08));
  }
  .goal-ledger-item:first-child {
    padding-top: 0;
    border-top: 0;
  }
  .checklist-mark {
    display: inline-grid;
    place-items: center;
    margin-top: 0.2rem;
    width: 1.05rem;
    height: 1.05rem;
    flex: 0 0 auto;
    border: 1px solid rgba(255, 255, 255, 0.35);
    color: #080808;
  }
  .checklist-mark.is-done {
    background: var(--ink, #fff);
    border-color: var(--ink, #fff);
  }
  .checklist-mark.is-active {
    border-color: var(--ink, #fff);
  }
  .checklist-mark.is-active::after {
    content: '';
    width: 5px;
    height: 5px;
    background: var(--ink, #fff);
  }
  .goal-ledger-info {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .goal-ledger-label {
    font-size: 0.94rem;
    font-weight: 500;
    line-height: 1.4;
    color: var(--ink, #fff);
  }
  .goal-ledger-item.is-done .goal-ledger-label {
    color: var(--muted, rgba(255, 255, 255, 0.6));
  }
  .goal-ledger-note {
    font-size: 0.82rem;
    line-height: 1.45;
    color: var(--muted, rgba(255, 255, 255, 0.6));
  }
  .goal-status-badge {
    flex: 0 0 auto;
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.2rem 0.45rem;
    border: 1px solid var(--hairline-strong, rgba(255, 255, 255, 0.2));
    color: var(--muted, rgba(255, 255, 255, 0.6));
    white-space: nowrap;
  }
  .goal-status-badge[data-status="done"],
  .goal-status-badge[data-status="in-progress"] {
    color: var(--ink, #fff);
    border-color: rgba(255, 255, 255, 0.35);
  }
  .goals-actions {
    margin-top: 2rem;
    display: flex;
    justify-content: center;
  }
  @media (max-width: 600px) {
    .goals-actions {
      width: 100%;
    }
    .goals-actions > .btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
