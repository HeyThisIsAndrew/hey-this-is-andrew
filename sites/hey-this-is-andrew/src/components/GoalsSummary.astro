---
import type { CollectionEntry } from 'astro:content';
import SectionHeader from '@andrew/ui/SectionHeader.astro';
import Accordion from '@andrew/ui/Accordion.astro';
import AccordionRow from '@andrew/ui/AccordionRow.astro';

interface Props { groups: CollectionEntry<'goals'>[] }
const { groups } = Astro.props;

const count = (g: CollectionEntry<'goals'>) => {
  const done = g.data.items.filter((i) => i.status === 'done').length;
  return { done, total: g.data.items.length, pct: Math.round((done / Math.max(1, g.data.items.length)) * 100) };
};
---
<section id="goals" aria-labelledby="goals-heading">
  <div class="container">
    <SectionHeader id="goals-heading" index="04" kicker="Building in public" title="Goals" />
    
    <div class="goals-accordion-wrapper">
      <Accordion>
        {groups.map((group) => {
          const { done, total } = count(group);
          return (
            <AccordionRow
              id={`home-goal-${group.id}`}
              kicker="Goal Group"
              title={group.data.title}
              progressCount={done}
              progressTotal={total}
            >
              <ul class="checklist-container" style="padding-top: 1.5rem;">
                {group.data.items.map(item => (
                  <li class:list={['checklist-card', { completed: item.status === 'done' }]}>
                    <div class="checklist-left">
                      <span class:list={['checklist-mark', { 'is-done': item.status === 'done' }]} aria-hidden="true">
                        {item.status === 'done' && (
                          <svg viewBox="0 0 16 16" width="12" height="12" fill="none"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="2" stroke-linecap="square" /></svg>
                        )}
                      </span>
                      <div class="checklist-info">
                        <h3 class="checklist-title">{item.label}</h3>
                        {item.note && <p class="checklist-desc">{item.note}</p>}
                      </div>
                    </div>
                    <div class:list={['status-badge', item.status === 'done' ? 'achieved' : item.status]}>
                      {item.status === 'in-progress' && <span class="pulse-indicator"></span>}
                      <span class="badge-text">{item.status === 'done' ? 'Done' : item.status === 'in-progress' ? 'In Progress' : 'Queued'}</span>
                    </div>
                  </li>
                ))}
              </ul>
            </AccordionRow>
          );
        })}
      </Accordion>
    </div>

    <div class="view-all-wrapper">
      <a href="/build/" class="btn view-all-btn">View all goals</a>
    </div>
  </div>
</section>

<style>
  .goals-accordion-wrapper {
    margin-top: 2rem;
    margin-bottom: 3rem;
  }
  .view-all-wrapper {
    display: flex;
    justify-content: center;
    margin-top: 2rem;
  }
  .view-all-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.8rem 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink);
    background: transparent;
    border: 1px solid var(--border);
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .view-all-btn:hover {
    background: var(--ink);
    color: var(--surface);
  }
  
  /* Reuse checklist styles for consistency */
  .checklist-container {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .checklist-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.25rem 1.5rem;
    background: var(--surface);
    border: 1px solid var(--border);
  }
  .checklist-card.completed {
    border-color: rgba(255, 255, 255, 0.4);
    background: rgba(255, 255, 255, 0.03);
  }
  .checklist-left {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    flex: 1 1 auto;
  }
  .checklist-mark {
    display: inline-grid;
    place-items: center;
    margin-top: 0.2rem;
    width: 1.2rem;
    height: 1.2rem;
    flex-shrink: 0;
    border: 1px solid rgba(255, 255, 255, 0.35);
    color: #080808;
  }
  .checklist-mark.is-done {
    background: var(--ink);
    border-color: var(--ink);
  }
  .checklist-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--ink);
    margin: 0;
  }
  .checklist-desc {
    font-size: 0.92rem;
    color: var(--muted);
    margin: 0.35rem 0 0;
    line-height: 1.5;
  }
  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    border: 1px solid var(--border);
  }
</style>
