---
/**
 * Storefront picks or referrals (src/data/storefront.ts).
 * - Default (2 items, /gear/): rendered as 3D flip cards with unified button sizing.
 * - picks={REFERRALS} (5 items, /about/): rendered as balanced 5-column grid with equal-height cards and CTA at bottom.
 */
import { GEAR_PICKS, type StorefrontPick } from '../data/storefront';
import FlipCard from '@andrew/ui/FlipCard.astro';

interface Props {
  picks?: StorefrontPick[];
  /** Accessible name of the block. */
  label?: string;
  /** Optional small heading above the picks. */
  eyebrow?: string;
  flipCards?: boolean;
}
const { picks = GEAR_PICKS, label = 'Featured picks and recommendations', eyebrow, flipCards } = Astro.props;
const useFlipCards = flipCards ?? picks.length <= 2;
---
<aside class="storefront" aria-label={label} data-count={picks.length}>
  {eyebrow && <p class="storefront-eyebrow font-mono">{eyebrow}</p>}
  {useFlipCards ? (
    <div class="storefront-picks-grid">
      {picks.map((pick, idx) => (
        <FlipCard
          value={pick.title}
          label={pick.kicker ?? ''}
          kickerFirst={true}
          desc={pick.frontDesc ?? pick.desc ?? ''}
          backText={pick.desc ?? ''}
          actionLabel={pick.cta}
          actionHref={pick.url}
          idPrefix="storefront-pick"
          index={idx}
          class="storefront-flip-card"
        />
      ))}
    </div>
  ) : (
    <ul class="storefront-picks">
      {picks.map((pick) => (
        <li class="storefront-pick">
          {pick.kicker && <p class="kicker font-mono">{pick.kicker}</p>}
          <h3 class="display storefront-pick-title">{pick.title}</h3>
          {pick.desc && <p class="storefront-pick-desc">{pick.desc}</p>}
          <a class="btn btn-primary storefront-cta" href={pick.url} target="_blank" rel="noopener">
            {pick.cta}
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M2 12L12 2M12 2H5M12 2v7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </li>
      ))}
    </ul>
  )}
</aside>

<style>
  .storefront {
    margin-top: 2.5rem;
    border: 1px solid var(--line);
    background: var(--surface);
    padding: clamp(1.25rem, 3vw, 2rem);
  }
  .storefront-eyebrow {
    margin: 0 0 1.25rem;
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .storefront-picks-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem 2.5rem;
    width: 100%;
    box-sizing: border-box;
  }
  @media (min-width: 768px) {
    .storefront-picks-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .storefront-flip-card {
    min-height: 200px;
  }
  :global(#site .storefront-flip-card .flip-action-btn) {
    width: 240px !important;
    height: 46px !important;
    min-height: 46px !important;
    box-sizing: border-box !important;
  }

  .storefront-picks {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* For 5 items (referrals), use 5 intentional columns on desktop so no item is orphaned */
  [data-count="5"] .storefront-picks {
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1.25rem;
  }
  @media (max-width: 1080px) {
    [data-count="5"] .storefront-picks {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 768px) {
    [data-count="5"] .storefront-picks {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 520px) {
    [data-count="5"] .storefront-picks {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .storefront-pick {
    display: flex;
    flex-direction: column;
    min-width: 0;
    height: 100%;
    padding: clamp(1rem, 1.5vw, 1.25rem);
    border: 1px solid var(--line, rgba(255, 255, 255, 0.1));
    background: #0d0d0d;
    box-sizing: border-box;
  }
  .storefront .kicker {
    margin: 0;
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .storefront-pick-title {
    margin: 0;
    font-size: clamp(1.05rem, 1.4vw, 1.25rem);
    text-transform: uppercase;
    font-weight: 800;
    letter-spacing: 0.02em;
  }
  .storefront-pick-desc {
    flex: 1 1 auto;
    margin: 0.75rem 0 1.25rem;
    color: var(--muted, #888);
    font-size: 0.85rem;
    line-height: 1.5;
  }
  .storefront-cta {
    margin-top: auto;
    width: 100%;
    min-height: 44px;
    height: 44px;
    padding: 0 1rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    white-space: nowrap;
    text-decoration: none;
    box-sizing: border-box;
    font-size: var(--btn-fs-sm, 0.75rem);
    letter-spacing: var(--btn-ls, 0.08em);
    text-transform: uppercase;
    font-weight: 600;
  }
</style>
