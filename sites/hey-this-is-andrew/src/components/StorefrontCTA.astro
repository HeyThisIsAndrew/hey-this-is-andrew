---
/**
 * Storefront picks or referrals (src/data/storefront.ts), all shown at once,
 * each with its own button. Nothing rotates: it used to be a one-at-a-time
 * rotator whose only control was a row of thin dot bars, and with two gear
 * picks there is nothing to rotate through.
 *
 * - Default: the gear picks (the homepage Gear section, /gear/).
 * - picks={REFERRALS} with an eyebrow (/about/): referrals, which are not gear.
 */
import { GEAR_PICKS, type StorefrontPick } from '../data/storefront';

interface Props {
  picks?: StorefrontPick[];
  /** Accessible name of the block. */
  label?: string;
  /** Optional small heading above the picks. */
  eyebrow?: string;
}
const { picks = GEAR_PICKS, label = 'Featured picks and recommendations', eyebrow } = Astro.props;
---
<aside class="storefront" aria-label={label}>
  {eyebrow && <p class="storefront-eyebrow font-mono">{eyebrow}</p>}
  <ul class="storefront-picks">
    {picks.map((pick) => (
      <li class="storefront-pick">
        <p class="kicker font-mono">{pick.kicker}</p>
        <h3 class="display storefront-pick-title">{pick.title}</h3>
        <p class="storefront-pick-desc">{pick.desc}</p>
        <a class="btn btn-primary storefront-cta" href={pick.url} target="_blank" rel="noopener">
          {pick.cta}
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M2 12L12 2M12 2H5M12 2v7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </li>
    ))}
  </ul>
</aside>

<style>
  .storefront {
    margin-top: 2.5rem;
    border: 1px solid var(--line);
    background: var(--surface);
    padding: clamp(1.25rem, 3vw, 2rem);
  }
  .storefront-eyebrow {
    margin: 0 0 1.25rem;
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .storefront-picks {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 1.5rem 2.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .storefront-pick {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    min-width: 0;
  }
  .storefront .kicker {
    margin: 0;
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .storefront-pick-title {
    margin: 0;
    font-size: clamp(1.2rem, 2vw, 1.5rem);
    text-transform: uppercase;
    font-weight: 800;
  }
  .storefront-pick-desc {
    flex: 1;
    margin: 0 0 0.5rem;
    color: var(--muted);
    max-width: 52ch;
  }
  .storefront-cta {
    max-width: 100%;
  }
</style>
