---
/**
 * Storefront picks or referrals (src/data/storefront.ts), rendered as 3D flip cards,
 * each with its own button.
 *
 * - Default: the gear picks (the homepage Gear section, /gear/).
 * - picks={REFERRALS} with an eyebrow (/about/): referrals, which are not gear.
 */
import { GEAR_PICKS, type StorefrontPick } from '../data/storefront';
import FlipCard from '@andrew/ui/FlipCard.astro';

interface Props {
  picks?: StorefrontPick[];
  /** Accessible name of the block. */
  label?: string;
  /** Optional small heading above the picks. */
  eyebrow?: string;
}
const { picks = GEAR_PICKS, label = 'Featured picks and recommendations', eyebrow } = Astro.props;
---
<aside class="storefront" aria-label={label}>
  {eyebrow && <p class="storefront-eyebrow font-mono">{eyebrow}</p>}
  <div class="storefront-picks-grid">
    {picks.map((pick, idx) => (
      <FlipCard
        value={pick.title}
        label={pick.kicker ?? ''}
        kickerFirst={true}
        desc={pick.frontDesc ?? pick.desc ?? ''}
        backText={pick.desc ?? ''}
        actionLabel={pick.cta}
        actionHref={pick.url}
        idPrefix="storefront-pick"
        index={idx}
        class="storefront-flip-card"
      />
    ))}
  </div>
</aside>

<style>
  .storefront {
    margin-top: 2.5rem;
    border: 1px solid var(--line);
    background: var(--surface);
    padding: clamp(1.25rem, 3vw, 2rem);
  }
  .storefront-eyebrow {
    margin: 0 0 1.25rem;
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .storefront-picks-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem 2.5rem;
    width: 100%;
    box-sizing: border-box;
  }
  @media (min-width: 768px) {
    .storefront-picks-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .storefront-flip-card {
    min-height: 200px;
  }
  :global(#site .storefront-flip-card .flip-action-btn) {
    width: 240px !important;
    height: 46px !important;
    min-height: 46px !important;
    box-sizing: border-box !important;
  }
</style>
