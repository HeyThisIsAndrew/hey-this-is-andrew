---
/**
 * WorkWithAndrew: "What I do". Displays all five service lines from
 * src/data/services.ts in one balanced visual grid, followed by the
 * project logistics ledger and brand partnership actions.
 */
import type { ImageMetadata } from 'astro';
import SectionHeader from '@andrew/ui/SectionHeader.astro';
import FlipCard from '@andrew/ui/FlipCard.astro';
import {
  SERVICES,
  SERVICES_CLIENT_BLOCK,
  UGC_INQUIRY_HREF,
  COHLEY_PROFILE_URL,
} from '../data/services';
import { CCC_TURNAROUND } from '../data/ccc';

import drinksPourImg from '../assets/ccc/s05-work-drinks-1-pour.jpg';
import desertMarqueeImg from '../assets/ccc/s08-video-desert-2-marquee.jpg';
import workDetailImg from '../assets/ccc/s07-work-detail.jpg';
import davinciResolveImg from '../assets/brand-logos/davinci-resolve.png';
import laComicConImg from '../assets/brands/hq/la-comic-con-2026.jpg';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase === '/' ? '' : rawBase.replace(/\/$/, '');

interface ServiceVisual {
  src?: ImageMetadata;
  alt?: string;
  objectPosition?: string;
  isLogo?: boolean;
  slateLabel?: string;
}

const SERVICE_VISUALS: Record<string, ServiceVisual> = {
  'Beverage & hospitality photography': {
    src: drinksPourImg,
    alt: 'Bartender pouring a craft cocktail into a coupe glass',
    objectPosition: 'center 40%',
  },
  'Short-form video & Reels': {
    src: desertMarqueeImg,
    alt: 'Neon marquee and evening crowd at Desert Escape',
    objectPosition: '20% center',
  },
  'UGC & brand partnerships': {
    src: workDetailImg,
    alt: 'Cut crystal bar glassware and spirits bottle in studio lighting',
    objectPosition: 'center 72%',
  },
  'Video editing': {
    src: davinciResolveImg,
    alt: 'DaVinci Resolve studio editing and color grading software',
    isLogo: true,
  },
  'Event photo & video coverage': {
    src: laComicConImg,
    alt: 'L.A. Comic Con event coverage by BE Unconventional HQ',
    objectPosition: 'center center',
  },
};

const serviceCards = SERVICES.map((service, index) => {
  const visual = SERVICE_VISUALS[service.title] ?? {};
  const isWide = index >= 3;
  return {
    ...service,
    isWide,
    visual,
  };
});

/* Turnaround and client details come from the shared brand facts (src/data/ccc.ts
   and src/data/services.ts). Pricing is not shown on the website. */
const logisticsItems = [
  { value: CCC_TURNAROUND },
  { value: SERVICES_CLIENT_BLOCK.deliverablesAndUsage },
  { value: SERVICES_CLIENT_BLOCK.clientResults },
].filter((item): item is { value: string } => Boolean(item.value && item.value.trim()));
---
<section id="services" aria-labelledby="services-heading" class="section-hairline work-section">
  <div class="container">
    <SectionHeader
      id="services-heading"
      title="What I do"
    />

    <div class="work-grid">
      {serviceCards.map((s, i) => (
        <div
          class:list={['work-card-wrap', 'reveal', { 'work-card-wrap--wide': s.isWide }]}
          style={`--rd: ${i * 70}ms`}
        >
          <FlipCard
            value={s.title}
            backText={s.desc}
            image={s.visual.src}
            imageAlt={s.visual.alt}
            imagePosition={s.visual.objectPosition}
            isLogo={s.visual.isLogo}
            slateLabel={s.visual.slateLabel}
            imageSide="front"
            idPrefix="service-card"
            index={i}
            class="work-flip-card"
          />
        </div>
      ))}
    </div>

    {logisticsItems.length > 0 && (
      <div class="client-block reveal" data-client-block>
        <div class="logistics-ledger">
          {logisticsItems.map((item) => (
            <div class="logistics-item">
              <p class="logistics-value">{item.value}</p>
            </div>
          ))}
        </div>
      </div>
    )}

    <div class="work-cta reveal">
      <p class="work-cta-caption">Brands: send a product to review, or ask about a partnership.</p>
      <div class="btn-group">
        <a class="btn btn-primary" href={UGC_INQUIRY_HREF}>
          Send a product <span aria-hidden="true">&rarr;</span>
        </a>
        <a class="btn btn-secondary" href={COHLEY_PROFILE_URL} target="_blank" rel="noopener">
          Cohley profile
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M2 12L12 2M12 2H5M12 2v7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>
      <p class="work-press-note">
        Press or media inquiry? <a href={`${base}/about/#press`}>Visit the press kit <span aria-hidden="true">&rarr;</span></a>
      </p>
    </div>
  </div>
</section>

<style>
  .work-section {
    padding-block: var(--space-section);
    margin: 0;
  }

  .work-grid {
    --flip-accent-border: var(--hairline-strong);
    --flip-accent-shadow: 0 8px 30px rgb(255 255 255 / 0.1);
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 760px) {
    .work-grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
    .work-card-wrap {
      grid-column: span 2;
    }
    .work-card-wrap--wide {
      grid-column: span 3;
    }
  }

  .work-card-wrap {
    display: flex;
    min-width: 0;
    width: 100%;
  }

  .work-card-wrap :global(.stat-card.flip-card) {
    --flip-value-size: clamp(1.1rem, 1.45vw, 1.75rem);
    min-height: 210px;
  }

  @media (min-width: 760px) {
    .work-card-wrap :global(.stat-card.flip-card) {
      min-height: clamp(260px, 20vw, 420px);
    }
  }

  /* How projects run: unified specification ledger matching WorkflowStrip. */
  .client-block {
    margin-top: clamp(1.5rem, 3vw, 2rem);
  }

  .logistics-ledger {
    border: 1px solid var(--line);
    border-radius: 0;
    background: var(--surface);
    padding: clamp(1rem, 2.2vw, 2rem);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(0.75rem, 2vw, 2rem);
  }

  .logistics-item {
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .logistics-value {
    margin: 0;
    font-family: var(--font-mono);
    font-size: clamp(0.6875rem, 0.9vw, 0.8rem);
    line-height: 1.5;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
    overflow-wrap: anywhere;
  }

  .work-cta {
    margin-top: clamp(1.5rem, 3vw, 2rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.85rem;
  }

  .work-cta-caption {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--muted);
  }

  :global(#site) .work-cta .btn:not(:hover, :focus-visible) {
    background: #000;
  }

  .work-press-note {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0 0.4rem;
    font-family: var(--font-body);
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--muted);
  }

  .work-press-note a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    min-height: var(--tap-min, 44px);
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: var(--hairline-strong);
    transition: text-decoration-color 0.2s ease;
  }

  .work-press-note a:hover,
  .work-press-note a:focus-visible {
    text-decoration-color: currentColor;
  }
</style>
