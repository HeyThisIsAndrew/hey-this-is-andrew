---
/**
 * WorkWithAndrew: "What I do". The service lines live in
 * src/data/services.ts, expanding in-place to the full offering
 * from the former /services/ page.
 */
import SectionHeader from '@andrew/ui/SectionHeader.astro';
import ExpandSection from '@andrew/ui/ExpandSection.astro';
import {
  SERVICES,
  SERVICES_LEDE,
  SERVICES_CLIENT_BLOCK,
  UGC_INQUIRY_HREF,
} from '../data/services';
import { CCC_TURNAROUND } from '../data/ccc';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase === '/' ? '' : rawBase.replace(/\/$/, '');

const previewItems = SERVICES.slice(0, 3);
const restItems = SERVICES.slice(3);

/* Turnaround and client details come from the shared brand facts (src/data/ccc.ts
   and src/data/services.ts). Pricing is not shown on the website. */
const clientCards: { label: string; value?: string; link?: { label: string; href: string } }[] = [
  { label: 'Turnaround', value: CCC_TURNAROUND },
  { label: 'Deliverables & Usage', value: SERVICES_CLIENT_BLOCK.deliverablesAndUsage },
  { label: 'Client Results', value: SERVICES_CLIENT_BLOCK.clientResults },
].filter((c) => Boolean(c.value && c.value.trim()));
---
<section id="services" aria-labelledby="services-heading" class="section-hairline work-section">
  <div class="container">
    <SectionHeader
      id="services-heading"
      kicker="Work with Andrew"
      title="What I do"
      lede={SERVICES_LEDE}
    />
    
    <ul class="work-list">
      {previewItems.map((s, i) => (
        <li class="work-item reveal" style={`--rd: ${i * 70}ms`}>
          <h3 class="work-title">{s.title}</h3>
          <p class="work-desc">{s.desc}</p>
        </li>
      ))}
    </ul>
    
    {restItems.length > 0 && (
      <ExpandSection id="services-expander" expandLabel="Show all services" collapseLabel="Show less">
        <ul class="work-list work-list-extra">
          {restItems.map((s) => (
            <li class="work-item reveal">
              <h3 class="work-title">{s.title}</h3>
              <p class="work-desc">{s.desc}</p>
            </li>
          ))}
        </ul>
      </ExpandSection>
    )}

    {clientCards.length > 0 && (
      <div class="client-block reveal" data-client-block>
        <div class="client-cards-grid">
          {clientCards.map((card) => (
            <div class="client-card">
              <span class="client-card-label font-mono">{card.label}</span>
              <p class="client-card-value">{card.value}</p>
              {card.link && (
                <a class="client-card-link font-mono" href={card.link.href}>
                  {card.link.label} <span aria-hidden="true">&rarr;</span>
                </a>
              )}
            </div>
          ))}
        </div>
      </div>
    )}

    <div class="work-cta-row reveal">
      <div class="work-ugc-cta">
        <a class="btn btn-primary" href={UGC_INQUIRY_HREF}>
          Send a product to review <span aria-hidden="true">&rarr;</span>
        </a>
        <p class="work-ugc-sub">Brands: send a product to review, or ask about a partnership.</p>
      </div>
      <p class="press-link">
        Press or media inquiry? <a href={`${base}/about/#press`}>Visit the press kit &rarr;</a>
      </p>
    </div>
  </div>
</section>

<style>
  .work-section {
    padding: var(--space-section) 0;
    border-top: 1px solid var(--line);
  }
  .work-list {
    list-style: none;
    margin: 0 0 clamp(2rem, 4vw, 3rem);
    padding: 0;
    display: grid;
    gap: 1.5rem;
  }
  .work-list-extra {
    margin-top: 1.5rem;
  }
  @media (min-width: 760px) {
    .work-list { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  .work-item {
    border: 1px solid var(--line);
    background: var(--surface);
    padding: 1.5rem;
  }
  .work-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.1rem;
    margin: 0 0 0.6rem;
    letter-spacing: 0.02em;
  }
  .work-desc {
    margin: 0;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.6;
  }
  .client-block {
    margin-top: 2rem;
  }
  .client-cards-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }
  @media (max-width: 1024px) {
    .client-cards-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 600px) {
    .client-cards-grid {
      grid-template-columns: 1fr;
    }
  }
  .client-card {
    border: 1px solid var(--line);
    background: var(--surface);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .client-card-label {
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .client-card-link {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .client-card-value {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--ink);
  }
  .work-cta-row {
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 2rem;
  }
  .work-ugc-cta {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: flex-start;
  }
  .work-ugc-sub {
    font-size: 0.82rem;
    color: var(--muted);
    margin: 0;
  }
  .press-link {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .press-link a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
