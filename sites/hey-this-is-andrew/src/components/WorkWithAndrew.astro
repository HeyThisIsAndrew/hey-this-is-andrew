---
/**
 * WorkWithAndrew: "What I do". Top three service cards, the compact photo
 * elevator inline (no side cards), two service cards beneath, and the UGC
 * and Press flip cards at the bottom.
 */
import type { ImageMetadata } from 'astro';
import SectionHeader from '@andrew/ui/SectionHeader.astro';
import FlipCard from '@andrew/ui/FlipCard.astro';
import PhotographyPortfolio from './PhotographyPortfolio.astro';
import {
  SERVICES,
  UGC_INQUIRY_HREF,
  COHLEY_PROFILE_URL,
} from '../data/services';
import { CCC_TURNAROUND } from '../data/ccc';

import drinksPourImg from '../assets/ccc/s05-work-drinks-1-pour.jpg';
import desertMarqueeImg from '../assets/ccc/s08-video-desert-2-marquee.jpg';
import workDetailImg from '../assets/ccc/s07-work-detail.jpg';
import davinciResolveImg from '../assets/brand-logos/davinci-resolve.png';
import laComicConImg from '../assets/brands/hq/la-comic-con-2026.jpg';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase === '/' ? '' : rawBase.replace(/\/$/, '');

interface ServiceVisual {
  src?: ImageMetadata;
  alt?: string;
  objectPosition?: string;
  isLogo?: boolean;
  slateLabel?: string;
}

const SERVICE_VISUALS: Record<string, ServiceVisual> = {
  'Beverage & hospitality photography': {
    src: drinksPourImg,
    alt: 'Bartender pouring a craft cocktail into a coupe glass',
    objectPosition: 'center 40%',
  },
  'Short-form video & Reels': {
    src: desertMarqueeImg,
    alt: 'Neon marquee and evening crowd at Desert Escape',
    objectPosition: '20% center',
  },
  'UGC & brand partnerships': {
    src: workDetailImg,
    alt: 'Cut crystal bar glassware and spirits bottle in studio lighting',
    objectPosition: 'center 72%',
  },
  'Video editing': {
    src: davinciResolveImg,
    alt: 'DaVinci Resolve studio editing and color grading software',
    isLogo: true,
  },
  'Event photo & video coverage': {
    src: laComicConImg,
    alt: 'L.A. Comic Con event coverage by BE Unconventional HQ',
    objectPosition: 'center center',
  },
};

const serviceCards = SERVICES.map((service, index) => {
  const visual = SERVICE_VISUALS[service.title] ?? {};
  const desc = index === 0 ? `${service.desc} ${CCC_TURNAROUND}` : service.desc;
  return {
    ...service,
    desc,
    visual,
  };
});

const topServiceCards = serviceCards.slice(0, 3);
const bottomServiceCards = serviceCards.slice(3, 5);
---
<section id="services" aria-labelledby="services-heading" class="section-hairline work-section">
  <div class="container">
    <SectionHeader
      id="services-heading"
      title="What I do"
    />

    <div class="work-row work-row--top">
      {topServiceCards.map((s, i) => (
        <div class="work-card-wrap reveal" style={`--rd: ${i * 70}ms`}>
          <FlipCard
            value={s.title}
            backText={s.desc}
            image={s.visual.src}
            imageAlt={s.visual.alt}
            imagePosition={s.visual.objectPosition}
            isLogo={s.visual.isLogo}
            slateLabel={s.visual.slateLabel}
            imageSide="front"
            idPrefix="service-card"
            index={i}
            class="work-flip-card"
          />
        </div>
      ))}
    </div>

    <div class="work-elevator">
      <PhotographyPortfolio inline />
    </div>

    <div class="work-row work-row--pair">
      {bottomServiceCards.map((s, i) => (
        <div class="work-card-wrap reveal" style={`--rd: ${i * 70}ms`}>
          <FlipCard
            value={s.title}
            backText={s.desc}
            image={s.visual.src}
            imageAlt={s.visual.alt}
            imagePosition={s.visual.objectPosition}
            isLogo={s.visual.isLogo}
            slateLabel={s.visual.slateLabel}
            imageSide="front"
            idPrefix="service-card"
            index={i + 3}
            class="work-flip-card"
          />
        </div>
      ))}
    </div>

    <div class="work-row work-row--actions">
      <div class="work-card-wrap reveal" style="--rd: 0ms">
        <FlipCard
          value="UGC"
          idPrefix="work-action"
          index={0}
          class="work-flip-card work-flip-card--action"
        >
          <div slot="back-action" class="flip-action-group">
            <a
              class="btn btn-primary flip-action-btn font-mono"
              href={UGC_INQUIRY_HREF}
              tabindex="-1"
              aria-hidden="true"
              data-no-flip
            >
              Send a product <span aria-hidden="true">&rarr;</span>
            </a>
            <a
              class="btn btn-secondary flip-action-btn font-mono"
              href={COHLEY_PROFILE_URL}
              target="_blank"
              rel="noopener"
              tabindex="-1"
              aria-hidden="true"
              data-no-flip
            >
              Cohley profile
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M2 12L12 2M12 2H5M12 2v7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </div>
        </FlipCard>
      </div>

      <div class="work-card-wrap reveal" style="--rd: 70ms">
        <FlipCard
          value="Press"
          idPrefix="work-action"
          index={1}
          class="work-flip-card work-flip-card--action"
        >
          <div slot="back-action" class="flip-action-group">
            <a
              class="btn btn-primary flip-action-btn font-mono"
              href={`${base}/about/#press`}
              tabindex="-1"
              aria-hidden="true"
              data-no-flip
            >
              Visit the press kit <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </FlipCard>
      </div>
    </div>
  </div>
</section>

<style>
  .work-section {
    padding-block: var(--space-section);
    margin: 0;
  }

  .work-row {
    --flip-accent-border: var(--hairline-strong);
    --flip-accent-shadow: 0 8px 30px rgb(255 255 255 / 0.1);
    --flip-value-size: clamp(1rem, 1.25vw, 1.45rem);
    --flip-back-size: clamp(0.84rem, 0.92vw, 0.98rem);
    --flip-back-size-mobile: 0.85rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }

  @media (min-width: 760px) {
    .work-row--top {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .work-row--pair,
    .work-row--actions {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .work-elevator {
    margin-block: clamp(1rem, 1.8vw, 1.5rem);
  }

  .work-row--actions {
    margin-top: 0.75rem;
  }

  .work-card-wrap {
    display: flex;
    min-width: 0;
    width: 100%;
  }

  .work-card-wrap :global(.stat-card.flip-card) {
    min-height: 155px;
  }

  .work-card-wrap :global(.work-flip-card--action.stat-card.flip-card) {
    min-height: 135px;
  }

  .work-card-wrap :global(.flip-card-front),
  .work-card-wrap :global(.flip-card-back) {
    padding: clamp(0.85rem, 1.35vw, 1.25rem) clamp(1rem, 1.6vw, 1.4rem);
  }

  @media (min-width: 760px) {
    .work-card-wrap :global(.stat-card.flip-card) {
      min-height: clamp(165px, 12.5vw, 220px);
    }
    .work-card-wrap :global(.work-flip-card--action.stat-card.flip-card) {
      min-height: clamp(135px, 10vw, 175px);
    }
  }
</style>
