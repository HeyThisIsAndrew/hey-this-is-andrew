---
/**
 * WorkWithAndrew: "What I do". Displays all five service lines from
 * src/data/services.ts in one balanced visual grid, followed by the
 * project logistics ledger and brand partnership actions.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SectionHeader from '@andrew/ui/SectionHeader.astro';
import {
  SERVICES,
  SERVICES_LEDE,
  SERVICES_CLIENT_BLOCK,
  UGC_INQUIRY_HREF,
  COHLEY_PROFILE_URL,
} from '../data/services';
import { CCC_TURNAROUND } from '../data/ccc';

import drinksPourImg from '../assets/ccc/s05-work-drinks-1-pour.jpg';
import desertMarqueeImg from '../assets/ccc/s08-video-desert-2-marquee.jpg';
import workDetailImg from '../assets/ccc/s07-work-detail.jpg';
import davinciResolveImg from '../assets/brand-logos/davinci-resolve.png';
import laComicConImg from '../assets/brands/hq/la-comic-con-2026.jpg';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase === '/' ? '' : rawBase.replace(/\/$/, '');

interface ServiceVisual {
  src?: ImageMetadata;
  alt?: string;
  objectPosition?: string;
  isLogo?: boolean;
  slateLabel?: string;
}

const SERVICE_VISUALS: Record<string, ServiceVisual> = {
  'Beverage & hospitality photography': {
    src: drinksPourImg,
    alt: 'Bartender pouring a craft cocktail into a coupe glass',
    objectPosition: 'center 40%',
  },
  'Short-form video & Reels': {
    src: desertMarqueeImg,
    alt: 'Neon marquee and evening crowd at Desert Escape',
    objectPosition: '20% center',
  },
  'UGC & brand partnerships': {
    src: workDetailImg,
    alt: 'Cut crystal bar glassware and spirits bottle in studio lighting',
    objectPosition: 'center 72%',
  },
  'Video editing': {
    src: davinciResolveImg,
    alt: 'DaVinci Resolve studio editing and color grading software',
    isLogo: true,
    slateLabel: 'POST-PRODUCTION',
  },
  'Event photo & video coverage': {
    src: laComicConImg,
    alt: 'L.A. Comic Con event coverage by BE Unconventional HQ',
    objectPosition: 'center center',
  },
};

const widthsFor = (src: ImageMetadata) =>
  [...new Set([320, 480, 640].filter((w) => w < src.width).concat(src.width))];

const serviceCards = SERVICES.map((service, index) => {
  const visual = SERVICE_VISUALS[service.title] ?? {};
  const isWide = index >= 3;
  return {
    ...service,
    isWide,
    visual,
  };
});

/* Turnaround and client details come from the shared brand facts (src/data/ccc.ts
   and src/data/services.ts). Pricing is not shown on the website. */
const logisticsItems = [
  { label: 'Turnaround', value: CCC_TURNAROUND },
  { label: 'Deliverables & Usage', value: SERVICES_CLIENT_BLOCK.deliverablesAndUsage },
  { label: 'Client Results', value: SERVICES_CLIENT_BLOCK.clientResults },
].filter((item): item is { label: string; value: string } => Boolean(item.value && item.value.trim()));
---
<section id="services" aria-labelledby="services-heading" class="section-hairline work-section">
  <div class="container">
    <SectionHeader
      id="services-heading"
      kicker="Work with Andrew"
      title="What I do"
      lede={SERVICES_LEDE}
    />

    <ul class="work-grid">
      {serviceCards.map((s, i) => (
        <li
          class:list={['work-card', 'reveal', { 'work-card--wide': s.isWide, 'work-card--text': !s.visual.src }]}
          style={`--rd: ${i * 70}ms`}
        >
          {s.visual.src ? (
            <div class:list={['work-media', { 'work-media--slate': s.visual.isLogo }]}>
              {s.visual.isLogo ? (
                <div class="work-slate">
                  <div class="work-slate-lockup">
                    <Image
                      src={s.visual.src}
                      alt={s.visual.alt ?? 'DaVinci Resolve'}
                      width={100}
                      height={100}
                      format="webp"
                      quality={92}
                      class="work-slate-logo"
                    />
                  </div>
                  {s.visual.slateLabel && (
                    <span class="work-slate-label font-mono">{s.visual.slateLabel}</span>
                  )}
                </div>
              ) : (
                <Image
                  src={s.visual.src}
                  alt={s.visual.alt ?? ''}
                  widths={widthsFor(s.visual.src)}
                  sizes={s.isWide ? '(max-width: 759px) 100vw, (max-width: 959px) 50vw, 25vw' : '(max-width: 759px) 100vw, 33vw'}
                  format="webp"
                  quality={82}
                  loading="lazy"
                  decoding="async"
                  class="work-img cinematic-img"
                  style={s.visual.objectPosition ? `object-position: ${s.visual.objectPosition};` : undefined}
                />
              )}
            </div>
          ) : null}

          <div class="work-body">
            <h3 class="work-title">{s.title}</h3>
            <p class="work-desc">{s.desc}</p>
          </div>
        </li>
      ))}
    </ul>

    {logisticsItems.length > 0 && (
      <div class="client-block reveal" data-client-block>
        <h3 class="subsection-header">How projects run</h3>
        <div class="logistics-ledger">
          {logisticsItems.map((item) => (
            <div class="logistics-item">
              <span class="logistics-label font-mono">{item.label}</span>
              <p class="logistics-value">{item.value}</p>
            </div>
          ))}
        </div>
      </div>
    )}

    <div class="work-cta reveal">
      <p class="work-cta-caption">Brands: send a product to review, or ask about a partnership.</p>
      <div class="btn-group">
        <a class="btn btn-primary" href={UGC_INQUIRY_HREF}>
          Send a product to review <span aria-hidden="true">&rarr;</span>
        </a>
        <a class="btn btn-secondary" href={COHLEY_PROFILE_URL} target="_blank" rel="noopener">
          View my Cohley profile
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M2 12L12 2M12 2H5M12 2v7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>
      <p class="work-press-note">
        Press or media inquiry? <a href={`${base}/about/#press`}>Visit the press kit <span aria-hidden="true">&rarr;</span></a>
      </p>
    </div>

    <p class="section-handoff font-mono">
      <a href="#goals">Next: Building in public (Goals) <span aria-hidden="true">&darr;</span></a>
    </p>
  </div>
</section>

<style>
  .work-section {
    padding-block: var(--space-section);
    margin: 0;
  }

  .work-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 760px) {
    .work-grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
    .work-card {
      grid-column: span 2;
    }
    .work-card--wide {
      grid-column: span 3;
    }
  }

  .work-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    overflow: clip;
  }

  .work-media {
    width: 100%;
    min-width: 0;
    background: var(--surface-2);
    border-bottom: 1px solid var(--line);
    overflow: clip;
  }

  .work-img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .work-media--slate {
    display: grid;
    place-items: center;
    width: 100%;
    aspect-ratio: 16 / 10;
    background: radial-gradient(ellipse at center, #202020, #080808 75%);
  }

  .work-slate {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
    padding: 1.25rem;
    text-align: center;
  }

  .work-slate-lockup {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .work-slate-logo {
    display: block;
    width: clamp(3.75rem, 5.5vw, 5rem);
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: contain;
    filter: drop-shadow(0 6px 20px rgba(0, 0, 0, 0.7));
  }

  .work-slate-label {
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .work-body {
    min-width: 0;
    padding: 1.35rem 1.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
  }

  @media (min-width: 960px) {
    .work-card--wide {
      display: grid;
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      grid-template-rows: 1fr;
    }
    .work-card--wide .work-media {
      height: 100%;
      border-bottom: none;
      border-right: 1px solid var(--line);
    }
    .work-card--wide .work-img {
      height: 100%;
    }
    .work-card--wide .work-media--slate {
      aspect-ratio: auto;
      width: 100%;
      min-height: 100%;
    }
    .work-card--wide .work-body {
      justify-content: center;
      padding: 1.35rem 1.5rem;
    }
  }

  .work-card--text .work-body {
    justify-content: center;
    padding: clamp(2rem, 4vw, 4rem);
    border-top: 3px solid var(--ink);
  }
  .work-card--text .work-title { max-width: 12ch; font-size: clamp(2rem, 4vw, 4rem); }
  .work-card--text .work-desc { max-width: 46ch; }

  @media (min-width: 760px) and (max-width: 1120px) {
    .work-body,
    .work-card--wide .work-body {
      padding: 1.15rem 1.25rem;
    }
  }


  .work-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: calc(14 * var(--ui-u));
    line-height: 1.25;
    margin: 0 0 0.6rem;
    letter-spacing: 0.02em;
  }

  @media (max-width: 759px) {
    .work-title {
      font-size: 1rem;
    }
  }

  @media (min-width: 1100px) {
    .work-title {
      font-size: calc(14.5 * var(--ui-u));
    }
  }

  .work-desc {
    margin: 0;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  /* How projects run: unified specification ledger matching WorkflowStrip. */
  .client-block {
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .client-block .subsection-header {
    margin-top: 0;
  }

  .logistics-ledger {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    padding: 1.5rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 760px) {
    .logistics-ledger {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .logistics-item {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    border-left: 2px solid var(--key-dim);
    padding-left: 1rem;
  }

  .logistics-label {
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .logistics-value {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--ink);
  }

  .work-cta {
    margin-top: clamp(1.75rem, 3.5vw, 2.5rem);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.85rem;
  }

  .work-cta-caption {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--muted);
  }

  .work-press-note {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 0.4rem;
    font-family: var(--font-body);
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--muted);
  }

  .work-press-note a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    min-height: var(--tap-min, 44px);
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: var(--hairline-strong);
    transition: text-decoration-color 0.2s ease;
  }

  .work-press-note a:hover,
  .work-press-note a:focus-visible {
    text-decoration-color: currentColor;
  }
</style>
