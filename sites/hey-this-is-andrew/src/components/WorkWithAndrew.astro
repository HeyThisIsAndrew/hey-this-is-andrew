---
/**
 * WorkWithAndrew: "What I do". Three brand pillar cards on top (Building in
 * Public, Creator and Coffee Drinker, UGC) and the compact photo elevator
 * inline beneath them. Nothing renders beneath the elevator: the services
 * list lives on Work With Me, and the press kit stays at /about/#press.
 *
 * Every back text is existing site copy: the Build in Public page's lede,
 * the About page's description with the site tagline, and the UGC service
 * description from services.json. The UGC back carries its two actions.
 */
import SectionHeader from '@andrew/ui/SectionHeader.astro';
import FlipCard from '@andrew/ui/FlipCard.astro';
import PhotographyPortfolio from './PhotographyPortfolio.astro';
import {
  SERVICES,
  UGC_INQUIRY_HREF,
  COHLEY_PROFILE_URL,
} from '../data/services';

import drinksPourImg from '../assets/ccc/s05-work-drinks-1-pour.jpg';
import desertMarqueeImg from '../assets/ccc/s08-video-desert-2-marquee.jpg';
import workDetailImg from '../assets/ccc/s07-work-detail.jpg';

const ugcService = SERVICES.find((service) => service.title === 'UGC & brand partnerships');

/* Building in Public carries the event marquee, Creator and Coffee
   Drinker the drink pour (Andrew's call, 2026-11-19). */
const pillars = [
  {
    title: 'Building in Public',
    // The Build in Public page (/build/) lede.
    back: 'My goals, and where each of my three brands stands. I check things off here as they happen.',
    image: desertMarqueeImg,
    alt: 'Neon marquee and evening crowd at Desert Escape',
    position: '20% center',
  },
  {
    title: 'Creator and Coffee Drinker',
    // The site tagline, then the About page's description.
    back: 'Creator, Photographer, Coffee Drinker. Building in public and figuring it out as I go.',
    image: drinksPourImg,
    alt: 'Bartender pouring a craft cocktail into a coupe glass',
    position: 'center 40%',
  },
  {
    title: 'UGC',
    back: ugcService?.desc ?? '',
    image: workDetailImg,
    alt: 'Cut crystal bar glassware and spirits bottle in studio lighting',
    position: 'center 72%',
    ugc: true,
  },
];
---
<section id="services" aria-labelledby="services-heading" class="section-hairline work-section">
  <div class="container">
    <SectionHeader id="services-heading" title="What I do" variant="chip" />

    <div class="work-row work-row--top">
      {pillars.map((p, i) => (
        <div class="work-card-wrap reveal" style={`--rd: ${i * 70}ms`}>
          {p.ugc ? (
            <FlipCard
              value={p.title}
              backText={p.back}
              image={p.image}
              imageAlt={p.alt}
              imagePosition={p.position}
              imageSide="front"
              idPrefix="pillar-card"
              index={i}
              class="work-flip-card work-flip-card--action"
            >
              <div slot="back-action" class="flip-action-group">
                <a
                  class="btn btn-primary flip-action-btn font-mono"
                  href={UGC_INQUIRY_HREF}
                  tabindex="-1"
                  aria-hidden="true"
                  data-no-flip
                >
                  Send a product <span aria-hidden="true">&rarr;</span>
                </a>
                <a
                  class="btn btn-secondary flip-action-btn font-mono"
                  href={COHLEY_PROFILE_URL}
                  target="_blank"
                  rel="noopener"
                  tabindex="-1"
                  aria-hidden="true"
                  data-no-flip
                >
                  Cohley profile
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                    <path d="M2 12L12 2M12 2H5M12 2v7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </a>
              </div>
            </FlipCard>
          ) : (
            <FlipCard
              value={p.title}
              backText={p.back}
              image={p.image}
              imageAlt={p.alt}
              imagePosition={p.position}
              imageSide="front"
              idPrefix="pillar-card"
              index={i}
              class="work-flip-card"
            />
          )}
        </div>
      ))}
    </div>

    <div class="work-elevator">
      <PhotographyPortfolio inline />
    </div>
  </div>
</section>

<style>
  .work-section {
    padding-block: clamp(1.25rem, 2.5vw, 2rem);
    margin: 0;
  }

  .work-row {
    --flip-accent-border: var(--hairline-strong);
    --flip-accent-shadow: 0 8px 30px rgb(255 255 255 / 0.1);
    --flip-value-size: clamp(1rem, 1.25vw, 1.45rem);
    --flip-back-size: clamp(0.84rem, 0.92vw, 0.98rem);
    --flip-back-size-mobile: 0.85rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }

  @media (min-width: 760px) {
    .work-row--top {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .work-elevator {
    margin-top: clamp(1rem, 1.8vw, 1.5rem);
  }

  .work-card-wrap {
    display: flex;
    min-width: 0;
    width: 100%;
  }

  .work-card-wrap :global(.stat-card.flip-card) {
    min-height: 155px;
  }

  .work-card-wrap :global(.flip-card-front),
  .work-card-wrap :global(.flip-card-back) {
    padding: clamp(0.85rem, 1.35vw, 1.25rem) clamp(1rem, 1.6vw, 1.4rem);
  }

  @media (min-width: 760px) {
    .work-card-wrap :global(.stat-card.flip-card) {
      min-height: clamp(165px, 12.5vw, 220px);
    }
  }
</style>
