---
/**
 * WorkWithAndrew: "What I do". The service lines live in
 * src/data/services.ts, expanding in-place to the full offering
 * from the former /services/ page.
 */
import SectionHeader from '@andrew/ui/SectionHeader.astro';
import ExpandSection from '@andrew/ui/ExpandSection.astro';
import { SERVICES, SERVICES_LEDE } from '../data/services';

interface Props {
  index?: string;
}
const { index = '05' } = Astro.props;

const rawBase = import.meta.env.BASE_URL;
const base = rawBase === '/' ? '' : rawBase.replace(/\/$/, '');

const previewItems = SERVICES.slice(0, 3);
const restItems = SERVICES.slice(3);
---
<section id="services" aria-labelledby="services-heading" class="work-section">
  <div class="container">
    <SectionHeader
      id="services-heading"
      index={index}
      kicker="Work with Andrew"
      title="What I do"
      lede={SERVICES_LEDE}
    />
    
    <ul class="work-list">
      {previewItems.map((s, i) => (
        <li class="work-item reveal" style={`--rd: ${i * 70}ms`}>
          <h3 class="work-title">{s.title}</h3>
          <p class="work-desc">{s.desc}</p>
        </li>
      ))}
    </ul>
    
    {restItems.length > 0 ? (
      <ExpandSection id="services-expander" expandLabel="Show all services" collapseLabel="Show less">
        <ul class="work-list work-list-extra">
          {restItems.map((s, i) => (
            <li class="work-item reveal">
              <h3 class="work-title">{s.title}</h3>
              <p class="work-desc">{s.desc}</p>
            </li>
          ))}
        </ul>
        <div class="reveal">
          <p class="press-link">
            Press, media, or project inquiry? <a href={`${base}/about/#press`}>Visit the press kit</a>.
          </p>
        </div>
      </ExpandSection>
    ) : (
      <div class="reveal">
        <p class="press-link">
          Press, media, or project inquiry? <a href={`${base}/about/#press`}>Visit the press kit</a>.
        </p>
      </div>
    )}
  </div>
</section>

<style>
  .work-section {
    padding: var(--space-section) 0;
    border-top: 1px solid var(--line);
  }
  .work-list {
    list-style: none;
    margin: 0 0 clamp(2rem, 4vw, 3rem);
    padding: 0;
    display: grid;
    gap: 1.5rem;
  }
  .work-list-extra {
    margin-top: 1.5rem;
  }
  @media (min-width: 760px) {
    .work-list { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  .work-item {
    border: 1px solid var(--line);
    background: var(--surface);
    padding: 1.5rem;
  }
  .work-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.1rem;
    margin: 0 0 0.6rem;
    letter-spacing: 0.02em;
  }
  .work-desc {
    margin: 0;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.6;
  }
  .press-link {
    margin: 1.5rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .press-link a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
