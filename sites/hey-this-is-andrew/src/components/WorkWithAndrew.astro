---
/**
 * WorkWithAndrew: "What I do". The service lines live in
 * src/data/services.ts (currently a DRAFT for Andrew's approval), then the
 * inquiry path. The newsletter signup lives once, in the Writing section
 * (defect 35: the homepage carried two).
 */
import SectionHeader from '@andrew/ui/SectionHeader.astro';
import ViewAllLink from '@andrew/ui/ViewAllLink.astro';
import { SERVICES, SERVICES_LEDE } from '../data/services';

interface Props {
  /** 'home': condensed (titles only) with View all -> /services.
      'page': the full offering, under the archive page's own header. */
  variant?: 'home' | 'page';
  /** Section number on the page that uses it (pages count their own). */
  index?: string;
}
const { variant = 'home', index = '05' } = Astro.props;
const home = variant === 'home';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase === '/' ? '' : rawBase.replace(/\/$/, '');
---

<section id={home ? 'work' : 'services'} aria-labelledby={home ? 'services-heading' : undefined} aria-label={home ? undefined : 'Services'} class:list={['work-section', { 'work-section--page': !home }]}>
  <div class="container">
    {home && (
      <SectionHeader
        id="services-heading"
        index={index}
        kicker="Work with Andrew"
        title="What I do"
        lede={SERVICES_LEDE}
      />
    )}
    <ul class:list={['work-list', { 'work-list--compact': home }]}>
      {SERVICES.map((s, i) => (
        <li class="work-item reveal" style={`--rd: ${i * 70}ms`}>
          <h3 class="work-title">{s.title}</h3>
          {!home && <p class="work-desc">{s.desc}</p>}
        </li>
      ))}
    </ul>
    <div class="reveal" style="--rd: 210ms">
      <p class="press-link">
        Press, media, or project inquiry? <a href={`${base}/press/`}>Visit the press kit</a>.
      </p>
    </div>
    {home && <ViewAllLink href={`${base}/services/`} what="services" />}
  </div>
</section>

<style>
  .work-section {
    /* The site's one section rhythm. */
    padding: var(--space-section) 0;
    border-top: 1px solid var(--line);
  }
  .work-list {
    list-style: none;
    margin: 0 0 clamp(2rem, 4vw, 3rem);
    padding: 0;
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 760px) {
    .work-list { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  .work-section--page {
    border-top: 0;
    padding-top: 0;
  }
  /* Homepage: titles only, a tight list. */
  .work-list--compact {
    gap: 0.75rem;
  }
  .work-list--compact .work-item {
    padding: 1rem 1.25rem;
  }
  .work-list--compact .work-title {
    margin: 0;
    font-size: 1rem;
  }
  .work-item {
    border: 1px solid var(--line);
    background: var(--surface);
    padding: 1.5rem;
  }
  .work-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.1rem;
    margin: 0 0 0.6rem;
    letter-spacing: 0.02em;
  }
  .work-desc {
    margin: 0;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.6;
  }
  .press-link {
    margin: 1.5rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .press-link a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
