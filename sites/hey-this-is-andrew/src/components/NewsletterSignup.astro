---
/**
 * NewsletterSignup — the owned-newsletter on-ramp. Understated by design:
 * notes from the build, what broke, what's next. No hype.
 *
 * Today the signup completes on Substack (real path, see
 * src/lib/newsletter.ts). The form UI stays the same when a direct
 * provider is connected — only NEWSLETTER_PROVIDER changes.
 */
import { NEWSLETTER_PROVIDER, NEWSLETTER_ENDPOINT, SUBSTACK_SUBSCRIBE_URL } from '../lib/newsletter';
---

<div class="newsletter" role="region" aria-labelledby="newsletter-heading">
  <div class="newsletter-copy">
    <h3 class="newsletter-title" id="newsletter-heading">Notes from the build, by email</h3>
    <p class="newsletter-lede">What I'm making, what I'm learning, what broke, what's coming next. Short, occasional, no hype.</p>
  </div>
  <form class="newsletter-form" id="newsletter-form" novalidate>
    <label class="newsletter-label" for="newsletter-email">Email address</label>
    <div class="newsletter-row">
      <input
        class="newsletter-input"
        type="email"
        id="newsletter-email"
        name="email"
        placeholder="you@example.com"
        autocomplete="email"
        required
        aria-describedby="newsletter-note"
      />
      <button class="btn btn-primary newsletter-btn" type="submit">Subscribe</button>
    </div>
    <p class="newsletter-note" id="newsletter-note">Via Substack. Unsubscribe anytime.</p>
    <p class="newsletter-error" id="newsletter-error" role="alert" hidden>Enter a valid email address.</p>
  </form>
</div>

<script define:vars={{ provider: NEWSLETTER_PROVIDER, endpoint: NEWSLETTER_ENDPOINT, subscribeUrl: SUBSTACK_SUBSCRIBE_URL }}>
  /* The signup completes on Substack, as src/lib/newsletter.ts documents:
     the subscribe page opens with the email prefilled. It used to fire a
     no-cors POST at Substack's private API (which cannot carry JSON and
     whose answer the page can never read) and then announce "You're on
     the list" regardless, so a failed signup still looked like success.
     A "direct" provider, once connected, confirms only on a real 2xx. */
  const form = document.getElementById('newsletter-form');
  const input = document.getElementById('newsletter-email');
  const error = document.getElementById('newsletter-error');
  const valid = (v) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v.trim());
  const done = (html) => {
    form.innerHTML = `<div class="newsletter-success" role="status">${html}</div>`;
  };
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = (input.value || '').trim();
    if (!valid(email)) {
      if (error) error.hidden = false;
      input.focus();
      return;
    }
    if (error) error.hidden = true;

    if (provider === 'direct' && endpoint) {
      const btn = form.querySelector('.newsletter-btn');
      if (btn) { btn.disabled = true; btn.textContent = 'Joining...'; }
      try {
        const res = await fetch(endpoint, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email }) });
        if (!res.ok) throw new Error(String(res.status));
        done('<span class="success-icon" aria-hidden="true">✓</span><p class="newsletter-done">You\'re on the list. Check your inbox.</p>');
      } catch {
        if (btn) { btn.disabled = false; btn.textContent = 'Subscribe'; }
        if (error) { error.textContent = 'That did not go through. Please try again.'; error.hidden = false; }
      }
      return;
    }

    // Substack: open its subscribe page (a user gesture, so not blocked);
    // if a blocker stops the new tab, go there in this one.
    const url = `${subscribeUrl}?email=${encodeURIComponent(email)}`;
    // (No 'noopener' feature: with it, window.open always returns null.)
    const tab = window.open(url, '_blank');
    if (tab) tab.opener = null;
    if (!tab) {
      window.location.href = url;
      return;
    }
    done(`<p class="newsletter-done">Almost there: confirm on Substack in the new tab. <a href="${url}" target="_blank" rel="noopener">Open it again</a></p>`);
  });
</script>

<style>
  /* Injected by the script above, so these are global (scoped styles never
     reached them). */
  :global(.newsletter-success) {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    background: var(--surface-2, rgba(255, 255, 255, 0.05));
    border: 1px solid var(--border-active, rgba(255, 255, 255, 0.3));
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.88rem;
    letter-spacing: 0.04em;
    animation: newsletterFadeIn 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  :global(.success-icon) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--ink);
    font-weight: 700;
    font-size: 1.1rem;
  }
  @keyframes newsletterFadeIn {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .newsletter {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    border: 1px solid var(--line);
    background: var(--surface);
    padding: clamp(1.5rem, 4vw, 2.5rem);
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 760px) {
    .newsletter { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: center; }
  }
  .newsletter-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.25rem, 2.6vw, 1.75rem);
    margin: 0 0 0.6rem;
    letter-spacing: 0.01em;
  }
  .newsletter-lede {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.6;
    max-width: 38ch;
  }
  .newsletter-label {
    position: absolute;
    width: 1px; height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .newsletter-row {
    display: flex;
    gap: 0;
  }
  .newsletter-input {
    flex: 1;
    min-width: 0;
    background: var(--bg);
    border: 1px solid var(--line);
    color: var(--ink);
    /* The same height as Subscribe beside it (md). */
    min-height: var(--btn-h-md);
    padding: 0.5rem 1rem;
    font-size: 0.95rem;
    font-family: var(--font-body);
    border-radius: 0;
  }
  .newsletter-input:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: -2px;
  }
  .newsletter-input::placeholder { color: var(--muted); }
  .newsletter-btn { flex: none; border-top-left-radius: 0; border-bottom-left-radius: 0; margin-left: -1px; }
  .newsletter-note {
    margin: 0.6rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .newsletter-error {
    margin: 0.6rem 0 0;
    color: var(--ink);
    font-size: 0.85rem;
  }
  :global(.newsletter-done) {
    margin: 0;
    font-size: 1rem;
    color: var(--ink);
  }
  :global(.newsletter-done a) {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  @media (max-width: 480px) {
    .newsletter-row { flex-direction: column; }
    .newsletter-btn { width: 100%; }
  }
</style>
