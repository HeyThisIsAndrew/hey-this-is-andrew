---
/**
 * Latest archive: videos and writing from the build and across the brands.
 */
import SectionHeader from '@andrew/ui/SectionHeader.astro';
import Accordion from '@andrew/ui/Accordion.astro';
import AccordionRow from '@andrew/ui/AccordionRow.astro';
import FilterTabs from '@andrew/ui/FilterTabs.astro';
import LatestFeed from './LatestFeed.astro';
import { getNetworkFeed } from '../lib/network';
import { SUBSTACK_URL } from '../lib/latest-content';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase === '/' ? '' : rawBase.replace(/\/$/, '');

const allItems = await getNetworkFeed(60);

const previewItems = allItems.slice(0, 3);
const restItems = allItems.slice(3);
---
<section id="latest" aria-labelledby="latest-heading" class="section-hairline latest-section">
  <span id="writing" class="anchor-alias" aria-hidden="true"></span>
  <span id="network" class="anchor-alias" aria-hidden="true"></span>
  <div class="container">
    <SectionHeader id="latest-heading" title="Latest" lede="Recent videos, articles, and dispatches across BE, CCC, and the build." />
    
    <FilterTabs
      target="latest-list"
      label="Filter the latest"
      mode="toggle"
      tabs={[{ key: 'video', label: 'Video' }, { key: 'writing', label: 'Writing' }]}
    />
    
    <div id="latest-list">
      <LatestFeed items={previewItems} id="latest-preview" />

      <div class="latest-accordion-wrapper" data-avoid-fab>
        <Accordion>
          <AccordionRow id="latest-archive" kicker="Archive" title={`All Latest (${restItems.length})`} level={3} size="md">
            <div class="latest-archive-inner">
              <LatestFeed items={restItems} id="latest-rest" />
              <p class="latest-links">
                <a href={SUBSTACK_URL} target="_blank" rel="noopener">Read everything on Substack</a>
                <a href={`${base}/rss.xml`}>RSS feed for the writing</a>
              </p>
            </div>
          </AccordionRow>
        </Accordion>
      </div>

    </div>
  </div>
</section>

<style>
  .latest-section {
    position: relative;
  }
  .anchor-alias {
    position: absolute;
    top: 0;
  }
  .latest-accordion-wrapper {
    margin-top: 2rem;
    border: 1px solid var(--line);
    background: var(--surface);
  }
  .latest-accordion-wrapper :global(.accordion-group) {
    border-top: 0;
    border-bottom: 0;
    background: transparent;
  }
  .latest-accordion-wrapper :global(.accordion-row) {
    background: transparent;
  }
  .latest-archive-inner {
    padding-top: 1.5rem;
  }
  .latest-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    margin: 2rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .latest-links a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: var(--hairline-strong);
  }
</style>
