---
/**
 * The homepage's sections after the hero, in funnel order. The hero is a
 * slot so the hero concepts (/preview/hero-*) render the identical page
 * around a different hero. `skipBrands` drops the brands section when the
 * hero already renders the accordion (concepts A and C).
 */
import PhotographyPortfolio from './PhotographyPortfolio.astro';
import BrandsSection from './BrandsSection.astro';
import WorkWithAndrew from './WorkWithAndrew.astro';
import KitSection from './KitSection.astro';
import NewsletterSection from './NewsletterSection.astro';

interface Props {
  /** Skip the brands section (a hero concept that already renders it). */
  skipBrands?: boolean;
  /** Pull the brands up under a shortened hero (concept D). */
  brandsTight?: boolean;
}
const { skipBrands = false, brandsTight = false } = Astro.props;
---
<slot name="hero" />
{!skipBrands && <BrandsSection tight={brandsTight} />}
<WorkWithAndrew />
<PhotographyPortfolio />
<KitSection />
<NewsletterSection />
