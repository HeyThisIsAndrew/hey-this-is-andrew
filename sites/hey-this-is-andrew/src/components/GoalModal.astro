    outline-offset: 2px;
    border-radius: 0;
  }

  .goal-modal-body {
    flex: 1 1 auto;
    min-block-size: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding-block: clamp(16px, 1.8vw, 22px) clamp(20px, 2.2vw, 28px);
    padding-inline: clamp(18px, 2.2vw, 28px);
    border-radius: 0;
  }

  .goal-modal-panel {
    border-radius: 0;
  }

  .goal-modal-panel[hidden] {
    display: none;
  }

  .checklist-container {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    border-block-start: 1px solid var(--hairline);
    border-radius: 0;
  }

  .checklist-card {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px 20px;
    padding-block: 16px;
    padding-inline: 0;
    border-block-end: 1px solid var(--hairline);
    border-radius: 0;
    min-inline-size: 0;
  }

  .checklist-left {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    flex: 1 1 auto;
    min-inline-size: 0;
  }

  .checklist-mark {
    display: inline-grid;
    place-items: center;
    margin-block-start: 2px;
    inline-size: 18px;
    block-size: 18px;
