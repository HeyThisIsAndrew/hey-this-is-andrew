  }

  .stage-badge {
    flex: 0 0 auto;
    padding-block: 4px;
    padding-inline: 8px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    line-height: 1.25;
    border: 1px solid var(--border);
    border-radius: 0;
    color: var(--muted);
    background: transparent;
    white-space: nowrap;
  }

  .stage-badge.achieved {
    color: var(--ink);
    border-color: var(--hairline-strong);
    background: var(--surface-2);
  }

  .stage-badge.active {
    color: var(--ink);
    border-color: var(--hairline-strong);
    background: var(--surface);
  }

  .stage-body {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-inline-size: 0;
  }

  .stage-name {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 15px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink);
    line-height: 1.3;
    overflow-wrap: break-word;
  }

  .stage-detail {
    margin: 0;
    font-family: var(--font-body);
    font-size: 14px;
    line-height: 1.55;
    color: var(--muted);
    overflow-wrap: break-word;
  }

  .ccc-page-link {
    margin-block: 20px 0;
    margin-inline: 0;
    display: flex;
    flex-wrap: wrap;
  }

  .ccc-page-link :global(.btn) {
    border-radius: 0;
    transition-timing-function: ease-in-out;
  }

  @media (max-width: 540px) {
    .goal-modal {
      inline-size: calc(100vw - 1.5rem);
      max-inline-size: calc(100vw - 1.5rem);
      max-block-size: 88svh;
    }

    .checklist-card {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }

    .status-badge {
      margin-block-start: 0;
      margin-inline-start: calc(18px + 14px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .goal-modal,
    .goal-modal[open],
    .goal-modal[data-closing='true'] {
      transform: none;
      transition-property: opacity, display, overlay;
      transition-duration: 0.12s;
      transition-timing-function: ease-in-out;
      transition-behavior: allow-discrete;
    }

    @starting-style {
      .goal-modal[open] {
        opacity: 0;
        transform: none;
      }
    }

    dialog::backdrop {
      transition-duration: 0.12s;
      transition-timing-function: ease-in-out;
    }

    .goal-modal-close {
      transition: none;
    }
  }
</style>

<script>
  import { createPageScope } from '@andrew/ui/scripts/page-scope.ts';

  function initGoalModal() {
    const dialog = document.querySelector<HTMLDialogElement>('[data-goal-modal]');
    if (!dialog || dialog.dataset.goalModalReady === 'true') return;
    dialog.dataset.goalModalReady = 'true';

    const { on, cleanup, timeout } = createPageScope(dialog);
    const kickerEl = dialog.querySelector<HTMLElement>('[data-goal-modal-kicker]');
    const titleEl = dialog.querySelector<HTMLElement>('[data-goal-modal-title]');
    const progressEl = dialog.querySelector<HTMLElement>('[data-goal-modal-progress]');
    const closeBtn = dialog.querySelector<HTMLButtonElement>('[data-goal-modal-close]');
    const bodyEl = dialog.querySelector<HTMLElement>('[data-goal-modal-body]');
    const panels = Array.from(dialog.querySelectorAll<HTMLElement>('[data-goal-panel]'));
    const triggers = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-goal-trigger]'));

    const supportsDiscreteOverlay =
      typeof CSS !== 'undefined' &&
      typeof CSS.supports === 'function' &&
      CSS.supports('transition-behavior', 'allow-discrete') &&
      CSS.supports('overlay', 'auto');

    const prefersReducedMotion = () =>
      window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let lastTrigger: HTMLElement | null = null;
    let isClosing = false;
    let touchStartY = 0;
    let scrollGuardActive = false;

    const handleWheel = (e: WheelEvent) => {
      if (!dialog.open) return;
      const target = e.target as Node | null;
      if (bodyEl && target && bodyEl.contains(target)) {
        const canScroll = bodyEl.scrollHeight > bodyEl.clientHeight + 1;
        if (!canScroll) {
          e.preventDefault();
          return;
        }
        const atTop = bodyEl.scrollTop <= 0;
        const atBottom = bodyEl.scrollTop + bodyEl.clientHeight >= bodyEl.scrollHeight - 1;
        if ((atTop && e.deltaY < 0) || (atBottom && e.deltaY > 0)) {
          e.preventDefault();
        }
        return;
      }
      e.preventDefault();
    };

    const handleTouchStart = (e: TouchEvent) => {
      if (e.touches.length > 0) {
        touchStartY = e.touches[0].clientY;
      }
    };

    const handleTouchMove = (e: TouchEvent) => {
      if (!dialog.open) return;
      const target = e.target as Node | null;
      if (bodyEl && target && bodyEl.contains(target)) {
        const canScroll = bodyEl.scrollHeight > bodyEl.clientHeight + 1;
        if (!canScroll) {
          e.preventDefault();
          return;
        }
        const currentY = e.touches.length > 0 ? e.touches[0].clientY : touchStartY;
        const deltaY = currentY - touchStartY;
        const atTop = bodyEl.scrollTop <= 0;
        const atBottom = bodyEl.scrollTop + bodyEl.clientHeight >= bodyEl.scrollHeight - 1;
        if ((atTop && deltaY > 0) || (atBottom && deltaY < 0)) {
          e.preventDefault();
        }
        return;
      }
      e.preventDefault();
    };

    const attachScrollGuard = () => {
      if (scrollGuardActive) return;
      scrollGuardActive = true;
      document.addEventListener('wheel', handleWheel, { passive: false });
      document.addEventListener('touchstart', handleTouchStart, { passive: true });
      document.addEventListener('touchmove', handleTouchMove, { passive: false });
    };

    const detachScrollGuard = () => {
      if (!scrollGuardActive) return;
      scrollGuardActive = false;
      document.removeEventListener('wheel', handleWheel);
      document.removeEventListener('touchstart', handleTouchStart);
      document.removeEventListener('touchmove', handleTouchMove);
    };

    cleanup(detachScrollGuard);

    const openModal = (triggerBtn: HTMLButtonElement) => {
      const groupId = triggerBtn.dataset.goalTrigger;
      if (!groupId) return;
      const targetPanel = panels.find((panel) => panel.dataset.goalPanel === groupId);
      if (!targetPanel) return;

      lastTrigger = triggerBtn;
      isClosing = false;
      dialog.removeAttribute('data-closing');

      panels.forEach((panel) => {
        panel.hidden = panel !== targetPanel;
      });

      const kicker = targetPanel.dataset.goalKicker || '';
      if (kickerEl) {
        kickerEl.textContent = kicker;
        kickerEl.hidden = !kicker;
      }
      if (titleEl) {
        titleEl.textContent = targetPanel.dataset.goalTitle || '';
      }
      if (progressEl) {
        progressEl.textContent = targetPanel.dataset.goalProgress || '';
      }

      if (!dialog.open) {
        dialog.showModal();
      }
      if (bodyEl) {
        bodyEl.scrollTop = 0;
      }
      attachScrollGuard();
      dialog.focus({ preventScroll: true });
    };

    const finishClose = () => {
      isClosing = false;
      dialog.removeAttribute('data-closing');
      if (dialog.open) {
        dialog.close();
      }
    };

    const closeModal = () => {
      if (!dialog.open) return;
      if (supportsDiscreteOverlay || prefersReducedMotion()) {
        finishClose();
        return;
      }
      if (isClosing) return;
      isClosing = true;
      dialog.dataset.closing = 'true';

      const animations = typeof dialog.getAnimations === 'function' ? dialog.getAnimations() : [];
      if (animations.length === 0) {
        finishClose();
        return;
      }

      let settled = false;
      const done = () => {
        if (settled) return;
        settled = true;
        finishClose();
      };
      Promise.allSettled(animations.map((anim) => anim.finished)).then(done);
      timeout(done, 280);
    };

    triggers.forEach((btn) => {
      on(btn, 'click', () => {
        openModal(btn);
      });
    });

    if (closeBtn) {
      on(closeBtn, 'click', () => {
        closeModal();
      });
    }

    on(dialog, 'cancel', (e) => {
      if (supportsDiscreteOverlay || prefersReducedMotion()) return;
      e.preventDefault();
      closeModal();
    });

    on(dialog, 'close', () => {
      isClosing = false;
      dialog.removeAttribute('data-closing');
      detachScrollGuard();
      panels.forEach((panel) => {
        panel.hidden = true;
      });
      const triggerToFocus = lastTrigger;
      lastTrigger = null;
      if (triggerToFocus && triggerToFocus.isConnected) {
        triggerToFocus.focus({ preventScroll: true });
      }
    });

    if (!('closedBy' in HTMLDialogElement.prototype)) {
      const isOutside = (e: PointerEvent) => {
        const rect = dialog.getBoundingClientRect();
        return (
          e.clientX < rect.left ||
          e.clientX > rect.right ||
          e.clientY < rect.top ||
          e.clientY > rect.bottom
        );
      };
      let pressedOutside = false;
      on(dialog, 'pointerdown', (e) => {
        pressedOutside = dialog.open && isOutside(e as PointerEvent);
      });
      on(dialog, 'pointerup', (e) => {
        const shouldClose = pressedOutside && dialog.open && isOutside(e as PointerEvent);
        pressedOutside = false;
        if (shouldClose) closeModal();
      });
      on(dialog, 'pointercancel', () => {
        pressedOutside = false;
      });
    }
  }

  initGoalModal();
  document.addEventListener('astro:page-load', initGoalModal);
</script>
