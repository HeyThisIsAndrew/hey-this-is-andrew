---
export type NormalizedStatus = 'done' | 'in-progress' | 'queued';
export type StageStatus = 'achieved' | 'active' | 'upcoming' | 'target';

export interface GoalChecklistItem {
  title: string;
  desc?: string;
  status: NormalizedStatus;
  statusLabel: string;
  milestoneId?: string;
}

export interface GoalStageItem {
  status: StageStatus;
  statusLabel: string;
  name: string;
  detail: string;
}

export type GoalModalGroup =
  | {
      id: string;
      kind: 'checklist';
      title: string;
      kicker?: string;
      progressText: string;
      items: GoalChecklistItem[];
    }
  | {
      id: string;
      kind: 'stages';
      title: string;
      kicker?: string;
      progressText: string;
      stages: GoalStageItem[];
    };

interface Props {
  groups: GoalModalGroup[];
  cccPageHref: string;
}

const { groups, cccPageHref } = Astro.props;
---

<dialog
  id="goal-modal"
  class="goal-modal"
  closedby="any"
  aria-labelledby="goal-modal-title"
  tabindex="-1"
  data-goal-modal
>
  <header class="goal-modal-head">
    <div class="goal-modal-titles">
      <p class="goal-modal-kicker font-mono" data-goal-modal-kicker hidden></p>
      <h2 id="goal-modal-title" class="goal-modal-title" data-goal-modal-title>Goal details</h2>
      <span class="goal-progress font-mono" data-goal-modal-progress></span>
    </div>
    <button
      type="button"
      class="goal-modal-close"
      data-goal-modal-close
      aria-label="Close goal details"
    >&times;</button>
  </header>

  <div class="goal-modal-body" data-goal-modal-body>
    {groups.map((group) => (
      <div
        class="goal-modal-panel"
        data-goal-panel={group.id}
        data-goal-kicker={group.kicker || ''}
        data-goal-title={group.title}
        data-goal-progress={group.progressText}
        hidden
      >
        {group.kind === 'checklist' ? (
          <ul class="checklist-container" role="list">
            {group.items.map((item) => (
              <li
                class:list={['checklist-card', { completed: item.status === 'done' }]}
                data-milestone-card={item.milestoneId || undefined}
              >
                <div class="checklist-left">
                  <span
                    class:list={['checklist-mark', `is-${item.status}`, { 'is-done': item.status === 'done' }]}
                    aria-hidden="true"
                  >
                    {item.status === 'done' && (
                      <svg viewBox="0 0 16 16" width="12" height="12" fill="none">
                        <path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="2" stroke-linecap="square" />
                      </svg>
                    )}
                  </span>
                  <div class="checklist-info">
                    <h3 class="checklist-title">{item.title}</h3>
                    {item.desc && <p class="checklist-desc">{item.desc}</p>}
                  </div>
                </div>
                <span class="status-badge font-mono" data-status={item.status}>{item.statusLabel}</span>
              </li>
            ))}
          </ul>
        ) : (
          <ol class="progression-stages-list" role="list">
            {group.stages.map((stage, index) => (
              <li class="progression-stage-item" data-stage-status={stage.status}>
                <div class="stage-head">
                  <span class="stage-number font-mono">{String(index + 1).padStart(2, '0')}</span>
                  <div class:list={['stage-bar', stage.status]} aria-hidden="true"></div>
                  <span class:list={['stage-badge', 'font-mono', stage.status]}>{stage.statusLabel}</span>
                </div>
                <div class="stage-body">
                  <h3 class="stage-name">{stage.name}</h3>
                  <p class="stage-detail">{stage.detail}</p>
                </div>
              </li>
            ))}
          </ol>
        )}

        {group.id === 'ccc' && (
          <p class="ccc-page-link">
            <a class="btn btn-ghost" href={cccPageHref}>CCC <span aria-hidden="true">&rarr;</span></a>
          </p>
        )}
      </div>
    ))}
  </div>
</dialog>

<style>
  .goal-modal {
    position: fixed;
    inset: 0;
    margin: auto;
    padding: 0;
    inline-size: min(92vw, 720px);
    max-inline-size: calc(100vw - 2rem);
    max-block-size: min(86svh, 760px);
    border: 1px solid var(--hairline-strong);
    border-radius: 0;
    background: var(--surface);
    color: var(--ink);
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.85);
    box-sizing: border-box;
    overflow: hidden;
    opacity: 0;
    transform: translateY(10px);
    transition-property: opacity, transform, display, overlay;
    transition-duration: 0.24s;
    transition-timing-function: ease-in-out;
    transition-behavior: allow-discrete;
  }

  .goal-modal[open] {
    display: flex;
    flex-direction: column;
    opacity: 1;
    transform: translateY(0);
  }

  @starting-style {
    .goal-modal[open] {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  .goal-modal[data-closing='true'] {
    opacity: 0;
    transform: translateY(10px);
  }

  dialog:modal {
    overscroll-behavior: contain;
  }

  .goal-modal:focus {
    outline: none;
  }

  .goal-modal:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
    border-radius: 0;
  }

  dialog::backdrop {
    background: rgb(0 0 0 / 0.84);
    overflow: hidden;
    overscroll-behavior: contain;
    opacity: 0;
    transition-property: opacity, display, overlay;
    transition-duration: 0.24s;
    transition-timing-function: ease-in-out;
    transition-behavior: allow-discrete;
  }

  .goal-modal[open]::backdrop {
    opacity: 1;
  }

  @starting-style {
    .goal-modal[open]::backdrop {
      opacity: 0;
    }
  }

  .goal-modal[data-closing='true']::backdrop {
    opacity: 0;
  }

  .goal-modal-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    padding-block: clamp(18px, 1.8vw, 24px);
    padding-inline: clamp(18px, 2.2vw, 28px);
    border-block-end: 1px solid var(--hairline);
    border-radius: 0;
    background: var(--surface);
    flex: 0 0 auto;
    min-inline-size: 0;
  }

  .goal-modal-titles {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    min-inline-size: 0;
  }

  .goal-modal-kicker {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    line-height: 1.3;
  }

  .goal-modal-kicker[hidden] {
    display: none;
  }

  .goal-modal-title {
    margin: 0;
    font-family: var(--font-display);
