  }

  .checklist-info {
    flex: 1 1 auto;
    min-inline-size: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .checklist-title {
    margin: 0;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 15.5px;
    line-height: 1.42;
    color: var(--ink);
    overflow-wrap: break-word;
