---
/**
 * The homepage Gear spotlight (#gear): the seven gear sections of /gear/
 * (src/data/gear.json), rendered with the shared @andrew/ui SpotlightBar
 * pattern (single-clock progress bar, Prev, Play/Pause, Next). Each slide
 * previews a section with its lead studio photo and links directly to that
 * section on /gear/.
 */
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SpotlightBar, { type SpotlightSlide } from '@andrew/ui/SpotlightBar.astro';
import { gearSectionId } from '../lib/gear-anchor';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase.slice(0, -1) : rawBase;

const photos = import.meta.glob<{ default: ImageMetadata }>('../../public/gear/*.{jpg,jpeg,png,webp}', { eager: true });
const photoFor = (image?: string) => {
  if (!image) return undefined;
  const file = image.replace(/^\/?gear\//, '');
  return Object.entries(photos).find(([key]) => key.endsWith(`/gear/${file}`))?.[1].default;
};

const previewSubtitles: Record<string, string> = {
  bodies: 'Full-frame bodies and phones',
  lighting: 'LED and radio wireless flash',
  audio: 'Mics and monitoring',
  cafe: 'Espresso, pour-over, and nitro',
};
const categories = (await getCollection('gear')).sort((a, b) => a.data.order - b.data.order);
const slides: SpotlightSlide[] = (
  await Promise.all(
    categories.map(async (cat) => {
      const lead = cat.data.items
        .filter((item) => item.stores.length > 0)
        .map((item) => ({ name: item.name, photo: photoFor(item.image) }))
        .find(({ photo }) => photo);
      if (!lead?.photo) return null;
      const hero = await getImage({ src: lead.photo, widths: [480, 800, 1200], format: 'webp' });
      return {
        tag: cat.data.kicker || cat.data.category,
        title: cat.data.category,
        subtitle: previewSubtitles[cat.id] ?? cat.data.subtitle,
        cta: 'Open',
        href: `${base}/gear/#${gearSectionId(cat.id)}`,
        imageSrc: hero.src,
        imageSrcset: hero.srcSet.attribute,
        imageAlt: lead.name,
        imageWidth: lead.photo.width,
        imageHeight: lead.photo.height,
        imageFit: 'contain' as const,
      };
    }),
  )
).filter((s): s is NonNullable<typeof s> => s !== null);
---

<div class="gear-spotlight-wrap" data-gear-carousel>
  <SpotlightBar
    slides={slides}
    label="Gear sections"
    height="clamp(210px, 22vw, 320px)"
    fullBleed={true}
    actionLabel="See all gear"
    actionHref={`${base}/gear/`}
  />
</div>

<style>
  .gear-spotlight-wrap {
    width: 100%;
  }
</style>
