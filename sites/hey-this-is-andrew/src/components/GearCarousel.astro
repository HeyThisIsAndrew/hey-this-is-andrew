---
/**
 * The homepage Gear carousel (#gear): the seven gear sections of /gear/
 * (src/data/gear.json), one card in view at a time, in the /gear/ page's
 * order. Each card is a whole section: its lead photo, kicker, name,
 * subtitle and piece count, and a strip of the other pieces in it. The card
 * in view is the link; it opens that section on /gear/ (GearGrid opens the
 * section a link names).
 *
 * Named tabs above the card say what is in it and which section is showing.
 * Swipe on touch (native scroll with snap, one card per swipe), mouse drag,
 * a trackpad or Shift+wheel swipe, the Prev and Next arrows, a tab, or the
 * arrow keys all move it, and it stays where they put it: it advances on
 * its own only until the reader touches it, and never while hovered,
 * focused, off screen, in a background tab or under reduced motion.
 *
 * Photos come from public/gear/ through Astro's image pipeline (WebP at the
 * size each slot needs), not the full-size JPGs /gear/ shows.
 */
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { gearSectionId, gearChipLabel } from '../lib/gear-anchor';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase.slice(0, -1) : rawBase;

const photos = import.meta.glob<{ default: ImageMetadata }>('../../public/gear/*.{jpg,jpeg,png,webp}', { eager: true });
const photoFor = (image?: string) => {
  if (!image) return undefined;
  const file = image.replace(/^\/?gear\//, '');
  return Object.entries(photos).find(([key]) => key.endsWith(`/gear/${file}`))?.[1].default;
};

const THUMBS = 4;
const categories = (await getCollection('gear')).sort((a, b) => a.data.order - b.data.order);
const sections = (
  await Promise.all(
    categories.map(async (cat) => {
      // What /gear/ shows: items with a store link.
      const shown = cat.data.items.filter((it) => it.stores.length > 0);
      const withPhoto = shown.map((it) => ({ it, photo: photoFor(it.image) })).filter((x) => x.photo);
      if (!shown.length || !withPhoto.length) return null;
      const lead = withPhoto[0];
      const hero = await getImage({ src: lead.photo!, widths: [480, 800, 1200], format: 'webp' });
      const thumbs = await Promise.all(
        withPhoto.slice(1, 1 + THUMBS).map(async ({ it, photo }) => ({
          name: it.name,
          src: (await getImage({ src: photo!, width: 128, format: 'webp' })).src,
        }))
      );
      return {
        id: cat.id,
        chip: gearChipLabel(cat.id, cat.data.category),
        title: cat.data.category,
        kicker: cat.data.kicker || '',
        subtitle: cat.data.subtitle || '',
        count: shown.length,
        more: Math.max(0, shown.length - 1 - thumbs.length),
        hero: { src: hero.src, srcset: hero.srcSet.attribute, alt: lead.it.name },
        thumbs,
        href: `${base}/gear/#${gearSectionId(cat.id)}`,
      };
    })
  )
).filter((s): s is NonNullable<typeof s> => s !== null);
const n = sections.length;
const pad = (v: number) => String(v).padStart(2, '0');
---
<div class="gear-carousel" data-gear-carousel role="region" aria-roledescription="carousel" aria-label="Gear sections">
  <div class="gc-tabs" role="group" aria-label="Choose a gear section">
    {sections.map((s, i) => (
      <button type="button" class:list={['gc-tab', 'font-mono', { 'is-active': i === 0 }]} data-gc-tab={i} aria-current={i === 0 ? 'true' : undefined}>
        {s.chip}
      </button>
    ))}
  </div>

  <ul class="gc-track" data-gc-track>
    {sections.map((s, i) => (
      <li class="gc-slide" role="group" aria-roledescription="slide" aria-label={`${i + 1} of ${n}: ${s.title}`}>
        <a class="gc-card" href={s.href} draggable="false" tabindex={i === 0 ? undefined : '-1'}>
          <span class="gc-media">
            <img src={s.hero.src} srcset={s.hero.srcset} sizes="(max-width: 720px) 92vw, 55vw" alt={s.hero.alt} width="1200" height="900" loading="lazy" decoding="async" draggable="false" />
          </span>
          <span class="gc-body">
            <span class="gc-kicker font-mono">{s.kicker}</span>
            <span class="gc-title display">{s.title}</span>
            {s.subtitle && <span class="gc-subtitle">{s.subtitle}</span>}
            <span class="gc-count font-mono">{s.count} {s.count === 1 ? 'piece' : 'pieces'}</span>
            {s.thumbs.length > 0 && (
              <span class="gc-strip" aria-hidden="true">
                {s.thumbs.map((t) => (
                  <img src={t.src} alt="" width="64" height="64" loading="lazy" decoding="async" draggable="false" />
                ))}
                {s.more > 0 && <span class="gc-more font-mono">+{s.more}</span>}
              </span>
            )}
            <span class="gc-go font-mono">
              Open {s.chip}
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M2 12L12 2M12 2H5M12 2v7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </span>
        </a>
      </li>
    ))}
  </ul>

  <div class="gc-controls">
    <button type="button" class="gc-step" data-gc-prev aria-label="Previous gear section">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="square" aria-hidden="true"><polyline points="15 18 9 12 15 6"></polyline></svg>
    </button>
    <span class="gc-counter font-mono" data-gc-counter aria-hidden="true">{pad(1)} / {pad(n)}</span>
    <button type="button" class="gc-step" data-gc-next aria-label="Next gear section">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="square" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>
    </button>
  </div>
</div>

<style>
  .gear-carousel {
    margin-top: 2.5rem;
  }

  /* The section tabs: every section by name, the current one filled. They
     wrap on a phone rather than scroll, so all seven are always in sight. */
  .gc-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  .gc-tab {
    min-height: 44px;
    padding: 0 1rem;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.18);
    color: var(--muted);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    transition: color 0.25s ease, border-color 0.25s ease, background-color 0.25s ease;
  }
  .gc-tab:hover {
    color: var(--ink);
    border-color: rgba(255, 255, 255, 0.5);
  }
  .gc-tab.is-active {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--bg, #000);
  }

  .gc-track {
    position: relative;
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    border: 1px solid var(--line);
    background: var(--surface);
  }
  .gc-track::-webkit-scrollbar {
    display: none;
  }
  .gc-track.is-dragging {
    scroll-snap-type: none;
    cursor: grabbing;
  }
  .gc-slide {
    flex: 0 0 100%;
    min-width: 0;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }
  .gc-card {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    min-height: clamp(300px, 30vw, 420px);
    color: var(--ink);
    text-decoration: none;
    -webkit-user-select: none;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }
  .gc-card:focus-visible {
    outline-offset: -3px;
  }
  .gc-media {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(1rem, 3vw, 2rem);
    /* The gear photos are shot on this same near-black. */
    background: #0d0d0d;
    border-right: 1px solid var(--line);
    overflow: hidden;
  }
  .gc-media img {
    display: block;
    width: 100%;
    height: 100%;
    max-height: 340px;
    object-fit: contain;
    -webkit-user-drag: none;
    transition: transform 1.4s ease;
  }
  .gc-body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 0.6rem;
    min-width: 0;
    padding: clamp(1.25rem, 3vw, 2.5rem);
  }
  .gc-kicker,
  .gc-count {
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .gc-title {
    font-size: clamp(1.8rem, 3.6vw, 2.8rem);
    line-height: 1;
    overflow-wrap: anywhere;
  }
  .gc-subtitle {
    color: var(--muted);
    max-width: 40ch;
  }
  .gc-strip {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.4rem;
  }
  .gc-strip img {
    width: 48px;
    height: 48px;
    padding: 3px;
    object-fit: contain;
    background: #0d0d0d;
    border: 1px solid var(--line);
    -webkit-user-drag: none;
  }
  .gc-more {
    display: grid;
    place-items: center;
    min-width: 48px;
    height: 48px;
    padding: 0 0.4rem;
    border: 1px solid var(--line);
    font-size: 0.72rem;
    color: var(--muted);
  }
  .gc-go {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    margin-top: 0.4rem;
    padding: 0 1rem;
    border: 1px solid rgba(255, 255, 255, 0.35);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition: background-color 0.25s ease, color 0.25s ease, border-color 0.25s ease;
  }
  @media (hover: hover) {
    .gc-card:hover .gc-media img {
      transform: scale(1.04);
    }
    .gc-card:hover .gc-go {
      background: var(--ink);
      border-color: var(--ink);
      color: var(--bg, #000);
    }
  }

  .gc-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }
  .gc-step {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.16);
    color: var(--ink);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }
  .gc-step:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.45);
  }
  .gc-counter {
    min-width: 5.5em;
    text-align: center;
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    color: var(--muted);
  }

  @media (max-width: 720px) {
    .gc-tab {
      flex: 1 1 auto;
      padding: 0 0.75rem;
    }
    .gc-card {
      grid-template-columns: minmax(0, 1fr);
      min-height: 0;
    }
    .gc-media {
      aspect-ratio: 4 / 3;
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }
    .gc-media img {
      max-height: none;
    }
    .gc-title {
      font-size: clamp(1.6rem, 8vw, 2.2rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gc-media img,
    .gc-go,
    .gc-tab,
    .gc-step {
      transition: none;
    }
  }
</style>

<script>
  const AUTO_MS = 7000;

  function initGearCarousels() {
    document.querySelectorAll<HTMLElement>('[data-gear-carousel]').forEach((root) => {
      if (root.dataset.ready === '1') return;
      root.dataset.ready = '1';
      const track = root.querySelector<HTMLElement>('[data-gc-track]');
      if (!track) return;
      const slides = Array.from(track.querySelectorAll<HTMLElement>('.gc-slide'));
      const links = slides.map((s) => s.querySelector<HTMLAnchorElement>('.gc-card'));
      const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-gc-tab]'));
      const counter = root.querySelector<HTMLElement>('[data-gc-counter]');
      const n = slides.length;
      if (n < 2) return;
      const pad = (v: number) => String(v).padStart(2, '0');
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

      let current = 0;
      /** The index a programmatic scroll is heading to; scroll positions on
       *  the way there do not move the tabs. */
      let heading: number | null = null;

      const mark = (i: number) => {
        current = i;
        tabs.forEach((t, k) => {
          t.classList.toggle('is-active', k === i);
          if (k === i) t.setAttribute('aria-current', 'true');
          else t.removeAttribute('aria-current');
        });
        links.forEach((a, k) => {
          if (!a) return;
          if (k === i) a.removeAttribute('tabindex');
          else a.tabIndex = -1;
        });
        if (counter) counter.textContent = `${pad(i + 1)} / ${pad(n)}`;
      };
      const leftOf = (i: number) => slides[i].offsetLeft;
      const indexFromScroll = () => Math.max(0, Math.min(n - 1, Math.round(track.scrollLeft / Math.max(1, track.clientWidth))));

      const go = (i: number) => {
        const to = (i + n) % n;
        heading = to;
        mark(to);
        track.scrollTo({ left: leftOf(to), behavior: reduced.matches ? 'auto' : 'smooth' });
      };

      // Auto-advance, until the reader takes over.
      let userTook = false;
      let inView = false;
      let hovering = false;
      let focused = false;
      let timer = 0;
      const sync = () => {
        const run = !userTook && inView && !hovering && !focused && !document.hidden && !reduced.matches;
        if (run && !timer) timer = window.setInterval(() => go(current + 1), AUTO_MS);
        else if (!run && timer) {
          window.clearInterval(timer);
          timer = 0;
        }
      };
      const takeOver = () => {
        heading = null;
        if (userTook) return;
        userTook = true;
        sync();
      };

      // The tabs follow the reader's own swipe or scroll as it happens.
      let raf = 0;
      track.addEventListener('scroll', () => {
        if (raf) return;
        raf = requestAnimationFrame(() => {
          raf = 0;
          if (heading !== null) {
            if (Math.abs(track.scrollLeft - leftOf(heading)) < 2) heading = null;
            return;
          }
          const i = indexFromScroll();
          if (i !== current) mark(i);
        });
      }, { passive: true });

      root.querySelector('[data-gc-prev]')?.addEventListener('click', () => {
        takeOver();
        go(current - 1);
      });
      root.querySelector('[data-gc-next]')?.addEventListener('click', () => {
        takeOver();
        go(current + 1);
      });
      tabs.forEach((tab, i) => tab.addEventListener('click', () => {
        takeOver();
        go(i);
      }));
      root.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
        e.preventDefault();
        takeOver();
        go(current + (e.key === 'ArrowRight' ? 1 : -1));
        const onTab = (e.target as HTMLElement).closest('[data-gc-tab]');
        (onTab ? tabs[current] : links[current])?.focus({ preventScroll: true });
      });

      // Any hand on it, before a click lands: a touch or a press.
      root.addEventListener('pointerdown', takeOver);
      track.addEventListener('touchstart', takeOver, { passive: true });

      // A horizontal wheel or trackpad swipe (Shift+wheel included) moves one
      // card per gesture. Left to native snap, a short swipe settled back on
      // the card it started from; the momentum tail is ignored until the
      // wheel goes quiet, so one swipe never skips two.
      let wheelAcc = 0;
      let wheelLocked = false;
      let wheelQuiet = 0;
      track.addEventListener('wheel', (e) => {
        const dx = e.shiftKey && !e.deltaX ? e.deltaY : e.deltaX;
        if (Math.abs(dx) <= Math.abs(e.shiftKey ? 0 : e.deltaY)) return;
        e.preventDefault();
        takeOver();
        window.clearTimeout(wheelQuiet);
        wheelQuiet = window.setTimeout(() => {
          wheelLocked = false;
          wheelAcc = 0;
        }, 220);
        if (wheelLocked) return;
        wheelAcc += dx;
        if (Math.abs(wheelAcc) < 40) return;
        wheelLocked = true;
        go(Math.max(0, Math.min(n - 1, current + (wheelAcc > 0 ? 1 : -1))));
        wheelAcc = 0;
      }, { passive: false });

      // Mouse drag (touch and trackpads scroll natively). Snap is off while
      // the card follows the pointer, then the release settles on the next
      // card in the drag's direction, or back where it started.
      const DRAG_START = 6;
      const SWIPE = 50;
      let pressX = 0;
      let pressLeft = 0;
      let pressIndex = 0;
      let pressed = false;
      let dragged = false;
      track.addEventListener('pointerdown', (e) => {
        if (e.pointerType !== 'mouse' || e.button !== 0) return;
        pressed = true;
        dragged = false;
        pressX = e.clientX;
        pressLeft = track.scrollLeft;
        pressIndex = current;
      });
      track.addEventListener('pointermove', (e) => {
        if (!pressed) return;
        const dx = e.clientX - pressX;
        if (!dragged) {
          if (Math.abs(dx) < DRAG_START) return;
          dragged = true;
          track.classList.add('is-dragging');
          try {
            track.setPointerCapture(e.pointerId);
          } catch {
            /* the release below still ends it */
          }
        }
        track.scrollLeft = pressLeft - dx;
      });
      const release = (e: PointerEvent) => {
        if (!pressed) return;
        pressed = false;
        if (!dragged) return;
        const dx = e.clientX - pressX;
        track.classList.remove('is-dragging');
        const to = dx <= -SWIPE ? pressIndex + 1 : dx >= SWIPE ? pressIndex - 1 : pressIndex;
        go(Math.max(0, Math.min(n - 1, to)));
      };
      track.addEventListener('pointerup', release);
      track.addEventListener('pointercancel', release);
      // A drag is not a tap on the card under it.
      track.addEventListener('click', (e) => {
        if (!dragged) return;
        dragged = false;
        e.preventDefault();
        e.stopPropagation();
      }, true);

      root.addEventListener('mouseenter', () => { hovering = true; sync(); });
      root.addEventListener('mouseleave', () => { hovering = false; sync(); });
      root.addEventListener('focusin', () => { focused = true; sync(); });
      root.addEventListener('focusout', (e) => {
        if (!root.contains(e.relatedTarget as Node | null)) {
          focused = false;
          sync();
        }
      });
      document.addEventListener('visibilitychange', sync);
      reduced.addEventListener?.('change', sync);
      new IntersectionObserver((entries) => {
        inView = entries.some((en) => en.isIntersecting);
        sync();
      }, { threshold: 0.5 }).observe(root);

      // A resize keeps the current card in place.
      window.addEventListener('resize', () => {
        heading = null;
        track.scrollLeft = leftOf(current);
      }, { passive: true });

      mark(indexFromScroll());
    });
  }

  initGearCarousels();
  document.addEventListener('astro:page-load', initGearCarousels);
</script>
