---
/**
 * /gear: the whole kit as one gallery. Every category is its own expanded,
 * full-width panel, one after another: the category heading, then its
 * products in a grid. No accordion, no deck, no view toggle (2026-11-19:
 * the show-all view, organised by category, is the only view).
 *
 * The cinematic language is the BE Unconventional HQ /featured page's,
 * translated to a catalogue: sharp corners, product imagery full-bleed on
 * its own dark ground, an ambient glow behind each panel (a blurred copy of
 * the panel's first photo washed in that photo's accent, sampled at build
 * time in src/lib/gear-accent.ts), and HQ's locked hover: the image scales
 * to 1.03 over 0.8s cubic-bezier(0.25, 1, 0.5, 1), the accent tint behind
 * it rises from 0.75 to 1, the border glows and a shadow lifts the card.
 * Tags are frosted (backdrop blur 8px).
 *
 * Search and the category select filter the cards across every panel; a
 * panel with no matching card hides. The count is the number of cards
 * showing.
 *
 * Data: src/data/gear.json. An item with no store link is owned but not
 * shown. An item whose image file is missing renders a typographic tile
 * rather than a wrong or broken picture.
 */
import fs from 'node:fs';
import path from 'node:path';
import type { CollectionEntry } from 'astro:content';
import { AMAZON_STOREFRONT } from '../data/storefront';
import { sampleAccent, NEUTRAL_ACCENT } from '../lib/gear-accent';
import { gearItemId, gearSectionId, gearChipLabel } from '../lib/gear-anchor';

interface Props {
  categories: CollectionEntry<'gear'>[];
}

const { categories } = Astro.props;

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase.slice(0, -1) : rawBase;
const publicDir = path.resolve(process.cwd(), 'public');

/** The public URL of an image, or '' when the file is not there. */
const imageUrl = (img?: string) => {
  if (!img) return '';
  if (/^https?:\/\//.test(img)) return img;
  const clean = img.startsWith('/') ? img : `/${img}`;
  return fs.existsSync(path.join(publicDir, clean)) ? `${base}${clean}` : '';
};

// Section DOM ids and chip names: src/lib/gear-anchor.ts (shared with the
// homepage Gear carousel, which links to these sections).

interface Store {
  store: string;
  url: string;
  affiliate?: boolean;
}

const sections = await Promise.all(
  [...categories]
    .sort((a, b) => a.data.order - b.data.order)
    .map(async (cat) => {
      const items = await Promise.all(
        cat.data.items
          .filter((it) => it.stores.length > 0)
          .map(async (it) => {
            const src = imageUrl(it.image);
            const accent = src && it.image ? await sampleAccent(path.join(publicDir, it.image)) : NEUTRAL_ACCENT;
            const stores = it.stores as Store[];
            return {
              ...it,
              short: it.shortName || it.name,
              src,
              accent,
              stores,
              search: [it.name, it.shortName, it.brand, it.tag, it.spec, cat.data.category, it.recommended ? 'recommended' : '', ...stores.map((s) => s.store)]
                .filter(Boolean)
                .join(' ')
                .toLowerCase(),
            };
          })
      );
      return {
        slug: cat.id,
        domId: gearSectionId(cat.id),
        chip: gearChipLabel(cat.id, cat.data.category),
        chipKey: cat.id === 'bodies' ? 'cameras' : cat.id === 'tools' ? 'support' : cat.id,
        title: cat.data.category,
        kicker: cat.data.kicker || '',
        subtitle: cat.data.subtitle || '',
        collectionUrl: cat.data.collectionUrl || AMAZON_STOREFRONT,
        collectionLabel: cat.data.collectionUrl ? cat.data.collectionLabel || 'Amazon list' : 'Storefront',
        items,
      };
    })
).then((all) => all.filter((s) => s.items.length > 0));

const ctaLabel = (s: Store) => `View on ${s.store}`;
const totalItems = sections.reduce((total, sec) => total + sec.items.length, 0);
const countLabel = (n: number) => `${n} ${n === 1 ? 'product' : 'products'}`;
---

<div class="gear-monolith" id="gear-monolith">
  <div class="gear-filter-toolbar" role="search" aria-label="Filter gear">
    <div class="gear-search-wrap">
      <svg class="gear-search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input
        type="search"
        id="gear-search-input"
        class="gear-search-input font-mono"
        placeholder="Filter gear (Sony, 90mm, Amaran, Ascaso, tripod)"
        aria-label="Search gear"
        autocomplete="off"
      />
      <button type="button" id="gear-search-clear" class="gear-search-clear" aria-label="Clear search" hidden>×</button>
    </div>
    <div class="gear-category-select-wrap">
      <label for="gear-category-select" class="vh">Filter by category</label>
      <select id="gear-category-select" class="gear-category-select font-mono" aria-label="Filter by category">
        <option value="">All categories</option>
        {sections.map((sec) => (
          <option value={sec.chipKey}>{sec.chip}</option>
        ))}
      </select>
      <svg class="gear-select-arrow" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="6 9 12 15 18 9"></polyline>
      </svg>
    </div>
    <span class="gear-count font-mono" data-grid-count aria-live="polite">{countLabel(totalItems)}</span>
  </div>

  <div id="gear-empty-state" class="gear-empty-state" hidden>
    <p class="gear-empty-text">No gear matches that search.</p>
    <button type="button" id="gear-reset-btn" class="gear-reset-btn font-mono">Reset filter</button>
  </div>

  <div class="gear-panels" id="gear-panels">
    {sections.map((sec, secIdx) => {
      const lead = sec.items.find((it) => it.src);
      return (
        <section
          class="gear-panel"
          id={sec.domId}
          data-category={sec.slug}
          data-chip={sec.chipKey}
          data-pn-entry
          data-pn-label={sec.title}
          data-sec-head
          aria-labelledby={`gear-heading-${sec.slug}`}
          style={`--accent: ${(lead ?? sec.items[0]).accent};${lead ? ` --glow-img: url('${lead.src}');` : ''}`}
        >
          <div class="gear-panel-glow" aria-hidden="true"></div>
          <div class="gear-panel-inner">
            <header class="gear-panel-head">
              <div class="gear-panel-titles">
                {sec.kicker && <span class="gear-panel-kicker font-mono">{sec.kicker}</span>}
                <h2 class="gear-panel-title" id={`gear-heading-${sec.slug}`}>{sec.title}</h2>
                {sec.subtitle && <p class="gear-panel-subtitle font-mono">{sec.subtitle}</p>}
              </div>
              <a href={sec.collectionUrl} target="_blank" rel="noopener sponsored" class="influencer-pill font-mono">
                <span class="influencer-text">{sec.collectionLabel.replace(/ list$/i, '')}{/ list$/i.test(sec.collectionLabel) && <span class="influencer-text-long"> list</span>}</span>
                <svg width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                  <path d="M2.5 9.5L9.5 2.5M9.5 2.5H4.5M9.5 2.5V7.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            </header>

            <div class="gear-cards">
              {sec.items.map((it, i) => (
                <article
                  class="gear-card"
                  id={gearItemId(it.name)}
                  data-search={it.search}
                  style={`--accent: ${it.accent};`}
                >
                  <div class="gear-card-visual">
                    <span class="gear-card-tint" aria-hidden="true"></span>
                    {it.src ? (
                      <img
                        src={it.src}
                        alt={it.name}
                        class="gear-card-img"
                        loading={secIdx === 0 && i < 4 ? 'eager' : 'lazy'}
                        decoding="async"
                        draggable="false"
                      />
                    ) : (
                      <span class="gear-card-type" role="img" aria-label={it.name}>{it.short}</span>
                    )}
                    <span class="gear-card-tag font-mono">{it.tag || it.brand}</span>
                  </div>
                  <div class="gear-card-body">
                    <h3 class="gear-card-name">{it.name}</h3>
                    <p class="gear-card-spec">{it.spec}</p>
                    <div class="gear-card-links">
                      {it.stores.map((s, si) => (
                        <a
                          href={s.url}
                          target="_blank"
                          rel="noopener sponsored"
                          class:list={['gear-card-cta', 'font-mono', { 'is-primary': si === 0 }]}
                        >
                          {ctaLabel(s)}
                        </a>
                      ))}
                      {it.video && (
                        <a class="gear-card-cta gear-card-video font-mono" href={it.video.url} target="_blank" rel="noopener sponsored">
                          {it.video.label}
                        </a>
                      )}
                    </div>
                  </div>
                </article>
              ))}
            </div>
          </div>
        </section>
      );
    })}
  </div>
</div>

<style>
  .gear-monolith :is(button, a) {
    -webkit-tap-highlight-color: transparent;
  }

  /* ------------------------------------------------------------------
     Toolbar: one tight, left-aligned row (search, category, count).
     ------------------------------------------------------------------ */
  .gear-filter-toolbar {
    width: min(100% - clamp(2rem, 4vw, 5rem), var(--maxw));
    margin: 0 auto clamp(1.75rem, 3vw, 2.75rem);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-start;
    gap: 0.75rem;
  }
  .gear-search-wrap {
    position: relative;
    display: flex;
    align-items: center;
    flex: 0 1 380px;
    min-width: 0;
  }
  .gear-search-icon {
    position: absolute;
    left: 1rem;
    color: var(--muted, #888);
    pointer-events: none;
  }
  .gear-search-input {
    width: 100%;
    min-height: 44px;
    height: 44px;
    box-sizing: border-box;
    padding: 0.7rem 2.75rem;
    background: #0d0d0d;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 0;
    color: #fff;
    font-size: 0.8rem;
    letter-spacing: 0.04em;
  }
  .gear-search-input:focus {
    outline: none;
    border-color: #fff;
  }
  .gear-search-clear {
    position: absolute;
    right: 0;
    width: 44px;
    height: 44px;
    background: none;
    border: none;
    color: var(--muted, #888);
    font-size: 1.25rem;
    cursor: pointer;
  }
  .gear-search-clear:hover {
    color: #fff;
  }
  .gear-category-select-wrap {
    position: relative;
    display: inline-flex;
    align-items: center;
    flex: 0 0 220px;
    max-width: 100%;
  }
  .gear-category-select {
    appearance: none;
    -webkit-appearance: none;
    width: 100%;
    min-height: 44px;
    height: 44px;
    padding: 0.4rem 2.2rem 0.4rem 0.85rem;
    background: #000000;
    border: 1px solid #ffffff;
    color: #ffffff;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    box-sizing: border-box;
    border-radius: 0;
    color-scheme: dark;
    transition: background 0.2s ease-in-out, color 0.2s ease-in-out, border-color 0.2s ease-in-out;
  }
  .gear-category-select:is(:hover, :focus-visible) {
    background: #ffffff;
    color: #000000;
    border-color: #ffffff;
    outline: none;
  }
  .gear-category-select option {
    background: #000000;
    color: #ffffff;
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }
  .gear-select-arrow {
    position: absolute;
    right: 0.85rem;
    pointer-events: none;
    color: #ffffff;
    transition: color 0.2s ease-in-out;
  }
  .gear-category-select-wrap:hover .gear-select-arrow,
  .gear-category-select:focus-visible + .gear-select-arrow {
    color: #000000;
  }
  .gear-count {
    flex: 0 0 auto;
    margin-left: 0.5rem;
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted, #888);
  }
  @media (max-width: 600px) {
    .gear-search-wrap {
      flex: 1 1 100%;
    }
    .gear-category-select-wrap {
      flex: 1 1 0;
      min-width: 0;
    }
    .gear-count {
      margin-left: 0.25rem;
    }
  }

  .gear-empty-state {
    width: min(100% - clamp(2rem, 4vw, 5rem), var(--maxw));
    margin: 0 auto 2rem;
    padding: 3rem 1rem;
    text-align: center;
    border: 1px dashed rgba(255, 255, 255, 0.16);
  }
  .gear-empty-state[hidden] {
    display: none;
  }
  .gear-empty-text {
    color: var(--muted, #888);
    margin: 0 0 1rem;
  }
  .gear-reset-btn {
    min-height: 44px;
    padding: 0.5rem 1rem;
    background: #fff;
    color: #000;
    border: none;
    border-radius: 0;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
  }

  /* ------------------------------------------------------------------
     Panels: one full-width cinematic panel per category, all expanded.
     ------------------------------------------------------------------ */
  .gear-panel {
    position: relative;
    isolation: isolate;
    overflow: clip;
    padding-block: clamp(3.5rem, 7vw, 7rem);
    background: #050505;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    scroll-margin-top: calc(var(--gear-nav-h, 88px) + 0.5rem);
  }
  .gear-panel[hidden] {
    display: none;
  }
  /* HQ ambient glow: a blurred copy of the panel's lead photo, washed in
     its accent, fading out toward the edges. No scrim over the cards. */
  .gear-panel-glow {
    position: absolute;
    inset: -10%;
    z-index: -1;
    pointer-events: none;
    background-image:
      radial-gradient(ellipse 46% 52% at 30% 38%, rgba(var(--accent), 0.55), rgba(var(--accent), 0) 72%),
      var(--glow-img, none);
    background-size: cover, 52% auto;
    background-position: center, 30% 38%;
    background-repeat: no-repeat;
    filter: blur(120px) saturate(1.5);
    opacity: 0.6;
    -webkit-mask-image: radial-gradient(circle at 30% 40%, #000 0%, transparent 70%);
    mask-image: radial-gradient(circle at 30% 40%, #000 0%, transparent 70%);
  }
  .gear-panel-inner {
    width: min(100% - clamp(2rem, 4vw, 5rem), var(--maxw));
    margin-inline: auto;
  }
  .gear-panel-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding-bottom: clamp(1.25rem, 2vw, 1.75rem);
    margin-bottom: clamp(1.75rem, 3vw, 2.75rem);
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }
  .gear-panel-titles {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    min-width: 0;
  }
  .gear-panel-kicker,
  .gear-panel-subtitle {
    font-size: 0.68rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted, #9a9a95);
    margin: 0;
  }
  .gear-panel-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 4.6vw, 4.25rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: #fff;
    overflow-wrap: break-word;
  }
  .influencer-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    padding: 0.4rem 0.85rem;
    background: rgba(10, 10, 10, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 0;
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    color: #fff;
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }
  .influencer-pill:is(:hover, :focus-visible) {
    background: #fff;
    color: #000;
    border-color: #fff;
  }

  /* ------------------------------------------------------------------
     Cards: product imagery full-bleed on its own dark ground.
     ------------------------------------------------------------------ */
  .gear-cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(0.75rem, 1.4vw, 1.25rem);
  }
  @media (min-width: 900px) {
    .gear-cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (min-width: 1200px) {
    .gear-cards {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .gear-card {
    --hover-ease: cubic-bezier(0.25, 1, 0.5, 1);
    position: relative;
    min-width: 0;
    display: flex;
    flex-direction: column;
    background: #0d0d0d;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 0;
    overflow-wrap: anywhere;
    scroll-margin-top: calc(var(--gear-nav-h, 88px) + 1rem);
    transition:
      border-color 0.8s var(--hover-ease),
      box-shadow 0.8s var(--hover-ease);
  }
  .gear-card[hidden] {
    display: none;
  }
  .gear-card-visual {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: #0d0d0d;
  }
  .gear-card-img {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.8s var(--hover-ease);
  }
  /* The accent tint: present at 0.75, full on hover. */
  .gear-card-tint {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background: radial-gradient(ellipse 70% 60% at 50% 60%, rgba(var(--accent), 0.26), rgba(var(--accent), 0) 72%);
    mix-blend-mode: screen;
    opacity: 0.75;
    transition: opacity 0.8s var(--hover-ease);
  }
  .gear-card-type {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: grid;
    place-items: center;
    padding: 1rem;
    font-family: var(--font-display);
    font-size: clamp(1rem, 1.6vw, 1.5rem);
    font-weight: 800;
    text-transform: uppercase;
    text-align: center;
    color: #fff;
  }
  .gear-card-tag {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 3;
    max-width: calc(100% - 1.5rem);
    box-sizing: border-box;
    padding: 0.35rem 0.6rem;
    background: rgba(10, 10, 10, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-left: 2px solid #f0f0f0;
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    color: rgba(255, 255, 255, 0.92);
    font-size: 0.6rem;
    letter-spacing: 0.16em;
    line-height: 1.2;
    text-transform: uppercase;
  }
  .gear-card-body {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    flex: 1;
    min-width: 0;
    padding: 1.1rem 1.15rem 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }
  .gear-card-name {
    margin: 0;
    font-size: 1rem;
    line-height: 1.3;
    color: #fff;
  }
  .gear-card-spec {
    margin: 0 0 0.75rem;
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--muted, #888);
  }
  .gear-card-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: auto;
  }
  .gear-card-cta {
    max-width: 100%;
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.4rem 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 0;
    color: #fff;
    font-size: 0.64rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: normal;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }
  .gear-card-cta.is-primary {
    background: #fff;
    color: #000;
    border-color: #fff;
  }
  .gear-card-cta:is(:hover, :focus-visible) {
    background: #dcdcdc;
    color: #000;
    border-color: #dcdcdc;
  }

  /* HQ's locked cinematic hover. */
  @media (hover: hover) and (pointer: fine) {
    .gear-card:hover {
      border-color: rgba(var(--accent), 0.7);
      box-shadow:
        0 22px 50px rgba(0, 0, 0, 0.6),
        0 0 34px rgba(var(--accent), 0.28);
    }
    .gear-card:hover .gear-card-img {
      transform: scale(1.03);
    }
    .gear-card:hover .gear-card-tint {
      opacity: 1;
    }
  }
  .gear-card:focus-within {
    border-color: rgba(var(--accent), 0.7);
  }

  @media (max-width: 599px) {
    .gear-cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.6rem;
    }
    .gear-card-visual {
      aspect-ratio: 1 / 1;
    }
    .gear-card-tag {
      top: 0.5rem;
      left: 0.5rem;
      max-width: calc(100% - 1rem);
      font-size: 0.52rem;
      letter-spacing: 0.12em;
    }
    .gear-card-body {
      padding: 0.75rem 0.7rem 0.85rem;
    }
    .gear-card-name {
      font-size: 0.85rem;
    }
    .gear-card-spec {
      font-size: 0.72rem;
    }
    .gear-card-cta {
      width: 100%;
      justify-content: center;
      text-align: center;
      padding: 0.4rem 0.5rem;
      font-size: 0.58rem;
    }
    .influencer-text-long {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gear-card,
    .gear-card-img,
    .gear-card-tint {
      transition: none;
    }
    .gear-card:hover .gear-card-img {
      transform: none;
    }
  }
</style>

<script>
  import { createPageScope } from '@andrew/ui/scripts/page-scope.ts';
  (() => {
    function setNavHeight() {
      const nav = document.querySelector<HTMLElement>('.site-nav');
      const h = nav ? Math.round(nav.getBoundingClientRect().height) : 0;
      if (h > 0) document.documentElement.style.setProperty('--gear-nav-h', `${h}px`);
    }

    function init() {
      const root = document.getElementById('gear-panels');
      if (!root || root.dataset.gearWired === '1') return;
      root.dataset.gearWired = '1';
      const { on } = createPageScope(root);
      setNavHeight();
      on(window, 'resize', setNavHeight, { passive: true });

      const panels = Array.from(root.querySelectorAll<HTMLElement>('.gear-panel'));
      const input = document.getElementById('gear-search-input') as HTMLInputElement | null;
      const clear = document.getElementById('gear-search-clear') as HTMLButtonElement | null;
      const empty = document.getElementById('gear-empty-state');
      const reset = document.getElementById('gear-reset-btn');
      const select = document.getElementById('gear-category-select') as HTMLSelectElement | null;
      const count = document.querySelector<HTMLElement>('[data-grid-count]');
      let cat = '';
      let query = '';

      // Search and category: a card shows when it matches both; a panel
      // with no card showing hides; the count is the cards showing.
      function apply() {
        let total = 0;
        panels.forEach((panel) => {
          const inCat = !cat || panel.dataset.chip === cat;
          let shown = 0;
          panel.querySelectorAll<HTMLElement>('.gear-card').forEach((card) => {
            const match = inCat && (!query || (card.dataset.search || '').includes(query));
            card.hidden = !match;
            if (match) shown += 1;
          });
          panel.hidden = shown === 0;
          total += shown;
        });
        if (count) count.textContent = `${total} ${total === 1 ? 'product' : 'products'}`;
        if (empty) empty.hidden = total > 0;
        if (clear) clear.hidden = !query;
      }

      const resetAll = () => {
        if (input) input.value = '';
        if (select) select.value = '';
        query = '';
        cat = '';
        apply();
      };

      select?.addEventListener('change', () => {
        cat = select.value;
        apply();
      });
      input?.addEventListener('input', () => {
        query = input.value.trim().toLowerCase();
        apply();
      });
      clear?.addEventListener('click', () => {
        if (input) input.value = '';
        query = '';
        apply();
        input?.focus();
      });
      reset?.addEventListener('click', resetAll);

      // A link to a section (#gear-lenses, #brew) or to one item
      // (#gear-item-..., what the homepage Gear carousel links to) clears a
      // filter that hides it, so the layout's anchor scroll finds it.
      const reveal = (hash: string) => {
        if (!hash || hash.length < 2) return;
        let id = hash.slice(1);
        try {
          id = decodeURIComponent(id);
        } catch {
          return;
        }
        const el = document.getElementById(id);
        if (!el || !root.contains(el)) return;
        if (el.hidden || el.closest<HTMLElement>('.gear-panel')?.hidden) resetAll();
      };
      reveal(location.hash);
      on(window, 'hashchange', () => reveal(location.hash));
      on(document, 'click', (e) => {
        const link = (e.target as Element | null)?.closest?.('a[href*="#"]') as HTMLAnchorElement | null;
        if (!link) return;
        const url = new URL(link.href, location.href);
        if (url.pathname.replace(/\/$/, '') !== location.pathname.replace(/\/$/, '')) return;
        reveal(url.hash);
      }, { capture: true });
    }

    init();
    document.addEventListener('astro:page-load', init);
  })();
</script>
