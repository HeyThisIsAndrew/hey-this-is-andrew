---
/** The personal kit deck uses the HQ featured layout with a single category in view. */
import Disclosure from '@andrew/ui/Disclosure.astro';
import fs from 'node:fs';
import path from 'node:path';
import type { CollectionEntry } from 'astro:content';
import { AMAZON_STOREFRONT } from '../data/storefront';
import { gearItemId, gearSectionId, gearChipLabel } from '../lib/gear-anchor';

interface Props {
  categories: CollectionEntry<'gear'>[];
}

const { categories } = Astro.props;

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase.slice(0, -1) : rawBase;
const publicDir = path.resolve(process.cwd(), 'public');

/** The public URL of an image, or '' when the file is not there. */
const imageUrl = (img?: string) => {
  if (!img) return '';
  if (/^https?:\/\//.test(img)) return img;
  const clean = img.startsWith('/') ? img : `/${img}`;
  return fs.existsSync(path.join(publicDir, clean)) ? `${base}${clean}` : '';
};

// Section DOM ids and chip names: src/lib/gear-anchor.ts (shared with the
// homepage Gear carousel, which links to these sections).

interface Store {
  store: string;
  url: string;
  affiliate?: boolean;
}

const sections = [...categories]
  .sort((a, b) => a.data.order - b.data.order)
  .map((cat) => ({
    slug: cat.id,
    domId: gearSectionId(cat.id),
    chip: gearChipLabel(cat.id, cat.data.category),
    chipKey: cat.id === 'bodies' ? 'cameras' : cat.id === 'tools' ? 'support' : cat.id,
    title: cat.data.category,
    kicker: cat.data.kicker || '',
    subtitle: cat.data.subtitle || '',
    collectionUrl: cat.data.collectionUrl || AMAZON_STOREFRONT,
    collectionLabel: cat.data.collectionUrl ? cat.data.collectionLabel || 'Amazon list' : 'Storefront',
    items: cat.data.items.filter((it) => it.stores.length > 0).map((it) => ({
      ...it,
      short: it.shortName || it.name,
      src: imageUrl(it.image),
      search: [
        it.name, it.shortName, it.brand, it.tag, it.spec, cat.data.category,
        it.recommended ? 'recommended' : '', ...it.stores.map((store) => store.store),
      ].filter(Boolean).join(' ').toLowerCase(),
    })),
  }))
  .filter((section) => section.items.length > 0);

const ctaLabel = (s: Store) => `View on ${s.store}`;
/** Positions in the deck, as the HQ deck names them. */
const stateOf = (i: number, n: number) =>
  i === 0 ? 'active' : i === 1 ? 'next-1' : i === 2 ? 'next-2' : i === n - 1 && n > 3 ? 'prev' : 'hidden';
---

<div class="gear-monolith" id="gear-monolith">
  <div class="gear-filter-toolbar" role="search" aria-label="Filter gear">
    <div class="gear-search-wrap">
      <svg class="gear-search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input
        type="search"
        id="gear-search-input"
        class="gear-search-input font-mono"
        placeholder="Filter gear (Sony, 90mm, Amaran, Ascaso, tripod)"
        aria-label="Search gear"
        autocomplete="off"
      />
      <button type="button" id="gear-search-clear" class="gear-search-clear" aria-label="Clear search" hidden>×</button>
    </div>
    <div class="gear-category-select-wrap">
      <label for="gear-category-select" class="vh">Filter by category</label>
      <select id="gear-category-select" class="gear-category-select font-mono" aria-label="Filter by category">
        <option value="">All categories</option>
        {sections.map((sec) => (
          <option value={sec.chipKey}>{sec.chip}</option>
        ))}
      </select>
      <svg class="gear-select-arrow" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="6 9 12 15 18 9"></polyline>
      </svg>
    </div>
    <button type="button" class="btn-all-toggle font-mono" data-all-toggle aria-expanded="false" aria-controls="gear-all-products">Show all products</button>
  </div>

  <div id="gear-empty-state" class="gear-empty-state" hidden>
    <p class="gear-empty-text">No gear matches that search.</p>
    <button type="button" id="gear-reset-btn" class="gear-reset-btn font-mono">Reset filter</button>
  </div>

  <Disclosure class="gear-all-grid-view" id="gear-all-products" hiddenWhenClosed labelledby="gear-all-title">
    <div class="gear-all-grid-content">
      <div class="all-grid-topbar">
        <h2 class="all-grid-title" id="gear-all-title">All products</h2>
        <span class="font-mono" data-grid-count aria-live="polite">{sections.reduce((total, sec) => total + sec.items.length, 0)} products</span>
      </div>
      <div class="all-grid-cards">
        {sections.flatMap((sec) => sec.items.map((it) => (
          <article class="all-grid-card" data-search={it.search} data-chip={sec.chipKey}>
            <div class="all-card-img-wrap">
              {it.src ? (
                <img src={it.src} alt={it.name} class="all-card-img" loading="lazy" decoding="async" />
              ) : (
                <span class="all-card-type" role="img" aria-label={it.name}>{it.short}</span>
              )}
            </div>
            <div class="all-card-body">
              <span class="all-card-tag font-mono">{it.tag || it.brand}</span>
              {it.recommended && <span class="all-card-tag font-mono">Recommended</span>}
              <h3 class="all-card-name">{it.name}</h3>
              <p class="all-card-spec">{it.spec}</p>
              <div class="all-card-links">
                {it.stores.map((s, si) => (
                  <a
                    href={s.url}
                    target="_blank"
                    rel="noopener sponsored"
                    class={`all-card-cta font-mono ${si === 0 ? 'is-primary' : ''}`}
                  >
                    {ctaLabel(s)}
                  </a>
                ))}
              </div>
            </div>
          </article>
        )))}
      </div>
    </div>
  </Disclosure>

  <Disclosure id="gear-decks-view" open hiddenWhenClosed>
  <div class="gear-accordion-container" id="gear-accordion-container">
    {sections.map((sec, secIdx) => {
      const open = secIdx === 0;
      const n = sec.items.length;
      return (
        <section
          class={`gear-accordion-section ${open ? 'is-expanded' : 'is-collapsed'}`}
          id={sec.domId}
          hidden={!open}
          data-category={sec.slug}
          data-chip={sec.chipKey}
          data-sec-head
        >
          <div class="gear-accordion-header-bar">
            <h2 class="gear-accordion-heading">
              <span class="box-idx font-mono">{sec.kicker}</span>
              <span class="box-title">{sec.title}</span>
              <span class="box-subtitle font-mono">{sec.subtitle}</span>
            </h2>
            <div class="gear-header-right btn-group btn-group--row">
              <a href={sec.collectionUrl} target="_blank" rel="noopener sponsored" class="influencer-pill font-mono">
                <span class="influencer-text">{sec.collectionLabel.replace(/ list$/i, '')}{/ list$/i.test(sec.collectionLabel) && <span class="influencer-text-long"> list</span>}</span>
                <svg width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                  <path d="M2.5 9.5L9.5 2.5M9.5 2.5H4.5M9.5 2.5V7.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            </div>
          </div>

          <div class="gear-accordion-body">
            <div class="gear-deck" data-deck={sec.slug}>
              <div class="deck-glow" aria-hidden="true">
                {sec.items.map((it, i) => (
                  <div
                    class={`deck-glow-layer ${i === 0 ? 'active' : ''}`}
                    data-glow-src={it.src || undefined}
                    style={i === 0 && it.src ? `--glow-img: url('${it.src}');` : undefined}
                  ></div>
                ))}
              </div>

              <div
                class="deck-stage"
                data-deck-stage={sec.slug}
                role="group"
                aria-roledescription="carousel"
                aria-label={`${sec.title}: ${n} items`}
              >
                {sec.items.map((it, i) => (
                  <article
                    class={`deck-card ${stateOf(i, n)}`}
                    id={gearItemId(it.name)}
                    data-index={i}
                    data-search={it.search}
                    aria-hidden={i === 0 ? 'false' : 'true'}
                    aria-label={it.name}
                  >
                    {it.src && (
                      <img
                        class="card-img"
                        src={it.src}
                        alt={it.name}
                        loading={secIdx === 0 && i < 3 ? 'eager' : 'lazy'}
                        decoding="async"
                        draggable="false"
                      />
                    )}
                    <div class="card-mark" aria-hidden="true">{it.brand || sec.title}</div>
                    {it.recommended && <span class="reco-badge font-mono">Recommended</span>}
                    <div class="card-caption">
                      <h3 class="card-title font-mono">{it.name}</h3>
                      {it.tag && <span class="card-tagline font-mono" aria-hidden="true"> · {it.tag}</span>}
                    </div>
                    <button
                      type="button"
                      class="card-open font-mono"
                      data-gear-open
                      aria-label={`Open ${it.name}`}
                      aria-expanded="false"
                      aria-controls={`${gearItemId(it.name)}-details`}
                      tabindex={i === 0 ? undefined : '-1'}
                    >
                      <span>Open</span>
                      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                        <path d="m3 5 4 4 4-4" stroke="currentColor" stroke-width="1.5"/>
                      </svg>
                    </button>
                  </article>
                ))}
              </div>

              <div class="deck-rail" role="group" aria-label={`${sec.title} item navigation`}>
                <button type="button" class="deck-step deck-step--prev" data-deck-prev aria-label={`Previous ${sec.title} item`}>
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="square" aria-hidden="true"><polyline points="15 18 9 12 15 6"></polyline></svg>
                </button>
                <div class="deck-thumb-track" role="tablist" aria-label={`${sec.title} items`}>
                  {sec.items.map((it, i) => (
                    <button
                      type="button"
                      class={`deck-thumb-tile ${i === 0 ? 'is-active' : ''}`}
                      role="tab"
                      aria-selected={i === 0 ? 'true' : 'false'}
                      aria-label={it.name}
                      data-index={i}
                    >
                      <span class="thumb-tile-img-box">
                        {it.src ? (
                          <img src={it.src} alt="" aria-hidden="true" class="thumb-tile-img" loading="lazy" decoding="async" draggable="false" />
                        ) : (
                          <span class="thumb-tile-fallback font-mono">{it.brand}</span>
                        )}
                      </span>
                    </button>
                  ))}
                </div>
                <button type="button" class="deck-step deck-step--next" data-deck-next aria-label={`Next ${sec.title} item`}>
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="square" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>
                </button>
              </div>

              {sec.items.map((it) => {
                  const primary = it.stores[0];
                  const extraAffiliates = it.stores.filter((s) => s.affiliate).map((s) => s.store);
                  // The Amazon line covers Amazon links only (James Coffee Co.
                  // links to its own shop and carries no disclosure).
                  const hasAmazon = it.stores.some((s) => s.store === 'Amazon');
                  return (
                    <Disclosure
                      class="card-details"
                      id={`${gearItemId(it.name)}-details`}
                      labelledby={`${gearItemId(it.name)}-title`}
                      tabindex="-1"
                      hiddenWhenClosed
                    >
                      <div class="card-plate">
                        <h4 class="card-detail-title" id={`${gearItemId(it.name)}-title`}>{it.name}</h4>
                        <div class="card-tags font-mono">
                          <span>{it.brand}</span>
                          {it.tag && <span>{it.tag}</span>}
                        </div>
                        <p class="card-spec">{it.spec}</p>
                        <div class="card-actions">
                          <a
                            class="store-cta font-mono"
                            href={primary.url}
                            target="_blank"
                            rel="noopener sponsored"
                            data-store-cta
                          >
                            <span data-store-cta-label>{ctaLabel(primary)}</span>
                            <svg width="13" height="13" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                              <path d="M2.5 11.5L11.5 2.5M11.5 2.5H5.5M11.5 2.5V8.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                          </a>
                          {it.stores.length > 1 && (
                            <div class="store-picker" role="radiogroup" aria-label={`Store for ${it.short}`}>
                              {it.stores.map((s, si) => (
                                <button
                                  type="button"
                                  class="store-option font-mono"
                                  role="radio"
                                  aria-checked={si === 0 ? 'true' : 'false'}
                                  data-store-url={s.url}
                                  data-store-label={ctaLabel(s)}
                                  tabindex={si === 0 ? undefined : '-1'}
                                >
                                  {s.store}
                                </button>
                              ))}
                            </div>
                          )}
                          {it.video && (
                            <a
                              class="video-link font-mono"
                              href={it.video.url}
                              target="_blank"
                              rel="noopener sponsored"
                            >
                              {it.video.label}
                            </a>
                          )}
                        </div>
                        {(hasAmazon || extraAffiliates.length > 0) && (
                          <p class="card-disclosure font-mono">
                            {hasAmazon && 'As an Amazon Associate, I earn from qualifying purchases.'}
                            {extraAffiliates.length > 0 && ` The ${extraAffiliates.join(' and ')} link is an affiliate link${hasAmazon ? ' too' : ''}.`}
                          </p>
                        )}
                      </div>
                    </Disclosure>
                  );
              })}
            </div>
          </div>
        </section>
      );
    })}
  </div>
  </Disclosure>
</div>

<style>
  /* ------------------------------------------------------------------
     Toolbar
     ------------------------------------------------------------------ */
  .gear-filter-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.7rem;
  }
  .gear-search-wrap {
    position: relative;
    display: flex;
    align-items: center;
    flex: 1 1 280px;
    max-width: 480px;
  }
  .gear-search-icon {
    position: absolute;
    left: 1rem;
    color: var(--muted, #888);
    pointer-events: none;
  }
  .gear-search-input {
    width: 100%;
    min-height: 44px;
    padding: 0.7rem 2.75rem;
    background: #0d0d0d;
    border: 1px solid rgba(255, 255, 255, 0.16);
    color: #fff;
    font-size: 0.8rem;
    letter-spacing: 0.04em;
  }
  .gear-search-input:focus {
    outline: none;
    border-color: #fff;
  }
  .gear-search-clear {
    position: absolute;
    right: 0;
    width: 44px;
    height: 44px;
    background: none;
    border: none;
    color: var(--muted, #888);
    font-size: 1.25rem;
    cursor: pointer;
  }
  .gear-search-clear:hover {
    color: #fff;
  }
  .gear-category-select-wrap {
    position: relative;
    display: inline-flex;
    align-items: center;
    width: 220px;
    max-width: 100%;
  }
  .gear-category-select {
    appearance: none;
    -webkit-appearance: none;
    width: 100%;
    min-height: 44px;
    height: 44px;
    padding: 0.4rem 2.2rem 0.4rem 0.85rem;
    background: #000000;
    border: 1px solid #ffffff;
    color: #ffffff;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    box-sizing: border-box;
    border-radius: 0;
    color-scheme: dark;
    transition: background 0.2s ease-in-out, color 0.2s ease-in-out, border-color 0.2s ease-in-out;
  }
  .gear-category-select:is(:hover, :focus-visible) {
    background: #ffffff;
    color: #000000;
    border-color: #ffffff;
    outline: none;
  }
  .gear-category-select option {
    background: #000000;
    color: #ffffff;
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }
  .gear-select-arrow {
    position: absolute;
    right: 0.85rem;
    pointer-events: none;
    color: #ffffff;
    transition: color 0.2s ease-in-out;
  }
  .gear-category-select-wrap:hover .gear-select-arrow,
  .gear-category-select:focus-visible + .gear-select-arrow {
    color: #000000;
  }
  @media (max-width: 768px) {
    .gear-filter-toolbar {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .gear-search-wrap {
      grid-column: 1 / -1;
      max-width: none;
    }
    .gear-category-select-wrap,
    .btn-all-toggle {
      width: 100%;
      min-width: 0;
    }
    .btn-all-toggle {
      justify-content: center;
    }
  }
  .gear-empty-state {
    padding: 3rem 1rem;
    text-align: center;
    border: 1px dashed rgba(255, 255, 255, 0.16);
  }
  .gear-empty-text {
    color: var(--muted, #888);
    margin: 0 0 1rem;
  }
  .gear-reset-btn {
    min-height: 44px;
    padding: 0.5rem 1rem;
    background: #fff;
    color: #000;
    border: none;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .gear-accordion-section {
    padding: 0;
    scroll-margin-top: calc(var(--gear-nav-h, 88px) + 0.5rem);
  }
  .gear-accordion-header-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-bottom: 0.5rem;
  }
  .gear-accordion-heading {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    min-width: 0;
    margin: 0;
  }
  .box-idx,
  .box-subtitle {
    color: var(--muted);
    font-weight: 400;
    font-size: 0.67rem;
  }
  .box-idx {
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .box-title {
    color: #fff;
    font: 800 clamp(1.05rem, 1.9vw, 1.4rem) / 1.15 var(--font-display);
  }
  .gear-header-right {
    flex: none;
  }
  :global(#site) .gear-monolith .gear-header-right {
    margin-inline: 0;
  }
  .influencer-pill,
  .btn-all-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    padding: 0.4rem 0.75rem;
    background: #000;
    border: 1px solid #fff;
    color: #fff;
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }
  .influencer-pill:hover,
  .btn-all-toggle:hover {
    background: #fff;
    color: #000;
    border-color: #fff;
  }
  :global(#site) .gear-monolith :is(.influencer-pill, .btn-all-toggle, .store-cta, .all-card-cta) {
    padding-inline: 0.75rem;
    font: 600 0.68rem / 1.15 var(--font-mono);
    letter-spacing: 0.08em;
  }
  :global(#site) .gear-monolith :is(.influencer-pill, .btn-all-toggle, .store-cta, .all-card-cta, .deck-step):not(:is(:hover, :focus-visible)) {
    background: #000;
  }
  .gear-deck {
    --stage-h: clamp(360px, calc(100svh - var(--gear-nav-h, 70px) - 210px), 760px);
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    isolation: isolate;
    overflow: clip;
  }
  .deck-glow {
    position: absolute;
    inset: 0;
    overflow: clip;
    pointer-events: none;
  }
  .deck-glow-layer {
    position: absolute;
    inset: 0;
    background: var(--glow-img, none) center / cover no-repeat;
    transform: scale(1.14);
    filter: blur(72px);
    opacity: 0;
    transition: opacity 0.65s ease-in-out;
  }
  .deck-glow-layer.active {
    opacity: 0.46;
  }
  .gear-monolith :is(button, a) {
    -webkit-tap-highlight-color: transparent;
  }

  .deck-stage {
    --peek: clamp(20px, 4.3vw, 60px);
    --card-w: 100%;
    position: relative;
    z-index: 1;
    width: 100%;
    height: var(--stage-h);
    touch-action: pan-y;
    user-select: none;
    overflow: clip;
  }
  .deck-stage:has(.deck-card.next-1) {
    --card-w: calc(100% - var(--peek));
  }
  .deck-stage:has(.deck-card.next-2) {
    --card-w: calc(100% - 2 * var(--peek));
  }
  .deck-stage.is-dragging .deck-card {
    transition: none;
  }

  .deck-card {
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--card-w);
    overflow: hidden;
    border-radius: 0;
    background: #121212;
    box-shadow: 0 12px 42px rgb(0 0 0 / 70%);
    transform-origin: center;
    transition: transform 0.5s ease-in-out, opacity 0.5s ease-in-out, translate 0.5s ease-in-out;
    cursor: pointer;
  }
  .deck-card.active {
    z-index: 3;
    transform: none;
    opacity: 1;
    cursor: auto;
  }
  .deck-card.next-1 {
    z-index: 2;
    transform: translateX(var(--peek)) scaleY(0.92);
    opacity: 0.8;
  }
  .deck-card.next-2 {
    z-index: 1;
    transform: translateX(calc(2 * var(--peek))) scaleY(0.84);
    opacity: 0.5;
  }
  .deck-card:is(.next-1, .next-2) {
    outline: 1px solid rgb(255 255 255 / 24%);
    outline-offset: -1px;
  }
  .deck-card:is(.next-1, .next-2):hover {
    opacity: 1;
  }
  .deck-card:is(.hidden, .prev) {
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
  }
  .deck-card.is-filtered-out {
    display: none;
  }
  .card-img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 46%;
