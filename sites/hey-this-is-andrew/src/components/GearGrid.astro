</style>

<script>
  import { setDisclosureOpen } from '@andrew/ui/scripts/disclosure.ts';
  import { createPageScope } from '@andrew/ui/scripts/page-scope.ts';
  (() => {
    function setNavHeight() {
      const nav = document.querySelector<HTMLElement>('.site-nav');
      const h = nav ? Math.round(nav.getBoundingClientRect().height) : 0;
      if (h > 0) document.documentElement.style.setProperty('--gear-nav-h', `${h}px`);
    }

    function init() {
      const root = document.getElementById('gear-accordion-container');
      if (!root || root.dataset.gearWired === '1') return;
      root.dataset.gearWired = '1';
      const { on, cleanup } = createPageScope(root);
      setNavHeight();
      on(window, 'resize', setNavHeight, { passive: true });

      const sections = Array.from(root.querySelectorAll<HTMLElement>('.gear-accordion-section'));
      const decks = new Map<HTMLElement, {
        refresh: () => void;
        show: (index: number) => void;
        closeDetails: () => void;
        filter: (query: string) => number;
      }>();
      let currentSection: HTMLElement | undefined = sections[0];

      function showSection(section?: HTMLElement) {
        if (currentSection && currentSection !== section) decks.get(currentSection)?.closeDetails();
        currentSection = section;
        sections.forEach((candidate) => {
          const open = candidate === section;
          candidate.hidden = !open;
          candidate.classList.toggle('is-expanded', open);
          candidate.classList.toggle('is-collapsed', !open);
          candidate.classList.toggle('is-settled', open);
        });
        if (section) decks.get(section)?.refresh();
      }

      sections.forEach((section) => {
        const stage = section.querySelector<HTMLElement>('.deck-stage');
        const cards = Array.from(section.querySelectorAll<HTMLElement>('.deck-card'));
        const thumbs = Array.from(section.querySelectorAll<HTMLElement>('.deck-thumb-tile'));
        const glows = Array.from(section.querySelectorAll<HTMLElement>('.deck-glow-layer'));
        const details = Array.from(section.querySelectorAll<HTMLElement>('.card-details'));
        const openers = Array.from(section.querySelectorAll<HTMLButtonElement>('[data-gear-open]'));
        const deck = section.querySelector<HTMLElement>('.gear-deck');
        if (!stage || !cards.length) return;

        let active = 0;
        let visible = cards.map((_, i) => i);
        let openDetails: number | null = null;
        const prev = section.querySelector<HTMLButtonElement>('[data-deck-prev]');
        const next = section.querySelector<HTMLButtonElement>('[data-deck-next]');

        function closeDetails() {
          if (openDetails === null) return;
          openers[openDetails]?.setAttribute('aria-expanded', 'false');
          const panel = details[openDetails];
          if (panel?.contains(document.activeElement)) openers[openDetails]?.focus({ preventScroll: true });
          if (panel) void setDisclosureOpen(panel, false);
          openDetails = null;
        }

        openers.forEach((button, index) => {
          button.addEventListener('click', async () => {
            const wasOpen = openDetails === index;
            closeDetails();
            const panel = details[index];
            if (wasOpen || !panel) return;
            openDetails = index;
            button.setAttribute('aria-expanded', 'true');
            if (await setDisclosureOpen(panel, true)) {
              panel.focus({ preventScroll: true });
              panel.scrollIntoView({ block: 'nearest' });
            }
          });
        });

        function render(focusThumb = false) {
          if (!visible.includes(active)) active = visible[0] ?? 0;
          if (openDetails !== null && openDetails !== active) closeDetails();
          const pos = visible.indexOf(active);
          const count = visible.length;
          if (prev) prev.disabled = count < 2;
          if (next) next.disabled = count < 2;
          const at = (k: number) => visible[(pos + k + count) % count];
          const n1 = count > 1 ? at(1) : -1;
          const n2 = count > 2 ? at(2) : -1;
          const pv = count > 3 ? at(-1) : -1;

          cards.forEach((card, i) => {
            const shown = visible.includes(i);
            card.classList.toggle('is-filtered-out', !shown);
            card.classList.remove('active', 'next-1', 'next-2', 'prev', 'hidden');
            card.classList.add(i === active ? 'active' : i === n1 ? 'next-1' : i === n2 ? 'next-2' : i === pv ? 'prev' : 'hidden');
            const isActive = i === active;
            card.setAttribute('aria-hidden', String(!isActive));
            openers[i]?.setAttribute('tabindex', isActive ? '0' : '-1');
          });

          thumbs.forEach((t, i) => {
            const isActive = i === active;
            t.classList.toggle('is-filtered-out', !visible.includes(i));
            t.classList.toggle('is-active', isActive);
            t.setAttribute('aria-selected', String(isActive));
            t.tabIndex = isActive ? 0 : -1;
          });
          glows.forEach((g, i) => {
            const isActive = i === active;
            g.classList.toggle('active', isActive);
            if (isActive && g.dataset.glowSrc && !g.style.getPropertyValue('--glow-img')) {
              g.style.setProperty('--glow-img', `url('${g.dataset.glowSrc}')`);
            }
          });

          const thumb = thumbs[active];
          const track = thumb?.parentElement;
          if (thumb && track && track.scrollWidth > track.clientWidth) {
            track.scrollTo({ left: thumb.offsetLeft - track.clientWidth / 2 + thumb.offsetWidth / 2, behavior: 'smooth' });
          }
          if (focusThumb) thumb?.focus({ preventScroll: true });
        }

        const go = (index: number, focusThumb = false) => {
          if (index === active || !visible.includes(index)) return;
          const focusOpener = openers[active] === document.activeElement || details[active]?.contains(document.activeElement);
          active = index;
          render(focusThumb);
          if (focusOpener) openers[active]?.focus({ preventScroll: true });
        };
        const step = (dir: 1 | -1, focusThumb = false) => {
          if (visible.length < 2) return;
          const pos = visible.indexOf(active);
          go(visible[(pos + dir + visible.length) % visible.length], focusThumb);
        };

        decks.set(section, {
          refresh: render,
          show: go,
          closeDetails,
          filter: (query) => {
            visible = cards
              .map((card, index) => ({ card, index }))
              .filter(({ card }) => !query || (card.dataset.search || '').includes(query))
              .map(({ index }) => index);
            if (visible.length) render();
            return visible.length;
          },
        });

        // Thumbnails and peeking cards bring an item forward.
        thumbs.forEach((t, i) => t.addEventListener('click', () => go(i)));

        // Item navigation (inside the deck, not the section header).
        prev?.addEventListener('click', () => step(-1));
        next?.addEventListener('click', () => step(1));

        // Keyboard: arrows anywhere in the deck rotate it.
        deck?.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && openDetails !== null) {
            e.preventDefault();
            closeDetails();
            return;
          }
          if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
          const onThumb = (e.target as HTMLElement).closest('.deck-thumb-tile');
          if ((e.target as HTMLElement).closest('.store-picker')) return; // radios own their arrows
          e.preventDefault();
          step(e.key === 'ArrowRight' ? 1 : -1, Boolean(onThumb));
        });

        // Store picker: choosing a store re-points the one primary CTA.
        details.forEach((panel) => {
          const cta = panel.querySelector<HTMLAnchorElement>('[data-store-cta]');
          const label = panel.querySelector<HTMLElement>('[data-store-cta-label]');
          const options = Array.from(panel.querySelectorAll<HTMLButtonElement>('.store-option'));
          const choose = (opt: HTMLButtonElement, focus = false) => {
            options.forEach((o) => {
              const on = o === opt;
              o.setAttribute('aria-checked', String(on));
              o.tabIndex = on ? 0 : -1;
            });
            if (cta && opt.dataset.storeUrl) cta.href = opt.dataset.storeUrl;
            if (label && opt.dataset.storeLabel) label.textContent = opt.dataset.storeLabel;
            if (focus) opt.focus();
          };
          options.forEach((opt, oi) => {
            opt.addEventListener('click', (e) => {
              e.stopPropagation();
              choose(opt);
            });
            opt.addEventListener('keydown', (e) => {
              if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
              e.preventDefault();
              const next = options[(oi + (e.key === 'ArrowRight' ? 1 : -1) + options.length) % options.length];
              choose(next, true);
            });
          });
        });

        // Drag and swipe: mouse, pen and touch alike. The front card follows
        // the pointer (the `translate` property, which composes with the
        // class transform), and a release past the threshold rotates.
        let startX = 0;
        let startY = 0;
        let dx = 0;
        let tracking = false;
        let dragging = false;
        let suppressClick = false;
        const SWIPE = 50;

        const endDrag = () => {
          tracking = false;
          stage.classList.remove('is-dragging');
          cards[active]?.style.removeProperty('translate');
          if (dragging) {
            if (dx <= -SWIPE) step(1);
            else if (dx >= SWIPE) step(-1);
            suppressClick = true;
            window.setTimeout(() => (suppressClick = false), 0);
          }
          dragging = false;
          dx = 0;
        };

        stage.addEventListener('pointerdown', (e) => {
          if (e.button !== 0) return;
          if ((e.target as HTMLElement).closest('a, button, input')) return;
          tracking = true;
          dragging = false;
          startX = e.clientX;
          startY = e.clientY;
          dx = 0;
        });
        stage.addEventListener('pointermove', (e) => {
          if (!tracking) return;
          dx = e.clientX - startX;
          const dy = e.clientY - startY;
          if (!dragging) {
            if (Math.abs(dx) > 8 && Math.abs(dx) > Math.abs(dy)) {
              dragging = true;
              stage.classList.add('is-dragging');
              try {
                stage.setPointerCapture(e.pointerId);
              } catch {
                /* not capturable: window listeners still end the drag */
              }
            } else if (Math.abs(dy) > 12) {
              tracking = false; // a vertical scroll, not a swipe
              return;
            }
          }
          if (dragging) {
            e.preventDefault();
            cards[active]?.style.setProperty('translate', `${dx * 0.6}px 0`);
          }
        });
        stage.addEventListener('pointerup', endDrag);
        stage.addEventListener('pointercancel', endDrag);
        // Touch starts with implicit capture on the element under the finger;
        // taking capture for the stage fires lostpointercapture on THAT
        // element, which bubbles here. Only the stage losing it ends a drag.
        stage.addEventListener('lostpointercapture', (e) => {
          if (e.target === stage && tracking) endDrag();
        });

        // A click on a peeking card brings it forward (never after a drag).
        stage.addEventListener('click', (e) => {
          if (suppressClick) {
            e.preventDefault();
            e.stopPropagation();
            return;
          }
          const card = (e.target as HTMLElement).closest<HTMLElement>('.deck-card');
          if (!card || card.classList.contains('active')) return;
          e.preventDefault();
          go(Number(card.dataset.index));
        }, true);

        // Trackpad: a horizontal two-finger swipe moves one card, fired on
        // the leading edge (40px of deltaX) and then locked. Ported from the
        // HQ /featured deck, which hit the same bug first.
        //
        // The lock used to be released by silence alone (140ms with no
        // wheel events). macOS keeps sending momentum events for a second
        // or two after the fingers lift, and each one re-armed the timer,
        // so a second swipe made during that tail was swallowed: "swipe,
        // swipe again, nothing happens" until the pointer left the deck.
        //
        // Now the lock is also released by INPUT, in two stages. A momentum
        // tail peaks and then only decays, so: (1) while still near the peak
        // it is the rest of the push that already fired, and never releases;
        // (2) once it has fallen to 60% of the peak it is coasting, and a
        // delta that climbs well back above the lowest point so far (2.5x
        // the trough, and at least 10px) can only be fingers on the pad
        // again. Measuring against the trough, not the previous sample, is
        // what keeps noisy macOS momentum from re-arming it. MIN_FIRE_GAP
        // makes "one swipe, one card" unconditional; the quiet timer stays
        // as a backstop.
        const SWIPE_DELTA = 40;
        const QUIET_MS = 120;
        const TAIL_RATIO = 0.6;
        const REARM_FACTOR = 2.5;
        const REARM_FLOOR = 10;
        const MIN_FIRE_GAP = 220;
        let wheelAcc = 0;
        let wheelLocked = false;
        let peak = 0;
        let tailing = false;
        let trough = Infinity;
        let lastFire = -Infinity;
        let quietTimer = 0;
        const releaseWheel = () => {
          wheelLocked = false;
          wheelAcc = 0;
          peak = 0;
          tailing = false;
          trough = Infinity;
        };
        cleanup(() => window.clearTimeout(quietTimer));
        stage.addEventListener('wheel', (e) => {
          if (Math.abs(e.deltaX) <= Math.abs(e.deltaY)) return;
          e.preventDefault();
          const abs = Math.abs(e.deltaX);
          window.clearTimeout(quietTimer);
          quietTimer = window.setTimeout(releaseWheel, QUIET_MS);
          if (wheelLocked) {
            if (abs > peak) peak = abs;
            if (!tailing) {
              if (abs < peak * TAIL_RATIO) {
                tailing = true;
                trough = abs;
              }
              return;
            }
            if (abs < trough) trough = abs;
            if (abs < REARM_FLOOR || abs < trough * REARM_FACTOR) return;
            releaseWheel();
          }
          wheelAcc += e.deltaX;
          if (Math.abs(wheelAcc) < SWIPE_DELTA) return;
          const now = e.timeStamp || performance.now();
          if (now - lastFire < MIN_FIRE_GAP) {
            wheelAcc = 0;
            return;
          }
          const forward = wheelAcc > 0;
          wheelLocked = true;
          peak = abs;
          tailing = false;
          trough = Infinity;
          lastFire = now;
          wheelAcc = 0;
          step(forward ? 1 : -1);
        }, { passive: false });

        render();
      });

      // The dropdown chooses a deck. Search filters its cards and the product list.
      const input = document.getElementById('gear-search-input') as HTMLInputElement | null;
      const clear = document.getElementById('gear-search-clear') as HTMLButtonElement | null;
      const empty = document.getElementById('gear-empty-state');
      const reset = document.getElementById('gear-reset-btn');
      const select = document.getElementById('gear-category-select') as HTMLSelectElement | null;
      let cat = '';
      let query = '';

      const allView = document.getElementById('gear-all-products');
      const deckView = document.getElementById('gear-decks-view');
      const allToggle = document.querySelector<HTMLButtonElement>('[data-all-toggle]');
      const allCards = Array.from(allView?.querySelectorAll<HTMLElement>('.all-grid-card') || []);
      const gridCount = allView?.querySelector('[data-grid-count]');
      let gridOpen = false;

      allToggle?.addEventListener('click', () => {
        if (!allView || !deckView) return;
        gridOpen = !gridOpen;
        allToggle.setAttribute('aria-expanded', String(gridOpen));
        allToggle.textContent = gridOpen ? 'Deck view' : 'Show all products';
        void setDisclosureOpen(deckView, !gridOpen);
        void setDisclosureOpen(allView, gridOpen);
        if (currentSection) {
          const currentDeck = decks.get(currentSection);
          if (gridOpen) currentDeck?.closeDetails();
          else currentDeck?.refresh();
        }
      });

      function apply() {
        let total = 0;
        const matchingSections = sections.filter((section) => {
          const matches = decks.get(section)?.filter(query) ?? 0;
          if (!matches || (cat && section.dataset.chip !== cat)) return false;
          total += matches;
          return true;
        });
        allCards.forEach((card) => {
          const matches = (!cat || card.dataset.chip === cat) && (!query || (card.dataset.search || '').includes(query));
          card.classList.toggle('is-filtered-out', !matches);
        });
        if (gridCount) gridCount.textContent = `${total} ${total === 1 ? 'product' : 'products'}`;
        if (empty) empty.hidden = total > 0;
        if (clear) clear.hidden = !query;
        const keepCurrent = currentSection && matchingSections.includes(currentSection);
        showSection(keepCurrent ? currentSection : matchingSections[0]);
      }

      select?.addEventListener('change', () => {
        cat = select.value;
        apply();
      });
      input?.addEventListener('input', () => {
        query = input.value.trim().toLowerCase();
        apply();
      });
      clear?.addEventListener('click', () => {
        if (input) input.value = '';
        query = '';
        apply();
        input?.focus();
      });
      reset?.addEventListener('click', () => {
        if (input) input.value = '';
        query = '';
        cat = '';
        if (select) select.value = '';
        apply();
      });

      // Category and product deep links choose the matching deck and front card
      // before the shared anchor script measures its position.
      const targetFor = (hash: string) => {
        if (!hash || hash.length < 2) return null;
        let id = hash.slice(1);
        try {
          id = decodeURIComponent(id);
        } catch {
          return null;
        }
        const el = document.getElementById(id);
        const section = el?.closest<HTMLElement>('.gear-accordion-section');
        if (!el || !section || !root.contains(section)) return null;
        return { section, card: el.closest<HTMLElement>('.deck-card') };
      };
      const openFor = (hash: string) => {
        const target = targetFor(hash);
        if (!target) return;
        if (gridOpen) allToggle?.click();
        const nextCategory = target.section.dataset.chip ?? '';
        if (query) {
          query = '';
          if (input) input.value = '';
        }
        cat = nextCategory;
        if (select) select.value = cat;
        apply();
        if (target.card) decks.get(target.section)?.show(Number(target.card.dataset.index));
      };
      const arrival = performance.getEntriesByType?.('navigation')[0] as PerformanceNavigationTiming | undefined;
      showSection(currentSection);
      if (location.hash && !(arrival?.type === 'reload' && !document.documentElement.dataset.pageTransition)) {
        openFor(location.hash);
      }
      on(window, 'hashchange', () => openFor(location.hash));
      on(document, 'click', (e) => {
        const link = (e.target as Element | null)?.closest?.('a[href*="#"]') as HTMLAnchorElement | null;
        if (!link) return;
        const url = new URL(link.href, location.href);
        if (url.pathname.replace(/\/$/, '') !== location.pathname.replace(/\/$/, '')) return;
        openFor(url.hash);
      }, { capture: true });
    }

    init();
    document.addEventListener('astro:page-load', init);
  })();
</script>
