      const previewBrand = document.getElementById('preview-camera-brand');
      const previewTitle = document.getElementById('preview-camera-title');
      const previewDesc = document.getElementById('preview-camera-desc');
      const previewBtn = document.getElementById('preview-camera-btn') as HTMLAnchorElement | null;
      const schematicView = document.getElementById('schematic-view');

      const selectCamera = (row: HTMLElement) => {
        cameraRows.forEach(r => r.classList.remove('is-active'));
        row.classList.add('is-active');

        const name = row.dataset.itemName || '';
        const brand = row.dataset.itemBrand || 'Sony';
        const spec = row.dataset.itemSpec || '';
        const tag = row.dataset.itemTag || 'Primary Body';
        const url = row.dataset.itemUrl || 'https://www.amazon.com/shop/influencer-0931c541?ref=ac_inf_tb_vh';

        if (previewTag) previewTag.textContent = tag;
        if (previewBrand) previewBrand.textContent = brand.toUpperCase() + ' // WORKHORSE';
        if (previewTitle) previewTitle.textContent = name;
        if (previewDesc) previewDesc.textContent = spec;
        if (previewBtn) previewBtn.href = url;

        if (schematicView) {
          if (name.includes('iPhone')) {
            schematicView.innerHTML = `
              <svg class="camera-schematic" viewBox="0 0 260 180" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="75" y="15" width="110" height="150" rx="18" fill="#151515" stroke="#3a3a3a" stroke-width="2.5"/>
                <rect x="85" y="25" width="55" height="55" rx="14" fill="#1e1e1e" stroke="#444" stroke-width="1.5"/>
                <circle cx="102" cy="42" r="11" fill="#0d0d0d" stroke="#555" stroke-width="2"/>
                <circle cx="102" cy="42" r="6" fill="#2a2a2a" stroke="#a2a2a2" stroke-width="1"/>
                <circle cx="123" cy="58" r="11" fill="#0d0d0d" stroke="#555" stroke-width="2"/>
                <circle cx="123" cy="58" r="6" fill="#2a2a2a" stroke="#a2a2a2" stroke-width="1"/>
                <circle cx="102" cy="66" r="8" fill="#0d0d0d" stroke="#555" stroke-width="1.5"/>
                <path d="M130 110c-3 0-5.5 2-8 2s-5-2-8-2c-4 0-8 3-10 8 0 7 6 15 10 15 3 0 4-2 8-2s5 2 8 2c4 0 9-7 10-13-5-2-7-7-7-10 0-4 3-7 7-9-3-4-8-5-10-5zm-3-4c2-3 2-6 1-8-2 0-5 2-7 4 0 2 0 6 1 8 2 0 4-2 5-4z" fill="#333"/>
                <text x="130" y="172" fill="#777" font-family="'JetBrains Mono', monospace" font-size="8" text-anchor="middle" font-weight="bold">APPLE // PRORES LOG 4K</text>
              </svg>
            `;
          } else {
            schematicView.innerHTML = `
              <svg class="camera-schematic" viewBox="0 0 260 180" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="20" y="45" width="220" height="120" rx="3" fill="#141414" stroke="#333" stroke-width="2"/>
                <rect x="70" y="25" width="60" height="22" rx="2" fill="#1e1e1e" stroke="#444" stroke-width="1.5"/>
                <circle cx="100" cy="35" r="4" fill="#696969"/>
                <circle cx="130" cy="105" r="48" fill="#0d0d0d" stroke="#555" stroke-width="2"/>
                <circle cx="130" cy="105" r="38" fill="#181818" stroke="#909090" stroke-width="1.5"/>
                <rect x="110" y="88" width="40" height="34" rx="2" fill="#222222" stroke="#a2a2a2" stroke-width="1"/>
                <rect x="25" y="45" width="42" height="120" fill="#1a1a1a" stroke="#2a2a2a" stroke-width="1"/>
                <line x1="28" y1="65" x2="62" y2="65" stroke="#333" stroke-width="1"/>
                <line x1="28" y1="85" x2="62" y2="85" stroke="#333" stroke-width="1"/>
                <line x1="28" y1="105" x2="62" y2="105" stroke="#333" stroke-width="1"/>
                <rect x="195" y="32" width="24" height="14" rx="2" fill="#222" stroke="#555" stroke-width="1"/>
                <rect x="165" y="36" width="20" height="10" rx="2" fill="#222" stroke="#555" stroke-width="1"/>
                <text x="130" y="16" fill="#888" font-family="'JetBrains Mono', monospace" font-size="9" text-anchor="middle" font-weight="bold">SONY ALPHA // SYSTEM</text>
              </svg>
            `;
          }
        }
      };

      cameraRows.forEach(row => {
        row.addEventListener('click', () => selectCamera(row));
        row.addEventListener('mouseenter', () => selectCamera(row));
      });
    }

    // 2. SUB COLLAGE BOXES INTERACTIVE PREVIEWS (LENSES, LIGHTING, AUDIO, TOOLS)
    const collageBoxes = Array.from(document.querySelectorAll<HTMLElement>('.gear-collage-box'));
    collageBoxes.forEach(box => {
      const slug = box.dataset.categorySlug || '';
      const items = Array.from(box.querySelectorAll<HTMLElement>('.collage-item-row'));
      const activeTag = document.getElementById(`tag-${slug}`);
      const activeBrand = document.getElementById(`brand-${slug}`);
      const activeTitle = document.getElementById(`title-${slug}`);
      const activeDesc = document.getElementById(`desc-${slug}`);
      const activeCta = document.getElementById(`cta-${slug}`) as HTMLAnchorElement | null;

      const selectItem = (row: HTMLElement) => {
        items.forEach(it => it.classList.remove('is-active'));
        row.classList.add('is-active');

        const name = row.dataset.itemName || '';
        const brand = row.dataset.itemBrand || 'Curated Kit';
        const spec = row.dataset.itemSpec || '';
        const tag = row.dataset.itemTag || 'Production Spec';
        const url = row.dataset.itemUrl || 'https://www.amazon.com/shop/influencer-0931c541?ref=ac_inf_tb_vh';

        if (activeTag) activeTag.textContent = tag;
        if (activeBrand) activeBrand.textContent = brand.toUpperCase() + ' // KIT';
        if (activeTitle) activeTitle.textContent = name;
        if (activeDesc) activeDesc.textContent = spec;
        if (activeCta) activeCta.href = url;
      };

      items.forEach(row => {
        row.addEventListener('click', () => selectItem(row));
        row.addEventListener('mouseenter', () => selectItem(row));
      });
    });

    // 3. INSTANT SEARCH & CATEGORY FILTER
    const searchInput = document.getElementById('gear-search-input') as HTMLInputElement | null;
    const clearBtn = document.getElementById('gear-search-clear') as HTMLButtonElement | null;
    const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.gear-chip'));
    const emptyState = document.getElementById('gear-empty-state');
    const resetBtn = document.getElementById('gear-reset-btn');

    let activeCategory = 'all';
    let searchQuery = '';

    function applyFilter() {
      let totalVisible = 0;
      const allBoxes = Array.from(document.querySelectorAll<HTMLElement>('.gear-hero-box, .gear-collage-box'));

      allBoxes.forEach((box) => {
        const catSlug = box.id.replace('gear-', '');
        const matchesCategory = activeCategory === 'all' || 
          catSlug === activeCategory || 
          (activeCategory === 'support' && catSlug === 'tools') ||
          (activeCategory === 'tools' && catSlug === 'tools');

        if (!matchesCategory) {
          box.hidden = true;
          return;
        }

        const items = Array.from(box.querySelectorAll<HTMLElement>('.camera-item-row, .collage-item-row'));
        let visibleItemsInBox = 0;

        items.forEach((item) => {
          const text = (item.textContent || '').toLowerCase();
          const matchesSearch = !searchQuery || text.includes(searchQuery);
          if (matchesSearch) {
            item.style.display = '';
            visibleItemsInBox++;
          } else {
            item.style.display = 'none';
          }
        });

        if (visibleItemsInBox > 0) {
          box.hidden = false;
          totalVisible += visibleItemsInBox;
        } else {
          box.hidden = true;
        }
      });

      if (emptyState) {
        emptyState.hidden = totalVisible > 0;
      }
      if (clearBtn) {
        clearBtn.hidden = !searchQuery;
      }
      // A tab switch shows boxes that were hidden: reveal them now, never
      // leave them at the reveal pre-state (audit defect 7).
      document.dispatchEvent(new CustomEvent('reveal:force', { detail: document.getElementById('gear-monolith') }));
    }

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        chips.forEach((c) => {
          c.classList.remove('active');
          c.setAttribute('aria-selected', 'false');
        });
        chip.classList.add('active');
        chip.setAttribute('aria-selected', 'true');
        activeCategory = chip.dataset.cat || 'all';
        applyFilter();
      });
    });

    searchInput?.addEventListener('input', () => {
      searchQuery = (searchInput.value || '').trim().toLowerCase();
      applyFilter();
    });

    clearBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      searchQuery = '';
      applyFilter();
      searchInput?.focus();
    });

    resetBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      searchQuery = '';
      activeCategory = 'all';
      chips.forEach((c) => {
        c.classList.toggle('active', c.dataset.cat === 'all');
        c.setAttribute('aria-selected', c.dataset.cat === 'all' ? 'true' : 'false');
      });
      applyFilter();
    });
  })();
</script>
