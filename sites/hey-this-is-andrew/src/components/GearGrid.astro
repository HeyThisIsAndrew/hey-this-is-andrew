---
import type { CollectionEntry } from 'astro:content';

interface Props {
  categories: CollectionEntry<'gear'>[];
}

const { categories } = Astro.props;

// Order map: Camera Bodies hero first, then Lenses, Lighting, Audio, Tools & Support
const orderMap: Record<string, number> = {
  'Camera Bodies': 1,
  'Lens': 2,
  'Lighting': 3,
  'Audio': 4,
  'Tools & Support': 5,
};

const sortedCats = [...categories].sort((a, b) => {
  const oA = orderMap[a.data.category] || a.data.order || 99;
  const oB = orderMap[b.data.category] || b.data.order || 99;
  return oA - oB;
});

const heroCat = sortedCats.find(c => c.data.category === 'Camera Bodies') || sortedCats[0];
const subCats = sortedCats.filter(c => c !== heroCat);

import { AMAZON_STOREFRONT } from '../data/storefront';
---

<div class="gear-monolith" id="gear-monolith">
  <!-- Gear Instant Search & Category Filter Toolbar -->
  <div class="gear-filter-toolbar" role="search" aria-label="Filter gear loadout">
    <div class="gear-search-wrap">
      <svg class="gear-search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input
        type="search"
        id="gear-search-input"
        class="gear-search-input"
        placeholder="Filter equipment (e.g. Sony, 24-70mm, Amaran, mic)..."
        aria-label="Search gear"
      />
      <button type="button" id="gear-search-clear" class="gear-search-clear" aria-label="Clear search" hidden>×</button>
    </div>
    <div class="gear-category-chips" role="tablist" aria-label="Gear categories">
      <button type="button" class="gear-chip active" data-cat="all" role="tab" aria-selected="true">All</button>
      <button type="button" class="gear-chip" data-cat="bodies" role="tab" aria-selected="false">Cameras</button>
      <button type="button" class="gear-chip" data-cat="lenses" role="tab" aria-selected="false">Lenses</button>
      <button type="button" class="gear-chip" data-cat="lighting" role="tab" aria-selected="false">Lighting</button>
      <button type="button" class="gear-chip" data-cat="audio" role="tab" aria-selected="false">Audio</button>
      <button type="button" class="gear-chip" data-cat="tools" role="tab" aria-selected="false">Support</button>
    </div>
  </div>
  <div id="gear-empty-state" class="gear-empty-state" hidden>
    <p class="gear-empty-text">No equipment matches your search filter.</p>
    <button type="button" id="gear-reset-btn" class="gear-reset-btn">Reset Filter</button>
  </div>
  <!-- HERO BOX 01: CAMERA BODIES (FULL WIDTH, TWO-PANEL SPLIT: LINKS | PREVIEW WITH AMAZON STOREFRONT) -->
  {heroCat && (
    <div
      class="gear-hero-box"
      id="gear-bodies"
      data-category="bodies"
    >
      <div class="gear-box-topbar">
        <div class="gear-box-meta">
          <span class="box-idx font-mono">01 / HERO SYSTEM</span>
          <h3 class="box-title">{heroCat.data.category}</h3>
          <span class="box-subtitle">High-Resolution Commercial Stills & Next-Gen Mobile Video</span>
        </div>

        <div class="brand-strip" aria-label="Camera Brands">
          <div class="brand-badge brand-sony" title="Sony Alpha Ecosystem">
            <svg class="brand-svg-sony" viewBox="0 0 100 22" fill="currentColor" aria-label="Sony">
              <path d="M14.6 4.8c-2.4-.7-5.1-1.1-7.7-1.1-4.2 0-6.9 1.6-6.9 4.6 0 5.4 12.3 3.6 12.3 8.3 0 2.2-2.1 3.4-5.6 3.4-3.4 0-6.7-.8-9.7-2.3l-1.2 3.6c3.2 1.4 7.2 2.1 10.9 2.1 6.5 0 10.4-2.7 10.4-6.8 0-5.8-12.3-3.8-12.3-8.4 0-1.8 1.7-2.7 4.7-2.7 2.6 0 5.2.6 7.4 1.5l1.6-3.8zM33.6 3.9c-6.8 0-12.2 4.4-12.2 10.7 0 6.4 5.3 10.7 12.2 10.7 6.9 0 12.2-4.4 12.2-10.7 0-6.4-5.4-10.7-12.2-10.7zm0 17.5c-4.3 0-7.2-3.1-7.2-6.8 0-3.8 2.9-6.8 7.2-6.8 4.3 0 7.2 3.1 7.2 6.8 0 3.8-2.9 6.8-7.2 6.8zM58.7 3.9h-4.8v21h4.8V12.7l9.7 12.2h5.1V3.9h-4.8v12.2L58.7 3.9zM86.9 13.9L80.1 3.9h-5.4l10.2 14.6v6.4h4.8v-6.4l10.3-14.6h-5.3l-6.8 10z"/>
            </svg>
            <span class="alpha-mark" title="Sony Alpha">α</span>
          </div>

          <div class="brand-badge brand-apple" title="Apple ProRes Log">
            <svg class="brand-svg-apple" viewBox="0 0 170 170" fill="currentColor" aria-label="Apple">
              <path d="M150.37 130.25c-2.45 5.66-5.35 10.87-8.71 15.66-4.58 6.53-8.33 11.05-11.22 13.56-4.48 4.12-9.28 6.23-14.42 6.35-3.69 0-8.14-1.05-13.32-3.18-5.19-2.12-9.97-3.17-14.34-3.17-4.58 0-9.49 1.05-14.75 3.17-5.26 2.13-9.5 3.24-12.74 3.35-4.35.13-9.16-1.9-14.42-6.08-3.69-3.08-7.7-7.93-12.02-14.55-6.3-9.68-11.23-20.73-14.79-33.15-3.56-12.43-5.34-24.08-5.34-34.96 0-15.11 3.69-27.42 11.07-36.93 7.38-9.5 16.7-14.35 27.97-14.55 5.48 0 11.45 1.49 17.9 4.48 6.45 2.98 10.5 4.54 12.14 4.67 1.83-.26 6.13-1.95 12.89-5.07 6.77-3.12 12.73-4.52 17.9-4.2 13.58.73 24.38 5.75 32.39 15.07-11.89 7.21-17.72 17.15-17.5 29.83.21 9.94 4.08 18.23 11.61 24.88 4.7 4.13 10.15 7.02 16.34 8.68-2.6 7.54-5.74 15.34-9.42 23.41zM119.22 33.02c0-7.72 2.76-14.97 8.27-21.75 5.52-6.77 12.27-10.87 20.25-12.3 1.05 7.72-1.39 14.86-7.32 21.43-5.93 6.57-12.99 10.77-21.2 12.62z"/>
            </svg>
            <span class="apple-text">Apple ProRes</span>
          </div>

          <a href={AMAZON_STOREFRONT} target="_blank" rel="noopener noreferrer" class="influencer-pill">
            <span class="influencer-dot"></span>
            <span class="influencer-text">Amazon Storefront</span>
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2.5 9.5L9.5 2.5M9.5 2.5H4.5M9.5 2.5V7.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
      </div>

      <!-- TWO-PANEL HERO SPLIT: LINKS | IMAGE PREVIEW -->
      <div class="gear-hero-body">
        <!-- LEFT: LINKS & SPECS -->
        <div class="gear-hero-links">
          <div class="hero-col-label">
            <span class="col-tag font-mono">MANIFEST</span>
            <span class="col-count font-mono">{heroCat.data.items.length} CAMERAS IN ACTIVE ROTATION</span>
          </div>

          <div class="camera-items-list">
            {heroCat.data.items.map((item, idx) => (
              <div
                class={`camera-item-row ${idx === 0 ? 'is-active' : ''}`}
                data-item-index={idx}
                data-item-name={item.name}
                data-item-brand={item.brand || (item.name.includes('Sony') ? 'Sony' : 'Apple')}
                data-item-spec={item.spec}
                data-item-tag={item.tag || (idx === 0 ? 'Primary Workhorse' : 'Cinema Body')}
                data-item-url={item.affiliateUrl || AMAZON_STOREFRONT}
              >
                <div class="camera-select-indicator" aria-hidden="true"></div>

                <div class="camera-item-main">
                  <div class="camera-item-header">
                    <h4 class="camera-name">{item.name}</h4>
                    <span class="camera-tag font-mono">{item.tag || (item.name.includes('Sony') ? 'Sony Alpha' : 'Apple ProRes')}</span>
                  </div>
                  <p class="camera-spec">{item.spec}</p>
                </div>

                <div class="camera-item-action">
                  <a
                    href={item.affiliateUrl || AMAZON_STOREFRONT}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn-amazon-link"
                    title={`Check ${item.name} on Amazon Influencer Storefront`}
                    onclick="event.stopPropagation();"
                  >
                    <span>Storefront ↗</span>
                  </a>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- RIGHT: LIVE IMAGE PREVIEW CARD -->
        <div class="gear-hero-preview-col">
          <div class="hero-col-label">
            <span class="col-tag font-mono">SPECIFICATION</span>
            <span class="col-count font-mono">FIELD VERIFIED</span>
          </div>

          <div class="amazon-preview-card" id="hero-camera-preview-card">
            <div class="preview-badge-row">
              <span class="preview-storefront-badge font-mono">
                STUDIO VERIFIED
              </span>
              <span class="preview-active-tag font-mono" id="preview-camera-tag">Workhorse Body</span>
            </div>

            <!-- SCHEMATIC CAMERA PRODUCT VISUAL BOX -->
            <div class="preview-product-stage">
              <div class="product-visual-container" id="preview-visual-container">
                <div class="schematic-wrap" id="schematic-view">
                  <svg class="camera-schematic" viewBox="0 0 260 180" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect x="20" y="45" width="220" height="120" rx="3" fill="#141414" stroke="#333" stroke-width="2"/>
                    <rect x="70" y="25" width="60" height="22" rx="2" fill="#1e1e1e" stroke="#444" stroke-width="1.5"/>
                    <circle cx="100" cy="35" r="4" fill="#696969"/>
                    <circle cx="130" cy="105" r="48" fill="#0d0d0d" stroke="#555" stroke-width="2"/>
                    <circle cx="130" cy="105" r="38" fill="#181818" stroke="#909090" stroke-width="1.5"/>
                    <rect x="110" y="88" width="40" height="34" rx="2" fill="#222222" stroke="#a2a2a2" stroke-width="1"/>
                    <rect x="25" y="45" width="42" height="120" fill="#1a1a1a" stroke="#2a2a2a" stroke-width="1"/>
                    <line x1="28" y1="65" x2="62" y2="65" stroke="#333" stroke-width="1"/>
                    <line x1="28" y1="85" x2="62" y2="85" stroke="#333" stroke-width="1"/>
                    <line x1="28" y1="105" x2="62" y2="105" stroke="#333" stroke-width="1"/>
                    <rect x="195" y="32" width="24" height="14" rx="2" fill="#222" stroke="#555" stroke-width="1"/>
                    <rect x="165" y="36" width="20" height="10" rx="2" fill="#222" stroke="#555" stroke-width="1"/>
                    <text x="130" y="16" fill="#888" font-family="'JetBrains Mono', monospace" font-size="9" text-anchor="middle" font-weight="bold">SONY ALPHA // SYSTEM</text>
                  </svg>
                </div>
              </div>
            </div>

            <!-- PREVIEW DETAILS & AMAZON CTA -->
            <div class="preview-info-strip">
              <div class="preview-naming">
                <span class="preview-brand-label font-mono" id="preview-camera-brand">SONY ELECTRONICS</span>
                <h4 class="preview-item-title" id="preview-camera-title">Sony a7 IV</h4>
                <p class="preview-item-desc" id="preview-camera-desc">33MP Full-Frame Exmor R CMOS, BIONZ XR, 4K60p 10-bit 4:2:2, 15+ stops DR. Primary body for low-light bar and atmospheric beverage work.</p>
              </div>

              <div class="preview-action-block">
                <a
                  href={AMAZON_STOREFRONT}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-primary-influencer"
                  id="preview-camera-btn"
                >
                  <span class="amz-btn-text">View on Amazon Storefront</span>
                  <svg width="15" height="15" viewBox="0 0 14 14" fill="none">
                    <path d="M2.5 11.5L11.5 2.5M11.5 2.5H5.5M11.5 2.5V8.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </a>
                <span class="preview-disclosure font-mono">Curated by Andrew · Field verified equipment</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  )}

  <!-- COLLAGE OF BOXES: MASONRY BENTO SIZED PROPORTIONALLY WITH KEY GEAR HAVING LARGER BOXES -->
  <div class="gear-collage">
    {subCats.map((cat, catIdx) => {
      const isLenses = cat.data.category === 'Lens';
      const isLighting = cat.data.category === 'Lighting';
      const isAudio = cat.data.category === 'Audio';
      const isTools = cat.data.category === 'Tools & Support';

      const anchorId = isLenses ? 'gear-lenses' : isLighting ? 'gear-lighting' : isAudio ? 'gear-audio' : 'gear-tools';
      const defaultItem = cat.data.items[0];

      return (
        <section
          class={`gear-collage-box ${isLenses ? 'box-lenses' : isLighting ? 'box-lighting' : isAudio ? 'box-audio' : 'box-tools'}`}
          id={anchorId}
          data-category-slug={anchorId}
          aria-label={cat.data.category}
        >
          {isLenses && (
            <>
              <span id="gear-zooms" class="vh" aria-hidden="true"></span>
              <span id="gear-primes" class="vh" aria-hidden="true"></span>
            </>
          )}
          {isLighting && (
            <>
              <span id="gear-lights" class="vh" aria-hidden="true"></span>
              <span id="gear-flash" class="vh" aria-hidden="true"></span>
            </>
          )}

          <!-- TOP BAR WITH LOGOS & METADATA -->
          <div class="gear-box-topbar sub-topbar">
            <div class="gear-box-meta">
              <span class="box-idx font-mono">0{catIdx + 2} / {isLenses ? 'OPTICAL SYSTEM' : isLighting ? 'ILLUMINATION' : isAudio ? 'ACOUSTIC PIPELINE' : 'STABILIZATION & RIG'}</span>
              <h3 class="box-title">{cat.data.category}</h3>
              <span class="box-subtitle">{cat.data.subtitle}</span>
            </div>

            <div class="brand-strip">
              {isLenses && (
                <div class="brand-badge brand-sony" title="Sony G Master & Viltrox">
                  <span class="gm-badge-tag">G MASTER</span>
                  <span class="brand-divider">/</span>
                  <span class="viltrox-tag">VILTROX</span>
                </div>
              )}
              {isLighting && (
                <div class="brand-badge" title="Aputure & Sony Flash">
                  <span class="aputure-text">Aputure</span>
                  <span class="brand-divider">/</span>
                  <span class="alpha-mark">Sony TTL</span>
                </div>
              )}
              {isAudio && (
                <div class="brand-badge" title="DJI & Røde Audio">
                  <span class="dji-text">DJI</span>
                  <span class="brand-divider">/</span>
                  <span class="rode-text">Røde</span>
                </div>
              )}
              {isTools && (
                <div class="brand-badge" title="Zhiyun & Peak Design">
                  <span class="zhiyun-text">Zhiyun</span>
                  <span class="brand-divider">/</span>
                  <span class="smallrig-text">Peak Design</span>
                </div>
              )}

              <a href={AMAZON_STOREFRONT} target="_blank" rel="noopener noreferrer" class="influencer-pill sub-pill">
                <span class="influencer-dot"></span>
                <span>Storefront</span>
                <svg width="10" height="10" viewBox="0 0 12 12" fill="none"><path d="M2.5 9.5L9.5 2.5M9.5 2.5H4.5M9.5 2.5V7.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            </div>
          </div>

          <!-- TWO-PANEL COLLAGE BODY: LINKS | LIVE PREVIEW -->
          <div class="gear-sub-split-body">
            <!-- LEFT PANEL: MANIFEST & LINKS -->
            <div class="gear-sub-links-col">
              <div class="hero-col-label">
                <span class="col-tag font-mono">MANIFEST</span>
                <span class="col-count font-mono">{cat.data.items.length} PIECES VERIFIED</span>
              </div>

              <div class="sub-items-scroll-list">
                {cat.data.items.map((item, itemIdx) => (
                  <div
                    class={`collage-item-row ${itemIdx === 0 ? 'is-active' : ''}`}
                    data-subcat={anchorId}
                    data-item-index={itemIdx}
                    data-item-name={item.name}
                    data-item-brand={item.brand || 'Curated Kit'}
                    data-item-spec={item.spec}
                    data-item-tag={item.tag || 'Production Spec'}
                    data-item-url={item.affiliateUrl || AMAZON_STOREFRONT}
                  >
                    <div class="camera-select-indicator" aria-hidden="true"></div>

                    <div class="collage-item-main">
                      <div class="collage-item-header">
                        <h4 class="collage-item-name">{item.name}</h4>
                        <span class="collage-item-tag font-mono">{item.tag || 'Pro Kit'}</span>
                      </div>
                      <p class="collage-item-spec">{item.spec}</p>
                    </div>

                    <div class="collage-item-action">
                      <a
                        href={item.affiliateUrl || AMAZON_STOREFRONT}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn-amazon-link"
                        title={`Check ${item.name} on Amazon Influencer Storefront`}
                        onclick="event.stopPropagation();"
                      >
                        <span>Storefront ↗</span>
                      </a>
                    </div>
                  </div>
                ))}
              </div>
            </div>

            <!-- RIGHT PANEL: INTERACTIVE LIVE PREVIEW CARD -->
            <div class="gear-sub-preview-col">
              <div class="hero-col-label">
                <span class="col-tag font-mono">SPECIFICATION</span>
                <span class="col-count font-mono">BENCH VERIFIED</span>
              </div>

              <div class="amazon-preview-card collage-preview-card">
                <div class="preview-badge-row">
                  <span class="preview-storefront-badge font-mono">
                    PRODUCTION SPEC
                  </span>
                  <span class="preview-active-tag font-mono" id={`tag-${anchorId}`}>
                    {defaultItem?.tag || 'Selected Spec'}
                  </span>
                </div>

                <!-- DYNAMIC SVG SCHEMATIC STAGE PER CATEGORY -->
                <div class="preview-product-stage sub-stage">
                  <div class="product-visual-container">
                    {isLenses && (
                      <div class="schematic-wrap" id={`schematic-${anchorId}`}>
                        <svg class="camera-schematic" viewBox="0 0 260 180" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <rect x="30" y="50" width="200" height="80" rx="3" fill="#141414" stroke="#333" stroke-width="2"/>
                          <rect x="25" y="45" width="25" height="90" rx="2" fill="#181818" stroke="#444" stroke-width="1.5"/>
                          <!-- Lens Elements -->
                          <ellipse cx="65" cy="90" rx="8" ry="34" fill="#333333" stroke="#808080" stroke-width="1.5"/>
                          <ellipse cx="95" cy="90" rx="10" ry="32" fill="#222222" stroke="#666666" stroke-width="1.5"/>
                          <ellipse cx="140" cy="90" rx="12" ry="30" fill="#444444" stroke="#808080" stroke-width="1.5"/>
                          <ellipse cx="185" cy="90" rx="9" ry="32" fill="#222222" stroke="#808080" stroke-width="1.5"/>
                          <ellipse cx="215" cy="90" rx="6" ry="34" fill="#111111" stroke="#555555" stroke-width="1.5"/>
                          <!-- Focus & Zoom Rings -->
                          <rect x="70" y="50" width="30" height="80" fill="#1a1a1a" stroke="#2a2a2a" stroke-width="1"/>
                          <rect x="150" y="50" width="40" height="80" fill="#1a1a1a" stroke="#2a2a2a" stroke-width="1"/>
                          <!-- G Master Badge -->
                          <rect x="115" y="42" width="22" height="14" rx="2" fill="#666666"/>
                          <text x="126" y="53" fill="#fff" font-family="'Syne', sans-serif" font-size="9" text-anchor="middle" font-weight="900">G</text>
                          <text x="130" y="160" fill="#888" font-family="'JetBrains Mono', monospace" font-size="8" text-anchor="middle" font-weight="bold">SONY G MASTER // OPTICAL SYSTEM</text>
                        </svg>
                      </div>
                    )}
                    {isLighting && (
                      <div class="schematic-wrap" id={`schematic-${anchorId}`}>
                        <svg class="camera-schematic" viewBox="0 0 260 180" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <rect x="40" y="55" width="110" height="70" rx="4" fill="#151515" stroke="#333" stroke-width="2"/>
                          <circle cx="95" cy="90" r="22" fill="#808080" fill-opacity="0.25" stroke="#868686" stroke-width="2"/>
                          <circle cx="95" cy="90" r="10" fill="#fff" stroke="#9d9d9d" stroke-width="2"/>
                          <!-- Reflector Cone -->
                          <polygon points="150,55 210,35 210,145 150,125" fill="#202020" stroke="#444" stroke-width="2"/>
                          <!-- Light Ray Emittance -->
                          <line x1="215" y1="45" x2="250" y2="35" stroke="#868686" stroke-width="1.5" stroke-dasharray="3 3"/>
                          <line x1="215" y1="90" x2="255" y2="90" stroke="#868686" stroke-width="2" stroke-dasharray="4 3"/>
                          <line x1="215" y1="135" x2="250" y2="145" stroke="#868686" stroke-width="1.5" stroke-dasharray="3 3"/>
                          <!-- Yoke & Stand Mount -->
                          <path d="M95 125v35m-15 0h30" stroke="#555" stroke-width="2"/>
                          <text x="130" y="24" fill="#888" font-family="'JetBrains Mono', monospace" font-size="8" text-anchor="middle" font-weight="bold">AMARAN // 5600K DAYLIGHT LED</text>
                        </svg>
                      </div>
                    )}
                    {isAudio && (
                      <div class="schematic-wrap" id={`schematic-${anchorId}`}>
                        <svg class="camera-schematic" viewBox="0 0 260 180" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <!-- Dual TX & RX Mic Units -->
                          <rect x="40" y="45" width="55" height="90" rx="8" fill="#141414" stroke="#333" stroke-width="2"/>
                          <circle cx="67" cy="65" r="12" fill="#222" stroke="#555" stroke-width="1.5"/>
                          <rect x="52" y="90" width="30" height="14" rx="2" fill="#000" stroke="#333"/>
                          <text x="67" y="101" fill="#747474" font-family="'JetBrains Mono', monospace" font-size="7" text-anchor="middle">32-BIT</text>

                          <rect x="110" y="45" width="55" height="90" rx="8" fill="#141414" stroke="#333" stroke-width="2"/>
                          <circle cx="137" cy="65" r="12" fill="#222" stroke="#555" stroke-width="1.5"/>
                          <rect x="122" y="90" width="30" height="14" rx="2" fill="#000" stroke="#333"/>
                          <text x="137" y="101" fill="#747474" font-family="'JetBrains Mono', monospace" font-size="7" text-anchor="middle">FLOAT</text>

                          <!-- Waveform visualization -->
