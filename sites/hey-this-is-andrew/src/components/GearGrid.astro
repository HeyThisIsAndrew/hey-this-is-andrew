  }
  .all-grid-title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0;
  }
  .btn-back-carousel {
    padding: 0.5rem 1.15rem;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.24);
    color: #ffffff;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .btn-back-carousel:hover {
    background: #ffffff;
    color: #000000;
    border-color: #ffffff;
  }

  .all-grid-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1.5rem;
  }
  .all-grid-card {
    background: #101010;
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1rem;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .all-grid-card:hover {
    border-color: rgba(255, 255, 255, 0.35);
    transform: translateY(-2px);
  }
  .all-card-top {
    display: flex;
    justify-content: space-between;
    font-size: 0.68rem;
    color: var(--muted, #888888);
  }
  .all-card-img-wrap {
    width: 100%;
    height: 140px;
    background: #080808;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem;
  }
  .all-card-img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }
  .all-card-name {
    font-size: 1rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 0.35rem;
  }
  .all-card-spec {
    font-size: 0.8rem;
    color: var(--muted, #888888);
    line-height: 1.5;
    margin: 0 0 1rem;
  }
  .all-card-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    padding: 0.45rem 0.85rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #ffffff;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .all-card-cta:hover {
    background: #ffffff;
    color: #000000;
    border-color: #ffffff;
  }

  .cafe-project-reel-note {
    background: #121212;
    border: 1px solid rgba(255, 255, 255, 0.12);
    padding: 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .reel-note-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.72rem;
    color: var(--muted, #888888);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .reel-badge {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #ffffff;
    padding: 0.15rem 0.5rem;
    font-weight: 700;
  }
  .reel-desc {
    font-size: 0.88rem;
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.6;
    margin: 0;
  }

  .all-grid-footer {
    display: flex;
    justify-content: flex-end;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  /* --------------------------------------------------------------------------
     RESPONSIVE BREAKPOINTS
     -------------------------------------------------------------------------- */
  @media (max-width: 768px) {
    .gear-accordion-header-bar {
      padding-right: 0.85rem;
      gap: 0.5rem;
    }
    .gear-accordion-header {
      padding: 1rem 0.5rem 1rem 1rem;
      gap: 0.75rem;
    }
    .gear-header-right {
      gap: 0.5rem;
    }
    .gear-item-count-badge {
      display: none;
    }
    .gear-deck-view {
      padding: 1.25rem 0.75rem;
      gap: 1.25rem;
    }
    .hero-poster-card {
      min-height: 440px;
    }
    .hero-poster-visual-wrap {
      padding: 2rem 1.25rem 8.5rem;
    }
    .hero-overlay-plate {
      padding: 1.25rem 1.25rem 1.25rem;
    }
    .hero-product-title {
      font-size: 1.35rem;
    }
    .hero-product-spec {
      font-size: 0.82rem;
    }
    .influencer-pill {
      font-size: 0.65rem;
      padding: 0.35rem 0.65rem;
    }
    .btn-all-toggle {
      font-size: 0.65rem;
      padding: 0.35rem 0.65rem;
    }
    .btn-deck-item-nav {
      width: 36px;
      height: 36px;
    }
  }
</style>

<script>
  (() => {
    function initGearMonolith() {
      const container = document.getElementById('gear-accordion-container');
      if (!container || container.dataset.gearWired === '1') return;
      container.dataset.gearWired = '1';

      const sections = Array.from(container.querySelectorAll<HTMLElement>('.gear-accordion-section'));

      // 1. SECTION CONTROLLER INTERFACE
      interface SectionController {
        renderActiveCard: (index: number, smoothScroll?: boolean) => void;
        getActiveIndex: () => number;
      }
      const sectionControllers = new Map<string, SectionController>();

      // 2. TOGGLE SECTION ACCORDION (EXPAND OR COLLAPSE)
      function toggleSection(section: HTMLElement) {
        const isCurrentlyExpanded = section.classList.contains('is-expanded');
        if (isCurrentlyExpanded) {
          // If already open, clicking its header COLLAPSES IT
          section.classList.remove('is-expanded');
          section.classList.add('is-collapsed');
          section.querySelector('.gear-accordion-header')?.setAttribute('aria-expanded', 'false');
          section.querySelector('.accordion-chevron-btn')?.setAttribute('aria-expanded', 'false');
        } else {
          // If closed, open this section and collapse all other sections
          sections.forEach(s => {
            const isTarget = s === section;
            s.classList.toggle('is-expanded', isTarget);
            s.classList.toggle('is-collapsed', !isTarget);
            s.querySelector('.gear-accordion-header')?.setAttribute('aria-expanded', String(isTarget));
            s.querySelector('.accordion-chevron-btn')?.setAttribute('aria-expanded', String(isTarget));
          });
        }
      }

      // 3. WIRE EACH SECTION
      sections.forEach(section => {
        const catKey = section.dataset.category || '';
        const tiles = Array.from(section.querySelectorAll<HTMLElement>('.deck-thumb-tile'));
        const slats = Array.from(section.querySelectorAll<HTMLElement>('.deck-slat'));
        const prevBtn = section.querySelector<HTMLButtonElement>(`[data-deck-prev="${catKey}"]`);
        const nextBtn = section.querySelector<HTMLButtonElement>(`[data-deck-next="${catKey}"]`);
        const counterEl = section.querySelector<HTMLElement>(`[data-card-counter="${catKey}"]`);
        const allToggleBtn = section.querySelector<HTMLButtonElement>(`[data-all-toggle="${catKey}"]`);
        const backCarouselBtns = Array.from(section.querySelectorAll<HTMLButtonElement>(`[data-back-carousel="${catKey}"]`));
        const deckView = section.querySelector<HTMLElement>(`[data-deck-container="${catKey}"]`);
        const allView = section.querySelector<HTMLElement>(`[data-all-view="${catKey}"]`);
        const heroPosterCard = section.querySelector<HTMLElement>(`[data-hero-poster="${catKey}"]`);
        const glowLayers = Array.from(section.querySelectorAll<HTMLElement>('.ambient-glow-layer'));

        const isBodies = catKey === 'bodies';
        const isBrew = catKey === 'brew';

        const imgEl = section.querySelector<HTMLImageElement>(`#${isBodies ? 'preview-camera-img' : isBrew ? 'preview-cafe-img' : `img-gear-${catKey}`}`);
        const ctaEl = section.querySelector<HTMLAnchorElement>(`#${isBodies ? 'preview-camera-btn' : isBrew ? 'cafe-hero-cta' : `cta-gear-${catKey}`}`);
        const brandEl = section.querySelector<HTMLElement>(`#${isBodies ? 'preview-camera-brand' : `brand-gear-${catKey}`}`);
        const titleEl = section.querySelector<HTMLElement>(`#${isBodies ? 'preview-camera-title' : isBrew ? 'cafe-hero-name' : `title-gear-${catKey}`}`);
        const descEl = section.querySelector<HTMLElement>(`#${isBodies ? 'preview-camera-desc' : isBrew ? 'cafe-hero-desc' : `desc-gear-${catKey}`}`);
        const tagEl = section.querySelector<HTMLElement>(`#${isBodies ? 'preview-camera-tag' : `tag-gear-${catKey}`}`);

        let activeIndex = 0;
        const totalItems = tiles.length;

        // Header click listener (unambiguous accordion toggle on whole bar)
        const headerBar = section.querySelector<HTMLElement>('.gear-accordion-header-bar');
        headerBar?.addEventListener('click', (e) => {
          // If clicked on an inner action (like Show All button or Storefront link), don't collapse accordion
          if ((e.target as HTMLElement).closest('.influencer-pill, .btn-all-toggle')) {
            return;
          }
          toggleSection(section);
        });

        function getNextVisibleIndex(direction: 1 | -1): number {
          const visibleTiles = tiles.filter(t => t.style.display !== 'none');
          if (visibleTiles.length === 0) return activeIndex;
          const currentVisIdx = visibleTiles.indexOf(tiles[activeIndex]);
          let nextVisIdx: number;
          if (currentVisIdx === -1) {
            nextVisIdx = 0;
          } else {
            nextVisIdx = (currentVisIdx + direction + visibleTiles.length) % visibleTiles.length;
          }
          return tiles.indexOf(visibleTiles[nextVisIdx]);
        }

        function renderActiveCard(index: number, smoothScroll = true) {
          activeIndex = (index + totalItems) % totalItems;
          const currentTile = tiles[activeIndex];
          if (!currentTile) return;

          // Motion: trigger short crossfade and scale
          if (heroPosterCard) {
            heroPosterCard.classList.add('is-rotating');
            setTimeout(() => {
              heroPosterCard.classList.remove('is-rotating');
            }, 180);
          }

          // Update tiles
          tiles.forEach((t, i) => {
            const isActive = i === activeIndex;
            t.classList.toggle('is-active', isActive);
            t.setAttribute('aria-selected', isActive ? 'true' : 'false');
          });

          // Scroll active thumbnail smoothly into view
          if (smoothScroll) {
            currentTile.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
          }

          // Update Counter based on visible matching items
          const visibleTiles = tiles.filter(t => t.style.display !== 'none');
          const visibleCount = visibleTiles.length;
          const pad = (n: number) => n < 10 ? `0${n}` : `${n}`;
          if (counterEl) {
            if (visibleCount < totalItems && visibleCount > 0) {
              const currentVisIdx = visibleTiles.indexOf(currentTile);
              const pos = currentVisIdx >= 0 ? currentVisIdx + 1 : 1;
              counterEl.textContent = `${pad(pos)} / ${pad(visibleCount)}`;
            } else {
              counterEl.textContent = `${pad(activeIndex + 1)} / ${pad(totalItems)}`;
            }
          }

          // Read data attributes
          const name = currentTile.dataset.itemName || '';
          const brand = currentTile.dataset.itemBrand || 'Curated Kit';
          const spec = currentTile.dataset.itemSpec || '';
          const tag = currentTile.dataset.itemTag || 'Production Spec';
          const url = currentTile.dataset.itemUrl || 'https://www.amazon.com/shop/influencer-0931c541?ref=ac_inf_tb_vh';
          const hasProductUrl = currentTile.dataset.hasProductUrl === 'true';
          const image = currentTile.dataset.itemImage || '';
          const rgb = currentTile.dataset.itemRgb || '100, 100, 100';
          const ariaLabel = currentTile.dataset.itemAria || `View ${name} on Amazon`;

          // Update Section Accent Color
          section.style.setProperty('--item-accent-rgb', rgb);

          // Update Hero Content
          if (titleEl) titleEl.textContent = name;
          if (brandEl) brandEl.textContent = `${brand.toUpperCase()} // KIT`;
          if (descEl) descEl.textContent = spec;
          if (tagEl) tagEl.textContent = tag;

          if (ctaEl) {
            ctaEl.href = url;
            ctaEl.setAttribute('aria-label', ariaLabel);
            const btnText = ctaEl.querySelector('.amz-btn-text');
            if (btnText) {
              btnText.textContent = hasProductUrl ? `View ${name} on Amazon` : 'Visit the storefront';
            }
          }

          // Image update
          if (imgEl && image) {
            imgEl.src = image;
            imgEl.alt = '';
          }

          // Update Ambient Glow Backlight
          glowLayers.forEach((glow, gIdx) => {
            glow.classList.toggle('active', gIdx === activeIndex);
          });

          // Update Peeking Slats (slat 1 = next visible, slat 2 = 2nd next visible)
          if (visibleCount <= 1) {
            slats.forEach(slat => {
              slat.className = 'deck-slat hidden';
            });
          } else {
            const currentVisIdx = visibleTiles.indexOf(currentTile);
            const next1Tile = visibleTiles[(currentVisIdx + 1) % visibleTiles.length];
            const next2Tile = visibleTiles.length > 2 ? visibleTiles[(currentVisIdx + 2) % visibleTiles.length] : null;

            const next1Idx = next1Tile ? tiles.indexOf(next1Tile) : -1;
            const next2Idx = next2Tile ? tiles.indexOf(next2Tile) : -1;

            slats.forEach((slat, idx) => {
              slat.className = 'deck-slat';
              if (idx === next1Idx) {
                slat.classList.add('next-1');
              } else if (idx === next2Idx) {
                slat.classList.add('next-2');
              } else {
                slat.classList.add('hidden');
              }
            });
          }
        }

        // Register controller for this section
        sectionControllers.set(catKey, {
          renderActiveCard,
          getActiveIndex: () => activeIndex,
        });

        // Thumbnail Tile Click & Keydown
        tiles.forEach((tile, idx) => {
          tile.addEventListener('click', () => {
            renderActiveCard(idx);
          });
          tile.addEventListener('keydown', (e: KeyboardEvent) => {
            if (e.key === 'ArrowRight') {
              e.preventDefault();
              renderActiveCard(getNextVisibleIndex(1));
            } else if (e.key === 'ArrowLeft') {
              e.preventDefault();
              renderActiveCard(getNextVisibleIndex(-1));
            }
          });
        });

        // Slats Click
        slats.forEach((slat, idx) => {
          slat.addEventListener('click', () => {
            renderActiveCard(idx);
          });
        });

        // Prev & Next Buttons (item navigation inside deck stage)
        prevBtn?.addEventListener('click', (e) => {
          e.stopPropagation();
          renderActiveCard(getNextVisibleIndex(-1));
        });
        nextBtn?.addEventListener('click', (e) => {
          e.stopPropagation();
          renderActiveCard(getNextVisibleIndex(1));
        });

        // Pointer Drag & Touch Swipe (Mouse, Trackpad, and Real Touch Devices)
        const deckStage = section.querySelector<HTMLElement>(`[data-deck-stage="${catKey}"]`);
        if (deckStage) {
          let startX = 0;
          let startY = 0;
          let isDragging = false;
          let hasHorizontalMoved = false;

          deckStage.addEventListener('pointerdown', (e: PointerEvent) => {
            if ((e.target as HTMLElement).closest('button, a, input')) return;
            startX = e.clientX;
            startY = e.clientY;
            isDragging = true;
            hasHorizontalMoved = false;
          });

          window.addEventListener('pointermove', (e: PointerEvent) => {
            if (!isDragging) return;
            const diffX = startX - e.clientX;
            const diffY = startY - e.clientY;
            if (Math.abs(diffX) > 10 && Math.abs(diffX) > Math.abs(diffY)) {
              hasHorizontalMoved = true;
            }
          });

          window.addEventListener('pointerup', (e: PointerEvent) => {
            if (!isDragging) return;
            isDragging = false;
            const diffX = startX - e.clientX;
            const diffY = startY - e.clientY;
            if (hasHorizontalMoved && Math.abs(diffX) > 40 && Math.abs(diffX) > Math.abs(diffY)) {
              if (diffX > 0) renderActiveCard(getNextVisibleIndex(1));
              else renderActiveCard(getNextVisibleIndex(-1));
            }
          });

          window.addEventListener('pointercancel', () => {
            isDragging = false;
            hasHorizontalMoved = false;
          });
        }

        // "All" View Toggle
        const toggleAllView = (showAll: boolean) => {
          if (!allView || !deckView) return;
          if (showAll) {
            deckView.hidden = true;
            allView.hidden = false;
            if (allToggleBtn) {
              allToggleBtn.setAttribute('aria-expanded', 'true');
              const label = allToggleBtn.querySelector('.all-toggle-label');
              const icon = allToggleBtn.querySelector('.all-toggle-icon');
              if (label) label.textContent = 'Carousel View';
              if (icon) icon.textContent = '⊟';
            }
          } else {
            allView.hidden = true;
            deckView.hidden = false;
            if (allToggleBtn) {
              allToggleBtn.setAttribute('aria-expanded', 'false');
              const label = allToggleBtn.querySelector('.all-toggle-label');
              const icon = allToggleBtn.querySelector('.all-toggle-icon');
              if (label) label.textContent = `Show All (${totalItems})`;
              if (icon) icon.textContent = '⊞';
            }
          }
        };

        allToggleBtn?.addEventListener('click', (e) => {
          e.stopPropagation();
          const isCurrentlyAll = !allView?.hidden;
          toggleAllView(!isCurrentlyAll);
        });

        backCarouselBtns.forEach(btn => {
          btn.addEventListener('click', () => {
            toggleAllView(false);
          });
        });
      });

      // 4. SEARCH & CATEGORY CHIPS FILTERING ACROSS ALL 5 SECTIONS
      const searchInput = document.getElementById('gear-search-input') as HTMLInputElement | null;
      const clearBtn = document.getElementById('gear-search-clear') as HTMLButtonElement | null;
      const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.gear-chip'));
      const emptyState = document.getElementById('gear-empty-state');
      const resetBtn = document.getElementById('gear-reset-btn');

      let activeCategory = 'all';
      let searchQuery = '';

      function applyFilter() {
        let totalVisible = 0;

        sections.forEach(section => {
          const catKey = section.dataset.category || '';
          const matchesCategory = activeCategory === 'all' || 
            catKey === activeCategory || 
            (activeCategory === 'cameras' && catKey === 'bodies') ||
            (activeCategory === 'support' && catKey === 'tools') ||
            (activeCategory === 'cafe' && catKey === 'brew');

          if (!matchesCategory) {
            section.hidden = true;
            return;
          }

          const tiles = Array.from(section.querySelectorAll<HTMLElement>('.deck-thumb-tile'));
          const gridCards = Array.from(section.querySelectorAll<HTMLElement>('.all-grid-card'));
          let visibleTiles = 0;

          tiles.forEach((tile, tIdx) => {
            const text = (tile.textContent || '').toLowerCase();
            const matchesSearch = !searchQuery || text.includes(searchQuery);
            if (matchesSearch) {
              tile.style.display = '';
              visibleTiles++;
            } else {
              tile.style.display = 'none';
            }
            if (gridCards[tIdx]) {
              gridCards[tIdx].style.display = matchesSearch ? '' : 'none';
            }
          });

          if (visibleTiles > 0) {
            section.hidden = false;
            totalVisible += visibleTiles;

            // Sync hero card & slats to matching visible items
            const ctrl = sectionControllers.get(catKey);
            if (ctrl) {
              const currentActiveIdx = ctrl.getActiveIndex();
              const currentTile = tiles[currentActiveIdx];
              if (!currentTile || currentTile.style.display === 'none') {
                const firstVisibleIdx = tiles.findIndex(t => t.style.display !== 'none');
                if (firstVisibleIdx !== -1) {
                  ctrl.renderActiveCard(firstVisibleIdx, false);
                }
              } else {
                ctrl.renderActiveCard(currentActiveIdx, false);
              }
            }
          } else {
            section.hidden = true;
          }
        });

        if (emptyState) emptyState.hidden = totalVisible > 0;
        if (clearBtn) clearBtn.hidden = !searchQuery;

        // Auto-expand the first visible section
        const firstVisible = sections.find(s => !s.hidden);
        if (firstVisible) {
          sections.forEach(s => {
            const isMatch = s === firstVisible;
            s.classList.toggle('is-expanded', isMatch);
            s.classList.toggle('is-collapsed', !isMatch);
            s.querySelector('.gear-accordion-header')?.setAttribute('aria-expanded', String(isMatch));
            s.querySelector('.accordion-chevron-btn')?.setAttribute('aria-expanded', String(isMatch));
          });
        }
      }

      chips.forEach(chip => {
        chip.addEventListener('click', () => {
          chips.forEach(c => {
            c.classList.remove('active');
            c.setAttribute('aria-selected', 'false');
          });
          chip.classList.add('active');
          chip.setAttribute('aria-selected', 'true');
          activeCategory = chip.dataset.cat || 'all';
          applyFilter();
        });
      });

      searchInput?.addEventListener('input', () => {
        searchQuery = (searchInput.value || '').trim().toLowerCase();
        applyFilter();
      });

      clearBtn?.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        searchQuery = '';
        applyFilter();
        searchInput?.focus();
      });

      resetBtn?.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        searchQuery = '';
        activeCategory = 'all';
        chips.forEach(c => {
          c.classList.toggle('active', c.dataset.cat === 'all');
          c.setAttribute('aria-selected', c.dataset.cat === 'all' ? 'true' : 'false');
        });
        applyFilter();
      });
    }

    initGearMonolith();
    document.addEventListener('astro:page-load', initGearMonolith);
  })();
</script>
