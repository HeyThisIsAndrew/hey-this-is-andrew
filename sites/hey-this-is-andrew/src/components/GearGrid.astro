---
/**
 * /gear: the kit as the BE Unconventional HQ /featured deck, copied, not
 * reinterpreted.
 *
 * Every section header shows at once as a compact stack; exactly one section
 * is open (or none: clicking the open header closes it). The open section is
 * a deck: the current item is a large card in front, the next two PEEK out
 * to its right with their names on a spine, and a thumbnail strip sits
 * underneath. Rotating moves every card between those positions, so the
 * change is a short crossfade with a slide and scale, never a swap.
 *
 * Behind the deck is the HQ ambient glow: a blurred copy of the current photo
 * washed in that photo's own accent colour (sampled at build time, see
 * src/lib/gear-accent.ts). The same accent tints the badge, the counter and
 * the active thumbnail. All other chrome stays monochrome.
 *
 * Data: src/data/gear.json. An item with no store link is owned but not
 * shown. An item whose image file is missing renders a typographic card
 * rather than a wrong or broken picture.
 */
import fs from 'node:fs';
import path from 'node:path';
import type { CollectionEntry } from 'astro:content';
import { AMAZON_STOREFRONT } from '../data/storefront';
import { sampleAccent, NEUTRAL_ACCENT } from '../lib/gear-accent';

interface Props {
  categories: CollectionEntry<'gear'>[];
}

const { categories } = Astro.props;

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase.slice(0, -1) : rawBase;
const publicDir = path.resolve(process.cwd(), 'public');

/** The public URL of an image, or '' when the file is not there. */
const imageUrl = (img?: string) => {
  if (!img) return '';
  if (/^https?:\/\//.test(img)) return img;
  const clean = img.startsWith('/') ? img : `/${img}`;
  return fs.existsSync(path.join(publicDir, clean)) ? `${base}${clean}` : '';
};

// Section DOM ids predate this file (anchors, the sitemap, site search).
const DOM_ID: Record<string, string> = { cafe: 'brew' };
const CHIP: Record<string, string> = { bodies: 'Cameras', tools: 'Support', cafe: 'Cafe' };

interface Store {
  store: string;
  url: string;
  affiliate?: boolean;
}

const sections = await Promise.all(
  [...categories]
    .sort((a, b) => a.data.order - b.data.order)
    .map(async (cat) => {
      const items = await Promise.all(
        cat.data.items
          .filter((it) => it.stores.length > 0)
          .map(async (it) => {
            const src = imageUrl(it.image);
            const accent = src && it.image ? await sampleAccent(path.join(publicDir, it.image)) : NEUTRAL_ACCENT;
            const stores = it.stores as Store[];
            return {
              ...it,
              short: it.shortName || it.name,
              src,
              accent,
              stores,
              search: [it.name, it.shortName, it.brand, it.tag, it.spec, cat.data.category, it.recommended ? 'recommended' : '', ...stores.map((s) => s.store)]
                .filter(Boolean)
                .join(' ')
                .toLowerCase(),
            };
          })
      );
      return {
        slug: cat.id,
        domId: DOM_ID[cat.id] || `gear-${cat.id}`,
        chip: CHIP[cat.id] || cat.data.category,
        chipKey: cat.id === 'bodies' ? 'cameras' : cat.id === 'tools' ? 'support' : cat.id,
        title: cat.data.category,
        kicker: cat.data.kicker || '',
        subtitle: cat.data.subtitle || '',
        collectionUrl: cat.data.collectionUrl || AMAZON_STOREFRONT,
        collectionLabel: cat.data.collectionUrl ? cat.data.collectionLabel || 'Amazon list' : 'Storefront',
        items,
      };
    })
).then((all) => all.filter((s) => s.items.length > 0));

const pad = (n: number) => String(n).padStart(2, '0');
const ctaLabel = (s: Store) => `View on ${s.store}`;
/** Positions in the deck, as the HQ deck names them. */
const stateOf = (i: number, n: number) =>
  i === 0 ? 'active' : i === 1 ? 'next-1' : i === 2 ? 'next-2' : i === n - 1 && n > 3 ? 'prev' : 'hidden';
---

<div class="gear-monolith" id="gear-monolith">
  <div class="gear-filter-toolbar" role="search" aria-label="Filter gear">
    <div class="gear-search-wrap">
      <svg class="gear-search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input
        type="search"
        id="gear-search-input"
        class="gear-search-input font-mono"
        placeholder="Filter gear (Sony, 90mm, Amaran, Ascaso, tripod)"
        aria-label="Search gear"
        autocomplete="off"
      />
      <button type="button" id="gear-search-clear" class="gear-search-clear" aria-label="Clear search" hidden>×</button>
    </div>
    <div class="gear-category-chips" role="group" aria-label="Gear categories">
      <button type="button" class="gear-chip active" data-cat="all" aria-pressed="true">All</button>
      {sections.map((sec) => (
        <button type="button" class="gear-chip" data-cat={sec.chipKey} aria-pressed="false">{sec.chip}</button>
      ))}
    </div>
  </div>

  <div id="gear-empty-state" class="gear-empty-state" hidden>
    <p class="gear-empty-text">No gear matches that search.</p>
    <button type="button" id="gear-reset-btn" class="gear-reset-btn font-mono">Reset filter</button>
  </div>

  <div class="gear-accordion-container" id="gear-accordion-container">
    {sections.map((sec, secIdx) => {
      const open = secIdx === 0;
      const n = sec.items.length;
      const hasAll = n > 6;
      return (
        <section
          class={`gear-accordion-section ${open ? 'is-expanded' : 'is-collapsed'}`}
          id={sec.domId}
          data-category={sec.slug}
          data-chip={sec.chipKey}
          data-pn-entry
          data-pn-label={sec.title}
          style={`--accent: ${sec.items[0].accent};`}
        >
          <div class="gear-accordion-header-bar">
            <h2 class="gear-accordion-heading">
              <button
                type="button"
                class="gear-accordion-header"
                aria-expanded={open ? 'true' : 'false'}
                aria-controls={`gear-body-${sec.slug}`}
              >
                <span class="gear-header-left">
                  <span class="box-idx font-mono">{sec.kicker}</span>
                  <span class="gear-header-title-row">
                    <span class="box-title">{sec.title}</span>
                    <span class="gear-item-count-badge font-mono">{n} {n === 1 ? 'piece' : 'pieces'}</span>
                  </span>
                  <span class="box-subtitle font-mono">{sec.subtitle}</span>
                </span>
                <span class="header-chevron" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </span>
              </button>
            </h2>
            <div class="gear-header-right btn-group btn-group--row">
              {hasAll && (
                <button
                  type="button"
                  class="btn-all-toggle font-mono"
                  data-all-toggle={sec.slug}
                  aria-expanded="false"
                  aria-controls={`all-grid-${sec.slug}`}
                >
                  <span class="all-toggle-label">Show all ({n})</span>
                </button>
              )}
              <a href={sec.collectionUrl} target="_blank" rel="noopener sponsored" class="influencer-pill font-mono">
                <span class="influencer-text">{sec.collectionLabel.replace(/ list$/i, '')}{/ list$/i.test(sec.collectionLabel) && <span class="influencer-text-long"> list</span>}</span>
                <svg width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                  <path d="M2.5 9.5L9.5 2.5M9.5 2.5H4.5M9.5 2.5V7.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            </div>
          </div>

          <div class="gear-accordion-body" id={`gear-body-${sec.slug}`}>
            <div class="gear-deck" data-deck={sec.slug}>
              <div class="deck-glow" aria-hidden="true">
                {sec.items.map((it, i) => (
                  <div
                    class={`deck-glow-layer ${i === 0 ? 'active' : ''}`}
                    data-glow-index={i}
                    data-glow-src={it.src || undefined}
                    style={`--glow: ${it.accent};${i === 0 && it.src ? ` --glow-img: url('${it.src}');` : ''}`}
                  ></div>
                ))}
              </div>

              <div
                class="deck-stage"
                data-deck-stage={sec.slug}
                role="group"
                aria-roledescription="carousel"
                aria-label={`${sec.title}: ${n} items`}
              >
                {sec.items.map((it, i) => {
                  const primary = it.stores[0];
                  const extraAffiliates = it.stores.filter((s) => s.affiliate).map((s) => s.store);
                  // The Amazon line covers Amazon links only (James Coffee Co.
                  // links to its own shop and carries no disclosure).
                  const hasAmazon = it.stores.some((s) => s.store === 'Amazon');
                  return (
                    <article
                      class={`deck-card ${stateOf(i, n)}`}
                      data-index={i}
                      data-accent={it.accent}
                      data-search={it.search}
                      aria-hidden={i === 0 ? 'false' : 'true'}
                      aria-label={it.name}
                    >
                      <div class="card-top">
                        <span class="card-tags">
                          {it.recommended && <span class="reco-badge font-mono">Recommended</span>}
                          <span class="card-badge font-mono">{it.tag || 'In the kit'}</span>
                          <span class="card-brand font-mono">{it.brand}</span>
                        </span>
                        <span class="card-counter font-mono" data-card-counter>{pad(i + 1)} / {pad(n)}</span>
                      </div>

                      <div class="card-visual">
                        {it.src ? (
                          <img
                            class="card-img"
                            src={it.src}
                            alt={it.name}
                            loading={secIdx === 0 && i < 3 ? 'eager' : 'lazy'}
                            decoding="async"
                            draggable="false"
                          />
                        ) : (
                          <div class="card-type" role="img" aria-label={it.name}>
                            <span class="card-type-brand font-mono">{it.brand}</span>
                            <span class="card-type-name">{it.short}</span>
                          </div>
                        )}
                      </div>

                      <div class="card-plate">
                        <h3 class="card-title">{it.name}</h3>
                        <p class="card-spec">{it.spec}</p>
                        <div class="card-actions">
                          <a
                            class="store-cta font-mono"
                            href={primary.url}
                            target="_blank"
                            rel="noopener sponsored"
                            data-store-cta
                            tabindex={i === 0 ? undefined : '-1'}
                          >
                            <span data-store-cta-label>{ctaLabel(primary)}</span>
                            <svg width="13" height="13" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                              <path d="M2.5 11.5L11.5 2.5M11.5 2.5H5.5M11.5 2.5V8.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                          </a>
                          {it.stores.length > 1 && (
                            <div class="store-picker" role="radiogroup" aria-label={`Store for ${it.short}`}>
                              {it.stores.map((s, si) => (
                                <button
                                  type="button"
                                  class="store-option font-mono"
                                  role="radio"
                                  aria-checked={si === 0 ? 'true' : 'false'}
                                  data-store-url={s.url}
                                  data-store-label={ctaLabel(s)}
                                  tabindex={i === 0 && si === 0 ? undefined : '-1'}
                                >
                                  {s.store}
                                </button>
                              ))}
                            </div>
                          )}
                          {it.video && (
                            <a
                              class="video-link font-mono"
                              href={it.video.url}
                              target="_blank"
                              rel="noopener sponsored"
                              tabindex={i === 0 ? undefined : '-1'}
                            >
                              {it.video.label}
                            </a>
                          )}
                        </div>
                        {(hasAmazon || extraAffiliates.length > 0) && (
                          <p class="card-disclosure font-mono">
                            {hasAmazon && 'As an Amazon Associate, I earn from qualifying purchases.'}
                            {extraAffiliates.length > 0 && ` The ${extraAffiliates.join(' and ')} link is an affiliate link${hasAmazon ? ' too' : ''}.`}
                          </p>
                        )}
                      </div>

                      <span class="card-spine" aria-hidden="true"><span class="spine-text">{it.short}</span></span>
                    </article>
                  );
                })}
              </div>

              <div class="deck-controls" role="group" aria-label={`${sec.title} item navigation`}>
                <button type="button" class="deck-step" data-deck-prev aria-label={`Previous ${sec.title} item`}>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="square" aria-hidden="true"><polyline points="15 18 9 12 15 6"></polyline></svg>
                  <span class="font-mono">Prev item</span>
                </button>
                <span class="deck-counter font-mono" data-deck-counter aria-live="polite">{pad(1)} / {pad(n)}</span>
                <button type="button" class="deck-step" data-deck-next aria-label={`Next ${sec.title} item`}>
                  <span class="font-mono">Next item</span>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="square" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>
                </button>
              </div>

              <div class="deck-thumb-track" role="tablist" aria-label={`${sec.title} items`}>
                {sec.items.map((it, i) => (
                  <button
                    type="button"
                    class={`deck-thumb-tile ${i === 0 ? 'is-active' : ''}`}
                    role="tab"
                    aria-selected={i === 0 ? 'true' : 'false'}
                    aria-label={it.name}
                    data-index={i}
                  >
                    <span class="thumb-tile-img-box">
                      {it.src ? (
                        <img src={it.src} alt="" aria-hidden="true" class="thumb-tile-img" loading="lazy" decoding="async" draggable="false" />
                      ) : (
                        <span class="thumb-tile-fallback font-mono">{it.brand}</span>
                      )}
                    </span>
                    <span class="thumb-tile-name">{it.short}</span>
                    {it.recommended && <span class="reco-badge reco-badge--thumb font-mono">Recommended</span>}
                  </button>
                ))}
              </div>
            </div>

            {hasAll && (
              <div class="gear-all-grid-view" id={`all-grid-${sec.slug}`} hidden data-all-view={sec.slug}>
                <div class="all-grid-topbar">
                  <h3 class="all-grid-title">{sec.title}: all {n}</h3>
                  <button type="button" class="btn-back-carousel font-mono" data-back-carousel={sec.slug}>Back to the deck</button>
                </div>
                <div class="all-grid-cards">
                  {sec.items.map((it) => (
                    <article class="all-grid-card" data-search={it.search}>
                      <div class="all-card-img-wrap">
                        {it.src ? (
                          <img src={it.src} alt={it.name} class="all-card-img" loading="lazy" decoding="async" />
                        ) : (
                          <span class="all-card-type" role="img" aria-label={it.name}>{it.short}</span>
                        )}
                      </div>
                      <div class="all-card-body">
                        {it.recommended && <span class="reco-badge reco-badge--grid font-mono">Recommended</span>}
                        <span class="all-card-tag font-mono">{it.tag || it.brand}</span>
                        <h4 class="all-card-name">{it.name}</h4>
                        <p class="all-card-spec">{it.spec}</p>
                        <div class="all-card-links">
                          {it.stores.map((s, si) => (
                            <a
                              href={s.url}
                              target="_blank"
                              rel="noopener sponsored"
                              class={`all-card-cta font-mono ${si === 0 ? 'is-primary' : ''}`}
                            >
                              {ctaLabel(s)}
                            </a>
                          ))}
                        </div>
                      </div>
                    </article>
                  ))}
                </div>
              </div>
            )}
          </div>
        </section>
      );
    })}
  </div>
</div>

<style>
  /* ------------------------------------------------------------------
     Toolbar
     ------------------------------------------------------------------ */
  .gear-filter-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 1.25rem;
    padding-bottom: 1.5rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--line, rgba(255, 255, 255, 0.12));
  }
  .gear-search-wrap {
    position: relative;
    display: flex;
    align-items: center;
    flex: 1 1 280px;
    max-width: 480px;
  }
  .gear-search-icon {
    position: absolute;
    left: 1rem;
    color: var(--muted, #888);
    pointer-events: none;
  }
  .gear-search-input {
    width: 100%;
    min-height: 44px;
    padding: 0.7rem 2.75rem;
    background: #0d0d0d;
    border: 1px solid rgba(255, 255, 255, 0.16);
    color: #fff;
    font-size: 0.8rem;
    letter-spacing: 0.04em;
  }
  .gear-search-input:focus {
    outline: none;
    border-color: #fff;
  }
  .gear-search-clear {
    position: absolute;
    right: 0;
    width: 44px;
    height: 44px;
    background: none;
    border: none;
    color: var(--muted, #888);
    font-size: 1.25rem;
    cursor: pointer;
  }
  .gear-search-clear:hover {
    color: #fff;
  }
  /* Every chip the same size (the house rule for buttons that sit
     together): equal columns at least as wide as the longest label,
     wrapping whole chips on a phone. Em of the chips' own type. */
  .gear-category-chips {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    width: max-content;
    max-width: 100%;
    gap: 0.4rem;
    font-size: 0.68rem;
  }
  @media (max-width: 600px) {
    .gear-category-chips {
      grid-auto-flow: row;
      grid-template-columns: repeat(auto-fill, minmax(9em, 1fr));
      width: 100%;
    }
  }
  .gear-chip {
    min-height: 44px;
    padding: 0.4rem 0.85rem;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.16);
    color: var(--muted, #888);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
  }
  .gear-chip:hover {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.4);
  }
  .gear-chip.active {
    background: #fff;
    border-color: #fff;
    color: #000;
  }
  .gear-empty-state {
    padding: 3rem 1rem;
    text-align: center;
    border: 1px dashed rgba(255, 255, 255, 0.16);
  }
  .gear-empty-text {
    color: var(--muted, #888);
    margin: 0 0 1rem;
  }
  .gear-reset-btn {
    min-height: 44px;
    padding: 0.5rem 1rem;
    background: #fff;
    color: #000;
    border: none;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
  }

  /* ------------------------------------------------------------------
     Section stack: every header visible, one open at a time
     ------------------------------------------------------------------ */
  .gear-accordion-container {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .gear-accordion-section {
    --accent: 176, 184, 196;
    position: relative;
    background: #080808;
    border: 1px solid rgba(255, 255, 255, 0.1);
    /* The site's global `section` padding would open a dead band above
       every header. */
    padding: 0;
    /* Nothing inside (the glow, a card parked off to the right) may push
       the page sideways. No iframe lives in here, so clipping is safe. */
    overflow-x: clip;
    /* Anchor jumps (/gear/#brew) stop clear of the fixed header. Opening a
       section scrolls with explicit math in the script, not this. */
    scroll-margin-top: calc(var(--gear-nav-h, 88px) + 1.5rem);
    transition: border-color 0.3s ease;
  }
  .gear-accordion-section.is-expanded {
    border-color: rgba(255, 255, 255, 0.24);
  }
  .gear-accordion-header-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-right: 1.25rem;
    background: #0e0e0e;
    cursor: pointer;
    transition: background 0.2s ease;
  }
  .gear-accordion-header-bar:hover {
    background: #141414;
  }
  .gear-accordion-heading {
    margin: 0;
    font: inherit;
    flex: 1;
    min-width: 0;
  }
  .gear-accordion-header {
    appearance: none;
    width: 100%;
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.1rem 0.5rem 1.1rem 1.5rem;
    background: none;
    border: none;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  .gear-accordion-header:focus-visible {
    outline: 2px solid #fff;
    outline-offset: -2px;
  }
  .gear-header-left {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    flex: 1;
    min-width: 0;
  }
  .box-idx {
    font-size: 0.66rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted, #888);
  }
  .gear-header-title-row {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .box-title {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 2.2vw, 1.8rem);
    font-weight: 800;
    line-height: 1.1;
    color: #fff;
  }
  .gear-item-count-badge {
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted, #888);
    border: 1px solid rgba(255, 255, 255, 0.12);
    padding: 0.15rem 0.45rem;
  }
  .box-subtitle {
    font-size: 0.74rem;
    color: var(--muted, #888);
  }
  .header-chevron {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: var(--muted, #888);
    transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1), color 0.2s ease, border-color 0.2s ease;
  }
  .gear-accordion-section.is-expanded .header-chevron {
    transform: rotate(180deg);
    color: #fff;
    border-color: rgba(255, 255, 255, 0.4);
  }
  .gear-header-right {
    --btn-group-gap: 0.5rem;
    align-items: center;
    flex-shrink: 0;
  }
  .influencer-pill,
  .btn-all-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
