</style>

<script>
  (() => {
    function setNavHeight() {
      const nav = document.querySelector<HTMLElement>('.site-nav');
      const h = nav ? Math.round(nav.getBoundingClientRect().height) : 0;
      if (h > 0) document.documentElement.style.setProperty('--gear-nav-h', `${h}px`);
    }

    function init() {
      const root = document.getElementById('gear-accordion-container');
      if (!root || root.dataset.gearWired === '1') return;
      root.dataset.gearWired = '1';
      setNavHeight();
      window.addEventListener('resize', setNavHeight, { passive: true });

      const sections = Array.from(root.querySelectorAll<HTMLElement>('.gear-accordion-section'));
      const decks = new Map<HTMLElement, { refresh: () => void }>();

      const setOpen = (section: HTMLElement, open: boolean) => {
        section.classList.toggle('is-expanded', open);
        section.classList.toggle('is-collapsed', !open);
        section.querySelector('.gear-accordion-header')?.setAttribute('aria-expanded', String(open));
      };

      /** Open one section and close the rest; or close it if it is open. */
      function toggleSection(section: HTMLElement, force?: boolean) {
        const open = force ?? !section.classList.contains('is-expanded');
        sections.forEach((s) => setOpen(s, open && s === section));
        if (open) {
          decks.get(section)?.refresh();
          // Keep what was opened in view, and never under the fixed header:
          // explicit math from the header's measured bottom, not
          // scrollIntoView (which trusts a fixed scroll-padding). On a short
          // screen (a phone on its side) the header and the hero cannot both
          // fit, so the HERO (.deck-stage) is what gets brought into view.
          requestAnimationFrame(() => {
            const header = document.querySelector<HTMLElement>('.site-nav');
            const headerBottom = header ? Math.max(0, header.getBoundingClientRect().bottom) : 88;
            const behavior: ScrollBehavior = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';
            const short = window.innerHeight < 560;
            const target = short ? section.querySelector<HTMLElement>('.deck-stage') : section;
            if (!target) return;
            const want = headerBottom + (short ? 8 : 16);
            const top = target.getBoundingClientRect().top;
            // Tall screens: move when the header is under the nav, or when the
            // hero runs off the bottom (a phone opening a lower section).
            const stage = section.querySelector<HTMLElement>('.deck-stage');
            const heroCut = !!stage && stage.getBoundingClientRect().bottom > window.innerHeight;
            const needs = short ? Math.abs(top - want) > 4 : top < want || heroCut;
            if (needs) window.scrollTo({ top: Math.max(0, window.scrollY + top - want), behavior });
          });
        }
      }

      sections.forEach((section) => {
        const bar = section.querySelector<HTMLElement>('.gear-accordion-header-bar');
        bar?.addEventListener('click', (e) => {
          if ((e.target as HTMLElement).closest('.influencer-pill, .btn-all-toggle')) return;
          toggleSection(section);
        });

        const stage = section.querySelector<HTMLElement>('.deck-stage');
        const cards = Array.from(section.querySelectorAll<HTMLElement>('.deck-card'));
        const thumbs = Array.from(section.querySelectorAll<HTMLElement>('.deck-thumb-tile'));
        const glows = Array.from(section.querySelectorAll<HTMLElement>('.deck-glow-layer'));
        const gridCards = Array.from(section.querySelectorAll<HTMLElement>('.all-grid-card'));
        const counter = section.querySelector<HTMLElement>('[data-deck-counter]');
        const deck = section.querySelector<HTMLElement>('.gear-deck');
        const allView = section.querySelector<HTMLElement>('[data-all-view]');
        const allToggle = section.querySelector<HTMLButtonElement>('.btn-all-toggle');
        if (!stage || !cards.length) return;

        let active = 0;
        let visible = cards.map((_, i) => i);
        const pad = (n: number) => String(n).padStart(2, '0');

        function render(focusThumb = false) {
          if (!visible.includes(active)) active = visible[0] ?? 0;
          const pos = visible.indexOf(active);
          const count = visible.length;
          const at = (k: number) => visible[(pos + k + count) % count];
          const n1 = count > 1 ? at(1) : -1;
          const n2 = count > 2 ? at(2) : -1;
          const pv = count > 3 ? at(-1) : -1;

          cards.forEach((card, i) => {
            const shown = visible.includes(i);
            card.classList.toggle('is-filtered-out', !shown);
            card.classList.remove('active', 'next-1', 'next-2', 'prev', 'hidden');
            card.classList.add(i === active ? 'active' : i === n1 ? 'next-1' : i === n2 ? 'next-2' : i === pv ? 'prev' : 'hidden');
            const isActive = i === active;
            card.setAttribute('aria-hidden', String(!isActive));
            card.querySelectorAll<HTMLElement>('a, button').forEach((el) => {
              if (isActive) {
                if (el.classList.contains('store-option') && el.getAttribute('aria-checked') !== 'true') el.tabIndex = -1;
                else el.removeAttribute('tabindex');
              } else el.tabIndex = -1;
            });
            const c = card.querySelector('[data-card-counter]');
            if (c && isActive) c.textContent = `${pad(pos + 1)} / ${pad(count)}`;
          });

          thumbs.forEach((t, i) => {
            const isActive = i === active;
            t.classList.toggle('is-filtered-out', !visible.includes(i));
            t.classList.toggle('is-active', isActive);
            t.setAttribute('aria-selected', String(isActive));
            t.tabIndex = isActive ? 0 : -1;
          });
          gridCards.forEach((g, i) => g.classList.toggle('is-filtered-out', !visible.includes(i)));
          glows.forEach((g, i) => {
            const isActive = i === active;
            g.classList.toggle('active', isActive);
            if (isActive && g.dataset.glowSrc && !g.style.getPropertyValue('--glow-img')) {
              g.style.setProperty('--glow-img', `url('${g.dataset.glowSrc}')`);
            }
          });

          const accent = cards[active]?.dataset.accent;
          if (accent) section.style.setProperty('--accent', accent);
          if (counter) counter.textContent = `${pad(pos + 1)} / ${pad(count)}`;

          const thumb = thumbs[active];
          const track = thumb?.parentElement;
          if (thumb && track && track.scrollWidth > track.clientWidth) {
            track.scrollTo({ left: thumb.offsetLeft - track.clientWidth / 2 + thumb.offsetWidth / 2, behavior: 'smooth' });
          }
          if (focusThumb) thumb?.focus({ preventScroll: true });
        }

        const go = (index: number, focusThumb = false) => {
          if (index === active || !visible.includes(index)) return;
          active = index;
          render(focusThumb);
        };
        const step = (dir: 1 | -1, focusThumb = false) => {
          if (visible.length < 2) return;
          const pos = visible.indexOf(active);
          go(visible[(pos + dir + visible.length) % visible.length], focusThumb);
        };

        decks.set(section, {
          refresh: () => render(),
        });
        (section as HTMLElement & { _gearFilter?: (q: string) => number })._gearFilter = (q: string) => {
          visible = cards
            .map((c, i) => ({ c, i }))
            .filter(({ c }) => !q || (c.dataset.search || '').includes(q))
            .map(({ i }) => i);
          if (visible.length) render();
          return visible.length;
        };

        // Thumbnails and peeking cards bring an item forward.
        thumbs.forEach((t, i) => t.addEventListener('click', () => go(i)));

        // Item navigation (inside the deck, not the section header).
        section.querySelector('[data-deck-prev]')?.addEventListener('click', () => step(-1));
        section.querySelector('[data-deck-next]')?.addEventListener('click', () => step(1));

        // Keyboard: arrows anywhere in the deck rotate it.
        deck?.addEventListener('keydown', (e) => {
          if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
          const onThumb = (e.target as HTMLElement).closest('.deck-thumb-tile');
          if ((e.target as HTMLElement).closest('.store-picker')) return; // radios own their arrows
          e.preventDefault();
          step(e.key === 'ArrowRight' ? 1 : -1, Boolean(onThumb));
        });

        // Store picker: choosing a store re-points the one primary CTA.
        cards.forEach((card) => {
          const cta = card.querySelector<HTMLAnchorElement>('[data-store-cta]');
          const label = card.querySelector<HTMLElement>('[data-store-cta-label]');
          const options = Array.from(card.querySelectorAll<HTMLButtonElement>('.store-option'));
          const choose = (opt: HTMLButtonElement, focus = false) => {
            options.forEach((o) => {
              const on = o === opt;
              o.setAttribute('aria-checked', String(on));
              o.tabIndex = on ? 0 : -1;
            });
            if (cta && opt.dataset.storeUrl) cta.href = opt.dataset.storeUrl;
            if (label && opt.dataset.storeLabel) label.textContent = opt.dataset.storeLabel;
            if (focus) opt.focus();
          };
          options.forEach((opt, oi) => {
            opt.addEventListener('click', (e) => {
              e.stopPropagation();
              choose(opt);
            });
            opt.addEventListener('keydown', (e) => {
              if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
              e.preventDefault();
              const next = options[(oi + (e.key === 'ArrowRight' ? 1 : -1) + options.length) % options.length];
              choose(next, true);
            });
          });
        });

        // Drag and swipe: mouse, pen and touch alike. The front card follows
        // the pointer (the `translate` property, which composes with the
        // class transform), and a release past the threshold rotates.
        let startX = 0;
        let startY = 0;
        let dx = 0;
        let tracking = false;
        let dragging = false;
        let suppressClick = false;
        const SWIPE = 50;

        const endDrag = () => {
          tracking = false;
          stage.classList.remove('is-dragging');
          cards[active]?.style.removeProperty('translate');
          if (dragging) {
            if (dx <= -SWIPE) step(1);
            else if (dx >= SWIPE) step(-1);
            suppressClick = true;
            window.setTimeout(() => (suppressClick = false), 0);
          }
          dragging = false;
          dx = 0;
        };

        stage.addEventListener('pointerdown', (e) => {
          if (e.button !== 0) return;
          if ((e.target as HTMLElement).closest('a, button, input')) return;
          tracking = true;
          dragging = false;
          startX = e.clientX;
          startY = e.clientY;
          dx = 0;
        });
        stage.addEventListener('pointermove', (e) => {
          if (!tracking) return;
          dx = e.clientX - startX;
          const dy = e.clientY - startY;
          if (!dragging) {
            if (Math.abs(dx) > 8 && Math.abs(dx) > Math.abs(dy)) {
              dragging = true;
              stage.classList.add('is-dragging');
              try {
                stage.setPointerCapture(e.pointerId);
              } catch {
                /* not capturable: window listeners still end the drag */
              }
            } else if (Math.abs(dy) > 12) {
              tracking = false; // a vertical scroll, not a swipe
              return;
            }
          }
          if (dragging) {
            e.preventDefault();
            cards[active]?.style.setProperty('translate', `${dx * 0.6}px 0`);
          }
        });
        stage.addEventListener('pointerup', endDrag);
        stage.addEventListener('pointercancel', endDrag);
        // Touch starts with implicit capture on the element under the finger;
        // taking capture for the stage fires lostpointercapture on THAT
        // element, which bubbles here. Only the stage losing it ends a drag.
        stage.addEventListener('lostpointercapture', (e) => {
          if (e.target === stage && tracking) endDrag();
        });

        // A click on a peeking card brings it forward (never after a drag).
        stage.addEventListener('click', (e) => {
          if (suppressClick) {
            e.preventDefault();
            e.stopPropagation();
            return;
          }
          const card = (e.target as HTMLElement).closest<HTMLElement>('.deck-card');
          if (!card || card.classList.contains('active')) return;
          e.preventDefault();
          go(Number(card.dataset.index));
        }, true);

        // Trackpad: a horizontal two-finger swipe moves one card, fired on
        // the leading edge (40px of deltaX) and then locked. Ported from the
        // HQ /featured deck, which hit the same bug first.
        //
        // The lock used to be released by silence alone (140ms with no
        // wheel events). macOS keeps sending momentum events for a second
        // or two after the fingers lift, and each one re-armed the timer,
        // so a second swipe made during that tail was swallowed: "swipe,
        // swipe again, nothing happens" until the pointer left the deck.
        //
        // Now the lock is also released by INPUT, in two stages. A momentum
        // tail peaks and then only decays, so: (1) while still near the peak
        // it is the rest of the push that already fired, and never releases;
        // (2) once it has fallen to 60% of the peak it is coasting, and a
        // delta that climbs well back above the lowest point so far (2.5x
        // the trough, and at least 10px) can only be fingers on the pad
        // again. Measuring against the trough, not the previous sample, is
        // what keeps noisy macOS momentum from re-arming it. MIN_FIRE_GAP
        // makes "one swipe, one card" unconditional; the quiet timer stays
        // as a backstop.
        const SWIPE_DELTA = 40;
        const QUIET_MS = 120;
        const TAIL_RATIO = 0.6;
        const REARM_FACTOR = 2.5;
        const REARM_FLOOR = 10;
        const MIN_FIRE_GAP = 220;
        let wheelAcc = 0;
        let wheelLocked = false;
        let peak = 0;
        let tailing = false;
        let trough = Infinity;
        let lastFire = -Infinity;
        let quietTimer = 0;
        const releaseWheel = () => {
          wheelLocked = false;
          wheelAcc = 0;
          peak = 0;
          tailing = false;
          trough = Infinity;
        };
        stage.addEventListener('wheel', (e) => {
          if (Math.abs(e.deltaX) <= Math.abs(e.deltaY)) return;
          e.preventDefault();
          const abs = Math.abs(e.deltaX);
          window.clearTimeout(quietTimer);
          quietTimer = window.setTimeout(releaseWheel, QUIET_MS);
          if (wheelLocked) {
            if (abs > peak) peak = abs;
            if (!tailing) {
              if (abs < peak * TAIL_RATIO) {
                tailing = true;
                trough = abs;
              }
              return;
            }
            if (abs < trough) trough = abs;
            if (abs < REARM_FLOOR || abs < trough * REARM_FACTOR) return;
            releaseWheel();
          }
          wheelAcc += e.deltaX;
          if (Math.abs(wheelAcc) < SWIPE_DELTA) return;
          const now = e.timeStamp || performance.now();
          if (now - lastFire < MIN_FIRE_GAP) {
            wheelAcc = 0;
            return;
          }
          const forward = wheelAcc > 0;
          wheelLocked = true;
          peak = abs;
          tailing = false;
          trough = Infinity;
          lastFire = now;
          wheelAcc = 0;
          step(forward ? 1 : -1);
        }, { passive: false });

        // Show all <-> deck.
        const showAll = (on: boolean) => {
          if (!allView || !deck) return;
          if (on && !section.classList.contains('is-expanded')) toggleSection(section, true);
          allView.hidden = !on;
          deck.hidden = on;
          allToggle?.setAttribute('aria-expanded', String(on));
          const lbl = allToggle?.querySelector('.all-toggle-label');
          if (lbl) lbl.textContent = on ? 'Deck view' : `Show all (${cards.length})`;
        };
        allToggle?.addEventListener('click', (e) => {
          e.stopPropagation();
          showAll(Boolean(allView?.hidden));
        });
        section.querySelectorAll('[data-back-carousel]').forEach((b) => b.addEventListener('click', () => showAll(false)));

        render();
      });

      // Search and chips: a section shows only its matches; its hero,
      // counter, peeking cards and thumbnails all follow the matches.
      const input = document.getElementById('gear-search-input') as HTMLInputElement | null;
      const clear = document.getElementById('gear-search-clear') as HTMLButtonElement | null;
      const empty = document.getElementById('gear-empty-state');
      const reset = document.getElementById('gear-reset-btn');
      const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.gear-chip'));
      let cat = 'all';
      let query = '';

      function apply() {
        let total = 0;
        let firstShown: HTMLElement | null = null;
        sections.forEach((s) => {
          const inCat = cat === 'all' || s.dataset.chip === cat;
          const filter = (s as HTMLElement & { _gearFilter?: (q: string) => number })._gearFilter;
          const matches = inCat && filter ? filter(query) : 0;
          s.hidden = !inCat || matches === 0;
          total += s.hidden ? 0 : matches;
          if (!s.hidden && !firstShown) firstShown = s;
        });
        if (empty) empty.hidden = total > 0;
        if (clear) clear.hidden = !query;
        if (firstShown && (query || cat !== 'all')) {
          sections.forEach((s) => setOpen(s, s === firstShown));
          decks.get(firstShown)?.refresh();
        }
      }

      chips.forEach((chip) =>
        chip.addEventListener('click', () => {
          chips.forEach((c) => {
            c.classList.toggle('active', c === chip);
            c.setAttribute('aria-pressed', String(c === chip));
          });
          cat = chip.dataset.cat || 'all';
          apply();
        })
      );
      input?.addEventListener('input', () => {
        query = input.value.trim().toLowerCase();
        apply();
      });
      clear?.addEventListener('click', () => {
        if (input) input.value = '';
        query = '';
        apply();
        input?.focus();
      });
      reset?.addEventListener('click', () => {
        if (input) input.value = '';
        query = '';
        cat = 'all';
        chips.forEach((c) => {
          c.classList.toggle('active', c.dataset.cat === 'all');
          c.setAttribute('aria-pressed', String(c.dataset.cat === 'all'));
        });
        apply();
      });
    }

    init();
    document.addEventListener('astro:page-load', init);
  })();
</script>
