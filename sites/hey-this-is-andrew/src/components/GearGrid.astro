---
import type { CollectionEntry } from 'astro:content';

interface Props {
  categories: CollectionEntry<'gear'>[];
}

const { categories } = Astro.props;

// Order map: Camera Bodies hero first, then Lenses, Lighting, Audio, Tools & Support
const orderMap: Record<string, number> = {
  'Camera Bodies': 1,
  'Lens': 2,
  'Lighting': 3,
  'Audio': 4,
  'Tools & Support': 5,
};

const sortedCats = [...categories].sort((a, b) => {
  const oA = orderMap[a.data.category] || a.data.order || 99;
  const oB = orderMap[b.data.category] || b.data.order || 99;
  return oA - oB;
});

// Audio is intentionally excluded if Andrew owns 0 items
const activeCats = sortedCats.filter(c => c.data.items && c.data.items.length > 0 && c.data.category !== 'Audio');

import { AMAZON_STOREFRONT } from '../data/storefront';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase.slice(0, -1) : rawBase;
const resolveAsset = (img?: string) => {
  if (!img) return '';
  if (img.startsWith('http://') || img.startsWith('https://')) return img;
  const clean = img.startsWith('/') ? img : `/${img}`;
  return `${base}${clean}`;
};

const isProductUrl = (url?: string) => Boolean(url && url.trim() && url !== AMAZON_STOREFRONT);

const getSystemKicker = (catName: string, idx: number) => {
  if (catName === 'Camera Bodies') return `01 / HERO SYSTEM`;
  if (catName === 'Lens') return `02 / OPTICAL SYSTEM`;
  if (catName === 'Lighting') return `03 / ILLUMINATION`;
  if (catName === 'Tools & Support') return `04 / STABILIZATION & RIG`;
  return `0${idx + 1} / PRODUCTION GEAR`;
};

const getCategorySlug = (catName: string) => {
  if (catName === 'Camera Bodies') return 'bodies';
  if (catName === 'Lens') return 'lenses';
  if (catName === 'Lighting') return 'lighting';
  if (catName === 'Tools & Support') return 'tools';
  return catName.toLowerCase().replace(/\s+/g, '-');
};

const getCategoryLabel = (catName: string) => {
  if (catName === 'Camera Bodies') return 'Cameras';
  if (catName === 'Lens') return 'Lenses';
  if (catName === 'Lighting') return 'Lighting';
  if (catName === 'Tools & Support') return 'Support';
  return catName;
};
---

<div class="gear-monolith" id="gear-monolith">
  <!-- Gear Instant Search & Category Filter Toolbar -->
  <div class="gear-filter-toolbar" role="search" aria-label="Filter gear loadout">
    <div class="gear-search-wrap">
      <svg class="gear-search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input
        type="search"
        id="gear-search-input"
        class="gear-search-input"
        placeholder="Filter equipment (e.g. Sony, 24-70mm, Amaran, tripod)..."
        aria-label="Search gear"
      />
      <button type="button" id="gear-search-clear" class="gear-search-clear" aria-label="Clear search" hidden>×</button>
    </div>
    <div class="gear-category-chips" role="tablist" aria-label="Gear categories">
      <button type="button" class="gear-chip active" data-cat="all" role="tab" aria-selected="true">All</button>
      {activeCats.map(cat => {
        const catKey = getCategorySlug(cat.data.category);
        const label = getCategoryLabel(cat.data.category);
        return (
          <button type="button" class="gear-chip" data-cat={catKey} role="tab" aria-selected="false">{label}</button>
        );
      })}
    </div>
  </div>

  <div id="gear-empty-state" class="gear-empty-state" hidden>
    <p class="gear-empty-text">No equipment matches your search filter.</p>
    <button type="button" id="gear-reset-btn" class="gear-reset-btn">Reset Filter</button>
  </div>

  <!-- ACCORDION DIRECTORY (ONE GROUP OPEN AT A TIME) -->
  <div class="gear-accordion-deck-container" id="gear-accordion-container">
    {activeCats.map((cat, catIdx) => {
      const catKey = getCategorySlug(cat.data.category);
      const anchorId = `gear-${catKey}`;
      const isDefaultExpanded = catIdx === 0;
      const isLenses = cat.data.category === 'Lens';
      const isLighting = cat.data.category === 'Lighting';
      const isTools = cat.data.category === 'Tools & Support';
      const isBodies = cat.data.category === 'Camera Bodies';
      const items = cat.data.items;
      const defaultItem = items[0];
      const hasProduct = isProductUrl(defaultItem?.affiliateUrl);
      const hasAllView = items.length > 6; // Threshold: sections with > 6 items get an All View

      // Unique IDs for element backward-compatibility with e2e tests
      const imgId = isBodies ? 'preview-camera-img' : `img-${anchorId}`;
      const ctaId = isBodies ? 'preview-camera-btn' : `cta-${anchorId}`;
      const brandId = isBodies ? 'preview-camera-brand' : `brand-${anchorId}`;
      const titleId = isBodies ? 'preview-camera-title' : `title-${anchorId}`;
      const descId = isBodies ? 'preview-camera-desc' : `desc-${anchorId}`;
      const tagId = isBodies ? 'preview-camera-tag' : `tag-${anchorId}`;

      return (
        <section
          class={`gear-accordion-section ${isDefaultExpanded ? 'is-expanded' : 'is-collapsed'}`}
          id={anchorId}
          data-category-slug={anchorId}
          data-category={catKey}
          data-pn-entry
          data-pn-label={getCategoryLabel(cat.data.category)}
        >
          {isLenses && (
            <>
              <span id="gear-zooms" class="vh" aria-hidden="true"></span>
              <span id="gear-primes" class="vh" aria-hidden="true"></span>
            </>
          )}
          {isLighting && (
            <>
              <span id="gear-lights" class="vh" aria-hidden="true"></span>
              <span id="gear-flash" class="vh" aria-hidden="true"></span>
            </>
          )}

          <!-- ACCORDION HEADER (CLICK EXPANDS THIS GROUP & COLLAPSES OTHERS) -->
          <div class="gear-accordion-header-bar">
            <h2 class="gear-accordion-heading">
              <button
                type="button"
                class="gear-accordion-header"
                aria-expanded={isDefaultExpanded ? 'true' : 'false'}
                aria-controls={`gear-body-${catKey}`}
              >
                <span class="gear-header-left">
                  <span class="box-idx font-mono">{getSystemKicker(cat.data.category, catIdx)}</span>
                  <span class="gear-header-title-row">
                    <span class="box-title">{cat.data.category}</span>
                    <span class="gear-item-count-badge font-mono">{items.length} PIECES VERIFIED</span>
                  </span>
                  <span class="box-subtitle">{cat.data.subtitle}</span>
                </span>
              </button>
            </h2>

            <div class="gear-header-right">
              {hasAllView && (
                <button
                  type="button"
                  class="btn-all-toggle font-mono"
                  data-all-toggle={catKey}
                  aria-expanded="false"
                  aria-controls={`all-grid-${catKey}`}
                  title="Toggle multi-column grid of all items"
                >
                  <span class="all-toggle-label">Show All ({items.length})</span>
                  <span class="all-toggle-icon" aria-hidden="true">⊞</span>
                </button>
              )}

              <a
                href={AMAZON_STOREFRONT}
                target="_blank"
                rel="noopener noreferrer"
                class="influencer-pill"
                aria-label="Visit the storefront"
              >
                <span class="influencer-dot"></span>
                <span class="influencer-text">Visit the storefront</span>
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                  <path d="M2.5 9.5L9.5 2.5M9.5 2.5H4.5M9.5 2.5V7.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>

              <button
                type="button"
                class="accordion-chevron-btn"
                aria-label={`Toggle ${cat.data.category} section`}
                aria-expanded={isDefaultExpanded ? 'true' : 'false'}
                data-accordion-toggle={catKey}
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </button>
            </div>
          </div>

          <!-- ACCORDION BODY -->
          <div class="gear-accordion-body" id={`gear-body-${catKey}`}>
            <!-- CAROUSEL / DECK STAGE VIEW (HERO SPEC CARD + PEEKING SLATS + CONTROLS) -->
            <div class="gear-deck-view" data-deck-container={catKey}>
              <!-- MAIN STAGE: HERO CARD + RIGHT PEEKING SLATS -->
              <div class="gear-deck-stage" data-deck-stage={catKey}>
                <!-- HERO SPECIFICATION CARD -->
                <div class="gear-hero-spec-card" data-hero-spec={catKey}>
                  <div class="spec-card-badge-row">
                    <span class="spec-card-verified-tag font-mono">
                      {isBodies ? 'STUDIO VERIFIED' : 'FIELD VERIFIED'}
                    </span>
                    <span class="spec-card-item-tag font-mono" id={tagId}>
                      {defaultItem?.tag || 'Production Spec'}
                    </span>
                    <span class="spec-card-counter font-mono" data-card-counter={catKey}>
                      01 / 0{items.length}
                    </span>
                  </div>

                  <!-- PRODUCT VISUAL STAGE & SPEC SPLIT -->
                  <div class="spec-card-split-content">
                    <div class="spec-card-visual-col">
                      <div class="product-visual-stage">
                        <img
                          id={imgId}
                          class="product-visual-img"
                          src={resolveAsset(defaultItem?.image)}
                          alt=""
                          hidden={!defaultItem?.image}
                        />
                        <div class="schematic-wrap" id={`schematic-${anchorId}`} hidden={Boolean(defaultItem?.image)}>
                          <svg class="camera-schematic" viewBox="0 0 260 180" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                            <rect x="20" y="45" width="220" height="120" rx="3" fill="#141414" stroke="#333" stroke-width="2"/>
                            <circle cx="130" cy="105" r="48" fill="#0d0d0d" stroke="#555" stroke-width="2"/>
                            <text x="130" y="16" fill="#888" font-family="'JetBrains Mono', monospace" font-size="9" text-anchor="middle" font-weight="bold">FIELD HARDWARE // KIT</text>
                          </svg>
                        </div>
                      </div>
                    </div>

                    <!-- SPECIFICATION DETAILS & AMAZON CTA -->
                    <div class="spec-card-info-col">
                      <div class="spec-card-naming">
                        <span class="spec-card-brand-label font-mono" id={brandId}>
                          {(defaultItem?.brand || 'CURATED PRODUCTION').toUpperCase()} // KIT
                        </span>
                        <h3 class="spec-card-item-title" id={titleId}>
                          {defaultItem?.name}
                        </h3>
                        <p class="spec-card-item-desc" id={descId}>
                          {defaultItem?.spec}
                        </p>
                      </div>

                      <div class="spec-card-action-block">
                        <a
                          href={defaultItem?.affiliateUrl || AMAZON_STOREFRONT}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="btn-primary-influencer"
                          id={ctaId}
                        >
                          <span class="amz-btn-text">
                            {hasProduct ? `View ${defaultItem?.name} on Amazon` : 'Visit the storefront'}
                          </span>
                          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true" focusable="false">
                            <path d="M2.5 11.5L11.5 2.5M11.5 2.5H5.5M11.5 2.5V8.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                          </svg>
                        </a>
                        <span class="preview-disclosure font-mono">
                          As an Amazon Associate, I earn from qualifying purchases.
                        </span>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- RIGHT PEEKING VERTICAL SLATS (HQ FEATURED PATTERN) -->
                <div class="deck-slats-stack" aria-hidden="true">
                  {items.map((item, itemIdx) => {
                    const isNext1 = itemIdx === 1;
                    const isNext2 = itemIdx === 2;
                    const initialClass = isNext1 ? 'deck-slat next-1' : isNext2 ? 'deck-slat next-2' : 'deck-slat hidden';
                    return (
                      <div
                        class={initialClass}
                        data-slat-index={itemIdx}
                        data-cat-slug={catKey}
                        title={`Click to view ${item.name}`}
                      >
                        <div class="peeking-spine">
                          <span class="spine-text">{item.name}</span>
                        </div>
                        {item.image && (
                          <img src={resolveAsset(item.image)} alt="" class="slat-peek-img" loading="lazy" />
                        )}
                      </div>
                    );
                  })}
                </div>

                <!-- CONTROLS: PREV / NEXT ARROWS (EXPLICIT GEAR ENHANCEMENTS) -->
                <div class="deck-arrows-wrap">
                  <button
                    type="button"
                    class="deck-nav-arrow deck-nav-prev"
                    data-deck-prev={catKey}
                    aria-label={`Previous ${cat.data.category} item`}
                  >
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="15 18 9 12 15 6"></polyline>
                    </svg>
                  </button>
                  <button
                    type="button"
                    class="deck-nav-arrow deck-nav-next"
                    data-deck-next={catKey}
                    aria-label={`Next ${cat.data.category} item`}
                  >
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="9 18 15 12 9 6"></polyline>
                    </svg>
                  </button>
                </div>
              </div>

              <!-- THUMBNAIL STRIP BELOW (HQ FEATURED MANIFEST THUMBNAILS) -->
              <div
                class="deck-thumb-track"
                role="tablist"
                aria-label={`${cat.data.category} rotation`}
                data-thumb-track={catKey}
              >
                {items.map((item, itemIdx) => {
                  const itemHasProduct = isProductUrl(item.affiliateUrl);
                  const rowClass = isBodies ? 'camera-item-row' : 'collage-item-row';
                  return (
                    <button
                      type="button"
                      class={`deck-thumb-tile ${rowClass} ${itemIdx === 0 ? 'is-active' : ''}`}
                      role="tab"
                      tabindex="0"
                      aria-selected={itemIdx === 0 ? 'true' : 'false'}
                      aria-label={`Select ${item.name}`}
                      data-subcat={anchorId}
                      data-item-index={itemIdx}
                      data-item-name={item.name}
                      data-item-brand={item.brand || (item.name.includes('Sony') ? 'Sony' : 'Curated Kit')}
                      data-item-spec={item.spec}
                      data-item-tag={item.tag || (itemIdx === 0 ? 'Primary Workhorse' : 'Production Spec')}
                      data-item-url={item.affiliateUrl || AMAZON_STOREFRONT}
                      data-has-product-url={itemHasProduct ? 'true' : 'false'}
                      data-item-image={resolveAsset(item.image)}
                      data-item-image-alt={item.imageAlt || item.name}
                      data-cat-slug={catKey}
                    >
                      <div class="thumb-tile-img-box">
                        {item.image ? (
                          <img src={resolveAsset(item.image)} alt="" class="thumb-tile-img" loading="lazy" />
                        ) : (
                          <div class="thumb-tile-fallback font-mono">{item.name.slice(0, 3)}</div>
                        )}
                      </div>
                      <div class="thumb-tile-meta">
                        <span class="thumb-tile-name">{item.name}</span>
                        <span class="thumb-tile-tag font-mono">{item.tag || 'Verified'}</span>
                      </div>
                      <span class="thumb-tile-glow" aria-hidden="true"></span>
                    </button>
                  );
                })}
              </div>
            </div>

            <!-- "ALL" MULTI-COLUMN TILE GRID VIEW (FOR SECTIONS WITH > 6 ITEMS, E.G. LENSES) -->
            {hasAllView && (
              <div class="gear-all-grid-view" id={`all-grid-${catKey}`} hidden data-all-view={catKey}>
                <div class="all-grid-topbar">
                  <div class="all-grid-title-wrap">
                    <span class="all-grid-tag font-mono">COMPLETE MANIFEST OVERVIEW</span>
                    <h4 class="all-grid-title">{cat.data.category} Inventory ({items.length} units)</h4>
                  </div>
                  <button type="button" class="btn-back-carousel font-mono" data-back-carousel={catKey}>
                    ← Return to Carousel
                  </button>
                </div>

                <div class="all-grid-cards">
                  {items.map((item, itemIdx) => {
                    const itemHasProduct = isProductUrl(item.affiliateUrl);
                    return (
                      <article class="all-grid-card">
                        <div class="all-card-top">
                          <span class="all-card-tag font-mono">{item.tag || 'Pro Kit'}</span>
                          <span class="all-card-brand font-mono">{item.brand || 'Sony'}</span>
                        </div>
                        <div class="all-card-img-wrap">
                          <img src={resolveAsset(item.image)} alt="" class="all-card-img" loading="lazy" />
                        </div>
                        <div class="all-card-body">
                          <h5 class="all-card-name">{item.name}</h5>
                          <p class="all-card-spec">{item.spec}</p>
                          <a
                            href={item.affiliateUrl || AMAZON_STOREFRONT}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="all-card-cta btn-amazon-link"
                          >
                            <span>{itemHasProduct ? `View on Amazon` : 'Storefront'} <span aria-hidden="true">↗</span></span>
                          </a>
                        </div>
                      </article>
                    );
                  })}
                </div>

                <div class="all-grid-footer">
                  <button type="button" class="btn-back-carousel font-mono" data-back-carousel={catKey}>
                    ← Return to Carousel
                  </button>
                </div>
              </div>
            )}
          </div>
        </section>
      );
    })}
  </div>
</div>

<style>
  /* --------------------------------------------------------------------------
     FILTER & SEARCH TOOLBAR
     -------------------------------------------------------------------------- */
  .gear-filter-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--line, rgba(255, 255, 255, 0.12));
  }
  .gear-search-wrap {
    position: relative;
    display: flex;
    align-items: center;
    flex: 1 1 300px;
    max-width: 480px;
  }
  .gear-search-icon {
    position: absolute;
    left: 1rem;
    color: var(--muted, #888888);
    pointer-events: none;
  }
  .gear-search-input {
    width: 100%;
    padding: 0.75rem 2.25rem 0.75rem 2.75rem;
    background: var(--surface, #111111);
    border: 1px solid var(--line, rgba(255, 255, 255, 0.15));
    color: var(--ink, #ffffff);
    font-family: var(--font-body);
    font-size: 0.88rem;
    outline: none;
    transition: var(--transition-smooth, all 0.2s ease);
  }
  .gear-search-input:focus {
    border-color: var(--border-active, rgba(255, 255, 255, 0.5));
    background: var(--surface-2, #1a1a1a);
  }
  .gear-search-clear {
    position: absolute;
    right: 0.75rem;
    background: none;
    border: none;
    color: var(--muted, #888888);
    font-size: 1.25rem;
    cursor: pointer;
    padding: 0.25rem 0.5rem;
    line-height: 1;
  }
  .gear-search-clear:hover {
    color: var(--ink, #ffffff);
  }
  .gear-category-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    row-gap: 0.5rem;
  }
  .gear-chip {
    position: relative;
    min-height: var(--btn-h-sm, 36px);
    padding: 0.4rem 0.9rem;
    background: transparent;
    border: 1px solid var(--line, rgba(255, 255, 255, 0.15));
    border-radius: var(--btn-radius, 0);
    color: var(--muted, #888888);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .gear-chip:hover {
    border-color: var(--border-active, rgba(255, 255, 255, 0.4));
    color: var(--ink, #ffffff);
    transform: translateY(-1px);
  }
  .gear-chip.active {
    background: var(--ink, #ffffff);
    color: var(--bg, #0a0a0a);
    border-color: var(--ink, #ffffff);
    font-weight: 700;
  }
  .gear-empty-state {
    padding: 3.5rem 1.5rem;
    text-align: center;
    border: 1px dashed var(--line, rgba(255, 255, 255, 0.2));
    background: var(--surface, #111111);
    margin-bottom: 2rem;
  }
  .gear-empty-state[hidden],
  .gear-accordion-section[hidden] {
    display: none !important;
  }
  .gear-empty-text {
    font-family: var(--font-mono);
    color: var(--muted, #888888);
    font-size: 0.9rem;
    margin-bottom: 1.25rem;
    letter-spacing: 0.05em;
  }
  .gear-reset-btn {
    padding: 0.6rem 1.25rem;
    background: transparent;
    border: 1px solid var(--border-active, rgba(255, 255, 255, 0.4));
    color: var(--ink, #ffffff);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .gear-reset-btn:hover {
    background: var(--surface-2, #1a1a1a);
    color: var(--color-white, #ffffff);
  }

  /* --------------------------------------------------------------------------
     ACCORDION STRUCTURE (ONE GROUP OPEN AT A TIME)
     -------------------------------------------------------------------------- */
  .gear-monolith {
    width: 100%;
    margin-top: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .gear-accordion-deck-container {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    width: 100%;
  }
  .gear-accordion-section {
    background: #090909;
    border: 1px solid var(--line, rgba(255, 255, 255, 0.14));
    display: flex;
    flex-direction: column;
    position: relative;
    transition: border-color 0.3s ease;
  }
  .gear-accordion-section.is-expanded {
    border-color: rgba(255, 255, 255, 0.28);
  }
  .gear-accordion-header-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.25rem 1.75rem;
    background: #0d0d0d;
    border-bottom: 1px solid transparent;
    transition: background-color 0.25s ease, border-color 0.25s ease;
  }
  .gear-accordion-section.is-expanded .gear-accordion-header-bar {
    border-bottom: 1px solid var(--line, rgba(255, 255, 255, 0.12));
    background: #0e0e0e;
  }
  .gear-accordion-section.is-collapsed .gear-accordion-header-bar:hover {
    background: #141414;
  }
  .gear-accordion-heading {
    margin: 0;
    font: inherit;
    flex: 1;
    min-width: 0;
  }
  .gear-accordion-header {
    appearance: none;
    -webkit-appearance: none;
    border: none;
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    width: 100%;
    display: flex;
    align-items: center;
    cursor: pointer;
