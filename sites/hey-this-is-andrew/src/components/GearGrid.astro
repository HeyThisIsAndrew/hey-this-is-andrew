---
import type { CollectionEntry } from 'astro:content';

interface Props {
  categories: CollectionEntry<'gear'>[];
}

const { categories } = Astro.props;

import { AMAZON_STOREFRONT } from '../data/storefront';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase.slice(0, -1) : rawBase;
const resolveAsset = (img?: string) => {
  if (!img) return '';
  if (img.startsWith('http://') || img.startsWith('https://')) return img;
  const clean = img.startsWith('/') ? img : `/${img}`;
  return `${base}${clean}`;
};

const isProductUrl = (url?: string) => Boolean(url && url.trim() && url !== AMAZON_STOREFRONT);

export interface GearItem {
  name: string;
  brand?: string;
  tag?: string;
  spec: string;
  desc?: string;
  affiliateUrl?: string;
  image?: string;
  imageAlt?: string;
  ariaLabel?: string;
}

export interface GearSectionData {
  id: string;
  slug: string;
  category: string;
  kicker: string;
  subtitle?: string;
  items: GearItem[];
  hasAllView: boolean;
}

// 1. Existing verified collection items
const orderMap: Record<string, number> = {
  'Camera Bodies': 1,
  'Lens': 2,
  'Lighting': 3,
  'Audio': 4,
  'Tools & Support': 5,
};

const sortedCats = [...categories].sort((a, b) => {
  const oA = orderMap[a.data.category] || a.data.order || 99;
  const oB = orderMap[b.data.category] || b.data.order || 99;
  return oA - oB;
});

// Audio is intentionally excluded if Andrew owns 0 items
const activeCats = sortedCats.filter(c => c.data.items && c.data.items.length > 0 && c.data.category !== 'Audio');

// 2. Cafe Bar section definition (exact 6 verified items with real imagery)
const cafeItems: GearItem[] = [
  {
    name: 'Ascaso Steel Duo PID',
    brand: 'Ascaso',
    tag: 'Espresso',
    spec: 'Dual thermoblock espresso machine with volumetric controls and independent steam circuit',
    desc: 'Commercial dual thermoblock system with independent steam circuit, PID temperature control, and volumetric programming. Used for high-volume beverage shoots and morning dial-in.',
    affiliateUrl: 'https://link.amazon/B0cCrykft',
    image: '/gear/ascaso-steel-duo.jpg',
    imageAlt: '',
    ariaLabel: 'View Ascaso Steel Duo PID on Amazon',
  },
  {
    name: 'Fellow Stagg EKG',
    brand: 'Fellow',
    tag: 'Pour-Over',
    spec: 'Electric pour-over kettle with variable temperature and precision flow control',
    desc: 'Precision gooseneck pour-over kettle with variable temperature control and real-time brew-time tracking. Central to pour-over extraction cinematography.',
    affiliateUrl: 'https://link.amazon/B0fbGKgld',
    image: '/gear/fellow-stagg-ekg.jpg',
    imageAlt: '',
    ariaLabel: 'View Fellow Stagg EKG on Amazon',
  },
  {
    name: 'Fellow Mighty Small Carafe',
    brand: 'Fellow',
    tag: 'Glassware',
    spec: 'Hand-blown 500ml borosilicate server for precise coffee pouring',
    desc: 'Hand-blown 500ml borosilicate glass carafe with clear volume markers and ergonomic spout design. Sits on set for clean pour-over captures.',
    affiliateUrl: 'https://link.amazon/B01DJcTby',
    image: '/gear/fellow-carafe.jpg',
    imageAlt: '',
    ariaLabel: 'View Fellow Mighty Small Carafe on Amazon',
  },
  {
    name: 'Fellow Tally Pro Precision Scale',
    brand: 'Fellow',
    tag: 'Measurement',
    spec: 'Ultra-fast 0.1g coffee brewing scale with interactive Brew Assist mode',
    desc: 'Precision brewing scale with 0.1g accuracy, rapid response rate, and interactive Brew Assist ratio calculations for espresso extraction and pour-over testing.',
    affiliateUrl: 'https://link.amazon/B06NamWQ9',
    image: '/gear/fellow-scale.jpg',
    imageAlt: '',
    ariaLabel: 'View Fellow Scale on Amazon',
  },
  {
    name: 'NitroPress Dispenser',
    brand: 'NitroPress',
    tag: 'Cold Brew',
    spec: 'High-pressure nitro beverage dispenser with pure nitrogen infuser',
    desc: 'High-pressure nitro infuser delivering micro-foam texture for cold brew coffee, tea, and signature cocktail production without dairy or syrup additives.',
    affiliateUrl: 'https://link.amazon/B04f3JDzo',
    image: '/gear/nitropress.jpg',
    imageAlt: '',
    ariaLabel: 'View Nitro Press on Amazon',
  },
  {
    name: 'James Coffee Co.',
    brand: 'James Coffee Co.',
    tag: 'Roastery',
    spec: 'Single-origin espresso and filter roasts sourced and roasted in San Diego, CA',
    desc: 'Local San Diego specialty roastery providing single-origin espresso and filter roasts tested across commercial and studio extractions.',
    affiliateUrl: 'https://jamescoffeeco.com',
    image: '/gear/james-coffee.jpg',
    imageAlt: '',
    ariaLabel: 'Visit James Coffee Co. website',
  },
];

// Unified 5 sections
const allSections: GearSectionData[] = [
  ...activeCats.map((cat) => {
    const isBodies = cat.data.category === 'Camera Bodies';
    const isLenses = cat.data.category === 'Lens';
    const isLighting = cat.data.category === 'Lighting';

    const slug = isBodies ? 'bodies' : isLenses ? 'lenses' : isLighting ? 'lighting' : 'tools';
    const kicker = isBodies ? '01 / HERO SYSTEM' : isLenses ? '02 / OPTICAL SYSTEM' : isLighting ? '03 / ILLUMINATION' : '04 / STABILIZATION & RIG';
    const categoryTitle = isBodies ? 'Cameras' : isLenses ? 'Lenses' : isLighting ? 'Lighting' : 'Tools and Support';

    return {
      id: `gear-${slug}`,
      slug,
      category: categoryTitle,
      kicker,
      subtitle: cat.data.subtitle || '',
      items: cat.data.items as GearItem[],
      hasAllView: cat.data.items.length > 6,
    };
  }),
  {
    id: 'brew',
    slug: 'brew',
    category: 'Cafe Bar',
    kicker: '05 / BEVERAGE & CRAFT',
    subtitle: 'Precision brewing and beverage production kit',
    items: cafeItems,
    hasAllView: true,
  },
];

// Color RGB tones sampled from product imagery for subtle cinematic ambient glow
const ITEM_RGB_MAP: Record<string, string> = {
  'sony-a7iv.jpg': '65, 65, 70',
  'sony-a7cr.jpg': '65, 68, 75',
  'iphone-17-pro-max.jpg': '70, 85, 130',
  'iphone-15-pro-max.jpg': '125, 121, 115',
  'iphone-12-pro-max.jpg': '85, 84, 81',
  'sony-24-70-gm.jpg': '60, 59, 63',
  'sony-16-35-gm2.jpg': '50, 49, 51',
  'sony-70-200-gm2.jpg': '150, 150, 155',
  'sony-90-macro.jpg': '56, 55, 56',
  'sony-55-sonnar.jpg': '57, 56, 59',
  'sony-50-g.jpg': '54, 54, 56',
  'sony-24-g.jpg': '54, 53, 55',
  'viltrox-85-evo.jpg': '110, 110, 120',
  'amaran-200d.jpg': '130, 135, 145',
  'sony-hvl-f60rm2.jpg': '98, 98, 99',
  'peak-design-carbon-tripod.jpg': '100, 105, 115',
  'kupo-c-stands.jpg': '85, 85, 85',
  'sony-np-fz100-battery.jpg': '79, 82, 82',
  'ascaso-steel-duo.jpg': '135, 125, 115',
  'fellow-stagg-ekg.jpg': '97, 96, 95',
  'fellow-carafe.jpg': '92, 91, 89',
  'fellow-scale.jpg': '53, 53, 54',
  'nitropress.jpg': '170, 140, 135',
  'james-coffee.jpg': '140, 115, 75',
};

const getItemRgb = (img?: string) => {
  if (!img) return '100, 100, 100';
  const fname = img.split('/').pop() || '';
  return ITEM_RGB_MAP[fname] || '100, 100, 100';
};
---

<div class="gear-monolith" id="gear-monolith">
  <!-- Gear Instant Search & Category Filter Toolbar -->
  <div class="gear-filter-toolbar" role="search" aria-label="Filter gear loadout">
    <div class="gear-search-wrap">
      <svg class="gear-search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input
        type="search"
        id="gear-search-input"
        class="gear-search-input font-mono"
        placeholder="Filter equipment (e.g. Sony, 90mm, Amaran, Ascaso, tripod)..."
        aria-label="Search gear"
      />
      <button type="button" id="gear-search-clear" class="gear-search-clear" aria-label="Clear search" hidden>×</button>
    </div>
    <div class="gear-category-chips" role="tablist" aria-label="Gear categories">
      <button type="button" class="gear-chip active" data-cat="all" role="tab" aria-selected="true">All</button>
      {allSections.map(sec => {
        const catKey = sec.slug === 'bodies' ? 'cameras' : sec.slug === 'tools' ? 'support' : sec.slug === 'brew' ? 'cafe' : sec.slug;
        const chipLabel = sec.slug === 'bodies' ? 'Cameras' : sec.slug === 'tools' ? 'Support' : sec.slug === 'brew' ? 'Cafe' : sec.category;
        return (
          <button type="button" class="gear-chip" data-cat={catKey} role="tab" aria-selected="false">{chipLabel}</button>
        );
      })}
    </div>
  </div>

  <div id="gear-empty-state" class="gear-empty-state" hidden>
    <p class="gear-empty-text">No equipment matches your search filter.</p>
    <button type="button" id="gear-reset-btn" class="gear-reset-btn font-mono">Reset Filter</button>
  </div>

  <!-- COMPACT ACCORDION STACK: ALL 5 SECTION HEADERS VISIBLE AT ONCE (EXACTLY ONE OPEN AT A TIME) -->
  <div class="gear-accordion-container" id="gear-accordion-container">
    {allSections.map((sec, secIdx) => {
      const isDefaultExpanded = secIdx === 0;
      const isBodies = sec.slug === 'bodies';
      const isLenses = sec.slug === 'lenses';
      const isLighting = sec.slug === 'lighting';
      const isBrew = sec.slug === 'brew';

      const items = sec.items;
      const defaultItem = items[0];
      const defaultRgb = getItemRgb(defaultItem?.image);
      const hasProduct = isProductUrl(defaultItem?.affiliateUrl);

      // Element IDs for strict backward-compatibility with e2e tests
      const imgId = isBodies ? 'preview-camera-img' : isBrew ? 'preview-cafe-img' : `img-${sec.id}`;
      const ctaId = isBodies ? 'preview-camera-btn' : isBrew ? 'cafe-hero-cta' : `cta-${sec.id}`;
      const brandId = isBodies ? 'preview-camera-brand' : `brand-${sec.id}`;
      const titleId = isBodies ? 'preview-camera-title' : isBrew ? 'cafe-hero-name' : `title-${sec.id}`;
      const descId = isBodies ? 'preview-camera-desc' : isBrew ? 'cafe-hero-desc' : `desc-${sec.id}`;
      const tagId = isBodies ? 'preview-camera-tag' : `tag-${sec.id}`;

      return (
        <section
          class={`gear-accordion-section ${isDefaultExpanded ? 'is-expanded' : 'is-collapsed'}`}
          id={sec.id}
          data-category-slug={sec.id}
          data-category={sec.slug}
          data-pn-entry
          data-pn-label={sec.category}
          style={`--item-accent-rgb: ${defaultRgb};`}
        >
          {isLenses && (
            <>
              <span id="gear-zooms" class="vh" aria-hidden="true"></span>
              <span id="gear-primes" class="vh" aria-hidden="true"></span>
            </>
          )}
          {isLighting && (
            <>
              <span id="gear-lights" class="vh" aria-hidden="true"></span>
              <span id="gear-flash" class="vh" aria-hidden="true"></span>
            </>
          )}

          <!-- COMPACT ACCORDION HEADER (CLICK TOGGLES THIS GROUP & COLLAPSES OTHERS) -->
          <div class="gear-accordion-header-bar" data-header-bar={sec.slug}>
            <h2 class="gear-accordion-heading">
              <button
                type="button"
                class="gear-accordion-header"
                aria-expanded={isDefaultExpanded ? 'true' : 'false'}
                aria-controls={`gear-body-${sec.slug}`}
              >
                <span class="gear-header-left">
                  <span class="box-idx font-mono">{sec.kicker}</span>
                  <span class="gear-header-title-row">
                    <span class="box-title">{sec.category}</span>
                    <span class="gear-item-count-badge font-mono">{items.length} PIECES VERIFIED</span>
                  </span>
                  <span class="box-subtitle font-mono">{sec.subtitle}</span>
                </span>
              </button>
            </h2>

            <div class="gear-header-right">
              {sec.hasAllView && (
                <button
                  type="button"
                  class="btn-all-toggle font-mono"
                  data-all-toggle={sec.slug}
                  aria-expanded="false"
                  aria-controls={isBrew ? 'cafe-all-grid' : `all-grid-${sec.slug}`}
                  title={`Toggle multi-column grid of all ${sec.category} items`}
                >
                  <span class="all-toggle-label">Show All ({items.length})</span>
                  <span class="all-toggle-icon" aria-hidden="true">⊞</span>
                </button>
              )}

              <a
                href={AMAZON_STOREFRONT}
                target="_blank"
                rel="noopener noreferrer"
                class="influencer-pill font-mono"
                aria-label="Visit the storefront"
              >
                <span class="influencer-dot"></span>
                <span class="influencer-text">Storefront</span>
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                  <path d="M2.5 9.5L9.5 2.5M9.5 2.5H4.5M9.5 2.5V7.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>

              <!-- UNAMBIGUOUS ACCORDION TOGGLE INDICATOR (ROTATING CHEVRON) -->
              <button
                type="button"
                class="accordion-chevron-btn"
                aria-label={`Toggle ${sec.category} section`}
                aria-expanded={isDefaultExpanded ? 'true' : 'false'}
                data-accordion-toggle={sec.slug}
              >
                <svg class="header-chevron-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </button>
            </div>
          </div>

          <!-- ACCORDION BODY (OPENS CINEMATIC POSTER DECK) -->
          <div class="gear-accordion-body" id={`gear-body-${sec.slug}`}>
            <!-- CAROUSEL / DECK STAGE VIEW (LARGE FLOATING HERO + RIGHT PEEKING SLATS + CONTROLS) -->
            <div class="gear-deck-view" data-deck-container={sec.slug}>
              
              <!-- STAGE CONTAINER (CONTAINS AMBIENT BACKLIGHT GLOW, HERO POSTER, SLATS, AND DECK ARROWS) -->
              <div class="gear-deck-stage" data-deck-stage={sec.slug}>
                
                <!-- DYNAMIC AMBIENT BACKLIGHT GLOW (HQ FEATURED PATTERN) -->
                <div class="ambient-glow-container" aria-hidden="true">
                  {items.map((item, itemIdx) => (
                    <div
                      class={`ambient-glow-layer ${itemIdx === 0 ? 'active' : ''}`}
                      data-glow-index={itemIdx}
                      style={item.image ? `background-image: url(${resolveAsset(item.image)});` : ''}
                    ></div>
                  ))}
                </div>

                <!-- FLOATING, IMAGE-LED HERO SPEC CARD (NO BOXY CHROME, FULL BLEED PRODUCT ART) -->
                <div class="hero-poster-card" data-hero-poster={sec.slug}>
                  <div class="hero-poster-topbar">
                    <div class="hero-top-tags">
                      <span class="hero-badge-verified font-mono">
                        {isBodies ? 'STUDIO VERIFIED' : isBrew ? 'CAFE VERIFIED' : 'FIELD VERIFIED'}
                      </span>
                      <span class="hero-badge-item font-mono" id={tagId}>
                        {defaultItem?.tag || 'Production Spec'}
                      </span>
                    </div>
                    <span class="hero-item-counter font-mono" data-card-counter={sec.slug}>
                      01 / 0{items.length}
                    </span>
                  </div>

                  <!-- LARGE, TALL, FLOATING PRODUCT VISUAL BLEEDING INTO THE DARK VIGNETTED STAGE -->
                  <div class="hero-poster-visual-wrap">
                    <img
                      id={imgId}
                      class="hero-poster-img"
                      src={resolveAsset(defaultItem?.image)}
                      alt=""
                    />
                    <div class="hero-poster-vignette" aria-hidden="true"></div>
                    <div class="hero-poster-scrim" aria-hidden="true"></div>
                  </div>

                  <!-- BOTTOM OVERLAY CONTENT STRIP (QUIET BRAND, BOLD TITLE, CLEAR CTA) -->
                  <div class="hero-overlay-plate">
                    <span class="hero-brand-kicker font-mono" id={brandId}>
                      {(defaultItem?.brand || 'CURATED PRODUCTION').toUpperCase()} // KIT
                    </span>
                    <h3 class="hero-product-title" id={titleId}>
                      {defaultItem?.name}
                    </h3>
                    <p class="hero-product-spec" id={descId}>
                      {defaultItem?.desc || defaultItem?.spec}
                    </p>
                    <div class="hero-action-row">
                      <a
                        href={defaultItem?.affiliateUrl || AMAZON_STOREFRONT}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn-primary-influencer font-mono"
                        id={ctaId}
                        aria-label={defaultItem?.ariaLabel || `View ${defaultItem?.name} on Amazon`}
                      >
                        <span class="amz-btn-text">
                          {hasProduct ? `View ${defaultItem?.name} on Amazon` : 'Visit the storefront'}
                        </span>
                        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true" focusable="false">
                          <path d="M2.5 11.5L11.5 2.5M11.5 2.5H5.5M11.5 2.5V8.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      </a>
                      <span class="hero-disclosure-note font-mono">
                        As an Amazon Associate, I earn from qualifying purchases.
                      </span>
                    </div>
                  </div>
                </div>

                <!-- RIGHT PEEKING VERTICAL SLATS (HQ FEATURED CARD STACK) -->
                <div class="deck-slats-stack" aria-hidden="true">
                  {items.map((item, itemIdx) => {
                    const isNext1 = itemIdx === 1;
                    const isNext2 = itemIdx === 2;
                    const initialClass = isNext1 ? 'deck-slat next-1' : isNext2 ? 'deck-slat next-2' : 'deck-slat hidden';
                    return (
                      <div
                        class={initialClass}
                        data-slat-index={itemIdx}
                        data-cat-slug={sec.slug}
                        title={`Click to view ${item.name}`}
                      >
                        <div class="peeking-spine">
                          <span class="spine-text">{item.name}</span>
                        </div>
                        {item.image && (
                          <img src={resolveAsset(item.image)} alt="" class="slat-peek-img" loading="lazy" />
                        )}
                      </div>
                    );
                  })}
                </div>

                <!-- UNAMBIGUOUS ITEM NAVIGATION ARROWS (INSIDE THE HERO DECK STAGE) -->
                <div class="deck-stage-nav-controls" aria-label="Deck item navigation">
                  <button
                    type="button"
                    class="btn-deck-item-nav btn-deck-prev"
                    data-deck-prev={sec.slug}
                    aria-label={`Previous ${sec.category} item`}
                    title="Previous item"
                  >
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="15 18 9 12 15 6"></polyline>
                    </svg>
                  </button>
                  <button
                    type="button"
                    class="btn-deck-item-nav btn-deck-next"
                    data-deck-next={sec.slug}
                    aria-label={`Next ${sec.category} item`}
                    title="Next item"
                  >
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="9 18 15 12 9 6"></polyline>
                    </svg>
                  </button>
                </div>
              </div>

              <!-- THUMBNAIL TRACK BELOW (HQ FEATURED THUMBNAIL STRIP) -->
              <div
                class="deck-thumb-track"
                role="tablist"
                aria-label={`${sec.category} rotation`}
                data-thumb-track={sec.slug}
              >
                {items.map((item, itemIdx) => {
                  const itemHasProduct = isProductUrl(item.affiliateUrl);
                  const rowClass = isBodies ? 'camera-item-row' : 'collage-item-row';
                  const itemRgb = getItemRgb(item.image);
                  return (
                    <button
                      type="button"
                      class={`deck-thumb-tile ${rowClass} ${itemIdx === 0 ? 'is-active' : ''}`}
                      role="tab"
                      tabindex="0"
                      aria-selected={itemIdx === 0 ? 'true' : 'false'}
                      aria-label={`Select ${item.name}`}
                      data-subcat={sec.id}
                      data-item-index={itemIdx}
                      data-item-name={item.name}
                      data-item-brand={item.brand || (item.name.includes('Sony') ? 'Sony' : 'Curated Kit')}
                      data-item-spec={item.desc || item.spec}
                      data-item-tag={item.tag || (itemIdx === 0 ? 'Primary Workhorse' : 'Production Spec')}
                      data-item-url={item.affiliateUrl || AMAZON_STOREFRONT}
                      data-has-product-url={itemHasProduct ? 'true' : 'false'}
                      data-item-image={resolveAsset(item.image)}
                      data-item-rgb={itemRgb}
                      data-item-aria={item.ariaLabel || `View ${item.name} on Amazon`}
                      data-cat-slug={sec.slug}
                    >
                      <div class="thumb-tile-img-box">
                        {item.image ? (
                          <img src={resolveAsset(item.image)} alt="" class="thumb-tile-img" loading="lazy" />
                        ) : (
                          <div class="thumb-tile-fallback font-mono">{item.name.slice(0, 3)}</div>
                        )}
                      </div>
                      <div class="thumb-tile-meta">
                        <span class="thumb-tile-name">{item.name}</span>
                        <span class="thumb-tile-tag font-mono">{item.tag || 'Verified'}</span>
                      </div>
                      <span class="thumb-tile-glow" aria-hidden="true"></span>
                    </button>
                  );
                })}
              </div>
            </div>

            <!-- "ALL" MULTI-COLUMN TILE GRID VIEW (FOR LENSES AND CAFE BAR) -->
            {sec.hasAllView && (
              <div class="gear-all-grid-view" id={isBrew ? 'cafe-all-grid-container' : `all-grid-${sec.slug}`} hidden data-all-view={sec.slug}>
                <div class="all-grid-topbar">
                  <div class="all-grid-title-wrap">
                    <span class="all-grid-tag font-mono">COMPLETE MANIFEST OVERVIEW</span>
                    <h4 class="all-grid-title">{sec.category} Inventory ({items.length} units)</h4>
                  </div>
                  <button type="button" class="btn-back-carousel font-mono" data-back-carousel={sec.slug}>
                    ← Return to Carousel
                  </button>
                </div>

                <div class="all-grid-cards" id={isBrew ? 'cafe-all-grid' : undefined}>
                  {items.map((item) => {
                    const itemHasProduct = isProductUrl(item.affiliateUrl);
                    return (
                      <article class="all-grid-card">
                        <div class="all-card-top">
                          <span class="all-card-tag font-mono">{item.tag || 'Pro Kit'}</span>
                          <span class="all-card-brand font-mono">{item.brand || 'Verified'}</span>
                        </div>
                        <div class="all-card-img-wrap">
                          <img src={resolveAsset(item.image)} alt="" class="all-card-img" loading="lazy" />
                        </div>
                        <div class="all-card-body">
                          <h5 class="all-card-name">{item.name}</h5>
                          <p class="all-card-spec">{item.spec}</p>
                          <a
                            href={item.affiliateUrl || AMAZON_STOREFRONT}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="all-card-cta btn-amazon-link font-mono"
                            aria-label={item.ariaLabel || `View ${item.name} on Amazon`}
                          >
                            <span>{itemHasProduct ? `View on Amazon` : 'Storefront'} <span aria-hidden="true">↗</span></span>
                          </a>
                        </div>
                      </article>
                    );
                  })}
                </div>

