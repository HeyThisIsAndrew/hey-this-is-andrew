---
/**
 * CccInquiryModal.astro
 * Premium, wide project inquiry modal for Capture Create Caffeinate.
 * Features a spacious 2-column desktop layout, package/service selection dropdown
 * with 'Other' option, optional add-on checkboxes, special requests field,
 * budget selector, prefilled mailto composition, and fallback copy tool.
 *
 * Punctuation hygiene: zero em dashes throughout.
 */
import { CCC_EMAIL } from '../../data/ccc';
---

<dialog
  id="ccc-inquiry-modal"
  class="ccc-modal"
  closedby="any"
  aria-labelledby="ccc-modal-title"
>
  <div class="ccc-modal-card">
    <header class="ccc-modal-head">
      <div class="ccc-modal-titles">
        <p class="ccc-modal-eyebrow font-mono">Capture Create Caffeinate</p>
        <h2 id="ccc-modal-title" class="ccc-modal-title">Start a project</h2>
      </div>
      <button
        type="button"
        class="ccc-modal-close"
        id="ccc-modal-close"
        aria-label="Close modal"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </header>

    <form id="ccc-inquiry-form" class="ccc-form">
      <!-- 2-Column Contact Info -->
      <div class="ccc-form-grid">
        <div class="ccc-field">
          <label for="ccc-name">Your name <span class="ccc-req" aria-hidden="true">*</span></label>
          <input
            type="text"
            id="ccc-name"
            name="name"
            required
            autocomplete="name"
            placeholder="First and last name"
            autofocus
          />
        </div>

        <div class="ccc-field">
          <label for="ccc-email">Email <span class="ccc-req" aria-hidden="true">*</span></label>
          <input
            type="email"
            id="ccc-email"
            name="email"
            required
            autocomplete="email"
            placeholder="you@venue.com"
            autocorrect="off"
            autocapitalize="off"
            spellcheck="false"
          />
        </div>

        <div class="ccc-field">
          <label for="ccc-venue">Venue name <span class="ccc-req" aria-hidden="true">*</span></label>
          <input
            type="text"
            id="ccc-venue"
            name="venue"
            required
            placeholder="The bar, restaurant, or brand"
            autocomplete="organization"
          />
        </div>

        <div class="ccc-field">
          <label for="ccc-location">Venue location <span class="ccc-req" aria-hidden="true">*</span></label>
          <input
            type="text"
            id="ccc-location"
            name="location"
            required
            placeholder="City or neighborhood"
            autocomplete="address-level2"
          />
        </div>
      </div>

      <!-- Scope & Services -->
      <div class="ccc-form-grid">
        <div class="ccc-field">
          <label for="ccc-service">What are you looking for? <span class="ccc-req" aria-hidden="true">*</span></label>
          <select id="ccc-service" name="service" required>
            <option value="" disabled selected>Select an option</option>
            <option value="Photo + vertical reel bundle">Photo + vertical reel bundle</option>
            <option value="Half-day photo session">Half-day photo session</option>
            <option value="Vertical reel only">Vertical reel only</option>
            <option value="Events or multi-day coverage">Events or multi-day coverage</option>
            <option value="Other (describe in requests below)">Other (describe in requests below)</option>
          </select>
        </div>

        <div class="ccc-field">
          <label for="ccc-date">Preferred date or dates <span class="ccc-req" aria-hidden="true">*</span></label>
          <input
            type="date"
            id="ccc-date"
            name="preferredDate"
            required
          />
        </div>
      </div>

      <!-- Add-on Options (Optional checkboxes) -->
      <div class="ccc-field ccc-field--full">
        <span class="ccc-field-label font-mono">Optional add-ons</span>
        <div class="ccc-checkbox-group">
          <label class="ccc-checkbox-label">
            <input type="checkbox" name="addons" value="Vertical reel add-on" />
            <span>Vertical reel add-on</span>
          </label>
          <label class="ccc-checkbox-label">
            <input type="checkbox" name="addons" value="Rush 48-hour gallery delivery" />
            <span>Rush 48-hour delivery</span>
          </label>
          <label class="ccc-checkbox-label">
            <input type="checkbox" name="addons" value="Multiple shoot sessions or locations" />
            <span>Multiple sessions or locations</span>
          </label>
        </div>
      </div>

      <!-- Budget Selection & Scope Note -->
      <div class="ccc-field ccc-field--full">
        <p id="ccc-pricing-note" class="ccc-pricing-note">
          Every package is tailored to your venue, your service schedule, and what you want to show off.
        </p>
        <div class="ccc-field-sub">
          <label for="ccc-budget">Scope & package level <span class="ccc-req" aria-hidden="true">*</span></label>
          <select
            id="ccc-budget"
            name="budget"
            required
            aria-describedby="ccc-pricing-note"
          >
            <option value="" disabled selected>Select an option</option>
            <option value="Standard single session">Standard single session</option>
            <option value="Combined photo + video">Combined photo + video</option>
            <option value="Multi-day or event coverage">Multi-day or event coverage</option>
            <option value="Custom scope">Custom scope</option>
            <option value="Not sure yet">Not sure yet</option>
          </select>
        </div>
      </div>

      <!-- Message & Special Requests -->
      <div class="ccc-field ccc-field--full">
        <label for="ccc-showoff">Special requests or details <span class="ccc-req" aria-hidden="true">*</span></label>
        <textarea
          id="ccc-showoff"
          name="showOff"
          rows="4"
          required
          placeholder="the menu, the room, the people, anything new."
        ></textarea>
        <p class="ccc-help-text">Feel free to type in any special requests or message and we will get back to you as soon as possible.</p>
      </div>

      <button type="submit" class="btn btn-primary ccc-submit-btn">
        Send inquiry <span aria-hidden="true">&rarr;</span>
      </button>
    </form>

    <!-- Confirmation / Fallback State -->
    <div id="ccc-confirm-box" class="ccc-confirm-box" hidden>
      <div class="ccc-confirm-header">
        <div class="ccc-confirm-icon" aria-hidden="true">&#10003;</div>
        <p id="ccc-confirm-msg" class="ccc-confirm-title" role="status" aria-live="polite">
          Thanks. We will get back to you to schedule a call.
        </p>
      </div>
      <p class="ccc-confirm-desc">
        If your email client did not launch automatically, copy the composed inquiry below and email it to
        <a href={`mailto:${CCC_EMAIL}`}>{CCC_EMAIL}</a>.
      </p>

      <div class="ccc-copy-wrap">
        <label for="ccc-copy-payload" class="ccc-copy-label font-mono">Composed email text</label>
        <textarea
          id="ccc-copy-payload"
          class="ccc-copy-payload"
          readonly
          rows="10"
        ></textarea>
        <div class="ccc-confirm-actions btn-group">
          <button type="button" id="ccc-copy-btn" class="btn btn-primary">
            Copy email text
          </button>
          <a id="ccc-mailto-link" class="btn btn-secondary" href={`mailto:${CCC_EMAIL}`}>
            Open mail app
          </a>
        </div>
      </div>
    </div>
  </div>
</dialog>

<style>
  /* CCC Brand Typography & Theme */
  .ccc-modal {
    --ccc-modal-display: 'Playfair Display', Georgia, 'Times New Roman', serif;
    --ccc-modal-serif: 'Cormorant Garamond', Georgia, 'Times New Roman', serif;
    --ccc-modal-mono: 'JetBrains Mono', ui-monospace, 'SF Mono', monospace;
    --ccc-gold: #c9a96e;
    --ccc-gold-light: #e5cb9e;
    --ccc-cream: #fbf7f0;
    --ccc-cream-soft: #ede7dc;
  }

  /* Modern Web Guidance: modal overscroll containment */
  .ccc-modal:modal {
    overscroll-behavior: contain;
  }
  .ccc-modal::backdrop {
    overflow: hidden;
    overscroll-behavior: contain;
    background: rgba(0, 0, 0, 0.88);
    backdrop-filter: blur(6px);
  }
  .ccc-modal {
    padding: 0;
    margin: auto;
    width: min(100% - 2rem, 50rem);
    max-height: calc(100svh - 3rem);
    background: #0b0b0b;
    color: var(--ccc-cream, #fbf7f0);
    border: 1px solid rgba(201, 169, 110, 0.35);
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.9);
    overflow-y: auto;
  }
  .ccc-modal[open] {
    display: block;
  }
  .ccc-modal-card {
    padding: clamp(1.5rem, 3.5vw, 2.75rem);
  }
  .ccc-modal-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 1.75rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid rgba(201, 169, 110, 0.22);
  }
  .ccc-modal-eyebrow {
    margin: 0 0 0.35rem;
    font-family: var(--ccc-modal-mono);
    font-size: 0.78rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--ccc-gold, #c9a96e);
  }
  .ccc-modal-title {
    margin: 0;
    font-family: var(--ccc-modal-display);
    font-size: clamp(1.6rem, 3.2vw, 2.2rem);
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--ccc-cream, #fbf7f0);
  }
  .ccc-modal-close {
    appearance: none;
    background: transparent;
    border: 1px solid rgba(201, 169, 110, 0.4);
    color: var(--ccc-cream, #fbf7f0);
    width: 44px;
    height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }
  .ccc-modal-close:hover,
  .ccc-modal-close:focus-visible {
    background: var(--ccc-gold, #c9a96e);
    color: #000;
    border-color: var(--ccc-gold, #c9a96e);
  }

  .ccc-form {
    display: flex;
    flex-direction: column;
    gap: 1.35rem;
  }
  .ccc-form-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  @media (min-width: 640px) {
    .ccc-form-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.5rem;
    }
  }

  .ccc-field {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .ccc-field--full {
    width: 100%;
  }
  .ccc-field label,
  .ccc-field-label,
  .ccc-copy-label {
    font-family: var(--ccc-modal-mono);
    font-size: 0.76rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ccc-gold, #c9a96e);
  }
  .ccc-req {
    color: var(--ccc-gold-light, #e5cb9e);
    font-weight: 400;
  }
  .ccc-field input:not([type="checkbox"]),
  .ccc-field textarea,
  .ccc-field select {
    width: 100%;
    min-height: 48px;
    padding: 0.75rem 0.95rem;
    background: #121212;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 0;
    color: var(--ccc-cream, #fbf7f0);
    font-family: inherit;
    font-size: 0.95rem;
    line-height: 1.4;
    box-sizing: border-box;
    color-scheme: dark;
    transition: border-color 0.2s ease;
  }
  .ccc-field input:focus-visible,
  .ccc-field textarea:focus-visible,
  .ccc-field select:focus-visible {
    outline: 2px solid var(--ccc-gold, #c9a96e);
    outline-offset: 2px;
    border-color: var(--ccc-gold, #c9a96e);
  }
  .ccc-field textarea {
    min-height: 6rem;
    resize: vertical;
  }

  /* Checkboxes */
  .ccc-checkbox-group {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.65rem;
    margin-top: 0.35rem;
  }
  @media (min-width: 640px) {
    .ccc-checkbox-group {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.85rem;
    }
  }
  .ccc-checkbox-label {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    padding: 0.75rem 0.9rem;
    background: #141414;
    border: 1px solid rgba(255, 255, 255, 0.12);
    font-size: 0.85rem;
    line-height: 1.35;
    color: var(--ccc-cream-soft, #ede7dc);
    cursor: pointer;
    user-select: none;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }
  .ccc-checkbox-label:hover {
    border-color: rgba(201, 169, 110, 0.5);
    background: #181818;
  }
  .ccc-checkbox-label input[type="checkbox"] {
    margin-top: 0.15rem;
    accent-color: var(--ccc-gold, #c9a96e);
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    cursor: pointer;
  }

  .ccc-pricing-note {
    margin: 0 0 0.85rem;
    padding: 0.85rem 1.1rem;
    background: rgba(201, 169, 110, 0.08);
    border-left: 3px solid var(--ccc-gold, #c9a96e);
    font-family: var(--ccc-modal-serif);
    font-size: 1.15rem;
    line-height: 1.5;
    color: var(--ccc-cream-soft, #ede7dc);
  }
  .ccc-help-text {
    margin: 0.35rem 0 0;
    font-family: var(--ccc-modal-serif);
    font-style: italic;
    font-size: 1.05rem;
    line-height: 1.45;
    color: var(--ccc-gold-light, #e5cb9e);
  }
  .ccc-submit-btn {
    width: 100%;
    min-height: 52px;
    margin-top: 0.5rem;
    font-family: var(--ccc-modal-mono);
    font-size: 0.88rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  /* Confirmation */
  .ccc-confirm-box[hidden] {
    display: none;
  }
  .ccc-confirm-box {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .ccc-confirm-header {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .ccc-confirm-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border: 1px solid var(--ccc-gold, #c9a96e);
    color: var(--ccc-gold, #c9a96e);
    font-size: 1.15rem;
    flex-shrink: 0;
  }
  .ccc-confirm-title {
    margin: 0;
    font-family: var(--ccc-modal-display);
    font-size: clamp(1.2rem, 2.5vw, 1.45rem);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--ccc-cream, #fbf7f0);
  }
  .ccc-confirm-desc {
    margin: 0;
    font-family: var(--ccc-modal-serif);
    font-size: 1.2rem;
    line-height: 1.6;
    color: var(--ccc-cream-soft, #ede7dc);
  }
  .ccc-confirm-desc a {
    color: var(--ccc-gold-light, #e5cb9e);
    text-decoration: underline;
  }
  .ccc-copy-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }
  .ccc-copy-payload {
    width: 100%;
    padding: 0.85rem;
    background: #141414;
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: var(--ccc-cream-soft, #ede7dc);
    font-family: var(--ccc-modal-mono);
    font-size: 0.82rem;
    line-height: 1.5;
    resize: vertical;
    box-sizing: border-box;
  }
  .ccc-confirm-actions {
    width: 100%;
    margin-top: 0.5rem;
  }
</style>

<script>
  function initCccModal() {
    const dialog = document.getElementById('ccc-inquiry-modal') as HTMLDialogElement | null;
    if (!dialog || dialog.dataset.cccWired === '1') return;
    dialog.dataset.cccWired = '1';

    const closeBtn = document.getElementById('ccc-modal-close');
    const form = document.getElementById('ccc-inquiry-form') as HTMLFormElement | null;
    const confirmBox = document.getElementById('ccc-confirm-box');
    const copyBtn = document.getElementById('ccc-copy-btn');
    const copyPayload = document.getElementById('ccc-copy-payload') as HTMLTextAreaElement | null;
    const mailtoLink = document.getElementById('ccc-mailto-link') as HTMLAnchorElement | null;
    const dateInput = document.getElementById('ccc-date') as HTMLInputElement | null;

    if (dateInput && !dateInput.min) {
      dateInput.min = new Date().toISOString().split('T')[0];
    }

    function openModal() {
      if (!dialog) return;
      if (form && confirmBox) {
        form.hidden = false;
        confirmBox.hidden = true;
      }
      if (!dialog.open) {
        dialog.showModal();
      }
    }

    function closeModal() {
      if (dialog?.open) {
        dialog.close();
      }
    }

    document.querySelectorAll<HTMLElement>('[data-open-ccc-modal]').forEach((trigger) => {
      trigger.addEventListener('click', (e) => {
        e.preventDefault();
        openModal();
      });
    });

    closeBtn?.addEventListener('click', closeModal);

    // Fallback for browsers without declarative closedby="any" support
    if (!('closedBy' in HTMLDialogElement.prototype)) {
      const outside = (e: PointerEvent, d: HTMLDialogElement) => {
        const r = d.getBoundingClientRect();
        return e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom;
      };
      let pressedOutside = false;
      dialog.addEventListener('pointerdown', (e) => {
        pressedOutside = outside(e, dialog);
      });
      dialog.addEventListener('pointerup', (e) => {
        if (pressedOutside && outside(e, dialog)) dialog.close();
      });
    }

    // Wrap Tab focus inside open modal
    dialog.addEventListener('keydown', (e) => {
      if (e.key !== 'Tab' || !dialog.open) return;
      const focusables = Array.from(
        dialog.querySelectorAll<HTMLElement>(
          'button:not([disabled]), [href], input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'
        )
      ).filter((el) => !el.closest('[hidden]') && el.offsetWidth > 0 && el.offsetHeight > 0);
      if (focusables.length === 0) return;
      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      const data = new FormData(form);
      const name = String(data.get('name') || '').trim();
      const email = String(data.get('email') || '').trim();
      const venue = String(data.get('venue') || '').trim();
      const location = String(data.get('location') || '').trim();
      const service = String(data.get('service') || '').trim();
      const preferredDates = String(data.get('preferredDate') || '').trim();
      const budget = String(data.get('budget') || '').trim();
      const showOff = String(data.get('showOff') || '').trim();

      const selectedAddons = data.getAll('addons').map((a) => String(a).trim()).filter(Boolean);
      const addonsSummary = selectedAddons.length > 0 ? selectedAddons.join(', ') : 'None selected';

      const recipient = 'capturecreatecaffeinate@gmail.com';
      const subject = `CCC shoot inquiry: ${venue}`;
      const bodyLines = [
        `Name: ${name}`,
        `Email: ${email}`,
        `Venue: ${venue}`,
        `Location: ${location}`,
        `Package/Service: ${service}`,
        `Add-ons: ${addonsSummary}`,
        `Preferred dates: ${preferredDates}`,
        `Budget: ${budget}`,
        `Special requests & details: ${showOff}`,
      ];
      const bodyText = bodyLines.join('\n');
      const mailtoUrl = `mailto:${recipient}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(bodyText)}`;

      form.dataset.lastMailto = mailtoUrl;
      form.hidden = true;
      if (confirmBox) confirmBox.hidden = false;
      if (copyPayload) {
        copyPayload.value = `To: ${recipient}\nSubject: ${subject}\n\n${bodyText}`;
      }
      if (mailtoLink) {
        mailtoLink.href = mailtoUrl;
      }

      // Open mail client via temporary link click
      const tempLink = document.createElement('a');
      tempLink.href = mailtoUrl;
      tempLink.style.display = 'none';
      document.body.appendChild(tempLink);
      tempLink.click();
      tempLink.remove();

      copyBtn?.focus();
    });

    copyBtn?.addEventListener('click', () => {
      if (!copyPayload) return;
      const text = copyPayload.value;
      const onCopied = () => {
        copyBtn.textContent = 'Copied';
        window.setTimeout(() => {
          copyBtn.textContent = 'Copy email text';
        }, 2000);
      };
      if (navigator.clipboard?.writeText) {
        navigator.clipboard.writeText(text).then(onCopied).catch(() => {
          copyPayload.select();
          document.execCommand('copy');
          onCopied();
        });
      } else {
        copyPayload.select();
        document.execCommand('copy');
        onCopied();
      }
    });

    // Support ?inquiry=1 query param to auto-open modal
    const params = new URLSearchParams(window.location.search);
    if (params.get('inquiry') === '1') {
      openModal();
    }
  }

  initCccModal();
  document.addEventListener('astro:page-load', initCccModal);
</script>
