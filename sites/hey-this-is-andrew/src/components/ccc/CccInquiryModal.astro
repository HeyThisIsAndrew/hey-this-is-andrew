---
/**
 * CccInquiryModal.astro
 * Streamlined project inquiry modal for Capture Create Caffeinate.
 * Reduced to 5 high-conversion fields:
 * - Your name (required)
 * - Email (required)
 * - Venue name (required)
 * - What do you need? (required select with auto-selection support)
 * - Dates, details, or questions (optional textarea)
 *
 * Punctuation hygiene: zero em dashes throughout.
 */
import { CCC_EMAIL } from '../../data/ccc';
---

<dialog
  id="ccc-inquiry-modal"
  class="ccc-modal"
  closedby="any"
  aria-labelledby="ccc-modal-title"
>
  <div class="ccc-modal-card">
    <header class="ccc-modal-head">
      <div class="ccc-modal-titles">
        <p class="ccc-modal-eyebrow font-mono">Capture Create Caffeinate</p>
        <h2 id="ccc-modal-title" class="ccc-modal-title">Contact</h2>
      </div>
      <button
        type="button"
        class="ccc-modal-close"
        id="ccc-modal-close"
        aria-label="Close modal"
      >&times;</button>
    </header>

    <form id="ccc-inquiry-form" class="ccc-form" data-ccc-email={CCC_EMAIL}>
      <div class="ccc-form-grid">
        <div class="ccc-field">
          <label for="ccc-name">Your name <span class="ccc-req" aria-hidden="true">*</span></label>
          <input
            type="text"
            id="ccc-name"
            name="name"
            required
            autocomplete="name"
            placeholder="First and last name"
          />
        </div>

        <div class="ccc-field">
          <label for="ccc-email">Email <span class="ccc-req" aria-hidden="true">*</span></label>
          <input
            type="email"
            id="ccc-email"
            name="email"
            required
            autocomplete="email"
            placeholder="you@venue.com"
            autocorrect="off"
            autocapitalize="off"
            spellcheck="false"
          />
        </div>
      </div>

      <div class="ccc-form-grid">
        <div class="ccc-field">
          <label for="ccc-venue">Venue name <span class="ccc-req" aria-hidden="true">*</span></label>
          <input
            type="text"
            id="ccc-venue"
            name="venue"
            required
            placeholder="Venue name & city"
            autocomplete="organization"
          />
        </div>

        <div class="ccc-field">
          <label for="ccc-service">What do you need? <span class="ccc-req" aria-hidden="true">*</span></label>
          <select id="ccc-service" name="service" required>
            <option value="" disabled selected>Select a package or service</option>
            <option value="Photo + vertical reel bundle">Photo + vertical reel bundle</option>
            <option value="Half-day photo session">Half-day photo session</option>
            <option value="Vertical reel add-on">Vertical reel add-on</option>
            <option value="Events or multi-day coverage">Events or multi-day coverage</option>
            <option value="Other / Let's talk">Other / Let's talk</option>
          </select>
        </div>
      </div>

      <div class="ccc-field ccc-field--full">
        <label for="ccc-notes">Dates, details, or questions</label>
        <textarea
          id="ccc-notes"
          name="notes"
          rows="3"
          placeholder="Preferred dates, what you want to show off, or any questions."
        ></textarea>
      </div>

      <button type="submit" class="btn btn-primary ccc-submit-btn">
        Open email draft <span aria-hidden="true">&rarr;</span>
      </button>
    </form>

    <!-- Confirmation / Fallback State -->
    <div id="ccc-confirm-box" class="ccc-confirm-box" hidden>
      <div class="ccc-confirm-header">
        <div class="ccc-confirm-icon" aria-hidden="true">&#10003;</div>
        <p id="ccc-confirm-msg" class="ccc-confirm-title" role="status" aria-live="polite">
          Your inquiry is ready to send
        </p>
      </div>
      <p class="ccc-confirm-desc">
        Send the message from your mail app, or copy the composed inquiry below and email it to
        <a href={`mailto:${CCC_EMAIL}`}>{CCC_EMAIL}</a>.
      </p>

      <div class="ccc-copy-wrap">
        <label for="ccc-copy-payload" class="ccc-copy-label font-mono">Composed email text</label>
        <textarea
          id="ccc-copy-payload"
          class="ccc-copy-payload"
          readonly
          rows="8"
        ></textarea>
        <div class="ccc-confirm-actions btn-group">
          <button type="button" id="ccc-copy-btn" class="btn btn-primary">
            Copy email text
          </button>
          <a id="ccc-mailto-link" class="btn btn-secondary" href={`mailto:${CCC_EMAIL}`}>
            Open mail app
          </a>
        </div>
      </div>
    </div>
  </div>
</dialog>

<style>
  /* CCC Brand Typography & Theme */
  .ccc-modal {
    --ccc-modal-display: 'Cinzel', Georgia, 'Times New Roman', serif;
    --ccc-modal-accent: 'Bodoni Moda', Georgia, 'Times New Roman', serif;
    --ccc-modal-serif: 'Newsreader', Georgia, 'Times New Roman', serif;
    --ccc-modal-mono: 'JetBrains Mono', ui-monospace, 'SF Mono', monospace;
    --ccc-gold: #c9a96e;
    --ccc-gold-light: #e5cb9e;
    --ccc-cream: #fbf7f0;
    --ccc-cream-soft: #ede7dc;
  }

  /* Modern Web Guidance: modal overscroll containment */
  .ccc-modal:modal {
    overscroll-behavior: contain;
  }
  .ccc-modal::backdrop {
    overflow: hidden;
    overscroll-behavior: contain;
    background: rgba(0, 0, 0, 0.94);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  .ccc-modal {
    padding: 0;
    margin: auto;
    width: min(100% - 2rem, clamp(44rem, 31vw, 74rem));
    max-width: calc(100vw - 2rem);
    max-height: calc(100svh - 3rem);
    max-height: calc(100dvh - 3rem);
    background: #0b0b0b;
    color: var(--ccc-cream, #fbf7f0);
    border: 1px solid rgba(201, 169, 110, 0.35);
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.9);
    overflow-y: auto;
    overflow-x: hidden;
    box-sizing: border-box;
  }
  .ccc-modal[open] {
    display: block;
  }
  .ccc-modal-card {
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
    width: 100%;
    box-sizing: border-box;
    overflow-x: hidden;
  }
  .ccc-modal-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
    padding-bottom: 1.1rem;
    border-bottom: 1px solid rgba(201, 169, 110, 0.22);
  }
  .ccc-modal-eyebrow {
    margin: 0 0 0.35rem;
    font-family: var(--ccc-modal-mono);
    font-size: 0.78rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--ccc-gold, #c9a96e);
  }
  .ccc-modal-title {
    margin: 0;
    font-family: var(--ccc-modal-display);
    font-size: clamp(1.6rem, 3.2vw, 2.2rem);
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--ccc-cream, #fbf7f0);
  }

  /* The Close X: exact Be Unconventional HQ design
     Bare white x, no box, no border, no background in any state.
     Hover and click rotate 90 degrees smoothly. */
  .ccc-modal-close {
    appearance: none;
    background: none;
    border: none;
    color: var(--ccc-cream, #fbf7f0);
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    font-size: 2.5rem;
    font-weight: 300;
    line-height: 1;
    padding: 0;
    margin: 0;
    width: 44px;
    height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
    outline: none;
    box-shadow: none;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    transition: color 0.3s ease, transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @media (hover: hover) {
    .ccc-modal-close:hover {
      color: var(--ccc-gold, #c9a96e);
      transform: rotate(90deg);
    }
  }

  .ccc-modal-close:focus-visible {
    outline: 1px solid var(--ccc-gold, #c9a96e);
    outline-offset: 2px;
  }

  .ccc-modal-close.is-turning {
    color: var(--ccc-gold, #c9a96e);
    transform: rotate(90deg);
  }

  .ccc-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .ccc-form-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.15rem;
  }
  @media (min-width: 640px) {
    .ccc-form-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem;
    }
  }

  .ccc-field {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .ccc-field--full {
    width: 100%;
  }
  .ccc-field label,
  .ccc-field-label,
  .ccc-copy-label {
    font-family: var(--ccc-modal-mono);
    font-size: 0.76rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ccc-gold, #c9a96e);
  }
  .ccc-req {
    color: var(--ccc-gold-light, #e5cb9e);
    font-weight: 400;
  }
  .ccc-field input,
  .ccc-field textarea,
  .ccc-field select {
    width: 100%;
    max-width: 100%;
    min-height: 48px;
    padding: 0.75rem 0.95rem;
    background: #121212;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 0;
    color: var(--ccc-cream, #fbf7f0);
    font-family: inherit;
    font-size: 16px; /* Prevents iOS Safari auto-zoom on input focus */
    line-height: 1.4;
    box-sizing: border-box;
    color-scheme: dark;
    transition: border-color 0.2s ease;
  }
  .ccc-field input:focus-visible,
  .ccc-field textarea:focus-visible,
  .ccc-field select:focus-visible {
    outline: 2px solid var(--ccc-gold, #c9a96e);
    outline-offset: 2px;
    border-color: var(--ccc-gold, #c9a96e);
  }
  .ccc-field textarea {
    min-height: 5rem;
    resize: vertical;
  }

  .ccc-submit-btn {
    width: 100%;
    min-height: 50px;
    margin-top: 0.35rem;
    font-family: var(--ccc-modal-mono);
    font-size: 0.88rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  /* Mobile Fullscreen & iOS Keyboard Hardening */
  @media (max-width: 640px) {
    .ccc-modal {
      position: fixed !important;
      inset: 0 !important;
      width: 100vw !important;
      max-width: 100vw !important;
      height: 100% !important;
      height: 100dvh !important;
      max-height: 100dvh !important;
      margin: 0 !important;
      border: none !important;
      border-top: 1px solid rgba(201, 169, 110, 0.35) !important;
      border-radius: 0 !important;
      background: #080808 !important;
      overflow-x: hidden !important;
      overflow-y: auto !important;
      -webkit-overflow-scrolling: touch;
      overscroll-behavior: contain;
    }
    .ccc-modal-card {
      padding: 1.25rem 1.1rem calc(2rem + env(safe-area-inset-bottom, 20px)) !important;
      width: 100% !important;
      max-width: 100% !important;
      box-sizing: border-box !important;
      overflow-x: hidden !important;
      background: #080808;
    }
    .ccc-modal-head {
      margin-bottom: 1.15rem;
      padding-bottom: 0.85rem;
    }
    .ccc-field input,
    .ccc-field textarea,
    .ccc-field select {
      font-size: 16px !important;
      min-height: 48px;
    }
    .ccc-copy-payload {
      font-size: 16px !important;
    }
    .ccc-form-grid {
      grid-template-columns: 1fr !important;
      gap: 1.15rem !important;
    }
  }

  /* Confirmation */
  .ccc-confirm-box[hidden] {
    display: none;
  }
  .ccc-confirm-box {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .ccc-confirm-header {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .ccc-confirm-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border: 1px solid var(--ccc-gold, #c9a96e);
    color: var(--ccc-gold, #c9a96e);
    font-size: 1.15rem;
    flex-shrink: 0;
  }
  .ccc-confirm-title {
    margin: 0;
    font-family: var(--ccc-modal-display);
    font-size: clamp(1.2rem, 2.5vw, 1.45rem);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--ccc-cream, #fbf7f0);
  }
  .ccc-confirm-desc {
    margin: 0;
    font-family: var(--ccc-modal-serif);
    font-size: 1.2rem;
    line-height: 1.6;
    color: var(--ccc-cream-soft, #ede7dc);
  }
  .ccc-confirm-desc a {
    color: var(--ccc-gold-light, #e5cb9e);
    text-decoration: underline;
  }
  .ccc-copy-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }
  .ccc-copy-wrap[hidden] {
    display: none !important;
  }
  .ccc-copy-payload {
    width: 100%;
    padding: 0.85rem;
    background: #141414;
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: var(--ccc-cream-soft, #ede7dc);
    font-family: var(--ccc-modal-mono);
    font-size: 0.82rem;
    line-height: 1.5;
    resize: vertical;
    box-sizing: border-box;
  }
  .ccc-confirm-actions {
    width: 100%;
    margin-top: 0.5rem;
  }

  @media (min-width: 1920px) and (min-height: 840px) {
    .ccc-modal-card {
      padding: clamp(2.5rem, 1.45vw, 3.5rem);
    }
    .ccc-modal-title {
      font-size: clamp(2.2rem, 1.4vw, 3.2rem);
    }
    .ccc-modal-eyebrow,
    .ccc-field label,
    .ccc-copy-label {
      font-size: clamp(0.78rem, 0.47vw, 1.05rem);
    }
    .ccc-field input,
    .ccc-field textarea,
    .ccc-field select {
      min-height: clamp(48px, 1.75vw, 66px);
      font-size: clamp(16px, 0.57vw, 21px);
    }
    .ccc-field textarea {
      min-height: 8rem;
    }
    .ccc-submit-btn {
      min-height: 64px;
      font-size: 1rem;
    }
  }
</style>

<script>
  import { lockBody } from '../../lib/spatial.ts';

  function initCccModal() {
    const dialog = document.getElementById('ccc-inquiry-modal') as HTMLDialogElement | null;
    if (!dialog || dialog.dataset.cccWired === '1') return;
    dialog.dataset.cccWired = '1';

    const closeBtn = document.getElementById('ccc-modal-close');
    const form = document.getElementById('ccc-inquiry-form') as HTMLFormElement | null;
    const confirmBox = document.getElementById('ccc-confirm-box');
    const copyBtn = document.getElementById('ccc-copy-btn');
    const copyPayload = document.getElementById('ccc-copy-payload') as HTMLTextAreaElement | null;
    const mailtoLink = document.getElementById('ccc-mailto-link') as HTMLAnchorElement | null;
    const serviceSelect = document.getElementById('ccc-service') as HTMLSelectElement | null;

    let unlockBody: (() => void) | null = null;
    let lastTriggerEl: HTMLElement | null = null;

    function restoreTriggerFocus() {
      if (!lastTriggerEl || !document.contains(lastTriggerEl)) return;
      const parentCard = lastTriggerEl.closest<HTMLElement>('.flip-card');
      const isHiddenAction =
        lastTriggerEl.getAttribute('aria-hidden') === 'true' ||
        lastTriggerEl.getAttribute('tabindex') === '-1' ||
        (parentCard && !parentCard.classList.contains('is-flipped') && !parentCard.matches(':hover'));
      const target = isHiddenAction
        ? parentCard?.querySelector<HTMLElement>('.flip-card-toggle') ?? lastTriggerEl
        : lastTriggerEl;
      lastTriggerEl = null;
      target.focus({ preventScroll: true });
    }

    function selectPackage(pkg: string | undefined | null) {
      if (!pkg || !serviceSelect) return;
      const p = pkg.toLowerCase().trim();

      // 1. Exact value or text match first
      for (const opt of Array.from(serviceSelect.options)) {
        const val = opt.value.toLowerCase();
        const txt = opt.text.toLowerCase();
        if (val === p || txt === p) {
          serviceSelect.value = opt.value;
          return;
        }
      }

      // 2. Bundle / photo + reel
      if (p === 'bundle' || p === 'photo-reel' || p === 'photo+reel' || p.includes('both')) {
        for (const opt of Array.from(serviceSelect.options)) {
          if (opt.value.toLowerCase().includes('bundle') || opt.text.toLowerCase().includes('bundle')) {
            serviceSelect.value = opt.value;
            return;
          }
        }
      }

      // 3. Reel only / add-on
      if (p === 'reel') {
        for (const opt of Array.from(serviceSelect.options)) {
          const val = opt.value.toLowerCase();
          const txt = opt.text.toLowerCase();
          if ((val.includes('reel add-on') || val.includes('reel only') || txt.includes('vertical reel')) && !val.includes('bundle') && !val.includes('+')) {
            serviceSelect.value = opt.value;
            return;
          }
        }
      }

      // 4. Photo session
      if (p === 'photo') {
        for (const opt of Array.from(serviceSelect.options)) {
          const val = opt.value.toLowerCase();
          const txt = opt.text.toLowerCase();
          if ((val.includes('photo session') || txt.includes('photo session')) && !val.includes('bundle') && !val.includes('+')) {
            serviceSelect.value = opt.value;
            return;
          }
        }
      }

      // 5. Events
      if (p === 'event' || p === 'events') {
        for (const opt of Array.from(serviceSelect.options)) {
          if (opt.value.toLowerCase().includes('event') || opt.text.toLowerCase().includes('event')) {
            serviceSelect.value = opt.value;
            return;
          }
        }
      }
    }

    function updateVisualViewport() {
      if (!window.visualViewport || !dialog?.open) return;
      if (window.innerWidth <= 640) {
        const vvH = window.visualViewport.height;
        dialog.style.height = `${vvH}px`;
        dialog.style.maxHeight = `${vvH}px`;
      } else {
        dialog.style.height = '';
        dialog.style.maxHeight = '';
      }
    }

    if (window.visualViewport) {
      window.visualViewport.addEventListener('resize', updateVisualViewport);
      window.visualViewport.addEventListener('scroll', updateVisualViewport);
    }

    function openModal(pkg?: string | null, trigger?: HTMLElement | null) {
      if (!dialog) return;
      lastTriggerEl = trigger || (document.activeElement as HTMLElement) || null;
      if (form && confirmBox) {
        form.hidden = false;
        confirmBox.hidden = true;
      }
      if (pkg) {
        selectPackage(pkg);
      }
      closeBtn?.classList.remove('is-turning');
      if (!dialog.open) {
        unlockBody = lockBody();
        dialog.showModal();
        dialog.focus();
        updateVisualViewport();
      }
    }

    function closeModal() {
      if (dialog?.open) {
        dialog.close();
      }
      if (unlockBody) {
        unlockBody();
        unlockBody = null;
      }
      closeBtn?.classList.remove('is-turning');
      if (dialog) {
        dialog.style.height = '';
        dialog.style.maxHeight = '';
      }
      restoreTriggerFocus();
    }

    dialog.addEventListener('close', () => {
      if (unlockBody) {
        unlockBody();
        unlockBody = null;
      }
      closeBtn?.classList.remove('is-turning');
      if (dialog) {
        dialog.style.height = '';
        dialog.style.maxHeight = '';
      }
      restoreTriggerFocus();
    });

    // Delegated click handler for modal triggers
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null;
      if (!target) return;
      const trigger = target.closest<HTMLElement>('[data-open-ccc-modal]');
      if (!trigger) return;
      // Do not intercept if clicked inside an open dialog form or other interactive controls
      if (trigger.closest('#ccc-inquiry-modal')) return;
      // Inside a flip card, only allow opening the modal when the card is already flipped to its back face
      const parentFlipCard = trigger.closest<HTMLElement>('.flip-card');
      if (parentFlipCard) {
        const isHoverFlipped =
          window.matchMedia('(hover: hover) and (pointer: fine)').matches && parentFlipCard.matches(':hover');
        if (!parentFlipCard.classList.contains('is-flipped') && !isHoverFlipped) {
          return;
        }
      }
      e.preventDefault();
      const pkg = trigger.dataset.cccPackage || trigger.closest<HTMLElement>('[data-ccc-package]')?.dataset.cccPackage;
      openModal(pkg, trigger);
    });

    // The X rotates 90 degrees on click / tap before closing, matching Be Unconventional HQ
    closeBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      closeBtn.classList.add('is-turning');
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.setTimeout(() => {
        closeModal();
      }, prefersReduced ? 0 : 250);
    });

    // A click on the dialog backdrop outside the modal card closes it
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) {
        closeModal();
      }
    });

    // Wrap Tab focus inside open modal
    dialog.addEventListener('keydown', (e) => {
      if (e.key !== 'Tab' || !dialog.open) return;
      const focusables = Array.from(
        dialog.querySelectorAll<HTMLElement>(
          'button:not([disabled]), [href], input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'
        )
      ).filter((el) => !el.closest('[hidden]') && el.offsetWidth > 0 && el.offsetHeight > 0);
      if (focusables.length === 0) return;
      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      const data = new FormData(form);
      const name = String(data.get('name') || '').trim();
      const email = String(data.get('email') || '').trim();
      const venue = String(data.get('venue') || '').trim();
      const service = String(data.get('service') || '').trim();
      const notes = String(data.get('notes') || '').trim();

      const recipient = form.dataset.cccEmail || '';
      const subject = `CCC shoot inquiry: ${venue || name}`;
      const bodyLines = [
        `Name: ${name}`,
        `Email: ${email}`,
        `Venue: ${venue}`,
        `Package/Service: ${service}`,
        `Notes & dates: ${notes || 'None provided'}`,
      ];
      const bodyText = bodyLines.join('\n');
      const mailtoUrl = `mailto:${recipient}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(bodyText)}`;

      const payload = {
        name,
        email,
        venue,
        service,
        notes,
        recipient,
        subject,
      };

      let success = false;
      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (res.ok) {
          success = true;
        }
      } catch {
        success = false;
      }

      if (success) {
        form.hidden = true;
        if (confirmBox) {
          confirmBox.hidden = false;
          const confirmMsg = document.getElementById('ccc-confirm-msg');
          if (confirmMsg) confirmMsg.textContent = 'Thanks. We will get back to you to schedule a call.';
          const confirmDesc = confirmBox.querySelector<HTMLElement>('.ccc-confirm-desc');
          if (confirmDesc) confirmDesc.textContent = 'Your inquiry has been received. We will be in touch shortly.';
          const copyWrap = confirmBox.querySelector<HTMLElement>('.ccc-copy-wrap');
          if (copyWrap) {
            copyWrap.hidden = true;
            copyWrap.style.display = 'none';
          }
        }
        return;
      }

      // Fallback: mailto behavior
      form.dataset.lastMailto = mailtoUrl;
      form.hidden = true;
      if (confirmBox) {
        confirmBox.hidden = false;
        const confirmMsg = document.getElementById('ccc-confirm-msg');
        if (confirmMsg) confirmMsg.textContent = 'Your inquiry is ready to send';
        const confirmDesc = confirmBox.querySelector<HTMLElement>('.ccc-confirm-desc');
        if (confirmDesc) {
          confirmDesc.innerHTML = `Send the message from your mail app, or copy the composed inquiry below and email it to <a href="mailto:${recipient}">${recipient}</a>.`;
        }
        const copyWrap = confirmBox.querySelector<HTMLElement>('.ccc-copy-wrap');
        if (copyWrap) {
          copyWrap.hidden = false;
          copyWrap.style.display = '';
        }
      }
      if (copyPayload) {
        copyPayload.value = `To: ${recipient}\nSubject: ${subject}\n\n${bodyText}`;
      }
      if (mailtoLink) {
        mailtoLink.href = mailtoUrl;
      }

      // Open mail client via temporary link click
      const tempLink = document.createElement('a');
      tempLink.href = mailtoUrl;
      tempLink.style.display = 'none';
      document.body.appendChild(tempLink);
      tempLink.click();
      tempLink.remove();

      copyBtn?.focus();
    });

    copyBtn?.addEventListener('click', () => {
      if (!copyPayload) return;
      const text = copyPayload.value;
      const onCopied = () => {
        copyBtn.textContent = 'Copied';
        window.setTimeout(() => {
          copyBtn.textContent = 'Copy email text';
        }, 2000);
      };
      if (navigator.clipboard?.writeText) {
        navigator.clipboard.writeText(text).then(onCopied).catch(() => {
          copyPayload.select();
          document.execCommand('copy');
          onCopied();
        });
      } else {
        copyPayload.select();
        document.execCommand('copy');
        onCopied();
      }
    });

    // Support ?inquiry=1 and ?package=... query params to auto-open modal and select package
    const params = new URLSearchParams(window.location.search);
    if (params.get('inquiry') === '1' || params.has('package')) {
      openModal(params.get('package'));
    }
  }

  initCccModal();
  document.addEventListener('astro:page-load', initCccModal);
</script>
