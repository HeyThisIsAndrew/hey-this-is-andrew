---
/**
 * The brands section (#directory, alias #brands): this site's heading around
 * the shared BrandAccordion (@andrew/ui), fed from src/data/brands.ts.
 * The accordion's mechanics, markup and styles live in the package; this
 * file only places it.
 */
import SectionHeader from '@andrew/ui/SectionHeader.astro';
import BrandAccordion from '@andrew/ui/BrandAccordion.astro';
import { childBrands } from '../data/brands';
---
<section id="directory" aria-labelledby="directory-heading" class="brand-accordion-section">
  <span id="brands" class="bacc-anchor" aria-hidden="true"></span>
  <div class="container lanes-intro">
    <SectionHeader id="directory-heading" index="01" kicker="The lanes" title="The brands" />
  </div>
  <BrandAccordion panels={childBrands} fullscreen />
</section>

<style>
  .brand-accordion-section {
    padding-block: 0;
    position: relative;
  }
  /* #brands is an alias for #directory (both land on this section). */
  .bacc-anchor {
    position: absolute;
    top: 0;
  }
  .lanes-intro {
    padding-top: clamp(3rem, 6vw, 5rem);
    padding-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }
  .lanes-intro :global(.sec-head) {
    margin-bottom: 0;
  }
</style>
