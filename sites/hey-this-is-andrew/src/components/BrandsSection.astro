---
/**
 * The brands section (#directory, alias #brands): this site's heading around
 * the shared BrandAccordion (@andrew/ui), fed from src/data/brands.ts.
 * The accordion's mechanics, markup and styles live in the package; this
 * file only places it.
 */
import SectionHeader from '@andrew/ui/SectionHeader.astro';
import BrandAccordion from '@andrew/ui/BrandAccordion.astro';
import { childBrands } from '../data/brands';

interface Props {
  /** Tighter heading padding, so the panels reach into the first viewport
      under a shortened hero (concept D). */
  tight?: boolean;
}
const { tight = false } = Astro.props;
const isHomepage = Astro.url.pathname.replace(/\/$/, '') === import.meta.env.BASE_URL.replace(/\/$/, '');
const homeActions: Record<string, string> = {
  be: 'Explore',
  ccc: 'Explore',
};
const panels = isHomepage
  ? childBrands.map((brand) => ({
      ...brand,
      cta: homeActions[brand.id] ?? brand.cta,
      teaserTag: brand.comingSoon ? 'Coming Soon' : brand.teaserTag,
    })).sort((a, b) => a.name.localeCompare(b.name, 'en'))
  : childBrands;
---
<section id="directory" aria-labelledby="directory-heading" class:list={['brand-accordion-section', { 'is-tight': tight }]}>
  <span id="brands" class="bacc-anchor" aria-hidden="true"></span>
  <div class="container lanes-intro">
    <SectionHeader id="directory-heading" title="Brands" variant="chip" />
  </div>
  <BrandAccordion {panels} fullscreen focusedActionsOnly={isHomepage} />
</section>

<style>
  .brand-accordion-section {
    padding-block: 0;
    position: relative;
    scroll-margin-top: calc(var(--nav-h, 60px) + 24px);
  }
  /* #brands is an alias for #directory (both land on this section). */
  .bacc-anchor {
    position: absolute;
    top: 0;
    scroll-margin-top: calc(var(--nav-h, 60px) + 24px);
  }
  :global(#directory-heading) {
    scroll-margin-top: calc(var(--nav-h, 60px) + 24px);
  }
  /* A metadata chip names the section; the gaps around it stay small so
     the homepage reads as one flow. */
  .lanes-intro {
    padding-top: clamp(1.25rem, 2.5vw, 2rem);
    padding-bottom: clamp(0.25rem, 0.6vw, 0.5rem);
  }
  .is-tight .lanes-intro {
    padding-top: clamp(1.25rem, 2.5vh, 2rem);
    padding-bottom: clamp(1rem, 2vh, 1.5rem);
  }
  .lanes-intro :global(.sec-head) {
    margin-bottom: 0;
  }
  /* No rule under "The brands": with the accordion directly beneath it, the
     hairline vanished and its square end read as a stray full stop. */
  .lanes-intro :global(.sec-rule) {
    display: none;
  }
</style>
