---
/**
 * Hero concept A (HQ-style): the brand accordion IS the hero. Nav, then
 * straight into the brands; no carousel above them.
 */
import BrandAccordion from '@andrew/ui/BrandAccordion.astro';
import { childBrands } from '../../data/brands';
---
<section id="directory" class="hero-brands" aria-labelledby="hero-brands-title">
  <span id="brands" class="anchor-alias" aria-hidden="true"></span>
  <span id="overview" class="anchor-alias" aria-hidden="true"></span>
  <h2 id="hero-brands-title" class="vh">The brands</h2>
  <BrandAccordion panels={childBrands} fullscreen />
</section>

<style>
  .hero-brands {
    position: relative;
    padding: 0;
  }
  .anchor-alias {
    position: absolute;
    top: 0;
  }
</style>
