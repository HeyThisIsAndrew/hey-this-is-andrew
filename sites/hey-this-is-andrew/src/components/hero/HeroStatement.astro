---
/**
 * Hero concept B (statement): one bold frame. The wordmark, one line, one
 * call to action, and the cinematic portrait. The brands follow as their own
 * section.
 */
import { Image } from 'astro:assets';
import portrait from '../../assets/hero-media/portrait.jpg';
import wordmark from '../../assets/brand-logos/hey-thisisandrew.svg';
---
<section id="overview" class="hero-statement" aria-labelledby="hero-statement-title">
  <div class="hs-media" aria-hidden="true">
    <Image src={portrait} alt="" widths={[960, 1440, 1920, 2560]} sizes="100vw" format="webp" loading="eager" fetchpriority="high" />
  </div>
  <div class="hs-scrim" aria-hidden="true"></div>
  <div class="container hs-content">
    <h2 id="hero-statement-title" class="hs-wordmark">
      <img src={wordmark.src} width={wordmark.width} height={wordmark.height} alt="HEY_THISISANDREW" />
    </h2>
    <p class="hs-line">Documenting the messy middle of building three brands, commercial photography, and creator automation.</p>
    <a class="btn btn-primary hs-cta" href="#directory">See the brands <span aria-hidden="true">↓</span></a>
  </div>
</section>

<style>
  .hero-statement {
    position: relative;
    min-height: calc(100svh - var(--nav-h));
    display: flex;
    align-items: flex-end;
    padding: 0 0 clamp(3rem, 8vh, 6rem);
    overflow: hidden;
    background: #000;
  }
  .hs-media {
    position: absolute;
    inset: 0;
  }
  .hs-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% 25%;
    filter: grayscale(0.2) contrast(1.05);
  }
  .hs-scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(8, 8, 8, 0.92) 0%, rgba(8, 8, 8, 0.55) 45%, rgba(8, 8, 8, 0.1) 75%),
      linear-gradient(to top, rgba(8, 8, 8, 0.95) 0%, transparent 45%);
  }
  .hs-content {
    position: relative;
    z-index: 1;
  }
  .hs-wordmark {
    margin: 0;
  }
  .hs-wordmark img {
    width: min(92vw, 820px);
    height: auto;
  }
  .hs-line {
    margin: clamp(1.25rem, 3vw, 2rem) 0 0;
    max-width: 40ch;
    font: 500 clamp(1rem, 1.6vw, 1.35rem) / 1.6 var(--font-body);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(245, 245, 245, 0.8);
  }
  .hs-cta {
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
  }
</style>
