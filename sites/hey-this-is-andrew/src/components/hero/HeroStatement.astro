---
/**
 * The statement hero (concept B, the homepage hero since 2026-09-30): one
 * bold frame. The wordmark, one line, one call to action, and the cinematic
 * portrait. The brands follow as their own section.
 *
 * `peek` (concept D, /preview/hero-d/) shortens the frame so the brands
 * section below shows inside the first viewport, the way HQ's hero keeps
 * its panels on screen. `line` swaps the one line (D uses a line that does
 * not repeat the Meet the Creator headline).
 *
 * The portrait renders at full strength: no wash over the photo and no
 * filter on it (Andrew's call, 2026-10-01: the dimmed version looked faded).
 * The only shading is a soft gradient behind the text block itself.
 * The wordmark is Andrew's own logo file (hey-thisisandrew.png, restored
 * from b9cc358), shown as-is: resized for the screen, never redrawn.
 *
 * Carousel (2026-11-19): the portrait frame above is the first slide, then
 * up to five of the latest posts from getNetworkFeed (the /latest/ feed,
 * newest first, the ones with an image), each linking where its /latest/
 * row links. The transport is the shared SpotlightBar's: slow progress bar,
 * play/pause, prev/next, the gear spotlight's pace, and a meta line naming
 * the current slide. Hover holds it only over the copy, the post text and
 * the controls (the frame fills the screen, so it is always under the
 * pointer); focus inside holds it anywhere.
 */
import { Image } from 'astro:assets';
import portrait from '../../assets/hero-media/portrait.jpg';
import { PERSONAL_BRAND } from '../../data/brand';
import { WORK_WITH_ME_HREF } from '../../data/nav';
import SpotlightBar, { type SpotlightSlide } from '@andrew/ui/SpotlightBar.astro';
import { getImage } from 'astro:assets';
import { getNetworkFeed, NETWORK_BRANDS, NETWORK_KIND_LABELS, type NetworkBrandId } from '../../lib/network';
import beLogo from '../../assets/brand-logos/be-logo.png';
import cccLogo from '../../assets/brand-logos/ccc-logo.png';
const wordmark = PERSONAL_BRAND.logo;

/* Each post slide shows its brand's own logo (the files the brands section
   uses) where the headline was, and the brands section's metadata chips
   upper left: whose, with its accent tick, then what. Andrew's own posts
   and his Substack writing (The Build) carry the personal wordmark. */
const BRAND_LOGO: Record<NetworkBrandId, ImageMetadata> = {
  htia: PERSONAL_BRAND.logo,
  build: PERSONAL_BRAND.logo,
  be: beLogo,
  ccc: cccLogo,
};
/* The accordion's brand ticks (theme.css): BE red, CCC gold, white. */
const BRAND_ACCENT: Partial<Record<NetworkBrandId, string>> = {
  be: 'var(--be-red, #e60000)',
  ccc: 'var(--ccc-gold, #c9a96e)',
};
const logoUrls = Object.fromEntries(
  await Promise.all(
    (Object.keys(BRAND_LOGO) as NetworkBrandId[]).map(async (id) => {
      const img = await getImage({ src: BRAND_LOGO[id], width: 840, format: 'png' });
      return [id, { src: img.src, width: Number(img.attributes.width) || undefined, height: Number(img.attributes.height) || undefined }];
    })
  )
) as Record<NetworkBrandId, { src: string; width?: number; height?: number }>;

const MAX_POSTS = 5;
const feed = await getNetworkFeed(30).catch(() => []);
const posts: SpotlightSlide[] = feed
  .filter((item) => Boolean(item.image))
  .slice(0, MAX_POSTS)
  .map((item) => ({
    chips: [
      { label: NETWORK_BRANDS[item.brand], accent: BRAND_ACCENT[item.brand] },
      { label: NETWORK_KIND_LABELS[item.kind] },
    ],
    logoSrc: logoUrls[item.brand].src,
    logoWidth: logoUrls[item.brand].width,
    logoHeight: logoUrls[item.brand].height,
    title: item.title,
    href: item.url,
    external: item.external,
    imageSrc: item.image ?? undefined,
    imageAlt: item.title,
    backdrop: true,
    meta: `${item.title} · ${NETWORK_BRANDS[item.brand]}`,
  }));

interface Props {
  peek?: boolean;
  line?: string;
}
const {
  peek = false,
  line = 'Creator, Photographer, Coffee Drinker. Building in Public.',
} = Astro.props;
---
<section id="overview" class:list={['hero-statement', { 'is-peek': peek }]} aria-labelledby="hero-statement-title">
  <SpotlightBar
    slides={posts}
    label="Hey, This Is Andrew and the latest posts"
    holdSeconds={7}
    height="auto"
    fullBleed
    overlayControls
    showMeta
    leadMeta={line}
    holdSelector=".hs-copy, .ui-spotlight-body, .ui-spotlight-cta, .ui-spotlight-controls"
    class="hs-carousel"
  >
    <div slot="lead" class="hs-lead">
      <div class="hs-media" aria-hidden="true">
        <Image src={portrait} alt="" widths={[960, 1440, 1920, 2560]} sizes="100vw" format="webp" loading="eager" fetchpriority="high" />
      </div>
      <div class="container hs-content">
        <div class="hs-copy">
          <h2 id="hero-statement-title" class="hs-wordmark" data-pn-top data-pn-label="Overview">
            <Image src={wordmark} alt={PERSONAL_BRAND.name} widths={[240, 360, 540, 720]} sizes="min(46vw, 360px)" format="png" loading="eager" />
          </h2>
          <p class="hs-line">{line}</p>
          <div class="btn-group hs-cta">
            <a class="btn btn-primary" href="#directory">Brands <span aria-hidden="true">↓</span></a>
            <a class="btn btn-secondary" href={WORK_WITH_ME_HREF}>Work With Me</a>
          </div>
        </div>
      </div>
    </div>
  </SpotlightBar>
</section>

<style>
  .hero-statement {
    --hs-min: calc(100svh - var(--nav-h));
    /* Room under the copy for the carousel controls laid over the frame. */
    --hs-pad: max(clamp(3rem, 8vh, 6rem), 5.5rem);
    position: relative;
    min-height: var(--hs-min);
    display: flex;
    flex-direction: column;
    padding: 0;
    overflow: hidden;
    background: #000;
  }
  /* The carousel fills the frame; its slides stack in one grid cell, so
     the frame is as tall as the hero (or its copy, on a short screen). */
  .hero-statement :global(.hs-carousel) {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
  }
  .hero-statement :global(.hs-carousel .ui-spotlight-frame) {
    flex: 1 1 auto;
    display: grid;
    height: auto;
    min-height: var(--hs-min);
    border: 0;
    background: #000;
  }
  .hero-statement :global(.hs-carousel .ui-spotlight-slide) {
    position: relative;
    inset: auto;
    grid-area: 1 / 1;
    min-width: 0;
  }
  .hero-statement :global(.hs-carousel .ui-spotlight-inner) {
    width: min(100% - clamp(2rem, 4vw, 5rem), var(--maxw, 1536px));
    padding-bottom: var(--hs-pad);
    align-items: flex-end;
    /* Static, so the metadata chips position against the slide itself. */
    position: static;
  }
  /* The metadata chips line up with the header's logo: the same left
     inset as the nav row (Nav.astro .nav-inner), not the content column,
     which sits further in on a wide screen. */
  .hero-statement :global(.hs-carousel.ui-spotlight--bleed .ui-spotlight-meta-block) {
    left: clamp(1.5rem, 3.5vw, 4rem);
    right: clamp(1.5rem, 3.5vw, 4rem);
  }
  /* With the inner layer static, the logo and the arrow keep their own
     layer above the scrim. */
  .hero-statement :global(.hs-carousel .ui-spotlight-body),
  .hero-statement :global(.hs-carousel .ui-spotlight-cta) {
    position: relative;
    z-index: 2;
  }
  @media (max-width: 599px) {
    .hero-statement {
      --hs-pad: 6.25rem;
    }
    /* The progress bar gets its own full-width row above the buttons and
       the meta line, instead of being squeezed beside them. */
    .hero-statement :global(.hs-carousel .ui-spotlight-controls) {
      flex-wrap: wrap;
      row-gap: 0.6rem;
    }
    .hero-statement :global(.hs-carousel .ui-spotlight-track-end) {
      order: -1;
      flex: 1 0 100%;
    }
    .hero-statement :global(.hs-carousel .ui-spotlight-meta) {
      flex: 1 1 0;
    }
  }
  /* Portrait screens: the post image sits whole over its blurred copy
     rather than being cropped to a sliver of a 16:9 frame. */
  @media (max-aspect-ratio: 1 / 1) {
    .hero-statement :global(.hs-carousel .ui-spotlight-bg) {
      object-fit: contain;
      object-position: center 38%;
    }
  }
  @media (min-aspect-ratio: 1 / 1) {
    .hero-statement :global(.hs-carousel .ui-spotlight-backdrop) {
      display: none;
    }
  }
  .hs-lead {
    position: relative;
    width: 100%;
    min-height: var(--hs-min);
    display: flex;
    align-items: flex-end;
    padding: 0 0 var(--hs-pad);
    box-sizing: border-box;
  }
  /* D: leave room under the frame for the brands heading and the top of
     the accordion. The frame never drops below what its content needs. */
  .hero-statement.is-peek {
    --peek: clamp(15rem, 34svh, 22rem);
    --hs-min: max(22rem, calc(100svh - var(--nav-h) - var(--peek)));
    --hs-pad: max(clamp(2rem, 5vh, 3.5rem), 5.5rem);
  }
  .hs-media {
    position: absolute;
    inset: 0;
  }
  .hs-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% 25%;
  }
  .hs-content {
    position: relative;
    z-index: 1;
  }
  /* Readability help for the copy only: a soft dark falloff sized to the
     text block, never a wash over the photo. */
  .hs-copy {
    position: relative;
    width: fit-content;
    max-width: 100%;
  }
  .hs-copy::before {
    content: '';
    position: absolute;
    inset: -3rem -4rem -2.5rem -6rem;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(closest-side, rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.28) 55%, transparent);
  }
  .hs-wordmark {
    margin: 0;
  }
  /* A logo mark with the line and the buttons, not the whole frame:
     under half its old width (it was min(92vw, 820px)). */
  .hs-wordmark :global(img) {
    display: block;
    width: min(46vw, 360px);
    height: auto;
  }
  .hs-line {
    margin: clamp(1.25rem, 3vw, 2rem) 0 0;
    max-width: 40ch;
    font: 500 clamp(1rem, 1.6vw, 1.35rem) / 1.6 var(--font-body);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(245, 245, 245, 0.8);
  }
  .is-peek .hs-line {
    text-wrap: balance;
  }
  .hs-cta {
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
  }
  @media (min-width: 601px) {
    :global(#site) .hs-cta.btn-group {
      margin-inline: 0;
      justify-content: flex-start;
    }
  }
  /* The added CTA sits on the existing dark portrait in either theme. */
  .hs-cta > .btn-secondary {
    --ink: #f5f5f5;
    --muted: #aaa;
    --color-black: #080808;
  }

  /* Mobile landscape: keep the hero wordmark and copy compact on the left
     so it does not stretch across or overlap Andrew's face on short screens. */
  @media (orientation: landscape) and (max-height: 520px), (max-width: 920px) and (orientation: landscape) and (max-height: 600px) {
    .hero-statement {
      --hs-pad: 4.25rem;
    }
    .hs-copy {
      max-width: 52%;
    }
    .hs-copy::before {
      inset: -1.25rem -2rem -1rem -3rem;
    }
    .hs-wordmark :global(img) {
      width: clamp(120px, 22vw, 180px);
    }
    .hs-line {
      margin-top: 0.5rem;
      font-size: 0.82rem;
      line-height: 1.35;
      max-width: 32ch;
    }
    .hs-cta {
      margin-top: 0.75rem;
      padding: 0.45rem 1.1rem;
      font-size: 0.8rem;
    }
  }
</style>
