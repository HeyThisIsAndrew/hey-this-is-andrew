---
/**
 * The statement hero (concept B, the homepage hero since 2026-09-30): one
 * bold frame. The wordmark, one line, one call to action, and the cinematic
 * portrait. The brands follow as their own section.
 *
 * `peek` (concept D, /preview/hero-d/) shortens the frame so the brands
 * section below shows inside the first viewport, the way HQ's hero keeps
 * its panels on screen. `line` swaps the one line (D uses a line that does
 * not repeat the Meet the Creator headline).
 *
 * The portrait renders at full strength: no wash over the photo and no
 * filter on it (Andrew's call, 2026-10-01: the dimmed version looked faded).
 * The only shading is a soft gradient behind the text block itself.
 * The wordmark is Andrew's own logo file (hey-thisisandrew.png, restored
 * from b9cc358), shown as-is: resized for the screen, never redrawn.
 */
import { Image } from 'astro:assets';
import portrait from '../../assets/hero-media/portrait.jpg';
import wordmark from '../../assets/brand-logos/hey-thisisandrew.png';

interface Props {
  peek?: boolean;
  line?: string;
}
const {
  peek = false,
  line = 'Documenting the messy middle of building three brands, commercial photography, and creator automation.',
} = Astro.props;
---
<section id="overview" class:list={['hero-statement', { 'is-peek': peek }]} aria-labelledby="hero-statement-title">
  <div class="hs-media" aria-hidden="true">
    <Image src={portrait} alt="" widths={[960, 1440, 1920, 2560]} sizes="100vw" format="webp" loading="eager" fetchpriority="high" />
  </div>
  <div class="container hs-content">
    <div class="hs-copy">
      <h2 id="hero-statement-title" class="hs-wordmark">
        <Image src={wordmark} alt="HEY_THISISANDREW" widths={[420, 640, 820, 1049]} sizes="min(92vw, 820px)" format="png" loading="eager" />
      </h2>
      <p class="hs-line">{line}</p>
      <a class="btn btn-primary hs-cta" href="#directory">See the brands <span aria-hidden="true">↓</span></a>
    </div>
  </div>
</section>

<style>
  .hero-statement {
    position: relative;
    min-height: calc(100svh - var(--nav-h));
    display: flex;
    align-items: flex-end;
    padding: 0 0 clamp(3rem, 8vh, 6rem);
    overflow: hidden;
    background: #000;
  }
  /* D: leave room under the frame for the brands heading and the top of
     the accordion. The frame never drops below what its content needs. */
  .hero-statement.is-peek {
    --peek: clamp(15rem, 34svh, 22rem);
    min-height: max(22rem, calc(100svh - var(--nav-h) - var(--peek)));
    padding-bottom: clamp(2rem, 5vh, 3.5rem);
  }
  .hs-media {
    position: absolute;
    inset: 0;
  }
  .hs-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% 25%;
  }
  .hs-content {
    position: relative;
    z-index: 1;
  }
  /* Readability help for the copy only: a soft dark falloff sized to the
     text block, never a wash over the photo. */
  .hs-copy {
    position: relative;
    width: fit-content;
    max-width: 100%;
  }
  .hs-copy::before {
    content: '';
    position: absolute;
    inset: -3rem -4rem -2.5rem -6rem;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(closest-side, rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.28) 55%, transparent);
  }
  .hs-wordmark {
    margin: 0;
  }
  .hs-wordmark :global(img) {
    display: block;
    width: min(92vw, 820px);
    height: auto;
  }
  .hs-line {
    margin: clamp(1.25rem, 3vw, 2rem) 0 0;
    max-width: 40ch;
    font: 500 clamp(1rem, 1.6vw, 1.35rem) / 1.6 var(--font-body);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(245, 245, 245, 0.8);
  }
  .is-peek .hs-line {
    text-wrap: balance;
  }
  .hs-cta {
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
  }
</style>
