{
  "dependencies": {
    "@andrew/content-pipeline": "workspace:*",
    "@andrew/tokens": "workspace:*",
    "@andrew/ui": "workspace:*",
    "@astrojs/cloudflare": "14.3.4",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.1",
    "fuse.js": "^7.5.0",
    "sharp": "^0.34.5"
  },
  "name": "hey-this-is-andrew",
  "private": true,
  "cloudflare": {
    "worker": "hey-this-is-andrew",
    "secrets": [
      "RESEND_API_KEY",
      "RESEND_FROM_EMAIL"
    ],
    "routes": [
      "/",
      "/about/",
      "/gear/",
      "/ccc/",
      "/brands/",
      "/writing/",
      "/api/contact",
      "/robots.txt"
    ]
  },
  "scripts": {
    "build": "astro build",
    "build:cloudflare": "node ../../scripts/cloudflare.mjs build hey-this-is-andrew",
    "deploy": "node ../../scripts/cloudflare.mjs deploy hey-this-is-andrew",
    "start": "astro preview --host 0.0.0.0 --port ${PORT:-3000} --ignore-lock",
    "dev": "astro dev --host 0.0.0.0 --port 3000",
    "preview": "astro preview --host 0.0.0.0 --port 3000",
    "check": "astro check",
    "refresh:token": "node scripts/refresh-instagram-token.mjs",
    "lint": "node -e \"process.exit(0)\"",
    "sync:articles": "sync-substack --pub https://thisiscoffeetalk.substack.com --out src/data/articles.json --timezone America/Los_Angeles",
    "sync:article-images": "sync-article-images --articles src/data/articles.json --manifest src/data/article-images.json --media-dir public/article-images --public-path /article-images",
    "sync:instagram": "node scripts/sync-instagram.mjs",
    "build:marks": "node scripts/build-brand-marks.mjs",
    "test": "node scripts/feed-text.test.mjs && node scripts/status-bar.test.mjs && node scripts/controls.test.mjs && node scripts/hq-latest.test.mjs",
    "test:dist": "node scripts/audit-dist.mjs"
  },
  "type": "module",
  "version": "0.1.0",
  "devDependencies": {
    "@andrew/local-cms": "workspace:*",
    "@astrojs/check": "^0.9.10",
    "@fontsource/syne": "^5.3.0",
    "opentype.js": "^1.3.4",
    "typescript": "^5.6.3"
  }
}
