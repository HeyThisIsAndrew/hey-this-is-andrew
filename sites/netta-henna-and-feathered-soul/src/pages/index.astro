---
/**
 * index.astro
 * Netta Henna and Feathered Soul - Landing Page
 * 
 * Ornate Boho Luxury Design honoring Netta's flyer + functional mobile-first UX:
 * - Hero in CCC rhythm: Centered Logo Emblem (not clickable) -> her title "Henna Tattoo Artist" -> Two Equal Buttons
 * - Three large circular gold-ringed service medallions on parchment with overlapping cursive ribbon banners & Netta's exact copy
 * - Ornate Price List section with horizontal gold scrollwork, turquoise cabochon gems, soft teal watercolor category banners, and selectable pricing pills
 * - Single upside-down pyramid gallery on homepage with category lightbox modal (Henna Art, Hair Feather Extensions, Hair Tinsel Extensions)
 * - Self-drawing henna mandala flourish
 * - Every content section element centered; zero em dashes across all copy
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import FeatherParallax from '../components/FeatherParallax.astro';
import PriceList from '../components/PriceList.astro';
import BookingSection from '../components/BookingSection.astro';
import HennaDraw from '../components/HennaDraw.astro';
import { SITE } from '../data/site';

// Real photo assets (10 re-cropped photos across 3 categories)
import henna1Img from '../assets/henna-art-1.jpg'; // LV monogram hand
import henna2Img from '../assets/henna-art-2.jpg'; // mandala hand
import henna3Img from '../assets/henna-art-3.jpg'; // lotus hand
import henna4Img from '../assets/henna-art-4.jpg'; // full stained hand

import feathers1Img from '../assets/hair-feathers-1.jpg'; // grizzly feather selfie
import feathers2Img from '../assets/hair-feathers-2.jpg'; // red top car selfie (cropped to face & feathers)
import feathers3Img from '../assets/hair-feathers-3.jpg'; // turquoise feather close-up

import tinsel1Img from '../assets/hair-tinsel-1.jpg'; // copper tinsel profile
import tinsel2Img from '../assets/hair-tinsel-2.jpg'; // iridescent tinsel profile
import tinsel3Img from '../assets/hair-tinsel-3.jpg'; // copper tinsel selfie (cropped to hair & tinsel)

import logoImg from '../assets/netta-logo.png';
import { getImage } from 'astro:assets';
import HennaSideBorders from '../components/HennaSideBorders.astro';
import HennaBorderDraw from '../components/HennaBorderDraw.astro';
import HennaHeroFrame from '../components/HennaHeroFrame.astro';

// Pass 32: the 680px PNG logo (781 KB) was the largest paint on mobile. The hero
// shows it at 230 to 320px, so serve WebP at 1x and 2x of that instead.
const heroLogo = await getImage({ src: logoImg, format: 'webp', quality: 86, widths: [320, 480, 680] });
const heroSizes = '(min-width: 3840px) 450px, (min-width: 2560px) 380px, (max-width: 958px) 240px, 320px';
const photoSources = { henna1Img, henna2Img, henna3Img, henna4Img, feathers1Img, feathers2Img, feathers3Img, tinsel1Img, tinsel2Img, tinsel3Img };
const photos = Object.fromEntries(
  await Promise.all(
    Object.entries(photoSources).map(async ([key, src]) => [
      key,
      await getImage({ src, format: 'webp', quality: 86, width: Math.min(src.width, 760) }),
    ])
  )
);
const fullPhotos = Object.fromEntries(
  await Promise.all(
    Object.entries(photoSources).map(async ([key, src]) => [
      key,
      await getImage({ src, format: 'webp', quality: 88, width: Math.min(src.width, 1280) }),
    ])
  )
);

const galleryCategories = {
  henna: {
    title: 'Henna Art',
    items: [
      { src: fullPhotos.henna1Img.src, width: henna1Img.width, height: henna1Img.height, alt: 'LV monogram custom henna design' },
      { src: fullPhotos.henna2Img.src, width: henna2Img.width, height: henna2Img.height, alt: 'Mandala hand henna design' },
      { src: fullPhotos.henna3Img.src, width: henna3Img.width, height: henna3Img.height, alt: 'Lotus hand henna design' },
      { src: fullPhotos.henna4Img.src, width: henna4Img.width, height: henna4Img.height, alt: 'Full stained henna hand' },
    ],
  },
  feathers: {
    title: 'Hair Feather Extensions',
    items: [
      { src: fullPhotos.feathers1Img.src, width: feathers1Img.width, height: feathers1Img.height, alt: 'Grizzly hair feather extensions selfie' },
      { src: fullPhotos.feathers2Img.src, width: feathers2Img.width, height: feathers2Img.height, alt: 'Netta styled with natural hair feather extensions' },
      { src: fullPhotos.feathers3Img.src, width: feathers3Img.width, height: feathers3Img.height, alt: 'Turquoise hair feather extensions in braid' },
    ],
  },
  tinsel: {
    title: 'Hair Tinsel Extensions',
    items: [
      { src: fullPhotos.tinsel1Img.src, width: tinsel1Img.width, height: tinsel1Img.height, alt: 'Copper hair tinsel curls profile' },
      { src: fullPhotos.tinsel2Img.src, width: tinsel2Img.width, height: tinsel2Img.height, alt: 'Iridescent hair tinsel profile' },
      { src: fullPhotos.tinsel3Img.src, width: tinsel3Img.width, height: tinsel3Img.height, alt: 'Copper hair tinsel strands shimmering in dark wavy hair' },
    ],
  },
};

// Original lightweight vines connect the three photo rings through the gaps.
const pyramidPaths = [
  'M337 173 C350 150 366 150 379 173',
  'M260 308 C310 347 273 369 245 438',
  'M456 308 C406 347 443 369 471 438',
  'M295 343 C319 362 338 366 358 351 C378 366 397 362 421 343',
  'M358 351 C346 334 348 322 358 312 C368 322 370 334 358 351 Z',
  'M355 350 C334 346 330 330 333 320 C347 326 354 336 355 350 Z',
  'M361 350 C382 346 386 330 383 320 C369 326 362 336 361 350 Z',
  'M285 361 C257 342 250 365 263 373 C275 380 287 371 285 361 Z',
  'M431 361 C459 342 466 365 453 373 C441 380 429 371 431 361 Z',
  'M252 404 Q221 384 230 372 Q249 376 252 404 Z',
  'M464 404 Q495 384 486 372 Q467 376 464 404 Z',
];
const pyramidDots = [[358, 299], [347, 157], [369, 157], [291, 382], [425, 382], [240, 365], [476, 365]];
---

<BaseLayout title={`${SITE.name} · Santa Barbara, CA`} heroPreload={{ src: heroLogo.src, srcset: heroLogo.srcSet.attribute, sizes: heroSizes }}>
  <HennaSideBorders />
  <FeatherParallax />

  <!-- 1. Hero Section (CCC Order: Logo Emblem, Headline, One Descriptor Line, Two Equal Buttons) -->
  <header class="hero-section" id="overview">
    <div class="container hero-container">
      <!-- 1. Centered Circular Logo Emblem. Not a link or button: Netta asked that
           tapping her logo does nothing (it used to jump to the Price List). -->
      <div class="hero-logo-static">
        <HennaHeroFrame />
        <div class="hero-logo-frame">
          <img
            src={heroLogo.src}
            srcset={heroLogo.srcSet.attribute}
            sizes={heroSizes}
            width={logoImg.width}
            height={logoImg.height}
            alt="Netta Henna and Feathered Soul Emblem"
            class="hero-logo-img"
            fetchpriority="high"
            decoding="async"
          />
        </div>
      </div>

      <!-- 2. One Headline: Netta Henna and Feathered Soul (Visually hidden for screen readers/SEO) -->
      <h1 class="sr-only">Netta Henna and Feathered Soul</h1>

      <!-- 3. Her title, in Netta's own words (Nov 16, 2026), in the gold italic serif line -->
      <p class="hero-descriptor-line">
        <span class="hero-title">Henna Tattoo Artist</span>
      </p>

      <!-- 4. Two Equal Buttons: Identical width, height, and shape -->
      <div class="hero-actions-row">
        <a
          href={SITE.instagramUrl}
          target="_blank"
          rel="noopener"
          class="hero-btn brush-ribbon-btn hero-brush-btn"
          title="Direct Message Netta on Instagram"
        >
          DM TO BOOK
        </a>
        <button
          type="button"
          class="hero-btn brush-ribbon-btn hero-brush-btn"
          data-action="book-date"
          aria-label="Book an appointment with Netta"
        >
          BOOK A DATE
        </button>
      </div>
    </div>
  </header>

  <!-- 2. Services Section (Three Large Circular Gold-Ringed Medallions with Overlapping Parchment Banner) -->
  <section id="services" aria-label="Services" class="services-section">
    <div class="container">
      <div class="services-cards-grid">
        <!-- Service 1: Henna Art (henna-art-3.jpg lotus hand) -->
        <article class="service-medallion-item" id="service-henna">
          <div class="medallion-visual">
            <div class="gold-ring-frame medallion-circle">
              <img src={photos.henna3Img.src} width={henna3Img.width} height={henna3Img.height} decoding="async" alt="Natural Henna Art lotus design" loading="lazy" />
            </div>
            <div class="medallion-ribbon">
              <h3 class="service-name gold-script-text">Henna Art</h3>
            </div>
          </div>
          <button type="button" class="btn btn-primary brush-ribbon-btn" data-service-cta="Henna Art">
            Book Henna Art
          </button>
        </article>

        <!-- Service 2: Hair Feathers (hair-feathers-2.jpg cropped to face & feathers) -->
        <article class="service-medallion-item" id="service-feathers">
          <div class="medallion-visual">
            <div class="gold-ring-frame medallion-circle">
              <img src={photos.feathers2Img.src} width={feathers2Img.width} height={feathers2Img.height} decoding="async" alt="Netta styling real hair feather extensions" loading="lazy" />
            </div>
            <div class="medallion-ribbon">
              <h3 class="service-name gold-script-text">Hair Feathers</h3>
            </div>
          </div>
          <button type="button" class="btn btn-primary brush-ribbon-btn" data-service-cta="Hair Feather Extensions">
            Book Hair Feathers
          </button>
        </article>

        <!-- Service 3: Hair Tinsel (hair-tinsel-1.jpg copper tinsel profile) -->
        <article class="service-medallion-item" id="service-tinsel">
          <div class="medallion-visual">
            <div class="gold-ring-frame medallion-circle">
              <img src={photos.tinsel1Img.src} width={tinsel1Img.width} height={tinsel1Img.height} decoding="async" alt="Sparkling Hair Tinsel Extensions" loading="lazy" />
            </div>
            <div class="medallion-ribbon">
              <h3 class="service-name gold-script-text">Hair Tinsel</h3>
            </div>
          </div>
          <button type="button" class="btn btn-primary brush-ribbon-btn" data-service-cta="Hair Tinsel Extensions">
            Book Hair Tinsel
          </button>
        </article>
      </div>
    </div>
  </section>

  <!-- Self-Drawing Henna Mandala Flourish -->
  <HennaDraw />

  <!-- 3. Price List Section (Real exact prices in ornate gold & turquoise gem frame) -->
  <PriceList />

  <!-- 4. Gallery Section (Single Upside-Down Pyramid with Category Lightbox Views) -->
  <section id="gallery" aria-labelledby="gallery-heading" class="gallery-section">
    <div class="container">
      <div class="section-title-wrap text-center">
        <!-- Job 6: Full Henna Art Divider before Gallery (Draws around the Teal Diamond, no inner fade) -->
        <div class="section-ornament gallery-henna-divider" data-henna-box-draw aria-hidden="true">
          <div class="g-divider-wing g-divider-wing-left"><HennaBorderDraw side="left" /></div>
          <span class="ornament-gem"><span class="teal-diamond">◆</span></span>
          <div class="g-divider-wing g-divider-wing-right"><HennaBorderDraw side="left" /></div>
        </div>
        <h2 id="gallery-heading" class="sec-title gold-script-text">Gallery</h2>
      </div>

      <!-- Single Homepage Pyramid: 2 circles on top (Henna Art, Hair Feathers), 1 centered below (Hair Tinsel) -->
      <div class="gallery-cat-group gallery-single-pyramid-wrap">
        <div class="gallery-photo-grid three-col" id="homepage-gallery-pyramid" data-pyramid-art>
          <!-- Top Left Circle: Henna Art (henna-art-3.jpg per Andrew) -->
          <button
            type="button"
            class="gallery-item gallery-pyramid-trigger"
            data-gallery-category="henna"
            aria-label="Open Henna Art gallery (4 photos)"
          >
            <div class="gallery-img-wrap">
              <img
                src={photos.henna3Img.src}
                width={henna3Img.width}
                height={henna3Img.height}
                decoding="async"
                alt="Lotus hand henna design"
                loading="lazy"
              />
            </div>
            <span class="gallery-circle-label">Henna Art</span>
          </button>

          <!-- Top Right Circle: Hair Feathers (hair-feathers-2.jpg per Andrew) -->
          <button
            type="button"
            class="gallery-item gallery-pyramid-trigger"
            data-gallery-category="feathers"
            aria-label="Open Hair Feather Extensions gallery (3 photos)"
          >
            <div class="gallery-img-wrap">
              <img
                src={photos.feathers2Img.src}
                width={feathers2Img.width}
                height={feathers2Img.height}
                decoding="async"
                alt="Netta styled with natural hair feather extensions"
                loading="lazy"
              />
            </div>
            <span class="gallery-circle-label">Hair Feathers</span>
          </button>

          <!-- Bottom Centered Circle: Hair Tinsel (hair-tinsel-1.jpg per Andrew) -->
          <button
            type="button"
            class="gallery-item gallery-pyramid-trigger"
            data-gallery-category="tinsel"
            aria-label="Open Hair Tinsel Extensions gallery (3 photos)"
          >
            <div class="gallery-img-wrap">
              <img
                src={photos.tinsel1Img.src}
                width={tinsel1Img.width}
                height={tinsel1Img.height}
                decoding="async"
                alt="Copper hair tinsel curls profile"
                loading="lazy"
              />
            </div>
            <span class="gallery-circle-label">Hair Tinsel</span>
          </button>

          <svg class="pyramid-henna" viewBox="0 0 716 722" preserveAspectRatio="none" aria-hidden="true" focusable="false" fill="none">
            {pyramidPaths.map((d) => (
              <path class="henna-path" d={d} pathLength="200" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke" />
            ))}
            {pyramidDots.map(([cx, cy]) => (
              <circle class="henna-dot" cx={cx} cy={cy} r="3" fill="var(--brand-teal)" />
            ))}
          </svg>
        </div>
      </div>
    </div>

    <!-- Category Lightbox Overlay (Opens full-size rectangular images for the selected category only) -->
    <div
      id="category-gallery-modal"
      class="cat-gallery-modal"
      role="dialog"
      aria-modal="true"
      aria-labelledby="cat-gallery-heading"
      hidden
      data-gallery-payload={JSON.stringify(galleryCategories)}
    >
      <div class="cat-gallery-henna-frame" id="cat-gallery-henna-frame" aria-hidden="true">
        <div class="cat-gallery-henna-side cat-gallery-henna-left">
          <HennaBorderDraw side="left" />
        </div>
        <div class="cat-gallery-henna-side cat-gallery-henna-right">
          <HennaBorderDraw side="right" />
        </div>
      </div>

      <header class="cat-gallery-header">
        <p id="cat-gallery-heading" class="cat-gallery-label" aria-live="polite">Henna Art, 1 of 4</p>
        <button
          type="button"
          id="cat-gallery-close"
          class="cat-gallery-close-btn"
          aria-label="Close category gallery"
        >
          &times;
        </button>
      </header>

      <div class="cat-gallery-stage" id="cat-gallery-stage">
        <button
          type="button"
          id="cat-gallery-prev"
          class="cat-gallery-nav-btn cat-gallery-prev"
          aria-label="Previous image"
        >
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M15 18l-6-6 6-6"></path>
          </svg>
        </button>

        <div class="cat-gallery-img-holder" id="cat-gallery-img-holder">
          <img
            id="cat-gallery-img"
            class="cat-gallery-full-img"
            src={fullPhotos.henna1Img.src}
            alt="LV monogram custom henna design"
            decoding="async"
          />
        </div>

        <button
          type="button"
          id="cat-gallery-next"
          class="cat-gallery-nav-btn cat-gallery-next"
          aria-label="Next image"
        >
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9 18l6-6-6-6"></path>
          </svg>
        </button>
      </div>
    </div>
  </section>

  <!-- 5. Book an Appointment Section -->
  <section id="booking" aria-labelledby="booking-heading" class="booking-section">
    <div class="container">
      <BookingSection />
    </div>
  </section>
</BaseLayout>

<script>
  // The shared spy covers main sections only. Netta's Home is a header and
  // Contact is the footer, so finish each landing with the matching link active.
  function syncNettaLanding() {
    const links = [...document.querySelectorAll<HTMLAnchorElement>('.site-nav [data-nav-link], .site-nav .mobile-nav-list a')];
    const navBottom = document.querySelector('.site-nav')?.getBoundingClientRect().bottom ?? 0;
    const ids = ['overview', 'services', 'price-list', 'gallery', 'booking', 'site-footer'];
    let active = 'overview';
    for (const id of ids) {
      const target = document.getElementById(id);
      if (target && target.getBoundingClientRect().top <= navBottom + 28) active = id;
    }
    for (const link of links) {
      const matches = new URL(link.href).hash === `#${active}`;
      link.classList.toggle('active', matches);
      if (matches) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    }
  }
  let landingTimer: number;
  window.addEventListener('scroll', () => {
    window.clearTimeout(landingTimer);
    landingTimer = window.setTimeout(syncNettaLanding, 60);
  }, { passive: true });
  window.addEventListener('scrollend', syncNettaLanding);
  window.addEventListener('resize', syncNettaLanding, { passive: true });
  syncNettaLanding();

  function initializePyramidArt() {
    const groups = document.querySelectorAll<HTMLElement>('[data-pyramid-art]:not([data-art-ready])');
    if (!groups.length) return;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      groups.forEach((group) => {
        group.dataset.artReady = 'true';
        group.classList.add('is-drawn');
      });
      return;
    }
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-drawn');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.2 }
    );
    groups.forEach((group) => {
      group.dataset.artReady = 'true';
      group.classList.add('pyramid-pending');
      observer.observe(group);
    });
    document.addEventListener('astro:before-swap', () => observer.disconnect(), { once: true });
  }

  function initCategoryGallery() {
    const modal = document.getElementById('category-gallery-modal') as HTMLElement | null;
    if (!modal || modal.dataset.galleryWired === 'true') return;
    modal.dataset.galleryWired = 'true';

    const payloadRaw = modal.getAttribute('data-gallery-payload');
    if (!payloadRaw) return;
    const categories = JSON.parse(payloadRaw) as Record<
      string,
      { title: string; items: Array<{ src: string; width: number; height: number; alt: string }> }
    >;

    const headingEl = document.getElementById('cat-gallery-heading');
    const closeBtn = document.getElementById('cat-gallery-close');
    const prevBtn = document.getElementById('cat-gallery-prev') as HTMLButtonElement | null;
    const nextBtn = document.getElementById('cat-gallery-next') as HTMLButtonElement | null;
    const imgEl = document.getElementById('cat-gallery-img') as HTMLImageElement | null;
    const stageEl = document.getElementById('cat-gallery-stage');
    const hennaFrame = document.getElementById('cat-gallery-henna-frame');

    let activeKey = 'henna';
    let activeIndex = 0;
    let isGalleryOpen = false;
    let savedScrollY = 0;
    let closeTimeout: number | null = null;

    const prefersReducedMotion = () =>
      window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function lockGalleryScroll() {
      if (isGalleryOpen) return;
      savedScrollY = window.scrollY || window.pageYOffset || 0;
      isGalleryOpen = true;

      document.documentElement.classList.add('modal-open');
      document.body.classList.add('modal-open');
      document.body.style.position = 'fixed';
      document.body.style.top = `-${savedScrollY}px`;
      document.body.style.left = '0';
      document.body.style.right = '0';
      document.body.style.width = '100%';
      document.body.style.overflow = 'hidden';
    }

    function unlockGalleryScroll() {
      if (!isGalleryOpen) return;
      const restoreY = savedScrollY;
      isGalleryOpen = false;

      const root = document.documentElement;
      const prevBehavior = root.style.scrollBehavior;
      root.style.scrollBehavior = 'auto';

      root.classList.remove('modal-open');
      document.body.classList.remove('modal-open');
      document.body.style.position = '';
      document.body.style.top = '';
      document.body.style.left = '';
      document.body.style.right = '';
      document.body.style.width = '';
      document.body.style.overflow = '';

      window.scrollTo(0, restoreY);
      requestAnimationFrame(() => {
        window.scrollTo(0, restoreY);
        root.style.scrollBehavior = prevBehavior;
      });
    }

    function updateGalleryView() {
      const cat = categories[activeKey];
      if (!cat || !imgEl || !headingEl) return;
      const total = cat.items.length;
      activeIndex = Math.max(0, Math.min(total - 1, activeIndex));
      const item = cat.items[activeIndex];
      imgEl.src = item.src;
      imgEl.alt = item.alt;
      imgEl.width = item.width;
      imgEl.height = item.height;
      headingEl.textContent = `${cat.title}, ${activeIndex + 1} of ${total}`;

      if (prevBtn) {
        prevBtn.disabled = activeIndex <= 0;
        prevBtn.classList.toggle('is-disabled', activeIndex <= 0);
      }
      if (nextBtn) {
        nextBtn.disabled = activeIndex >= total - 1;
        nextBtn.classList.toggle('is-disabled', activeIndex >= total - 1);
      }
    }

    function openCategoryGallery(categoryKey: string) {
      if (!categories[categoryKey] || !modal) return;
      if (closeTimeout !== null) {
        window.clearTimeout(closeTimeout);
        closeTimeout = null;
      }
      activeKey = categoryKey;
      activeIndex = 0;
      updateGalleryView();

      hennaFrame?.classList.remove('is-drawn');
      lockGalleryScroll();
      modal.hidden = false;
      void modal.offsetWidth;
      modal.classList.add('is-open');

      if (prefersReducedMotion()) {
        hennaFrame?.classList.add('is-drawn');
      } else {
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            hennaFrame?.classList.add('is-drawn');
          });
        });
      }
      closeBtn?.focus({ preventScroll: true });
    }

    function closeCategoryGallery() {
      if (!modal || modal.hidden) {
        unlockGalleryScroll();
        return;
      }
      modal.classList.remove('is-open');
      unlockGalleryScroll();

      if (prefersReducedMotion()) {
        modal.hidden = true;
        hennaFrame?.classList.remove('is-drawn');
        return;
      }

      closeTimeout = window.setTimeout(() => {
        closeTimeout = null;
        modal.hidden = true;
        hennaFrame?.classList.remove('is-drawn');
      }, 240);
    }

    function stepImage(delta: number) {
      const cat = categories[activeKey];
      if (!cat) return;
      const nextIdx = activeIndex + delta;
      if (nextIdx >= 0 && nextIdx < cat.items.length) {
        activeIndex = nextIdx;
        updateGalleryView();
      }
    }

    document.querySelectorAll<HTMLElement>('[data-gallery-category]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const cat = btn.getAttribute('data-gallery-category') || 'henna';
        openCategoryGallery(cat);
      });
    });

    closeBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      closeCategoryGallery();
    });

    prevBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      stepImage(-1);
    });

    nextBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      stepImage(1);
    });

    // Backdrop tap to close (clicking outside the image and nav buttons)
    modal.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null;
      if (!target) return;
      if (
        target === modal ||
        target === stageEl ||
        target.classList.contains('cat-gallery-img-holder') ||
        target.classList.contains('cat-gallery-header')
      ) {
        closeCategoryGallery();
      }
    });

    // Keyboard navigation: Left, Right, Escape
    window.addEventListener('keydown', (e) => {
      if (!modal || modal.hidden) return;
      if (e.key === 'Escape') {
        e.preventDefault();
        closeCategoryGallery();
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        stepImage(1);
      } else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        stepImage(-1);
      }
    });

    // Touch and pointer swipe left/right
    let startX = 0;
    let startY = 0;
    let pointerActive = false;

    modal.addEventListener(
      'touchstart',
      (e) => {
        if (e.changedTouches.length > 0) {
          startX = e.changedTouches[0].clientX;
          startY = e.changedTouches[0].clientY;
        }
      },
      { passive: true }
    );

    modal.addEventListener(
      'touchend',
      (e) => {
        if (e.changedTouches.length > 0) {
          const dx = e.changedTouches[0].clientX - startX;
          const dy = e.changedTouches[0].clientY - startY;
          if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) {
            if (dx < 0) stepImage(1);
            else stepImage(-1);
          }
        }
      },
      { passive: true }
    );

    stageEl?.addEventListener('pointerdown', (e) => {
      if ((e.target as HTMLElement)?.closest('button')) return;
      pointerActive = true;
      startX = e.clientX;
      startY = e.clientY;
    });

    stageEl?.addEventListener('pointerup', (e) => {
      if (!pointerActive) return;
      pointerActive = false;
      const dx = e.clientX - startX;
      const dy = e.clientY - startY;
      if (Math.abs(dx) > 45 && Math.abs(dx) > Math.abs(dy)) {
        if (dx < 0) stepImage(1);
        else stepImage(-1);
      }
    });
  }

  initializePyramidArt();
  initCategoryGallery();
  document.addEventListener('astro:page-load', () => {
    initializePyramidArt();
    initCategoryGallery();
  });
</script>

