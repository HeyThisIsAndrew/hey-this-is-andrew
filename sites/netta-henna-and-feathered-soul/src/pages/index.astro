---
/**
 * index.astro
 * Netta Henna and Feathered Soul - Landing Page
 * 
 * Ornate Boho Luxury Re-skin and Restructure:
 * - Reference Section Order: Hero, Services, Price List, Gallery, Book an Appointment, Footer
 * - Big gold script headings ("Netta", "Henna and Feathered Soul")
 * - Crescent moon and feather motifs
 * - Service line: Henna Art · Hair Feathers · Hair Tinsel
 * - "DM to Book" teal brush accent banner
 * - Circular gold-ringed service cards using real photos
 * - Ornate Price List section with exact prices
 * - Real photo gallery (no stock or AI imagery, logo placeholders for coming soon)
 * - Self-drawing henna mandala flourish
 * - Zero em dashes across all copy
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import FeatherParallax from '../components/FeatherParallax.astro';
import PriceList from '../components/PriceList.astro';
import BookingSection from '../components/BookingSection.astro';
import HennaDraw from '../components/HennaDraw.astro';
import { SITE } from '../data/site';

// Real photo assets
import heroFeathersImg from '../assets/netta-hero-feather-extensions.jpg';
import tinsel1Img from '../assets/hair-tinsel-1.jpg';
import tinsel2Img from '../assets/hair-tinsel-2.jpg';
import hennaLotusImg from '../assets/henna-lotus.jpg';
import hennaArt1Img from '../assets/henna-art-1.jpg';
import featherBraidImg from '../assets/feather-braid.jpg';
import logoImg from '../assets/netta-logo.png';
---

<BaseLayout title={`${SITE.name} · Santa Barbara, CA`}>
  <FeatherParallax />

  <!-- 1. Hero Section -->
  <header class="hero-section" id="overview">
    <div class="container hero-container">
      <div class="hero-content">
        <div class="hero-badge-row">
          <span class="location-dot" aria-hidden="true"></span>
          <span class="hero-location">{SITE.location}</span>
          <span class="badge-separator" aria-hidden="true">✦</span>
          <span class="hero-tag">Boho Beauty &amp; Earthy Luxury</span>
        </div>

        <h1 class="hero-title">
          <span class="hero-name gold-script-text">Netta</span>
          <span class="hero-subtitle">Henna and Feathered Soul</span>
        </h1>

        <!-- Crescent Moon & Feather Emblem Accent -->
        <div class="hero-motif" aria-hidden="true">
          <span class="motif-line"></span>
          <span class="motif-symbol">🌙 ✦ 🪶</span>
          <span class="motif-line"></span>
        </div>

        <!-- Service Line -->
        <p class="hero-service-line">
          <strong>Henna Art</strong> · <strong>Hair Feathers</strong> · <strong>Hair Tinsel</strong>
        </p>

        <!-- "DM to Book" Teal Brush Banner -->
        <div class="hero-brush-banner-wrap">
          <a href={SITE.instagramUrl} target="_blank" rel="noopener" class="teal-brush-banner" title="Direct Message Netta on Instagram">
            DM to Book on Instagram
          </a>
        </div>

        <!-- Hero Actions -->
        <div class="hero-actions">
          <button type="button" class="btn btn-primary" data-action="book-date">
            Book a date
          </button>
          <a
            href={SITE.instagramUrl}
            target="_blank"
            rel="noopener"
            class="btn-instagram"
            aria-label="Visit Netta on Instagram"
            title="Instagram @nettahennaandfeatheredsoul"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
            </svg>
          </a>
        </div>
      </div>

      <div class="hero-visual">
        <div class="hero-logo-frame">
          <img
            src={logoImg.src}
            width={logoImg.width}
            height={logoImg.height}
            alt="Netta Henna and Feathered Soul Emblem"
            class="hero-logo-img"
          />
        </div>
      </div>
    </div>
  </header>

  <!-- 2. Services Section (Three Circular Gold-Ringed Cards) -->
  <section id="services" aria-labelledby="services-heading" class="services-section">
    <div class="container">
      <div class="section-title-wrap text-center">
        <p class="sec-kicker">✦ Our Offerings ✦</p>
        <h2 id="services-heading" class="sec-title gold-script-text">What She Does</h2>
        <p class="sec-subtitle">Three signature offerings in Santa Barbara, crafted with intention and organic care.</p>
      </div>

      <div class="services-cards-grid">
        <!-- Service 1: Henna Art -->
        <article class="service-card" id="service-henna">
          <div class="gold-ring-frame">
            <img src={hennaLotusImg.src} alt="Natural Henna Art on hand" loading="lazy" />
          </div>
          <h3 class="service-name gold-script-text">Henna Art</h3>
          <p class="service-tagline">Natural, Organic Adornment</p>
          <p class="service-desc">
            Custom natural henna art hand-drawn in Santa Barbara. From delicate minimal finger accents to elaborate full-hand compositions.
          </p>
          <div class="service-rate-badge">From $20 · Free Glitter Touch</div>
          <button type="button" class="btn btn-primary" data-service-cta="Henna Art">
            Book Henna Art
          </button>
        </article>

        <!-- Service 2: Hair Feathers -->
        <article class="service-card highlight" id="service-feathers">
          <div class="gold-ring-frame">
            <img src={heroFeathersImg.src} alt="Netta styling real hair feather extensions" loading="lazy" />
          </div>
          <h3 class="service-name gold-script-text">Hair Feathers</h3>
          <p class="service-tagline">Cruelty-Free Boho Extensions</p>
          <p class="service-desc">
            Sustainably sourced, premium natural feathers installed gently with silicone-lined micro beads for long-lasting earthy beauty.
          </p>
          <div class="service-rate-badge">$10 to $60 + $10 Install</div>
          <button type="button" class="btn btn-primary" data-service-cta="Hair Feathers">
            Book Hair Feathers
          </button>
        </article>

        <!-- Service 3: Hair Tinsel -->
        <article class="service-card" id="service-tinsel">
          <div class="gold-ring-frame">
            <img src={tinsel1Img.src} alt="Sparkling Hair Tinsel Extensions" loading="lazy" />
          </div>
          <h3 class="service-name gold-script-text">Hair Tinsel</h3>
          <p class="service-tagline">Shimmering Fairy Strands</p>
          <p class="service-desc">
            High-grade, heat-resistant shimmer strands tied gently to hair follicles. Shines in natural sunlight and evening candlelight.
          </p>
          <div class="service-rate-badge">$10 to $30 + $10 Install</div>
          <button type="button" class="btn btn-primary" data-service-cta="Hair Tinsel">
            Book Hair Tinsel
          </button>
        </article>
      </div>
    </div>
  </section>

  <!-- Self-Drawing Henna Mandala Flourish -->
  <HennaDraw />

  <!-- 3. Price List Section (Real exact prices in ornate gold frame) -->
  <PriceList />

  <!-- 4. Gallery Section (Real photos of her work) -->
  <section id="gallery" aria-labelledby="gallery-heading" class="gallery-section">
    <div class="container">
      <div class="section-title-wrap text-center">
        <p class="sec-kicker">✦ Portfolio ✦</p>
        <h2 id="gallery-heading" class="sec-title gold-script-text">Recent Work</h2>
        <p class="sec-subtitle">Real client work in Santa Barbara. Original photos only, no stock or AI imagery.</p>
      </div>

      <div class="gallery-photo-grid">
        <!-- Photo 1: Hero Feather Extensions -->
        <figure class="gallery-item">
          <div class="gallery-img-wrap">
            <img src={heroFeathersImg.src} alt="Hair feather extensions styling" loading="lazy" />
          </div>
          <figcaption class="gallery-caption">
            <strong>Hair Feathers</strong>
            <span>Natural Feather Extensions</span>
          </figcaption>
        </figure>

        <!-- Photo 2: Hair Tinsel Wavy -->
        <figure class="gallery-item">
          <div class="gallery-img-wrap">
            <img src={tinsel1Img.src} alt="Golden hair tinsel strands" loading="lazy" />
          </div>
          <figcaption class="gallery-caption">
            <strong>Hair Tinsel</strong>
            <span>Golden Shimmer Strands</span>
          </figcaption>
        </figure>

        <!-- Photo 3: Hair Tinsel Turquoise -->
        <figure class="gallery-item">
          <div class="gallery-img-wrap">
            <img src={tinsel2Img.src} alt="Turquoise hair tinsel strands" loading="lazy" />
          </div>
          <figcaption class="gallery-caption">
            <strong>Hair Tinsel</strong>
            <span>Turquoise Glow Strands</span>
          </figcaption>
        </figure>

        <!-- Photo 4: Lotus Henna Hand -->
        <figure class="gallery-item">
          <div class="gallery-img-wrap">
            <img src={hennaLotusImg.src} alt="Organic lotus henna tattoo" loading="lazy" />
          </div>
          <figcaption class="gallery-caption">
            <strong>Henna Art</strong>
            <span>Lotus Mandala Design</span>
          </figcaption>
        </figure>

        <!-- Photo 5: Henna Finger Rings -->
        <figure class="gallery-item">
          <div class="gallery-img-wrap">
            <img src={hennaArt1Img.src} alt="Henna hand and finger patterns" loading="lazy" />
          </div>
          <figcaption class="gallery-caption">
            <strong>Henna Art</strong>
            <span>Delicate Finger Adornment</span>
          </figcaption>
        </figure>

        <!-- Photo 6: Feather Braid / Coming Soon -->
        <figure class="gallery-item">
          <div class="gallery-img-wrap">
            <img src={featherBraidImg.src} alt="Feather braid styling" loading="lazy" />
          </div>
          <figcaption class="gallery-caption">
            <strong>Hair Feathers</strong>
            <span>Braid Feather Accent</span>
          </figcaption>
        </figure>
      </div>

      <div class="gallery-more-note text-center">
        <p>More portfolio photos coming soon from Netta's recent appointments.</p>
      </div>
    </div>
  </section>

  <!-- 5. Book an Appointment Section -->
  <section id="booking" aria-labelledby="booking-heading" class="booking-section">
    <div class="container">
      <BookingSection />
    </div>
  </section>
</BaseLayout>

<style>
  /* ── 1. Hero Section ── */
  .hero-section {
    padding-top: calc(var(--nav-h, 4.5rem) + 2.5rem);
    padding-bottom: 4rem;
    position: relative;
    z-index: 2;
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 3rem;
    align-items: center;
  }

  @media (max-width: 860px) {
    .hero-container {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 2.5rem;
    }
  }

  .hero-badge-row {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--brand-gold);
    font-weight: 500;
    margin-bottom: 0.75rem;
    letter-spacing: 0.05em;
  }

  .location-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--brand-teal);
    display: inline-block;
  }

  .badge-separator {
    color: var(--brand-gold-border);
  }

  .hero-title {
    margin: 0 0 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .hero-name {
    font-size: clamp(3.8rem, 8.5vw, 6rem);
    line-height: 1;
    display: block;
  }

  .hero-subtitle {
    font-family: var(--font-section);
    font-size: clamp(1.4rem, 3.2vw, 2.1rem);
    font-weight: 500;
    color: var(--ink);
    letter-spacing: 0.02em;
    line-height: 1.2;
  }

  .hero-motif {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin: 0.75rem 0 1.25rem;
    color: var(--brand-gold);
  }

  .motif-line {
    width: 40px;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--brand-gold), transparent);
  }

  .motif-symbol {
    font-size: 0.95rem;
    letter-spacing: 0.3em;
  }

  .hero-service-line {
    font-family: var(--font-section);
    font-size: 1.2rem;
    color: var(--brand-brown-muted);
    margin: 0 0 1.5rem;
    letter-spacing: 0.03em;
  }

  .hero-brush-banner-wrap {
    margin-bottom: 1.75rem;
  }

  .teal-brush-banner {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #1b8a8e, #136a6e);
    color: #ffffff !important;
    padding: 0.5rem 1.4rem;
    font-family: var(--font-body);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-radius: 255px 15px 225px 15px/15px 225px 15px 255px;
    box-shadow: 0 4px 14px rgba(26, 153, 157, 0.35);
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .teal-brush-banner:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(26, 153, 157, 0.5);
  }

  .hero-actions {
    display: flex;
    flex-wrap: nowrap;
    gap: 0.85rem;
    align-items: center;
  }

  @media (max-width: 860px) {
    .hero-motif {
      justify-content: center;
    }
    .hero-actions {
      justify-content: center;
    }
  }

  .hero-visual {
    display: flex;
    justify-content: center;
  }

  .hero-logo-frame {
    width: clamp(240px, 32vw, 360px);
    aspect-ratio: 1;
    border-radius: 50%;
    padding: 8px;
    background: linear-gradient(135deg, #e3ba6b, #9e6c1e, #d4a34b);
    box-shadow: 0 16px 48px rgba(61, 40, 23, 0.16);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hero-logo-frame:hover {
    transform: scale(1.02);
  }

  .hero-logo-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
    display: block;
    border: 3px solid var(--surface);
  }

  /* ── 2. Services Section ── */
  .services-section {
    padding: 4.5rem 1.5rem;
    position: relative;
    scroll-margin-top: 100px;
  }

  .section-title-wrap {
    margin-bottom: 3rem;
  }

  .sec-kicker {
    font-family: var(--font-section);
    font-size: 0.85rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--brand-gold);
    margin: 0 0 0.5rem;
  }

  .sec-title {
    font-size: clamp(3rem, 6.5vw, 4.2rem);
    margin: 0 0 0.5rem;
    line-height: 1.1;
  }

  .sec-subtitle {
    font-family: var(--font-section);
    font-size: 1.05rem;
    color: var(--muted);
    margin: 0 auto;
    max-width: 46ch;
    font-style: italic;
  }

  .services-cards-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    max-width: 1120px;
    margin: 0 auto;
  }

  @media (max-width: 960px) {
    .services-cards-grid {
      grid-template-columns: 1fr;
      max-width: 480px;
      gap: 2rem;
    }
  }

  .service-card {
    background: var(--surface);
    border: 1.5px solid var(--gold-border);
    border-radius: 24px;
    padding: 2.5rem 1.75rem;
    text-align: center;
    box-shadow: var(--card-shadow);
    display: flex;
    flex-direction: column;
    align-items: center;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.3s ease;
  }

  .service-card:hover {
    transform: translateY(-4px);
    border-color: var(--brand-gold);
  }

  .service-card.highlight {
    background: linear-gradient(180deg, var(--surface) 0%, var(--brand-cream-surface) 100%);
    border-color: var(--brand-gold);
  }

  .service-name {
    font-size: 2.3rem;
    margin: 0 0 0.25rem;
    line-height: 1.1;
  }

  .service-tagline {
    font-family: var(--font-section);
    font-size: 0.95rem;
    color: var(--brand-gold);
    font-style: italic;
    margin: 0 0 1rem;
  }

  .service-desc {
    font-size: 0.92rem;
    color: var(--muted);
    line-height: 1.55;
    margin: 0 0 1.5rem;
    flex: 1;
  }

  .service-rate-badge {
    background: var(--brand-teal-light);
    color: var(--brand-teal);
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.3rem 0.85rem;
    border-radius: 9999px;
    margin-bottom: 1.5rem;
    letter-spacing: 0.03em;
  }

  /* ── 4. Gallery Section ── */
  .gallery-section {
    padding: 5rem 1.5rem;
    position: relative;
    scroll-margin-top: 100px;
  }

  .gallery-photo-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    max-width: 1060px;
    margin: 0 auto 2rem;
  }

  @media (max-width: 860px) {
    .gallery-photo-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }
  }

  @media (max-width: 480px) {
    .gallery-photo-grid {
      grid-template-columns: 1fr;
    }
  }

  .gallery-item {
    background: var(--surface);
    border: 1.5px solid var(--gold-border);
    border-radius: 18px;
    overflow: hidden;
    margin: 0;
    box-shadow: 0 6px 20px rgba(61, 40, 23, 0.06);
    transition: transform 0.25s ease, border-color 0.25s ease;
  }

  .gallery-item:hover {
    transform: translateY(-3px);
    border-color: var(--brand-gold);
  }

  .gallery-img-wrap {
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--brand-cream-surface);
  }

  .gallery-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.35s ease;
  }

  .gallery-item:hover .gallery-img-wrap img {
    transform: scale(1.05);
  }

  .gallery-caption {
    padding: 0.85rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    text-align: center;
  }

  .gallery-caption strong {
    font-family: var(--font-section);
    font-size: 1rem;
    color: var(--ink);
  }

  .gallery-caption span {
    font-size: 0.8rem;
    color: var(--muted);
    font-style: italic;
  }

  .gallery-more-note {
    font-size: 0.92rem;
    color: var(--muted);
    font-style: italic;
    margin: 0;
  }

  /* ── 5. Booking Section ── */
  .booking-section {
    padding: 4.5rem 1.5rem 6rem;
    position: relative;
    scroll-margin-top: 100px;
  }
</style>
