---
/**
 * index.astro
 * Netta Henna and Feathered Soul - Landing Page
 * 
 * Ornate Boho Luxury Design honoring Netta's flyer + functional mobile-first UX:
 * - Hero in CCC rhythm: Centered Logo Emblem -> "Netta" in gold script -> "Henna Art · Hair Feathers · Hair Tinsel" -> Two Equal Buttons
 * - Three large circular gold-ringed service medallions on parchment with overlapping cursive ribbon banners & Netta's exact copy
 * - Ornate Price List section with horizontal gold scrollwork, turquoise cabochon gems, soft teal watercolor category banners, and selectable pricing pills
 * - Real photo gallery organized across the 3 categories (Henna Art, Hair Feathers, Hair Tinsel)
 * - Self-drawing henna mandala flourish
 * - Every content section element centered; zero em dashes across all copy
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import FeatherParallax from '../components/FeatherParallax.astro';
import PriceList from '../components/PriceList.astro';
import BookingSection from '../components/BookingSection.astro';
import HennaDraw from '../components/HennaDraw.astro';
import { SITE } from '../data/site';

// Real photo assets (10 re-cropped photos across 3 categories)
import henna1Img from '../assets/henna-art-1.jpg'; // LV monogram hand
import henna2Img from '../assets/henna-art-2.jpg'; // mandala hand
import henna3Img from '../assets/henna-art-3.jpg'; // lotus hand
import henna4Img from '../assets/henna-art-4.jpg'; // full stained hand

import feathers1Img from '../assets/hair-feathers-1.jpg'; // grizzly feather selfie
import feathers2Img from '../assets/hair-feathers-2.jpg'; // red top car selfie (cropped to face & feathers)
import feathers3Img from '../assets/hair-feathers-3.jpg'; // turquoise feather close-up

import tinsel1Img from '../assets/hair-tinsel-1.jpg'; // copper tinsel profile
import tinsel2Img from '../assets/hair-tinsel-2.jpg'; // iridescent tinsel profile
import tinsel3Img from '../assets/hair-tinsel-3.jpg'; // copper tinsel selfie (cropped to hair & tinsel)

import logoImg from '../assets/netta-logo.png';
---

<BaseLayout title={`${SITE.name} · Santa Barbara, CA`}>
  <FeatherParallax />

  <!-- 1. Hero Section (CCC Order: Logo Emblem, Headline, One Descriptor Line, Two Equal Buttons) -->
  <header class="hero-section" id="overview">
    <div class="container hero-container">
      <!-- 1. Centered Circular Logo Emblem -->
      <div class="hero-logo-frame">
        <img
          src={logoImg.src}
          width={logoImg.width}
          height={logoImg.height}
          alt="Netta Henna and Feathered Soul Emblem"
          class="hero-logo-img"
        />
      </div>

      <!-- 2. One Headline: Netta Henna and Feathered Soul (Visually hidden for screen readers/SEO) -->
      <h1 class="sr-only">Netta Henna and Feathered Soul</h1>

      <!-- 3. One Descriptor Line: Gold italic serif trio -->
      <p class="hero-descriptor-line">
        Henna Art · Hair Feathers · Hair Tinsel
      </p>

      <!-- 4. Two Equal Buttons: Identical width, height, and shape -->
      <div class="hero-actions-row">
        <a
          href={SITE.instagramUrl}
          target="_blank"
          rel="noopener"
          class="hero-btn"
          title="Direct Message Netta on Instagram"
        >
          DM TO BOOK
        </a>
        <button
          type="button"
          class="hero-btn"
          data-action="book-date"
          aria-label="Book an appointment with Netta"
        >
          BOOK A DATE
        </button>
      </div>
    </div>
  </header>

  <!-- 2. Services Section (Three Large Circular Gold-Ringed Medallions with Overlapping Parchment Banner) -->
  <section id="services" aria-labelledby="services-heading" class="services-section">
    <div class="container">
      <div class="section-title-wrap text-center">
        <p class="sec-kicker"><span class="kicker-gem" aria-hidden="true">✦</span> Bohemian Beauty · Body Art · Hair Adornments <span class="kicker-gem" aria-hidden="true">✦</span></p>
        <h2 id="services-heading" class="sec-title gold-script-text">What She Does</h2>
      </div>

      <div class="services-cards-grid">
        <!-- Service 1: Henna Art (henna-art-3.jpg lotus hand) -->
        <article class="service-medallion-item" id="service-henna">
          <div class="medallion-visual">
            <div class="gold-ring-frame medallion-circle">
              <img src={henna3Img.src} alt="Natural Henna Art lotus design" loading="lazy" />
            </div>
            <div class="medallion-ribbon">
              <h3 class="service-name gold-script-text">Henna Art</h3>
            </div>
          </div>
          <p class="service-desc">
            Beautiful, custom henna designs for hands, arms, feet and more.
          </p>
          <button type="button" class="service-rate-badge" data-service-cta="Henna Art">
            From $20 · Free Glitter Touch
          </button>
          <button type="button" class="btn btn-primary" data-service-cta="Henna Art">
            Book Henna Art
          </button>
        </article>

        <!-- Service 2: Hair Feathers (hair-feathers-2.jpg cropped to face & feathers) -->
        <article class="service-medallion-item" id="service-feathers">
          <div class="medallion-visual">
            <div class="gold-ring-frame medallion-circle">
              <img src={feathers2Img.src} alt="Netta styling real hair feather extensions" loading="lazy" />
            </div>
            <div class="medallion-ribbon">
              <h3 class="service-name gold-script-text">Hair Feathers</h3>
            </div>
          </div>
          <p class="service-desc">
            Lightweight, natural-looking feather hair extensions that add a boho touch to your style.
          </p>
          <button type="button" class="service-rate-badge" data-service-cta="Hair Feather Extensions">
            $10 to $60 + $10 Install
          </button>
          <button type="button" class="btn btn-primary" data-service-cta="Hair Feather Extensions">
            Book Hair Feathers
          </button>
        </article>

        <!-- Service 3: Hair Tinsel (hair-tinsel-1.jpg copper tinsel profile) -->
        <article class="service-medallion-item" id="service-tinsel">
          <div class="medallion-visual">
            <div class="gold-ring-frame medallion-circle">
              <img src={tinsel1Img.src} alt="Sparkling Hair Tinsel Extensions" loading="lazy" />
            </div>
            <div class="medallion-ribbon">
              <h3 class="service-name gold-script-text">Hair Tinsel</h3>
            </div>
          </div>
          <p class="service-desc">
            Shimmering hair tinsel strands for a subtle or bold, sparkling look.
          </p>
          <button type="button" class="service-rate-badge" data-service-cta="Hair Tinsel Extensions">
            $10 to $30 + $10 Install
          </button>
          <button type="button" class="btn btn-primary" data-service-cta="Hair Tinsel Extensions">
            Book Hair Tinsel
          </button>
        </article>
      </div>
    </div>
  </section>

  <!-- Self-Drawing Henna Mandala Flourish -->
  <HennaDraw />

  <!-- 3. Price List Section (Real exact prices in ornate gold & turquoise gem frame) -->
  <PriceList />

  <!-- 4. Gallery Section (Organized by Category with 10 Real Client Photos) -->
  <section id="gallery" aria-labelledby="gallery-heading" class="gallery-section">
    <div class="container">
      <div class="section-title-wrap text-center">
        <h2 id="gallery-heading" class="sec-title gold-script-text">Gallery</h2>
      </div>

      <!-- Category 1: Henna Art (4 Real Photos) -->
      <div class="gallery-cat-group">
        <div class="gallery-cat-header">
          <span class="gallery-cat-gem" aria-hidden="true">✦</span>
          <h3 class="gallery-cat-title">Henna Art</h3>
          <span class="gallery-cat-gem" aria-hidden="true">✦</span>
        </div>
        <div class="gallery-photo-grid four-col">
          <figure class="gallery-item">
            <div class="gallery-img-wrap">
              <img src={henna1Img.src} alt="LV monogram custom henna design" loading="lazy" />
            </div>
            <figcaption class="gallery-caption">
              <strong>LV Monogram Hand</strong>
              <span>Custom Henna Art</span>
            </figcaption>
          </figure>

          <figure class="gallery-item">
            <div class="gallery-img-wrap">
              <img src={henna2Img.src} alt="Mandala hand henna design" loading="lazy" />
            </div>
            <figcaption class="gallery-caption">
              <strong>Mandala Hand</strong>
              <span>Intricate Floral Composition</span>
            </figcaption>
          </figure>

          <figure class="gallery-item">
            <div class="gallery-img-wrap">
              <img src={henna3Img.src} alt="Lotus hand henna design" loading="lazy" />
            </div>
            <figcaption class="gallery-caption">
              <strong>Lotus Hand</strong>
              <span>Organic Lotus Bloom</span>
            </figcaption>
          </figure>

          <figure class="gallery-item">
            <div class="gallery-img-wrap">
              <img src={henna4Img.src} alt="Full stained henna hand" loading="lazy" />
            </div>
            <figcaption class="gallery-caption">
              <strong>Full Stained Hand</strong>
              <span>Geometric Arrow Adornment</span>
            </figcaption>
          </figure>
        </div>
      </div>

      <!-- Category 2: Hair Feathers (3 Real Photos) -->
      <div class="gallery-cat-group">
        <div class="gallery-cat-header">
          <span class="gallery-cat-gem" aria-hidden="true">✦</span>
          <h3 class="gallery-cat-title">Hair Feather Extensions</h3>
          <span class="gallery-cat-gem" aria-hidden="true">✦</span>
        </div>
        <div class="gallery-photo-grid three-col">
          <figure class="gallery-item">
            <div class="gallery-img-wrap">
              <img src={feathers1Img.src} alt="Grizzly hair feather extensions selfie" loading="lazy" />
            </div>
            <figcaption class="gallery-caption">
              <strong>Grizzly Feather Selfie</strong>
              <span>Natural Earthy Feathers</span>
            </figcaption>
          </figure>

          <figure class="gallery-item">
            <div class="gallery-img-wrap">
              <img src={feathers2Img.src} alt="Netta styled with natural hair feather extensions" loading="lazy" />
            </div>
            <figcaption class="gallery-caption">
              <strong>Feather Extensions Portrait</strong>
              <span>Multi-Tone Feather Blend</span>
            </figcaption>
          </figure>

          <figure class="gallery-item">
            <div class="gallery-img-wrap">
              <img src={feathers3Img.src} alt="Turquoise hair feather extensions in braid" loading="lazy" />
            </div>
            <figcaption class="gallery-caption">
              <strong>Turquoise Feather Close-Up</strong>
              <span>Vibrant Braid Accent</span>
            </figcaption>
          </figure>
        </div>
      </div>

      <!-- Category 3: Hair Tinsel (3 Real Photos) -->
      <div class="gallery-cat-group">
        <div class="gallery-cat-header">
          <span class="gallery-cat-gem" aria-hidden="true">✦</span>
          <h3 class="gallery-cat-title">Hair Tinsel Extensions</h3>
          <span class="gallery-cat-gem" aria-hidden="true">✦</span>
        </div>
        <div class="gallery-photo-grid three-col">
          <figure class="gallery-item">
            <div class="gallery-img-wrap">
              <img src={tinsel1Img.src} alt="Copper hair tinsel curls profile" loading="lazy" />
            </div>
            <figcaption class="gallery-caption">
              <strong>Copper Tinsel Profile</strong>
              <span>Warm Golden Curls</span>
            </figcaption>
          </figure>

          <figure class="gallery-item">
            <div class="gallery-img-wrap">
              <img src={tinsel2Img.src} alt="Iridescent hair tinsel profile" loading="lazy" />
            </div>
            <figcaption class="gallery-caption">
              <strong>Iridescent Tinsel Profile</strong>
              <span>Turquoise Shimmer Strands</span>
            </figcaption>
          </figure>

          <figure class="gallery-item">
            <div class="gallery-img-wrap">
              <img src={tinsel3Img.src} alt="Copper hair tinsel strands shimmering in dark wavy hair" loading="lazy" />
            </div>
            <figcaption class="gallery-caption">
              <strong>Copper Tinsel Strands</strong>
              <span>Fairy Hair Shimmer</span>
            </figcaption>
          </figure>
        </div>
      </div>

      <div class="gallery-more-note text-center">
        <p>More portfolio photos coming soon from Netta's recent appointments.</p>
      </div>
    </div>
  </section>

  <!-- 5. Book an Appointment Section -->
  <section id="booking" aria-labelledby="booking-heading" class="booking-section">
    <div class="container">
      <BookingSection />
    </div>
  </section>
</BaseLayout>

<style>
  /* ── 1. Hero Section ── */
  .hero-section {
    padding-top: calc(var(--nav-h, 4.5rem) + 2rem);
    padding-bottom: 5rem;
    position: relative;
    z-index: 2;
    overflow: visible;
    scroll-margin-top: 120px;
    scroll-margin-bottom: 120px;
    text-align: center;
  }

  .hero-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 680px;
    margin: 0 auto;
    overflow: visible;
  }

  .hero-logo-frame {
    --hero-logo-size: clamp(204px, 26vw, 252px);
    width: var(--hero-logo-size);
    height: var(--hero-logo-size);
    min-width: var(--hero-logo-size);
    max-width: var(--hero-logo-size);
    min-height: var(--hero-logo-size);
    max-height: var(--hero-logo-size);
    aspect-ratio: 1 / 1;
    flex-shrink: 0;
    border-radius: 50%;
    padding: 5px;
    background: linear-gradient(135deg, #e3ba6b, #9e6c1e, #d4a34b);
    box-shadow: 0 14px 40px rgba(61, 40, 23, 0.16);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.5rem;
    box-sizing: border-box;
    transition: transform 0.3s ease-in-out;
  }

  .hero-logo-frame:hover {
    transform: scale(1.02);
  }

  .hero-logo-img {
    width: 100%;
    height: 100%;
    aspect-ratio: 1 / 1;
    flex-shrink: 0;
    object-fit: cover;
    border-radius: 50%;
    display: block;
    border: 2.5px solid var(--surface);
    box-sizing: border-box;
  }

  /* Screen reader only utility for accessible page H1 */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .hero-descriptor-line {
    font-family: var(--font-display, 'Cormorant Garamond', Georgia, serif);
    font-style: italic;
    font-size: clamp(1.4rem, 3vw, 1.8rem);
    font-weight: 500;
    color: var(--brand-gold-heading, #a8821d);
    margin: 0 0 1.75rem;
    letter-spacing: 0.01em;
    line-height: 1.4;
    padding-top: 0.15em;
    padding-bottom: 0.15em;
    overflow: visible;
    text-align: center;
  }

  [data-theme="dark"] .hero-descriptor-line {
    color: var(--brand-gold, #f4d087);
  }

  .hero-actions-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
    width: 100%;
    max-width: 360px;
    margin: 0 auto;
  }

  .hero-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 1;
    min-width: 0;
    width: 100%;
    height: 48px;
    min-height: 48px;
    max-height: 48px;
    padding: 0 1rem;
    border-radius: 9999px;
    background: var(--brand-teal) !important;
    color: var(--color-accent-text, #ffffff) !important;
    font-family: var(--font-body);
    font-size: 0.88rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    border: 1.5px solid var(--brand-teal);
    box-shadow: 0 4px 14px var(--brand-teal-glow);
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    box-sizing: border-box;
    text-align: center;
  }

  .hero-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px var(--brand-teal-glow);
    border-color: var(--brand-teal-hover);
  }

  .hero-btn:active {
    transform: translateY(0);
  }

  @media (max-width: 390px) {
    .hero-actions-row {
      gap: 0.6rem;
      max-width: 350px;
    }
    .hero-btn {
      font-size: 0.8rem;
      padding: 0 0.65rem;
      letter-spacing: 0.06em;
    }
  }

  /* ── 2. Services Section (Flyer Medallion + Overlapping Parchment Banner Style) ── */
  .services-section {
    padding: 3.5rem 1.5rem 4rem;
    position: relative;
    scroll-margin-top: 115px;
    text-align: center;
  }

  .section-title-wrap {
    margin-bottom: 2rem;
    padding-bottom: 0;
    scroll-margin-top: 115px;
    scroll-margin-bottom: 120px;
    text-align: center;
    overflow: visible;
  }

  .sec-kicker {
    font-family: var(--font-display, 'Cormorant Garamond', Georgia, serif) !important;
    font-style: italic !important;
    font-size: clamp(1.15rem, 2.5vw, 1.35rem) !important;
    font-weight: 500 !important;
    letter-spacing: 0.01em !important;
    text-transform: none !important;
    color: var(--brand-gold-heading, #a8821d) !important;
    line-height: 1.4 !important;
    padding-top: 0.1em;
    padding-bottom: 0.1em;
    overflow: visible;
    margin: 0 0 0.35rem;
    text-align: center;
  }

  [data-theme="dark"] .sec-kicker {
    color: var(--brand-gold, #f4d087) !important;
  }

  .sec-kicker .kicker-gem {
    font-style: normal;
    color: var(--brand-gold);
    font-size: 0.9em;
    vertical-align: middle;
  }

  .sec-title {
    font-size: clamp(3rem, 6.5vw, 4.2rem);
    margin: 0 0 0.25rem;
    line-height: 1.45 !important;
    padding-top: 0.25em !important;
    padding-bottom: 0.2em !important;
    overflow: visible !important;
    text-align: center;
  }

  .sec-subtitle {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 500;
    font-style: normal;
    line-height: 1.55;
    color: var(--ink);
    margin: 0 auto;
    max-width: 38ch;
    text-wrap: balance;
    text-align: center;
  }

  .services-cards-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.25rem;
    max-width: 1080px;
    margin: 0 auto;
  }

  @media (max-width: 960px) {
    .services-cards-grid {
      grid-template-columns: 1fr;
      max-width: 460px;
      gap: 2.75rem;
    }
  }

  .service-medallion-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 0.5rem 0.75rem;
    height: 100%;
  }

  .medallion-visual {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 1.15rem;
  }

  .medallion-circle {
    width: 210px !important;
    height: 210px !important;
    padding: 6px !important;
    margin: 0 auto !important;
    background: linear-gradient(135deg, #e8c478 0%, #9e6c1e 50%, #e3ba6b 100%) !important;
    box-shadow: 0 12px 32px rgba(61, 40, 23, 0.2), 0 0 0 2px rgba(197, 155, 39, 0.35) !important;
  }

  .medallion-ribbon {
    position: relative;
    z-index: 2;
    margin-top: -1.65rem;
    padding: 0.15rem 1.65rem;
    border-radius: 9999px;
    background: var(--surface);
    border: 1.5px solid var(--brand-gold);
    box-shadow: 0 6px 18px rgba(61, 40, 23, 0.14);
    min-width: 205px;
    text-align: center;
    overflow: visible;
  }

  .service-name {
    font-size: 2.2rem;
    margin: 0;
    line-height: 1.45 !important;
    padding-top: 0.25em !important;
    padding-bottom: 0.2em !important;
    overflow: visible !important;
    text-align: center;
    white-space: nowrap;
  }

  .service-desc {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 500;
    font-style: normal;
    color: var(--ink);
    line-height: 1.55;
    margin: 0 auto 1.1rem;
    max-width: 32ch;
    flex: 1;
    text-align: center;
    text-wrap: balance;
  }

  .service-rate-badge {
    appearance: none;
    -webkit-appearance: none;
    font-family: var(--font-body);
    background: var(--brand-teal-light);
    color: var(--brand-teal);
    border: 1.5px solid var(--brand-gold-border);
    font-size: 0.88rem;
    font-weight: 600;
    padding: 0.45rem 1.1rem;
    border-radius: 9999px;
    margin-bottom: 1.15rem;
    letter-spacing: 0.02em;
    white-space: normal;
    text-align: center;
    cursor: pointer;
    transition: transform 0.2s ease, border-color 0.2s ease, background-color 0.2s ease;
  }

  .service-rate-badge:hover {
    transform: translateY(-1px);
    border-color: var(--brand-gold);
  }

  /* ── 4. Gallery Section ── */
  .gallery-section {
    padding: 4.5rem 1.5rem;
    position: relative;
    scroll-margin-top: 115px;
    text-align: center;
  }

  .gallery-cat-group {
    margin-bottom: 3.25rem;
    text-align: center;
  }

  .gallery-cat-header {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: 1.35rem;
    text-align: center;
  }

  .gallery-cat-gem {
    color: var(--brand-gold);
    font-size: 0.9rem;
  }

  .gallery-cat-title {
    font-family: var(--font-section);
    font-size: 1.65rem;
    font-weight: 700;
    color: var(--ink);
    margin: 0;
    line-height: 1.35;
    letter-spacing: 0.02em;
    text-align: center;
  }

  .gallery-photo-grid {
    display: grid;
    gap: 1.25rem;
    max-width: 1080px;
    margin: 0 auto;
  }

  .gallery-photo-grid.four-col {
    grid-template-columns: repeat(4, 1fr);
  }

  .gallery-photo-grid.three-col {
    grid-template-columns: repeat(3, 1fr);
  }

  @media (max-width: 900px) {
    .gallery-photo-grid.four-col,
    .gallery-photo-grid.three-col {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 500px) {
    .gallery-photo-grid.four-col,
    .gallery-photo-grid.three-col {
      grid-template-columns: 1fr;
    }
  }

  .gallery-item {
    background: var(--surface);
    border: 1.5px solid var(--brand-gold);
    border-radius: 18px;
    overflow: hidden;
    margin: 0;
    box-shadow: 0 6px 20px rgba(61, 40, 23, 0.08);
    transition: transform 0.25s ease, border-color 0.25s ease;
    text-align: center;
  }

  .gallery-item:hover {
    transform: translateY(-3px);
    border-color: var(--brand-gold);
  }

  .gallery-img-wrap {
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--brand-cream-surface);
  }

  .gallery-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
