---
/**
 * index.astro
 * Netta Henna and Feathered Soul - Landing Page
 * 
 * Ornate Boho Luxury Design:
 * - Reference Section Order: Hero, Services, Price List, Gallery, Book an Appointment, Footer
 * - Big gold script headings ("Netta", "Henna and Feathered Soul")
 * - Crescent moon and feather motifs
 * - Service line: Henna Art · Hair Feathers · Hair Tinsel
 * - "DM to Book" teal brush accent banner
 * - Circular gold-ringed service cards using real client photos
 * - Ornate Price List section with exact prices
 * - Real photo gallery organized across the 3 categories (Henna Art, Hair Feathers, Hair Tinsel)
 * - Self-drawing henna mandala flourish
 * - Zero em dashes across all copy
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import FeatherParallax from '../components/FeatherParallax.astro';
import PriceList from '../components/PriceList.astro';
import BookingSection from '../components/BookingSection.astro';
import HennaDraw from '../components/HennaDraw.astro';
import { SITE } from '../data/site';

// Real photo assets (10 photos across 3 categories sent Nov 14)
import henna1Img from '../assets/henna-art-1.jpg'; // LV monogram hand
import henna2Img from '../assets/henna-art-2.jpg'; // mandala hand
import henna3Img from '../assets/henna-art-3.jpg'; // lotus hand
import henna4Img from '../assets/henna-art-4.jpg'; // full stained hand

import feathers1Img from '../assets/hair-feathers-1.jpg'; // grizzly feather selfie
import feathers2Img from '../assets/hair-feathers-2.jpg'; // red top car selfie
import feathers3Img from '../assets/hair-feathers-3.jpg'; // turquoise feather close-up

import tinsel1Img from '../assets/hair-tinsel-1.jpg'; // copper tinsel profile
import tinsel2Img from '../assets/hair-tinsel-2.jpg'; // iridescent tinsel profile
import tinsel3Img from '../assets/hair-tinsel-3.jpg'; // copper tinsel selfie, white top

import logoImg from '../assets/netta-logo.png';
---

<BaseLayout title={`${SITE.name} · Santa Barbara, CA`}>
  <FeatherParallax />

  <!-- 1. Hero Section (CCC Order: Logo Emblem, Headline, One Descriptor Line, Two Equal Buttons) -->
  <header class="hero-section" id="overview">
    <div class="container hero-container">
      <!-- 1. Centered Circular Logo Emblem -->
      <div class="hero-logo-frame">
        <img
          src={logoImg.src}
          width={logoImg.width}
          height={logoImg.height}
          alt="Netta Henna and Feathered Soul Emblem"
          class="hero-logo-img"
        />
      </div>

      <!-- 2. One Headline: "Netta" in big gold script -->
      <h1 class="hero-title">
        <span class="hero-name gold-script-text">Netta</span>
      </h1>

      <!-- 3. One Descriptor Line: Gold italic serif trio -->
      <p class="hero-descriptor-line">
        Henna Art · Hair Feathers · Hair Tinsel
      </p>

      <!-- 4. Two Equal Buttons: Identical width, height, and shape -->
      <div class="hero-actions-row">
        <a
          href={SITE.instagramUrl}
          target="_blank"
          rel="noopener"
          class="hero-btn"
          title="Direct Message Netta on Instagram"
        >
          DM TO BOOK
        </a>
        <button
          type="button"
          class="hero-btn"
          data-action="book-date"
          aria-label="Book an appointment with Netta"
        >
          BOOK A DATE
        </button>
      </div>
    </div>
  </header>

  <!-- 2. Services Section (Three Circular Gold-Ringed Cards) -->
  <section id="services" aria-labelledby="services-heading" class="services-section">
    <div class="container">
      <div class="section-title-wrap text-center">
        <p class="sec-kicker">✦ Our Offerings ✦</p>
        <h2 id="services-heading" class="sec-title gold-script-text">What She Does</h2>
        <p class="sec-subtitle">Three signature offerings in Santa Barbara, crafted with intention and organic care.</p>
      </div>

      <div class="services-cards-grid">
        <!-- Service 1: Henna Art (henna-art-3.jpg lotus hand) -->
        <article class="service-card" id="service-henna">
          <div class="gold-ring-frame">
            <img src={henna3Img.src} alt="Natural Henna Art lotus design" loading="lazy" />
          </div>
          <h3 class="service-name gold-script-text">Henna Art</h3>
          <p class="service-tagline">Natural, Organic Adornment</p>
          <p class="service-desc">
            Custom natural henna art hand-drawn in Santa Barbara. From delicate minimal finger accents to elaborate full-hand compositions.
          </p>
          <div class="service-rate-badge">From $20 · Free Glitter Touch</div>
          <button type="button" class="btn btn-primary" data-service-cta="Henna Art">
            Book Henna Art
          </button>
        </article>

        <!-- Service 2: Hair Feathers (hair-feathers-2.jpg red top car selfie) -->
        <article class="service-card highlight" id="service-feathers">
          <div class="gold-ring-frame">
            <img src={feathers2Img.src} alt="Netta styling real hair feather extensions" loading="lazy" />
          </div>
          <h3 class="service-name gold-script-text">Hair Feathers</h3>
          <p class="service-tagline">Cruelty-Free Boho Extensions</p>
          <p class="service-desc">
            Sustainably sourced, premium natural feathers installed gently with silicone-lined micro beads for long-lasting earthy beauty.
          </p>
          <div class="service-rate-badge">$10 to $60 + $10 Install</div>
          <button type="button" class="btn btn-primary" data-service-cta="Hair Feathers">
            Book Hair Feathers
          </button>
        </article>

        <!-- Service 3: Hair Tinsel (hair-tinsel-1.jpg copper tinsel profile) -->
        <article class="service-card" id="service-tinsel">
          <div class="gold-ring-frame">
            <img src={tinsel1Img.src} alt="Sparkling Hair Tinsel Extensions" loading="lazy" />
          </div>
          <h3 class="service-name gold-script-text">Hair Tinsel</h3>
          <p class="service-tagline">Shimmering Fairy Strands</p>
          <p class="service-desc">
            High-grade, heat-resistant shimmer strands tied gently to hair follicles. Shines in natural sunlight and evening candlelight.
          </p>
          <div class="service-rate-badge">$10 to $30 + $10 Install</div>
          <button type="button" class="btn btn-primary" data-service-cta="Hair Tinsel">
            Book Hair Tinsel
          </button>
        </article>
      </div>
    </div>
  </section>

  <!-- Self-Drawing Henna Mandala Flourish -->
  <HennaDraw />

  <!-- 3. Price List Section (Real exact prices in ornate gold frame) -->
  <PriceList />

  <!-- 4. Gallery Section (Organized by Category with 10 Real Client Photos) -->
  <section id="gallery" aria-labelledby="gallery-heading" class="gallery-section">
    <div class="container">
      <div class="section-title-wrap text-center">
        <p class="sec-kicker">✦ Portfolio ✦</p>
        <h2 id="gallery-heading" class="sec-title gold-script-text">Recent Work</h2>
        <p class="sec-subtitle">Real client work in Santa Barbara. Original photos only, no stock or AI imagery.</p>
      </div>

      <!-- Category 1: Henna Art (4 Real Photos) -->
      <div class="gallery-cat-group">
        <div class="gallery-cat-header">
          <span class="gallery-cat-gem" aria-hidden="true">✦</span>
          <h3 class="gallery-cat-title">Henna Art</h3>
          <span class="gallery-cat-gem" aria-hidden="true">✦</span>
        </div>
        <div class="gallery-photo-grid four-col">
          <figure class="gallery-item">
            <div class="gallery-img-wrap">
              <img src={henna1Img.src} alt="LV monogram custom henna design" loading="lazy" />
            </div>
            <figcaption class="gallery-caption">
              <strong>LV Monogram Hand</strong>
              <span>Custom Henna Art</span>
            </figcaption>
          </figure>

          <figure class="gallery-item">
            <div class="gallery-img-wrap">
              <img src={henna2Img.src} alt="Mandala hand henna design" loading="lazy" />
            </div>
            <figcaption class="gallery-caption">
              <strong>Mandala Hand</strong>
              <span>Intricate Floral Composition</span>
            </figcaption>
          </figure>

          <figure class="gallery-item">
            <div class="gallery-img-wrap">
              <img src={henna3Img.src} alt="Lotus hand henna design" loading="lazy" />
            </div>
            <figcaption class="gallery-caption">
              <strong>Lotus Hand</strong>
              <span>Organic Lotus Bloom</span>
            </figcaption>
          </figure>

          <figure class="gallery-item">
            <div class="gallery-img-wrap">
              <img src={henna4Img.src} alt="Full stained henna hand" loading="lazy" />
            </div>
            <figcaption class="gallery-caption">
              <strong>Full Stained Hand</strong>
              <span>Geometric Arrow Adornment</span>
            </figcaption>
          </figure>
        </div>
      </div>

      <!-- Category 2: Hair Feathers (3 Real Photos) -->
      <div class="gallery-cat-group">
        <div class="gallery-cat-header">
          <span class="gallery-cat-gem" aria-hidden="true">✦</span>
          <h3 class="gallery-cat-title">Hair Feather Extensions</h3>
          <span class="gallery-cat-gem" aria-hidden="true">✦</span>
        </div>
        <div class="gallery-photo-grid three-col">
          <figure class="gallery-item">
            <div class="gallery-img-wrap">
              <img src={feathers1Img.src} alt="Grizzly hair feather extensions selfie" loading="lazy" />
            </div>
            <figcaption class="gallery-caption">
              <strong>Grizzly Feather Selfie</strong>
              <span>Natural Earthy Feathers</span>
            </figcaption>
          </figure>

          <figure class="gallery-item">
            <div class="gallery-img-wrap">
              <img src={feathers2Img.src} alt="Netta styled with natural hair feather extensions" loading="lazy" />
            </div>
            <figcaption class="gallery-caption">
              <strong>Red Top Car Selfie</strong>
              <span>Multi-Tone Feather Blend</span>
            </figcaption>
          </figure>

          <figure class="gallery-item">
            <div class="gallery-img-wrap">
              <img src={feathers3Img.src} alt="Turquoise hair feather extensions in braid" loading="lazy" />
            </div>
            <figcaption class="gallery-caption">
              <strong>Turquoise Feather Close-Up</strong>
              <span>Vibrant Braid Accent</span>
            </figcaption>
          </figure>
        </div>
      </div>

      <!-- Category 3: Hair Tinsel (3 Real Photos) -->
      <div class="gallery-cat-group">
        <div class="gallery-cat-header">
          <span class="gallery-cat-gem" aria-hidden="true">✦</span>
          <h3 class="gallery-cat-title">Hair Tinsel Extensions</h3>
          <span class="gallery-cat-gem" aria-hidden="true">✦</span>
        </div>
        <div class="gallery-photo-grid three-col">
          <figure class="gallery-item">
            <div class="gallery-img-wrap">
              <img src={tinsel1Img.src} alt="Copper hair tinsel curls profile" loading="lazy" />
            </div>
            <figcaption class="gallery-caption">
              <strong>Copper Tinsel Profile</strong>
              <span>Warm Golden Curls</span>
            </figcaption>
          </figure>

          <figure class="gallery-item">
            <div class="gallery-img-wrap">
              <img src={tinsel2Img.src} alt="Iridescent hair tinsel profile" loading="lazy" />
            </div>
            <figcaption class="gallery-caption">
              <strong>Iridescent Tinsel Profile</strong>
              <span>Turquoise Shimmer Strands</span>
            </figcaption>
          </figure>

          <figure class="gallery-item">
            <div class="gallery-img-wrap">
              <img src={tinsel3Img.src} alt="Copper hair tinsel strands shimmering in dark wavy hair" loading="lazy" />
            </div>
            <figcaption class="gallery-caption">
              <strong>Copper Tinsel Selfie</strong>
              <span>Fairy Hair Shimmer</span>
            </figcaption>
          </figure>
        </div>
      </div>

      <div class="gallery-more-note text-center">
        <p>More portfolio photos coming soon from Netta's recent appointments.</p>
      </div>
    </div>
  </section>

  <!-- 5. Book an Appointment Section -->
  <section id="booking" aria-labelledby="booking-heading" class="booking-section">
    <div class="container">
      <BookingSection />
    </div>
  </section>
</BaseLayout>

<style>
  /* ── 1. Hero Section ── */
  .hero-section {
    padding-top: calc(var(--nav-h, 4.5rem) + 2.5rem);
    padding-bottom: 4rem;
    position: relative;
    z-index: 2;
    overflow: visible;
    scroll-margin-top: 120px;
  }

  .hero-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 680px;
    margin: 0 auto;
    overflow: visible;
  }

  .hero-logo-frame {
    width: clamp(160px, 22vw, 220px);
    aspect-ratio: 1;
    border-radius: 50%;
    padding: 6px;
    background: linear-gradient(135deg, #e3ba6b, #9e6c1e, #d4a34b);
    box-shadow: 0 14px 40px rgba(61, 40, 23, 0.14);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hero-logo-frame:hover {
    transform: scale(1.02);
  }

  .hero-logo-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
    display: block;
    border: 3px solid var(--surface);
  }

  .hero-title {
    margin: 0 0 0.5rem;
    overflow: visible;
  }

  .hero-name {
    font-size: clamp(3.8rem, 8.5vw, 5.8rem);
    line-height: 1.25;
    padding-top: 0.15em;
    display: block;
    overflow: visible;
  }

  .hero-descriptor-line {
    font-family: var(--font-section, 'Cormorant Garamond', Georgia, serif);
    font-style: italic;
    font-size: clamp(1.15rem, 2.8vw, 1.45rem);
    font-weight: 500;
    color: var(--brand-gold);
    margin: 0 0 2rem;
    letter-spacing: 0.05em;
    text-align: center;
  }

  [data-theme="dark"] .hero-descriptor-line {
    color: var(--brand-gold-hover, #eec472);
  }

  .hero-actions-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
    width: 100%;
    max-width: 360px;
    margin: 0 auto;
  }

  .hero-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 1;
    min-width: 0;
    width: 100%;
    height: 48px;
    min-height: 48px;
    max-height: 48px;
    padding: 0 1rem;
    border-radius: 9999px;
    background: linear-gradient(135deg, var(--brand-teal), var(--brand-teal-hover));
    color: #ffffff !important;
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    border: 1.5px solid var(--brand-teal);
    box-shadow: 0 4px 14px var(--brand-teal-glow);
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    box-sizing: border-box;
  }

  .hero-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px var(--brand-teal-glow);
    border-color: var(--brand-teal-hover);
  }

  .hero-btn:active {
    transform: translateY(0);
  }

  @media (max-width: 390px) {
    .hero-actions-row {
      gap: 0.6rem;
      max-width: 340px;
    }
    .hero-btn {
      font-size: 0.8rem;
      padding: 0 0.65rem;
      letter-spacing: 0.06em;
    }
  }

  /* ── 2. Services Section ── */
  .services-section {
    padding: 4.5rem 1.5rem;
    position: relative;
    scroll-margin-top: 100px;
  }

  .section-title-wrap {
    margin-bottom: 3rem;
  }

  .sec-kicker {
    font-family: var(--font-section);
    font-size: 0.85rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--brand-gold);
    margin: 0 0 0.5rem;
  }

  .sec-title {
    font-size: clamp(3rem, 6.5vw, 4.2rem);
    margin: 0 0 0.5rem;
    line-height: 1.1;
  }

  .sec-subtitle {
    font-family: var(--font-section);
    font-size: 1.05rem;
    color: var(--muted);
    margin: 0 auto;
    max-width: 46ch;
    font-style: italic;
  }

  .services-cards-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    max-width: 1120px;
    margin: 0 auto;
  }

  @media (max-width: 960px) {
    .services-cards-grid {
      grid-template-columns: 1fr;
      max-width: 480px;
      gap: 2rem;
    }
  }

  .service-card {
    background: var(--surface);
    border: 1.5px solid var(--gold-border);
    border-radius: 24px;
    padding: 2.5rem 1.75rem;
    text-align: center;
    box-shadow: var(--card-shadow);
    display: flex;
    flex-direction: column;
    align-items: center;
    height: 100%;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.3s ease;
  }

  .service-card:hover {
    transform: translateY(-4px);
    border-color: var(--brand-gold);
  }

  .service-card.highlight {
    background: linear-gradient(180deg, var(--surface) 0%, var(--brand-cream-surface) 100%);
    border-color: var(--brand-gold);
  }

  .service-name {
    font-size: 2.3rem;
    margin: 0 0 0.25rem;
    line-height: 1.1;
  }

  .service-tagline {
    font-family: var(--font-section);
    font-size: 0.95rem;
    color: var(--brand-gold);
    font-style: italic;
    margin: 0 0 1rem;
  }

  .service-desc {
    font-size: 0.92rem;
    color: var(--muted);
    line-height: 1.55;
    margin: 0 0 1.5rem;
    flex: 1;
  }

  .service-rate-badge {
    background: var(--brand-teal-light);
    color: var(--brand-teal);
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.3rem 0.85rem;
    border-radius: 9999px;
    margin-bottom: 1.5rem;
    letter-spacing: 0.03em;
  }

  /* ── 4. Gallery Section ── */
  .gallery-section {
    padding: 5rem 1.5rem;
    position: relative;
    scroll-margin-top: 100px;
  }

  .gallery-cat-group {
    margin-bottom: 3.5rem;
  }

  .gallery-cat-header {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .gallery-cat-gem {
    color: var(--brand-gold);
    font-size: 0.85rem;
  }

  .gallery-cat-title {
    font-family: var(--font-section);
    font-size: 1.6rem;
    font-weight: 600;
    color: var(--ink);
    margin: 0;
    letter-spacing: 0.02em;
  }

  .gallery-photo-grid {
    display: grid;
    gap: 1.25rem;
    max-width: 1080px;
    margin: 0 auto;
  }

  .gallery-photo-grid.four-col {
    grid-template-columns: repeat(4, 1fr);
  }

  .gallery-photo-grid.three-col {
    grid-template-columns: repeat(3, 1fr);
  }

  @media (max-width: 900px) {
    .gallery-photo-grid.four-col,
    .gallery-photo-grid.three-col {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 500px) {
    .gallery-photo-grid.four-col,
    .gallery-photo-grid.three-col {
      grid-template-columns: 1fr;
    }
  }

  .gallery-item {
    background: var(--surface);
    border: 1.5px solid var(--gold-border);
    border-radius: 18px;
    overflow: hidden;
    margin: 0;
    box-shadow: 0 6px 20px rgba(61, 40, 23, 0.06);
    transition: transform 0.25s ease, border-color 0.25s ease;
  }

  .gallery-item:hover {
    transform: translateY(-3px);
    border-color: var(--brand-gold);
  }

  .gallery-img-wrap {
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--brand-cream-surface);
  }

  .gallery-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    display: block;
    transition: transform 0.35s ease;
  }

  .gallery-item:hover .gallery-img-wrap img {
    transform: scale(1.05);
  }

  .gallery-caption {
    padding: 0.85rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    text-align: center;
  }

  .gallery-caption strong {
    font-family: var(--font-section);
    font-size: 0.95rem;
    color: var(--ink);
  }

  .gallery-caption span {
    font-size: 0.8rem;
    color: var(--muted);
    font-style: italic;
  }

  .gallery-more-note {
    font-size: 0.92rem;
    color: var(--muted);
    font-style: italic;
    margin-top: 2rem;
  }

  /* ── 5. Booking Section ── */
  .booking-section {
    padding: 4.5rem 1.5rem 6rem;
    position: relative;
    scroll-margin-top: 100px;
  }
</style>
