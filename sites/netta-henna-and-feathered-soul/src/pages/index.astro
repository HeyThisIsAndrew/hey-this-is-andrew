---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandAccordion from '@andrew/ui/BrandAccordion.astro';
import SectionHeader from '@andrew/ui/SectionHeader.astro';
import FeatherParallax from '../components/FeatherParallax.astro';
import BookingSection from '../components/BookingSection.astro';
import { PANELS } from '../data/panels';
import { SITE } from '../data/site';
---

<BaseLayout title={`${SITE.name} · Santa Barbara, CA`}>
  <div class="hero-and-services">
    <FeatherParallax />

    <!-- Section 1: Hero -->
    <header class="hero-section" id="overview" data-pn-top data-pn-label="Top">
      <div class="container hero-container">
        <div class="hero-content">
          <p class="hero-kicker font-mono">
            <span class="location-dot" aria-hidden="true"></span>
            {SITE.location}
          </p>
          <h1 class="hero-title">{SITE.name}</h1>
          <p class="hero-tagline">{SITE.tagline}</p>
          <div class="hero-actions">
            <button type="button" class="btn btn-primary" data-action="book-date">
              Book a date
            </button>
            <a
              href={SITE.instagramUrl}
              target="_blank"
              rel="noopener"
              class="btn btn-secondary"
            >
              See her work on Instagram &rarr;
            </a>
          </div>
        </div>

        <div class="hero-visual" aria-hidden="true">
          <div class="hero-art-frame">
            <div class="hero-badge">Original Work Only</div>
            <p class="hero-visual-note">
              Hero photo waiting on photo supplied by Netta.
            </p>
            <div class="hero-geometry">
              <span class="geo-line"></span>
              <span class="geo-square"></span>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- Section 2: Services -->
    <section id="services" aria-labelledby="services-heading" class="services-section">
      <div class="container">
        <SectionHeader
          id="services-heading"
          kicker="01 / Services"
          title="What She Does"
          lede="Three signature offerings in Santa Barbara, crafted with intention."
        />
      </div>
      <BrandAccordion panels={PANELS} />
    </section>
  </div>

  <!-- Section 3: Gallery -->
  <section id="gallery" aria-labelledby="gallery-heading" class="gallery-section">
    <div class="container">
      <SectionHeader
        id="gallery-heading"
        kicker="02 / Portfolio"
        title="Recent Work"
        lede="Real photos of henna, feathers, and tinsel in Santa Barbara."
      />
      <div class="gallery-card">
        <p class="gallery-kicker font-mono">Original Work Only</p>
        <h3 class="gallery-card-title">Gallery Photos Coming Soon</h3>
        <p class="gallery-card-desc">
          Waiting on real photos from Netta. No stock or AI generated imagery is used.
        </p>
        <a
          href={SITE.instagramUrl}
          target="_blank"
          rel="noopener"
          class="btn btn-secondary"
        >
          See new work first on Instagram &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- Section 5: How Booking Works -->
  <section id="how-it-works" aria-labelledby="how-heading" class="how-section">
    <div class="container">
      <SectionHeader
        id="how-heading"
        kicker="03 / Process"
        title="How Booking Works"
        lede="Simple and direct. No upfront deposit or automated charges."
      />
      <ol class="steps-grid">
        <li class="step-card">
          <span class="step-num font-mono">01</span>
          <h3 class="step-title">Pick a date on the calendar</h3>
          <p class="step-desc">Select an open date that suits you from the calendar below.</p>
        </li>
        <li class="step-card">
          <span class="step-num font-mono">02</span>
          <h3 class="step-title">Tell her what you want</h3>
          <p class="step-desc">Choose your service and share any notes or ideas in the booking form.</p>
        </li>
        <li class="step-card">
          <span class="step-num font-mono">03</span>
          <h3 class="step-title">She confirms the date</h3>
          <p class="step-desc">Netta connects with you directly to confirm timing, pricing, and details.</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- Section 6: Booking Calendar & Contact Modal -->
  <section id="booking" aria-labelledby="booking-heading" class="booking-section">
    <div class="container">
      <SectionHeader
        id="booking-heading"
        kicker="04 / Schedule"
        title="Book a Date"
        lede="Select an available date below to send Netta a booking request."
      />
      <BookingSection />
    </div>
  </section>

  <!-- Section 7: Instagram -->
  <section id="instagram" aria-labelledby="instagram-heading" class="instagram-section">
    <div class="container">
      <div class="instagram-box">
        <SectionHeader
          id="instagram-heading"
          kicker="05 / Social"
          title="Follow on Instagram"
          lede="See new work first on Instagram."
        />
        <div class="instagram-actions">
          <p class="instagram-handle font-mono">{SITE.instagramHandle}</p>
          <a
            href={SITE.instagramUrl}
            target="_blank"
            rel="noopener"
            class="btn btn-secondary"
          >
            Visit Instagram Profile &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-and-services {
    position: relative;
    overflow: hidden;
  }

  .hero-section {
    padding-top: calc(var(--nav-h, 5rem) + 3rem);
    padding-bottom: 4rem;
    position: relative;
    z-index: 2;
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 3rem;
    align-items: center;
  }

  @media (max-width: 860px) {
    .hero-container {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  .hero-kicker {
    margin: 0 0 1rem;
    font-size: 0.82rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--brand, #c86446);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .location-dot {
    width: 8px;
    height: 8px;
    background: var(--brand, #c86446);
    display: inline-block;
  }

  .hero-title {
    margin: 0 0 1.25rem;
    font-family: var(--font-display, Syne, sans-serif);
    font-weight: 800;
    font-size: clamp(2.2rem, 5.5vw, 4.2rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: var(--white, #f0f0f0);
  }

  .hero-tagline {
    margin: 0 0 2rem;
    font-size: clamp(1.05rem, 2vw, 1.35rem);
    line-height: 1.45;
    color: var(--muted, #888888);
    max-width: 48ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
  }

  .hero-visual {
    width: 100%;
  }

  .hero-art-frame {
    aspect-ratio: 4 / 3;
    border: 1px solid var(--hairline, #2a2a2a);
    background:
      radial-gradient(ellipse 60% 70% at 70% 45%, rgba(200, 100, 70, 0.12), transparent 70%),
      #0e0e0e;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
  }

  .hero-badge {
    font-family: var(--font-mono, monospace);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--brand, #c86446);
  }

  .hero-visual-note {
    margin: 0;
    font-size: 0.95rem;
    color: #777777;
    max-width: 28ch;
    line-height: 1.4;
  }

  .hero-geometry {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .geo-line {
    height: 1px;
    width: 40px;
    background: #333333;
  }

  .geo-square {
    width: 6px;
    height: 6px;
    background: var(--brand, #c86446);
  }

  /* Services section */
  .services-section {
    position: relative;
    z-index: 2;
    padding-bottom: 2rem;
  }

  /* Gallery section */
  .gallery-section {
    border-top: 1px solid var(--hairline, #1f1f1f);
  }

  .gallery-card {
    border: 1px solid var(--hairline, #222222);
    background: var(--surface, #111111);
    padding: clamp(2rem, 5vw, 3.5rem);
    text-align: center;
    max-width: 720px;
    margin: 2rem auto 0;
  }

  .gallery-kicker {
    margin: 0 0 0.5rem;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--brand, #c86446);
  }

  .gallery-card-title {
    margin: 0 0 1rem;
    font-family: var(--font-display, Syne, sans-serif);
    font-size: 1.6rem;
    color: var(--white, #f0f0f0);
  }

  .gallery-card-desc {
    margin: 0 auto 1.75rem;
    color: var(--muted, #888888);
    max-width: 44ch;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  /* Steps / How it works */
  .how-section {
    border-top: 1px solid var(--hairline, #1f1f1f);
  }

  .steps-grid {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  @media (max-width: 768px) {
    .steps-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }

  .step-card {
    background: var(--surface, #111111);
    border: 1px solid var(--hairline, #222222);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
  }

  .step-num {
    font-size: 0.85rem;
    color: var(--brand, #c86446);
    margin-bottom: 0.75rem;
    display: inline-block;
  }

  .step-title {
    margin: 0 0 0.75rem;
    font-family: var(--font-display, Syne, sans-serif);
    font-size: 1.15rem;
    color: var(--white, #f0f0f0);
    line-height: 1.25;
  }

  .step-desc {
    margin: 0;
    color: var(--muted, #888888);
    font-size: 0.88rem;
    line-height: 1.5;
  }

  /* Booking section */
  .booking-section {
    border-top: 1px solid var(--hairline, #1f1f1f);
  }

  /* Instagram section */
  .instagram-section {
    border-top: 1px solid var(--hairline, #1f1f1f);
    padding-bottom: 5rem;
  }

  .instagram-box {
    max-width: 720px;
    margin: 0 auto;
  }

  .instagram-actions {
    margin-top: 2rem;
    padding: 1.5rem;
    background: var(--surface, #111111);
    border: 1px solid var(--hairline, #222222);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .instagram-handle {
    margin: 0;
    font-size: 1.05rem;
    color: var(--white, #f0f0f0);
  }
</style>
