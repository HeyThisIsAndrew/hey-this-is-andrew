---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandAccordion from '@andrew/ui/BrandAccordion.astro';
import SectionHeader from '@andrew/ui/SectionHeader.astro';
import FeatherParallax from '../components/FeatherParallax.astro';
import BookingSection from '../components/BookingSection.astro';
import { PANELS } from '../data/panels';
import { SITE } from '../data/site';
import emblemImg from '../assets/netta-logo.png';
---

<BaseLayout title={`${SITE.name} · Santa Barbara, CA`}>
  <div class="hero-and-services">
    <FeatherParallax />

    <!-- Section 1: Hero -->
    <header class="hero-section" id="overview" data-pn-top data-pn-label="Top">
      <div class="container hero-container">
        <div class="hero-content">
          <p class="hero-kicker">
            <span class="location-dot" aria-hidden="true"></span>
            <em>{SITE.location}</em>
          </p>
          <h1 class="hero-title">{SITE.name}</h1>
          <p class="hero-tagline">{SITE.tagline}</p>
          <div class="hero-actions">
            <button type="button" class="btn btn-primary" data-action="book-date">
              Book a date
            </button>
            <a
              href={SITE.instagramUrl}
              target="_blank"
              rel="noopener"
              class="btn-instagram"
              aria-label="Visit Netta on Instagram"
              title="Instagram @nettahennaandfeatheredsoul"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
              </svg>
            </a>
          </div>
        </div>

        <div class="hero-visual" aria-hidden="true">
          <div class="hero-emblem-wrap">
            <img
              src={emblemImg.src}
              width={emblemImg.width}
              height={emblemImg.height}
              alt="Netta Henna and Feathered Soul Emblem"
              class="hero-emblem-img"
            />
          </div>
        </div>
      </div>
    </header>

    <!-- Section 2: Services -->
    <section id="services" aria-labelledby="services-heading" class="services-section">
      <div class="container">
        <SectionHeader
          id="services-heading"
          kicker="Our Offerings"
          title="What She Does"
          lede="Three signature offerings in Santa Barbara, crafted with intention."
        />
      </div>
      <BrandAccordion panels={PANELS} />
    </section>
  </div>

  <!-- Section 3: Gallery -->
  <section id="gallery" aria-labelledby="gallery-heading" class="gallery-section">
    <div class="container">
      <SectionHeader
        id="gallery-heading"
        kicker="Portfolio"
        title="Recent Work"
        lede="Real photos of henna, feathers, and tinsel in Santa Barbara."
      />
      <div class="gallery-card">
        <p class="gallery-kicker"><em>Original Work Only</em></p>
        <h3 class="gallery-card-title">Gallery Photos Coming Soon</h3>
        <p class="gallery-card-desc">
          Waiting on real photos from Netta. No stock or AI generated imagery is used.
        </p>
        <div class="gallery-action-wrap">
          <a
            href={SITE.instagramUrl}
            target="_blank"
            rel="noopener"
            class="btn-instagram"
            aria-label="See new work on Instagram"
            title="Instagram @nettahennaandfeatheredsoul"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 5: How Booking Works -->
  <section id="how-it-works" aria-labelledby="how-heading" class="how-section">
    <div class="container">
      <SectionHeader
        id="how-heading"
        kicker="Process"
        title="How Booking Works"
        lede="Simple and direct. No upfront deposit or automated charges."
      />
      <ol class="steps-grid">
        <li class="step-card">
          <span class="step-num">01</span>
          <h3 class="step-title">Pick a date on the calendar</h3>
          <p class="step-desc">Select an open date that suits you from the calendar in the booking form.</p>
        </li>
        <li class="step-card">
          <span class="step-num">02</span>
          <h3 class="step-title">Tell her what you want</h3>
          <p class="step-desc">Choose your service and share any notes or ideas in the booking form.</p>
        </li>
        <li class="step-card">
          <span class="step-num">03</span>
          <h3 class="step-title">She confirms the date</h3>
          <p class="step-desc">Netta connects with you directly to confirm timing, pricing, and details.</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- Section 6: Booking Calendar & Contact Modal (Condensed on-page) -->
  <section id="booking" aria-labelledby="booking-heading" class="booking-section">
    <div class="container">
      <SectionHeader
        id="booking-heading"
        kicker="Appointments"
        title="Book a Date"
        lede="Select an available date to send Netta a booking request."
      />
      <BookingSection />
    </div>
  </section>

  <!-- Section 7: Instagram -->
  <section id="instagram" aria-labelledby="instagram-heading" class="instagram-section">
    <div class="container">
      <div class="instagram-box">
        <SectionHeader
          id="instagram-heading"
          kicker="Connect"
          title="Follow on Instagram"
          lede="See new work first on Instagram."
        />
        <div class="instagram-actions">
          <p class="instagram-handle font-mono">{SITE.instagramHandle}</p>
          <a
            href={SITE.instagramUrl}
            target="_blank"
            rel="noopener"
            class="btn-instagram"
            aria-label="Visit Netta on Instagram"
            title="Instagram @nettahennaandfeatheredsoul"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-and-services {
    position: relative;
    overflow: hidden;
  }

  .hero-section {
    padding-top: calc(var(--nav-h, 5rem) + 2rem);
    padding-bottom: 4rem;
    position: relative;
    z-index: 2;
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 3rem;
    align-items: center;
  }

  @media (max-width: 860px) {
    .hero-container {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  .hero-kicker {
    margin: 0 0 0.75rem;
    font-family: var(--font-section, 'Cormorant Garamond', Georgia, serif);
    font-size: 1.25rem;
    color: var(--brand-gold);
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  .location-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--brand-teal);
    display: inline-block;
  }

  .hero-title {
    margin: 0 0 1rem;
    font-family: var(--font-script, 'Great Vibes', cursive);
    font-weight: 400;
    font-size: clamp(3.2rem, 7.5vw, 5.6rem);
    line-height: 1.1;
    color: var(--ink);
    text-transform: none;
    letter-spacing: normal;
  }

  .hero-tagline {
    margin: 0 0 2rem;
    font-family: var(--font-section, 'Cormorant Garamond', Georgia, serif);
    font-size: clamp(1.2rem, 2.2vw, 1.55rem);
    line-height: 1.45;
    color: var(--muted);
    max-width: 44ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: nowrap;
    gap: 0.85rem;
    align-items: center;
  }

  .hero-visual {
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .hero-emblem-wrap {
    width: min(100%, 360px);
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    padding: 10px;
    background: var(--surface);
    border: 1.5px solid var(--gold-border);
    box-shadow:
      0 12px 35px rgba(61, 40, 23, 0.12),
      0 0 0 8px var(--brand-teal-light);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.4s ease, border-color 0.3s ease;
  }

  .hero-emblem-wrap:hover {
    transform: scale(1.02);
  }

  .hero-emblem-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
  }

  /* Services section */
  .services-section {
    position: relative;
    z-index: 2;
    padding-bottom: 2.5rem;
  }

  /* Gallery section */
  .gallery-section {
    border-top: 1px solid var(--gold-border);
  }

  .gallery-card {
    border: 1px solid var(--gold-border);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--card-shadow);
    padding: clamp(2rem, 5vw, 3.5rem);
    text-align: center;
    max-width: 680px;
    margin: 2rem auto 0;
  }

  .gallery-kicker {
    margin: 0 0 0.5rem;
    font-family: var(--font-section, 'Cormorant Garamond', Georgia, serif);
    font-size: 1.15rem;
    color: var(--brand-gold);
  }

  .gallery-card-title {
    margin: 0 0 0.75rem;
    font-family: var(--font-display, 'Cormorant Garamond', Georgia, serif);
    font-weight: 500;
    font-size: 1.8rem;
    color: var(--ink);
  }

  .gallery-card-desc {
    margin: 0 auto 1.5rem;
    color: var(--muted);
    max-width: 44ch;
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .gallery-action-wrap {
    display: flex;
    justify-content: center;
  }

  /* Steps / How it works */
  .how-section {
    border-top: 1px solid var(--gold-border);
  }

  .steps-grid {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  @media (max-width: 768px) {
    .steps-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }

  .step-card {
    background: var(--surface);
    border: 1px solid var(--gold-border);
    border-radius: var(--radius);
    box-shadow: var(--card-shadow);
    padding: 2rem 1.75rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    transition: background-color 0.3s ease, border-color 0.3s ease;
  }

  .step-num {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--brand-teal-light);
    color: var(--brand-teal);
    font-family: var(--font-section, Georgia, serif);
    font-weight: 600;
    font-size: 0.9rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
    border: 1px solid var(--gold-border);
  }

  .step-title {
    margin: 0 0 0.6rem;
    font-family: var(--font-display, 'Cormorant Garamond', Georgia, serif);
    font-weight: 600;
    font-size: 1.35rem;
    color: var(--ink);
    line-height: 1.25;
  }

  .step-desc {
    margin: 0;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.55;
  }

  /* Booking section */
  .booking-section {
    border-top: 1px solid var(--gold-border);
  }

  /* Instagram section */
  .instagram-section {
    border-top: 1px solid var(--gold-border);
    padding-bottom: 5rem;
  }

  .instagram-box {
    max-width: 680px;
    margin: 0 auto;
  }

  .instagram-actions {
    margin-top: 2rem;
    padding: 1.5rem 2rem;
    background: var(--surface);
    border: 1px solid var(--gold-border);
    border-radius: var(--radius);
    box-shadow: var(--card-shadow);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    transition: background-color 0.3s ease, border-color 0.3s ease;
  }

  .instagram-handle {
    margin: 0;
    font-size: 1.05rem;
    color: var(--ink);
  }
</style>
