---
/**
 * SlimFooter.astro
 * Slim landing page footer.
 * Contains:
 * 1. Centered brand logo and name
 * 2. One centered action row pairing the Instagram pill (icon + @nettahennaandfeatheredsoul) and the Book a date button
 */
import { SITE, homeUrl } from '../data/site';
import logoImg from '../assets/netta-logo.png';
---

<footer class="slim-footer" id="site-footer">
  <div class="container slim-footer-inner">
    <!-- Brand & Logo -->
    <a href={homeUrl} class="slim-footer-brand" aria-label={`${SITE.name}, top`}>
      <img
        src={logoImg.src}
        width={logoImg.width}
        height={logoImg.height}
        alt={SITE.name}
        class="slim-footer-logo"
      />
      <span class="slim-footer-name">{SITE.name}</span>
    </a>

    <!-- Paired Action Row: Instagram Pill + Book a date button -->
    <div class="slim-footer-actions">
      <a
        href={SITE.instagramUrl}
        target="_blank"
        rel="noopener"
        class="btn-instagram footer-ig-link"
        aria-label="Follow Netta on Instagram, @nettahennaandfeatheredsoul"
        title="Instagram @nettahennaandfeatheredsoul"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          width="22"
          height="22"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"
          />
        </svg>
        <span class="footer-ig-handle">{SITE.instagramHandle}</span>
      </a>

      <button type="button" class="footer-book-btn" data-action="book-date">
        Book a date
      </button>
    </div>
  </div>
</footer>

<style>
  .footer-ig-link {
    width: auto !important;
    min-width: 0 !important;
    max-width: none !important;
    height: 48px !important;
    min-height: 48px !important;
    padding: 0 1.15rem 0 0.95rem !important;
    gap: 0.5rem !important;
    border-radius: 9999px !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    box-sizing: border-box !important;
  }

  .footer-ig-handle {
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--ink);
    white-space: nowrap;
    text-transform: lowercase;
    line-height: 1;
  }

  [data-theme="dark"] .footer-ig-handle {
    color: var(--ink, #f7efe4);
  }

  @media (max-width: 640px) {
    .slim-footer-actions {
      flex-direction: column !important;
      align-items: center !important;
      gap: 0.75rem !important;
      width: 100% !important;
      max-width: 340px !important;
      margin: 0 auto !important;
    }
    .footer-ig-link {
      width: 100% !important;
      max-width: 320px !important;
      padding: 0 0.85rem !important;
      justify-content: center !important;
    }
    .footer-ig-handle {
      font-size: 0.85rem;
    }
    .footer-book-btn {
      width: 100% !important;
      max-width: 320px !important;
      justify-content: center !important;
    }
  }
</style>
