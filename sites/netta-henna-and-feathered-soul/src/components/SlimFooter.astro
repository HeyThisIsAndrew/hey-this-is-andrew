---
/**
 * SlimFooter.astro
 * Pass 30: Transparent floating footer with feathered top/bottom mandala SVG bar (no straight bottom baseline),
 * henna draw-on hover underline under the handle/domain text only (no whole-card lift),
 * tap-to-copy domain with 2s gold "Copied" feedback, and feathered ribbon "Book a date" button.
 */
import { SITE } from '../data/site';
import HennaBorderDraw from './HennaBorderDraw.astro';
---

<footer class="slim-footer" id="site-footer">
  <!-- Top Ornate Gold Divider with Teal Diamond -->
  <div class="footer-top-divider" aria-hidden="true">
    <div class="divider-line divider-line-left"></div>
    <div class="divider-scroll-ornament">
      <span class="scroll-flourish flourish-left">❧</span>
      <span class="divider-diamond">◆</span>
      <span class="scroll-flourish flourish-right">☙</span>
    </div>
    <div class="divider-line divider-line-right"></div>
  </div>

  <div class="container slim-footer-inner">
    <!-- Two Column Flyer Layout (Desktop Symmetric 3-Col Grid: 1fr | auto | 1fr, Mobile Stacked) -->
    <div class="footer-flyer-cols">
      <!-- Left Column: Follow Along (Instagram) -->
      <a
        href={SITE.instagramUrl}
        target="_blank"
        rel="noopener"
        class="footer-col-card footer-col-ig footer-col-insta"
        aria-label="Follow Netta on Instagram, @nettahennaandfeatheredsoul"
      >
        <div class="footer-icon-circle">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            width="22"
            height="22"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"
            />
          </svg>
        </div>
        <div class="footer-col-text">
          <span class="footer-script-label">Follow Along</span>
          <span class="footer-sub-interactive">
            <span class="footer-sub-label">{SITE.instagramHandle}</span>
            <svg class="footer-henna-underline" viewBox="0 0 220 12" fill="none" aria-hidden="true">
              <path
                class="henna-underline-path"
                d="M 2 6 C 45 2, 95 10, 145 5 C 175 2, 195 8, 208 6"
                stroke="#a8821d"
                stroke-width="1.6"
                stroke-linecap="round"
              />
              <circle class="henna-underline-dot" cx="215" cy="6" r="2.8" fill="#0e7c7b" />
            </svg>
          </span>
        </div>
      </a>

      <!-- Center Ornate Vertical Divider (Desktop Only): thin gold line with centered teal diamond -->
      <div class="footer-center-divider" aria-hidden="true">
        <span class="footer-v-line"></span>
        <span class="footer-v-diamond">◆</span>
        <span class="footer-v-line"></span>
      </div>

      <!-- Right Column: Visit My Website (Tap-to-Copy plain text, NOT a hyperlink) -->
      <div class="footer-col-card footer-col-web">
        <div class="footer-icon-circle">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            width="22"
            height="22"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
            <line x1="8" y1="21" x2="16" y2="21"></line>
            <line x1="12" y1="17" x2="12" y2="21"></line>
          </svg>
        </div>
        <div class="footer-col-text">
          <span class="footer-script-label">Visit My Website</span>
          <div class="footer-domain-copy-wrap footer-sub-interactive">
            <span
              class="footer-sub-label footer-domain-text footer-plain-domain"
              role="button"
              tabindex="0"
              aria-label="Copy website address"
              title="Tap to copy"
              data-domain-copy="nettahennaandfeatheredsoul.com"
            >
              <span>nettahennaandfeatheredsoul.com</span>
              <svg
                class="footer-copy-icon"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
                <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
              </svg>
            </span>
            <span class="footer-copied-badge" role="status" aria-live="polite">Copied</span>
            <svg class="footer-henna-underline" viewBox="0 0 220 12" fill="none" aria-hidden="true">
              <path
                class="henna-underline-path"
                d="M 2 6 C 45 2, 95 10, 145 5 C 175 2, 195 8, 208 6"
                stroke="#a8821d"
                stroke-width="1.6"
                stroke-linecap="round"
              />
              <circle class="henna-underline-dot" cx="215" cy="6" r="2.8" fill="#0e7c7b" />
            </svg>
          </div>
        </div>
      </div>
    </div>

    <!-- Centered Book a Date Feathered Ribbon Button -->
    <div class="footer-cta-wrap">
      <button type="button" class="footer-book-btn brush-ribbon-btn" data-action="book-date">
        Book a date
      </button>
    </div>

    <!-- Copyright Line -->
    <p class="footer-copyright">
      © 2026 Netta Henna and Feathered Soul. All rights reserved.
    </p>
  </div>

  <!-- Bottom Floating Henna Mandala Border using Argon's SVG (Transparent, Feathered Top & Bottom, No Straight Baseline) -->
  <div class="footer-mandala-bar" data-footer-henna-draw aria-hidden="true">
    <div class="footer-mandala-track">
      <div class="footer-mandala-half footer-mandala-half-left">
        <HennaBorderDraw side="left" variant="open" />
      </div>
      <div class="footer-mandala-half footer-mandala-half-right">
        <HennaBorderDraw side="left" variant="open" />
      </div>
    </div>
  </div>
</footer>

<script>
  function setupFooterHennaAndCopy() {
    const bars = document.querySelectorAll<HTMLElement>('[data-footer-henna-draw]');
    if (bars.length) {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        bars.forEach((el) => el.classList.add('is-drawn'));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-drawn');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.15 }
        );
        bars.forEach((el) => observer.observe(el));
      }
    }

    const domainEl = document.querySelector<HTMLElement>('[data-domain-copy]');
    if (domainEl && !domainEl.dataset.copyWired) {
      domainEl.dataset.copyWired = '1';
      const badgeEl = domainEl.parentElement?.querySelector<HTMLElement>('.footer-copied-badge');
      let fadeTimer = 0;

      const handleCopy = (e: Event) => {
        if (e.type === 'keydown') {
          const ke = e as KeyboardEvent;
          if (ke.key !== 'Enter' && ke.key !== ' ') return;
          ke.preventDefault();
        }
        const domain = domainEl.getAttribute('data-domain-copy') || 'nettahennaandfeatheredsoul.com';
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(domain).catch(() => {});
        }
        if (badgeEl) {
          window.clearTimeout(fadeTimer);
          badgeEl.classList.add('is-visible');
          fadeTimer = window.setTimeout(() => {
            badgeEl.classList.remove('is-visible');
          }, 2000);
        }
      };

      domainEl.addEventListener('click', handleCopy);
      domainEl.addEventListener('keydown', handleCopy);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupFooterHennaAndCopy, { once: true });
  } else {
    setupFooterHennaAndCopy();
  }
  document.addEventListener('astro:page-load', setupFooterHennaAndCopy);
</script>

<style>
  /* ── Transparent Floating Footer (Floats directly on #faf6ee light / #181310 dark) ── */
  .slim-footer {
    position: relative !important;
    z-index: 10 !important;
    padding: 2rem 0 0.5rem 0;
    text-align: center;
    background: transparent !important;
    background-color: transparent !important;
    border-top: none !important;
    overflow: hidden;
  }

  :global([data-theme="dark"]) .slim-footer {
    background: transparent !important;
    background-color: transparent !important;
  }

  /* ── Top Ornate Gold Divider ── */
  .footer-top-divider {
    display: flex;
    align-items: center;
    justify-content: center;
    max-width: 860px;
    margin: 0 auto 1.75rem;
    padding: 0 1.5rem;
    gap: 0.85rem;
    opacity: 0.85;
  }

  .divider-line {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--brand-gold, #c59b27) 30%, var(--brand-gold, #c59b27) 70%, transparent);
  }

  .divider-scroll-ornament {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--brand-gold, #c59b27);
  }

  .scroll-flourish {
    font-size: 1.1rem;
    line-height: 1;
    color: var(--brand-gold, #c59b27);
  }

  .divider-diamond {
    color: var(--brand-teal, #0e7c7b);
    font-size: 0.95rem;
    vertical-align: middle;
  }

  [data-theme="dark"] .divider-diamond {
    color: var(--brand-teal, #4de0d2);
    text-shadow: 0 0 8px rgba(77, 224, 210, 0.4);
  }

  .slim-footer-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    padding-bottom: 1.5rem;
  }

  /* ── Flyer Columns (Desktop Symmetric 3-Col Grid: 1fr | auto | 1fr, Mobile Stacked) ── */
  .footer-flyer-cols {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    justify-items: center;
    gap: 2.75rem;
    width: 100%;
    max-width: 820px;
    margin: 0 auto;
  }

  .footer-col-ig {
    justify-self: end;
  }

  .footer-col-web {
    justify-self: start;
  }

  /* Step 3: NO whole-section lift, NO scale, NO opacity change on hover */
  .footer-col-card {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    text-decoration: none;
    color: inherit;
    transform: none !important;
    transition: none !important;
  }

  a.footer-col-card:hover,
  .footer-col-card:hover {
    transform: none !important;
    opacity: 1 !important;
  }

  .footer-icon-circle {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1.5px solid var(--brand-gold, #c59b27);
    background: var(--surface, #faf6ee);
    color: var(--brand-gold-heading, #a8821d);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: 0 2px 6px rgba(61, 40, 23, 0.08);
    transform: none !important;
  }

  [data-theme="dark"] .footer-icon-circle {
    background: #231b15;
    color: var(--brand-gold, #f4d087);
    border-color: var(--brand-gold, #f4d087);
  }

  .footer-col-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    overflow: visible !important;
  }

  .footer-script-label {
    font-family: var(--font-script, 'Great Vibes', cursive);
    font-size: 1.85rem;
    color: var(--brand-gold-heading, #a8821d) !important;
    line-height: 1.4 !important;
    white-space: nowrap;
    overflow: visible !important;
    margin-bottom: 0.35rem !important;
    padding-bottom: 0.15rem;
  }

  [data-theme="dark"] .footer-script-label {
    color: var(--brand-gold, #f4d087) !important;
  }

  .footer-sub-interactive {
    position: relative;
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    overflow: visible !important;
  }

  .footer-sub-label {
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 0.95rem;
    font-weight: 500;
    line-height: 1.5 !important;
    letter-spacing: 0.02em;
    color: var(--ink, #3d2817);
    white-space: nowrap;
    overflow: visible !important;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding-top: 0.25rem !important;
    transition: color 0.25s ease;
  }

  [data-theme="dark"] .footer-sub-label {
    color: var(--ink, #f7efe4);
  }

  .footer-domain-text {
    color: var(--ink, #3d2817);
    font-weight: 500;
    letter-spacing: 0.02em;
    cursor: pointer;
    user-select: all;
  }

  [data-theme="dark"] .footer-domain-text {
    color: var(--ink, #f7efe4);
  }

  .footer-copy-icon {
    opacity: 0.65;
    color: var(--brand-gold-heading, #a8821d);
    flex-shrink: 0;
  }

  [data-theme="dark"] .footer-copy-icon {
    color: var(--brand-gold, #f4d087);
  }

  .footer-copied-badge {
    position: absolute;
    left: calc(100% + 0.5rem);
    top: 50%;
    transform: translateY(-50%);
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--brand-gold-heading, #a8821d);
    background: rgba(197, 155, 39, 0.14);
    border: 1px solid var(--brand-gold, #c59b27);
    padding: 0.12rem 0.5rem;
    border-radius: 999px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
    white-space: nowrap;
  }

  [data-theme="dark"] .footer-copied-badge {
    color: var(--brand-gold, #f4d087);
    background: rgba(244, 208, 135, 0.15);
    border-color: var(--brand-gold, #f4d087);
  }

  .footer-copied-badge.is-visible {
    opacity: 1;
  }

  /* ── Step 3: Henna Draw-On Underline Under Text Only (0.4s Left-to-Right) ── */
  .footer-henna-underline {
    width: 100%;
    height: 10px;
    margin-top: 1px;
    overflow: visible;
    pointer-events: none;
    display: block;
  }

  .henna-underline-path {
    stroke-dasharray: 220;
    stroke-dashoffset: 220;
    transition: stroke-dashoffset 0.4s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .henna-underline-dot {
    opacity: 0;
    transform: scale(0.4);
    transform-box: fill-box;
    transform-origin: center;
    transition: opacity 0.25s ease 0.25s, transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1) 0.25s;
  }

  /* Trigger on hover/focus of the handle or domain separately */
  .footer-col-ig:hover .footer-sub-label,
  .footer-col-ig:focus-visible .footer-sub-label,
  .footer-domain-copy-wrap:hover .footer-sub-label,
  .footer-domain-copy-wrap:focus-within .footer-sub-label {
    color: #0e7c7b !important;
  }

  :global([data-theme="dark"]) .footer-col-ig:hover .footer-sub-label,
  :global([data-theme="dark"]) .footer-col-ig:focus-visible .footer-sub-label,
  :global([data-theme="dark"]) .footer-domain-copy-wrap:hover .footer-sub-label,
  :global([data-theme="dark"]) .footer-domain-copy-wrap:focus-within .footer-sub-label {
    color: #4de0d2 !important;
  }

  .footer-col-ig:hover .henna-underline-path,
  .footer-col-ig:focus-visible .henna-underline-path,
  .footer-domain-copy-wrap:hover .henna-underline-path,
  .footer-domain-copy-wrap:focus-within .henna-underline-path {
    stroke-dashoffset: 0;
  }

  .footer-col-ig:hover .henna-underline-dot,
  .footer-col-ig:focus-visible .henna-underline-dot,
  .footer-domain-copy-wrap:hover .henna-underline-dot,
  .footer-domain-copy-wrap:focus-within .henna-underline-dot {
    opacity: 1;
    transform: scale(1);
  }

  /* Center Vertical Divider (Desktop): Thin Gold Line + Teal Diamond */
  .footer-center-divider {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 68px;
    gap: 0.25rem;
    opacity: 0.9;
  }

  .footer-v-line {
    width: 1px;
    flex: 1;
    background: linear-gradient(180deg, transparent, var(--brand-gold, #c59b27) 25%, var(--brand-gold, #c59b27) 75%, transparent);
  }

  .footer-v-diamond {
    color: var(--brand-teal, #0e7c7b);
    font-size: 0.78rem;
    line-height: 1;
  }

  [data-theme="dark"] .footer-v-diamond {
    color: var(--brand-teal, #4de0d2);
    text-shadow: 0 0 8px rgba(77, 224, 210, 0.4);
  }

  /* CTA Button Wrap */
  .footer-cta-wrap {
    margin-top: 0.25rem;
  }

  .footer-copyright {
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 0.82rem;
    color: var(--muted, #6e5540);
    margin: 0;
    opacity: 0.85;
  }

  [data-theme="dark"] .footer-copyright {
    color: #a89484;
  }

  /* ── Step 2: Bottom Floating Henna Mandala SVG Border (Transparent, Feathered Top & Bottom, No Baseline) ── */
  .footer-mandala-bar {
    width: 100%;
    height: 54px;
    overflow: hidden;
    position: relative;
    pointer-events: none !important;
    background: transparent !important;
    opacity: 0.82;
    margin-top: 0.35rem;
    -webkit-mask-image:
      linear-gradient(180deg, transparent 0%, rgba(0, 0, 0, 0.78) 18%, #000 48%, rgba(0, 0, 0, 0.65) 78%, transparent 98%),
      linear-gradient(90deg, transparent 0%, #000 8%, #000 92%, transparent 100%);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(180deg, transparent 0%, rgba(0, 0, 0, 0.78) 18%, #000 48%, rgba(0, 0, 0, 0.65) 78%, transparent 98%),
      linear-gradient(90deg, transparent 0%, #000 8%, #000 92%, transparent 100%);
    mask-composite: intersect;
  }

  [data-theme="dark"] .footer-mandala-bar {
    opacity: 0.58;
    filter: drop-shadow(0 0 8px rgba(244, 208, 135, 0.22));
  }

  .footer-mandala-track {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    width: 100%;
    height: 100%;
  }

  .footer-mandala-half {
    width: 780px;
    height: 54px;
    position: relative;
    flex-shrink: 0;
    overflow: hidden;
  }

  .footer-mandala-half-right {
    transform: scaleX(-1);
  }

  .footer-mandala-half :global(.henna-art-svg) {
    width: 58px !important;
    height: 780px !important;
    position: absolute !important;
    left: 50% !important;
    top: calc(50% + 5px) !important;
    transform: translate(-50%, -50%) rotate(-90deg) !important;
    display: block !important;
  }

  /* The footer bar uses HennaBorderDraw variant="open" (no straight rails); draw-in lives in src/styles/henna.css. */

  /* ── Mobile Stacked (<= 640px, e.g. 390px) ── */
  @media (max-width: 640px) {
    .slim-footer {
      padding: 1.5rem 0 0.35rem 0;
    }

    .footer-top-divider {
      margin-bottom: 1.5rem;
      padding: 0 1rem;
    }

    .footer-flyer-cols {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1.25rem;
    }

    .footer-col-ig,
    .footer-col-web {
      justify-self: center;
    }

    .footer-center-divider {
      display: none;
    }

    .footer-col-card {
      flex-direction: column;
      text-align: center;
      gap: 0.5rem;
    }

    .footer-col-text {
      align-items: center;
      text-align: center;
      overflow: visible !important;
    }

    .footer-sub-interactive {
      align-items: center;
    }

    .footer-copied-badge {
      position: static;
      transform: none;
      margin-top: 0.2rem;
    }

    .footer-script-label {
      font-size: 1.7rem;
      line-height: 1.4 !important;
      margin-bottom: 0.4rem !important;
      overflow: visible !important;
    }

    .footer-sub-label {
      font-size: 0.95rem;
      line-height: 1.5 !important;
      padding-top: 0.25rem !important;
      overflow: visible !important;
    }

    .footer-mandala-bar {
      height: 38px;
    }

    .footer-mandala-half {
      width: 540px;
      height: 38px;
    }

    .footer-mandala-half :global(.henna-art-svg) {
      width: 42px !important;
      height: 540px !important;
      top: calc(50% + 4px) !important;
    }
  }
</style>
