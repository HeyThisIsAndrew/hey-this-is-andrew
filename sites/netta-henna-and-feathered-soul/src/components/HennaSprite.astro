---
/**
 * HennaSprite.astro
 * Renders Netta's henna strip ONCE per page, hidden, so every border can show it
 * through <use href="#hb-strip">. Before Pass 32 the page inlined 44 full copies
 * (15,488 paths and 18,216 circles, about 5 MB of HTML).
 *
 * Groups, in Pass 30 paint order (frame lines, motifs, then dots on top):
 *   #hb-frame   36 frame rail and scallop paths
 *   #hb-motifs  mandalas, paisleys and lotus flowers
 *   #hb-dots    414 dots and gems (real circles, never converted to paths),
 *               grouped by radius for a cheap scale-in (see henna-art.ts DOT_GROUPS)
 *   #hb-strip       frame + motifs + dots (side borders, boxes, dividers, nav drape)
 *   #hb-strip-open  motifs + dots, no straight rails (footer mandala bar)
 *
 * Every path has pathLength="1", so the draw-in dash works for any path length.
 */
import { FRAME_GROUPS, MOTIF_GROUPS, DOT_GROUPS, NAV_CORNER_DOTS, type PathItem } from '../lib/henna-art';

const pathAttrs = (p: PathItem) => ({
  d: p.d,
  stroke: p.stroke,
  'stroke-width': p.width,
  pathLength: 1,
});
---

<svg class="henna-sprite" width="0" height="0" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <g id="hb-frame" stroke-linecap="round" stroke-linejoin="round" fill="none">
      {FRAME_GROUPS.map((g, i) => (
        <g id={`hb-frame-${i}`} class="hb-m" style={`--d:${g.delay}`}>{g.paths.map((p) => <path {...pathAttrs(p)} />)}</g>
      ))}
    </g>
    <g id="hb-motifs" stroke-linecap="round" stroke-linejoin="round" fill="none">
      {MOTIF_GROUPS.map((g, i) => (
        <g id={`hb-motif-${i}`} class="hb-m" style={`--d:${g.delay}`}>{g.paths.map((p) => <path {...pathAttrs(p)} />)}</g>
      ))}
    </g>
    <g id="hb-dots" class="hb-dots">
      {DOT_GROUPS.map((g) => (
        <g class="hb-dg" style={`--sw:${g.radius}`}>
          {g.dots.map((d) => <circle cx={d.cx} cy={d.cy} r={Math.round(d.radius * 50) / 100} fill={d.fill} stroke={d.fill} />)}
        </g>
      ))}
    </g>
    <g id="hb-strip"><use href="#hb-frame" /><use href="#hb-motifs" /><use href="#hb-dots" /></g>
    <g id="hb-strip-open"><use href="#hb-motifs" /><use href="#hb-dots" /></g>
    <!-- Reuse complete original motifs instead of clipping the long strip. -->
    <g id="hb-nav-corner" fill="none" stroke-linecap="round" stroke-linejoin="round">
      <use href="#hb-frame-0" /><use href="#hb-motif-0" />
      {NAV_CORNER_DOTS.map((d) => <circle cx={d.cx} cy={d.cy} r={d.radius} fill={d.fill} />)}
    </g>
    <!-- Connected 5-petal henna lotus & sweeping curling vine connector reused for Services gaps -->
    <g id="hb-lotus-connector" fill="none" stroke-linecap="round" stroke-linejoin="round">
      <!-- Continuous sweeping central vine from left to right -->
      <path d="M12 60 C38 60, 56 72, 84 64 C98 60, 108 58, 120 58 C132 58, 142 60, 156 64 C184 72, 202 60, 228 60" stroke="#a8821d" stroke-width="1.6" vector-effect="non-scaling-stroke" />
      <!-- Pedestal base scallop under lotus -->
      <path d="M96 60 Q120 72 144 60" stroke="#c59b27" stroke-width="1.35" vector-effect="non-scaling-stroke" />
      <!-- 5-petal symmetrical lotus rising from (120, 58) -->
      <path d="M120 58 C108 38, 110 20, 120 8 C130 20, 132 38, 120 58 Z" stroke="#a8821d" stroke-width="1.55" vector-effect="non-scaling-stroke" />
      <path d="M117 57 C97 50, 93 30, 101 18 C111 26, 116 40, 117 57 Z" stroke="#c59b27" stroke-width="1.4" vector-effect="non-scaling-stroke" />
      <path d="M123 57 C143 50, 147 30, 139 18 C129 26, 124 40, 123 57 Z" stroke="#c59b27" stroke-width="1.4" vector-effect="non-scaling-stroke" />
      <path d="M112 58 C86 58, 76 44, 82 32 C94 36, 104 46, 112 58 Z" stroke="#a8821d" stroke-width="1.35" vector-effect="non-scaling-stroke" />
      <path d="M128 58 C154 58, 164 44, 158 32 C146 36, 136 46, 128 58 Z" stroke="#a8821d" stroke-width="1.35" vector-effect="non-scaling-stroke" />
      <!-- Connected spiral curls and leaves branching from the sweeping vine -->
      <path d="M62 65 C46 52, 42 40, 50 36 C56 34, 62 42, 62 65 Z" stroke="#c59b27" stroke-width="1.35" vector-effect="non-scaling-stroke" />
      <path d="M178 65 C194 52, 198 40, 190 36 C184 34, 178 42, 178 65 Z" stroke="#c59b27" stroke-width="1.35" vector-effect="non-scaling-stroke" />
      <path d="M36 62 C26 52, 20 44, 24 38 C28 34, 34 38, 30 44" stroke="#a8821d" stroke-width="1.3" vector-effect="non-scaling-stroke" />
      <path d="M204 62 C214 52, 220 44, 216 38 C212 34, 206 38, 210 44" stroke="#a8821d" stroke-width="1.3" vector-effect="non-scaling-stroke" />
      <!-- Teal & gold mehndi dots -->
      <circle cx="120" cy="3" r="3" fill="var(--brand-teal, #0e7c7b)" />
      <circle cx="96" cy="14" r="2.3" fill="var(--brand-teal, #0e7c7b)" />
      <circle cx="144" cy="14" r="2.3" fill="var(--brand-teal, #0e7c7b)" />
      <circle cx="74" cy="27" r="2.2" fill="#c59b27" />
      <circle cx="166" cy="27" r="2.2" fill="#c59b27" />
      <circle cx="12" cy="60" r="2.6" fill="var(--brand-teal, #0e7c7b)" />
      <circle cx="228" cy="60" r="2.6" fill="var(--brand-teal, #0e7c7b)" />
      <circle cx="120" cy="74" r="2.6" fill="var(--brand-teal, #0e7c7b)" />
    </g>
    <!-- Blooming lotus motif & gem dots from HennaSprite for Gallery Henna Art dialog header -->
    <g id="hb-dialog-lotus" fill="none" stroke-linecap="round" stroke-linejoin="round">
      <use href="#hb-motif-2" />
      {DOT_GROUPS.map((g) =>
        g.dots
          .filter((d) => d.cy >= 280 && d.cy <= 356 && d.cx >= 15)
          .map((d) => <circle cx={d.cx} cy={d.cy} r={d.radius} fill={d.fill} />)
      )}
    </g>
  </defs>
</svg>

<style is:global>
  .henna-sprite {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
    pointer-events: none;
  }
</style>
