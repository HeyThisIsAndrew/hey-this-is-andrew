<style>
  .henna-borders-layer {
    position: fixed;
    inset: 0;
    pointer-events: none !important;
    overflow: hidden;
    z-index: 0;
  }

  .henna-border-side {
    position: absolute;
    top: 0;
    bottom: 0;
    height: 100vh;
    pointer-events: none !important;
    opacity: 0.75;
    transition: opacity 0.4s ease;
  }

  .henna-vine-svg {
    display: block;
    width: 100%;
    height: 100%;
    pointer-events: none !important;
    filter: drop-shadow(0 2px 8px rgba(197, 155, 39, 0.22));
  }

  /* ── Desktop Default (>= 1025px, e.g. 1440px) ── */
  .henna-border-left {
    left: 0;
    width: clamp(90px, 10vw, 180px);
  }

  .henna-border-right {
    right: 0;
    width: clamp(90px, 10vw, 180px);
  }

  /* ── Tablet (641px - 1024px, e.g. 820px) ── */
  @media (max-width: 1024px) {
    .henna-border-side {
      opacity: 0.58;
    }
    .henna-border-left,
    .henna-border-right {
      width: clamp(75px, 9vw, 120px);
    }
  }

  /* ── Mobile (<= 640px, e.g. 390px) ── */
  @media (max-width: 640px) {
    .henna-border-side {
      opacity: 0.42;
    }
    .henna-border-left,
    .henna-border-right {
      width: clamp(60px, 14vw, 85px);
    }
  }

  /* ── Dark Mode ── */
  :global([data-theme="dark"]) .henna-border-side {
    opacity: 0.55;
    filter: drop-shadow(0 0 10px rgba(244, 208, 135, 0.25));
  }

  @media (max-width: 640px) {
    :global([data-theme="dark"]) .henna-border-side {
      opacity: 0.38;
    }
  }

  /* ── SVG Stroke-Draw Animation (Pen draw along path, exactly like HennaDraw) ── */
  .henna-path {
    stroke-dasharray: 260;
    stroke-dashoffset: 260;
    transition: stroke-dashoffset 2s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .henna-path.vine-stem {
    stroke-dasharray: 1400;
    stroke-dashoffset: 1400;
    transition: stroke-dashoffset 2.4s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .henna-dot {
    opacity: 0;
    transform: scale(0.5);
    transition: opacity 1.2s ease 1s, transform 1.2s cubic-bezier(0.34, 1.56, 0.64, 1) 1s;
    transform-origin: center;
  }

  /* On is-drawn: lines draw themselves smoothly from top to bottom */
  .henna-borders-layer.is-drawn .henna-path {
    stroke-dashoffset: 0;
  }

  .henna-borders-layer.is-drawn .henna-dot {
    opacity: 1;
    transform: scale(1);
  }

  /* ── Prefers-reduced-motion: fully static ── */
  @media (prefers-reduced-motion: reduce) {
    .henna-path {
      stroke-dashoffset: 0 !important;
      transition: none !important;
    }
    .henna-dot {
      opacity: 1 !important;
      transform: scale(1) !important;
      transition: none !important;
    }
  }
</style>

<script>
  (() => {
    const bordersLayer = document.querySelector('[data-henna-borders]');
    if (!bordersLayer) return;

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      bordersLayer.classList.add('is-drawn');
      return;
    }

    // Trigger stroke draw-in once when borders layer mounts/enters view
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            bordersLayer.classList.add('is-drawn');
            observer.disconnect();
          }
        });
      },
      { threshold: 0.1 }
    );

    observer.observe(bordersLayer);
  })();
</script>
