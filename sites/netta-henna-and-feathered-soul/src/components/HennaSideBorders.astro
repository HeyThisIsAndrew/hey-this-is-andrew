---
/**
 * HennaSideBorders.astro
 * Meticulous original SVG henna (mehndi) side tapestries (left and right mirrored).
 * Uses HennaBorderDraw.astro and the exact HennaDraw.astro pen-stroke draw technique:
 * - SVG paths with stroke-dasharray and stroke-dashoffset (no PNGs, no clip-path slices).
 * - Dots fade and scale in (opacity 0 -> 1, scale 0.5 -> 1, 1.2s ease 1s).
 * - Triggered once via IntersectionObserver (threshold: 0.2) adding .is-drawn.
 * - Full prefers-reduced-motion static support.
 */
import HennaBorderDraw from './HennaBorderDraw.astro';
---

<div class="henna-sides-layer" aria-hidden="true" data-henna-side-draw>
  <div class="henna-side-panel henna-side-left" data-side-left>
    <HennaBorderDraw side="left" />
  </div>
  <div class="henna-side-panel henna-side-right" data-side-right>
    <HennaBorderDraw side="right" />
  </div>
</div>

<style>
  .henna-sides-layer {
    position: fixed;
    inset: 0;
    pointer-events: none !important;
    overflow: hidden;
    z-index: 0;
  }

  .henna-side-panel {
    position: absolute;
    top: 0;
    bottom: 0;
    height: 100vh;
    pointer-events: none !important;
    opacity: 0.75;
    transition: opacity 0.4s ease;
  }

  .henna-side-panel :global(.henna-art-svg) {
    display: block;
    width: 100%;
    height: 100%;
    pointer-events: none !important;
    filter: drop-shadow(0 2px 6px rgba(197, 155, 39, 0.2));
  }

  /* Desktop (>= 1025px, e.g. 1440px) */
  .henna-side-left {
    left: 0;
    width: clamp(90px, 10vw, 180px);
  }

  .henna-side-right {
    right: 0;
    width: clamp(90px, 10vw, 180px);
  }

  /* Tablet / iPad (641px - 1024px, e.g. 820px) */
  @media (max-width: 1024px) {
    .henna-side-panel {
      opacity: 0.58;
    }
    .henna-side-left,
    .henna-side-right {
      width: clamp(75px, 9vw, 120px);
    }
  }

  /* Mobile (<= 640px, e.g. 390px) */
  @media (max-width: 640px) {
    .henna-side-panel {
      opacity: 0.42;
    }
    .henna-side-left,
    .henna-side-right {
      width: clamp(60px, 14vw, 85px);
    }
  }

  /* Dark Mode */
  :global([data-theme="dark"]) .henna-side-panel {
    opacity: 0.55;
    filter: drop-shadow(0 0 10px rgba(244, 208, 135, 0.25));
  }

  @media (max-width: 640px) {
    :global([data-theme="dark"]) .henna-side-panel {
      opacity: 0.4;
    }
  }

  /* SVG Stroke-Draw Animation (exact HennaDraw.astro technique) */
  .henna-sides-layer :global(.henna-path) {
    stroke-dasharray: 320;
    stroke-dashoffset: 320;
    transition: stroke-dashoffset 2s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .henna-sides-layer :global(.henna-dot) {
    opacity: 0;
    transform: scale(0.5);
    transition: opacity 1.2s ease 1s, transform 1.2s cubic-bezier(0.34, 1.56, 0.64, 1) 1s;
    transform-box: fill-box;
    transform-origin: center;
  }

  .henna-sides-layer.is-drawn :global(.henna-path) {
    stroke-dashoffset: 0;
  }

  .henna-sides-layer.is-drawn :global(.henna-dot) {
    opacity: 1;
    transform: scale(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .henna-sides-layer :global(.henna-path) {
      stroke-dashoffset: 0 !important;
      transition: none !important;
    }
    .henna-sides-layer :global(.henna-dot) {
      opacity: 1 !important;
      transform: scale(1) !important;
      transition: none !important;
    }
  }
</style>

<script>
  function setupHennaSideDraw() {
    const elements = document.querySelectorAll<HTMLElement>('[data-henna-side-draw]');
    if (!elements.length) return;

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      elements.forEach((el) => el.classList.add('is-drawn'));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-drawn');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.2 }
    );

    elements.forEach((el) => observer.observe(el));
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupHennaSideDraw, { once: true });
  } else {
    setupHennaSideDraw();
  }
  document.addEventListener('astro:page-load', setupHennaSideDraw);
</script>
