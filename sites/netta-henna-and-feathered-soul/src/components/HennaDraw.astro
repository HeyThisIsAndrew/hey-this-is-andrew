---
/**
 * HennaDraw.astro
 * Delicate SVG henna mandala and flourish pattern that draws itself on scroll.
 * Accessible with full prefers-reduced-motion support.
 */
---

<div class="henna-draw-wrapper" data-henna-draw aria-hidden="true">
  <svg class="henna-svg" viewBox="0 0 400 120" fill="none" xmlns="http://www.w3.org/2000/svg">
    <!-- Center Crescent Moon -->
    <path class="henna-path" d="M200 35 C190 35, 185 45, 185 55 C185 68, 195 78, 208 78 C202 78, 194 72, 194 62 C194 50, 202 42, 212 40 C208 36, 204 35, 200 35 Z" stroke="currentColor" stroke-width="1.6" />
    
    <!-- Central Lotus Petals -->
    <path class="henna-path" d="M200 20 C190 38, 190 55, 200 70 C210 55, 210 38, 200 20 Z" stroke="currentColor" stroke-width="1.6" />
    <path class="henna-path" d="M190 30 C175 42, 175 58, 192 68 C188 56, 188 42, 190 30 Z" stroke="currentColor" stroke-width="1.5" />
    <path class="henna-path" d="M210 30 C225 42, 225 58, 208 68 C212 56, 212 42, 210 30 Z" stroke="currentColor" stroke-width="1.5" />
    <circle class="henna-dot" cx="200" cy="12" r="3" fill="currentColor" />
    <circle class="henna-dot" cx="200" cy="80" r="2.5" fill="currentColor" />

    <!-- Left Flourish Vine & Paisley -->
    <path class="henna-path" d="M180 60 C150 60, 130 45, 110 55 C90 65, 80 50, 60 55 C40 60, 30 50, 10 55" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
    <path class="henna-path" d="M140 52 C135 40, 145 35, 150 42 C152 48, 146 54, 140 52 Z" stroke="currentColor" stroke-width="1.4" />
    <path class="henna-path" d="M100 58 C95 48, 105 42, 110 48 C112 52, 106 58, 100 58 Z" stroke="currentColor" stroke-width="1.4" />
    <path class="henna-path" d="M60 55 C55 45, 65 40, 70 46 C72 50, 66 56, 60 55 Z" stroke="currentColor" stroke-width="1.4" />
    <circle class="henna-dot" cx="130" cy="40" r="2" fill="currentColor" />
    <circle class="henna-dot" cx="90" cy="45" r="2" fill="currentColor" />
    <circle class="henna-dot" cx="50" cy="48" r="2" fill="currentColor" />

    <!-- Right Flourish Vine & Paisley -->
    <path class="henna-path" d="M220 60 C250 60, 270 45, 290 55 C310 65, 320 50, 340 55 C360 60, 370 50, 390 55" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
    <path class="henna-path" d="M260 52 C265 40, 255 35, 250 42 C248 48, 254 54, 260 52 Z" stroke="currentColor" stroke-width="1.4" />
    <path class="henna-path" d="M300 58 C305 48, 295 42, 290 48 C288 52, 294 58, 300 58 Z" stroke="currentColor" stroke-width="1.4" />
    <path class="henna-path" d="M340 55 C345 45, 335 40, 330 46 C328 50, 334 56, 340 55 Z" stroke="currentColor" stroke-width="1.4" />
    <circle class="henna-dot" cx="270" cy="40" r="2" fill="currentColor" />
    <circle class="henna-dot" cx="310" cy="45" r="2" fill="currentColor" />
    <circle class="henna-dot" cx="350" cy="48" r="2" fill="currentColor" />
  </svg>
</div>

<style>
  .henna-draw-wrapper {
    width: 100%;
    max-width: 480px;
    margin: 2rem auto;
    display: flex;
    justify-content: center;
    color: var(--brand-gold);
    overflow: hidden;
  }

  .henna-svg {
    width: 100%;
    height: auto;
    filter: drop-shadow(0 2px 6px rgba(197, 155, 39, 0.2));
  }

  .henna-path {
    stroke-dasharray: 200;
    stroke-dashoffset: 200;
    transition: stroke-dashoffset 2s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .henna-dot {
    opacity: 0;
    transform: scale(0.5);
    transition: opacity 1.2s ease 1s, transform 1.2s cubic-bezier(0.34, 1.56, 0.64, 1) 1s;
    transform-origin: center;
  }

  .henna-draw-wrapper.is-drawn .henna-path {
    stroke-dashoffset: 0;
  }

  .henna-draw-wrapper.is-drawn .henna-dot {
    opacity: 1;
    transform: scale(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .henna-path {
      stroke-dashoffset: 0 !important;
      transition: none !important;
    }
    .henna-dot {
      opacity: 1 !important;
      transform: scale(1) !important;
      transition: none !important;
    }
  }
</style>

<script>
  function setupHennaDraw() {
    const elements = document.querySelectorAll<HTMLElement>('[data-henna-draw]');
    if (!elements.length) return;

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      elements.forEach(el => el.classList.add('is-drawn'));
      return;
    }

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-drawn');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.2 });

    elements.forEach(el => observer.observe(el));
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupHennaDraw, { once: true });
  } else {
    setupHennaDraw();
  }
  document.addEventListener('astro:page-load', setupHennaDraw);
</script>
