---
/**
 * FeatherParallax.astro
 * Organic feather parallax incorporating the vibrant turquoise blue feather
 * directly from Netta's logo, alongside warm gold and natural brown feathers.
 * Now visible for the entire scroll of the site.
 * Respects prefers-reduced-motion. Pointer events none, zero legibility impact.
 */
import featherBlueSvg from '../assets/feather-blue.svg?raw';
import featherGoldSvg from '../assets/feather.svg?raw';
import featherBrownSvg from '../assets/feather-2.svg?raw';
---

<div class="feather-layer" aria-hidden="true" data-feather-layer>
  <!-- Feather 1: Upper right (Turquoise Teal Blue from Logo) -->
  <div class="feather-item feather-one" data-feather="1">
    <Fragment set:html={featherBlueSvg} />
  </div>

  <!-- Feather 2: Mid-left (Warm Antique Gold & Bronze) -->
  <div class="feather-item feather-two" data-feather="2">
    <Fragment set:html={featherGoldSvg} />
  </div>

  <!-- Feather 3: Lower right (Natural Warm Brown Grizzly Hair Feather) -->
  <div class="feather-item feather-three" data-feather="3">
    <Fragment set:html={featherBrownSvg} />
  </div>

  <!-- Feather 4: Lower left (Subtle Turquoise Accent) -->
  <div class="feather-item feather-four" data-feather="4">
    <Fragment set:html={featherBlueSvg} />
  </div>
</div>

<style>
  .feather-layer {
    position: fixed;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    z-index: 0;
  }

  .feather-item {
    position: absolute;
    will-change: transform, opacity;
    filter: drop-shadow(0 12px 24px rgba(61, 40, 23, 0.1));
  }

  :global([data-theme="dark"]) .feather-item {
    filter: drop-shadow(0 14px 28px rgba(0, 0, 0, 0.5));
  }

  .feather-item :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Feather 1: Turquoise Blue (Top right) */
  .feather-one {
    top: 6vh;
    right: clamp(10px, 3.5vw, 60px);
    width: clamp(180px, 17vw, 250px);
    opacity: 0.75;
    transform: rotate(16deg);
  }

  /* Feather 2: Warm Gold (Mid-left) */
  .feather-two {
    top: 38vh;
    left: clamp(10px, 2.5vw, 40px);
    width: clamp(170px, 15vw, 220px);
    opacity: 0.7;
    transform: rotate(-18deg);
  }

  /* Feather 3: Warm Brown Grizzly (Mid-right) */
  .feather-three {
    top: 65vh;
    right: clamp(15px, 4vw, 70px);
    width: clamp(160px, 14vw, 210px);
    opacity: 0.65;
    transform: rotate(12deg);
  }

  /* Feather 4: Soft Turquoise (Mid-low left, well above footer) */
  .feather-four {
    top: 66vh;
    left: clamp(10px, 2.5vw, 40px);
    width: clamp(100px, 9vw, 140px);
    opacity: 0.45;
    transform: rotate(-24deg);
  }

  @media (max-width: 640px) {
    .feather-one {
      top: 2vh;
      right: -25px;
      width: 120px;
      opacity: 0.7;
    }

    .feather-two {
      top: 42vh;
      left: -20px;
      width: 115px;
      opacity: 0.65;
    }

    .feather-three {
      top: 70vh;
      right: -20px;
      width: 110px;
      opacity: 0.6;
    }

    .feather-four {
      top: 68vh;
      left: -20px;
      width: 85px;
      opacity: 0.4;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .feather-item {
      transform: none !important;
      opacity: 0.6 !important;
      will-change: auto !important;
    }
  }
</style>

<script>
  function initFeatherParallax() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      return;
    }

    const feather1 = document.querySelector('[data-feather="1"]') as HTMLElement | null;
    const feather2 = document.querySelector('[data-feather="2"]') as HTMLElement | null;
    const feather3 = document.querySelector('[data-feather="3"]') as HTMLElement | null;
    const feather4 = document.querySelector('[data-feather="4"]') as HTMLElement | null;
    if (!feather1 && !feather2 && !feather3 && !feather4) return;

    let ticking = false;

    function update() {
      const scrollY = window.scrollY || window.pageYOffset;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const progress = docHeight > 0 ? Math.min(1, Math.max(0, scrollY / docHeight)) : 0;

      // Gentle floating cycle across the entire document scroll
      if (feather1) {
        const y = progress * 160;
        const x = Math.sin(progress * Math.PI) * -25;
        const rot = 16 + progress * 12;
        feather1.style.transform = `translate3d(${x}px, ${y}px, 0) rotate(${rot}deg)`;
      }

      if (feather2) {
        const y = progress * -120;
        const x = Math.sin(progress * Math.PI) * 30;
        const rot = -18 + progress * 14;
        feather2.style.transform = `translate3d(${x}px, ${y}px, 0) rotate(${rot}deg)`;
      }

      if (feather3) {
        const y = progress * 140;
        const x = Math.cos(progress * Math.PI) * -20;
        const rot = 12 + progress * 10;
        feather3.style.transform = `translate3d(${x}px, ${y}px, 0) rotate(${rot}deg)`;
      }

      if (feather4) {
        const y = progress * -100;
        const x = Math.sin(progress * Math.PI) * -25;
        const rot = -24 + progress * 16;
        feather4.style.transform = `translate3d(${x}px, ${y}px, 0) rotate(${rot}deg)`;
      }

      ticking = false;
    }

    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          window.requestAnimationFrame(update);
          ticking = true;
        }
      },
      { passive: true }
    );

    update();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFeatherParallax, { once: true });
  } else {
    initFeatherParallax();
  }
  document.addEventListener('astro:page-load', initFeatherParallax);
</script>
