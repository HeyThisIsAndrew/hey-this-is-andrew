---
/**
 * FeatherParallax.astro
 * Organic feather parallax incorporating the vibrant turquoise blue feather
 * directly from Netta's logo, alongside warm gold and natural brown feathers.
 * Visible and active across mobile (390px), iPad (820px), and desktop (1440px).
 * Responsive widths, high visibility (0.5 to 0.8 opacity), dynamic travel (>= 300px),
 * and full prefers-reduced-motion support. Pointer events none, zero legibility impact.
 */
import featherBlueSvg from '../assets/feather-blue.svg?raw';
import featherGoldSvg from '../assets/feather.svg?raw';
import featherBrownSvg from '../assets/feather-2.svg?raw';
---

<div class="feather-layer" aria-hidden="true" data-feather-layer>
  <!-- Feather 1: Upper right (Turquoise Teal Blue from Logo) -->
  <div class="feather-item feather-one" data-feather="1">
    <Fragment set:html={featherBlueSvg} />
  </div>

  <!-- Feather 2: Mid-left (Warm Antique Gold & Bronze) -->
  <div class="feather-item feather-two" data-feather="2">
    <Fragment set:html={featherGoldSvg} />
  </div>

  <!-- Feather 3: Lower right (Natural Warm Brown Grizzly Hair Feather) -->
  <div class="feather-item feather-three" data-feather="3">
    <Fragment set:html={featherBrownSvg} />
  </div>

  <!-- Feather 4: Lower left (Subtle Turquoise Accent) -->
  <div class="feather-item feather-four" data-feather="4">
    <Fragment set:html={featherBlueSvg} />
  </div>
</div>

<style>
  .feather-layer {
    position: fixed;
    inset: 0;
    pointer-events: none !important;
    overflow: hidden;
    z-index: 0;
  }

  .feather-item {
    position: absolute;
    pointer-events: none !important;
    filter: drop-shadow(0 12px 24px rgba(61, 40, 23, 0.12));
  }

  /* Promote only during an active scroll. Keeping this hint permanently would
     spend compositor memory while the page is idle. */
  .feather-layer.is-parallaxing .feather-item {
    will-change: transform;
  }

  :global([data-theme="dark"]) .feather-item {
    filter: drop-shadow(0 14px 28px rgba(0, 0, 0, 0.55));
  }

  .feather-item :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* ── Desktop Default (>= 1025px, e.g. 1440px) ── */
  /* Width clamp 140px to 190px, opacity 0.6 to 0.8 */
  .feather-one {
    top: 6vh;
    right: clamp(16px, 3.5vw, 60px);
    width: clamp(140px, 12vw, 190px);
    opacity: 0.75;
    transform: rotate(16deg);
  }

  .feather-two {
    top: 32vh;
    left: clamp(16px, 2.5vw, 40px);
    width: clamp(130px, 11vw, 175px);
    opacity: 0.72;
    transform: rotate(-18deg);
  }

  .feather-three {
    top: 55vh;
    right: clamp(16px, 3.5vw, 60px);
    width: clamp(125px, 11vw, 165px);
    opacity: 0.72;
    transform: rotate(12deg);
  }

  .feather-four {
    top: 72vh;
    left: clamp(16px, 2.5vw, 40px);
    width: clamp(115px, 9vw, 145px);
    opacity: 0.68;
    transform: rotate(-24deg);
  }

  /* ── iPad Tablet (641px - 1024px, e.g. 820px) ── */
  /* Width clamp 120px to 160px, opacity 0.6 to 0.7 */
  @media (max-width: 1024px) {
    .feather-one {
      top: 5vh;
      right: clamp(12px, 3vw, 36px);
      width: clamp(120px, 15vw, 160px);
      opacity: 0.68;
    }
    .feather-two {
      top: 30vh;
      left: clamp(12px, 2.5vw, 30px);
      width: clamp(115px, 14vw, 150px);
      opacity: 0.65;
    }
    .feather-three {
      top: 52vh;
      right: clamp(12px, 3vw, 36px);
      width: clamp(110px, 13vw, 145px);
      opacity: 0.66;
    }
    .feather-four {
      top: 70vh;
      left: clamp(12px, 2.5vw, 30px);
      width: clamp(100px, 12vw, 135px);
      opacity: 0.62;
    }
  }

  /* ── Mobile Phone (<= 640px, e.g. 390px) ── */
  /* Width clamp 90px to 130px, opacity 0.5 to 0.6 */
  @media (max-width: 640px) {
    .feather-one {
      top: 4vh;
      right: 6px;
      width: clamp(90px, 26vw, 125px);
      opacity: 0.58;
    }
    .feather-two {
      top: 28vh;
      left: 6px;
      width: clamp(85px, 24vw, 115px);
      opacity: 0.55;
    }
    .feather-three {
      top: 52vh;
      right: 6px;
      width: clamp(85px, 24vw, 115px);
      opacity: 0.56;
    }
    .feather-four {
      top: 70vh;
      left: 6px;
      width: clamp(80px, 22vw, 110px);
      opacity: 0.52;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .feather-item {
      will-change: auto !important;
    }
  }
</style>

<script>
  function initFeatherParallax() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      return;
    }

    const layer = document.querySelector('[data-feather-layer]') as HTMLElement | null;
    const feather1 = document.querySelector('[data-feather="1"]') as HTMLElement | null;
    const feather2 = document.querySelector('[data-feather="2"]') as HTMLElement | null;
    const feather3 = document.querySelector('[data-feather="3"]') as HTMLElement | null;
    const feather4 = document.querySelector('[data-feather="4"]') as HTMLElement | null;
    if (!layer || (!feather1 && !feather2 && !feather3 && !feather4)) return;
    const featherLayer = layer;

    // Astro can fire astro:page-load after the first document load. Do not add
    // another scroll listener to the same fixed feather layer.
    if (featherLayer.dataset.parallaxReady === 'true') return;
    featherLayer.dataset.parallaxReady = 'true';

    let ticking = false;
    let restingTimer: number | undefined;
    let maxScroll = 1;

    function measureScrollRange() {
      // Measure only at setup and resize, never in the animation frame.
      maxScroll = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
    }

    function setScrollingState() {
      featherLayer.classList.add('is-parallaxing');
      if (restingTimer) window.clearTimeout(restingTimer);
      restingTimer = window.setTimeout(() => {
        featherLayer.classList.remove('is-parallaxing');
      }, 140);
    }

    function update() {
      const scrollY = window.scrollY || window.pageYOffset;
      const progress = Math.min(1, Math.max(0, scrollY / maxScroll));

      // Each feather travels >= 300px over the full page scroll at distinct speeds
      // Feathers 1 & 3 move downwards; Feathers 2 & 4 move upwards (separating continuously)
      if (feather1) {
        const y1 = progress * 380; // 380px travel down
        const x1 = Math.sin(progress * Math.PI) * -30;
        const rot1 = 16 + progress * 12;
        feather1.style.transform = `translateY(${y1}px) translateX(${x1}px) rotate(${rot1}deg)`;
      }

      if (feather2) {
        const y2 = progress * -320; // 320px travel up
        const x2 = Math.sin(progress * Math.PI) * 28;
        const rot2 = -18 + progress * 14;
        feather2.style.transform = `translateY(${y2}px) translateX(${x2}px) rotate(${rot2}deg)`;
      }

      if (feather3) {
        const y3 = progress * 350; // 350px travel down
        const x3 = Math.cos(progress * Math.PI) * -25;
        const rot3 = 12 + progress * 10;
        feather3.style.transform = `translateY(${y3}px) translateX(${x3}px) rotate(${rot3}deg)`;
      }

      if (feather4) {
        const y4 = progress * -330; // 330px travel up
        const x4 = Math.sin(progress * Math.PI) * -28;
        const rot4 = -24 + progress * 14;
        feather4.style.transform = `translateY(${y4}px) translateX(${x4}px) rotate(${rot4}deg)`;
      }

      ticking = false;
    }

    function onScroll() {
      setScrollingState();
      if (!ticking) {
        window.requestAnimationFrame(update);
        ticking = true;
      }
    }

    measureScrollRange();
    window.addEventListener('resize', measureScrollRange, { passive: true });
    window.addEventListener('scroll', onScroll, { passive: true });
    update();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFeatherParallax, { once: true });
  } else {
    initFeatherParallax();
  }
  document.addEventListener('astro:page-load', initFeatherParallax);
</script>
