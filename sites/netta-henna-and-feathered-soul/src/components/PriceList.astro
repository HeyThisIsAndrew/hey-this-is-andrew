---
/**
 * PriceList.astro
 * Netta Henna and Feathered Soul - Official Price List
 * Styled in ornate boho gold frame with horizontal scrollwork, cabochon turquoise gems,
 * soft watercolor teal brushstroke category banners, and gold parchment fee ribbons.
 * Every pricing pill is a real selectable button that opens the booking modal with that service and option pre-selected.
 * Prices are exact per Netta's price list (no invented numbers, zero em dashes).
 */
import { SITE } from '../data/site';
---

<section class="price-list-section" id="price-list" data-sec aria-labelledby="price-list-heading">
  <div class="container price-container">
    <div class="price-frame">
      <!-- Ornate Mandala & Cabochon Turquoise Gem Corner Accents -->
      <div class="corner-filigree top-left" aria-hidden="true">
        <svg viewBox="0 0 72 72" width="64" height="64" fill="none">
          <path d="M4 68 C4 22, 22 4, 68 4 M12 68 C12 30, 30 12, 68 12 M20 68 C20 38, 38 20, 68 20" stroke="currentColor" stroke-width="1.5" opacity="0.75"/>
          <path d="M4 4 L32 4 L4 32 Z" fill="currentColor" opacity="0.22"/>
          <circle cx="18" cy="18" r="5.5" fill="#1a999d" stroke="currentColor" stroke-width="1.5"/>
          <circle cx="16.5" cy="16.5" r="1.8" fill="#a8f0f2" opacity="0.85"/>
          <circle cx="32" cy="11" r="2.2" fill="#1a999d" opacity="0.9"/>
          <circle cx="11" cy="32" r="2.2" fill="#1a999d" opacity="0.9"/>
        </svg>
      </div>
      <div class="corner-filigree top-right" aria-hidden="true">
        <svg viewBox="0 0 72 72" width="64" height="64" fill="none">
          <path d="M68 68 C68 22, 50 4, 4 4 M60 68 C60 30, 42 12, 4 12 M52 68 C52 38, 34 20, 4 20" stroke="currentColor" stroke-width="1.5" opacity="0.75"/>
          <path d="M68 4 L40 4 L68 32 Z" fill="currentColor" opacity="0.22"/>
          <circle cx="54" cy="18" r="5.5" fill="#1a999d" stroke="currentColor" stroke-width="1.5"/>
          <circle cx="52.5" cy="16.5" r="1.8" fill="#a8f0f2" opacity="0.85"/>
          <circle cx="40" cy="11" r="2.2" fill="#1a999d" opacity="0.9"/>
          <circle cx="61" cy="32" r="2.2" fill="#1a999d" opacity="0.9"/>
        </svg>
      </div>

      <div class="price-header text-center">
        <!-- Flyer-Style Horizontal Gold Scrollwork + Cabochon Turquoise Gems Flanking "Price List" -->
        <div class="price-title-banner">
          <svg class="scroll-wing left-wing" viewBox="0 0 140 44" width="130" height="40" fill="none" aria-hidden="true">
            <path d="M4 22 C24 8, 52 8, 72 22 C88 33, 108 30, 134 22" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            <path d="M18 22 C34 34, 56 34, 72 22 C86 12, 106 14, 126 22" stroke="currentColor" stroke-width="1.3" opacity="0.75"/>
            <circle cx="96" cy="22" r="7.5" fill="#1a999d" stroke="currentColor" stroke-width="2"/>
            <circle cx="94" cy="19.5" r="2.3" fill="#b8f5f7" opacity="0.9"/>
            <circle cx="78" cy="22" r="2.2" fill="currentColor"/>
            <circle cx="114" cy="22" r="2.2" fill="currentColor"/>
          </svg>

          <h2 class="price-title gold-script-text" id="price-list-heading">Price List</h2>

          <svg class="scroll-wing right-wing" viewBox="0 0 140 44" width="130" height="40" fill="none" aria-hidden="true">
            <path d="M136 22 C116 8, 88 8, 68 22 C52 33, 32 30, 6 22" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            <path d="M122 22 C106 34, 84 34, 68 22 C54 12, 34 14, 14 22" stroke="currentColor" stroke-width="1.3" opacity="0.75"/>
            <circle cx="44" cy="22" r="7.5" fill="#1a999d" stroke="currentColor" stroke-width="2"/>
            <circle cx="42" cy="19.5" r="2.3" fill="#b8f5f7" opacity="0.9"/>
            <circle cx="62" cy="22" r="2.2" fill="currentColor"/>
            <circle cx="26" cy="22" r="2.2" fill="currentColor"/>
          </svg>
        </div>

        <p class="price-subtitle">Crafted with natural ingredients and organic care in Santa Barbara</p>
        <p class="price-tap-hint">Tap any option below to select and book</p>
        <div class="brush-badge-wrap">
          <a href="#booking" class="teal-brush-banner" data-open-booking-btn>
            DM to Book ✨
          </a>
        </div>
      </div>

      <!-- Price Category 1: Henna Tattoos -->
      <div class="price-category">
        <div class="cat-watercolor-banner">
          <h3 class="cat-script-title">Henna Tattoos</h3>
        </div>
        <p class="cat-desc">Hand-drawn with all-natural, freshly mixed organic henna paste.</p>

        <div class="price-tier-list" role="group" aria-label="Henna Tattoos pricing options">
          <button
            type="button"
            class="price-pill-btn price-tier-btn"
            data-select-service="Henna Art"
            data-select-option="Small / Simple ($20 to $45)"
            aria-pressed="false"
          >
            <span class="tier-centered-line">
              <span class="pill-check" aria-hidden="true">✓</span>
              <span class="tier-name">Small / Simple Designs</span>
              <span class="tier-sep" aria-hidden="true">·</span>
              <span class="tier-price">$20 to $45</span>
            </span>
            <span class="tier-note">(delicate, minimal, or smaller pieces)</span>
          </button>

          <div class="diamond-divider" aria-hidden="true"><span>✦</span></div>

          <button
            type="button"
            class="price-pill-btn price-tier-btn"
            data-select-service="Henna Art"
            data-select-option="Medium ($50 to $75)"
            aria-pressed="false"
          >
            <span class="tier-centered-line">
              <span class="pill-check" aria-hidden="true">✓</span>
              <span class="tier-name">Medium Designs</span>
              <span class="tier-sep" aria-hidden="true">·</span>
              <span class="tier-price">$50 to $75</span>
            </span>
            <span class="tier-note">(hand, wrist to hand, or more detailed designs including full hand)</span>
          </button>

          <div class="diamond-divider" aria-hidden="true"><span>✦</span></div>

          <button
            type="button"
            class="price-pill-btn price-tier-btn"
            data-select-service="Henna Art"
            data-select-option="Large ($100+)"
            aria-pressed="false"
          >
            <span class="tier-centered-line">
              <span class="pill-check" aria-hidden="true">✓</span>
              <span class="tier-name">Large Pieces</span>
              <span class="tier-sep" aria-hidden="true">·</span>
              <span class="tier-price">$100+</span>
            </span>
            <span class="tier-note">(elaborate, custom, or extended designs)</span>
          </button>

          <button
            type="button"
            class="price-pill-btn gold-parchment-ribbon glitter-bonus-pill"
            data-select-service="Henna Art"
            data-select-option="Add Glitter (FREE)"
            aria-pressed="false"
          >
            <span class="pill-check" aria-hidden="true">✓</span>
            <span class="glitter-star" aria-hidden="true">✦</span>
            <span class="ribbon-script-text">Add a Touch of Glitter · <strong>FREE!</strong></span>
            <span class="glitter-star" aria-hidden="true">✦</span>
          </button>
        </div>
      </div>

      <div class="section-ornament" aria-hidden="true">
        <span class="ornament-line"></span>
        <span class="ornament-gem">✦ <span class="turquoise-gem">❖</span> ✦</span>
        <span class="ornament-line"></span>
      </div>

      <!-- Price Category 2: Hair Feather Extensions -->
      <div class="price-category">
        <div class="cat-watercolor-banner">
          <h3 class="cat-script-title">Hair Feather Extensions</h3>
        </div>
        <p class="cat-desc">Cruelty-free, premium natural feathers installed with gentle silicone-lined beads.</p>

        <div class="price-grid-rates" role="group" aria-label="Hair Feather Extensions pricing options">
          <button
            type="button"
            class="price-pill-btn rate-card"
            data-select-service="Hair Feather Extensions"
            data-select-option="1 Feather ($10)"
            aria-pressed="false"
          >
            <span class="rate-top-row">
              <span class="pill-check" aria-hidden="true">✓</span>
              <span class="rate-count">1 Feather</span>
            </span>
            <span class="rate-cost">$10</span>
          </button>
          <button
            type="button"
            class="price-pill-btn rate-card"
            data-select-service="Hair Feather Extensions"
            data-select-option="2 Feathers ($18)"
            aria-pressed="false"
          >
            <span class="rate-top-row">
              <span class="pill-check" aria-hidden="true">✓</span>
              <span class="rate-count">2 Feathers</span>
            </span>
            <span class="rate-cost">$18</span>
          </button>
          <button
            type="button"
            class="price-pill-btn rate-card"
            data-select-service="Hair Feather Extensions"
            data-select-option="3 Feathers ($25)"
            aria-pressed="false"
          >
            <span class="rate-top-row">
              <span class="pill-check" aria-hidden="true">✓</span>
              <span class="rate-count">3 Feathers</span>
            </span>
            <span class="rate-cost">$25</span>
          </button>
          <button
            type="button"
            class="price-pill-btn rate-card"
            data-select-service="Hair Feather Extensions"
            data-select-option="5 Feathers ($35)"
            aria-pressed="false"
          >
            <span class="rate-top-row">
              <span class="pill-check" aria-hidden="true">✓</span>
              <span class="rate-count">5 Feathers</span>
            </span>
            <span class="rate-cost">$35</span>
          </button>
          <button
            type="button"
            class="price-pill-btn rate-card"
            data-select-service="Hair Feather Extensions"
            data-select-option="10 Feathers ($60)"
            aria-pressed="false"
          >
            <span class="rate-top-row">
              <span class="pill-check" aria-hidden="true">✓</span>
              <span class="rate-count">10 Feathers</span>
            </span>
            <span class="rate-cost">$60</span>
          </button>
        </div>
        <div class="install-fee-ribbon">
          <span>Installation Fee · <strong>$10</strong></span>
        </div>
      </div>

      <div class="section-ornament" aria-hidden="true">
        <span class="ornament-line"></span>
        <span class="ornament-gem">✦ <span class="turquoise-gem">❖</span> ✦</span>
        <span class="ornament-line"></span>
      </div>

      <!-- Price Category 3: Hair Tinsel Extensions -->
      <div class="price-category">
        <div class="cat-watercolor-banner">
          <h3 class="cat-script-title">Hair Tinsel Extensions</h3>
        </div>
        <p class="cat-desc">Heat-resistant shimmer strands tied gently for multi-week sparkle.</p>

        <div class="price-grid-rates" role="group" aria-label="Hair Tinsel Extensions pricing options">
          <button
            type="button"
            class="price-pill-btn rate-card"
            data-select-service="Hair Tinsel Extensions"
            data-select-option="5 Strands ($10)"
            aria-pressed="false"
          >
            <span class="rate-top-row">
              <span class="pill-check" aria-hidden="true">✓</span>
              <span class="rate-count">5 Strands</span>
            </span>
            <span class="rate-cost">$10</span>
          </button>
          <button
            type="button"
            class="price-pill-btn rate-card"
            data-select-service="Hair Tinsel Extensions"
            data-select-option="10 Strands ($12)"
            aria-pressed="false"
          >
            <span class="rate-top-row">
              <span class="pill-check" aria-hidden="true">✓</span>
              <span class="rate-count">10 Strands</span>
            </span>
            <span class="rate-cost">$12</span>
          </button>
          <button
            type="button"
            class="price-pill-btn rate-card"
            data-select-service="Hair Tinsel Extensions"
            data-select-option="15 Strands ($15)"
            aria-pressed="false"
          >
            <span class="rate-top-row">
              <span class="pill-check" aria-hidden="true">✓</span>
              <span class="rate-count">15 Strands</span>
            </span>
            <span class="rate-cost">$15</span>
          </button>
          <button
            type="button"
            class="price-pill-btn rate-card"
            data-select-service="Hair Tinsel Extensions"
            data-select-option="20 Strands ($20)"
            aria-pressed="false"
          >
            <span class="rate-top-row">
              <span class="pill-check" aria-hidden="true">✓</span>
              <span class="rate-count">20 Strands</span>
            </span>
            <span class="rate-cost">$20</span>
          </button>
          <button
            type="button"
            class="price-pill-btn rate-card"
            data-select-service="Hair Tinsel Extensions"
            data-select-option="30 Strands ($30)"
            aria-pressed="false"
          >
            <span class="rate-top-row">
              <span class="pill-check" aria-hidden="true">✓</span>
              <span class="rate-count">30 Strands</span>
            </span>
            <span class="rate-cost">$30</span>
          </button>
        </div>
        <div class="install-fee-ribbon">
          <span>Installation Fee · <strong>$10</strong></span>
        </div>
      </div>

      <!-- Bottom Frame Actions -->
      <div class="price-action-wrap text-center">
        <p class="price-custom-note">Custom combinations and party bookings are available upon request.</p>
        <div class="action-buttons-row">
          <button type="button" class="btn btn-primary" data-open-booking-btn>
            Book a Date
          </button>
          <a
            href={SITE.instagramUrl}
            target="_blank"
            rel="noopener"
            class="btn-instagram"
            aria-label="Direct message Netta on Instagram"
            title="DM to Book @nettahennaandfeatheredsoul"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Ornate Mandala & Cabochon Turquoise Gem Corner Accents Bottom -->
      <div class="corner-filigree bottom-left" aria-hidden="true">
        <svg viewBox="0 0 72 72" width="64" height="64" fill="none">
          <path d="M4 4 C4 50, 22 68, 68 68 M12 4 C12 42, 30 60, 68 60 M20 4 C20 34, 38 52, 68 52" stroke="currentColor" stroke-width="1.5" opacity="0.75"/>
          <path d="M4 68 L32 68 L4 40 Z" fill="currentColor" opacity="0.22"/>
          <circle cx="18" cy="54" r="5.5" fill="#1a999d" stroke="currentColor" stroke-width="1.5"/>
          <circle cx="16.5" cy="52.5" r="1.8" fill="#a8f0f2" opacity="0.85"/>
          <circle cx="32" cy="61" r="2.2" fill="#1a999d" opacity="0.9"/>
          <circle cx="11" cy="40" r="2.2" fill="#1a999d" opacity="0.9"/>
        </svg>
      </div>
      <div class="corner-filigree bottom-right" aria-hidden="true">
        <svg viewBox="0 0 72 72" width="64" height="64" fill="none">
          <path d="M68 4 C68 50, 50 68, 4 68 M60 4 C60 42, 42 60, 4 60 M52 4 C52 34, 34 52, 4 52" stroke="currentColor" stroke-width="1.5" opacity="0.75"/>
          <path d="M68 68 L40 68 L68 40 Z" fill="currentColor" opacity="0.22"/>
          <circle cx="54" cy="54" r="5.5" fill="#1a999d" stroke="currentColor" stroke-width="1.5"/>
          <circle cx="52.5" cy="52.5" r="1.8" fill="#a8f0f2" opacity="0.85"/>
          <circle cx="40" cy="61" r="2.2" fill="#1a999d" opacity="0.9"/>
          <circle cx="61" cy="40" r="2.2" fill="#1a999d" opacity="0.9"/>
        </svg>
      </div>
    </div>
  </div>
</section>

<style>
  .price-list-section {
    padding: 4.5rem 1.5rem;
    position: relative;
    scroll-margin-top: 100px;
    text-align: center;
  }

  .price-container {
    max-width: 820px;
    margin: 0 auto;
  }

  .price-frame {
    position: relative;
    background: var(--surface);
    border: 2px solid var(--brand-gold);
    outline: 1.5px solid var(--brand-gold-border);
    outline-offset: 5px;
    border-radius: 28px;
    padding: 3.5rem 2.5rem;
    box-shadow: 0 16px 48px rgba(61, 40, 23, 0.1), inset 0 0 36px rgba(197, 155, 39, 0.08);
    text-align: center;
  }

  .corner-filigree {
    position: absolute;
    color: var(--brand-gold);
    pointer-events: none;
  }
  .corner-filigree.top-left { top: 10px; left: 10px; }
  .corner-filigree.top-right { top: 10px; right: 10px; }
  .corner-filigree.bottom-left { bottom: 10px; left: 10px; }
  .corner-filigree.bottom-right { bottom: 10px; right: 10px; }

  .price-header {
    text-align: center;
  }

  .price-title-banner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: 0.25rem;
    color: var(--brand-gold);
    overflow: visible;
  }

  .scroll-wing {
    flex-shrink: 1;
    max-width: 130px;
    height: auto;
    color: var(--brand-gold);
  }

  .price-title {
    font-size: clamp(3rem, 7vw, 4.3rem);
    margin: 0;
    line-height: 1.45 !important;
    padding-top: 0.25em !important;
    padding-bottom: 0.2em !important;
    overflow: visible !important;
    text-align: center;
    white-space: nowrap;
  }

  .price-subtitle {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 500;
    font-style: normal;
    line-height: 1.55;
    color: var(--ink);
    margin: 0 auto 0.5rem;
    max-width: 34ch;
    text-wrap: balance;
    text-align: center;
  }

  .price-tap-hint {
    font-family: var(--font-body);
    font-size: 0.92rem;
    color: var(--brand-teal);
    font-weight: 600;
    margin: 0 auto 1.25rem;
    letter-spacing: 0.02em;
    text-align: center;
  }

  .brush-badge-wrap {
    margin-bottom: 2.25rem;
    text-align: center;
  }

  .teal-brush-banner {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #1b8a8e, #136a6e);
    color: #ffffff !important;
    padding: 0.5rem 1.65rem;
    font-family: var(--font-section);
    font-style: italic;
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    border-radius: 255px 15px 225px 15px/15px 225px 15px 255px;
    box-shadow: 0 4px 14px rgba(26, 153, 157, 0.35);
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .teal-brush-banner:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(26, 153, 157, 0.5);
  }

  .price-category {
    margin: 2.25rem 0;
    text-align: center;
  }

  /* Soft Turquoise Watercolor Brushstroke Banner Behind Category Script Headings */
  .cat-watercolor-banner {
    display: inline-block;
    position: relative;
    padding: 0.1rem 2rem;
    margin: 0 auto 0.35rem;
    background:
      linear-gradient(90deg, transparent 0%, rgba(15, 104, 107, 0.14) 14%, rgba(15, 104, 107, 0.22) 50%, rgba(15, 104, 107, 0.14) 86%, transparent 100%);
    border-radius: 255px 25px 225px 25px / 25px 225px 25px 255px;
    text-align: center;
    overflow: visible;
  }

  :global([data-theme="dark"]) .cat-watercolor-banner {
    background:
      linear-gradient(90deg, transparent 0%, rgba(46, 196, 182, 0.2) 14%, rgba(46, 196, 182, 0.28) 50%, rgba(46, 196, 182, 0.2) 86%, transparent 100%);
  }

  .cat-script-title {
    font-family: var(--font-script, 'Great Vibes', cursive);
    font-size: clamp(2.1rem, 5vw, 2.65rem);
    font-weight: 400;
    color: var(--ink);
    margin: 0;
    line-height: 1.45 !important;
    padding-top: 0.25em !important;
    padding-bottom: 0.2em !important;
    overflow: visible !important;
    text-align: center;
  }

  .cat-desc {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 500;
    font-style: normal;
    line-height: 1.55;
    color: var(--ink);
    text-align: center;
    margin: 0 auto 1.35rem;
    max-width: 42ch;
    text-wrap: balance;
  }

  /* ── Interactive Selectable Pricing Pills (Neutral by default) ── */
  .price-pill-btn {
    appearance: none;
    -webkit-appearance: none;
    font-family: inherit;
    background: var(--surface);
    border: 1.5px solid var(--brand-gold-border);
    color: var(--ink);
    cursor: pointer;
    text-align: center;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
    box-sizing: border-box;
  }

  .price-pill-btn:hover {
    transform: translateY(-2px);
    border-color: var(--brand-gold);
    box-shadow: 0 6px 18px rgba(197, 155, 39, 0.16);
  }

  .price-pill-btn:focus-visible {
    outline: 2px solid var(--brand-teal);
    outline-offset: 2px;
  }

  .pill-check {
    display: none;
    align-items: center;
