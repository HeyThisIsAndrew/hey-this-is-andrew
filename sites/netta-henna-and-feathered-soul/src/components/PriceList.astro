---
/**
 * PriceList.astro
 * Netta Henna and Feathered Soul - Official Price List
 * Styled in ornate boho gold frame with mandala borders, turquoise gems, and diamond separators.
 * Every pricing pill is a real selectable button that opens the booking modal with that service and option pre-selected.
 * Prices are exact per Netta's price list (no invented numbers, zero em dashes).
 */
import { SITE } from '../data/site';
---

<section class="price-list-section" id="price-list" data-sec aria-labelledby="price-list-heading">
  <div class="container price-container">
    <div class="price-frame">
      <!-- Ornate Mandala & Turquoise Gem Corner Accents -->
      <div class="corner-filigree top-left" aria-hidden="true">
        <svg viewBox="0 0 60 60" width="60" height="60" fill="none">
          <path d="M4 56 C4 20, 20 4, 56 4 M12 56 C12 28, 28 12, 56 12 M20 56 C20 36, 36 20, 56 20" stroke="currentColor" stroke-width="1.4" opacity="0.65"/>
          <path d="M4 4 L28 4 L4 28 Z" fill="currentColor" opacity="0.22"/>
          <circle cx="16" cy="16" r="4" fill="#1a999d" stroke="currentColor" stroke-width="1.2"/>
          <circle cx="28" cy="10" r="2" fill="#1a999d" opacity="0.85"/>
          <circle cx="10" cy="28" r="2" fill="#1a999d" opacity="0.85"/>
        </svg>
      </div>
      <div class="corner-filigree top-right" aria-hidden="true">
        <svg viewBox="0 0 60 60" width="60" height="60" fill="none">
          <path d="M56 56 C56 20, 40 4, 4 4 M48 56 C48 28, 32 12, 4 12 M40 56 C40 36, 24 20, 4 20" stroke="currentColor" stroke-width="1.4" opacity="0.65"/>
          <path d="M56 4 L32 4 L56 28 Z" fill="currentColor" opacity="0.22"/>
          <circle cx="44" cy="16" r="4" fill="#1a999d" stroke="currentColor" stroke-width="1.2"/>
          <circle cx="32" cy="10" r="2" fill="#1a999d" opacity="0.85"/>
          <circle cx="50" cy="28" r="2" fill="#1a999d" opacity="0.85"/>
        </svg>
      </div>

      <div class="price-header text-center">
        <p class="price-kicker">✦ Boho Beauty &amp; Earthy Luxury ✦</p>
        <h2 class="price-title gold-script-text" id="price-list-heading">Price List</h2>
        <p class="price-subtitle">Crafted with natural ingredients and organic care in Santa Barbara</p>
        <p class="price-tap-hint">Tap any option below to select and book</p>
        <div class="brush-badge-wrap">
          <a href="#booking" class="teal-brush-banner" data-open-booking-btn>
            DM to Book on Instagram
          </a>
        </div>
      </div>

      <!-- Price Category 1: Henna Tattoos -->
      <div class="price-category">
        <div class="cat-header">
          <span class="cat-diamond" aria-hidden="true">✦</span>
          <h3 class="cat-title">Henna Tattoos</h3>
          <span class="cat-diamond" aria-hidden="true">✦</span>
        </div>
        <p class="cat-desc">Hand-drawn with all-natural, freshly mixed organic henna paste.</p>

        <div class="price-tier-list" role="group" aria-label="Henna Tattoos pricing options">
          <button
            type="button"
            class="price-pill-btn price-tier-btn"
            data-select-service="Henna Art"
            data-select-option="Small / Simple ($20 to $45)"
            aria-pressed="false"
          >
            <span class="tier-centered-line">
              <span class="pill-check" aria-hidden="true">✓</span>
              <span class="tier-name">Small / Simple Designs</span>
              <span class="tier-sep" aria-hidden="true">·</span>
              <span class="tier-price">$20 to $45</span>
            </span>
            <span class="tier-note">Delicate, minimal, or smaller accent pieces</span>
          </button>

          <div class="diamond-divider" aria-hidden="true"><span>✦</span></div>

          <button
            type="button"
            class="price-pill-btn price-tier-btn"
            data-select-service="Henna Art"
            data-select-option="Medium ($50 to $75)"
            aria-pressed="false"
          >
            <span class="tier-centered-line">
              <span class="pill-check" aria-hidden="true">✓</span>
              <span class="tier-name">Medium Designs</span>
              <span class="tier-sep" aria-hidden="true">·</span>
              <span class="tier-price">$50 to $75</span>
            </span>
            <span class="tier-note">Hand, wrist to hand, or more detailed designs including full hand</span>
          </button>

          <div class="diamond-divider" aria-hidden="true"><span>✦</span></div>

          <button
            type="button"
            class="price-pill-btn price-tier-btn"
            data-select-service="Henna Art"
            data-select-option="Large ($100+)"
            aria-pressed="false"
          >
            <span class="tier-centered-line">
              <span class="pill-check" aria-hidden="true">✓</span>
              <span class="tier-name">Large Pieces</span>
              <span class="tier-sep" aria-hidden="true">·</span>
              <span class="tier-price">$100+</span>
            </span>
            <span class="tier-note">Elaborate, custom, or extended floral and mandala compositions</span>
          </button>

          <button
            type="button"
            class="price-pill-btn glitter-bonus-pill"
            data-select-service="Henna Art"
            data-select-option="Add Glitter (FREE)"
            aria-pressed="false"
          >
            <span class="pill-check" aria-hidden="true">✓</span>
            <span class="glitter-star" aria-hidden="true">✨</span>
            <strong>Add a Touch of Glitter</strong>
            <span class="tier-sep" aria-hidden="true">·</span>
            <span class="glitter-free">FREE</span>
          </button>
        </div>
      </div>

      <div class="section-ornament" aria-hidden="true">
        <span class="ornament-line"></span>
        <span class="ornament-gem">✦ <span class="turquoise-gem">❖</span> ✦</span>
        <span class="ornament-line"></span>
      </div>

      <!-- Price Category 2: Hair Feather Extensions -->
      <div class="price-category">
        <div class="cat-header">
          <span class="cat-diamond" aria-hidden="true">✦</span>
          <h3 class="cat-title">Hair Feather Extensions</h3>
          <span class="cat-diamond" aria-hidden="true">✦</span>
        </div>
        <p class="cat-desc">Cruelty-free, premium natural feathers installed with gentle silicone-lined beads.</p>

        <div class="price-grid-rates" role="group" aria-label="Hair Feather Extensions pricing options">
          <button
            type="button"
            class="price-pill-btn rate-card"
            data-select-service="Hair Feather Extensions"
            data-select-option="1 Feather ($10)"
            aria-pressed="false"
          >
            <span class="rate-top-row">
              <span class="pill-check" aria-hidden="true">✓</span>
              <span class="rate-count">1 Feather</span>
            </span>
            <span class="rate-cost">$10</span>
          </button>
          <button
            type="button"
            class="price-pill-btn rate-card"
            data-select-service="Hair Feather Extensions"
            data-select-option="2 Feathers ($18)"
            aria-pressed="false"
          >
            <span class="rate-top-row">
              <span class="pill-check" aria-hidden="true">✓</span>
              <span class="rate-count">2 Feathers</span>
            </span>
            <span class="rate-cost">$18</span>
          </button>
          <button
            type="button"
            class="price-pill-btn rate-card"
            data-select-service="Hair Feather Extensions"
            data-select-option="3 Feathers ($25)"
            aria-pressed="false"
          >
            <span class="rate-top-row">
              <span class="pill-check" aria-hidden="true">✓</span>
              <span class="rate-count">3 Feathers</span>
            </span>
            <span class="rate-cost">$25</span>
          </button>
          <button
            type="button"
            class="price-pill-btn rate-card"
            data-select-service="Hair Feather Extensions"
            data-select-option="5 Feathers ($35)"
            aria-pressed="false"
          >
            <span class="rate-top-row">
              <span class="pill-check" aria-hidden="true">✓</span>
              <span class="rate-count">5 Feathers</span>
            </span>
            <span class="rate-cost">$35</span>
          </button>
          <button
            type="button"
            class="price-pill-btn rate-card"
            data-select-service="Hair Feather Extensions"
            data-select-option="10 Feathers ($60)"
            aria-pressed="false"
          >
            <span class="rate-top-row">
              <span class="pill-check" aria-hidden="true">✓</span>
              <span class="rate-count">10 Feathers</span>
            </span>
            <span class="rate-cost">$60</span>
          </button>
        </div>
        <p class="install-fee-note">Installation Fee: <strong>$10</strong></p>
      </div>

      <div class="section-ornament" aria-hidden="true">
        <span class="ornament-line"></span>
        <span class="ornament-gem">✦ <span class="turquoise-gem">❖</span> ✦</span>
        <span class="ornament-line"></span>
      </div>

      <!-- Price Category 3: Hair Tinsel Extensions -->
      <div class="price-category">
        <div class="cat-header">
          <span class="cat-diamond" aria-hidden="true">✦</span>
          <h3 class="cat-title">Hair Tinsel Extensions</h3>
          <span class="cat-diamond" aria-hidden="true">✦</span>
        </div>
        <p class="cat-desc">Heat-resistant shimmer strands tied gently for multi-week sparkle.</p>

        <div class="price-grid-rates" role="group" aria-label="Hair Tinsel Extensions pricing options">
          <button
            type="button"
            class="price-pill-btn rate-card"
            data-select-service="Hair Tinsel Extensions"
            data-select-option="5 Strands ($10)"
            aria-pressed="false"
          >
            <span class="rate-top-row">
              <span class="pill-check" aria-hidden="true">✓</span>
              <span class="rate-count">5 Strands</span>
            </span>
            <span class="rate-cost">$10</span>
          </button>
          <button
            type="button"
            class="price-pill-btn rate-card"
            data-select-service="Hair Tinsel Extensions"
            data-select-option="10 Strands ($12)"
            aria-pressed="false"
          >
            <span class="rate-top-row">
              <span class="pill-check" aria-hidden="true">✓</span>
              <span class="rate-count">10 Strands</span>
            </span>
            <span class="rate-cost">$12</span>
          </button>
          <button
            type="button"
            class="price-pill-btn rate-card"
            data-select-service="Hair Tinsel Extensions"
            data-select-option="15 Strands ($15)"
            aria-pressed="false"
          >
            <span class="rate-top-row">
              <span class="pill-check" aria-hidden="true">✓</span>
              <span class="rate-count">15 Strands</span>
            </span>
            <span class="rate-cost">$15</span>
          </button>
          <button
            type="button"
            class="price-pill-btn rate-card"
            data-select-service="Hair Tinsel Extensions"
            data-select-option="20 Strands ($20)"
            aria-pressed="false"
          >
            <span class="rate-top-row">
              <span class="pill-check" aria-hidden="true">✓</span>
              <span class="rate-count">20 Strands</span>
            </span>
            <span class="rate-cost">$20</span>
          </button>
          <button
            type="button"
            class="price-pill-btn rate-card"
            data-select-service="Hair Tinsel Extensions"
            data-select-option="30 Strands ($30)"
            aria-pressed="false"
          >
            <span class="rate-top-row">
              <span class="pill-check" aria-hidden="true">✓</span>
              <span class="rate-count">30 Strands</span>
            </span>
            <span class="rate-cost">$30</span>
          </button>
        </div>
        <p class="install-fee-note">Installation Fee: <strong>$10</strong></p>
      </div>

      <!-- Bottom Frame Actions -->
      <div class="price-action-wrap text-center">
        <p class="price-custom-note">Custom combinations and party bookings are available upon request.</p>
        <div class="action-buttons-row">
          <button type="button" class="btn btn-primary" data-open-booking-btn>
            Book an Appointment
          </button>
          <a
            href={SITE.instagramUrl}
            target="_blank"
            rel="noopener"
            class="btn-instagram"
            aria-label="Direct message Netta on Instagram"
            title="DM to Book @nettahennaandfeatheredsoul"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Ornate Mandala & Turquoise Gem Corner Accents Bottom -->
      <div class="corner-filigree bottom-left" aria-hidden="true">
        <svg viewBox="0 0 60 60" width="60" height="60" fill="none">
          <path d="M4 4 C4 40, 20 56, 56 56 M12 4 C12 32, 28 48, 56 48 M20 4 C20 24, 36 40, 56 40" stroke="currentColor" stroke-width="1.4" opacity="0.65"/>
          <path d="M4 56 L28 56 L4 32 Z" fill="currentColor" opacity="0.22"/>
          <circle cx="16" cy="44" r="4" fill="#1a999d" stroke="currentColor" stroke-width="1.2"/>
          <circle cx="28" cy="50" r="2" fill="#1a999d" opacity="0.85"/>
          <circle cx="10" cy="32" r="2" fill="#1a999d" opacity="0.85"/>
        </svg>
      </div>
      <div class="corner-filigree bottom-right" aria-hidden="true">
        <svg viewBox="0 0 60 60" width="60" height="60" fill="none">
          <path d="M56 4 C56 40, 40 56, 4 56 M48 4 C48 32, 32 48, 4 48 M40 4 C40 24, 24 40, 4 40" stroke="currentColor" stroke-width="1.4" opacity="0.65"/>
          <path d="M56 56 L32 56 L56 32 Z" fill="currentColor" opacity="0.22"/>
          <circle cx="44" cy="44" r="4" fill="#1a999d" stroke="currentColor" stroke-width="1.2"/>
          <circle cx="32" cy="50" r="2" fill="#1a999d" opacity="0.85"/>
          <circle cx="50" cy="32" r="2" fill="#1a999d" opacity="0.85"/>
        </svg>
      </div>
    </div>
  </div>
</section>

<style>
  .price-list-section {
    padding: 4.5rem 1.5rem;
    position: relative;
    scroll-margin-top: 100px;
    text-align: center;
  }

  .price-container {
    max-width: 820px;
    margin: 0 auto;
  }

  .price-frame {
    position: relative;
    background: var(--surface);
    border: 2px solid var(--brand-gold);
    outline: 1.5px solid var(--brand-gold-border);
    outline-offset: 5px;
    border-radius: 28px;
    padding: 3.5rem 2.5rem;
    box-shadow: 0 16px 48px rgba(61, 40, 23, 0.08), inset 0 0 0 1px rgba(197, 155, 39, 0.2);
    text-align: center;
  }

  .corner-filigree {
    position: absolute;
    color: var(--brand-gold);
    pointer-events: none;
  }
  .corner-filigree.top-left { top: 10px; left: 10px; }
  .corner-filigree.top-right { top: 10px; right: 10px; }
  .corner-filigree.bottom-left { bottom: 10px; left: 10px; }
  .corner-filigree.bottom-right { bottom: 10px; right: 10px; }

  .price-header {
    text-align: center;
  }

  .price-kicker {
    font-family: var(--font-section);
    font-size: 0.85rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--brand-gold);
    margin: 0 0 0.5rem;
    text-align: center;
  }

  .price-title {
    font-size: clamp(3rem, 7vw, 4.2rem);
    margin: 0 0 0.5rem;
    line-height: 1.15;
    text-align: center;
  }

  .price-subtitle {
    font-family: var(--font-section);
    font-size: 1.05rem;
    color: var(--muted);
    margin: 0 auto 0.5rem;
    max-width: 34ch;
    text-wrap: balance;
    font-style: italic;
    text-align: center;
  }

  .price-tap-hint {
    font-size: 0.8rem;
    color: var(--brand-teal);
    font-weight: 500;
    margin: 0 auto 1.25rem;
    letter-spacing: 0.02em;
    text-align: center;
  }

  .brush-badge-wrap {
    margin-bottom: 2.25rem;
    text-align: center;
  }

  .teal-brush-banner {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #1b8a8e, #136a6e);
    color: #ffffff !important;
    padding: 0.5rem 1.4rem;
    font-family: var(--font-body);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-radius: 255px 15px 225px 15px/15px 225px 15px 255px;
    box-shadow: 0 4px 14px rgba(26, 153, 157, 0.35);
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .teal-brush-banner:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(26, 153, 157, 0.5);
  }

  .price-category {
    margin: 2.25rem 0;
    text-align: center;
  }

  .cat-header {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    margin-bottom: 0.4rem;
    text-align: center;
  }

  .cat-diamond {
    color: var(--brand-gold);
    font-size: 0.9rem;
  }

  .cat-title {
    font-family: var(--font-section);
    font-size: 1.8rem;
    font-weight: 600;
    color: var(--ink);
    margin: 0;
    letter-spacing: 0.02em;
    text-align: center;
  }

  .cat-desc {
    font-size: 0.92rem;
    color: var(--muted);
    text-align: center;
    margin: 0 auto 1.35rem;
    max-width: 42ch;
    text-wrap: balance;
    font-style: italic;
  }

  /* ── Interactive Selectable Pricing Pills (Neutral by default) ── */
  .price-pill-btn {
    appearance: none;
    -webkit-appearance: none;
    font-family: inherit;
    background: var(--surface);
    border: 1.5px solid var(--brand-gold-border);
    color: var(--ink);
    cursor: pointer;
    text-align: center;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
    box-sizing: border-box;
  }

  .price-pill-btn:hover {
    transform: translateY(-2px);
    border-color: var(--brand-gold);
    box-shadow: 0 6px 18px rgba(197, 155, 39, 0.16);
  }

  .price-pill-btn:focus-visible {
    outline: 2px solid var(--brand-teal);
    outline-offset: 2px;
  }

  .pill-check {
    display: none;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--brand-gold);
    color: #ffffff;
    font-size: 0.7rem;
    font-weight: 700;
    line-height: 1;
    flex-shrink: 0;
  }

  .price-pill-btn.is-selected {
    border-color: var(--brand-gold) !important;
    border-width: 2px !important;
    background: var(--brand-gold-light) !important;
    box-shadow: 0 6px 20px rgba(197, 155, 39, 0.24) !important;
  }

  .price-pill-btn.is-selected .pill-check {
    display: inline-flex;
  }

  /* Henna Tattoo Centered Tier Buttons */
  .price-tier-list {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    padding: 0;
    margin: 0 auto;
    max-width: 560px;
  }

  .price-tier-btn {
    width: 100%;
    border-radius: 16px;
    padding: 0.9rem 1.15rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
  }

  .tier-centered-line {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.45rem;
    text-align: center;
    width: 100%;
  }

  .tier-name {
    font-family: var(--font-section);
    font-size: 1.18rem;
    font-weight: 600;
    color: var(--ink);
  }

  .tier-sep {
    color: var(--brand-gold);
    font-weight: 700;
  }

  .tier-price {
    font-family: var(--font-section);
    font-size: 1.22rem;
    font-weight: 700;
    color: var(--brand-teal);
  }

  .tier-note {
    font-size: 0.85rem;
    color: var(--muted);
    margin: 0;
    line-height: 1.4;
    text-align: center;
    text-wrap: balance;
  }

  .diamond-divider {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--brand-gold);
    font-size: 0.65rem;
    margin: 0.15rem 0;
    opacity: 0.75;
  }

  .glitter-bonus-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.45rem;
    border-radius: 9999px;
    padding: 0.6rem 1.35rem;
    margin: 0.75rem auto 0;
    font-size: 0.9rem;
    color: var(--ink);
  }

  .glitter-free {
    background: var(--brand-teal);
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.15rem 0.55rem;
    border-radius: 9999px;
    letter-spacing: 0.05em;
  }

  .section-ornament {
    display: flex;
    align-items: center;
