<script>
  function initBookingSection() {
    const modal = document.getElementById('booking-modal') as HTMLDialogElement | null;
    const closeBtn = document.getElementById('booking-modal-close');
    const confirmCloseBtn = document.getElementById('confirm-close-btn');
    const form = document.getElementById('booking-request-form') as HTMLFormElement | null;
    const confirmBox = document.getElementById('booking-confirm-box');
    const dateInput = document.getElementById('book-date') as HTMLInputElement | null;
    const detailsSummary = document.getElementById('confirm-details-summary');
    const stickyWrap = document.getElementById('sticky-book-wrap');
    const calToggleBtn = document.getElementById('cal-toggle-btn');
    const calToggleText = document.getElementById('cal-toggle-text');
    const calBlock = document.getElementById('modal-calendar-block');
    const errorMsg = document.getElementById('service-error-msg');

    if (!modal) return;

    // ── Agent 2: Full iOS Safari-Safe Background Scroll & Interaction Lock ──
    let savedScrollY = 0;
    let isLocked = false;

    function getBackgroundElements(): HTMLElement[] {
      return [
        document.querySelector<HTMLElement>('header.site-nav'),
        document.querySelector<HTMLElement>('#main-content'),
        document.querySelector<HTMLElement>('footer#site-footer'),
        document.getElementById('sticky-book-wrap'),
      ].filter((el): el is HTMLElement => Boolean(el));
    }

    function lockPageBackground() {
      if (isLocked) return;
      savedScrollY = window.scrollY || window.pageYOffset || 0;
      isLocked = true;

      document.documentElement.classList.add('modal-open');
      document.body.classList.add('modal-open');
      document.body.style.position = 'fixed';
      document.body.style.top = `-${savedScrollY}px`;
      document.body.style.left = '0';
      document.body.style.right = '0';
      document.body.style.width = '100%';
      document.body.style.overflow = 'hidden';

      getBackgroundElements().forEach((el) => {
        // Do not set inert on #main-content itself since #booking-modal lives inside #main-content;
        // instead set inert on all sibling sections and non-modal children!
        if (el.id === 'main-content') {
          Array.from(el.children).forEach((child) => {
            if (child.id !== 'booking') {
              (child as HTMLElement).setAttribute('inert', '');
            } else {
              const interactiveCard = child.querySelector('#booking-interactive');
              interactiveCard?.setAttribute('inert', '');
            }
          });
        } else {
          el.setAttribute('inert', '');
        }
      });
      updateStickyVisibility();
    }

    function unlockPageBackground() {
      if (!isLocked) return;
      const restoreY = savedScrollY;
      isLocked = false;

      document.querySelectorAll('[inert]').forEach((el) => el.removeAttribute('inert'));

      document.documentElement.classList.remove('modal-open');
      document.body.classList.remove('modal-open');
      document.body.style.position = '';
      document.body.style.top = '';
      document.body.style.left = '';
      document.body.style.right = '';
      document.body.style.width = '';
      document.body.style.overflow = '';

      window.scrollTo({ top: restoreY, left: 0, behavior: 'instant' });
      updateStickyVisibility();
    }

    let modalCloseTimer: number | null = null;
    const prefersReducedMotion = () =>
      window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function closeModal() {
      if (!modal || !modal.open) {
        unlockPageBackground();
        return;
      }
      if (modalCloseTimer !== null) {
        window.clearTimeout(modalCloseTimer);
        modalCloseTimer = null;
      }

      modal.classList.remove('is-visible');

      if (prefersReducedMotion()) {
        modal.classList.remove('is-closing');
        modal.close();
        unlockPageBackground();
        return;
      }

      modal.classList.add('is-closing');
      modalCloseTimer = window.setTimeout(() => {
        modalCloseTimer = null;
        modal.classList.remove('is-closing');
        if (modal.open) {
          modal.close();
        }
        unlockPageBackground();
      }, 280);
    }

    // Intercept Escape key ('cancel' event) so it uses the smooth ease-in-out close animation
    modal.addEventListener('cancel', (e) => {
      e.preventDefault();
      closeModal();
    });

    // Listen to native dialog close event as a fallback
    modal.addEventListener('close', () => {
      modal.classList.remove('is-visible', 'is-closing');
      unlockPageBackground();
    });

    function normalizeServiceName(raw?: string): string {
      if (!raw) return '';
      const lower = raw.toLowerCase();
      if (lower.includes('henna')) return 'Henna Art';
      if (lower.includes('feather')) return 'Hair Feather Extensions';
      if (lower.includes('tinsel')) return 'Hair Tinsel Extensions';
      return '';
    }

    const subOptionTimers = new Map<HTMLElement, number>();

    function syncServiceBlocks(immediate = false) {
      const checkboxes = modal?.querySelectorAll<HTMLInputElement>('.service-checkbox') || [];
      checkboxes.forEach((cb) => {
        const serviceName = cb.getAttribute('data-service-box') || '';
        const block = modal?.querySelector(`[data-service-block="${serviceName}"]`);
        const subOptions = modal?.querySelector<HTMLElement>(`[data-service-options="${serviceName}"]`);
        if (subOptions && subOptionTimers.has(subOptions)) {
          window.clearTimeout(subOptionTimers.get(subOptions));
          subOptionTimers.delete(subOptions);
        }

        if (cb.checked) {
          block?.classList.add('is-checked');
          if (subOptions) {
            subOptions.hidden = false;
            if (immediate || prefersReducedMotion()) {
              subOptions.classList.add('is-expanded');
            } else {
              void subOptions.offsetWidth;
              subOptions.classList.add('is-expanded');
            }
          }
        } else {
          block?.classList.remove('is-checked');
          if (subOptions) {
            subOptions.querySelectorAll<HTMLInputElement>('input[type="checkbox"]').forEach((opt) => {
              opt.checked = false;
            });
            subOptions.classList.remove('is-expanded');
            if (immediate || prefersReducedMotion()) {
              subOptions.hidden = true;
            } else {
              const t = window.setTimeout(() => {
                subOptions.hidden = true;
                subOptionTimers.delete(subOptions);
              }, 240);
              subOptionTimers.set(subOptions, t);
            }
          }
        }
      });
      if (errorMsg) errorMsg.hidden = true;
    }

    modal.querySelectorAll<HTMLInputElement>('.service-checkbox').forEach((cb) => {
      cb.addEventListener('change', () => syncServiceBlocks(false));
    });

    // Open Modal function: locks page background, resets form unless service / option passed
    function openModal(defaultService?: string, defaultOption?: string) {
      if (modalCloseTimer !== null) {
        window.clearTimeout(modalCloseTimer);
        modalCloseTimer = null;
      }
      modal?.classList.remove('is-closing');

      if (form) {
        form.reset();
        form.hidden = false;
      }
      if (confirmBox) {
        confirmBox.hidden = true;
      }
      if (calToggleText) {
        calToggleText.textContent = '📅 Choose a date on the calendar';
      }
      if (calToggleBtn) {
        calToggleBtn.setAttribute('aria-expanded', 'false');
      }
      if (calBlock) {
        calBlock.classList.remove('is-expanded');
        calBlock.hidden = true;
      }

      const canonicalService = normalizeServiceName(defaultService);
      modal?.querySelectorAll<HTMLInputElement>('.service-checkbox').forEach((cb) => {
        cb.checked = canonicalService !== '' && cb.value === canonicalService;
      });
      syncServiceBlocks(true);

      if (canonicalService && defaultOption) {
        const optInputs = modal?.querySelectorAll<HTMLInputElement>(
          `input[data-opt-service="${canonicalService}"]`
        );
        optInputs?.forEach((optInput) => {
          const label = optInput.getAttribute('data-opt-label') || '';
          if (label.toLowerCase() === defaultOption.toLowerCase()) {
            optInput.checked = true;
          }
        });
      }

      lockPageBackground();
      if (!modal?.open) {
        modal?.classList.remove('is-visible');
        modal?.showModal();
      }
      // Trigger reflow so the ease-in-out open transition always plays smoothly
      void modal?.offsetWidth;
      modal?.classList.add('is-visible');

      const modalCard = modal?.querySelector('.booking-modal-card');
      if (modalCard) modalCard.scrollTop = 0;
    }

    // Toggle calendar collapse with smooth ease-in-out transition
    let calCollapseTimer: number | null = null;
    calToggleBtn?.addEventListener('click', () => {
      const isExpanded = calToggleBtn.getAttribute('aria-expanded') === 'true';
      const nextExpanded = !isExpanded;
      calToggleBtn.setAttribute('aria-expanded', String(nextExpanded));
      if (calBlock) {
        if (calCollapseTimer !== null) {
          window.clearTimeout(calCollapseTimer);
          calCollapseTimer = null;
        }
        if (nextExpanded) {
          renderCalendar();
          calBlock.hidden = false;
          void calBlock.offsetWidth;
          calBlock.classList.add('is-expanded');
        } else {
          calBlock.classList.remove('is-expanded');
          if (prefersReducedMotion()) {
            calBlock.hidden = true;
          } else {
            calCollapseTimer = window.setTimeout(() => {
              calBlock.hidden = true;
              calCollapseTimer = null;
            }, 250);
          }
        }
      }
    });

    // Clicking the read-only Selected Date field also expands the calendar chooser smoothly
    dateInput?.addEventListener('click', () => {
      if (calToggleBtn && calBlock && calBlock.hidden) {
        calToggleBtn.click();
        calToggleBtn.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    });

    // Bind general booking triggers (Hero, Nav, Footer, Floating Icon, Booking Card)
    document.querySelectorAll('[data-action="book-date"], [data-open-booking-btn]').forEach((el) => {
      el.addEventListener('click', (e) => {
        e.preventDefault();
        openModal();
      });
    });

    // Bind service card CTA buttons and service rate badges
    document.querySelectorAll('a[href="#booking"]:not([data-open-booking-btn]), .bacc-cta, [data-service-cta]').forEach((el) => {
      el.addEventListener('click', (e) => {
        e.preventDefault();
        const text = el.getAttribute('data-service-cta') || el.textContent || '';
        openModal(text);
      });
    });

    // Bind interactive Price List pills (selects pill + opens modal with service & option pre-chosen)
    const pricePills = document.querySelectorAll<HTMLButtonElement>('.price-pill-btn[data-select-service]');
    pricePills.forEach((pill) => {
      pill.addEventListener('click', (e) => {
        e.preventDefault();
        const service = pill.getAttribute('data-select-service') || '';
        const option = pill.getAttribute('data-select-option') || '';

        pricePills.forEach((p) => {
          p.classList.remove('is-selected');
          p.setAttribute('aria-pressed', 'false');
        });
        pill.classList.add('is-selected');
        pill.setAttribute('aria-pressed', 'true');

        openModal(service, option);
      });
    });

    closeBtn?.addEventListener('click', () => closeModal());
    confirmCloseBtn?.addEventListener('click', () => closeModal());

    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    // Sticky book button visibility: hides when footer is in view
    const footer = document.getElementById('site-footer') || document.querySelector('footer');
    let isFooterVisible = false;

    if (footer && 'IntersectionObserver' in window) {
      const footerObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          isFooterVisible = entry.isIntersecting;
          updateStickyVisibility();
        });
      }, { threshold: 0.05 });
      footerObserver.observe(footer);
    }

    function updateStickyVisibility() {
      if (!stickyWrap) return;
      const currentY = isLocked ? savedScrollY : window.scrollY;

      // Check if the floating 48x48 button at bottom-right would overlap any photo card, caption, text block, or interactive control
      const btnLeft = window.innerWidth - 64;
      const btnRight = window.innerWidth - 8;
      const btnTop = window.innerHeight - 68;
      const btnBottom = window.innerHeight - 8;

      let overlapsContent = false;
      const protectedEls = document.querySelectorAll(
        '.gallery-item, .gallery-caption, .medallion-circle, .service-desc, .service-rate-badge, .btn-primary, .price-frame, .booking-ornate-card, footer'
      );
      for (let i = 0; i < protectedEls.length; i++) {
        const r = protectedEls[i].getBoundingClientRect();
        if (r.right > btnLeft && r.left < btnRight && r.bottom > btnTop && r.top < btnBottom) {
          overlapsContent = true;
          break;
        }
      }

      if (currentY > 240 && !isFooterVisible && !isLocked && !overlapsContent) {
        stickyWrap.style.transform = 'translateY(0)';
        stickyWrap.style.opacity = '1';
        stickyWrap.style.pointerEvents = 'auto';
        stickyWrap.removeAttribute('aria-hidden');
      } else {
        stickyWrap.style.transform = 'translateY(24px)';
        stickyWrap.style.opacity = '0';
        stickyWrap.style.pointerEvents = 'none';
        stickyWrap.setAttribute('aria-hidden', 'true');
      }
    }

    window.addEventListener('scroll', updateStickyVisibility, { passive: true });
    updateStickyVisibility();

    // Calendar dynamic logic inside modal
    let currentYear = new Date().getFullYear();
    let currentMonth = new Date().getMonth();
    let selectedDateStr = '';

    const monthTitle = document.getElementById('cal-month-title');
    const grid = document.getElementById('calendar-grid');
    const prevBtn = document.getElementById('cal-prev-btn');
    const nextBtn = document.getElementById('cal-next-btn');

    const monthNames = [
      'January', 'February', 'March', 'April', 'May', 'June',
      'July', 'August', 'September', 'October', 'November', 'December'
    ];

    function renderCalendar() {
      if (!grid || !monthTitle) return;
      monthTitle.textContent = `${monthNames[currentMonth]} ${currentYear}`;
      grid.innerHTML = '';

      const firstDay = new Date(currentYear, currentMonth, 1).getDay();
      const daysInMonth = new Date(currentYear, currentMonth + 1, 0).getDate();
      const today = new Date();
      today.setHours(0, 0, 0, 0);

      for (let i = 0; i < firstDay; i++) {
        const emptyCell = document.createElement('div');
        emptyCell.className = 'cal-day is-empty';
        grid.appendChild(emptyCell);
      }

      for (let day = 1; day <= daysInMonth; day++) {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'cal-day';
        btn.textContent = String(day);

        const dateObj = new Date(currentYear, currentMonth, day);
        const formatted = `${monthNames[currentMonth]} ${day}, ${currentYear}`;
        btn.setAttribute('data-date', formatted);

        if (dateObj < today) {
          btn.classList.add('is-past');
          btn.disabled = true;
          btn.setAttribute('aria-label', `${formatted} (past date)`);
        } else {
          btn.setAttribute('aria-label', formatted);
          if (selectedDateStr === formatted) {
            btn.classList.add('is-selected');
          }
          btn.addEventListener('click', () => {
            selectedDateStr = formatted;
            if (dateInput) dateInput.value = formatted;
            if (calToggleText) calToggleText.textContent = `📅 Selected: ${formatted}`;
            document.querySelectorAll('.cal-day.is-selected').forEach((d) => d.classList.remove('is-selected'));
            btn.classList.add('is-selected');
          });
        }

        grid.appendChild(btn);
      }
    }

    prevBtn?.addEventListener('click', () => {
      currentMonth--;
      if (currentMonth < 0) {
        currentMonth = 11;
        currentYear--;
      }
      renderCalendar();
    });

    nextBtn?.addEventListener('click', () => {
      currentMonth++;
      if (currentMonth > 11) {
        currentMonth = 0;
        currentYear++;
      }
      renderCalendar();
    });

    // Form submission with A La Carte multi-select summary
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const formData = new FormData(form);
      const name = (formData.get('name') as string) || '';
      const contact = (formData.get('contact') as string) || '';
      const selectedServices = formData.getAll('services') as string[];
      const selectedOptions = formData.getAll('service_options') as string[];
      const date = (formData.get('date') as string) || 'To be coordinated';
      const notes = (formData.get('message') as string) || '';

      if (selectedServices.length === 0) {
        if (errorMsg) errorMsg.hidden = false;
        return;
      }

      const serviceLines = selectedServices.map((srv) => {
        const optsForSrv = selectedOptions
          .filter((o) => o.startsWith(`${srv}:`))
          .map((o) => o.replace(`${srv}: `, ''));
        return optsForSrv.length > 0 ? `${srv} (${optsForSrv.join(', ')})` : srv;
      });

      if (detailsSummary) {
        detailsSummary.innerHTML = `
          <strong>Name:</strong> ${name}<br/>
          <strong>Contact:</strong> ${contact}<br/>
          <strong>Selected Services:</strong> ${serviceLines.join(' + ')}<br/>
          <strong>Requested Date:</strong> ${date}${notes ? `<br/><strong>Notes:</strong> ${notes}` : ''}
        `;
      }

      form.hidden = true;
      if (confirmBox) confirmBox.hidden = false;
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initBookingSection, { once: true });
  } else {
    initBookingSection();
  }
  document.addEventListener('astro:page-load', initBookingSection);
</script>
