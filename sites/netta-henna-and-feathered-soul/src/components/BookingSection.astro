---
/**
 * BookingSection.astro
 * Feminine, soft, warm booking flow for Netta Henna and Feathered Soul.
 * Uses Google Calendar appointment scheduling (titled "Book Netta") with contact request modal fallback.
 * No custom JSON availability file is used.
 * Punctuation hygiene: zero em dashes throughout.
 */

// TODO: Google Calendar appointment schedule URL from Netta (titled "Book Netta")
// Example: https://calendar.google.com/calendar/appointments/schedules/...
const GOOGLE_BOOKING_SCHEDULE_URL = '';
---

<div class="booking-wrap" id="booking-interactive">
  <!-- Google Calendar Appointment Schedule: "Book Netta" -->
  <div class="booking-schedule-card">
    <div class="schedule-head">
      <span class="schedule-badge">Google Calendar</span>
      <h3 class="schedule-title">Book Netta</h3>
      <p class="schedule-subtext">
        Direct booking via Netta's Google Calendar appointment schedule.
      </p>
    </div>

    {GOOGLE_BOOKING_SCHEDULE_URL ? (
      <div class="google-calendar-embed">
        <iframe
          src={GOOGLE_BOOKING_SCHEDULE_URL}
          style="border: 0"
          width="100%"
          height="600"
          title="Book Netta on Google Calendar"
        ></iframe>
      </div>
    ) : (
      <div class="schedule-pending-box">
        <p class="pending-tag">Appointment Schedule Pending</p>
        <p class="pending-desc">
          TODO: Waiting for Netta to provide her Google Calendar appointment schedule link (titled "Book Netta"). No third-party accounts (no Cal.com, no Calendly).
        </p>
        <div class="schedule-flow-steps">
          <div class="flow-step">
            <span class="flow-num">1</span>
            <span class="flow-text">Pick your service in the booking request modal.</span>
          </div>
          <div class="flow-step">
            <span class="flow-num">2</span>
            <span class="flow-text">Pick an available date and time on Netta's calendar.</span>
          </div>
          <div class="flow-step">
            <span class="flow-num">3</span>
            <span class="flow-text">Netta receives your appointment directly in her Google Calendar.</span>
          </div>
        </div>
      </div>
    )}

    <div class="calendar-preview-block">
      <header class="calendar-header">
        <div class="calendar-nav">
          <button type="button" class="cal-nav-btn" id="cal-prev-btn" aria-label="Previous month">
            &larr;
          </button>
          <h4 class="calendar-month-heading" id="cal-month-title" aria-live="polite">
            Loading month...
          </h4>
          <button type="button" class="cal-nav-btn" id="cal-next-btn" aria-label="Next month">
            &rarr;
          </button>
        </div>
        <p class="calendar-subtext">
          Select a date to request an appointment. Past dates are not selectable.
        </p>
      </header>

      <div class="calendar-weekdays" aria-hidden="true">
        <span>Sun</span>
        <span>Mon</span>
        <span>Tue</span>
        <span>Wed</span>
        <span>Thu</span>
        <span>Fri</span>
        <span>Sat</span>
      </div>

      <div class="calendar-grid" id="calendar-grid" role="grid" aria-labelledby="cal-month-title">
        <!-- Days populated dynamically by client-side script -->
      </div>

      <footer class="calendar-footer">
        <div class="calendar-legend">
          <span class="legend-item"><span class="legend-swatch legend-available"></span> Selectable Date</span>
          <span class="legend-item"><span class="legend-swatch legend-past"></span> Past Date</span>
        </div>
        <p class="calendar-disclaimer">
          This is a request system, not live booking. Netta will confirm your date.
        </p>
      </footer>
    </div>

    <div class="direct-request-box">
      <p class="direct-request-text">Ready to request a booking or have questions?</p>
      <button type="button" class="btn btn-secondary" id="open-modal-direct-btn">
        Open Booking Form
      </button>
    </div>
  </div>
</div>

<!-- Accessible Booking Request Modal -->
<dialog id="booking-modal" class="booking-modal" aria-labelledby="booking-modal-title">
  <div class="booking-modal-card">
    <header class="booking-modal-head">
      <div class="booking-modal-titles">
        <p class="booking-modal-kicker">Netta Henna and Feathered Soul</p>
        <h2 id="booking-modal-title" class="booking-modal-title">Request a Date</h2>
        <p class="booking-modal-pricing-note">Pricing on request, ask in the booking form.</p>
      </div>
      <button type="button" class="booking-modal-close" id="booking-modal-close" aria-label="Close booking form">
        &times;
      </button>
    </header>

    <form id="booking-request-form" class="booking-form">
      <div class="form-group">
        <label for="book-name">Your Name <span class="req" aria-hidden="true">*</span></label>
        <input type="text" id="book-name" name="name" required placeholder="First and last name" autocomplete="name" />
      </div>

      <div class="form-group">
        <label for="book-contact">Contact (Instagram handle or email) <span class="req" aria-hidden="true">*</span></label>
        <input type="text" id="book-contact" name="contact" required placeholder="@handle or you@example.com" />
      </div>

      <div class="form-group">
        <label for="book-service">Service <span class="req" aria-hidden="true">*</span></label>
        <select id="book-service" name="service" required>
          <option value="" disabled selected>Select a service</option>
          <option value="Henna Art">Henna Art</option>
          <option value="Hair Feathers">Hair Feathers</option>
          <option value="Hair Tinsel">Hair Tinsel</option>
          <option value="Not sure yet">Not sure yet</option>
        </select>
      </div>

      <div class="form-group">
        <label for="book-date">Selected Date</label>
        <input type="text" id="book-date" name="date" readonly placeholder="Pick a date on the calendar, or specify below" />
      </div>

      <div class="form-group">
        <label for="book-message">Notes or questions</label>
        <textarea id="book-message" name="message" rows="3" placeholder="Tell Netta about your event, placement, or preferred time."></textarea>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn btn-primary" id="booking-submit-btn">
          Send Booking Request
        </button>
      </div>
    </form>

    <!-- Confirmation display state -->
    <div id="booking-confirm-box" class="booking-confirm-box" hidden>
      <div class="confirm-icon" aria-hidden="true">&#10003;</div>
      <h3 class="confirm-title" role="status" aria-live="polite">Request sent. Netta will confirm your date.</h3>
      <p class="confirm-desc">
        Thank you. Your request details have been recorded. Netta will contact you via your provided contact information to confirm your date and finalize details.
      </p>
      <div class="confirm-details" id="confirm-details-summary"></div>
      <button type="button" class="btn btn-secondary" id="confirm-close-btn">
        Close
      </button>
    </div>
  </div>
</dialog>

<style>
  .booking-wrap {
    max-width: 680px;
    margin: 0 auto;
  }

  .booking-schedule-card {
    background: var(--surface, #fffdfa);
    border: 1px solid var(--hairline, rgba(200, 100, 70, 0.18));
    border-radius: var(--radius, 20px);
    padding: 2rem;
    box-shadow: 0 10px 30px rgba(74, 44, 29, 0.05);
  }

  @media (max-width: 480px) {
    .booking-schedule-card {
      padding: 1.25rem 1rem;
      border-radius: 16px;
    }
  }

  .schedule-head {
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(200, 100, 70, 0.12);
  }

  .schedule-badge {
    font-family: var(--font-section, 'Cormorant Garamond', Georgia, serif);
    font-style: italic;
    font-size: 1.05rem;
    color: var(--brand, #c86446);
    display: inline-block;
    margin-bottom: 0.25rem;
  }

  .schedule-title {
    margin: 0 0 0.35rem;
    font-family: var(--font-display, 'Cormorant Garamond', Georgia, serif);
    font-weight: 500;
    font-size: 1.7rem;
    color: var(--brand-brown, #332219);
  }

  .schedule-subtext {
    margin: 0;
    font-size: 0.92rem;
    color: var(--brand-brown-muted, #735d50);
  }

  .schedule-pending-box {
    background: #fbf6ef;
    border: 1px dashed rgba(200, 100, 70, 0.3);
    border-radius: 16px;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .pending-tag {
    margin: 0 0 0.4rem;
    font-family: var(--font-section, 'Cormorant Garamond', Georgia, serif);
    font-style: italic;
    font-size: 1.1rem;
    color: var(--brand, #c86446);
  }

  .pending-desc {
    margin: 0 0 1rem;
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--brand-brown-muted, #735d50);
  }

  .schedule-flow-steps {
    display: grid;
    gap: 0.75rem;
  }

  .flow-step {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.88rem;
    color: var(--brand-brown, #332219);
  }

  .flow-num {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: rgba(200, 100, 70, 0.15);
    border: 1px solid var(--brand, #c86446);
    color: var(--brand, #c86446);
    font-family: var(--font-section, Georgia, serif);
    font-weight: 600;
    font-size: 0.85rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .calendar-preview-block {
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(200, 100, 70, 0.12);
  }

  .calendar-header {
    margin-bottom: 1.25rem;
  }

  .calendar-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .calendar-month-heading {
    margin: 0;
    font-family: var(--font-display, 'Cormorant Garamond', Georgia, serif);
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--brand-brown, #332219);
  }

  .cal-nav-btn {
    background: #fdfaf6;
    border: 1px solid rgba(200, 100, 70, 0.25);
    border-radius: 50%;
    color: var(--brand-brown, #332219);
    width: 38px;
    height: 38px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 1.1rem;
    transition: all 180ms ease;
  }

  .cal-nav-btn:hover {
    background: var(--brand, #c86446);
    border-color: var(--brand, #c86446);
    color: #ffffff;
  }

  .calendar-subtext {
    margin: 0.5rem 0 0;
    font-size: 0.88rem;
    color: var(--brand-brown-muted, #735d50);
  }

  .calendar-weekdays {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    text-align: center;
    font-family: var(--font-section, 'Cormorant Garamond', Georgia, serif);
    font-style: italic;
    font-size: 0.95rem;
    color: var(--brand-brown-muted, #735d50);
    padding: 0.5rem 0;
    border-bottom: 1px solid rgba(200, 100, 70, 0.12);
    margin-bottom: 0.5rem;
  }

  .calendar-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 6px;
  }

  :global(.cal-day) {
    aspect-ratio: 1 / 1;
    min-height: 40px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: #fdfaf6;
    border: 1px solid rgba(200, 100, 70, 0.15);
    border-radius: 10px;
    color: var(--brand-brown, #332219);
    font-family: var(--font-body, Inter, sans-serif);
    font-size: 0.88rem;
    padding: 0.2rem;
    position: relative;
    cursor: default;
    transition: all 150ms ease;
  }

  :global(.cal-day.empty) {
    background: transparent;
    border: none;
    pointer-events: none;
  }

  :global(.cal-day.is-past) {
    color: #9c8a80;
    background: #f5ede3;
    border-color: transparent;
    text-decoration: line-through;
    opacity: 0.5;
    pointer-events: none;
  }

  :global(.cal-day.is-available) {
    background: #ffffff;
    border: 1px solid rgba(200, 100, 70, 0.35);
    color: var(--brand-brown, #332219);
    font-weight: 500;
    cursor: pointer;
  }

  :global(.cal-day.is-available:hover) {
    background: var(--brand, #c86446);
    border-color: var(--brand, #c86446);
    color: #ffffff;
    transform: scale(1.05);
    box-shadow: 0 4px 12px rgba(200, 100, 70, 0.25);
  }

  :global(.cal-day.is-available:focus-visible) {
    outline: 2px solid var(--brand, #c86446);
    outline-offset: 1px;
  }

  .calendar-footer {
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(200, 100, 70, 0.12);
  }

  .calendar-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    font-size: 0.82rem;
    color: var(--brand-brown-muted, #735d50);
  }

  .legend-item {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .legend-swatch {
    width: 12px;
    height: 12px;
    border-radius: 4px;
    display: inline-block;
  }

  .legend-available {
    background: #ffffff;
    border: 1px solid var(--brand, #c86446);
  }

  .legend-past {
    background: #f5ede3;
    border: 1px solid #d4c4b6;
    text-decoration: line-through;
  }

  .calendar-disclaimer {
    margin: 0.75rem 0 0;
    font-size: 0.82rem;
    line-height: 1.45;
    color: var(--brand-brown-muted, #735d50);
  }

  .direct-request-box {
    margin-top: 1.5rem;
    padding: 1.25rem 1.5rem;
    border: 1px solid rgba(200, 100, 70, 0.18);
    border-radius: 16px;
    background: #fbf6ef;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .direct-request-text {
    margin: 0;
    font-size: 0.95rem;
    color: var(--brand-brown, #332219);
  }

  /* Modal Styling: Soft warm dialog */
  .booking-modal {
    position: fixed;
    inset: 0;
    width: min(92vw, 520px);
    max-height: 90vh;
    margin: auto;
    padding: 0;
    background: #fffdfa;
    border: 1px solid rgba(200, 100, 70, 0.25);
    border-radius: 24px;
    color: var(--brand-brown, #332219);
    box-shadow: 0 25px 60px rgba(74, 44, 29, 0.18);
  }

  .booking-modal::backdrop {
    background: rgba(46, 31, 24, 0.45);
    backdrop-filter: blur(6px);
  }

  .booking-modal:focus {
    outline: none;
  }

  .booking-modal-card {
    padding: 2rem;
    max-height: 90vh;
    overflow-y: auto;
  }

  @media (max-width: 480px) {
    .booking-modal-card {
      padding: 1.5rem 1.25rem;
    }
  }

  .booking-modal-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    border-bottom: 1px solid rgba(200, 100, 70, 0.15);
    padding-bottom: 1rem;
    margin-bottom: 1.25rem;
    position: relative;
  }

  .booking-modal-kicker {
    margin: 0 0 0.25rem;
    font-family: var(--font-section, 'Cormorant Garamond', Georgia, serif);
    font-style: italic;
    font-size: 1.1rem;
    color: var(--brand, #c86446);
  }

  .booking-modal-title {
    margin: 0 0 0.35rem;
    font-family: var(--font-display, 'Cormorant Garamond', Georgia, serif);
    font-weight: 500;
    font-size: 1.8rem;
    color: var(--brand-brown, #332219);
  }

  .booking-modal-pricing-note {
    margin: 0;
    font-size: 0.88rem;
    color: var(--brand-brown-muted, #735d50);
  }

  .booking-modal-close {
    background: #fbf6ef;
    border: 1px solid rgba(200, 100, 70, 0.2);
    border-radius: 50%;
    color: var(--brand-brown-muted, #735d50);
    font-size: 1.5rem;
    line-height: 1;
    width: 38px;
    height: 38px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0;
    transition: all 180ms ease;
  }

  .booking-modal-close:hover {
    background: var(--brand, #c86446);
    border-color: var(--brand, #c86446);
    color: #ffffff;
  }

  .form-group {
    margin-bottom: 1.15rem;
  }

  .form-group label {
    display: block;
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--brand-brown, #332219);
    margin-bottom: 0.4rem;
  }

  .form-group .req {
    color: var(--brand, #c86446);
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    width: 100%;
    padding: 0.75rem 1rem;
    background: #fdfaf6;
    border: 1px solid rgba(200, 100, 70, 0.25);
    border-radius: 12px;
    color: var(--brand-brown, #332219);
    font-family: var(--font-body, Inter, sans-serif);
    font-size: 0.95rem;
    box-sizing: border-box;
    transition: border-color 150ms ease, box-shadow 150ms ease;
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--brand, #c86446);
    box-shadow: 0 0 0 3px rgba(200, 100, 70, 0.15);
  }

  .form-group input[readonly] {
    background: #fbf6ef;
    border-color: rgba(200, 100, 70, 0.2);
    color: var(--brand, #c86446);
    font-weight: 500;
  }

  .form-actions {
    margin-top: 1.75rem;
  }

  /* Confirmation Box */
  .booking-confirm-box {
    text-align: center;
    padding: 1.5rem 0.5rem;
  }

  .confirm-icon {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: rgba(200, 100, 70, 0.12);
    color: var(--brand, #c86446);
    font-size: 1.8rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
  }

  .confirm-title {
    font-family: var(--font-display, 'Cormorant Garamond', Georgia, serif);
    font-weight: 500;
    font-size: 1.6rem;
    color: var(--brand-brown, #332219);
    margin: 0 0 0.75rem;
  }

  .confirm-desc {
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--brand-brown-muted, #735d50);
    margin: 0 0 1.25rem;
  }

  .confirm-details {
    background: #fbf6ef;
    border: 1px solid rgba(200, 100, 70, 0.2);
    border-radius: 14px;
    padding: 1.1rem;
    font-size: 0.88rem;
    line-height: 1.6;
    text-align: left;
    margin-bottom: 1.5rem;
    color: var(--brand-brown, #332219);
    white-space: pre-wrap;
  }
</style>

<script>
  function initBookingCalendar() {
    const calendarGrid = document.getElementById('calendar-grid');
    const monthTitle = document.getElementById('cal-month-title');
    const prevBtn = document.getElementById('cal-prev-btn');
    const nextBtn = document.getElementById('cal-next-btn');

    const modal = document.getElementById('booking-modal') as HTMLDialogElement | null;
    const modalCloseBtn = document.getElementById('booking-modal-close');
    const dateInput = document.getElementById('book-date') as HTMLInputElement | null;
    const directBtn = document.getElementById('open-modal-direct-btn');
    const bookingForm = document.getElementById('booking-request-form') as HTMLFormElement | null;
    const confirmBox = document.getElementById('booking-confirm-box');
    const confirmDetails = document.getElementById('confirm-details-summary');
    const confirmCloseBtn = document.getElementById('confirm-close-btn');

    const today = new Date();
    let viewYear = 2026;
    let viewMonth = 10; // November

    if (today.getFullYear() > 2026 || (today.getFullYear() === 2026 && today.getMonth() > 10)) {
      viewYear = today.getFullYear();
      viewMonth = today.getMonth();
    }

    const monthNames = [
      'January', 'February', 'March', 'April', 'May', 'June',
      'July', 'August', 'September', 'October', 'November', 'December'
    ];

    function renderCalendar() {
      if (!calendarGrid || !monthTitle) return;

      monthTitle.textContent = `${monthNames[viewMonth]} ${viewYear}`;
      calendarGrid.innerHTML = '';

      const firstDayOfMonth = new Date(viewYear, viewMonth, 1).getDay();
      const daysInMonth = new Date(viewYear, viewMonth + 1, 0).getDate();

      for (let i = 0; i < firstDayOfMonth; i++) {
        const emptyCell = document.createElement('div');
        emptyCell.className = 'cal-day empty';
        calendarGrid.appendChild(emptyCell);
      }

      const todayStr = `${today.getFullYear()}-${String(today.getMonth() + 1).padStart(2, '0')}-${String(today.getDate()).padStart(2, '0')}`;

      for (let day = 1; day <= daysInMonth; day++) {
        const dateStr = `${viewYear}-${String(viewMonth + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
        const dayBtn = document.createElement('button');
        dayBtn.type = 'button';
        dayBtn.className = 'cal-day';
        dayBtn.textContent = String(day);
        dayBtn.setAttribute('data-date', dateStr);

        const isPast = dateStr < todayStr;

        if (isPast) {
          dayBtn.classList.add('is-past');
          dayBtn.setAttribute('aria-disabled', 'true');
          dayBtn.setAttribute('disabled', 'true');
          dayBtn.title = 'Past date (not selectable)';
        } else {
          dayBtn.classList.add('is-available');
          dayBtn.setAttribute('aria-label', `${monthNames[viewMonth]} ${day}, ${viewYear} - Select date to request booking`);
          dayBtn.addEventListener('click', () => {
            selectDateAndOpenModal(dateStr);
          });
        }

        calendarGrid.appendChild(dayBtn);
      }
    }

    function selectDateAndOpenModal(dateStr: string) {
      if (dateInput) {
        dateInput.value = dateStr;
      }
      openModal();
    }

    function openModal() {
      if (!modal) return;
      if (bookingForm) bookingForm.hidden = false;
      if (confirmBox) confirmBox.hidden = true;
      modal.showModal();
    }

    function closeModal() {
      if (!modal) return;
      modal.close();
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        viewMonth--;
        if (viewMonth < 0) {
          viewMonth = 11;
          viewYear--;
        }
        renderCalendar();
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        viewMonth++;
        if (viewMonth > 11) {
          viewMonth = 0;
          viewYear++;
        }
        renderCalendar();
      });
    }

    if (directBtn) {
      directBtn.addEventListener('click', () => {
        if (dateInput && !dateInput.value) {
          dateInput.value = 'Date flexible / TBD';
        }
        openModal();
      });
    }

    document.querySelectorAll('[data-action="book-date"]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        openModal();
      });
    });

    if (modalCloseBtn) {
      modalCloseBtn.addEventListener('click', closeModal);
    }

    if (confirmCloseBtn) {
      confirmCloseBtn.addEventListener('click', closeModal);
    }

    if (modal) {
      modal.addEventListener('click', (e) => {
        const rect = modal.getBoundingClientRect();
        const isInDialog = (
          rect.top <= e.clientY &&
          e.clientY <= rect.top + rect.height &&
          rect.left <= e.clientX &&
          e.clientX <= rect.left + rect.width
        );
        if (!isInDialog) {
          closeModal();
        }
      });
    }

    if (bookingForm) {
      bookingForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const formData = new FormData(bookingForm);
        const name = (formData.get('name') as string) || '';
        const contact = (formData.get('contact') as string) || '';
        const service = (formData.get('service') as string) || '';
        const date = (formData.get('date') as string) || '';
        const message = (formData.get('message') as string) || '';

        /**
         * TODO: How should booking requests reach Netta, email, DM link, or form service?
         * (Delivery method TBD. No backend endpoint invented.)
         */

        if (confirmDetails) {
          confirmDetails.textContent = `Name: ${name}\nContact: ${contact}\nService: ${service}\nRequested Date: ${date}${message ? `\nNotes: ${message}` : ''}`;
        }

        bookingForm.hidden = true;
        if (confirmBox) {
          confirmBox.hidden = false;
        }
      });
    }

    renderCalendar();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initBookingCalendar);
  } else {
    initBookingCalendar();
  }
</script>
