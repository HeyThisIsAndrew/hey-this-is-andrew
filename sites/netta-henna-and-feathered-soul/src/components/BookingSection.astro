  }

  .sms-fallback-textarea {
    width: 100%;
    box-sizing: border-box;
    font-family: var(--font-body, inherit);
    font-size: 0.88rem;
    line-height: 1.5;
    padding: 0.65rem 0.75rem;
    background: var(--surface-2);
    color: var(--ink);
    border: 1px solid var(--hairline);
    border-radius: 8px;
    resize: none;
    margin-bottom: 0.75rem;
    display: block;
  }

  .sms-fallback-actions {
    display: flex;
    gap: 0.65rem;
    flex-wrap: wrap;
  }

  .btn-copy-sms,
  .btn-open-sms {
    flex: 1 1 140px;
    height: 44px !important;
    min-height: 44px !important;
    font-size: 0.88rem !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    text-decoration: none !important;
    box-sizing: border-box !important;
    border-radius: 9999px !important;
    font-family: var(--font-body, inherit) !important;
    font-weight: 600 !important;
    cursor: pointer !important;
  }

  .btn-copy-sms {
    background: var(--brand-teal) !important;
    color: #ffffff !important;
    border: none !important;
  }

  .btn-open-sms {
    background: transparent !important;
    color: var(--ink) !important;
    border: 1.5px solid var(--gold-border) !important;
  }

  .btn-open-sms:hover {
    border-color: var(--brand-gold) !important;
    background: var(--surface-2) !important;
  }
</style>

<script>
  import { BOOKING_SMS_NUMBER_ENCODED } from '../data/site';

  function initBookingSection() {
    const modal = document.getElementById('booking-modal') as HTMLDialogElement | null;
    const closeBtn = document.getElementById('booking-modal-close');
    const confirmCloseBtn = document.getElementById('confirm-close-btn');
    const openSmsBtn = document.getElementById('btn-open-sms') as HTMLAnchorElement | null;
    const form = document.getElementById('booking-request-form') as HTMLFormElement | null;
    const confirmBox = document.getElementById('booking-confirm-box');
    const dateInput = document.getElementById('book-date') as HTMLInputElement | null;
    const detailsSummary = document.getElementById('confirm-details-summary');
    const stickyWrap = document.getElementById('sticky-book-wrap');
    const stickyBtn = document.getElementById('sticky-book-btn');
    const calToggleBtn = document.getElementById('cal-toggle-btn');
    const calToggleText = document.getElementById('cal-toggle-text');
    const calBlock = document.getElementById('modal-calendar-block');
    const errorMsg = document.getElementById('service-error-msg');

    if (!modal) return;

    // ── Agent 2: Full iOS Safari-Safe Background Scroll & Interaction Lock ──
    let savedScrollY = 0;
    let isLocked = false;

    function getBackgroundElements(): HTMLElement[] {
      return [
        document.querySelector<HTMLElement>('header.site-nav'),
        document.querySelector<HTMLElement>('#main-content'),
        document.querySelector<HTMLElement>('footer#site-footer'),
        document.getElementById('sticky-book-wrap'),
      ].filter((el): el is HTMLElement => Boolean(el));
    }

    function lockPageBackground() {
      if (isLocked) return;
      savedScrollY = window.scrollY || window.pageYOffset || 0;
      isLocked = true;

      document.documentElement.classList.add('modal-open');
      document.body.classList.add('modal-open');
      document.body.style.position = 'fixed';
      document.body.style.top = `-${savedScrollY}px`;
      document.body.style.left = '0';
      document.body.style.right = '0';
      document.body.style.width = '100%';
      document.body.style.overflow = 'hidden';

      getBackgroundElements().forEach((el) => {
        if (el.id === 'main-content') {
          Array.from(el.children).forEach((child) => {
            if (child.id !== 'booking') {
              (child as HTMLElement).setAttribute('inert', '');
            } else {
              const interactiveCard = child.querySelector('#booking-interactive');
              interactiveCard?.setAttribute('inert', '');
            }
          });
        } else {
          el.setAttribute('inert', '');
        }
      });
      updateStickyVisibility();
    }

    function unlockPageBackground() {
      if (!isLocked) return;
      const restoreY = savedScrollY;
      isLocked = false;

      const root = document.documentElement;
      const prevBehavior = root.style.scrollBehavior;
      root.style.scrollBehavior = 'auto';

      document.querySelectorAll('[inert]').forEach((el) => el.removeAttribute('inert'));

      root.classList.remove('modal-open');
      document.body.classList.remove('modal-open');
      document.body.style.position = '';
      document.body.style.top = '';
      document.body.style.left = '';
      document.body.style.right = '';
      document.body.style.width = '';
      document.body.style.overflow = '';

      window.scrollTo(0, restoreY);
      requestAnimationFrame(() => {
        window.scrollTo(0, restoreY);
        root.style.scrollBehavior = prevBehavior;
        updateStickyVisibility();
      });
    }

    let modalCloseTimer: number | null = null;
    const prefersReducedMotion = () =>
      window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function finishModalClose() {
      if (!modal) return;
      if (openSmsBtn) openSmsBtn.onclick = null;
      const restoreY = savedScrollY;
      const root = document.documentElement;
      root.style.scrollBehavior = 'auto';
      if (modal.open) {
        modal.close();
      }
      unlockPageBackground();
      window.scrollTo(0, restoreY);
    }

    function closeModal() {
      if (!modal || !modal.open) {
        unlockPageBackground();
        return;
      }
      if (modalCloseTimer !== null) {
        window.clearTimeout(modalCloseTimer);
        modalCloseTimer = null;
      }

      modal.classList.remove('is-visible');

      if (prefersReducedMotion()) {
        modal.classList.remove('is-closing');
        finishModalClose();
        return;
      }

      modal.classList.add('is-closing');
      modalCloseTimer = window.setTimeout(() => {
        modalCloseTimer = null;
        modal.classList.remove('is-closing');
        finishModalClose();
      }, 280);
    }

    // Intercept Escape key ('cancel' event) so it uses the smooth ease-in-out close animation
    modal.addEventListener('cancel', (e) => {
      e.preventDefault();
      closeModal();
    });

    // Listen to native dialog close event as a fallback
    modal.addEventListener('close', () => {
      modal.classList.remove('is-visible', 'is-closing');
      unlockPageBackground();
    });

    function normalizeServiceName(raw?: string): string {
      if (!raw) return '';
      const lower = raw.toLowerCase();
      if (lower.includes('henna')) return 'Henna Art';
      if (lower.includes('feather')) return 'Hair Feather Extensions';
      if (lower.includes('tinsel')) return 'Hair Tinsel Extensions';
      return '';
    }

    const subOptionTimers = new Map<HTMLElement, number>();

    function syncServiceBlocks(immediate = false) {
      const checkboxes = modal?.querySelectorAll<HTMLInputElement>('.service-checkbox') || [];
      checkboxes.forEach((cb) => {
        const serviceName = cb.getAttribute('data-service-box') || '';
        const block = modal?.querySelector(`[data-service-block="${serviceName}"]`);
        const subOptions = modal?.querySelector<HTMLElement>(`[data-service-options="${serviceName}"]`);
        if (subOptions && subOptionTimers.has(subOptions)) {
          window.clearTimeout(subOptionTimers.get(subOptions));
          subOptionTimers.delete(subOptions);
        }

        if (cb.checked) {
          block?.classList.add('is-checked');
          if (subOptions) {
            subOptions.hidden = false;
            if (immediate || prefersReducedMotion()) {
              subOptions.classList.add('is-expanded');
            } else {
              void subOptions.offsetWidth;
              subOptions.classList.add('is-expanded');
            }
          }
        } else {
          block?.classList.remove('is-checked');
          if (subOptions) {
            subOptions.querySelectorAll<HTMLInputElement>('input[type="checkbox"]').forEach((opt) => {
              opt.checked = false;
            });
            subOptions.classList.remove('is-expanded');
            if (immediate || prefersReducedMotion()) {
              subOptions.hidden = true;
            } else {
              const t = window.setTimeout(() => {
                subOptions.hidden = true;
                subOptionTimers.delete(subOptions);
              }, 240);
              subOptionTimers.set(subOptions, t);
            }
          }
        }
      });
      if (errorMsg) errorMsg.hidden = true;
    }

    modal.querySelectorAll<HTMLInputElement>('.service-checkbox').forEach((cb) => {
      cb.addEventListener('change', () => syncServiceBlocks(false));
    });

    // Open Modal function: locks page background, resets form unless service / option passed
    function openModal(defaultService?: string, defaultOption?: string) {
      if (modalCloseTimer !== null) {
        window.clearTimeout(modalCloseTimer);
        modalCloseTimer = null;
      }
      modal?.classList.remove('is-closing');

      if (form) {
        form.reset();
        form.hidden = false;
      }
      if (confirmBox) {
        confirmBox.hidden = true;
      }
      const configErr = document.getElementById('booking-config-error');
      if (configErr) {
        configErr.hidden = true;
        configErr.textContent = '';
      }
      const smsFlowDetails = document.getElementById('sms-flow-details');
      if (smsFlowDetails) smsFlowDetails.hidden = true;
      if (detailsSummary) detailsSummary.hidden = true;
      if (calToggleText) {
        calToggleText.textContent = '📅 Choose a date on the calendar';
      }
      if (calToggleBtn) {
        calToggleBtn.setAttribute('aria-expanded', 'false');
      }
      if (calBlock) {
        calBlock.classList.remove('is-expanded');
        calBlock.hidden = true;
      }

      const canonicalService = normalizeServiceName(defaultService);
      modal?.querySelectorAll<HTMLInputElement>('.service-checkbox').forEach((cb) => {
        cb.checked = canonicalService !== '' && cb.value === canonicalService;
      });
      syncServiceBlocks(true);

      if (canonicalService && defaultOption) {
        const optInputs = modal?.querySelectorAll<HTMLInputElement>(
          `input[data-opt-service="${canonicalService}"]`
        );
        optInputs?.forEach((optInput) => {
          const label = optInput.getAttribute('data-opt-label') || '';
          if (label.toLowerCase() === defaultOption.toLowerCase()) {
            optInput.checked = true;
          }
        });
      }

      lockPageBackground();
      if (!modal?.open) {
        modal?.classList.remove('is-visible');
        modal?.showModal();
      }
      void modal?.offsetWidth;
      modal?.classList.add('is-visible');

      const modalCard = modal?.querySelector('.booking-modal-card');
      if (modalCard) modalCard.scrollTop = 0;
    }

    // Toggle calendar collapse with smooth ease-in-out transition
    let calCollapseTimer: number | null = null;
    calToggleBtn?.addEventListener('click', () => {
      const isExpanded = calToggleBtn.getAttribute('aria-expanded') === 'true';
      const nextExpanded = !isExpanded;
      calToggleBtn.setAttribute('aria-expanded', String(nextExpanded));
      if (calBlock) {
        if (calCollapseTimer !== null) {
          window.clearTimeout(calCollapseTimer);
          calCollapseTimer = null;
        }
        if (nextExpanded) {
          renderCalendar();
          calBlock.hidden = false;
          void calBlock.offsetWidth;
          calBlock.classList.add('is-expanded');
        } else {
          calBlock.classList.remove('is-expanded');
          if (prefersReducedMotion()) {
            calBlock.hidden = true;
          } else {
            calCollapseTimer = window.setTimeout(() => {
              calBlock.hidden = true;
              calCollapseTimer = null;
            }, 250);
          }
        }
      }
    });

    dateInput?.addEventListener('click', () => {
      if (calToggleBtn && calBlock && calBlock.hidden) {
        calToggleBtn.click();
        calToggleBtn.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    });

    // Bind general booking triggers (Hero, Nav, Footer, Floating Icon, Booking Card)
    document.querySelectorAll('[data-action="book-date"], [data-open-booking-btn]').forEach((el) => {
      el.addEventListener('click', (e) => {
        e.preventDefault();
        openModal();
      });
    });

    // Bind service card CTA buttons and service rate badges
    document.querySelectorAll('a[href="#booking"]:not([data-open-booking-btn]), .bacc-cta, [data-service-cta]').forEach((el) => {
      el.addEventListener('click', (e) => {
        e.preventDefault();
        const text = el.getAttribute('data-service-cta') || el.textContent || '';
        openModal(text);
      });
    });

    // Bind interactive Price List pills (selects pill + opens modal with service & option pre-chosen)
    const pricePills = document.querySelectorAll<HTMLButtonElement>('.price-pill-btn[data-select-service]');
    pricePills.forEach((pill) => {
      pill.addEventListener('click', (e) => {
        e.preventDefault();
        const service = pill.getAttribute('data-select-service') || '';
        const option = pill.getAttribute('data-select-option') || '';

        pricePills.forEach((p) => {
          p.classList.remove('is-selected');
          p.setAttribute('aria-pressed', 'false');
        });
        pill.classList.add('is-selected');
        pill.setAttribute('aria-pressed', 'true');

        openModal(service, option);
      });
    });

    closeBtn?.addEventListener('click', () => closeModal());
    confirmCloseBtn?.addEventListener('click', () => closeModal());

    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    const footer = document.getElementById('site-footer') || document.querySelector('footer');
    let isFooterVisible = false;
    let scrollTicking = false;

    if (footer && 'IntersectionObserver' in window) {
      const footerObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          isFooterVisible = entry.isIntersecting;
          updateStickyVisibility();
        });
      }, { threshold: 0.05 });
      footerObserver.observe(footer);
    }

    function updateStickyVisibility() {
      if (!stickyWrap) return;
      const currentY = isLocked ? savedScrollY : (window.scrollY || window.pageYOffset || 0);
      const shouldHide = currentY <= 240 || isFooterVisible || isLocked;

      if (shouldHide) {
        stickyWrap.classList.add('is-hidden');
        if (isFooterVisible) {
          stickyWrap.classList.add('is-hidden-footer');
        } else {
          stickyWrap.classList.remove('is-hidden-footer');
        }
        stickyWrap.setAttribute('aria-hidden', 'true');
        stickyBtn?.setAttribute('tabindex', '-1');
      } else {
        stickyWrap.classList.remove('is-hidden');
        stickyWrap.classList.remove('is-hidden-footer');
        stickyWrap.removeAttribute('aria-hidden');
        stickyBtn?.removeAttribute('tabindex');
      }
    }

    function onScrollThrottled() {
      if (!scrollTicking) {
        scrollTicking = true;
        window.requestAnimationFrame(() => {
          updateStickyVisibility();
          scrollTicking = false;
        });
      }
    }

    window.addEventListener('scroll', onScrollThrottled, { passive: true });
    updateStickyVisibility();

    // Calendar dynamic logic inside modal
    // Kept for future use, hidden per Netta, Nov 15, 2026. Do not re-enable without Andrew's approval.
    let currentYear = new Date().getFullYear();
    let currentMonth = new Date().getMonth();
    let selectedDateStr = '';

    const monthTitle = document.getElementById('cal-month-title');
    const grid = document.getElementById('calendar-grid');
    const prevBtn = document.getElementById('cal-prev-btn');
    const nextBtn = document.getElementById('cal-next-btn');

    const monthNames = [
      'January', 'February', 'March', 'April', 'May', 'June',
      'July', 'August', 'September', 'October', 'November', 'December'
    ];

    function renderCalendar() {
      if (!calBlock || calBlock.hidden || calBlock.style.display === 'none') return;
      if (!grid || !monthTitle) return;
      monthTitle.textContent = `${monthNames[currentMonth]} ${currentYear}`;
      grid.innerHTML = '';

      const firstDay = new Date(currentYear, currentMonth, 1).getDay();
      const daysInMonth = new Date(currentYear, currentMonth + 1, 0).getDate();
      const today = new Date();
      today.setHours(0, 0, 0, 0);

      for (let i = 0; i < firstDay; i++) {
        const emptyCell = document.createElement('div');
        emptyCell.className = 'cal-day is-empty';
        grid.appendChild(emptyCell);
      }

      for (let day = 1; day <= daysInMonth; day++) {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'cal-day';
        btn.textContent = String(day);

        const dateObj = new Date(currentYear, currentMonth, day);
        const formatted = `${monthNames[currentMonth]} ${day}, ${currentYear}`;
        btn.setAttribute('data-date', formatted);

        if (dateObj < today) {
          btn.classList.add('is-past');
          btn.disabled = true;
          btn.setAttribute('aria-label', `${formatted} (past date)`);
        } else {
          btn.setAttribute('aria-label', formatted);
          if (selectedDateStr === formatted) {
            btn.classList.add('is-selected');
          }
          btn.addEventListener('click', () => {
            selectedDateStr = formatted;
            if (dateInput) dateInput.value = formatted;
            if (calToggleText) calToggleText.textContent = `📅 Selected: ${formatted}`;
            document.querySelectorAll('.cal-day.is-selected').forEach((d) => d.classList.remove('is-selected'));
            btn.classList.add('is-selected');
          });
        }

        grid.appendChild(btn);
      }
    }

    prevBtn?.addEventListener('click', () => {
      if (!calBlock || calBlock.hidden) return;
      currentMonth--;
      if (currentMonth < 0) {
        currentMonth = 11;
        currentYear--;
      }
      renderCalendar();
    });

    nextBtn?.addEventListener('click', () => {
      if (!calBlock || calBlock.hidden) return;
      currentMonth++;
      if (currentMonth > 11) {
        currentMonth = 0;
        currentYear++;
      }
      renderCalendar();
    });

    if (calBlock && !calBlock.hidden && calBlock.style.display !== 'none') {
      renderCalendar();
    }

    function escapeHtml(str: string): string {
      return str
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();

      const phoneErr = document.getElementById('phone-error-msg');
      const emailErr = document.getElementById('email-error-msg');
      const nameErr = document.getElementById('name-error-msg');
      const configErr = document.getElementById('booking-config-error');
      if (phoneErr) { phoneErr.hidden = true; phoneErr.textContent = ''; }
      if (emailErr) { emailErr.hidden = true; emailErr.textContent = ''; }
      if (nameErr) { nameErr.hidden = true; nameErr.textContent = ''; }
      if (configErr) { configErr.hidden = true; configErr.textContent = ''; }
      if (errorMsg) { errorMsg.hidden = true; }

      const formData = new FormData(form);
      const name = ((formData.get('name') as string) || '').trim();
      const phone = ((formData.get('phone') as string) || '').trim();
      const email = ((formData.get('email') as string) || '').trim();
      const instagram = ((formData.get('instagram') as string) || '').trim();
      const selectedServices = formData.getAll('services') as string[];
      const selectedOptions = formData.getAll('service_options') as string[];
      const preferredTimeRaw = ((formData.get('preferred_time') as string) || '').trim();
      const notes = ((formData.get('message') as string) || '').trim();

      let hasError = false;

      if (!name) {
        if (nameErr) {
          nameErr.textContent = 'Please enter your name.';
          nameErr.hidden = false;
        }
        hasError = true;
      }

      if (!phone) {
        if (phoneErr) {
          phoneErr.textContent = 'Please add a phone number so Netta can text you to confirm.';
          phoneErr.hidden = false;
        }
        hasError = true;
      } else {
        const digits = phone.replace(/\D/g, '');
        if (digits.length < 10) {
          if (phoneErr) {
            phoneErr.textContent = 'That phone number looks incomplete. Please check it and try again.';
            phoneErr.hidden = false;
          }
          hasError = true;
        }
      }

      if (email) {
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!emailRegex.test(email)) {
          if (emailErr) {
            emailErr.textContent = 'Please enter a valid email address.';
            emailErr.hidden = false;
          }
          hasError = true;
        }
      }

      if (selectedServices.length === 0) {
        if (errorMsg) errorMsg.hidden = false;
        hasError = true;
      }

      if (hasError) return;

      const serviceLines = selectedServices.map((srv) => {
        const optsForSrv = selectedOptions
          .filter((o) => o.startsWith(`${srv}:`))
          .map((o) => o.replace(`${srv}: `, ''));
        return optsForSrv.length > 0 ? `${srv} (${optsForSrv.join(', ')})` : srv;
      });

      const preferredTime = preferredTimeRaw || 'To be coordinated';

      const bookingMode = (form.getAttribute('data-booking-mode') || 'sms').toLowerCase();

      const confirmTitle = document.getElementById('confirm-title');
      const confirmIcon = document.getElementById('confirm-icon');
      const confirmDesc = document.getElementById('confirm-desc');
      const smsFlowDetails = document.getElementById('sms-flow-details');
      const confirmDetailsSummary = document.getElementById('confirm-details-summary');

      if (bookingMode === 'sms') {
        const smsLines = [
          "Hi Netta! I'd like to request an appointment:",
          `• Name: ${name}`,
          `• Phone: ${phone}`,
          `• Services: ${serviceLines.join(' + ')}`,
          `• Preferred Date & Time: ${preferredTime}`,
        ];
        if (notes) smsLines.push(`• Notes: ${notes}`);
        if (email) smsLines.push(`• Email: ${email}`);
        if (instagram) {
          const igFormatted = instagram.startsWith('@') ? instagram : `@${instagram}`;
          smsLines.push(`• Instagram: ${igFormatted}`);
        }
        const smsBody = smsLines.join('\n');

        const isApple = /iPad|iPhone|iPod|Macintosh/.test(navigator.userAgent) && !('MSStream' in window);
        const separator = isApple ? '&' : '?';
        let cleanSmsNumber = '';
        try {
          cleanSmsNumber = atob(BOOKING_SMS_NUMBER_ENCODED);
        } catch {
          // Keep the existing configuration fallback for an invalid encoding.
        }
        if (!/^\+[1-9]\d{7,14}$/.test(cleanSmsNumber)) {
          if (configErr) {
            configErr.textContent = "Netta's booking phone number is not set yet. Please contact Netta directly on Instagram (@nettahennaandfeatheredsoul) or check back soon.";
            configErr.hidden = false;
          }
          return;
        }
        const smsUrl = `sms:${cleanSmsNumber}${separator}body=${encodeURIComponent(smsBody)}`;
        const launchSms = () => {
          try {
            window.location.href = smsUrl;
          } catch {
            // The confirmation still offers a copyable message if the handoff is blocked.
          }
        };

        if (confirmTitle) confirmTitle.textContent = 'Check Your Messages';
        if (confirmIcon) confirmIcon.textContent = '💬';
        if (confirmDesc) {
          confirmDesc.textContent = 'Check your Messages, tap Send to text Netta your appointment request.';
        }

        if (smsFlowDetails) smsFlowDetails.hidden = false;
        if (confirmDetailsSummary) confirmDetailsSummary.hidden = true;

        const fallbackTextarea = document.getElementById('sms-fallback-textarea') as HTMLTextAreaElement | null;
        if (fallbackTextarea) fallbackTextarea.value = smsBody;

        if (openSmsBtn) {
          openSmsBtn.onclick = (event) => {
            event.preventDefault();
            launchSms();
          };
        }
        launchSms();

      } else {
        if (confirmTitle) confirmTitle.textContent = 'Request Received!';
        if (confirmIcon) confirmIcon.textContent = '✓';
        if (confirmDesc) {
          confirmDesc.textContent = 'Thank you. Netta will reach out directly to confirm availability and finalize your appointment.';
        }

        if (smsFlowDetails) smsFlowDetails.hidden = true;
        if (confirmDetailsSummary) confirmDetailsSummary.hidden = false;

        const payload = {
          name,
          phone,
          email: email || undefined,
          instagram: instagram || undefined,
          services: serviceLines.join(', '),
          preferred_time: preferredTime,
          notes: notes || undefined,
          _subject: `New Appointment Request from ${name} (${phone})`,
          message: `New Appointment Request:\n` +
            `• Name: ${name}\n` +
            `• Phone: ${phone} (Tap to reply by text/call)\n` +
            (email ? `• Email: ${email}\n` : '') +
            (instagram ? `• Instagram: ${instagram}\n` : '') +
            `• Services: ${serviceLines.join(' + ')}\n` +
            `• Preferred Date & Time: ${preferredTime}\n` +
            (notes ? `• Notes: ${notes}\n` : '')
        };

        try {
          const deliveryEndpoint = form.getAttribute('data-endpoint');
          if (deliveryEndpoint && !deliveryEndpoint.includes('YOUR_FORM_ID')) {
            await fetch(deliveryEndpoint, {
              method: 'POST',
              headers: { 'Accept': 'application/json', 'Content-Type': 'application/json' },
              body: JSON.stringify(payload),
              signal: AbortSignal.timeout ? AbortSignal.timeout(4000) : undefined,
            });
          }
        } catch (err) {
          console.warn('Booking dispatch notice:', err);
        }

        if (confirmDetailsSummary) {
          let summaryHtml = `<strong>Name:</strong> ${escapeHtml(name)}<br/>
            <strong>Phone:</strong> ${escapeHtml(phone)}<br/>`;
          if (email) {
            summaryHtml += `<strong>Email:</strong> ${escapeHtml(email)}<br/>`;
          }
          if (instagram) {
            const igFormatted = instagram.startsWith('@') ? instagram : `@${instagram}`;
            summaryHtml += `<strong>Instagram:</strong> ${escapeHtml(igFormatted)}<br/>`;
          }
          summaryHtml += `<strong>Selected Services:</strong> ${serviceLines.map(escapeHtml).join(' + ')}<br/>
            <strong>Preferred date and time:</strong> ${escapeHtml(preferredTime)}`;
          if (notes) {
            summaryHtml += `<br/><strong>Notes:</strong> ${escapeHtml(notes)}`;
          }
          confirmDetailsSummary.innerHTML = summaryHtml;
        }
      }

      form.hidden = true;
      if (confirmBox) confirmBox.hidden = false;
    });

    const copySmsBtn = document.getElementById('btn-copy-sms');
    const fallbackTextarea = document.getElementById('sms-fallback-textarea') as HTMLTextAreaElement | null;
    copySmsBtn?.addEventListener('click', async () => {
      if (!fallbackTextarea) return;
      const textToCopy = fallbackTextarea.value;
      try {
        if (navigator.clipboard && navigator.clipboard.writeText) {
          await navigator.clipboard.writeText(textToCopy);
        } else {
          fallbackTextarea.select();
          document.execCommand('copy');
        }
        copySmsBtn.textContent = '✓ Copied!';
        window.setTimeout(() => {
          copySmsBtn.textContent = '📋 Copy Message';
        }, 2500);
      } catch (err) {
        fallbackTextarea.select();
        copySmsBtn.textContent = '✓ Copied!';
        window.setTimeout(() => {
          copySmsBtn.textContent = '📋 Copy Message';
        }, 2500);
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initBookingSection, { once: true });
  } else {
    initBookingSection();
  }
  document.addEventListener('astro:page-load', initBookingSection);
</script>
