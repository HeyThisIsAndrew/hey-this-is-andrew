---
/**
 * BookingSection.astro
 * Condensed on-page booking card, sticky floating CTA, and comprehensive booking modal.
 * Google Calendar appointment schedule pending note ("Book Netta").
 * No fake dates, zero em dashes.
 */
---

<!-- Condensed On-Page Booking Card (Item 7) -->
<div class="booking-wrap" id="booking-interactive">
  <div class="booking-summary-card">
    <div class="booking-summary-text">
      <span class="booking-badge">Direct & Personal</span>
      <h3 class="booking-summary-title">Reserve Your Session</h3>
      <p class="booking-summary-desc">
        Simple booking with personal confirmation from Netta. Select your service and preferred date, and Netta will connect with you directly to finalize your session.
      </p>
    </div>
    <div class="booking-summary-action">
      <button type="button" class="btn btn-primary" id="open-booking-modal-btn" data-action="book-date">
        Request an Appointment
      </button>
      <p class="booking-summary-note">Pricing on request, ask in the booking form.</p>
    </div>
  </div>
</div>

<!-- Sticky Floating Book Button (Item 7) -->
<div class="sticky-book-wrap" id="sticky-book-wrap" aria-hidden="true">
  <button type="button" class="sticky-book-btn" id="sticky-book-btn" data-action="book-date" aria-label="Book an appointment with Netta">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
      <line x1="16" y1="2" x2="16" y2="6"></line>
      <line x1="8" y1="2" x2="8" y2="6"></line>
      <line x1="3" y1="10" x2="21" y2="10"></line>
    </svg>
    <span>Book a date</span>
  </button>
</div>

<!-- Accessible Booking Request Modal with Calendar Inside (Item 7) -->
<dialog id="booking-modal" class="booking-modal" aria-labelledby="booking-modal-title">
  <div class="booking-modal-card">
    <header class="booking-modal-head">
      <div class="booking-modal-titles">
        <p class="booking-modal-kicker">Netta Henna and Feathered Soul</p>
        <h2 id="booking-modal-title" class="booking-modal-title">Book an Appointment</h2>
        <p class="booking-modal-pricing-note">Pricing on request, ask in the booking form.</p>
      </div>
      <button type="button" class="booking-modal-close" id="booking-modal-close" aria-label="Close booking form">
        &times;
      </button>
    </header>

    <div class="modal-body">
      <!-- Calendar Schedule Pending Notice -->
      <div class="schedule-pending-notice">
        <div class="pending-badge-row">
          <span class="pending-pill">Google Calendar</span>
          <span class="pending-status-text">Schedule Pending</span>
        </div>
        <p class="pending-notice-body">
          Netta is preparing her official Google Calendar schedule titled "Book Netta". Select your preferred date below and submit your request. Netta will confirm directly.
        </p>
      </div>

      <!-- Interactive Calendar Picker Inside Modal -->
      <div class="modal-calendar-block">
        <header class="calendar-header">
          <div class="calendar-nav">
            <button type="button" class="cal-nav-btn" id="cal-prev-btn" aria-label="Previous month">
              &larr;
            </button>
            <h4 class="calendar-month-heading" id="cal-month-title" aria-live="polite">
              Loading month...
            </h4>
            <button type="button" class="cal-nav-btn" id="cal-next-btn" aria-label="Next month">
              &rarr;
            </button>
          </div>
          <p class="calendar-subtext">
            Choose a date to request your booking:
          </p>
        </header>

        <div class="calendar-weekdays" aria-hidden="true">
          <span>Sun</span>
          <span>Mon</span>
          <span>Tue</span>
          <span>Wed</span>
          <span>Thu</span>
          <span>Fri</span>
          <span>Sat</span>
        </div>

        <div class="calendar-grid" id="calendar-grid" role="grid" aria-labelledby="cal-month-title">
          <!-- Populated dynamically by client-side script -->
        </div>
      </div>

      <!-- Booking Form -->
      <form id="booking-request-form" class="booking-form">
        <div class="form-grid">
          <div class="form-group">
            <label for="book-name">Your Name <span class="req" aria-hidden="true">*</span></label>
            <input type="text" id="book-name" name="name" required placeholder="First and last name" autocomplete="name" />
          </div>

          <div class="form-group">
            <label for="book-contact">Contact (Instagram or Email) <span class="req" aria-hidden="true">*</span></label>
            <input type="text" id="book-contact" name="contact" required placeholder="@handle or you@example.com" />
          </div>
        </div>

        <div class="form-grid">
          <div class="form-group">
            <label for="book-service">Service <span class="req" aria-hidden="true">*</span></label>
            <select id="book-service" name="service" required>
              <option value="" disabled selected>Select an offering</option>
              <option value="Henna Art">Henna Art</option>
              <option value="Hair Feathers">Hair Feathers</option>
              <option value="Hair Tinsel">Hair Tinsel</option>
              <option value="Multiple Offerings">Multiple Offerings</option>
            </select>
          </div>

          <div class="form-group">
            <label for="book-date">Requested Date</label>
            <input type="text" id="book-date" name="date" readonly placeholder="Select a date on the calendar above" />
          </div>
        </div>

        <div class="form-group">
          <label for="book-message">Notes or questions</label>
          <textarea id="book-message" name="message" rows="3" placeholder="Tell Netta about your design ideas, placement, or preferred time of day."></textarea>
        </div>

        <div class="form-actions">
          <button type="submit" class="btn btn-primary" id="booking-submit-btn">
            Send Booking Request
          </button>
        </div>
      </form>

      <!-- Confirmation state -->
      <div id="booking-confirm-box" class="booking-confirm-box" hidden>
        <div class="confirm-icon" aria-hidden="true">&#10003;</div>
        <h3 class="confirm-title" role="status" aria-live="polite">Request sent. Netta will confirm your date.</h3>
        <p class="confirm-desc">
          Thank you. Your appointment request details have been received. Netta will reach out via your contact info to confirm availability and discuss pricing.
        </p>
        <div class="confirm-details" id="confirm-details-summary"></div>
        <button type="button" class="btn btn-secondary" id="confirm-close-btn">
          Done
        </button>
      </div>
    </div>
  </div>
</dialog>

<style>
  /* ── Condensed On-Page Booking Card ── */
  .booking-wrap {
    max-width: 820px;
    margin: 0 auto;
  }

  .booking-summary-card {
    background: var(--surface);
    border: 1px solid var(--gold-border);
    border-radius: var(--radius);
    padding: 2.5rem;
    box-shadow: var(--card-shadow);
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 2rem;
    align-items: center;
    transition: background-color 0.3s ease, border-color 0.3s ease;
  }

  @media (max-width: 720px) {
    .booking-summary-card {
      grid-template-columns: 1fr;
      padding: 1.75rem 1.25rem;
      gap: 1.5rem;
      text-align: center;
    }
  }

  .booking-badge {
    font-family: var(--font-section);
    font-style: italic;
    font-size: 1.1rem;
    color: var(--brand-gold);
    display: inline-block;
    margin-bottom: 0.35rem;
  }

  .booking-summary-title {
    margin: 0 0 0.5rem;
    font-family: var(--font-section);
    font-weight: 500;
    font-size: 2rem;
    color: var(--ink);
    line-height: 1.2;
  }

  .booking-summary-desc {
    margin: 0;
    font-size: 1rem;
    color: var(--muted);
    line-height: 1.55;
  }

  .booking-summary-action {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
  }

  @media (max-width: 720px) {
    .booking-summary-action {
      align-items: center;
    }
  }

  .booking-summary-note {
    margin: 0;
    font-size: 0.85rem;
    color: var(--muted);
    font-style: italic;
  }

  /* ── Booking Modal & Dialog ── */
  .booking-modal {
    border: none;
    border-radius: var(--radius);
    padding: 0;
    max-width: 640px;
    width: calc(100% - 2rem);
    background: transparent;
    color: var(--ink);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.35);
  }

  .booking-modal::backdrop {
    background: rgba(24, 19, 16, 0.65);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .booking-modal-card {
    background: var(--surface);
    border: 1px solid var(--gold-border);
    border-radius: var(--radius);
    padding: 2rem;
    max-height: 88vh;
    overflow-y: auto;
  }

  @media (max-width: 520px) {
    .booking-modal-card {
      padding: 1.5rem 1.15rem;
    }
  }

  .booking-modal-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 1.25rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--gold-border);
  }

  .booking-modal-kicker {
    margin: 0;
    font-family: var(--font-section);
    font-style: italic;
    font-size: 1.05rem;
    color: var(--brand-gold);
  }

  .booking-modal-title {
    margin: 0.2rem 0 0.25rem;
    font-family: var(--font-section);
    font-size: 1.85rem;
    font-weight: 500;
    color: var(--ink);
    line-height: 1.2;
  }

  .booking-modal-pricing-note {
    margin: 0;
    font-size: 0.88rem;
    color: var(--muted);
    font-style: italic;
  }

  .booking-modal-close {
    background: var(--surface-2);
    border: 1px solid var(--gold-border);
    color: var(--ink);
    font-size: 1.5rem;
    line-height: 1;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .booking-modal-close:hover {
    background: var(--brand-teal-light);
    color: var(--brand-teal);
  }

  /* Schedule Notice Inside Modal */
  .schedule-pending-notice {
    background: var(--brand-teal-light);
    border: 1px solid var(--brand-teal-glow);
    border-radius: 14px;
    padding: 1rem 1.15rem;
    margin-bottom: 1.5rem;
  }

  .pending-badge-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.4rem;
  }

  .pending-pill {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: var(--brand-teal);
    color: #ffffff;
    padding: 0.15rem 0.55rem;
    border-radius: 9999px;
  }

  .pending-status-text {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--ink);
  }

  .pending-notice-body {
    margin: 0;
    font-size: 0.88rem;
    color: var(--muted);
    line-height: 1.5;
  }

  /* Calendar inside Modal */
  .modal-calendar-block {
    background: var(--surface-2);
    border: 1px solid var(--gold-border);
    border-radius: 16px;
    padding: 1.15rem;
    margin-bottom: 1.5rem;
  }

  .calendar-header {
    margin-bottom: 0.75rem;
  }

  .calendar-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .cal-nav-btn {
    background: var(--surface);
    border: 1px solid var(--gold-border);
    color: var(--ink);
    border-radius: 50%;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 1rem;
    transition: all 0.2s ease;
  }

  .cal-nav-btn:hover {
    background: var(--brand-teal);
    color: #ffffff;
  }

  .calendar-month-heading {
    margin: 0;
    font-family: var(--font-section);
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--ink);
  }

  .calendar-subtext {
    margin: 0.35rem 0 0;
    font-size: 0.82rem;
    color: var(--muted);
  }

  .calendar-weekdays {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    text-align: center;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--muted);
    margin-bottom: 0.4rem;
  }

  .calendar-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 4px;
  }

  .calendar-grid :global(.cal-day) {
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    border: 1px solid transparent;
    background: transparent;
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 0.85rem;
    cursor: pointer;
    transition: all 0.2s ease;
    padding: 0;
  }

  .calendar-grid :global(.cal-day:hover:not(.is-past):not(.is-empty)) {
    background: var(--brand-teal-light);
    border-color: var(--brand-teal);
    color: var(--brand-teal);
  }

  .calendar-grid :global(.cal-day.is-selected) {
    background: var(--brand-teal) !important;
    color: #ffffff !important;
    font-weight: 600;
  }

  .calendar-grid :global(.cal-day.is-past) {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .calendar-grid :global(.cal-day.is-empty) {
    cursor: default;
  }

  /* Form inside Modal */
  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  @media (max-width: 520px) {
    .form-grid {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }

  .form-group {
    margin-bottom: 1rem;
  }

  .form-group label {
    display: block;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--ink);
    margin-bottom: 0.35rem;
  }

  .req {
    color: var(--brand-gold);
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    width: 100%;
    padding: 0.65rem 0.85rem;
    border: 1px solid var(--gold-border);
    border-radius: 10px;
    background: var(--surface-2);
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 0.92rem;
    box-sizing: border-box;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--brand-teal);
    box-shadow: 0 0 0 3px var(--brand-teal-glow);
  }

  .form-actions {
    margin-top: 1.25rem;
  }

  .form-actions button {
    width: 100%;
  }

  /* Confirm State */
  .booking-confirm-box {
    text-align: center;
    padding: 1.5rem 0;
  }

  .confirm-icon {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--brand-teal);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    margin: 0 auto 1rem;
  }

  .confirm-title {
    font-family: var(--font-section);
    font-size: 1.4rem;
    margin: 0 0 0.5rem;
    color: var(--ink);
  }

  .confirm-desc {
    font-size: 0.95rem;
    color: var(--muted);
    line-height: 1.5;
    margin: 0 0 1.25rem;
  }

  .confirm-details {
    background: var(--surface-2);
    border: 1px solid var(--gold-border);
    border-radius: 12px;
    padding: 1rem;
    margin-bottom: 1.25rem;
    text-align: left;
    font-size: 0.88rem;
    color: var(--ink);
    line-height: 1.6;
  }
</style>

<script>
  function initBookingModalAndCalendar() {
    const modal = document.getElementById('booking-modal') as HTMLDialogElement | null;
    const closeBtn = document.getElementById('booking-modal-close');
    const confirmCloseBtn = document.getElementById('confirm-close-btn');
    const form = document.getElementById('booking-request-form') as HTMLFormElement | null;
    const confirmBox = document.getElementById('booking-confirm-box');
    const dateInput = document.getElementById('book-date') as HTMLInputElement | null;
    const serviceSelect = document.getElementById('book-service') as HTMLSelectElement | null;
    const detailsSummary = document.getElementById('confirm-details-summary');
    const stickyWrap = document.getElementById('sticky-book-wrap');

    if (!modal) return;

    // Open Modal function
    function openModal(defaultService?: string) {
      if (defaultService && serviceSelect) {
        for (let i = 0; i < serviceSelect.options.length; i++) {
          if (serviceSelect.options[i].value.toLowerCase().includes(defaultService.toLowerCase())) {
            serviceSelect.selectedIndex = i;
            break;
          }
        }
      }
      modal?.showModal();
    }

    // Bind all buttons with data-action="book-date"
    document.querySelectorAll('[data-action="book-date"]').forEach((el) => {
      el.addEventListener('click', (e) => {
        e.preventDefault();
        openModal();
      });
    });

    // Also bind service CTA links (#booking) inside BrandAccordion
    document.querySelectorAll('a[href="#booking"], .bacc-cta').forEach((el) => {
      el.addEventListener('click', (e) => {
        e.preventDefault();
        const text = el.textContent || '';
        let service = '';
        if (text.includes('Henna')) service = 'Henna Art';
        else if (text.includes('Feather')) service = 'Hair Feathers';
        else if (text.includes('Tinsel')) service = 'Hair Tinsel';
        openModal(service);
      });
    });

    closeBtn?.addEventListener('click', () => modal.close());
    confirmCloseBtn?.addEventListener('click', () => modal.close());

    modal.addEventListener('click', (e) => {
      if (e.target === modal) modal.close();
    });

    // Sticky book button visibility on scroll
    function updateStickyVisibility() {
      if (!stickyWrap) return;
      if (window.scrollY > 300) {
        stickyWrap.style.transform = 'translateY(0)';
        stickyWrap.style.opacity = '1';
        stickyWrap.style.pointerEvents = 'auto';
        stickyWrap.removeAttribute('aria-hidden');
      } else {
        stickyWrap.style.transform = 'translateY(20px)';
        stickyWrap.style.opacity = '0';
        stickyWrap.style.pointerEvents = 'none';
        stickyWrap.setAttribute('aria-hidden', 'true');
      }
    }

    window.addEventListener('scroll', updateStickyVisibility, { passive: true });
    updateStickyVisibility();

    // Calendar dynamic logic inside modal
    let currentYear = new Date().getFullYear();
    let currentMonth = new Date().getMonth();
    let selectedDateStr = '';

    const monthTitle = document.getElementById('cal-month-title');
    const grid = document.getElementById('calendar-grid');
    const prevBtn = document.getElementById('cal-prev-btn');
    const nextBtn = document.getElementById('cal-next-btn');

    const monthNames = [
      'January', 'February', 'March', 'April', 'May', 'June',
      'July', 'August', 'September', 'October', 'November', 'December'
    ];

    function renderCalendar() {
      if (!grid || !monthTitle) return;
      monthTitle.textContent = `${monthNames[currentMonth]} ${currentYear}`;
      grid.innerHTML = '';

      const firstDay = new Date(currentYear, currentMonth, 1).getDay();
      const daysInMonth = new Date(currentYear, currentMonth + 1, 0).getDate();
      const today = new Date();
      today.setHours(0, 0, 0, 0);

      // Empty lead days
      for (let i = 0; i < firstDay; i++) {
        const emptyCell = document.createElement('div');
        emptyCell.className = 'cal-day is-empty';
        grid.appendChild(emptyCell);
      }

      // Month days
      for (let day = 1; day <= daysInMonth; day++) {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'cal-day';
        btn.textContent = String(day);

        const dateObj = new Date(currentYear, currentMonth, day);
        const formatted = `${monthNames[currentMonth]} ${day}, ${currentYear}`;
        btn.setAttribute('data-date', formatted);

        if (dateObj < today) {
          btn.classList.add('is-past');
          btn.disabled = true;
          btn.setAttribute('aria-label', `${formatted} (past date)`);
        } else {
          btn.setAttribute('aria-label', formatted);
          if (selectedDateStr === formatted) {
            btn.classList.add('is-selected');
          }
          btn.addEventListener('click', () => {
            selectedDateStr = formatted;
            if (dateInput) dateInput.value = formatted;
            document.querySelectorAll('.cal-day.is-selected').forEach(d => d.classList.remove('is-selected'));
            btn.classList.add('is-selected');
          });
        }

        grid.appendChild(btn);
      }
    }

    prevBtn?.addEventListener('click', () => {
      currentMonth--;
      if (currentMonth < 0) {
        currentMonth = 11;
        currentYear--;
      }
      renderCalendar();
    });

    nextBtn?.addEventListener('click', () => {
      currentMonth++;
      if (currentMonth > 11) {
        currentMonth = 0;
        currentYear++;
      }
      renderCalendar();
    });

    renderCalendar();

    // Form submission
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const formData = new FormData(form);
      const name = formData.get('name') as string;
      const contact = formData.get('contact') as string;
      const service = formData.get('service') as string;
      const date = formData.get('date') as string || 'Date to be coordinated';

      if (detailsSummary) {
        detailsSummary.innerHTML = `
          <strong>Name:</strong> ${name}<br/>
          <strong>Contact:</strong> ${contact}<br/>
          <strong>Service:</strong> ${service}<br/>
          <strong>Requested Date:</strong> ${date}
        `;
      }

      form.hidden = true;
      if (confirmBox) confirmBox.hidden = false;
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initBookingModalAndCalendar, { once: true });
  } else {
    initBookingModalAndCalendar();
  }
  document.addEventListener('astro:page-load', initBookingModalAndCalendar);
</script>
