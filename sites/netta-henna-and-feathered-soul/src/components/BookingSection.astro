---
/**
 * BookingSection.astro
 * Netta Henna and Feathered Soul - Booking Card, Floating Calendar Icon & Modal
 * 
 * Pass 8 / Pass 34 Redesign:
 * - Option 1 ("DM to Book on Instagram") uses the circular 48x48 Instagram logo icon button (no "DM NETTA" text pill)
 * - Tall, calm modal layout (up to 92dvh on mobile) with generous vertical breathing room
 * - 52px tall inputs and triggers with comfortable internal padding
 * - Full-width stacked fields on mobile (two-column only on desktop > 640px)
 * - Multi-select A La Carte service checkboxes (Henna Art, Hair Feather Extensions, Hair Tinsel Extensions)
 *   with top-level prices hidden and expandable sub-option pills keeping exact prices per Andrew (2026-11-17)
 * - Full iOS Safari-safe background scroll & interaction lock (locks body at current scrollY, marks background inert, restores exact scrollY on X, backdrop tap, or Escape)
 * - Zero em dashes, zero horizontal modal scroll
 */
import { SITE, BOOKING_DELIVERY, BOOKING_MODE } from '../data/site';
import HennaBorderDraw from './HennaBorderDraw.astro';
---

<!-- On-Page Booking Section Card (Content section: centered) -->
<div class="booking-wrap" id="booking-interactive">
  <div class="booking-ornate-card">
    <!-- All-Out Henna Art Wrapping the Booking Card (Top, Sides, Bottom) -->
    <div class="booking-henna-surround" data-henna-box-draw aria-hidden="true">
      <div class="b-henna-edge b-henna-top">
        <div class="b-henna-half"><HennaBorderDraw side="left" /></div>
        <div class="b-henna-half b-henna-mirror"><HennaBorderDraw side="left" /></div>
      </div>
      <div class="b-henna-edge b-henna-bottom">
        <div class="b-henna-half"><HennaBorderDraw side="left" /></div>
        <div class="b-henna-half b-henna-mirror"><HennaBorderDraw side="left" /></div>
      </div>
      <div class="b-henna-edge b-henna-left"><HennaBorderDraw side="left" tiles={2} /></div>
      <div class="b-henna-edge b-henna-right"><HennaBorderDraw side="right" tiles={2} /></div>
    </div>
    <div class="corner-filigree top-left" aria-hidden="true">
      <svg viewBox="0 0 50 50" width="50" height="50" fill="none">
        <path d="M4 46 C4 18, 18 4, 46 4 M11 46 C11 24, 24 11, 46 11" stroke="currentColor" stroke-width="1.4" opacity="0.65"/>
        <circle cx="14" cy="14" r="3.5" fill="#1a999d" stroke="currentColor" stroke-width="1"/>
      </svg>
    </div>
    <div class="corner-filigree top-right" aria-hidden="true">
      <svg viewBox="0 0 50 50" width="50" height="50" fill="none">
        <path d="M46 46 C46 18, 32 4, 4 4 M39 46 C39 24, 26 11, 4 11" stroke="currentColor" stroke-width="1.4" opacity="0.65"/>
        <circle cx="36" cy="14" r="3.5" fill="#1a999d" stroke="currentColor" stroke-width="1"/>
      </svg>
    </div>

    <div class="booking-card-content text-center">
      <div class="section-ornament booking-henna-divider" data-henna-box-draw aria-hidden="true">
        <div class="b-divider-wing"><HennaBorderDraw side="left" /></div>
        <span class="ornament-gem"><span class="teal-diamond">◆</span></span>
        <div class="b-divider-wing b-henna-mirror"><HennaBorderDraw side="left" /></div>
      </div>
      <span class="booking-kicker"><span class="teal-diamond" aria-hidden="true">◆</span> Santa Barbara, CA <span class="teal-diamond" aria-hidden="true">◆</span></span>
      <h2 id="booking-heading" class="booking-title gold-script-text">Book an Appointment</h2>
      <p class="booking-desc">
        Ready for a little boho magic?<br />Book your henna, hair feathers, or hair tinsel appointment today!
      </p>

      <div class="booking-actions-row">
        <button type="button" class="btn btn-primary brush-ribbon-btn" id="open-booking-modal-btn" data-action="book-date">
          <span class="btn-sparkle" aria-hidden="true">✨</span>
          <span>Book Now</span>
          <span class="btn-sparkle" aria-hidden="true">✨</span>
        </button>
      </div>
      <p class="booking-note">Pricing per official price list.<br />Custom group bookings welcomed.</p>
    </div>

    <div class="corner-filigree bottom-left" aria-hidden="true">
      <svg viewBox="0 0 50 50" width="50" height="50" fill="none">
        <path d="M4 4 C4 32, 18 46, 46 46 M11 4 C11 26, 24 39, 46 39" stroke="currentColor" stroke-width="1.4" opacity="0.65"/>
        <circle cx="14" cy="36" r="3.5" fill="#1a999d" stroke="currentColor" stroke-width="1"/>
      </svg>
    </div>
    <div class="corner-filigree bottom-right" aria-hidden="true">
      <svg viewBox="0 0 50 50" width="50" height="50" fill="none">
        <path d="M46 4 C46 32, 32 46, 4 46 M39 4 C39 26, 26 39, 4 39" stroke="currentColor" stroke-width="1.4" opacity="0.65"/>
        <circle cx="36" cy="36" r="3.5" fill="#1a999d" stroke="currentColor" stroke-width="1"/>
      </svg>
    </div>
  </div>
</div>

<!-- Sticky Floating Appointment Button (48x48 circle, appointment chat icon, hides when footer is in view) -->
<div class="sticky-book-wrap is-hidden" id="sticky-book-wrap" aria-hidden="true">
  <button
    type="button"
    class="sticky-book-icon-btn"
    id="sticky-book-btn"
    data-action="book-date"
    aria-label="Book an appointment with Netta"
    title="Book a date"
  >
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
    </svg>
  </button>
</div>

<!-- Accessible Booking Modal (Strictly Left-Aligned, Spacious, Full Mobile Stack) -->
<dialog id="booking-modal" class="booking-modal" aria-labelledby="booking-modal-title">
  <div class="booking-modal-card">
    <header class="booking-modal-head">
      <div class="booking-modal-titles">
        <p class="booking-modal-kicker"><span class="teal-diamond" aria-hidden="true">◆</span> Netta Henna &amp; Feathered Soul <span class="teal-diamond" aria-hidden="true">◆</span></p>
        <h2 id="booking-modal-title" class="booking-modal-title gold-script-text">Book an Appointment</h2>
      </div>
      <!-- Uncircled X close button that rotates on hover/tap -->
      <button type="button" class="booking-modal-close-x" id="booking-modal-close" aria-label="Close booking modal">
        &times;
      </button>
    </header>

    <div class="modal-body">
      <!-- Quick Option 1: DM on Instagram with Circular Instagram Logo Icon Only -->
      <div class="dm-quick-bar">
        <div class="dm-quick-info">
          <span class="dm-badge">Option 1 · Quickest</span>
          <span class="dm-title">DM to Book on Instagram</span>
        </div>
        <a
          href={SITE.instagramUrl}
          target="_blank"
          rel="noopener"
          class="btn-instagram dm-ig-icon-btn"
          aria-label="Direct message Netta on Instagram"
          title="DM to Book @nettahennaandfeatheredsoul"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
          </svg>
        </a>
      </div>

      <div class="method-separator" aria-hidden="true">
        <span><span class="teal-diamond">◆</span> REQUEST APPOINTMENT BELOW <span class="teal-diamond">◆</span></span>
      </div>

      <!-- Appointment Form -->
      <form
        id="booking-request-form"
        class="booking-form"
        data-endpoint={BOOKING_DELIVERY.endpoint}
        data-booking-mode={BOOKING_MODE}
        novalidate
      >
        <!-- Row 1: Name & Phone Number (Mandatory) -->
        <div class="form-grid">
          <div class="form-group">
            <label for="book-name">Your Name <span class="req" aria-hidden="true">*</span></label>
            <input type="text" id="book-name" name="name" required placeholder="First and last name" autocomplete="name" />
            <p class="field-error-msg" id="name-error-msg" hidden></p>
          </div>

          <div class="form-group">
            <label for="book-phone">Phone number <span class="req" aria-hidden="true">*</span></label>
            <input type="tel" id="book-phone" name="phone" required autocomplete="tel" inputmode="tel" placeholder="(555) 123-4567" />
            <p class="field-error-msg" id="phone-error-msg" hidden></p>
          </div>
        </div>

        <!-- Row 2: Email (Optional) & Instagram Handle (Optional) -->
        <div class="form-grid">
          <div class="form-group">
            <label for="book-email">Email (optional)</label>
            <input type="email" id="book-email" name="email" autocomplete="email" placeholder="Email (optional)" />
            <p class="field-error-msg" id="email-error-msg" hidden></p>
          </div>

          <div class="form-group">
            <label for="book-instagram">Instagram handle (optional)</label>
            <input type="text" id="book-instagram" name="instagram" autocomplete="off" placeholder="@handle (optional)" />
          </div>
        </div>

        <!-- Hidden per Netta, Nov 15, 2026, no calendar at all. Do not re-enable without Andrew's approval. -->
        <div class="calendar-collapsible-wrapper" id="calendar-wrapper" hidden style="display: none !important;">
          <span class="field-section-label">Preferred Date</span>
          <button type="button" class="cal-toggle-btn" id="cal-toggle-btn" aria-expanded="false" aria-controls="modal-calendar-block" tabindex="-1">
            <span class="cal-toggle-text" id="cal-toggle-text">📅 Choose a date on the calendar</span>
            <svg class="cal-toggle-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor">
              <path d="M6 9l6 6 6-6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>

          <!-- Calendar Block (Collapsed by default) -->
          <div class="modal-calendar-block is-collapsed" id="modal-calendar-block" hidden style="display: none !important;">
            <div class="schedule-pending-notice">
              <div class="pending-badge-row">
                <span class="pending-pill">Google Calendar</span>
                <span class="pending-status-text">Schedule Pending</span>
              </div>
              <p class="pending-notice-body">
                Netta is setting up her official Google Calendar schedule titled "Book Netta". Select your preferred date below and submit your request. Netta will confirm directly.
              </p>
            </div>

            <div class="calendar-container">
              <header class="calendar-header">
                <div class="calendar-nav">
                  <button type="button" class="cal-nav-btn" id="cal-prev-btn" aria-label="Previous month" tabindex="-1"></button>
                  <h4 class="calendar-month-heading" id="cal-month-title" aria-live="polite">Loading...</h4>
                  <button type="button" class="cal-nav-btn" id="cal-next-btn" aria-label="Next month" tabindex="-1"></button>
                </div>
              </header>

              <div class="calendar-weekdays" aria-hidden="true">
                <span>Sun</span><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span>
              </div>

              <div class="calendar-grid" id="calendar-grid" role="grid" aria-labelledby="cal-month-title"></div>
            </div>
          </div>
        </div>

        <!-- A La Carte Multi-Select Services & Pricing Options -->
        <fieldset class="alacarte-fieldset" id="alacarte-services-fieldset">
          <legend class="alacarte-legend">
            Services (Select one or more) <span class="req" aria-hidden="true">*</span>
          </legend>

          <div class="alacarte-services-list">
            <!-- Service 1: Henna Art -->
            <div class="service-check-block" data-service-block="Henna Art">
              <label class="service-check-label">
                <input
                  type="checkbox"
                  name="services"
                  value="Henna Art"
                  class="service-checkbox"
                  data-service-box="Henna Art"
                />
                <span class="service-check-title">Henna Art</span>
                <!-- 2026-11-17: Netta asked top-level modal service rows not to duplicate prices; restore by uncommenting: <span class="service-check-rate">$20 to $100+</span> -->
              </label>
              <div class="service-suboptions" data-service-options="Henna Art" hidden>
                <p class="suboptions-hint">Choose design size or add-on:</p>
                <div class="suboptions-pills">
                  <label class="modal-opt-pill">
                    <input type="checkbox" name="service_options" value="Henna Art: Small / Simple ($20 to $45)" data-opt-service="Henna Art" data-opt-label="Small / Simple ($20 to $45)" />
                    <span>Small / Simple ($20 to $45)</span>
                  </label>
                  <label class="modal-opt-pill">
                    <input type="checkbox" name="service_options" value="Henna Art: Medium ($50 to $75)" data-opt-service="Henna Art" data-opt-label="Medium ($50 to $75)" />
                    <span>Medium ($50 to $75)</span>
                  </label>
                  <label class="modal-opt-pill">
                    <input type="checkbox" name="service_options" value="Henna Art: Large ($100+)" data-opt-service="Henna Art" data-opt-label="Large ($100+)" />
                    <span>Large ($100+)</span>
                  </label>
                  <label class="modal-opt-pill">
                    <input type="checkbox" name="service_options" value="Henna Art: Add Glitter (FREE)" data-opt-service="Henna Art" data-opt-label="Add Glitter (FREE)" />
                    <span>Add Glitter (FREE)</span>
                  </label>
                </div>
              </div>
            </div>

            <!-- Service 2: Hair Feather Extensions -->
            <div class="service-check-block" data-service-block="Hair Feather Extensions">
              <label class="service-check-label">
                <input
                  type="checkbox"
                  name="services"
                  value="Hair Feather Extensions"
                  class="service-checkbox"
                  data-service-box="Hair Feather Extensions"
                />
                <span class="service-check-title">Hair Feather Extensions</span>
                <!-- 2026-11-17: Netta asked top-level modal service rows not to duplicate prices; restore by uncommenting: <span class="service-check-rate">$10 to $60 + $10 install</span> -->
              </label>
              <div class="service-suboptions" data-service-options="Hair Feather Extensions" hidden>
                <p class="suboptions-hint">Choose feather count (+$10 installation fee):</p>
                <div class="suboptions-pills">
                  <label class="modal-opt-pill">
                    <input type="checkbox" name="service_options" value="Hair Feather Extensions: 1 Feather ($10)" data-opt-service="Hair Feather Extensions" data-opt-label="1 Feather ($10)" />
                    <span>1 Feather ($10)</span>
                  </label>
                  <label class="modal-opt-pill">
                    <input type="checkbox" name="service_options" value="Hair Feather Extensions: 2 Feathers ($18)" data-opt-service="Hair Feather Extensions" data-opt-label="2 Feathers ($18)" />
                    <span>2 Feathers ($18)</span>
                  </label>
                  <label class="modal-opt-pill">
                    <input type="checkbox" name="service_options" value="Hair Feather Extensions: 3 Feathers ($25)" data-opt-service="Hair Feather Extensions" data-opt-label="3 Feathers ($25)" />
                    <span>3 Feathers ($25)</span>
                  </label>
                  <label class="modal-opt-pill">
                    <input type="checkbox" name="service_options" value="Hair Feather Extensions: 5 Feathers ($35)" data-opt-service="Hair Feather Extensions" data-opt-label="5 Feathers ($35)" />
                    <span>5 Feathers ($35)</span>
                  </label>
                  <label class="modal-opt-pill">
                    <input type="checkbox" name="service_options" value="Hair Feather Extensions: 10 Feathers ($60)" data-opt-service="Hair Feather Extensions" data-opt-label="10 Feathers ($60)" />
                    <span>10 Feathers ($60)</span>
                  </label>
                </div>
              </div>
            </div>

            <!-- Service 3: Hair Tinsel Extensions -->
            <div class="service-check-block" data-service-block="Hair Tinsel Extensions">
              <label class="service-check-label">
                <input
                  type="checkbox"
                  name="services"
                  value="Hair Tinsel Extensions"
                  class="service-checkbox"
                  data-service-box="Hair Tinsel Extensions"
                />
                <span class="service-check-title">Hair Tinsel Extensions</span>
                <!-- 2026-11-17: Netta asked top-level modal service rows not to duplicate prices; restore by uncommenting: <span class="service-check-rate">$10 to $30 + $10 install</span> -->
              </label>
              <div class="service-suboptions" data-service-options="Hair Tinsel Extensions" hidden>
                <p class="suboptions-hint">Choose strand bundle (+$10 installation fee):</p>
                <div class="suboptions-pills">
                  <label class="modal-opt-pill">
                    <input type="checkbox" name="service_options" value="Hair Tinsel Extensions: 5 Strands ($10)" data-opt-service="Hair Tinsel Extensions" data-opt-label="5 Strands ($10)" />
                    <span>5 Strands ($10)</span>
                  </label>
                  <label class="modal-opt-pill">
                    <input type="checkbox" name="service_options" value="Hair Tinsel Extensions: 10 Strands ($12)" data-opt-service="Hair Tinsel Extensions" data-opt-label="10 Strands ($12)" />
                    <span>10 Strands ($12)</span>
                  </label>
                  <label class="modal-opt-pill">
                    <input type="checkbox" name="service_options" value="Hair Tinsel Extensions: 15 Strands ($15)" data-opt-service="Hair Tinsel Extensions" data-opt-label="15 Strands ($15)" />
                    <span>15 Strands ($15)</span>
                  </label>
                  <label class="modal-opt-pill">
                    <input type="checkbox" name="service_options" value="Hair Tinsel Extensions: 20 Strands ($20)" data-opt-service="Hair Tinsel Extensions" data-opt-label="20 Strands ($20)" />
                    <span>20 Strands ($20)</span>
                  </label>
                  <label class="modal-opt-pill">
                    <input type="checkbox" name="service_options" value="Hair Tinsel Extensions: 30 Strands ($30)" data-opt-service="Hair Tinsel Extensions" data-opt-label="30 Strands ($30)" />
                    <span>30 Strands ($30)</span>
                  </label>
                </div>
              </div>
            </div>
          </div>
          <p class="service-error-msg" id="service-error-msg" hidden>Please select at least one service.</p>
        </fieldset>

        <!-- Hidden per Netta, Nov 15, 2026, no calendar at all. Do not re-enable without Andrew's approval. -->
        <div class="form-group" hidden style="display: none !important;">
          <label for="book-date">Selected Date</label>
          <input type="text" id="book-date" name="date" readonly placeholder="Pick a date above or coordinate via DM" tabindex="-1" hidden />
        </div>

        <!-- Row 3: Preferred Date and Time & Notes (Stacked full-width on mobile, 2-col on desktop) -->
        <div class="form-grid">
          <div class="form-group">
            <label for="book-preferred-time">Preferred date and time</label>
            <input
              type="text"
              id="book-preferred-time"
              name="preferred_time"
              placeholder="e.g. Saturday at 2pm"
            />
          </div>

          <div class="form-group">
            <label for="book-message">Notes or design ideas</label>
            <input type="text" id="book-message" name="message" placeholder="Design or placement notes" />
          </div>
        </div>

        <!-- Consent line directly above submit button -->
        <p class="form-consent-text">
          By submitting, you agree Netta may text you about this appointment.
        </p>

        <!-- Configuration notice if 3A SMS number is not configured -->
        <p class="field-error-msg form-general-error" id="booking-config-error" hidden></p>

        <div class="form-actions">
          <button type="submit" class="btn btn-primary modal-submit-btn brush-ribbon-btn" id="booking-submit-btn">
            <span class="btn-sparkle" aria-hidden="true">✨</span>
            <span>Send Appointment Request</span>
            <span class="btn-sparkle" aria-hidden="true">✨</span>
          </button>
        </div>
      </form>

      <!-- Confirmation Notice (Left-Aligned inside Modal) -->
      <div id="booking-confirm-box" class="booking-confirm-box" hidden>
        <div class="confirm-head-row">
          <div class="confirm-icon" id="confirm-icon" aria-hidden="true">✓</div>
          <h4 class="confirm-title" id="confirm-title" role="status">Request Received!</h4>
        </div>
        <p class="confirm-desc" id="confirm-desc">
          Thank you. Netta will reach out directly to confirm availability and finalize your appointment.
        </p>

        <!-- 3A Flip the Flow Interactive Messages & Copy Fallback (Shown when BOOKING_MODE === 'sms') -->
        <div id="sms-flow-details" class="sms-flow-details" hidden>
          <div class="sms-action-banner">
            <span class="sms-banner-badge">Step 2 of 2</span>
            <p class="sms-banner-instruction">
              Your appointment request is prefilled in Messages. <strong>Tap Send in your Messages app</strong> to send it to Netta.
            </p>
          </div>

          <div class="sms-fallback-wrap">
            <label for="sms-fallback-textarea" class="sms-fallback-label">
              If Messages didn't open automatically, copy this message and text it to <strong id="sms-target-phone-display">Netta</strong>:
            </label>
            <textarea id="sms-fallback-textarea" class="sms-fallback-textarea" readonly rows="5" tabindex="-1"></textarea>
            <div class="sms-fallback-actions">
              <button type="button" class="btn btn-primary btn-copy-sms" id="btn-copy-sms">
                📋 Copy Message
              </button>
              <a href="#" class="btn btn-secondary btn-open-sms" id="btn-open-sms">
                💬 Open Messages
              </a>
            </div>
          </div>
        </div>

        <!-- 3B Direct Email Summary (Shown when BOOKING_MODE === 'email') -->
        <div class="confirm-details" id="confirm-details-summary" hidden></div>

        <button type="button" class="btn btn-secondary confirm-close-btn" id="confirm-close-btn">
          <span class="btn-sparkle" aria-hidden="true">✨</span>
          <span>Done</span>
          <span class="btn-sparkle" aria-hidden="true">✨</span>
        </button>
      </div>
    </div>
  </div>
</dialog>

<style>
  /* ── Standalone On-Page Booking Card (Content Section: Centered) ── */
  .booking-wrap {
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
  }

  .booking-ornate-card {
    position: relative;
    background: var(--surface);
    border: 2px solid var(--brand-gold);
    outline: 1.5px solid var(--brand-gold-border);
    outline-offset: 5px;
    border-radius: 28px;
    padding: 3.25rem 2.25rem;
    box-shadow: 0 12px 40px rgba(61, 40, 23, 0.08);
    text-align: center;
    overflow: hidden;
  }

  .corner-filigree {
    position: absolute;
    color: var(--brand-gold);
    pointer-events: none;
    z-index: 1;
