    z-index: 2;
    text-align: center;
  }

  .booking-henna-surround {
    position: absolute;
    inset: 0;
    pointer-events: none !important;
    overflow: hidden;
    z-index: 0;
    opacity: 0.72;
    border-radius: inherit;
  }

  :global([data-theme="dark"]) .booking-henna-surround {
    opacity: 0.52;
  }

  .b-henna-edge {
    position: absolute;
    pointer-events: none !important;
    overflow: hidden;
  }

  .b-henna-left {
    top: 0;
    bottom: 0;
    left: 0;
    width: 48px;
    -webkit-mask-image: linear-gradient(90deg, rgba(0,0,0,0.88) 0%, rgba(0,0,0,0.5) 62%, transparent 100%);
    mask-image: linear-gradient(90deg, rgba(0,0,0,0.88) 0%, rgba(0,0,0,0.5) 62%, transparent 100%);
  }

  .b-henna-right {
    top: 0;
    bottom: 0;
    right: 0;
    width: 48px;
    -webkit-mask-image: linear-gradient(270deg, rgba(0,0,0,0.88) 0%, rgba(0,0,0,0.5) 62%, transparent 100%);
    mask-image: linear-gradient(270deg, rgba(0,0,0,0.88) 0%, rgba(0,0,0,0.5) 62%, transparent 100%);
  }

  .b-henna-left :global(.henna-art-svg),
  .b-henna-right :global(.henna-art-svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .b-henna-top,
  .b-henna-bottom {
    left: 0;
    right: 0;
    height: 40px;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .b-henna-top {
    top: 0;
    -webkit-mask-image: linear-gradient(180deg, rgba(0,0,0,0.82) 0%, rgba(0,0,0,0.45) 65%, transparent 100%);
    mask-image: linear-gradient(180deg, rgba(0,0,0,0.82) 0%, rgba(0,0,0,0.45) 65%, transparent 100%);
  }

  .b-henna-bottom {
    bottom: 0;
    -webkit-mask-image: linear-gradient(0deg, rgba(0,0,0,0.82) 0%, rgba(0,0,0,0.45) 65%, transparent 100%);
    mask-image: linear-gradient(0deg, rgba(0,0,0,0.82) 0%, rgba(0,0,0,0.45) 65%, transparent 100%);
  }

  .b-henna-half {
    width: 540px;
    height: 40px;
    position: relative;
    flex-shrink: 0;
    overflow: hidden;
  }

  .b-henna-mirror {
    transform: scaleX(-1);
  }

  .b-henna-top .b-henna-half :global(.henna-art-svg) {
    width: 40px !important;
    height: 540px !important;
    position: absolute !important;
    left: 50% !important;
    top: 50% !important;
    transform: translate(-50%, -50%) rotate(90deg) scaleY(-1) !important;
  }

  .b-henna-bottom .b-henna-half :global(.henna-art-svg) {
    width: 40px !important;
    height: 540px !important;
    position: absolute !important;
    left: 50% !important;
    top: 50% !important;
    transform: translate(-50%, -50%) rotate(-90deg) !important;
  }

  .booking-henna-divider {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    height: 56px;
    margin: 0 auto 0.85rem;
    max-width: 520px;
    overflow: hidden;
    opacity: 0.85;
  }

  .booking-henna-divider .ornament-gem :global(.teal-diamond) {
    margin: 0 !important;
  }

  .b-divider-wing {
    flex: 1;
    height: 48px;
    position: relative;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 14%, #000 100%);
    mask-image: linear-gradient(90deg, transparent 0%, #000 14%, #000 100%);
  }

  .b-divider-wing :global(.henna-art-svg) {
    width: 44px !important;
    height: 440px !important;
    position: absolute !important;
    left: calc(100% - 220px + 6px) !important;
    top: 50% !important;
    transform: translate(-50%, -50%) rotate(-90deg) scaleY(-1) !important;
  }

  @media (max-width: 640px) {
    .booking-henna-surround {
      opacity: 0.42;
    }
    .b-henna-left,
    .b-henna-right {
      width: 28px;
    }
    .booking-henna-divider {
      height: 42px;
    }
    .b-divider-wing :global(.henna-art-svg) {
      width: 38px !important;
      height: 380px !important;
      left: calc(100% - 190px + 5px) !important;
    }
  }

  .booking-kicker {
    font-family: var(--font-body);
    font-size: 0.86rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink);
    display: inline-block;
    margin-bottom: 0.25rem;
    text-align: center;
  }

  .booking-title {
    font-size: clamp(2.8rem, 6vw, 3.8rem);
    margin: 0 0 0.25rem;
    line-height: 1.45 !important;
    padding-top: 0.25em !important;
    padding-bottom: 0.2em !important;
    overflow: visible !important;
    text-align: center;
  }

  .booking-desc {
    font-family: var(--font-display, 'Cormorant Garamond', Georgia, serif);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--ink);
    line-height: 1.55;
    margin: 0 auto 1.75rem;
    max-width: 58ch;
    text-align: center;
  }

  .booking-actions-row {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 1.15rem;
  }

  .booking-note {
    font-family: var(--font-display, 'Cormorant Garamond', Georgia, serif);
    font-size: 1.08rem;
    font-weight: 600;
    color: var(--ink);
    font-style: normal;
    line-height: 1.45;
    margin: 0;
    text-align: center;
  }

  /* ── Sticky Floating Calendar Icon Circle (48x48, icon only, safe-area padded & floating cleanly) ── */
  .sticky-book-wrap {
    position: fixed;
    bottom: calc(env(safe-area-inset-bottom, 0px) + 1.5rem);
    right: 1.5rem;
    z-index: 95;
    display: flex;
    align-items: center;
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  .sticky-book-wrap.is-hidden {
    opacity: 0 !important;
    pointer-events: none !important;
    transform: translateY(24px) !important;
  }

  .sticky-book-wrap.is-hidden-footer {
    opacity: 0 !important;
    pointer-events: none !important;
    transform: translateY(24px) !important;
  }

  .sticky-book-icon-btn {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    width: 48px !important;
    min-width: 48px !important;
    max-width: 48px !important;
    height: 48px !important;
    min-height: 48px !important;
    max-height: 48px !important;
    padding: 0 !important;
    border-radius: 50% !important;
    background: var(--brand-teal) !important;
    color: var(--color-accent-text, #ffffff) !important;
    border: 1.5px solid var(--brand-gold) !important;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.24) !important;
    cursor: pointer;
    transition: transform 0.25s ease-in-out, background-color 0.2s ease, box-shadow 0.2s ease !important;
  }

  .sticky-book-icon-btn:hover {
    background: var(--brand-teal-hover) !important;
    transform: translateY(-2px) scale(1.04);
    box-shadow: 0 8px 24px var(--brand-teal-glow) !important;
  }

  @media (max-width: 640px) {
    .sticky-book-wrap {
      bottom: calc(env(safe-area-inset-bottom, 0px) + 1.25rem);
      right: 1.25rem;
    }
    .booking-ornate-card {
      padding: 2.35rem 1.15rem;
      border-radius: 22px;
      outline-offset: 3px;
    }
    .corner-filigree svg {
      width: 36px;
      height: 36px;
    }
    .corner-filigree.top-left { top: 8px; left: 8px; }
    .corner-filigree.top-right { top: 8px; right: 8px; }
    .corner-filigree.bottom-left { bottom: 8px; left: 8px; }
    .corner-filigree.bottom-right { bottom: 8px; right: 8px; }
  }

  /* ── Pass 8: Spacious, Calm Booking Modal & Full-Screen Backdrop Lock ── */
  :global(html.modal-open),
  :global(body.modal-open) {
    overflow: hidden !important;
    overscroll-behavior: none !important;
  }

  .booking-modal {
    border: none;
    border-radius: 26px;
    padding: 0;
    max-width: 620px;
    width: calc(100% - 1.5rem);
    max-height: 90vh;
    background: transparent;
    color: var(--ink);
    box-shadow: 0 28px 70px rgba(0, 0, 0, 0.45);
    overflow: hidden;
    text-align: left;
    opacity: 0;
    transform: translateY(14px) scale(0.96);
    transition:
      opacity 0.28s ease-in-out,
      transform 0.28s ease-in-out;
    will-change: opacity, transform;
  }

  .booking-modal.is-visible {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .booking-modal.is-closing {
    opacity: 0;
    transform: translateY(12px) scale(0.96);
    pointer-events: none;
  }

  /* Full-screen backdrop covering Dynamic Island / status bar and blocking all background taps */
  .booking-modal::backdrop {
    position: fixed;
    top: -120px;
    left: -120px;
    right: -120px;
    bottom: -120px;
    background: rgba(18, 14, 11, 0.74);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    overscroll-behavior: none;
    touch-action: none;
    opacity: 0;
    transition: opacity 0.28s ease-in-out;
  }

  .booking-modal.is-visible::backdrop {
    opacity: 1;
  }

  .booking-modal.is-closing::backdrop {
    opacity: 0;
  }

  .booking-modal-card {
    background: var(--surface);
    border: 2px solid var(--brand-gold);
    border-radius: 26px;
    padding: 2rem 2rem 2.25rem;
    max-height: 90vh;
    overflow-y: auto;
    overflow-x: hidden;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    box-sizing: border-box;
    text-align: left;
  }

  @media (max-width: 640px) {
    .booking-modal {
      width: calc(100% - 1.25rem);
      max-height: 92dvh;
      border-radius: 24px;
    }

    .booking-modal-card {
      padding: 1.5rem 1.25rem 1.75rem;
      max-height: 92dvh;
      border-radius: 24px;
    }
  }

  .booking-modal-head {
    position: relative;
    display: block;
    margin-bottom: 1.35rem;
    padding: 0 3rem 1rem;
    border-bottom: 1px solid var(--gold-border);
    text-align: center;
  }

  .booking-modal-titles {
    text-align: center;
    overflow: visible;
  }

  .booking-modal-kicker {
    margin: 0 0 0.2rem;
    font-family: var(--font-body);
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink);
    text-align: center;
    white-space: nowrap;
  }

  .booking-modal-title {
    margin: 0;
    font-size: clamp(2rem, 5.5vw, 2.45rem);
    line-height: 1.45 !important;
    padding-top: 0.25em !important;
    padding-bottom: 0.2em !important;
    overflow: visible !important;
    text-align: center;
  }

  /* Uncircled rotating X close button */
  .booking-modal-close-x {
    position: absolute;
    top: 0;
    right: 0;
    background: transparent !important;
    border: none !important;
    outline: none !important;
    box-shadow: none !important;
    color: var(--ink);
    font-size: 2rem;
    line-height: 1;
    width: 40px;
    height: 40px;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: transform 0.25s ease, color 0.2s ease;
    flex-shrink: 0;
  }

  .booking-modal-close-x:hover,
  .booking-modal-close-x:focus-visible {
    transform: rotate(90deg);
    color: var(--brand-teal);
    outline: none !important;
    box-shadow: none !important;
  }

  .booking-form[hidden],
  .booking-confirm-box[hidden],
  .service-suboptions[hidden],
  .modal-calendar-block[hidden],
  .service-error-msg[hidden] {
    display: none !important;
  }

  /* Option 1 Box: DM to Book on Instagram with 48x48 Circular Instagram Logo Icon */
  .dm-quick-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    background: var(--brand-cream-surface);
    border: 1.5px solid var(--gold-border);
    border-radius: 16px;
    padding: 0.95rem 1.15rem;
    margin-bottom: 1.35rem;
    text-align: left;
  }

  .dm-quick-info {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    text-align: left;
  }

  .dm-badge {
    font-family: var(--font-section);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--brand-gold);
    font-weight: 600;
    text-align: left;
  }

  .dm-title {
    font-family: var(--font-section);
    font-size: 1.22rem;
    font-weight: 600;
    color: var(--ink);
    text-align: left;
    line-height: 1.25;
  }

  .dm-ig-icon-btn {
    flex-shrink: 0;
  }

  .method-separator {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    gap: 0.65rem;
    margin: 1rem 0;
    color: var(--brand-gold);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-align: center;
  }
  .method-separator > span { flex: 0 0 auto; white-space: nowrap; }
  .method-separator::before,
  .method-separator::after {
    content: '';
    flex: 0 0 64px;
    width: 64px;
    height: 1px;
    background: var(--gold-border);
  }
  @media (max-width: 640px) {
    .method-separator { font-size: 0.64rem; letter-spacing: 0.06em; gap: 0.4rem; }
    .method-separator::before,
    .method-separator::after {
      flex: 0 0 28px;
      width: 28px;
    }
  }

  /* ── Form & A La Carte Multi-Select Styles (Spacious & Left-Aligned) ── */
  .booking-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    text-align: left;
  }

  /* Two-column on desktop (> 640px), Full-Width 1-column stack on mobile (<= 640px) */
  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.15rem;
  }

  @media (max-width: 640px) {
    .form-grid {
      grid-template-columns: 1fr;
      gap: 1.15rem;
    }
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    text-align: left;
  }

  .form-group label,
  .field-section-label,
  .alacarte-legend {
    font-family: var(--font-display, 'Cormorant Garamond', Georgia, serif);
    font-size: 1.08rem;
    font-weight: 600;
    color: var(--ink);
    text-align: left;
    letter-spacing: 0.01em;
  }

  .req {
    color: #dc2626 !important;
  }

  /* Inline Field Error Messages */
  .field-error-msg {
    font-family: var(--font-body);
    font-size: 0.88rem;
    font-weight: 500;
    color: #dc2626;
    margin: 0.2rem 0 0;
    line-height: 1.4;
    text-align: left;
  }
  [data-theme="dark"] .field-error-msg {
    color: #f87171;
  }

  /* Consent line above submit button */
  .form-consent-text {
    font-family: var(--font-body);
    font-size: 0.88rem;
    color: var(--ink);
    opacity: 0.8;
    margin: 0.65rem 0 0.25rem;
    line-height: 1.45;
    text-align: left;
  }

  /* Generous 52px+ Input Heights & Internal Padding */
  input[type="text"],
  input[type="tel"],
  input[type="email"],
  textarea {
    width: 100%;
    min-height: 52px;
    height: 52px;
    background: var(--surface);
    border: 1.5px solid var(--gold-border);
    border-radius: 12px;
    padding: 0.75rem 1rem;
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--ink);
    box-sizing: border-box;
    text-align: left;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  input[type="text"]:focus,
  input[type="tel"]:focus,
  input[type="email"]:focus,
  textarea:focus {
    outline: none;
    border-color: var(--brand-teal);
    box-shadow: 0 0 0 3px var(--brand-teal-glow);
  }

  /* Collapsible Calendar Trigger (52px tall) */
  .calendar-collapsible-wrapper {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    text-align: left;
  }

  .cal-toggle-btn {
    width: 100%;
    min-height: 52px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: var(--surface);
    border: 1.5px solid var(--brand-gold-border);
    border-radius: 12px;
    padding: 0.75rem 1rem;
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 500;
    color: var(--ink);
    cursor: pointer;
    text-align: left;
    transition: all 0.2s ease;
  }

  .cal-toggle-btn:hover {
    border-color: var(--brand-teal);
    background: var(--brand-teal-light);
  }

  .cal-toggle-icon {
    transition: transform 0.25s ease-in-out;
    flex-shrink: 0;
  }
  .cal-toggle-btn[aria-expanded="true"] .cal-toggle-icon {
    transform: rotate(180deg);
  }

  .modal-calendar-block {
    margin-top: 0;
    border: 0 solid var(--gold-border);
    border-radius: 16px;
    padding: 0 1.15rem;
    background: var(--surface);
    text-align: left;
    max-height: 0;
    opacity: 0;
    transform: translateY(-6px);
    overflow: hidden;
    transition:
      max-height 0.26s ease-in-out,
      opacity 0.24s ease-in-out,
      transform 0.24s ease-in-out,
      padding 0.24s ease-in-out,
      margin-top 0.24s ease-in-out,
      border-width 0.24s ease-in-out;
  }

  .modal-calendar-block.is-expanded {
    margin-top: 0.5rem;
    border-width: 1.5px;
    padding: 1.15rem;
    max-height: 520px;
    opacity: 1;
    transform: translateY(0);
  }

  .schedule-pending-notice {
    background: var(--brand-teal-light);
    border-left: 3px solid var(--brand-teal);
    border-radius: 10px;
    padding: 0.75rem 0.95rem;
    margin-bottom: 1rem;
    text-align: left;
  }

  .pending-badge-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.3rem;
  }

  .pending-pill {
    background: var(--brand-teal);
    color: #ffffff;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.15rem 0.5rem;
    border-radius: 9999px;
    text-transform: uppercase;
  }

  .pending-status-text {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--brand-teal);
  }

  .pending-notice-body {
    margin: 0;
    font-size: 0.84rem;
    color: var(--ink);
    line-height: 1.45;
    text-align: left;
  }

  .calendar-header {
    margin-bottom: 0.65rem;
  }

  .calendar-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .cal-nav-btn {
    background: var(--surface-2);
    border: 1px solid var(--gold-border);
    color: var(--ink);
    border-radius: 8px;
    padding: 0.35rem 0.75rem;
    cursor: pointer;
  }

  .calendar-month-heading {
    margin: 0;
    font-family: var(--font-section);
    font-size: 1.15rem;
    color: var(--ink);
  }

  .calendar-weekdays {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    text-align: center;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--brand-gold);
    margin-bottom: 0.45rem;
  }

  .calendar-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 5px;
  }

  :global(.cal-day) {
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--hairline);
    border-radius: 8px;
    background: var(--surface);
    color: var(--ink);
    font-size: 0.85rem;
    cursor: pointer;
    transition: all 0.15s ease;
    padding: 0;
  }

  :global(.cal-day:hover:not(:disabled)) {
    background: var(--brand-teal-light);
    border-color: var(--brand-teal);
    color: var(--brand-teal);
  }

  :global(.cal-day.is-selected) {
    background: var(--brand-teal) !important;
    color: #ffffff !important;
    border-color: var(--brand-teal) !important;
    font-weight: 700;
  }

  :global(.cal-day.is-past) {
    opacity: 0.35;
    cursor: not-allowed;
    background: transparent;
  }

  :global(.cal-day.is-empty) {
    border: none;
    background: transparent;
  }

  /* A La Carte Multi-Select Checkboxes with Generous Spacing */
  .alacarte-fieldset {
    border: none;
    margin: 0;
    padding: 0;
    min-width: 0;
    width: 100%;
    text-align: left;
  }

  .alacarte-legend {
    margin-bottom: 0.55rem;
    padding: 0;
    display: block;
    width: 100%;
  }

  .alacarte-services-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: 100%;
  }

  .service-check-block {
    border: 1.5px solid var(--gold-border);
    border-radius: 14px;
