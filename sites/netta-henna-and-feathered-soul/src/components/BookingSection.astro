---
/**
 * BookingSection.astro
 * Netta Henna and Feathered Soul - Booking Card, Sticky CTA & Modal
 * 
 * Features:
 * - Two booking methods: DM on Instagram or Calendar Request
 * - Calendar collapsed by default until visitor taps to select a date
 * - Schedule Pending banner (honest Google Calendar schedule notice, zero fake dates)
 * - Modal X close button has no circle, rotates 90deg on hover/tap
 * - Reset service selection on each modal open
 * - Sticky Book button hides when footer is in view (no overlapping buttons)
 * - Zero em dashes, zero horizontal modal scroll
 */
import { SITE } from '../data/site';
---

<!-- On-Page Booking Section Card -->
<div class="booking-wrap" id="booking-interactive">
  <div class="booking-ornate-card">
    <div class="corner-filigree top-left" aria-hidden="true">
      <svg viewBox="0 0 50 50" width="50" height="50" fill="none">
        <path d="M4 46 C4 18, 18 4, 46 4" stroke="currentColor" stroke-width="1.4" opacity="0.6"/>
        <circle cx="14" cy="14" r="2.5" fill="currentColor"/>
      </svg>
    </div>
    <div class="corner-filigree top-right" aria-hidden="true">
      <svg viewBox="0 0 50 50" width="50" height="50" fill="none">
        <path d="M46 46 C46 18, 32 4, 4 4" stroke="currentColor" stroke-width="1.4" opacity="0.6"/>
        <circle cx="36" cy="14" r="2.5" fill="currentColor"/>
      </svg>
    </div>

    <div class="booking-card-content text-center">
      <span class="booking-kicker">✦ Santa Barbara, CA ✦</span>
      <h3 class="booking-title gold-script-text">Book an Appointment</h3>
      <p class="booking-desc">
        Direct and personal booking with Netta. Connect via Instagram DM for quick confirmation or choose a date to request an appointment.
      </p>

      <div class="booking-actions-row">
        <button type="button" class="btn btn-primary" id="open-booking-modal-btn" data-action="book-date">
          Book an Appointment
        </button>
        <a
          href={SITE.instagramUrl}
          target="_blank"
          rel="noopener"
          class="btn-instagram"
          aria-label="Direct message Netta on Instagram"
          title="DM to Book @nettahennaandfeatheredsoul"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
          </svg>
        </a>
      </div>
      <p class="booking-note">Pricing per official price list. Custom group bookings welcomed.</p>
    </div>

    <div class="corner-filigree bottom-left" aria-hidden="true">
      <svg viewBox="0 0 50 50" width="50" height="50" fill="none">
        <path d="M4 4 C4 32, 18 46, 46 46" stroke="currentColor" stroke-width="1.4" opacity="0.6"/>
        <circle cx="14" cy="36" r="2.5" fill="currentColor"/>
      </svg>
    </div>
    <div class="corner-filigree bottom-right" aria-hidden="true">
      <svg viewBox="0 0 50 50" width="50" height="50" fill="none">
        <path d="M46 4 C46 32, 32 46, 4 46" stroke="currentColor" stroke-width="1.4" opacity="0.6"/>
        <circle cx="36" cy="36" r="2.5" fill="currentColor"/>
      </svg>
    </div>
  </div>
</div>

<!-- Sticky Floating Book Button (hides when footer is in view) -->
<div class="sticky-book-wrap" id="sticky-book-wrap" aria-hidden="true">
  <button type="button" class="sticky-book-btn" id="sticky-book-btn" data-action="book-date" aria-label="Book an appointment with Netta">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
      <line x1="16" y1="2" x2="16" y2="6"></line>
      <line x1="8" y1="2" x2="8" y2="6"></line>
      <line x1="3" y1="10" x2="21" y2="10"></line>
    </svg>
    <span>Book a date</span>
  </button>
</div>

<!-- Accessible Booking Modal -->
<dialog id="booking-modal" class="booking-modal" aria-labelledby="booking-modal-title">
  <div class="booking-modal-card">
    <header class="booking-modal-head">
      <div class="booking-modal-titles">
        <p class="booking-modal-kicker">✦ Netta Henna &amp; Feathered Soul ✦</p>
        <h2 id="booking-modal-title" class="booking-modal-title gold-script-text">Book an Appointment</h2>
      </div>
      <!-- Uncircled X close button that rotates on hover/tap -->
      <button type="button" class="booking-modal-close-x" id="booking-modal-close" aria-label="Close booking modal">
        &times;
      </button>
    </header>

    <div class="modal-body">
      <!-- Quick Option: DM on Instagram -->
      <div class="dm-quick-bar">
        <div class="dm-quick-info">
          <span class="dm-badge">Option 1 · Quickest</span>
          <span class="dm-title">DM to Book on Instagram</span>
        </div>
        <a
          href={SITE.instagramUrl}
          target="_blank"
          rel="noopener"
          class="teal-brush-banner dm-quick-btn"
          aria-label="Direct message Netta on Instagram"
        >
          DM Netta &rarr;
        </a>
      </div>

      <div class="method-separator" aria-hidden="true">
        <span>✦ OR REQUEST APPOINTMENT BELOW ✦</span>
      </div>

      <!-- Collapsible Calendar Trigger -->
      <div class="calendar-collapsible-wrapper">
        <button type="button" class="cal-toggle-btn" id="cal-toggle-btn" aria-expanded="false" aria-controls="modal-calendar-block">
          <span class="cal-toggle-text">📅 Choose a date on the calendar</span>
          <svg class="cal-toggle-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor">
            <path d="M6 9l6 6 6-6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>

        <!-- Calendar Block (Collapsed by default) -->
        <div class="modal-calendar-block is-collapsed" id="modal-calendar-block" hidden>
          <div class="schedule-pending-notice">
            <div class="pending-badge-row">
              <span class="pending-pill">Google Calendar</span>
              <span class="pending-status-text">Schedule Pending</span>
            </div>
            <p class="pending-notice-body">
              Netta is setting up her official Google Calendar schedule titled "Book Netta". Select your preferred date below and submit your request. Netta will confirm directly.
            </p>
          </div>

          <div class="calendar-container">
            <header class="calendar-header">
              <div class="calendar-nav">
                <button type="button" class="cal-nav-btn" id="cal-prev-btn" aria-label="Previous month">&larr;</button>
                <h4 class="calendar-month-heading" id="cal-month-title" aria-live="polite">Loading...</h4>
                <button type="button" class="cal-nav-btn" id="cal-next-btn" aria-label="Next month">&rarr;</button>
              </div>
            </header>

            <div class="calendar-weekdays" aria-hidden="true">
              <span>Sun</span><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span>
            </div>

            <div class="calendar-grid" id="calendar-grid" role="grid" aria-labelledby="cal-month-title"></div>
          </div>
        </div>
      </div>

      <!-- Appointment Form -->
      <form id="booking-request-form" class="booking-form">
        <div class="form-grid">
          <div class="form-group">
            <label for="book-name">Your Name <span class="req" aria-hidden="true">*</span></label>
            <input type="text" id="book-name" name="name" required placeholder="First and last name" autocomplete="name" />
          </div>

          <div class="form-group">
            <label for="book-contact">Contact (Instagram or Email) <span class="req" aria-hidden="true">*</span></label>
            <input type="text" id="book-contact" name="contact" required placeholder="@handle or email" />
          </div>
        </div>

        <div class="form-grid">
          <div class="form-group">
            <label for="book-service">Service <span class="req" aria-hidden="true">*</span></label>
            <select id="book-service" name="service" required>
              <option value="" disabled selected>Select a service</option>
              <option value="Henna Art">Henna Art ($20 to $100+)</option>
              <option value="Hair Feathers">Hair Feather Extensions ($10 to $60)</option>
              <option value="Hair Tinsel">Hair Tinsel Extensions ($10 to $30)</option>
              <option value="Combination Offering">Combination Offering</option>
            </select>
          </div>

          <div class="form-group">
            <label for="book-date">Selected Date</label>
            <input type="text" id="book-date" name="date" readonly placeholder="Pick date above or coordinate via DM" />
          </div>
        </div>

        <div class="form-group">
          <label for="book-message">Notes, placement, or design ideas</label>
          <textarea id="book-message" name="message" rows="2" placeholder="Tell Netta about placement, design ideas, or preferred timing."></textarea>
        </div>

        <div class="form-actions">
          <button type="submit" class="btn btn-primary" id="booking-submit-btn">
            Send Appointment Request
          </button>
        </div>
      </form>

      <!-- Confirmation Notice -->
      <div id="booking-confirm-box" class="booking-confirm-box" hidden>
        <div class="confirm-icon" aria-hidden="true">✓</div>
        <h4 class="confirm-title" role="status">Request Received!</h4>
        <p class="confirm-desc">
          Thank you. Netta will reach out directly to confirm availability and discuss pricing for your session.
        </p>
        <div class="confirm-details" id="confirm-details-summary"></div>
        <button type="button" class="btn btn-secondary" id="confirm-close-btn">
          Done
        </button>
      </div>
    </div>
  </div>
</dialog>

<style>
  /* ── Standalone On-Page Booking Card ── */
  .booking-wrap {
    max-width: 760px;
    margin: 0 auto;
  }

  .booking-ornate-card {
    position: relative;
    background: var(--surface);
    border: 1.5px solid var(--brand-gold);
    border-radius: 28px;
    padding: 3.5rem 2.5rem;
    box-shadow: 0 12px 40px rgba(61, 40, 23, 0.08);
  }

  .corner-filigree {
    position: absolute;
    color: var(--brand-gold);
    pointer-events: none;
  }
  .corner-filigree.top-left { top: 12px; left: 12px; }
  .corner-filigree.top-right { top: 12px; right: 12px; }
  .corner-filigree.bottom-left { bottom: 12px; left: 12px; }
  .corner-filigree.bottom-right { bottom: 12px; right: 12px; }

  .booking-kicker {
    font-family: var(--font-section);
    font-size: 0.85rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--brand-gold);
    display: inline-block;
    margin-bottom: 0.5rem;
  }

  .booking-title {
    font-size: clamp(2.8rem, 6vw, 3.8rem);
    margin: 0 0 0.5rem;
    line-height: 1.15;
  }

  .booking-desc {
    font-size: 1.05rem;
    color: var(--muted);
    line-height: 1.6;
    margin: 0 auto 2rem;
    max-width: 48ch;
  }

  .booking-actions-row {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 1.25rem;
  }

  .booking-note {
    font-size: 0.85rem;
    color: var(--muted);
    font-style: italic;
    margin: 0;
  }

  /* ── Sticky Floating Book Button ── */
  .sticky-book-wrap {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    z-index: 99;
    display: flex;
    align-items: center;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  .sticky-book-wrap.is-hidden-footer {
    opacity: 0 !important;
    pointer-events: none !important;
    transform: translateY(24px) !important;
  }

  .sticky-book-btn {
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.22) !important;
  }

  @media (max-width: 640px) {
    .sticky-book-wrap {
      bottom: 1rem;
      right: 1rem;
    }
    .booking-ornate-card {
      padding: 2.5rem 1.25rem;
      border-radius: 20px;
    }
    .corner-filigree {
      display: none;
    }
  }

  /* ── Booking Modal & Dialog ── */
  .booking-modal {
    border: none;
    border-radius: 24px;
    padding: 0;
    max-width: 620px;
    width: calc(100% - 2rem);
    background: transparent;
    color: var(--ink);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.35);
    overflow-x: hidden;
  }

  .booking-modal::backdrop {
    background: rgba(24, 19, 16, 0.65);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .booking-modal-card {
    background: var(--surface);
    border: 1.5px solid var(--brand-gold);
    border-radius: 24px;
    padding: 1.35rem 1.75rem;
    max-height: 90vh;
    overflow-y: auto;
    overflow-x: hidden;
    box-sizing: border-box;
  }

  @media (max-width: 520px) {
    .booking-modal-card {
      padding: 1.1rem 0.9rem;
    }
  }

  .booking-modal-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 0.75rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--gold-border);
  }

  .booking-modal-kicker {
    margin: 0;
    font-family: var(--font-section);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--brand-gold);
  }

  .booking-modal-title {
    margin: 0.1rem 0;
    font-size: 1.85rem;
    line-height: 1.15;
  }

  .booking-modal-subtitle {
    margin: 0;
    font-size: 0.82rem;
    color: var(--muted);
    font-style: italic;
  }

  /* Uncircled rotating X close button */
  .booking-modal-close-x {
    background: transparent;
    border: none;
    color: var(--ink);
    font-size: 1.8rem;
    line-height: 1;
    width: 32px;
    height: 32px;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: transform 0.25s ease, color 0.2s ease;
  }

  .booking-modal-close-x:hover,
  .booking-modal-close-x:focus-visible {
    transform: rotate(90deg);
    color: var(--brand-teal);
  }

  .dm-quick-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    background: var(--brand-cream-surface);
    border: 1px solid var(--gold-border);
    border-radius: 12px;
    padding: 0.5rem 0.85rem;
    margin-bottom: 0.35rem;
  }

  .dm-quick-info {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    text-align: left;
  }

  .dm-badge {
    font-family: var(--font-section);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brand-gold);
    font-weight: 600;
  }

  .dm-title {
    font-family: var(--font-section);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--ink);
  }

  .dm-quick-btn {
    white-space: nowrap;
    padding: 0.35rem 0.85rem !important;
    font-size: 0.78rem !important;
  }

  .method-separator {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin: 0.4rem 0;
    color: var(--brand-gold);
    font-size: 0.65rem;
    letter-spacing: 0.08em;
  }
  .method-separator::before,
  .method-separator::after {
    content: '';
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--gold-border), transparent);
  }

  /* Collapsible Calendar Trigger */
  .calendar-collapsible-wrapper {
    margin-bottom: 0.5rem;
  }

  .cal-toggle-btn {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: var(--surface);
    border: 1.5px solid var(--brand-gold-border);
    border-radius: 8px;
    padding: 0.45rem 0.75rem;
    font-family: var(--font-body);
    font-size: 0.82rem;
    color: var(--ink);
    cursor: pointer;
    transition: all 0.2s ease;
  }
    border: 1.5px solid var(--brand-gold-border);
    border-radius: 12px;
    padding: 0.75rem 1rem;
    font-family: var(--font-body);
    font-size: 0.92rem;
    color: var(--ink);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .cal-toggle-btn:hover {
    border-color: var(--brand-teal);
    background: var(--brand-teal-light);
  }

  .cal-toggle-icon {
    transition: transform 0.25s ease;
  }
  .cal-toggle-btn[aria-expanded="true"] .cal-toggle-icon {
    transform: rotate(180deg);
  }

  .modal-calendar-block {
    margin-top: 0.75rem;
    border: 1px solid var(--gold-border);
    border-radius: 14px;
    padding: 1.25rem;
    background: var(--surface);
  }

  .schedule-pending-notice {
    background: var(--brand-teal-light);
    border-left: 3px solid var(--brand-teal);
    border-radius: 8px;
    padding: 0.75rem 1rem;
    margin-bottom: 1rem;
  }

  .pending-badge-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.35rem;
  }

  .pending-pill {
    background: var(--brand-teal);
    color: #ffffff;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.15rem 0.5rem;
    border-radius: 9999px;
    text-transform: uppercase;
  }

  .pending-status-text {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--brand-teal);
  }

  .pending-notice-body {
    margin: 0;
    font-size: 0.82rem;
    color: var(--ink);
    line-height: 1.45;
  }

  .calendar-header {
    margin-bottom: 0.75rem;
  }

  .calendar-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .cal-nav-btn {
    background: var(--surface-2);
    border: 1px solid var(--gold-border);
    color: var(--ink);
    border-radius: 8px;
    padding: 0.25rem 0.65rem;
    cursor: pointer;
  }

  .calendar-month-heading {
    margin: 0;
    font-family: var(--font-section);
    font-size: 1.15rem;
    color: var(--ink);
  }

  .calendar-weekdays {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    text-align: center;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--brand-gold);
    margin-bottom: 0.5rem;
  }

  .calendar-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 4px;
  }

  :global(.cal-day) {
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--hairline);
    border-radius: 8px;
    background: var(--surface);
    color: var(--ink);
    font-size: 0.82rem;
    cursor: pointer;
    transition: all 0.15s ease;
    padding: 0;
  }

  :global(.cal-day:hover:not(:disabled)) {
    background: var(--brand-teal-light);
    border-color: var(--brand-teal);
    color: var(--brand-teal);
  }

  :global(.cal-day.is-selected) {
    background: var(--brand-teal) !important;
    color: #ffffff !important;
    border-color: var(--brand-teal) !important;
    font-weight: 700;
  }

  :global(.cal-day.is-past) {
    opacity: 0.35;
    cursor: not-allowed;
    background: transparent;
  }

  :global(.cal-day.is-empty) {
    border: none;
    background: transparent;
  }

  /* Form Styles */
  .booking-form {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.65rem;
  }

  @media (max-width: 520px) {
    .form-grid {
      grid-template-columns: 1fr;
    }
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    text-align: left;
  }

  .form-group label {
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--ink);
  }

  .req {
    color: var(--brand-teal);
  }

  input, select, textarea {
    width: 100%;
    background: var(--surface);
    border: 1.5px solid var(--gold-border);
    border-radius: 8px;
    padding: 0.45rem 0.65rem;
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: var(--ink);
    box-sizing: border-box;
    transition: border-color 0.2s ease;
  }
    font-size: 0.9rem;
    color: var(--ink);
    box-sizing: border-box;
    transition: border-color 0.2s ease;
  }

  /* Dark mode select options contrast fix */
  select option {
    background: var(--surface) !important;
    color: var(--ink) !important;
  }
  :global([data-theme="dark"]) select,
  :global([data-theme="dark"]) select option {
    background-color: #241d18 !important;
    color: #f6efe3 !important;
  }

  input:focus, select:focus, textarea:focus {
    outline: none;
    border-color: var(--brand-teal);
    box-shadow: 0 0 0 3px var(--brand-teal-glow);
  }

  .form-actions {
    margin-top: 0.5rem;
  }

  .booking-confirm-box {
    text-align: center;
    padding: 1.5rem 1rem;
    background: var(--surface-2);
    border-radius: 14px;
    border: 1px solid var(--gold-border);
  }

  .confirm-icon {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--brand-teal);
    color: #ffffff;
    font-size: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 0.75rem;
  }

  .confirm-title {
    font-family: var(--font-section);
    font-size: 1.4rem;
    margin: 0 0 0.5rem;
    color: var(--ink);
  }

  .confirm-desc {
    font-size: 0.92rem;
    color: var(--muted);
    margin: 0 0 1rem;
    line-height: 1.5;
  }

  .confirm-details {
    background: var(--surface);
    border: 1px solid var(--gold-border);
    border-radius: 10px;
    padding: 0.85rem;
    margin-bottom: 1rem;
    text-align: left;
    font-size: 0.85rem;
    color: var(--ink);
    line-height: 1.6;
  }
</style>

<script>
  function initBookingSection() {
    const modal = document.getElementById('booking-modal') as HTMLDialogElement | null;
    const closeBtn = document.getElementById('booking-modal-close');
    const confirmCloseBtn = document.getElementById('confirm-close-btn');
    const form = document.getElementById('booking-request-form') as HTMLFormElement | null;
    const confirmBox = document.getElementById('booking-confirm-box');
    const dateInput = document.getElementById('book-date') as HTMLInputElement | null;
    const serviceSelect = document.getElementById('book-service') as HTMLSelectElement | null;
    const detailsSummary = document.getElementById('confirm-details-summary');
    const stickyWrap = document.getElementById('sticky-book-wrap');
    const calToggleBtn = document.getElementById('cal-toggle-btn');
    const calBlock = document.getElementById('modal-calendar-block');

    if (!modal) return;

    // Open Modal function: resets service selection unless explicitly passed
    function openModal(defaultService?: string) {
      if (form) {
        form.reset();
        form.hidden = false;
      }
      if (confirmBox) {
        confirmBox.hidden = true;
      }

      if (serviceSelect) {
        if (defaultService) {
          for (let i = 0; i < serviceSelect.options.length; i++) {
            if (serviceSelect.options[i].value.toLowerCase().includes(defaultService.toLowerCase())) {
              serviceSelect.selectedIndex = i;
              break;
            }
          }
        } else {
          serviceSelect.selectedIndex = 0;
        }
      }

      modal?.showModal();
    }

    // Toggle calendar collapse
    calToggleBtn?.addEventListener('click', () => {
      const isExpanded = calToggleBtn.getAttribute('aria-expanded') === 'true';
      calToggleBtn.setAttribute('aria-expanded', String(!isExpanded));
      if (calBlock) {
        calBlock.hidden = isExpanded;
        if (!isExpanded) {
          renderCalendar();
        }
      }
    });

    // Bind all buttons with data-action="book-date" or data-open-booking-btn
    document.querySelectorAll('[data-action="book-date"], [data-open-booking-btn]').forEach((el) => {
      el.addEventListener('click', (e) => {
        e.preventDefault();
        openModal();
      });
    });

    // Also bind service CTA buttons (#booking) inside BrandAccordion
    document.querySelectorAll('a[href="#booking"], .bacc-cta, [data-service-cta]').forEach((el) => {
      el.addEventListener('click', (e) => {
        e.preventDefault();
        const text = el.getAttribute('data-service-cta') || el.textContent || '';
        let service = '';
        if (text.includes('Henna')) service = 'Henna Art';
        else if (text.includes('Feather')) service = 'Hair Feathers';
        else if (text.includes('Tinsel')) service = 'Hair Tinsel';
        openModal(service);
      });
    });

    closeBtn?.addEventListener('click', () => modal.close());
    confirmCloseBtn?.addEventListener('click', () => modal.close());

    modal.addEventListener('click', (e) => {
      if (e.target === modal) modal.close();
    });

    // Sticky book button visibility: hides when footer is in view
    const footer = document.getElementById('site-footer') || document.querySelector('footer');
    let isFooterVisible = false;

    if (footer && 'IntersectionObserver' in window) {
      const footerObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          isFooterVisible = entry.isIntersecting;
          updateStickyVisibility();
        });
      }, { threshold: 0.05 });
      footerObserver.observe(footer);
    }

    function updateStickyVisibility() {
      if (!stickyWrap) return;
      if (window.scrollY > 300 && !isFooterVisible) {
        stickyWrap.style.transform = 'translateY(0)';
        stickyWrap.style.opacity = '1';
        stickyWrap.style.pointerEvents = 'auto';
        stickyWrap.removeAttribute('aria-hidden');
      } else {
        stickyWrap.style.transform = 'translateY(24px)';
        stickyWrap.style.opacity = '0';
        stickyWrap.style.pointerEvents = 'none';
        stickyWrap.setAttribute('aria-hidden', 'true');
      }
    }

    window.addEventListener('scroll', updateStickyVisibility, { passive: true });
    updateStickyVisibility();

    // Calendar dynamic logic inside modal
    let currentYear = new Date().getFullYear();
    let currentMonth = new Date().getMonth();
    let selectedDateStr = '';

    const monthTitle = document.getElementById('cal-month-title');
    const grid = document.getElementById('calendar-grid');
    const prevBtn = document.getElementById('cal-prev-btn');
    const nextBtn = document.getElementById('cal-next-btn');

    const monthNames = [
      'January', 'February', 'March', 'April', 'May', 'June',
      'July', 'August', 'September', 'October', 'November', 'December'
    ];

    function renderCalendar() {
      if (!grid || !monthTitle) return;
      monthTitle.textContent = `${monthNames[currentMonth]} ${currentYear}`;
      grid.innerHTML = '';

      const firstDay = new Date(currentYear, currentMonth, 1).getDay();
      const daysInMonth = new Date(currentYear, currentMonth + 1, 0).getDate();
      const today = new Date();
      today.setHours(0, 0, 0, 0);

      // Empty lead days
      for (let i = 0; i < firstDay; i++) {
        const emptyCell = document.createElement('div');
        emptyCell.className = 'cal-day is-empty';
        grid.appendChild(emptyCell);
      }

      // Month days
      for (let day = 1; day <= daysInMonth; day++) {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'cal-day';
        btn.textContent = String(day);

        const dateObj = new Date(currentYear, currentMonth, day);
        const formatted = `${monthNames[currentMonth]} ${day}, ${currentYear}`;
        btn.setAttribute('data-date', formatted);

        if (dateObj < today) {
          btn.classList.add('is-past');
          btn.disabled = true;
          btn.setAttribute('aria-label', `${formatted} (past date)`);
        } else {
          btn.setAttribute('aria-label', formatted);
          if (selectedDateStr === formatted) {
            btn.classList.add('is-selected');
          }
          btn.addEventListener('click', () => {
            selectedDateStr = formatted;
            if (dateInput) dateInput.value = formatted;
            document.querySelectorAll('.cal-day.is-selected').forEach(d => d.classList.remove('is-selected'));
            btn.classList.add('is-selected');
          });
        }

        grid.appendChild(btn);
      }
    }

    prevBtn?.addEventListener('click', () => {
      currentMonth--;
      if (currentMonth < 0) {
        currentMonth = 11;
        currentYear--;
      }
      renderCalendar();
    });

    nextBtn?.addEventListener('click', () => {
      currentMonth++;
      if (currentMonth > 11) {
        currentMonth = 0;
        currentYear++;
      }
      renderCalendar();
    });

    // Form submission
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const formData = new FormData(form);
      const name = formData.get('name') as string;
      const contact = formData.get('contact') as string;
      const service = formData.get('service') as string;
      const date = formData.get('date') as string || 'To be coordinated';

      if (detailsSummary) {
        detailsSummary.innerHTML = `
          <strong>Name:</strong> ${name}<br/>
          <strong>Contact:</strong> ${contact}<br/>
          <strong>Service:</strong> ${service}<br/>
          <strong>Requested Date:</strong> ${date}
        `;
      }

      form.hidden = true;
      if (confirmBox) confirmBox.hidden = false;
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initBookingSection, { once: true });
  } else {
    initBookingSection();
  }
  document.addEventListener('astro:page-load', initBookingSection);
</script>
