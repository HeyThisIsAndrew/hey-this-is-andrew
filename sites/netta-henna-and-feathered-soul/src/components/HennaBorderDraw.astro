---
/**
 * HennaBorderDraw.astro
 * Meticulous original SVG henna (mehndi) side art that draws itself via SVG path strokes.
 * ViewBox 0 0 130 1800 (aspect ratio 1:13.85) ensures 100% full-height coverage (100vh)
 * across Mobile (390x844), iPad (820x1180), and Desktop (1440x900) with zero horizontal clipping.
 * Contains per side:
 * - 4 elaborate Half-Mandala Rosettes (concentric arches, kangura scallops, radial petals, dome tips, tri-bead crowns)
 * - 6 sweeping diagonal Teardrop Paisleys / Ambi motifs cradling the mandalas (double walls, belly seed floweret, internal jaali arcs, spine scallops, coiled kalgi tips)
 * - 3 multi-layered Blooming Lotus Flowers (central spear petal, inner & outer reflexed petals, vein linework, padma pedestal, gem accents)
 * - Continuous triple-line outer frame with fine kangura scallops and beaded dot chains.
 * - Gold (#a8821d, #c59b27) fine linework (1.0px - 1.6px) with Teal (#0e7c7b, #1a999d) gems and dots (2px - 4px).
 */

interface Props {
  side: 'left' | 'right';
}

const { side } = Astro.props;

const GOLD_DARK = '#a8821d';
const GOLD_BRIGHT = '#c59b27';
const TEAL_DEEP = '#0e7c7b';
const TEAL_BRIGHT = '#1a999d';

const r = (n: number) => Math.round(n * 100) / 100;

interface PathItem {
  d: string;
  stroke: string;
  width: number;
  delay: number;
}

interface DotItem {
  cx: number;
  cy: number;
  radius: number;
  fill: string;
}

const paths: PathItem[] = [];
const dots: DotItem[] = [];

function addPath(d: string, stroke = GOLD_DARK, width = 1.3, yPos = 600) {
  const delay = r(Math.min(0.65, Math.max(0, (yPos / 1800) * 0.65)));
  paths.push({ d, stroke, width, delay });
}

function addDot(cx: number, cy: number, radius = 2.4, fill = GOLD_BRIGHT) {
  dots.push({ cx: r(cx), cy: r(cy), radius: r(radius), fill });
}

// 1. Outer Edge Mehndi Triple-Line Frame & Kangura Scallops (y: 0 -> 1800)
for (let seg = 0; seg < 9; seg++) {
  const y0 = seg * 200;
  const y1 = y0 + 200;
  const yMid = y0 + 100;
  addPath(`M 2 ${y0} L 2 ${y1}`, GOLD_DARK, 1.4, yMid);
  addPath(`M 5.5 ${y0} L 5.5 ${y1}`, GOLD_BRIGHT, 1.1, yMid);
  addPath(`M 9 ${y0} L 9 ${y1}`, GOLD_DARK, 1.25, yMid);

  let scallopD = `M 9 ${y0}`;
  for (let y = y0; y < y1; y += 10) {
    scallopD += ` C 14.5 ${y + 2}, 14.5 ${y + 8}, 9 ${y + 10}`;
    if (y % 20 === 0) {
      addDot(3.8, y + 5, 2.0, seg % 2 === 0 ? GOLD_BRIGHT : TEAL_DEEP);
    }
  }
  addPath(scallopD, GOLD_BRIGHT, 1.05, yMid);
}

// 2. Builder: Elaborate Half-Mandala Rosette anchored at (9, yc)
function buildMandalaRosette(yc: number, maxR: number) {
  const cx = 9;

  // Core cabochon gem & concentric inner arches
  addDot(cx + 4.5, yc, 3.6, TEAL_DEEP);
  addPath(
    `M ${cx} ${yc - 12} A 12 12 0 0 1 ${cx} ${yc + 12}`,
    GOLD_DARK,
    1.5,
    yc
  );
  addPath(
    `M ${cx} ${yc - 16.5} A 16.5 16.5 0 0 1 ${cx} ${yc + 16.5}`,
    GOLD_BRIGHT,
    1.1,
    yc
  );

  // Inner kangura scallop band on r = 16.5..22
  let innerScallop = `M ${cx} ${yc - 16.5}`;
  const steps1 = 10;
  for (let i = 0; i < steps1; i++) {
    const aMid = -Math.PI / 2 + ((i + 0.5) * Math.PI) / steps1;
    const a2 = -Math.PI / 2 + ((i + 1) * Math.PI) / steps1;
    const xMid = r(cx + Math.cos(aMid) * 22.5);
    const yMid = r(yc + Math.sin(aMid) * 22.5);
    const x2 = r(cx + Math.cos(a2) * 16.5);
    const y2 = r(yc + Math.sin(a2) * 16.5);
    innerScallop += ` Q ${xMid} ${yMid} ${x2} ${y2}`;
    addDot(
      cx + Math.cos(aMid) * 14,
      yc + Math.sin(aMid) * 14,
      1.9,
      GOLD_BRIGHT
    );
  }
  addPath(innerScallop, GOLD_DARK, 1.05, yc);

  // Concentric rings r = 24 and r = 28.5
  addPath(
    `M ${cx} ${yc - 24} A 24 24 0 0 1 ${cx} ${yc + 24}`,
    GOLD_DARK,
    1.4,
    yc
  );
  addPath(
    `M ${cx} ${yc - 28.5} A 28.5 28.5 0 0 1 ${cx} ${yc + 28.5}`,
    TEAL_DEEP,
    1.15,
    yc
  );

  // Inner radial petal rosette (9 petals between r = 28.5 and r = 47)
  const innerPetals = 9;
  for (let i = 0; i < innerPetals; i++) {
    const aStart = -Math.PI * 0.46 + (i * (Math.PI * 0.92)) / innerPetals;
    const aEnd = -Math.PI * 0.46 + ((i + 1) * (Math.PI * 0.92)) / innerPetals;
    const aMid = (aStart + aEnd) / 2;

    const x1 = r(cx + Math.cos(aStart) * 28.5);
    const y1 = r(yc + Math.sin(aStart) * 28.5);
    const x2 = r(cx + Math.cos(aEnd) * 28.5);
    const y2 = r(yc + Math.sin(aEnd) * 28.5);

    const c1x = r(cx + Math.cos(aStart + 0.04) * 42);
    const c1y = r(yc + Math.sin(aStart + 0.04) * 42);
    const c2x = r(cx + Math.cos(aEnd - 0.04) * 42);
    const c2y = r(yc + Math.sin(aEnd - 0.04) * 42);

    const tipX = r(cx + Math.cos(aMid) * 47);
    const tipY = r(yc + Math.sin(aMid) * 47);

    addPath(
      `M ${x1} ${y1} Q ${c1x} ${c1y} ${tipX} ${tipY} Q ${c2x} ${c2y} ${x2} ${y2}`,
      GOLD_DARK,
      1.2,
      yc
    );

    const vx1 = r(cx + Math.cos(aMid) * 31);
    const vy1 = r(yc + Math.sin(aMid) * 31);
    const vx2 = r(cx + Math.cos(aMid) * 41);
    const vy2 = r(yc + Math.sin(aMid) * 41);
    addPath(`M ${vx1} ${vy1} L ${vx2} ${vy2}`, GOLD_BRIGHT, 1.0, yc);

    addDot(
      cx + Math.cos(aMid) * 38,
      yc + Math.sin(aMid) * 38,
      1.9,
      i % 2 === 0 ? TEAL_BRIGHT : GOLD_BRIGHT
    );
  }

  // Outer Concentric Double Arch (r = 50 and r = 54.5)
  addPath(
    `M ${cx} ${yc - 50} A 50 50 0 0 1 ${cx} ${yc + 50}`,
    GOLD_DARK,
    1.5,
    yc
  );
  addPath(
    `M ${cx} ${yc - 54.5} A 54.5 54.5 0 0 1 ${cx} ${yc + 54.5}`,
    GOLD_BRIGHT,
    1.15,
    yc
  );

  // Outer kangura scallop band on r = 54.5..61
  let outerScallop = `M ${cx} ${yc - 54.5}`;
  const steps2 = 16;
  for (let i = 0; i < steps2; i++) {
    const aMid = -Math.PI / 2 + ((i + 0.5) * Math.PI) / steps2;
    const a2 = -Math.PI / 2 + ((i + 1) * Math.PI) / steps2;
    const xMid = r(cx + Math.cos(aMid) * 61);
    const yMid = r(yc + Math.sin(aMid) * 61);
    const x2 = r(cx + Math.cos(a2) * 54.5);
    const y2 = r(yc + Math.sin(a2) * 54.5);
    outerScallop += ` Q ${xMid} ${yMid} ${x2} ${y2}`;
  }
  addPath(outerScallop, GOLD_BRIGHT, 1.05, yc);

  // Crown of 7 Pointed Ogee Lotus-Mandala Dome Petals (r = 59 -> maxR)
  const outerPetals = 7;
  for (let i = 0; i < outerPetals; i++) {
    const aStart = -Math.PI * 0.43 + (i * (Math.PI * 0.86)) / outerPetals;
    const aEnd = -Math.PI * 0.43 + ((i + 1) * (Math.PI * 0.86)) / outerPetals;
    const aMid = (aStart + aEnd) / 2;

    const baseR = 59;
    const tipR = maxR;
    const x1 = r(cx + Math.cos(aStart) * baseR);
    const y1 = r(yc + Math.sin(aStart) * baseR);
    const x2 = r(cx + Math.cos(aEnd) * baseR);
    const y2 = r(yc + Math.sin(aEnd) * baseR);

    const ctrlR = r((baseR + tipR) * 0.54);
    const c1x = r(cx + Math.cos(aStart - 0.02) * ctrlR);
    const c1y = r(yc + Math.sin(aStart - 0.02) * ctrlR);
    const c2x = r(cx + Math.cos(aEnd + 0.02) * ctrlR);
    const c2y = r(yc + Math.sin(aEnd + 0.02) * ctrlR);

    const tipX = r(cx + Math.cos(aMid) * tipR);
    const tipY = r(yc + Math.sin(aMid) * tipR);

    addPath(
      `M ${x1} ${y1} C ${c1x} ${c1y}, ${ r(cx + Math.cos(aMid - 0.07) * (tipR - 5)) } ${ r(yc + Math.sin(aMid - 0.07) * (tipR - 5)) }, ${tipX} ${tipY} C ${ r(cx + Math.cos(aMid + 0.07) * (tipR - 5)) } ${ r(yc + Math.sin(aMid + 0.07) * (tipR - 5)) }, ${c2x} ${c2y}, ${x2} ${y2}`,
      GOLD_DARK,
      1.45,
      yc
    );

    const ix1 = r(cx + Math.cos(aStart + 0.05) * (baseR + 3));
    const iy1 = r(yc + Math.sin(aStart + 0.05) * (baseR + 3));
    const ix2 = r(cx + Math.cos(aEnd - 0.05) * (baseR + 3));
    const iy2 = r(yc + Math.sin(aEnd - 0.05) * (baseR + 3));
    const itipX = r(cx + Math.cos(aMid) * (tipR - 7));
    const itipY = r(yc + Math.sin(aMid) * (tipR - 7));
    addPath(
      `M ${ix1} ${iy1} Q ${ r(cx + Math.cos(aMid - 0.07) * (ctrlR - 2)) } ${ r(yc + Math.sin(aMid - 0.07) * (ctrlR - 2)) } ${itipX} ${itipY} Q ${ r(cx + Math.cos(aMid + 0.07) * (ctrlR - 2)) } ${ r(yc + Math.sin(aMid + 0.07) * (ctrlR - 2)) } ${ix2} ${iy2}`,
      GOLD_BRIGHT,
      1.05,
      yc
    );

    addDot(
      cx + Math.cos(aMid) * (baseR + 12),
      yc + Math.sin(aMid) * (baseR + 12),
      2.3,
      i % 2 === 0 ? TEAL_DEEP : GOLD_BRIGHT
    );
    addDot(
      cx + Math.cos(aMid) * (tipR + 5),
      yc + Math.sin(aMid) * (tipR + 5),
      2.9,
      i === 3 ? TEAL_DEEP : GOLD_DARK
    );
    addDot(
      cx + Math.cos(aMid - 0.05) * (tipR + 9.5),
      yc + Math.sin(aMid - 0.05) * (tipR + 9.5),
      1.9,
      TEAL_BRIGHT
    );
    addDot(
      cx + Math.cos(aMid + 0.05) * (tipR + 9.5),
      yc + Math.sin(aMid + 0.05) * (tipR + 9.5),
      1.9,
      TEAL_BRIGHT
    );
  }
}

// 3. Builder: Sweeping Diagonal Teardrop Paisley (Ambi Motif) cradling the Mandala
function buildPaisley(yBase: number, dir: 1 | -1, reachX: number) {
  // Sweeps gracefully at a 45-degree diagonal from border (x=10.5, yBase) out to (reachX, yBase + dir*42)
  const x0 = 10.5;
  const y0 = yBase;
  const yEnd = r(yBase + dir * 48);
  const tipX = reachX;
  const tipY = r(yBase + dir * 40);

  // Plump outer S-curve belly of the teardrop paisley
  addPath(
    `M ${x0} ${y0} C ${ r(reachX * 0.62) } ${ r(y0 - dir * 6) }, ${ r(reachX + 4) } ${ r(y0 + dir * 14) }, ${tipX} ${tipY}`,
    GOLD_DARK,
    1.55,
    yBase
  );

  // Coiled spiral kalgi tip
  addPath(
    `M ${tipX} ${tipY} C ${ r(tipX - 2) } ${ r(tipY + dir * 12) }, ${ r(tipX - 18) } ${ r(tipY + dir * 14) }, ${ r(tipX - 20) } ${ r(tipY + dir * 3) } C ${ r(tipX - 21) } ${ r(tipY - dir * 4) }, ${ r(tipX - 11) } ${ r(tipY - dir * 4) }, ${ r(tipX - 12) } ${ r(tipY + dir * 2) }`,
    GOLD_DARK,
    1.35,
    yBase
  );

  // Concave inner waist returning smoothly to border
  addPath(
    `M ${ r(tipX - 10) } ${ r(tipY + dir * 9) } C ${ r(reachX * 0.58) } ${ r(y0 + dir * 48) }, ${ r(reachX * 0.28) } ${ r(y0 + dir * 36) }, ${x0} ${yEnd}`,
    GOLD_DARK,
    1.45,
    yBase
  );

  // Inner parallel double-wall contour
  addPath(
    `M ${x0 + 3} ${ r(y0 + dir * 5) } C ${ r(reachX * 0.56) } ${ r(y0 + dir * 1) }, ${ r(reachX - 5) } ${ r(y0 + dir * 16) }, ${ r(tipX - 10) } ${ r(tipY - dir * 1) } C ${ r(reachX * 0.56) } ${ r(y0 + dir * 41) }, ${ r(reachX * 0.28) } ${ r(y0 + dir * 31) }, ${x0 + 3} ${ r(yEnd - dir * 5) }`,
    GOLD_BRIGHT,
    1.1,
    yBase
  );

  // Inner seed floweret inside plump belly of paisley
  const seedX = r(reachX * 0.42);
  const seedY = r(y0 + dir * 18);
  addPath(
    `M ${seedX - 6.5} ${seedY} A 6.5 6.5 0 1 0 ${seedX + 6.5} ${seedY} A 6.5 6.5 0 1 0 ${seedX - 6.5} ${seedY}`,
    GOLD_DARK,
    1.15,
    yBase
  );
  addDot(seedX, seedY, 2.5, TEAL_DEEP);

  // Internal curved henna jaali ribs across tapering paisley neck
  for (const frac of [0.60, 0.72]) {
    const bx = r(reachX * frac);
    const byTop = r(y0 + dir * (frac * 22 - 4));
    const byBot = r(y0 + dir * (frac * 36 + 6));
    addPath(
      `M ${bx} ${byTop} Q ${ r(bx + 6) } ${ r((byTop + byBot) / 2) } ${ r(bx - 4) } ${byBot}`,
      TEAL_DEEP,
      1.05,
      yBase
    );
  }

  // Fine kangura scallops along the outer convex spine of the paisley
  let spineScallop = `M ${x0 + 6} ${ r(y0 - dir * 1) }`;
  const steps = 6;
  for (let s = 1; s <= steps; s++) {
    const t = s / steps;
    const sx = r(x0 + 6 + t * (tipX - x0 - 10));
    const sy = r(y0 + dir * (t * t * 34 - 1));
    const mx = r(sx - 3);
    const my = r(sy - dir * 6);
    spineScallop += ` Q ${mx} ${my} ${sx} ${sy}`;
  }
  addPath(spineScallop, GOLD_BRIGHT, 1.05, yBase);

  // Graduated bead trail off the coiled kalgi tip
  addDot(tipX - 15, tipY + dir * 2, 2.2, TEAL_BRIGHT);
  addDot(tipX + 5, tipY + dir * 5, 3.1, GOLD_DARK);
  addDot(tipX + 10, tipY + dir * 10, 2.4, TEAL_DEEP);
  addDot(tipX + 13, tipY + dir * 15, 1.9, GOLD_BRIGHT);
  addDot(reachX * 0.24, y0 + dir * 16, 2.2, GOLD_BRIGHT);
}

// 4. Builder: Symmetrical Multi-Layered Blooming Lotus Flower at y = yc
function buildLotusFlower(yc: number, reachX: number) {
  const baseX = 10.5;

  // Padma pedestal base chalice
  addPath(
    `M ${baseX} ${yc - 15} A 15 15 0 0 1 ${baseX} ${yc + 15}`,
    GOLD_DARK,
    1.45,
    yc
  );
  addPath(
    `M ${baseX} ${yc - 19.5} A 19.5 19.5 0 0 1 ${baseX} ${yc + 19.5}`,
    GOLD_BRIGHT,
    1.1,
    yc
  );
  addDot(baseX + 7.5, yc, 2.8, TEAL_DEEP);

  const p0 = baseX + 19.5;

  // Center Pointed Spear Lotus Petal
  addPath(
    `M ${p0} ${yc - 5.5} C ${ r(p0 + 28) } ${yc - 14}, ${ r(reachX - 20) } ${yc - 10}, ${reachX} ${yc} C ${ r(reachX - 20) } ${yc + 10}, ${ r(p0 + 28) } ${yc + 14}, ${p0} ${yc + 5.5}`,
    GOLD_DARK,
    1.55,
    yc
  );
  addPath(
    `M ${p0 + 3.5} ${yc - 3} C ${ r(p0 + 26) } ${yc - 9}, ${ r(reachX - 22) } ${yc - 6.5}, ${reachX - 8} ${yc} C ${ r(reachX - 22) } ${yc + 6.5}, ${ r(p0 + 26) } ${yc + 9}, ${p0 + 3.5} ${yc + 3}`,
    GOLD_BRIGHT,
    1.05,
    yc
  );
  addPath(`M ${p0 + 7} ${yc} L ${reachX - 18} ${yc}`, TEAL_DEEP, 1.1, yc);
  addDot(reachX - 12, yc, 2.6, TEAL_DEEP);
  addDot(reachX + 5.5, yc, 3.1, GOLD_DARK);
  addDot(reachX + 10.5, yc - 3.5, 2.0, TEAL_BRIGHT);
  addDot(reachX + 10.5, yc + 3.5, 2.0, TEAL_BRIGHT);

  // Layer 2: Upper and Lower Inner Lotus Petals
  for (const s of [-1, 1]) {
    const tipX = reachX - 13;
    const tipY = yc + s * 19;
    addPath(
      `M ${p0 - 1} ${ r(yc + s * 5.5) } C ${ r(p0 + 24) } ${ r(yc + s * 17) }, ${ r(tipX - 16) } ${ r(yc + s * 23) }, ${tipX} ${tipY} C ${ r(tipX - 12) } ${ r(yc + s * 9.5) }, ${ r(p0 + 36) } ${ r(yc + s * 10) }, ${ r(p0 + 20) } ${ r(yc + s * 8) }`,
      GOLD_DARK,
      1.4,
      yc
    );
    addPath(
      `M ${ r(p0 + 8) } ${ r(yc + s * 9) } Q ${ r(p0 + 36) } ${ r(yc + s * 17) } ${ r(tipX - 8) } ${ r(tipY - s * 1.5) }`,
      GOLD_BRIGHT,
      1.0,
      yc
    );
    addDot(tipX + 4.5, tipY + s * 1.5, 2.3, TEAL_BRIGHT);
  }

  // Layer 3: Upper and Lower Outer Reflexed Lotus Petals
  for (const s of [-1, 1]) {
    const tipX = reachX - 31;
    const tipY = yc + s * 32;
    addPath(
      `M ${baseX + 13} ${ r(yc + s * 13) } C ${ r(baseX + 30) } ${ r(yc + s * 26) }, ${ r(tipX - 14) } ${ r(yc + s * 36) }, ${tipX} ${tipY} C ${ r(tipX - 8) } ${ r(yc + s * 20) }, ${ r(baseX + 44) } ${ r(yc + s * 19) }, ${ r(baseX + 30) } ${ r(yc + s * 13) }`,
      GOLD_DARK,
      1.35,
      yc
    );
    addPath(
      `M ${ r(baseX + 20) } ${ r(yc + s * 17) } Q ${ r(baseX + 38) } ${ r(yc + s * 26) } ${ r(tipX - 7) } ${ r(tipY - s * 2) }`,
      GOLD_BRIGHT,
      1.0,
      yc
    );
    addDot(tipX + 4.5, tipY + s * 2, 2.2, GOLD_BRIGHT);
  }
}

// Assemble the Complete Non-Overlapping Henna Tapestry down y = 0..1800:
// Band 1 (y: 15 -> 495): Mandala 1 -> Paisley 1 -> Lotus 1 -> Paisley 2
buildMandalaRosette(112, 86);
buildPaisley(214, 1, 96);
buildLotusFlower(318, 108);
buildPaisley(422, -1, 96);

// Band 2 (y: 440 -> 975): Mandala 2 -> Paisley 3 -> Lotus 2 -> Paisley 4
buildMandalaRosette(532, 88);
buildPaisley(636, 1, 96);
buildLotusFlower(740, 108);
buildPaisley(844, -1, 96);

// Band 3 (y: 870 -> 1395): Mandala 3 -> Paisley 5 -> Lotus 3 -> Paisley 6
buildMandalaRosette(954, 86);
buildPaisley(1056, 1, 96);
buildLotusFlower(1160, 108);
buildPaisley(1264, -1, 96);

// Band 4 (y: 1290 -> 1790): Mandala 4 -> Paisley 7 -> Lotus 4 -> Paisley 8
buildMandalaRosette(1376, 88);
buildPaisley(1478, 1, 96);
buildLotusFlower(1582, 108);
buildPaisley(1686, -1, 96);
buildMandalaRosette(1780, 82);

// Assemble high-performance compound paths grouped by stroke & width
const strokeGroups: Record<string, { stroke: string; width: number; d: string; delay: number }> = {};
paths.forEach((p) => {
  const key = `${p.stroke}|${p.width}`;
  if (!strokeGroups[key]) {
    strokeGroups[key] = { stroke: p.stroke, width: p.width, d: p.d, delay: p.delay };
  } else {
    strokeGroups[key].d += ' ' + p.d;
    strokeGroups[key].delay = Math.min(strokeGroups[key].delay, p.delay);
  }
});
const compoundPaths = Object.values(strokeGroups);

// Assemble compound dots grouped by fill color
const dotGroups: Record<string, { fill: string; d: string }> = {};
dots.forEach((d) => {
  const circleD = `M ${(d.cx - d.radius).toFixed(2)} ${d.cy.toFixed(2)} A ${d.radius} ${d.radius} 0 1 0 ${(d.cx + d.radius).toFixed(2)} ${d.cy.toFixed(2)} A ${d.radius} ${d.radius} 0 1 0 ${(d.cx - d.radius).toFixed(2)} ${d.cy.toFixed(2)} Z`;
  if (!dotGroups[d.fill]) {
    dotGroups[d.fill] = { fill: d.fill, d: circleD };
  } else {
    dotGroups[d.fill].d += ' ' + circleD;
  }
});
const compoundDots = Object.values(dotGroups);
---

<svg
  class={`henna-art-svg henna-art-svg-${side}`}
  viewBox="0 0 120 1800"
  preserveAspectRatio={side === 'left' ? 'xMinYMin slice' : 'xMaxYMin slice'}
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <g transform={side === 'right' ? 'translate(120, 0) scale(-1, 1)' : undefined}>
    {compoundPaths.map((p) => (
      <path
        class="henna-path"
        d={p.d}
        stroke={p.stroke}
        stroke-width={p.width}
        stroke-linecap="round"
        stroke-linejoin="round"
        style={`transition-delay: ${p.delay}s;`}
      />
    ))}
    {compoundDots.map((d) => (
      <path
        class="henna-dot"
        d={d.d}
        fill={d.fill}
      />
    ))}
  </g>
</svg>
