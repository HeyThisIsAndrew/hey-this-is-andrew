---
/**
 * HennaBorderDraw.astro
 * One henna border instance. The art itself lives once in HennaSprite.astro; this
 * component only places it with <use>, so each instance is 3 to 10 DOM nodes
 * instead of 766.
 *
 * Props:
 *   side     'left' keeps the strip as drawn, 'right' mirrors it.
 *   variant  'full' (default) with the straight frame rails, 'open' without them
 *            (the footer mandala bar).
 *   tiles    Stack the 1800 unit strip this many times vertically, so a tall box
 *            edge is covered top to bottom at the same art scale instead of
 *            stopping part way down. Each tile starts drawing 0.2s after the one
 *            above it, so the ink flows down the box.
 *
 * Draw-in: see src/styles/henna.css. The draw is driven by one inherited custom
 * property (--ht, seconds) on this <svg>; any ancestor with .is-drawn starts it.
 */
interface Props {
  side: 'left' | 'right';
  variant?: 'full' | 'open';
  tiles?: number;
}

const { side, variant = 'full', tiles = 1 } = Astro.props;
const href = variant === 'open' ? '#hb-strip-open' : '#hb-strip';
const count = Math.max(1, Math.floor(tiles));
const tileList = Array.from({ length: count }, (_, i) => i);
---

<svg
  class={`henna-art-svg henna-art-svg-${side}`}
  viewBox={`0 0 120 ${1800 * count}`}
  preserveAspectRatio={side === 'left' ? 'xMinYMin slice' : 'xMaxYMin slice'}
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
>
  <g transform={side === 'right' ? 'translate(120, 0) scale(-1, 1)' : undefined}>
    {count === 1 ? (
      <use href={href} />
    ) : (
      tileList.map((i) => (
        <svg x="0" y={i * 1800} width="120" height="1800" viewBox="0 0 120 1800" style={`--td:${(i * 0.2).toFixed(1)}`}>
          <use href={href} />
        </svg>
      ))
    )}
  </g>
</svg>
