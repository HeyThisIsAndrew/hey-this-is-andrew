---
/**
 * BaseLayout.astro
 * Netta Henna and Feathered Soul base layout.
 * Light and dark mode support with logo palette.
 * Crisp circular logo asset, slim footer, zero em dashes.
 */
import '@andrew/tokens/tokens.css';
import '../styles/theme.css';
import '@andrew/ui/styles/base.css';
import '@andrew/ui/styles/chips.css';
import '../styles/global.css';
import '../styles/henna.css';
import '@andrew/ui/styles/cta.css';
import Nav from '@andrew/ui/Nav.astro';
import SlimFooter from '../components/SlimFooter.astro';
import HennaBorderDraw from '../components/HennaBorderDraw.astro';
import HennaSprite from '../components/HennaSprite.astro';
import ChromeMeta from '@andrew/ui/ChromeMeta.astro';
import logo from '../assets/netta-logo.png';
import { getImage } from 'astro:assets';
import { SITE, NAV_LINKS } from '../data/site';

interface Props {
  title: string;
  description?: string;
}

const { title, description = SITE.description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// The nav shows the logo at 50px; a 120px WebP covers 2x screens (was the 781 KB PNG).
const navLogo = await getImage({ src: logo, format: 'webp', quality: 86, width: 120, height: 120 });
const logoAsset = { src: navLogo.src, width: logo.width, height: logo.height, alt: SITE.name };
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ChromeMeta color="#181310" lightColor="#faf6ee" />
    <script is:inline>
      (function() {
        function applyNettaTheme(theme) {
          var isDark = theme === 'dark';
          var resolved = isDark ? 'dark' : 'light';
          var chromeHex = isDark ? '#181310' : '#faf6ee';
          var root = document.documentElement;

          root.setAttribute('data-theme', resolved);
          root.style.colorScheme = resolved;
          root.style.setProperty('--chrome', chromeHex, 'important');
          root.style.setProperty('--nav-bg', chromeHex, 'important');
          root.style.setProperty('--page-bg', chromeHex, 'important');
          root.style.backgroundColor = chromeHex;

          var oldMetas = document.querySelectorAll('meta[name="theme-color"]');
          for (var i = 0; i < oldMetas.length; i++) {
            if (oldMetas[i].parentNode) {
              oldMetas[i].parentNode.removeChild(oldMetas[i]);
            }
          }
          var meta = document.createElement('meta');
          meta.name = 'theme-color';
          meta.content = chromeHex;
          document.head.appendChild(meta);
        }
        window.__applyNettaTheme = applyNettaTheme;
        try {
          var stored = localStorage.getItem('netta-theme');
          var initialTheme = (stored === 'dark' || stored === 'light') ? stored : 'light';
          applyNettaTheme(initialTheme);
        } catch (e) {
          applyNettaTheme('light');
        }
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Great+Vibes&family=Parisienne&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <HennaSprite />
    <Nav logo={logoAsset} homeHref="#price-list" homeLabel="Go to Price List" links={NAV_LINKS} labels={{ menu: '', close: 'Close' }}>
      <div class="nav-drape-wrap" data-nav-henna-draw aria-hidden="true">
        <div class="nav-drape-panel nav-drape-left">
          <div class="nav-drape-svg-holder">
            <HennaBorderDraw side="left" />
          </div>
        </div>
        <div class="nav-drape-panel nav-drape-right">
          <div class="nav-drape-svg-holder">
            <HennaBorderDraw side="left" />
          </div>
        </div>
      </div>
    </Nav>
    <main id="main-content">
      <slot />
    </main>
    <SlimFooter />
    <script>
      import { initSectionAnchors } from '@andrew/ui/scripts/section-anchors.ts';
      initSectionAnchors();

      // Theme toggle mounting and handling
      function setupThemeToggle() {
        const rightActions = document.querySelector('.nav-right-actions');
        if (!rightActions) return;
        const menuBtn = rightActions.querySelector('.menu-btn');
        if (menuBtn && !menuBtn.getAttribute('aria-label')) {
          menuBtn.setAttribute('aria-label', 'Menu');
        }
        if (document.getElementById('theme-toggle-btn')) return;

        const btn = document.createElement('button');
        btn.type = 'button';
        btn.id = 'theme-toggle-btn';
        btn.className = 'theme-toggle-btn';
        btn.setAttribute('aria-label', 'Toggle dark and light color theme');

        function updateIcon() {
          const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
          btn.innerHTML = isDark
            ? `<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>`
            : `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>`;
        }

        btn.addEventListener('click', () => {
          const current = document.documentElement.getAttribute('data-theme') || 'light';
          const next = current === 'dark' ? 'light' : 'dark';
          if (typeof (window as any).__applyNettaTheme === 'function') {
            (window as any).__applyNettaTheme(next);
          } else {
            const chromeHex = next === 'dark' ? '#181310' : '#faf6ee';
            const root = document.documentElement;
            root.setAttribute('data-theme', next);
            root.style.colorScheme = next;
            root.style.setProperty('--chrome', chromeHex, 'important');
            root.style.setProperty('--nav-bg', chromeHex, 'important');
            root.style.setProperty('--page-bg', chromeHex, 'important');
            root.style.backgroundColor = chromeHex;

            const oldMetas = document.querySelectorAll('meta[name="theme-color"]');
            for (let i = 0; i < oldMetas.length; i++) {
              if (oldMetas[i].parentNode) {
                oldMetas[i].parentNode!.removeChild(oldMetas[i]);
              }
            }
            const meta = document.createElement('meta');
            meta.name = 'theme-color';
            meta.content = chromeHex;
            document.head.appendChild(meta);
          }
          try {
            localStorage.setItem('netta-theme', next);
          } catch (e) {}
          updateIcon();
        });

        updateIcon();
        const themeObserver = new MutationObserver(() => updateIcon());
        themeObserver.observe(document.documentElement, {
          attributes: true,
          attributeFilter: ['data-theme'],
        });
        rightActions.insertBefore(btn, rightActions.firstChild);
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupThemeToggle, { once: true });
      } else {
        setupThemeToggle();
      }
      document.addEventListener('astro:page-load', setupThemeToggle);
    </script>
  </body>
</html>
