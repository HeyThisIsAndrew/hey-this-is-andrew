---
/**
 * Footer (@andrew/ui): brand block, an Explore list, SVG-only social links
 * (44x44 targets on touch) and the legal row. Everything it prints is a
 * prop, so a site's header and footer can read ONE nav data file and never
 * disagree.
 */
import type { FooterLink, LogoAsset, SocialLink } from './types';

interface Props {
  logo: LogoAsset;
  tagline: string;
  explore: FooterLink[];
  socials: SocialLink[];
  copyright: string;
  privacyHref: string;
  notes?: string[];
  labels?: { explore?: string; follow?: string; socials?: string; privacy?: string };
}

const { logo, tagline, explore, socials, copyright, privacyHref, notes = [], labels = {} } = Astro.props;
const L = { explore: 'Explore', follow: 'Follow', socials: 'Social links', privacy: 'Privacy', ...labels };
---
<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <img src={logo.src} width={logo.width} height={logo.height} alt={logo.alt} class="footer-logo" loading="lazy" decoding="async" />
      <p class="footer-note">{tagline}</p>
    </div>
    <nav class="footer-nav" aria-label={L.explore}>
      <p class="footer-label">{L.explore}</p>
      <ul>
        {explore.map((l) => (
          <li>
            <a href={l.href}>
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="footer-socials-col">
      <p class="footer-label">{L.follow}</p>
      <ul class="socials" aria-label={L.socials}>
        {socials.map((s) => (
          <li>
            <a href={s.href} target="_blank" rel="noopener" aria-label={s.label} title={s.label}>
              <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                <Fragment set:html={s.icon} />
              </svg>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
  <div class="footer-bottom">
    <p>{copyright}</p>
    <p><a href={privacyHref} class="footer-privacy">{L.privacy}</a></p>
    {notes.map((n) => <p>{n}</p>)}
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    background: var(--surface);
    padding: 4rem 2rem 2rem;
    margin-top: 4rem;
  }
  .footer-inner {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 1.5rem;
    max-width: var(--maxw);
    margin: 0 auto;
    padding-bottom: 3rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }
  .footer-brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 0.75rem;
  }
  .footer-word {
    font-family: var(--font-display);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    line-height: 1.1;
    font-size: clamp(1.2rem, 2vw, 1.6rem);
    color: var(--ink);
    margin: 0;
  }
  .footer-logo {
    display: block;
    height: 5rem;
    width: auto;
  }
  .footer-note {
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--muted);
    font-size: 0.8rem;
    margin: 0;
  }
  .footer-nav {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .footer-label {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink);
    margin: 0 0 1.25rem;
    text-align: center;
  }
  .footer-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.9rem 1.5rem;
    justify-items: center;
  }
  .footer-nav a {
    position: relative;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.675rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
    white-space: nowrap;
    padding-bottom: 0.25rem;
  }
  .footer-nav a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background: var(--ink);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s ease;
  }
  .footer-nav a:hover {
    color: var(--ink);
  }
  .footer-nav a:hover::after {
    transform: scaleX(1);
  }
  .footer-socials-col {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .socials {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 44px);
    gap: 0.5rem;
    justify-content: center;
  }
  .socials a {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: #111;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }
  .socials a:hover {
    color: var(--ink);
    border-color: rgba(255, 255, 255, 0.4);
    transform: translateY(-3px);
  }
  .footer-bottom {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 1rem;
    max-width: var(--maxw);
    margin: 0 auto;
    padding-top: 1.5rem;
    text-align: center;
  }
  .footer-bottom p {
    margin: 0;
    font-size: 0.75rem;
    color: var(--muted);
  }
  @media (max-width: 768px) {
    .site-footer {
      padding: 3rem 1.25rem 1.5rem;
    }
    .footer-inner {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 2.25rem;
      padding-bottom: 2.25rem;
    }
    .footer-brand {
      margin-bottom: 0;
    }
    .footer-nav ul {
      grid-template-columns: 1fr 1fr;
      gap: 0.75rem 1rem;
      width: 100%;
      max-width: 320px;
    }
    .footer-nav a {
      white-space: normal;
      text-align: center;
    }
    .footer-bottom {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }
  /* 44x44 touch targets (the social links already are). */
  @media (pointer: coarse), (max-width: 1023px) {
    .footer-nav a {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 44px;
      min-width: 44px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .socials a:hover {
      transform: none;
    }
  }
</style>
