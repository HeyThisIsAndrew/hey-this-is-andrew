---
/**
 * Shared 3D Flip Card component (@andrew/ui/FlipCard.astro).
 *
 * Used across the monorepo (e.g. BE Unconventional HQ /about and
 * hey-this-is-andrew /ccc/) to present compact summary tiles on the front
 * face (display value, accent label, short one-line summary, and corner flip
 * affordance) that flip on hover/focus/tap to reveal longer descriptive copy
 * on the back face.
 *
 * Keyboard accessibility:
 * - The card flip toggle button is keyboard-focusable and toggles on Enter/Space.
 * - When flipped, any back-face action button (e.g. Contact) becomes focusable
 *   via Tab and can be activated via Enter/Space.
 * - Escape closes the flipped card and returns focus to the card toggle.
 *
 * Punctuation hygiene: zero em dashes throughout.
 */
interface Props {
  value: string;
  label: string;
  desc: string;
  backText: string;
  idPrefix?: string;
  index?: number;
  longValue?: boolean;
  class?: string;
  delay?: number;
  dataCccPackage?: string;
  actionLabel?: string;
}

const {
  value,
  label,
  desc,
  backText,
  idPrefix = 'pillar-back',
  index = 0,
  longValue = false,
  class: className = '',
  delay,
  dataCccPackage,
  actionLabel,
} = Astro.props;

const backId = `${idPrefix}-${index}`;
---

<div
  class:list={['stat-card', 'flip-card', className]}
  data-delay={delay}
  data-ccc-package={dataCccPackage}
>
  <button
    type="button"
    class="flip-card-toggle"
    aria-label={`${label}: ${value}. ${desc}`}
    aria-describedby={backId}
    aria-pressed="false"
  ></button>
  <div class="flip-card-inner">
    <div class="flip-card-front">
      <span class:list={['stat-value', longValue && 'stat-value-long']}>
        {value}
      </span>
      <span class="stat-label">{label}</span>
      <p class="pillar-desc">{desc}</p>
      <span class="flip-hint" aria-hidden="true">
        <svg
          viewBox="0 0 24 24"
          width="14"
          height="14"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M2 12a10 10 0 0 1 17-7.1L22 8" />
          <path d="M22 3v5h-5" />
        </svg>
      </span>
    </div>
    <div class="flip-card-back">
      <p id={backId}>{backText}</p>
      {actionLabel && (
        <button
          type="button"
          class="btn btn-primary flip-action-btn"
          data-open-ccc-modal
          data-ccc-package={dataCccPackage}
          tabindex="-1"
          aria-hidden="true"
        >
          {actionLabel} <span aria-hidden="true">&rarr;</span>
        </button>
      )}
      <slot name="back-action" />
    </div>
  </div>
</div>

<style>
  .flip-card {
    position: relative;
    background: transparent;
    border: none;
    padding: 0;
    perspective: 1000px;
    width: 100%;
    font-family: inherit;
    color: inherit;
    -webkit-tap-highlight-color: transparent;
  }

  .flip-card-toggle {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
    background: transparent;
    cursor: pointer;
    z-index: 2;
    padding: 0;
    margin: 0;
    -webkit-tap-highlight-color: transparent;
  }

  .flip-card.is-flipped .flip-card-toggle {
    z-index: 0;
    pointer-events: none;
  }

  .flip-card-toggle:focus-visible {
    outline: none;
  }

  /* Reset outer stat-card hover transform since .flip-card-inner rotates */
  .stat-card.flip-card,
  .stat-card.flip-card:hover {
    background: transparent;
    border: none;
    padding: 0;
    transform: none;
    box-shadow: none;
  }

  .flip-card-inner {
    position: relative;
    width: 100%;
    height: 100%;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    text-align: center;
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    transform-style: preserve-3d;
  }

  @media (hover: hover) and (pointer: fine) {
    .flip-card:hover .flip-card-inner {
      transform: rotateY(180deg);
    }
  }

  .flip-card-toggle:focus-visible ~ .flip-card-inner,
  .flip-card:focus-within .flip-card-inner,
  .flip-card.is-flipped .flip-card-inner {
    transform: rotateY(180deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .flip-card-inner {
      transition: none;
    }
  }

  .flip-card-front,
  .flip-card-back {
    grid-area: 1 / 1;
    position: relative;
    width: 100%;
    height: 100%;
    box-sizing: border-box;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
    border-radius: 0;
    padding: var(--flip-padding, 2.25rem 1.5rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    background: var(--flip-bg, var(--color-surface, #111111));
    border: 1px solid var(--flip-border, rgba(255, 255, 255, 0.06));
    transition:
      border-color 0.3s ease,
      box-shadow 0.3s ease,
      opacity 0.25s ease 0.12s;
  }

  .flip-card-front {
    transform: rotateY(0deg) translateZ(1px);
    opacity: 1;
    pointer-events: auto;
  }

  .flip-card-back {
    transform: rotateY(180deg) translateZ(1px);
    background: var(--flip-bg-back, rgba(25, 25, 25, 0.96));
    text-align: center;
    gap: 0.45rem;
    opacity: 0;
    pointer-events: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .flip-card:hover .flip-card-front,
    .flip-card:hover .flip-card-back {
      border-color: var(--flip-accent-border, var(--color-accent, #cc0000));
      box-shadow: var(--flip-accent-shadow, 0 8px 30px rgba(204, 0, 0, 0.1));
    }

    .flip-card:hover .flip-card-front {
      opacity: 0;
      pointer-events: none;
    }

    .flip-card:hover .flip-card-back {
      opacity: 1;
      pointer-events: auto;
    }
  }

  .flip-card-toggle:focus-visible ~ .flip-card-inner .flip-card-front,
  .flip-card-toggle:focus-visible ~ .flip-card-inner .flip-card-back,
  .flip-card:focus-within .flip-card-front,
  .flip-card:focus-within .flip-card-back,
  .flip-card.is-flipped .flip-card-front,
  .flip-card.is-flipped .flip-card-back {
    border-color: var(--flip-accent-border, var(--color-accent, #cc0000));
    box-shadow: var(--flip-accent-shadow, 0 8px 30px rgba(204, 0, 0, 0.1));
  }

  .flip-card-toggle:focus-visible ~ .flip-card-inner .flip-card-front,
  .flip-card:focus-within .flip-card-front,
  .flip-card.is-flipped .flip-card-front {
    opacity: 0;
    pointer-events: none;
  }

  .flip-card-toggle:focus-visible ~ .flip-card-inner .flip-card-back,
  .flip-card:focus-within .flip-card-back,
  .flip-card.is-flipped .flip-card-back {
    opacity: 1;
    pointer-events: auto;
  }

  .stat-value {
    display: block;
    font-family: var(--flip-font-value, var(--font-display));
    font-size: clamp(1.75rem, 1.4rem + 1.8vw, 2.4rem);
    font-weight: 800;
    color: var(--flip-value-color, var(--color-white, var(--ink, #ffffff)));
    margin-bottom: 0.45rem;
    line-height: 1.15;
    text-transform: uppercase;
  }

  .stat-value-long {
    font-size: var(--flip-value-long-size, clamp(1.05rem, calc(0.75rem + 0.9vw), 1.35rem));
    letter-spacing: 0.06em;
    line-height: 1.25;
    text-wrap: balance;
  }

  .stat-label {
    display: block;
    font-family: var(--flip-font-label, inherit);
    color: var(--flip-accent-text, var(--color-accent-text, #ef4444));
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .pillar-desc {
    font-family: var(--flip-font-desc, inherit);
    font-size: 0.82rem;
    color: var(--flip-muted-color, var(--color-white-muted, var(--muted, #9a9a95)));
    margin: 0.5rem 0 0;
    line-height: 1.4;
    text-wrap: balance;
  }

  .flip-card-back p {
    font-family: var(--flip-font-back, inherit);
    color: var(--flip-back-color, var(--color-white, var(--ink, #ffffff)));
    font-size: var(--flip-back-size, 1rem);
    line-height: 1.45;
    margin: 0;
    width: 100%;
    text-wrap: balance;
  }

  .flip-action-btn {
    position: relative;
    z-index: 3;
    margin-top: 0.35rem;
    padding: 0.35rem 0.9rem;
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-family: var(--flip-font-label, inherit);
    cursor: pointer;
    box-sizing: border-box;
  }

  .flip-action-btn:focus-visible {
    outline: 2px solid var(--flip-accent-border, #fff);
    outline-offset: 2px;
  }

  .flip-hint {
    position: absolute;
    right: 0.85rem;
    bottom: 0.85rem;
    display: inline-flex;
    color: var(--flip-muted-color, var(--color-white-muted, var(--muted, #9a9a95)));
    opacity: 0.45;
    transition: opacity 0.3s ease, color 0.3s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .flip-card:hover .flip-hint {
      color: var(--flip-accent-text, var(--color-accent-text, #ef4444));
      opacity: 1;
    }
  }

  .flip-card-toggle:focus-visible ~ .flip-card-inner .flip-hint,
  .flip-card.is-flipped .flip-hint {
    color: var(--flip-accent-text, var(--color-accent-text, #ef4444));
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .flip-hint {
      opacity: 0.6;
    }
  }

  @media (max-width: 768px) {
    .flip-card-front,
    .flip-card-back {
      padding: var(--flip-padding-mobile, 1.5rem 1.25rem);
    }
    .flip-card-back p {
      font-size: var(--flip-back-size-mobile, 0.88rem);
      line-height: 1.45;
    }
  }
</style>

<script>
  function initFlipCards() {
    if (document.documentElement.dataset.flipDocWired === '1') return;
    document.documentElement.dataset.flipDocWired = '1';

    function updateCardState(card: HTMLElement, isFlipped: boolean) {
      card.classList.toggle('is-flipped', isFlipped);
      const toggle = card.querySelector<HTMLButtonElement>('.flip-card-toggle');
      if (toggle) {
        toggle.setAttribute('aria-pressed', isFlipped ? 'true' : 'false');
      }
      const actionBtn = card.querySelector<HTMLButtonElement>('.flip-action-btn');
      if (actionBtn) {
        if (isFlipped) {
          actionBtn.removeAttribute('tabindex');
          actionBtn.removeAttribute('aria-hidden');
        } else {
          actionBtn.setAttribute('tabindex', '-1');
          actionBtn.setAttribute('aria-hidden', 'true');
        }
      }
    }

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null;
      const card = target?.closest<HTMLElement>('.flip-card');

      if (!card) {
        document.querySelectorAll<HTMLElement>('.flip-card.is-flipped').forEach((openCard) => {
          updateCardState(openCard, false);
        });
        return;
      }

      const wasFlipped = card.classList.contains('is-flipped');
      const isHoverFlipped =
        window.matchMedia('(hover: hover) and (pointer: fine)').matches && card.matches(':hover');

      // If card is already showing its back face and the user clicked the inner action button, let that action handle it
      if ((wasFlipped || isHoverFlipped) && target?.closest('[data-open-ccc-modal], [data-no-flip]')) {
        return;
      }

      document.querySelectorAll<HTMLElement>('.flip-card.is-flipped').forEach((other) => {
        if (other !== card) {
          updateCardState(other, false);
        }
      });

      updateCardState(card, !wasFlipped);
    });

    document.addEventListener('keydown', (e) => {
      const target = e.target as HTMLElement | null;
      const card = target?.closest<HTMLElement>('.flip-card');
      if (!card) return;

      if (e.key === 'Escape') {
        if (card.classList.contains('is-flipped')) {
          updateCardState(card, false);
          card.querySelector<HTMLButtonElement>('.flip-card-toggle')?.focus();
        }
      }
    });
  }

  initFlipCards();
  document.addEventListener('astro:page-load', initFlipCards);
</script>
