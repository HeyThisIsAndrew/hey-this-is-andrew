---
import QRCode from 'qrcode';
interface Props { id: string; url: string; title: string; label: string; description?: string; }
const { id, url, title, label, description = 'Scan or open the link below.' } = Astro.props;
const qr = await QRCode.toString(url, { type: 'svg', errorCorrectionLevel: 'M', margin: 4, color: { dark: '#000000', light: '#ffffff' } });
---
<dialog id={id} class="qr-dialog" aria-labelledby={`${id}-title`} data-qr-dialog>
  <button type="button" class="qr-close" data-qr-close aria-label="Close QR code">×</button>
  <div class="qr-brand"><slot /></div>
  <h2 id={`${id}-title`}>{title}</h2>
  <div class="qr-code" role="img" aria-label={`QR code for ${label}`} set:html={qr} />
  <p>{description}</p>
  <a class="qr-destination" href={url}>{label} <span aria-hidden="true">↗</span></a>
</dialog>
<style>
  .qr-dialog { position: fixed; inset: 0; width: min(90vw, 420px); max-height: 90svh; margin: auto; padding: 2.5rem 1.5rem 1.5rem; overflow-y: auto; background: #0b0b0b; border: 1px solid #555; color: #f5f5f5; text-align: center; }
  .qr-dialog::backdrop { background: rgb(0 0 0 / 0.85); }
  .qr-close { position: absolute; top: 0.35rem; right: 0.35rem; width: 44px; height: 44px; border: 0; background: transparent; color: inherit; font-size: 1.7rem; cursor: pointer; }
  .qr-brand { max-width: 170px; margin: 0 auto 1rem; }
  .qr-brand :global(img) { display: block; width: 100%; height: auto; }
  .qr-dialog h2 { margin: 0 0 1rem; font: 700 1.2rem var(--font-body, system-ui); }
  .qr-code { max-width: 280px; margin: auto; background: white; }
  .qr-code :global(svg) { display: block; width: 100%; height: auto; }
  .qr-dialog p { margin: 1rem 0; color: #aaa; font: 0.85rem/1.5 var(--font-body, system-ui); }
  .qr-destination { display: flex; min-height: 44px; align-items: center; justify-content: center; gap: 0.75rem; border: 1px solid #666; color: inherit; text-decoration: none; font: 0.75rem var(--font-mono, monospace); text-transform: uppercase; letter-spacing: 0.1em; }
  .qr-destination:hover { background: #fff; color: #000; }
  @media (prefers-reduced-motion: no-preference) {
    .qr-dialog[open] { animation: qr-enter 0.2s cubic-bezier(0.16, 1, 0.3, 1); }
    @keyframes qr-enter { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
  }
</style>
<script>
  function initQrDialogs() {
    document.querySelectorAll<HTMLDialogElement>('[data-qr-dialog]').forEach((dialog) => {
      if (dialog.dataset.ready) return;
      dialog.dataset.ready = '1';
      let trigger: HTMLElement | null = null;
      let overflow = '';
      document.querySelectorAll<HTMLElement>('[data-qr-open]').forEach((button) => {
        if (button.dataset.qrOpen !== dialog.id) return;
        button.addEventListener('click', () => {
          if (dialog.open) return;
          trigger = button;
          overflow = document.documentElement.style.overflow;
          dialog.showModal();
          document.documentElement.style.overflow = 'hidden';
          document.documentElement.classList.add('modal-open');
          dialog.querySelector<HTMLButtonElement>('[data-qr-close]')?.focus();
        });
      });
      dialog.querySelector('[data-qr-close]')?.addEventListener('click', () => dialog.close());
      dialog.addEventListener('click', (event) => {
        if (event.target !== dialog) return;
        const bounds = dialog.getBoundingClientRect();
        if (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom) dialog.close();
      });
      dialog.addEventListener('close', () => {
        document.documentElement.style.overflow = overflow;
        document.documentElement.classList.remove('modal-open');
        if (trigger?.isConnected) trigger.focus({ preventScroll: true });
      });
    });
  }
  initQrDialogs();
  document.addEventListener('astro:page-load', initQrDialogs);
</script>
