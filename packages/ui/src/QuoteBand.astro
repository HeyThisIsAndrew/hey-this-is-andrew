---
/**
 * QuoteBand (@andrew/ui): a standalone quote band. Pure black, generous
 * whitespace, no imagery, no decoration: the words carry it.
 */
interface Props {
  eyebrow: string;
  quote: string;
  attribution: string;
  /** Accessible name for the band. */
  label?: string;
}

const { eyebrow, quote, attribution, label = eyebrow } = Astro.props;
---
<aside class="quote-band" aria-label={label}>
  <div class="container">
    <p class="quote-eyebrow">{eyebrow}</p>
    <blockquote>
      <p>"{quote}"</p>
      <cite>{attribution}</cite>
    </blockquote>
  </div>
</aside>

<style>
  .quote-band {
    background: #000;
    padding: clamp(5rem, 12vw, 10rem) 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    text-align: center;
  }
  .quote-eyebrow {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 2.5rem;
  }
  .quote-band blockquote { margin: 0; }
  .quote-band blockquote p {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.5rem, 3.6vw, 2.75rem);
    line-height: 1.4;
    color: var(--ink);
    max-width: 24ch;
    margin: 0 auto 2rem;
    text-wrap: balance;
  }
  .quote-band cite {
    font-style: normal;
    font-size: 0.85rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--muted);
  }
</style>
