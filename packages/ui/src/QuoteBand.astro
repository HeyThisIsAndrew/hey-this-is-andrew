---
/**
 * QuoteBand (@andrew/ui): a standalone quote band. Pure black, no imagery,
 * no decoration: the words carry it, set as an editorial title card (left
 * aligned, all caps, tight leading). The band breathes on a desktop and
 * stays compact on a phone.
 */
interface Props {
  eyebrow: string;
  quote: string;
  attribution: string;
  attributionHref?: string;
  /** Accessible name for the band. */
  label?: string;
  variant?: 'editorial' | 'cinematic';
}

const { eyebrow, quote, attribution, attributionHref, label = eyebrow, variant = 'editorial' } = Astro.props;
---
<aside class:list={['quote-band', { 'quote-band--cinematic': variant === 'cinematic' }]} aria-label={label}>
  <div class="container">
    <div class="quote-band-inner">
      <p class="quote-eyebrow">{eyebrow}</p>
      <blockquote>
        <p>"{quote}"</p>
        <cite>
          {attributionHref ? (
            <a class="quote-attribution-link" href={attributionHref} target="_blank" rel="noopener noreferrer">{attribution}</a>
          ) : (
            attribution
          )}
        </cite>
      </blockquote>
    </div>
  </div>
</aside>

<style>
  .quote-band {
    background: #000;
    padding: clamp(3rem, 10vw, 10rem) 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    text-align: left;
  }
  .quote-band-inner {
    width: fit-content;
    max-width: 100%;
    margin-inline: auto;
  }
  .quote-eyebrow {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    color: var(--muted);
    text-align: center;
    margin: 0 0 clamp(1.25rem, 2.5vw, 2.5rem);
  }
  .quote-band blockquote {
    margin: 0;
    text-align: left;
  }
  .quote-band blockquote p {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.35rem, 3.6vw, 2.75rem);
    line-height: 1.12;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: var(--ink);
    max-width: 28ch;
    margin: 0 0 clamp(1.25rem, 2.5vw, 2rem);
    text-wrap: balance;
  }
  .quote-band cite {
    font-style: normal;
    font-size: 0.85rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .quote-attribution-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--muted);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: rgba(255, 255, 255, 0.35);
    transition: color 180ms ease-in-out, text-decoration-color 180ms ease-in-out;
  }
  .quote-attribution-link:is(:hover, :focus-visible) {
    color: var(--ink);
    text-decoration-color: var(--ink);
  }
  .quote-band.quote-band--cinematic {
    padding: clamp(3rem, 5.5vw, 5.5rem) 0;
    border-radius: 0;
  }
  .quote-band--cinematic .quote-eyebrow {
    font-size: clamp(0.75rem, 0.65rem + 0.18vw, 0.95rem);
    margin: 0 0 clamp(1rem, 1.8vw, 1.6rem);
    text-align: center;
  }
  .quote-band--cinematic blockquote {
    text-align: center;
  }
  .quote-band--cinematic blockquote p {
    font-family: 'Cinzel', Georgia, serif;
    font-weight: 500;
    text-transform: none;
    letter-spacing: 0.015em;
    font-size: clamp(1.35rem, 0.95rem + 1.1vw, 2.5rem);
    line-height: 1.32;
    max-width: 42ch;
    margin: 0 auto clamp(1.1rem, 1.8vw, 1.6rem);
    text-wrap: balance;
  }
  .quote-band--cinematic cite {
    display: block;
    text-align: center;
    font-size: clamp(0.8rem, 0.7rem + 0.16vw, 0.98rem);
    letter-spacing: 0.22em;
  }
  @media (max-width: 767px) {
    .quote-band.quote-band--cinematic {
      padding: 1.75rem 0 1.5rem;
    }
    .quote-band--cinematic .quote-band-inner {
      width: 100%;
    }
    .quote-band--cinematic .quote-eyebrow {
      text-align: center;
      margin-bottom: 0.75rem;
      font-size: 0.7rem;
    }
    .quote-band--cinematic blockquote {
      text-align: center;
    }
    .quote-band--cinematic blockquote p {
      font-size: 1.05rem;
      line-height: 1.44;
      max-width: 34ch;
      margin: 0 auto 0.75rem;
      text-align: center;
      text-wrap: pretty;
    }
    .quote-band--cinematic cite {
      display: block;
      text-align: center;
      font-size: 0.74rem;
      letter-spacing: 0.2em;
    }
  }
</style>
