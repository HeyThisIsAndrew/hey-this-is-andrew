---
/**
 * SpotlightBar (@andrew/ui): full-width switching banner carousel lifted from
 * BE Unconventional HQ's HomeSpotlightBar.astro.
 *
 * Uses one clock, never two: the progress bar's CSS animation triggers
 * `animationend` to advance slides, so hovering, focusing, scrolling offscreen,
 * or pressing Pause stops both the bar and the rotation together.
 */
export interface SpotlightSlide {
  tag?: string;
  eyebrow?: string;
  title: string;
  subtitle?: string;
  cta: string;
  href: string;
  external?: boolean;
  imageSrc?: string;
  imageSrcset?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  imageFit?: 'cover' | 'contain';
}

export interface Props {
  slides: SpotlightSlide[];
  label?: string;
  holdSeconds?: number;
  height?: string;
  fullBleed?: boolean;
  class?: string;
  actionLabel?: string;
  actionHref?: string;
}

const {
  slides,
  label = 'Highlights',
  holdSeconds = 7,
  height = 'clamp(250px, 24vw, 440px)',
  fullBleed = false,
  class: className,
  actionLabel,
  actionHref,
} = Astro.props;

const rotates = slides.length > 1;
const hasControls = rotates || Boolean(actionLabel && actionHref);
---

<div
  class:list={['ui-spotlight', { 'ui-spotlight--bleed': fullBleed }, className]}
  data-spotlight
  role="region"
  aria-roledescription={rotates ? 'carousel' : undefined}
  aria-label={label}
  style={`--spotlight-hold: ${holdSeconds}s; --spotlight-h: ${height};`}
>
  <div class="ui-spotlight-frame">
    {slides.map((slide, index) => (
      <a
        href={slide.href}
        target={slide.external ? '_blank' : undefined}
        rel={slide.external ? 'noopener noreferrer' : undefined}
        class:list={[
          'ui-spotlight-slide',
          {
            'is-current': index === 0,
            'is-contain': slide.imageFit === 'contain',
          },
        ]}
        data-spotlight-slide
        data-index={index}
        aria-hidden={index === 0 ? undefined : 'true'}
        inert={index === 0 ? undefined : true}
        tabindex={index === 0 ? undefined : -1}
      >
        {slide.imageSrc && (
          <img
            class:list={['ui-spotlight-bg', { 'ui-spotlight-bg--contain': slide.imageFit === 'contain' }]}
            src={slide.imageSrc}
            srcset={slide.imageSrcset}
            sizes={slide.imageFit === 'contain' ? '(max-width: 599px) 100vw, 68vw' : '(max-width: 720px) 100vw, 90vw'}
            alt={slide.imageFit === 'contain' ? '' : (slide.imageAlt ?? '')}
            width={slide.imageWidth}
            height={slide.imageHeight}
            loading={index === 0 ? 'eager' : 'lazy'}
            decoding="async"
            draggable="false"
          />
        )}
        <span class="ui-spotlight-scrim" aria-hidden="true"></span>
        <span class="ui-spotlight-inner">
          {slide.tag && (
            <span class="ui-spotlight-tags" aria-hidden="true">
              <span class="ui-spotlight-tag">{slide.tag}</span>
            </span>
          )}
          <span class="ui-spotlight-body">
            {slide.eyebrow && <span class="ui-spotlight-eyebrow font-mono">{slide.eyebrow}</span>}
            <span class="ui-spotlight-title display">{slide.title}</span>
            {slide.subtitle && <span class="ui-spotlight-subtitle">{slide.subtitle}</span>}
          </span>
          <span class="ui-spotlight-cta font-mono">
            <span class="ui-spotlight-cta-label">{slide.cta}</span>
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
              <path d="M5 12h14M12 5l7 7-7 7" />
            </svg>
          </span>
        </span>
      </a>
    ))}
  </div>

  {hasControls && (
    <div class="ui-spotlight-controls">
      {rotates && (
        <>
          <button type="button" class="ui-spotlight-nav" data-spotlight-prev hidden aria-label="Previous slide">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="square" aria-hidden="true" focusable="false">
              <polyline points="15 18 9 12 15 6" />
            </svg>
          </button>

          <button type="button" class="ui-spotlight-pause" data-spotlight-pause hidden aria-label="Pause rotation">
            <span class="ui-spotlight-pause-glyph" aria-hidden="true"></span>
          </button>

          <button type="button" class="ui-spotlight-nav" data-spotlight-next hidden aria-label="Next slide">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="square" aria-hidden="true" focusable="false">
              <polyline points="9 18 15 12 9 6" />
            </svg>
          </button>
        </>
      )}

      <div class="ui-spotlight-track-end">
        {rotates && <span class="ui-spotlight-progress" data-spotlight-progress aria-hidden="true"></span>}
        {actionLabel && actionHref && (
          <a class="ui-spotlight-action font-mono" href={actionHref}>
            <span>{actionLabel}</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        )}
      </div>
      <span class="vh" role="status" aria-live="polite" data-spotlight-live></span>
    </div>
  )}
</div>

<style>
  .ui-spotlight {
    width: 100%;
    position: relative;
  }

  .ui-spotlight-frame {
    position: relative;
    container-type: inline-size;
    width: 100%;
    height: var(--spotlight-h, clamp(210px, 24vw, 310px));
    min-height: 190px;
    border-top: 1px solid var(--hairline-strong, rgba(255, 255, 255, 0.14));
    border-bottom: 1px solid var(--hairline-strong, rgba(255, 255, 255, 0.14));
    border-left: 0;
    border-right: 0;
    border-radius: 0;
    background: #0d0d0d;
    overflow: hidden;
    isolation: isolate;
  }

  .ui-spotlight:not(.ui-spotlight--bleed) .ui-spotlight-frame {
    border-inline: 1px solid var(--hairline-strong, rgba(255, 255, 255, 0.14));
  }

  .ui-spotlight--bleed .ui-spotlight-frame {
    border-top: 0;
    border-left: 0;
    border-right: 0;
  }

  .ui-spotlight--bleed .ui-spotlight-inner {
    width: min(100% - clamp(2rem, 4vw, 5rem), var(--maxw, 1536px));
    margin-inline: auto;
    padding-inline: 0;
  }

  .ui-spotlight--bleed .ui-spotlight-controls {
    width: min(100% - clamp(2rem, 4vw, 5rem), var(--maxw, 1536px));
    margin-inline: auto;
  }

  .ui-spotlight-slide {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: stretch;
    text-decoration: none;
    color: var(--ink, #f0f0f0);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.48s ease, visibility 0s linear 0.48s;
  }

  .ui-spotlight-slide.is-current {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition: opacity 0.48s ease, visibility 0s linear 0s;
  }

  .ui-spotlight-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: 0;
    border-radius: 0;
    transition: transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .ui-spotlight-bg--contain {
    top: 0;
    right: 0;
    bottom: 0;
    left: auto;
    width: clamp(54%, 58vw, 72%);
    height: 100%;
    object-fit: contain;
    object-position: right center;
    padding: clamp(0.6rem, 1.8vw, 1.5rem) clamp(1rem, 4vw, 4rem) clamp(0.6rem, 1.8vw, 1.5rem) 0;
    box-sizing: border-box;
  }

  .ui-spotlight-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      linear-gradient(
        to right,
        rgba(8, 8, 8, 0.96) 0%,
        rgba(8, 8, 8, 0.8) 38%,
        rgba(8, 8, 8, 0.22) 72%,
        rgba(8, 8, 8, 0.12) 100%
      ),
      linear-gradient(to top, rgba(8, 8, 8, 0.86) 0%, rgba(8, 8, 8, 0.25) 45%, transparent 72%);
  }

  .ui-spotlight-inner {
    position: relative;
    z-index: 2;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    padding-block: clamp(1rem, 2vw, 1.75rem);
    padding-inline: clamp(1rem, 2.5vw, 2rem);
    min-width: 0;
    box-sizing: border-box;
  }

  .ui-spotlight-inner:has(.ui-spotlight-tags) {
    padding-top: clamp(3.15rem, 4.5vw, 3.85rem);
  }

  .ui-spotlight-tags {
    position: absolute;
    top: clamp(0.85rem, 1.6vw, 1.35rem);
    left: clamp(1rem, 2.5vw, 2rem);
    right: clamp(1rem, 2.5vw, 2rem);
    z-index: 3;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.45rem;
    pointer-events: none;
  }

  .ui-spotlight--bleed .ui-spotlight-tags {
    left: 0;
    right: 0;
  }

  .ui-spotlight-tag {
    display: inline-flex;
    align-items: center;
    max-width: 100%;
    box-sizing: border-box;
    padding: 0.35rem 0.65rem;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-left: 2px solid #f0f0f0;
    background: rgba(10, 10, 10, 0.65);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: rgba(255, 255, 255, 0.9);
    font-family: var(--font-body, sans-serif);
    font-weight: 600;
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    line-height: 1.2;
    white-space: normal;
    overflow-wrap: break-word;
  }

  .ui-spotlight-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
    min-width: 0;
    padding: 0;
  }

  .ui-spotlight-eyebrow {
    font-size: clamp(0.65rem, 0.78vw, 0.76rem);
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--muted, #b2b2b2);
  }

  .ui-spotlight-title {
    font-size: clamp(1.25rem, 2.3vw, 2.2rem);
    line-height: 1.1;
    letter-spacing: 0.04em;
    color: #ffffff;
    overflow-wrap: anywhere;
  }

  .ui-spotlight-subtitle {
    font-size: clamp(0.88rem, 1vw, 1rem);
    line-height: 1.45;
    color: var(--muted, #b2b2b2);
    max-width: 44ch;
  }

  .ui-spotlight-cta {
    margin-left: auto;
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.6rem 1rem;
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 0;
    background: rgba(8, 8, 8, 0.55);
    color: #f5f5f5;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    white-space: nowrap;
    transition: background-color 180ms ease-in-out, color 180ms ease-in-out, border-color 180ms ease-in-out;
  }

  .ui-spotlight-slide:is(:hover, :focus-visible) .ui-spotlight-cta {
    background: #f5f5f5;
    color: #080808;
    border-color: #f5f5f5;
  }

  .ui-spotlight-slide:focus-visible {
    outline: 2px solid var(--focus-ring, #f0f0f0);
    outline-offset: -3px;
  }

  @media (hover: hover) {
    .ui-spotlight-slide:hover .ui-spotlight-bg {
      transform: scale(1.03);
    }
  }

  .ui-spotlight-controls {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-top: 0.7rem;
    min-height: 36px;
  }

  .ui-spotlight-nav,
  .ui-spotlight-pause {
    flex: 0 0 auto;
    width: 34px;
    height: 34px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    background: #080808;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 0;
    color: #f5f5f5;
    cursor: pointer;
    transition: background-color 180ms ease-in-out, color 180ms ease-in-out, border-color 180ms ease-in-out;
  }

  .ui-spotlight-nav[hidden],
  .ui-spotlight-pause[hidden] {
    display: none;
  }

  .ui-spotlight-nav:is(:hover, :focus-visible),
  .ui-spotlight-pause:is(:hover, :focus-visible) {
    background: #f5f5f5;
    color: #080808;
    border-color: #f5f5f5;
  }

  .ui-spotlight-nav svg {
    display: block;
  }

  .ui-spotlight-pause-glyph {
    display: block;
    width: 8px;
    height: 10px;
    border-left: 2.5px solid currentColor;
    border-right: 2.5px solid currentColor;
  }

  .ui-spotlight-pause[data-paused='true'] .ui-spotlight-pause-glyph {
    width: 0;
    height: 0;
    border-left: 8px solid currentColor;
    border-right: 0;
    border-top: 5px solid transparent;
    border-bottom: 5px solid transparent;
  }

  .ui-spotlight-track-end {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 0;
  }

  .ui-spotlight-progress {
    flex: 1 1 0;
    min-width: 24px;
    height: 2px;
    background: rgba(255, 255, 255, 0.14);
    position: relative;
    overflow: hidden;
  }

  .ui-spotlight-action {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    box-sizing: border-box;
    min-height: 34px;
    height: 34px;
    padding: 0 0.85rem;
    background: #080808;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 0;
    color: #f5f5f5;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 180ms ease-in-out, color 180ms ease-in-out, border-color 180ms ease-in-out;
  }

  .ui-spotlight-action:is(:hover, :focus-visible) {
    background: #f5f5f5;
    color: #080808;
    border-color: #f5f5f5;
  }

  .ui-spotlight-progress::after {
    content: '';
    position: absolute;
    inset: 0;
    transform-origin: left center;
    transform: scaleX(0);
    background: var(--spotlight-accent, #f0f0f0);
  }

  .ui-spotlight-progress.is-running::after {
    animation: ui-spotlight-lap var(--spotlight-hold, 7s) linear forwards;
  }

  .ui-spotlight.is-paused .ui-spotlight-progress::after,
  .ui-spotlight.is-held .ui-spotlight-progress::after,
  .ui-spotlight.is-offscreen .ui-spotlight-progress::after {
    animation-play-state: paused;
  }

  @keyframes ui-spotlight-lap {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  @media (max-width: 1023px), (pointer: coarse) {
    .ui-spotlight-controls {
      min-height: 44px;
    }

    .ui-spotlight-nav,
    .ui-spotlight-pause {
      width: 44px;
      height: 44px;
      min-width: 44px;
      min-height: 44px;
    }

    .ui-spotlight-action {
      min-height: 44px;
      height: 44px;
    }
  }

  @media (max-width: 599px) {
    .ui-spotlight-controls {
      gap: 0.45rem;
    }

    .ui-spotlight-action {
      padding: 0 0.65rem;
      font-size: 0.66rem;
      letter-spacing: 0.1em;
    }
    .ui-spotlight-frame {
      height: clamp(195px, 54vw, 235px);
    }

    .ui-spotlight-bg--contain {
      left: 0;
      right: 0;
      width: 100%;
      padding: 0.75rem 0.5rem 2.25rem 28%;
      object-position: right center;
    }

    .ui-spotlight-subtitle {
      display: none;
    }

    .ui-spotlight-cta-label {
      display: none;
    }

    .ui-spotlight-cta {
      width: 44px;
      height: 44px;
      min-width: 44px;
      min-height: 44px;
      padding: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ui-spotlight-slide,
    .ui-spotlight-bg {
      transition: none;
    }

    .ui-spotlight-progress.is-running::after {
      animation: none;
      transform: scaleX(1);
    }
  }
</style>

<script>
  import { createPageScope } from './scripts/page-scope';

  function initSpotlightBars() {
    document.querySelectorAll<HTMLElement>('[data-spotlight]').forEach((root) => {
      if (root.dataset.spotlightBound === 'true') return;
      root.dataset.spotlightBound = 'true';

      const slides = Array.from(root.querySelectorAll<HTMLAnchorElement>('[data-spotlight-slide]'));
      const progress = root.querySelector<HTMLElement>('[data-spotlight-progress]');
      const prevBtn = root.querySelector<HTMLButtonElement>('[data-spotlight-prev]');
      const nextBtn = root.querySelector<HTMLButtonElement>('[data-spotlight-next]');
      const pauseBtn = root.querySelector<HTMLButtonElement>('[data-spotlight-pause]');
      const live = root.querySelector<HTMLElement>('[data-spotlight-live]');

      if (slides.length <= 1) {
        slides[0]?.classList.add('is-current');
        return;
      }

      const { on, cleanup } = createPageScope(root);
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let index = 0;
      let userPaused = false;

      const show = (nextIndex: number, announce = false) => {
        const next = ((nextIndex % slides.length) + slides.length) % slides.length;
        slides.forEach((slide, i) => {
          const active = i === next;
          slide.classList.toggle('is-current', active);
          slide.inert = !active;
          if (active) {
            slide.removeAttribute('aria-hidden');
            slide.removeAttribute('tabindex');
          } else {
            slide.setAttribute('aria-hidden', 'true');
            slide.setAttribute('tabindex', '-1');
          }
        });
        index = next;
        if (announce && live) {
          const title = slides[next].querySelector('.ui-spotlight-title')?.textContent?.trim() || '';
          live.textContent = `Slide ${next + 1} of ${slides.length}: ${title}`;
        }
      };

      const restartClock = () => {
        if (reduced || !progress) return;
        progress.classList.remove('is-running');
        void progress.offsetWidth;
        progress.classList.add('is-running');
      };

      const step = (delta: number, announce = false) => {
        show(index + delta, announce);
        restartClock();
      };

      show(0, false);

      if (prevBtn && nextBtn) {
        prevBtn.hidden = false;
        nextBtn.hidden = false;
        on(prevBtn, 'click', () => step(-1, true));
        on(nextBtn, 'click', () => step(1, true));
      }

      // Keyboard navigation when focused inside spotlight
      on(root, 'keydown', (event: KeyboardEvent) => {
        if (event.key === 'ArrowLeft') {
          event.preventDefault();
          step(-1, true);
        } else if (event.key === 'ArrowRight') {
          event.preventDefault();
          step(1, true);
        }
      });

      // Touch horizontal swipe support on frame
      let swipeX: number | null = null;
      let swipeY = 0;
      const frame = root.querySelector<HTMLElement>('.ui-spotlight-frame');
      if (frame) {
        on(frame, 'pointerdown', (e: PointerEvent) => {
          if (!e.isPrimary || e.button !== 0) return;
          swipeX = e.clientX;
          swipeY = e.clientY;
        });
        on(frame, 'pointerup', (e: PointerEvent) => {
          if (swipeX === null) return;
          const dx = e.clientX - swipeX;
          const dy = e.clientY - swipeY;
          swipeX = null;
          if (Math.abs(dx) > 42 && Math.abs(dx) > Math.abs(dy)) {
            step(dx < 0 ? 1 : -1, true);
          }
        });
        on(frame, 'pointercancel', () => {
          swipeX = null;
        });
      }

      if (reduced || !progress) return;

      on(progress, 'animationend', () => {
        step(1, false);
      });

      if (pauseBtn) {
        pauseBtn.hidden = false;
        on(pauseBtn, 'click', () => {
          userPaused = !userPaused;
          root.classList.toggle('is-paused', userPaused);
          pauseBtn.dataset.paused = String(userPaused);
          pauseBtn.setAttribute('aria-label', userPaused ? 'Play rotation' : 'Pause rotation');
        });
      }

      on(root, 'mouseenter', () => root.classList.add('is-held'));
      on(root, 'mouseleave', () => root.classList.remove('is-held'));
      on(root, 'focusin', () => root.classList.add('is-held'));
      on(root, 'focusout', (e: FocusEvent) => {
        if (!root.contains(e.relatedTarget as Node | null)) {
          root.classList.remove('is-held');
        }
      });

      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((en) => root.classList.toggle('is-offscreen', !en.isIntersecting));
          },
          { threshold: 0 },
        );
        io.observe(root);
        cleanup(() => io.disconnect());
      }

      restartClock();
    });
  }

  initSpotlightBars();
  document.addEventListener('astro:page-load', initSpotlightBars);
</script>
