---
/**
 * SubstackGallery — upgrades <substack-gallery> elements emitted by the article
 * sanitizer into a natively scrollable CSS scroll-snap carousel paired with a
 * native <dialog> lightbox, and handles standalone [data-lightbox-image] triggers.
 *
 * Reads @andrew/tokens custom properties (--color-accent, --focus-ring, --ink).
 */
---
<script>
  const LIGHTBOX_BACKDROP_IGNORE = 'img, button';

  function widestRendition(img: HTMLImageElement): string {
    let best = img.currentSrc || img.src;
    let bestWidth = 0;
    for (const [, rawUrl, w] of (img.getAttribute('srcset') || '').matchAll(/(\S+)\s+(\d+)w/g)) {
      const url = rawUrl.replace(/^,+/, '');
      const width = Number(w);
      if (url && width > bestWidth) {
        best = new URL(url, location.href).href;
        bestWidth = width;
      }
    }
    return best;
  }

  function redirectFocusIfDisabled(
    control: HTMLButtonElement,
    opposite: HTMLButtonElement,
    shouldDisable: boolean,
  ): void {
    if (shouldDisable && document.activeElement === control && !opposite.disabled) {
      opposite.focus({ preventScroll: true });
    }
    control.disabled = shouldDisable;
  }

  function openLightbox(
    startIndex: number,
    imageSources: Array<{ src: string; alt: string }>,
    onClose?: (lastIndex: number) => void,
  ): void {
    document.getElementById('substack-lightbox')?.remove();

    const dialog = document.createElement('dialog');
    dialog.id = 'substack-lightbox';
    dialog.className = 'substack-lightbox';
    dialog.setAttribute('closedby', 'any');
    dialog.setAttribute('aria-label', 'Image viewer');

    const closeBtn = document.createElement('button');
    closeBtn.type = 'button';
    closeBtn.className = 'substack-lightbox-close';
    closeBtn.innerHTML = '&times;';
    closeBtn.setAttribute('aria-label', 'Close fullscreen');

    let currentIndex = Math.max(0, Math.min(startIndex, imageSources.length - 1));
    const img = document.createElement('img');
    img.className = 'substack-lightbox-img';

    const status = document.createElement('p');
    status.className = 'substack-gallery-vh';
    status.setAttribute('role', 'status');
    status.setAttribute('aria-live', 'polite');

    const lbLeftArrow = document.createElement('button');
    lbLeftArrow.type = 'button';
    lbLeftArrow.className = 'substack-gallery-arrow left-arrow';
    lbLeftArrow.innerHTML =
      '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>';
    lbLeftArrow.setAttribute('aria-label', 'Previous image');

    const lbRightArrow = document.createElement('button');
    lbRightArrow.type = 'button';
    lbRightArrow.className = 'substack-gallery-arrow right-arrow';
    lbRightArrow.innerHTML =
      '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>';
    lbRightArrow.setAttribute('aria-label', 'Next image');

    const updateLbArrows = () => {
      const atStart = currentIndex <= 0;
      const atEnd = currentIndex >= imageSources.length - 1;
      redirectFocusIfDisabled(lbLeftArrow, lbRightArrow, atStart);
      redirectFocusIfDisabled(lbRightArrow, lbLeftArrow, atEnd);
      lbLeftArrow.classList.toggle('disabled', atStart);
      lbRightArrow.classList.toggle('disabled', atEnd);
    };

    const updateImage = (announce = false) => {
      const item = imageSources[currentIndex];
      if (!item) return;
      img.src = item.src;
      img.alt = item.alt || '';
      if (announce && imageSources.length > 1) {
        status.textContent = `Image ${currentIndex + 1} of ${imageSources.length}`;
      }
      updateLbArrows();
    };

    const next = () => {
      if (currentIndex < imageSources.length - 1) {
        currentIndex++;
        updateImage(true);
      }
    };

    const prev = () => {
      if (currentIndex > 0) {
        currentIndex--;
        updateImage(true);
      }
    };

    dialog.appendChild(lbLeftArrow);
    dialog.appendChild(lbRightArrow);
    dialog.appendChild(closeBtn);
    dialog.appendChild(img);
    dialog.appendChild(status);

    updateImage(false);

    closeBtn.addEventListener('click', () => dialog.close());
    lbLeftArrow.addEventListener('click', (e) => {
      e.stopPropagation();
      prev();
    });
    lbRightArrow.addEventListener('click', (e) => {
      e.stopPropagation();
      next();
    });

    // Fallback light dismiss when clicking outside the image/controls or on browsers lacking closedBy.
    const isOutsideContent = (e: PointerEvent | MouseEvent) => {
      const target = e.target as Element | null;
      return !target || !target.closest(LIGHTBOX_BACKDROP_IGNORE);
    };

    let pressedOutside = false;
    dialog.addEventListener('pointerdown', (e) => {
      pressedOutside = isOutsideContent(e);
    });
    dialog.addEventListener('pointerup', (e) => {
      if (pressedOutside && isOutsideContent(e)) {
        dialog.close();
      }
      pressedOutside = false;
    });

    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') {
        e.preventDefault();
        next();
      } else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        prev();
      }
    });

    let touchStartX = 0;
    dialog.addEventListener(
      'touchstart',
      (e) => {
        touchStartX = e.changedTouches[0]?.screenX ?? 0;
      },
      { passive: true },
    );
    dialog.addEventListener(
      'touchend',
      (e) => {
        const touchEndX = e.changedTouches[0]?.screenX ?? 0;
        if (touchEndX < touchStartX - 50) next();
        if (touchEndX > touchStartX + 50) prev();
      },
      { passive: true },
    );

    let wheelTimeout: ReturnType<typeof setTimeout> | null = null;
    dialog.addEventListener(
      'wheel',
      (e) => {
        if (Math.abs(e.deltaX) <= 20) return;
        e.preventDefault();
        if (wheelTimeout) return;
        if (e.deltaX > 20) {
          next();
          wheelTimeout = setTimeout(() => {
            wheelTimeout = null;
          }, 300);
        } else if (e.deltaX < -20) {
          prev();
          wheelTimeout = setTimeout(() => {
            wheelTimeout = null;
          }, 300);
        }
      },
      { passive: false },
    );

    dialog.addEventListener('close', () => {
      if (wheelTimeout) clearTimeout(wheelTimeout);
      onClose?.(currentIndex);
      dialog.remove();
    });

    document.body.appendChild(dialog);
    dialog.showModal();
  }

  class SubstackGalleryElement extends HTMLElement {
    connectedCallback() {
      if (this.dataset.initialized) return;
      this.dataset.initialized = 'true';

      const images = Array.from(this.querySelectorAll('img'));
      if (images.length === 0) return;

      const imageSources = images.map((img) => ({
        src: widestRendition(img),
        alt: img.alt,
      }));

      const wrapper = document.createElement('div');
      wrapper.className = 'substack-gallery-wrapper';
      wrapper.setAttribute('role', 'region');
      wrapper.setAttribute('aria-roledescription', 'carousel');
      wrapper.setAttribute('aria-label', 'Image gallery');

      const leftArrow = document.createElement('button');
      leftArrow.type = 'button';
      leftArrow.className = 'substack-gallery-arrow left-arrow';
      leftArrow.innerHTML =
        '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>';
      leftArrow.setAttribute('aria-label', 'Previous slide');

      const rightArrow = document.createElement('button');
      rightArrow.type = 'button';
      rightArrow.className = 'substack-gallery-arrow right-arrow';
      rightArrow.innerHTML =
        '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>';
      rightArrow.setAttribute('aria-label', 'Next slide');

      const controls = document.createElement('div');
      controls.className = 'substack-gallery-controls';
      controls.appendChild(leftArrow);
      controls.appendChild(rightArrow);

      const container = document.createElement('div');
      container.className = 'substack-gallery-container';
      container.tabIndex = 0;
      container.setAttribute('role', 'group');
      container.setAttribute('aria-label', 'Slides');

      const slides: HTMLElement[] = [];

      images.forEach((img, index) => {
        const slide = document.createElement('div');
        slide.className = 'substack-gallery-slide';
        slide.setAttribute('role', 'group');
        slide.setAttribute('aria-roledescription', 'slide');
        slide.setAttribute('aria-label', `${index + 1} of ${images.length}`);

        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'substack-gallery-trigger';
        button.setAttribute(
          'aria-label',
          `View image ${index + 1} of ${images.length} full screen`,
        );

        button.addEventListener('click', (e) => {
          e.preventDefault();
          openLightbox(index, imageSources, (lastIndex) => {
            const targetSlide = slides[lastIndex];
            if (targetSlide) {
              container.scrollTo({
                left: targetSlide.offsetLeft - container.offsetLeft - 16,
                behavior: 'instant',
              });
            }
          });
        });

        button.appendChild(img);
        slide.appendChild(button);
        container.appendChild(slide);
        slides.push(slide);
      });

      const status = document.createElement('p');
      status.className = 'substack-gallery-vh';
      status.setAttribute('role', 'status');
      status.setAttribute('aria-live', 'polite');

      wrapper.appendChild(controls);
      wrapper.appendChild(container);
      wrapper.appendChild(status);

      this.innerHTML = '';
      this.appendChild(wrapper);

      let settledIndex = 0;

      const nearestSlideIndex = (): number => {
        const center = container.scrollLeft + container.clientWidth / 2;
        let bestIdx = 0;
        let bestDist = Infinity;
        slides.forEach((slide, idx) => {
          const slideCenter = slide.offsetLeft - container.offsetLeft + slide.clientWidth / 2;
          const dist = Math.abs(slideCenter - center);
          if (dist < bestDist) {
            bestDist = dist;
            bestIdx = idx;
          }
        });
        return bestIdx;
      };

      const updateArrows = () => {
        const scrollLeft = container.scrollLeft;
        const maxScroll = container.scrollWidth - container.clientWidth;
        const atStart = scrollLeft <= 5;
        const atEnd = maxScroll <= 5 || scrollLeft >= maxScroll - 5;

        redirectFocusIfDisabled(leftArrow, rightArrow, atStart);
        redirectFocusIfDisabled(rightArrow, leftArrow, atEnd);
        leftArrow.classList.toggle('disabled', atStart);
        rightArrow.classList.toggle('disabled', atEnd);
      };

      const onSettle = (announce: boolean) => {
        updateArrows();
        const current = nearestSlideIndex();
        if (announce && current !== settledIndex) {
          settledIndex = current;
          status.textContent = `Slide ${current + 1} of ${slides.length}`;
        } else {
          settledIndex = current;
        }
      };

      if ('onscrollend' in window) {
        container.addEventListener('scrollend', () => onSettle(true));
      } else {
        let debounceTimer: ReturnType<typeof setTimeout> | null = null;
        container.addEventListener(
          'scroll',
          () => {
            if (debounceTimer) clearTimeout(debounceTimer);
            debounceTimer = setTimeout(() => onSettle(true), 120);
          },
          { passive: true },
        );
      }

      container.addEventListener(
        'scroll',
        () => {
          requestAnimationFrame(updateArrows);
        },
        { passive: true },
      );

      setTimeout(() => onSettle(false), 50);

      const scrollStep = (delta: -1 | 1) => {
        const targetIdx = Math.max(0, Math.min(slides.length - 1, nearestSlideIndex() + delta));
        const target = slides[targetIdx];
        if (!target) return;
        const targetCenter = target.offsetLeft - container.offsetLeft + target.clientWidth / 2;
        const offset = targetCenter - container.clientWidth / 2 - container.scrollLeft;
        container.scrollBy({ left: offset });
      };

      leftArrow.addEventListener('click', () => scrollStep(-1));
      rightArrow.addEventListener('click', () => scrollStep(1));
    }
  }

  if (typeof window !== 'undefined' && typeof HTMLElement !== 'undefined') {
    if (!customElements.get('substack-gallery')) {
      customElements.define('substack-gallery', SubstackGalleryElement);
    }

    const w = window as unknown as { __substackGalleryClickBound?: boolean };
    if (!w.__substackGalleryClickBound) {
      w.__substackGalleryClickBound = true;
      document.addEventListener('click', (e) => {
        const trigger = (e.target as Element | null)?.closest?.('[data-lightbox-image]');
        const img = trigger?.querySelector('img');
        if (!img) return;
        e.preventDefault();
        openLightbox(0, [{ src: widestRendition(img), alt: img.alt }]);
      });
    }
  }
</script>

<style is:global>
  substack-gallery {
    display: block;
    margin: 2.5rem 0;
    width: 100%;
    position: relative;
  }

  .substack-gallery-wrapper {
    position: relative;
    width: 100%;
  }

  .substack-gallery-controls {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 10;
  }

  .substack-gallery-vh {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (hover: hover) and (pointer: fine) {
    .substack-gallery-wrapper:hover .substack-gallery-arrow:not(:disabled),
    .substack-gallery-wrapper:focus-within .substack-gallery-arrow:not(:disabled),
    dialog.substack-lightbox[open] .substack-gallery-arrow:not(:disabled) {
      opacity: 0.72;
      pointer-events: auto;
    }
  }

  .substack-gallery-container {
    display: flex;
    align-items: center;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    gap: 1rem;
    mask-image: linear-gradient(
      to right,
      transparent 0,
      black 16px,
      black calc(100% - 16px),
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0,
      black 16px,
      black calc(100% - 16px),
      transparent 100%
    );
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior-x: contain;
    touch-action: manipulation;
    container-type: inline-size;
  }

  @media (prefers-reduced-motion: no-preference) {
    .substack-gallery-container {
      scroll-behavior: smooth;
    }
  }

  .substack-gallery-container::-webkit-scrollbar {
    display: none;
  }

  .substack-gallery-slide {
    flex: 0 0 85cqw;
    scroll-snap-align: center;
    scroll-snap-stop: always;
    overflow: hidden;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  @media (min-width: 768px) {
    .substack-gallery-slide {
      flex: 0 0 75cqw;
    }
  }

  .substack-gallery-slide button.substack-gallery-trigger {
    display: block;
    width: 100%;
    background: transparent;
    border: none;
    padding: 0;
    cursor: pointer;
    text-align: left;
  }

  .substack-gallery-slide img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 70vh;
    object-fit: contain;
    transition: transform 0.3s ease;
  }

  .substack-gallery-slide button:hover img {
    transform: scale(1.02);
  }

  .substack-gallery-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    background: rgba(10, 10, 10, 0.55);
    color: var(--ink, #f0f0f0);
    border: 1px solid var(--hairline-strong, rgba(255, 255, 255, 0.2));
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    touch-action: manipulation;
    opacity: 0.45;
    pointer-events: auto;
    transition:
      opacity 0.25s ease,
      border-color 0.25s ease,
      color 0.25s ease;
    z-index: 10;
    padding: 0;
  }

  .substack-gallery-arrow:hover:not(:disabled),
  .substack-gallery-arrow:focus-visible:not(:disabled) {
    opacity: 1 !important;
    border-color: var(--color-accent, #b2b2b2);
    color: var(--color-accent-hover, #ffffff);
  }

  .substack-gallery-arrow:focus-visible,
  .substack-gallery-trigger:focus-visible,
  .substack-lightbox-close:focus-visible {
    outline: 2px solid var(--focus-ring, #f0f0f0);
    outline-offset: 2px;
  }

  .substack-gallery-arrow.left-arrow {
    left: 1rem;
  }

  .substack-gallery-arrow.right-arrow {
    right: 1rem;
  }

  dialog.substack-lightbox .substack-gallery-arrow.left-arrow {
    left: max(1rem, env(safe-area-inset-left));
  }

  dialog.substack-lightbox .substack-gallery-arrow.right-arrow {
    right: max(1rem, env(safe-area-inset-right));
  }

  .substack-gallery-arrow:disabled,
  .substack-gallery-arrow.disabled {
    opacity: 0 !important;
    pointer-events: none !important;
  }

  /* Native top-layer modal lightbox */
  dialog.substack-lightbox {
    position: fixed;
    inset: 0;
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: none;
    background: rgba(0, 0, 0, 0.92);
    color: var(--ink, #f0f0f0);
    z-index: 300;
  }

  dialog.substack-lightbox[open] {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  dialog.substack-lightbox:modal {
    overscroll-behavior: contain;
  }

  dialog.substack-lightbox::backdrop {
    background: rgba(0, 0, 0, 0.9);
    overflow: hidden;
    overscroll-behavior: contain;
    backdrop-filter: blur(5px);
  }

  .substack-lightbox-img {
    max-width: min(
      95vw,
      calc(100vw - env(safe-area-inset-left) - env(safe-area-inset-right) - 2rem)
    );
    max-height: min(
      95dvh,
      calc(100dvh - env(safe-area-inset-top) - env(safe-area-inset-bottom) - 2rem)
    );
    object-fit: contain;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    cursor: default;
  }

  .substack-lightbox-close {
    position: absolute;
    top: max(1rem, env(safe-area-inset-top));
    right: max(1.5rem, env(safe-area-inset-right));
    min-width: 44px;
    min-height: 44px;
    background: transparent;
    border: none;
    color: var(--ink, #f0f0f0);
    font-size: 2.5rem;
    line-height: 1;
    font-weight: 300;
    cursor: pointer;
    z-index: 310;
    padding: 0.25rem 0.5rem;
    opacity: 0.75;
    transition: opacity 0.2s;
  }

  .substack-lightbox-close:hover {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .substack-gallery-slide img,
    .substack-gallery-arrow,
    .substack-lightbox-close {
      transition: none;
    }
  }
</style>
