---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

import SectionHeader from './SectionHeader.astro';

// Photography portfolio: parallel vertical elevators.
// Four columns (two on mobile), each a continuous vertical reel.
// Columns alternate direction and speed. Photos keep their natural
// aspect ratios (vertical and horizontal mix as part of the composition),
// so a photo is never cropped to a sliver of itself.
// Clicking a photo dollies the camera in just far enough to show the whole
// photo; the neighbouring reels stay on screen and tappable.
//
// Rendered UNCONDITIONALLY (it is the homepage's photography section, right
// after About): with no synced photos it shows a short empty state, never
// nothing.

interface DisplayPhoto {
  id: string;
  image: ImageMetadata;
  caption: string;
  category: 'cocktails' | 'bar' | 'product' | string;
  location: string;
  venue?: string;
  event?: string;
  permalink?: string;
  duration?: string;
  /** An Instagram reel: its frame shows here; it plays in the zoomed view. */
  video: boolean;
  /** The reel as a self-hosted file (public URL), when the sync has one. */
  videoSrc?: string;
}


export interface Props {
  photos: DisplayPhoto[];
  emptyText?: string;
  /** Where the credit line's "More about the work" goes. The homepage
      passes "#about" (its own section); elsewhere it is the About page. */
  aboutHref?: string;
}

const { photos: displayPhotos, emptyText = 'No photos configured yet.', aboutHref } = Astro.props;

const categoryLabels: Record<string, string> = {
  cocktails: 'Cocktails',
  bar: 'Bars',
  product: 'Product',
};

// Distribute photos across 4 columns for visual rhythm.
const COLUMN_COUNT = 4;
const columns: number[][] = Array.from({ length: COLUMN_COUNT }, () => []);
displayPhotos.forEach((_, i) => {
  columns[i % COLUMN_COUNT].push(i);
});

const directions = ['up', 'down', 'up', 'down'];
const durations = [58, 74, 66, 82];
// The note links to the About page (this section also renders on /work,
// where there is no #about).
const aboutUrl = aboutHref ?? `${import.meta.env.BASE_URL.replace(/\/$/, '')}/about/`;
// Each reel renders its photos twice: the CSS/WAAPI loop translates the
// track by -50%, which is seamless only over two identical sets. The copy
// is aria-hidden and out of the tab order.
const SETS = [0, 1];
---

<section id="photos" class="photo-section" aria-labelledby="photography-title">
  <div class="photo-zoom-backdrop" aria-hidden="true"></div>
  <div class="photo-intro">
    <SectionHeader
      kicker="Photography"
      title="Shot on the job."
      lede="Bar and beverage photography. The work behind Capture Create Caffeinate. Available for select photography work."
      id="photography-title"
    />
  </div>

  {displayPhotos.length === 0 ? (
    <p class="photo-empty">The photographs could not be loaded right now. Please check back soon.</p>
  ) : (
  <div class="photo-grid-container">
    <div class="photo-stage-wrap">
      <div id="camera-stage" class="camera-stage">
        <div class="photo-wall" role="region" aria-label="Photography portfolio, vertical image reels" data-photo-total={displayPhotos.length}>
    {columns.map((col, ci) => (
      <div
        class="photo-column"
        data-column={ci}
        data-direction={directions[ci]}
        style={`--reel-duration: ${durations[ci]}s`}
      >
        <div class="photo-track">
          {SETS.map((set) => (
          <div class="photo-set" aria-hidden={set === 1 ? 'true' : undefined}>
            {col.map((pi) => {
              const p = displayPhotos[pi];
              if (!p) return null;
              return (
                <button
                  type="button"
                  class="photo-item"
                  data-camera-zoom
                  data-photo-index={pi}
                  data-video-url={p.video ? p.permalink : undefined}
                  data-video-src={p.video && p.videoSrc ? p.videoSrc : undefined}
                  tabindex={set === 1 ? -1 : undefined}
                  style={`aspect-ratio: ${p.image.width} / ${p.image.height}`}
                  aria-label={p.video ? `Open video: ${p.caption}` : `View photo: ${p.caption}`}
                >
                  <Image
                    src={p.image}
                    alt={set === 0 ? p.caption : ""}
                    widths={[360, 540, 720, 1080]}
                    sizes="(max-width: 767px) 50vw, 540px"
                    format="webp"
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="photo-tag">
                    {p.video && (
                      <svg class="photo-tag-video-icon" width="10" height="10" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M8 5v14l11-7z" />
                      </svg>
                    )}
                    {p.location || categoryLabels[p.category] || 'Cocktails'}
                  </span>
                  {p.video && (
                    <div class="photo-play-badge" data-action="play-reel" aria-hidden="true">
                      <div class="photo-play-icon-wrap">
                        <svg viewBox="0 0 24 24" fill="currentColor">
                          <path d="M8 5v14l11-7z" />
                        </svg>
                      </div>
                      <span class="photo-play-label">Video</span>
                      {p.duration && <span class="photo-play-duration">{p.duration}</span>}
                    </div>
                  )}
                </button>
              );
            })}
          </div>
          ))}
        </div>
      </div>
    ))}
        </div><!-- /.photo-wall -->
      </div><!-- /#camera-stage -->
    </div><!-- /.photo-stage-wrap -->
  </div><!-- /.photo-grid-container -->
  )}
  {/* Persistent elevator HUD: progress counter (Item X of Y) + Close control */}
  <div class="photo-hud" data-photo-hud hidden aria-label="Photo elevator controls">
    <span class="photo-progress" data-photo-progress role="status" aria-live="polite" aria-atomic="true">
      Item 1 of {displayPhotos.length}
    </span>
    <button type="button" class="photo-close" data-photo-close aria-label="Close photo view">
      <span aria-hidden="true">Close</span>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>
  {/* Zoomed onto a reel, the dock offers Play (in place) and the way out
      to Instagram. Photos get none. */}
  <div class="photo-actions" data-photo-actions hidden>
    <button type="button" class="btn btn-primary photo-play-btn" data-photo-play aria-label="Play video reel">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M8 5v14l11-7z" />
      </svg>
      <span>Play<span class="photo-label-long"> Video</span></span>
    </button>
    <a class="btn btn-secondary photo-watch" href="#" target="_blank" rel="noopener" data-photo-watch aria-label="Watch video on Instagram">
      <span><span class="photo-label-long">Watch video on </span>Instagram</span>
      <svg width="13" height="13" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <path d="M2 12L12 2H5M12 2v7" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" />
      </svg>
    </a>
  </div>

  {/* The in-place player. A video tile zooms into the elevator view like
      a photo; only there, from the dock's Play button or a second tap on
      the zoomed tile, does it play, laid exactly over the zoomed tile.
      Only a self-hosted file plays here (data-video-src, downloaded by the
      deploy's Instagram sync or dropped in public/reels/<id>.mp4). A reel
      without one has no Play button: Instagram's embed refuses those, so the
      dock's "Watch on Instagram" link is the way to it. */}
  <div class="photo-player" data-photo-player hidden>
    <button type="button" class="photo-player-close" data-photo-player-close aria-label="Stop video">&times;</button>
    <div class="photo-player-media" data-photo-player-media></div>
  </div>

  <p class="photo-note">
    Photographs by Andrew Baxter. Shot for Capture Create Caffeinate. <a href={aboutUrl}>More about the work</a>.
  </p>
</section>

<style>
  .photo-section {
    position: relative;
    padding: var(--space-section) 0;
    overflow: hidden;
    overflow-anchor: none;
  }
  /* Header, grid and note sit on the site's .container measure, so this
     section lines up with every other section (it used its own max-width
     plus padding and sat ~20px further in). */
  .photo-intro {
    position: relative;
    z-index: 10;
    opacity: 1;
    transform: translateY(0);
    transition:
      opacity 0.36s cubic-bezier(0.22, 1, 0.36, 1) 0.22s,
      transform 0.36s cubic-bezier(0.22, 1, 0.36, 1) 0.22s;
    width: min(100% - clamp(2rem, 4vw, 5rem), var(--maxw));
    margin: 0 auto;
  }
  .photo-section.is-zoomed .photo-intro {
    opacity: 0;
    transform: translateY(-6px);
    pointer-events: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .photo-grid-container {
    width: min(100% - clamp(2rem, 4vw, 5rem), var(--maxw));
    margin: 2rem auto 0;
    position: relative;
  }

  .photo-wall {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(12px, 1.5vw, 24px);
    width: 100%;
    max-width: 100%;
    margin: 0 auto;
    padding: 0;
    /* Tall enough to feel like reels with proportional height across 4K displays */
    height: clamp(540px, 75vh, 1600px);
    min-height: 520px;
  }

  .photo-column {
    overflow: hidden;
    position: relative;
    width: 100%;
  }

  .photo-track {
    display: flex;
    flex-direction: column;
    /* Seamless loop: two identical sets, translate -50%. */
    animation: reel var(--reel-duration, 70s) linear infinite;
    will-change: transform;
  }
  .photo-column[data-direction="down"] .photo-track {
    animation-direction: reverse;
  }
  /* Pause the reel you're inspecting. */
  .photo-column:hover .photo-track,
  .photo-column:focus-within .photo-track {
    animation-play-state: paused;
  }

  /* JS-driven reels: the keyframe animation is replaced by WAAPI
     (compositor-thread, no main-thread jitter) plus pointer drag.
     Applied only when the script initializes, so no-JS still gets
     the CSS autoplay. */
  .photo-wall.js-reels {
    touch-action: pan-y;
    cursor: grab;
  }
  .photo-wall.js-reels.is-dragging {
    cursor: grabbing;
    touch-action: none;
  }
  .photo-wall.js-reels .photo-track {
    animation: none;
  }
  .photo-wall.js-reels .photo-item {
    user-select: none;
    -webkit-user-select: none;
  }
  .photo-wall.js-reels .photo-item img {
    -webkit-user-drag: none;
    pointer-events: none;
  }

  @keyframes reel {
    from { transform: translateY(0); }
    to { transform: translateY(-50%); }
  }

  .photo-set {
    display: flex;
    flex-direction: column;
    gap: clamp(12px, 1.5vw, 24px);
    padding-bottom: clamp(12px, 1.5vw, 24px);
  }

  .photo-item {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: #111;
    cursor: pointer;
    overflow: hidden;
    /* The cell takes the photo's own aspect ratio (inline style), so the
       whole photo shows. Forced 16:9 / 1:1 / 4:5 cells cut portrait photos
       to slivers. */
    aspect-ratio: 4 / 5;
    transition: border-color 0.3s ease, transform 0.3s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .photo-item img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    /* Subtle cinematic grade at rest, full color on hover. */
    filter: grayscale(0.35) contrast(1.02);
    transition: filter 0.4s ease, transform 0.5s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  /* Mouse hover only: on a phone :hover sticks after a tap, which caused
     the image to jump to scale(1.03) and the tag to stay stuck when zoom
     ended. Disabled while zoomed or closing so exiting never triggers a
     scale(1.03) pop on the hovered card. */
  @media (hover: hover) and (pointer: fine) {
    .photo-stage-wrap:not(.is-zoomed):not(.is-closing) .photo-item:hover img {
      filter: grayscale(0) contrast(1.05);
      transform: scale(1.03);
    }
    .photo-stage-wrap:not(.is-zoomed):not(.is-closing) .photo-item:hover {
      border-color: rgba(255, 255, 255, 0.35);
    }
    .photo-stage-wrap:not(.is-zoomed):not(.is-closing) .photo-item:hover .photo-tag {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .photo-item:focus-visible img,
  .photo-item.is-active img {
    filter: grayscale(0) contrast(1.05);
  }
  .photo-item:focus-visible {
    border-color: rgba(255, 255, 255, 0.6);
    outline: 2px solid var(--focus-ring, #f0f0f0);
    outline-offset: -2px;
  }
  .photo-item:active {
    transform: scale(0.98);
  }

  .photo-tag {
    position: absolute;
    left: 0.6rem;
    bottom: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.85);
    background: rgba(0, 0, 0, 0.65);
    padding: 0.3rem 0.55rem;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.25s ease, transform 0.25s ease;
    pointer-events: none;
  }
  .photo-item:focus-visible .photo-tag {
    opacity: 1;
    transform: translateY(0);
  }
  .camera-stage.is-zoomed .photo-tag,
  .photo-stage-wrap.is-closing .photo-tag {
    opacity: 0 !important;
    transform: translateY(4px) !important;
  }

  .photo-empty {
    width: min(100% - clamp(2rem, 4vw, 5rem), var(--maxw));
    box-sizing: border-box;
    margin: 1.5rem auto 0;
    padding: 2.5rem clamp(1.25rem, 4vw, 2.5rem);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--color-white-muted, #888);
    font-size: 0.9rem;
    text-align: center;
  }

  .photo-note {
    position: relative;
    z-index: 10;
    width: min(100% - clamp(2rem, 4vw, 5rem), var(--maxw));
    /* A caption: close under the wall (whose last ~30px already fade
       out), not floating in the gap below it. */
    margin: 1.25rem auto 0;
    font-size: 0.85rem;
    color: var(--color-white-muted, #888);
    text-align: center;
    opacity: 1;
    transform: translateY(0);
    transition:
      opacity 0.36s cubic-bezier(0.22, 1, 0.36, 1) 0.22s,
      transform 0.36s cubic-bezier(0.22, 1, 0.36, 1) 0.22s;
  }
  .photo-section.is-zoomed .photo-note {
    opacity: 0;
    transform: translateY(6px);
    pointer-events: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  .photo-note a {
    color: var(--color-accent-text, #f0f0f0);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Mobile: two columns, shorter reels — the concept adapts, not hidden. */
  @media (max-width: 767px) {
    .photo-note {
      margin-top: 0.75rem;
    }
    /* The link gets a full tap height on a phone. */
    .photo-note a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      /* The box is 44 tall; the negative margin keeps it from spreading
         the caption's lines apart. */
      margin: -13px 0;
      vertical-align: middle;
    }
    .photo-wall {
      grid-template-columns: repeat(2, 1fr);
      height: 74vh;
      min-height: 480px;
    }
    /* On mobile show columns 1 and 3 (up-direction pair) for variety. */
    .photo-column:nth-child(2),
    .photo-column:nth-child(4) {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .photo-track {
      animation: none;
    }
    .photo-wall {
      height: auto;
      min-height: 0;
    }
    .photo-stage-wrap::before,
    .photo-stage-wrap::after {
      display: none;
    }
    .photo-item img {
      filter: none;
    }
  }

  /* Camera stage: the viewport wrapper for the zoom effect.
     The entire photo wall scales from a transform-origin, simulating
     a camera lens moving closer. Overflow hidden on the wrapper ensures
     the scaled content flows past the screen edges cleanly. */
  .photo-stage-wrap {
    overflow: hidden;
    position: relative;
    width: 100%;
    clip-path: inset(0px 0px 0px 0px);
  }
  /* Top and bottom edge dissolve scrims: unlike mask-image (which cannot
     transition in CSS and popped back in on exit), opacity on pseudo-element
     scrims crossfades smoothly above #camera-stage (z-index 55 > 50). */
  .photo-stage-wrap::before,
  .photo-stage-wrap::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: 8%;
    z-index: 55;
    pointer-events: none;
    opacity: 1;
    transition: opacity 0.38s cubic-bezier(0.22, 1, 0.36, 1) 0.18s;
  }
  .photo-stage-wrap::before {
    top: 0;
    background: linear-gradient(to bottom, var(--bg, #0a0a0a) 0%, rgba(10, 10, 10, 0) 100%);
  }
  .photo-stage-wrap::after {
    bottom: 0;
    background: linear-gradient(to top, var(--bg, #0a0a0a) 0%, rgba(10, 10, 10, 0) 100%);
  }
  .photo-stage-wrap.is-zoomed:not(.is-closing)::before,
  .photo-stage-wrap.is-zoomed:not(.is-closing)::after {
    opacity: 0;
    transition: opacity 0.24s ease;
  }

  /* `is-camera` holds from the moment the camera moves in until it has
     landed back out (longer than `is-zoomed`, which drives the backdrop and
     the header fade), while clip-path on .photo-stage-wrap smoothly
     interpolates between the viewport and the resting wall box. */
  .photo-stage-wrap.is-zoomed,
  .photo-stage-wrap.is-closing,
  .photo-section.is-camera {
    overflow: visible;
    z-index: 50;
  }

  /* Bottom actions dock for video reels */
  .photo-actions {
    position: fixed;
    left: 50%;
    bottom: calc(1.5rem + env(safe-area-inset-bottom, 0px));
    z-index: 60;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    white-space: nowrap;
    opacity: 0;
    transform: translate3d(-50%, 14px, 0);
    pointer-events: none;
    transition:
      opacity 0.28s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.28s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .photo-actions[hidden] {
    display: none;
  }
  .photo-actions.is-visible {
    opacity: 1;
    transform: translate3d(-50%, 0, 0);
    pointer-events: auto;
  }

  /* Play Video CTA */
  .photo-play-btn {
    background-color: var(--ink, #ffffff) !important;
    color: #080808 !important;
    border: 1px solid var(--ink, #ffffff) !important;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
    cursor: pointer;
  }
  .photo-play-btn:hover,
  .photo-play-btn:focus-visible {
    background-color: #ffffff !important;
    color: #000000 !important;
    border-color: #ffffff !important;
    box-shadow: 0 0 24px rgba(255, 255, 255, 0.45);
    transform: translateY(-2px);
  }

  /* Watch on Instagram CTA - fixed hover inversion (never black-on-black!) */
  .photo-watch {
    background-color: rgba(10, 10, 10, 0.9) !important;
    color: var(--ink, #f0f0f0) !important;
    border: 1px solid rgba(255, 255, 255, 0.28) !important;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    white-space: nowrap;
    transition:
      opacity 0.28s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.28s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.2s ease,
      background-color 0.2s ease,
      color 0.2s ease;
  }
  .photo-watch:hover,
  .photo-watch:focus-visible {
    background-color: var(--ink, #ffffff) !important;
    color: #080808 !important;
    border-color: var(--ink, #ffffff) !important;
    box-shadow: 0 0 24px rgba(255, 255, 255, 0.35);
    transform: translateY(-2px);
  }

  @media (max-width: 480px) {
    .photo-actions {
      gap: 0.5rem;
    }
    .photo-actions .btn {
      font-size: 0.68rem;
      padding: 0.5rem 0.85rem;
      min-height: 44px;
    }
    /* Both buttons fit a phone: "Play" and "Instagram". */
    .photo-label-long {
      display: none;
    }
  }

  /* Persistent Elevator HUD (Progress indicator + Close button) */
  .photo-hud {
    position: fixed;
    top: calc(1.1rem + env(safe-area-inset-top, 0px));
    left: clamp(1.25rem, 3.5vw, 4rem);
    right: clamp(1.25rem, 3.5vw, 4rem);
    z-index: 120;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    pointer-events: none;
    opacity: 0;
    transform: translateY(-6px);
    transition:
      opacity 0.24s cubic-bezier(0.22, 1, 0.36, 1) 0s,
      transform 0.24s cubic-bezier(0.22, 1, 0.36, 1) 0s;
  }
  .photo-hud[hidden] {
    display: none;
  }
  .photo-hud.is-visible {
    opacity: 1;
    transform: translateY(0);
    transition:
      opacity 0.3s cubic-bezier(0.22, 1, 0.36, 1) 0.09s,
      transform 0.3s cubic-bezier(0.22, 1, 0.36, 1) 0.09s;
  }
  .photo-progress {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min, 44px);
    padding: 0 1rem;
    background: rgba(10, 10, 10, 0.88);
    border: 1px solid rgba(255, 255, 255, 0.22);
    color: var(--ink, #f0f0f0);
    font: 600 0.72rem / 1 var(--font-mono, monospace);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    pointer-events: auto;
  }
  .photo-close {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: var(--tap-min, 44px);
    padding: 0 1.1rem;
    background: rgba(10, 10, 10, 0.9);
    border: 1px solid rgba(255, 255, 255, 0.28);
    color: var(--ink, #f0f0f0);
    font: 600 0.72rem / 1 var(--font-mono, monospace);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    cursor: pointer;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    pointer-events: auto;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }
  .photo-close:hover,
  .photo-close:focus-visible {
    background-color: var(--ink, #ffffff);
    color: #080808;
    border-color: var(--ink, #ffffff);
  }

  /* Play badge overlay on video items: ALWAYS visible at rest so reels are
     distinguishable from photos at a glance in the grid. */
  .photo-tag-video-icon {
    display: inline-block;
    vertical-align: middle;
    margin-right: 0.25rem;
    opacity: 0.9;
  }

  .photo-play-badge {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scale(1);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 1.05rem;
    background: rgba(10, 10, 10, 0.86);
    border: 1px solid rgba(255, 255, 255, 0.36);
    border-radius: 0;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    color: #ffffff;
    font-family: var(--font-display, sans-serif);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
    opacity: 1;
    pointer-events: auto;
    cursor: pointer;
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.65);
    transition:
      opacity 0.28s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.28s cubic-bezier(0.22, 1, 0.36, 1),
      background-color 0.2s ease,
      box-shadow 0.2s ease,
      color 0.2s ease;
    z-index: 6;
  }
  .photo-play-duration {
    font-family: var(--font-mono, monospace);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    opacity: 0.8;
    padding-left: 0.35rem;
    border-left: 1px solid rgba(255, 255, 255, 0.25);
  }
  .photo-play-icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 13px;
    height: 13px;
  }
  .photo-play-icon-wrap svg {
    width: 100%;
    height: 100%;
    fill: currentColor;
  }
  .photo-item:hover .photo-play-badge,
  .photo-item.is-active .photo-play-badge:hover {
    background-color: var(--ink, #ffffff);
    color: #080808;
    border-color: var(--ink, #ffffff);
    box-shadow: 0 0 28px rgba(255, 255, 255, 0.45);
    transform: translate(-50%, -50%) scale(1.05);
  }

  /* ── In-place player: laid over the zoomed tile (moved to <body> by the
     script so no transformed ancestor can trap it) ── */
  :global(.photo-player) {
    position: fixed;
    z-index: 58;
    background: #000;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.85);
    opacity: 0;
    transition: opacity 0.25s ease;
  }
  :global(.photo-player[hidden]) {
    display: none;
  }
  :global(.photo-player.is-visible) {
    opacity: 1;
  }
  :global(.photo-player-media),
  :global(.photo-player-media video),
  :global(.photo-player-media iframe) {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    background: #000;
  }
  :global(.photo-player-media video) {
    object-fit: contain;
  }
  /* The HQ modal close (BE Unconventional HQ .modal-close / .close-btn): a
     bare white x floating above the player's top right corner, rotating a
     quarter turn on hover. White on hover too: this site has no HQ red.
     placePlayer() keeps room above the player so the nav never covers it. */
  :global(.photo-player-close) {
    position: absolute;
    top: -46px;
    right: -4px;
    z-index: 2;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    appearance: none;
    background: transparent;
    border: none;
    border-radius: 0;
    box-shadow: none;
    color: #ffffff;
    font-size: 2.5rem;
    line-height: 1;
    cursor: pointer;
    transition: transform 0.3s cubic-bezier(0.25, 1, 0.5, 1), opacity 0.2s ease;
    -webkit-tap-highlight-color: transparent;
    user-select: none;
    touch-action: manipulation;
  }
  :global(.photo-player[data-close='right'] .photo-player-close) {
    top: -4px;
    right: -50px;
  }
  :global(.photo-player[data-close='left'] .photo-player-close) {
    top: -4px;
    right: auto;
    left: -50px;
  }
  :global(.photo-player-close:hover) {
    transform: rotate(90deg);
  }
  :global(.photo-player-close:focus) {
    outline: none;
  }
  :global(.photo-player-close:focus-visible) {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }
  :global(.photo-play-btn[hidden]) {
    display: none;
  }

  .photo-zoom-backdrop {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    background: var(--bg, #0a0a0a);
    z-index: 45;
    opacity: 0;
    pointer-events: none;
    /* Out of the page entirely while unused, not just transparent: a
       full-screen fixed layer over the top of the screen is one more thing
       iOS Safari weighs when it colours the status bar from fixed elements
       at the top (see @andrew/ui Nav.astro). HQ has none. */
    visibility: hidden;
    transition:
      opacity 0.48s cubic-bezier(0.22, 1, 0.36, 1) 0.08s,
      visibility 0s linear 0.56s;
  }
  .photo-stage-wrap.is-zoomed .photo-zoom-backdrop,
  .photo-section.is-zoomed .photo-zoom-backdrop {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition: opacity 0.42s cubic-bezier(0.22, 1, 0.36, 1), visibility 0s linear 0s;
  }

  .camera-stage {
    transform-origin: 0 0;
    transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
    will-change: transform;
    width: 100%;
    position: relative;
  }

  .camera-stage.is-zoomed {
    z-index: 50;
  }

  .camera-stage.is-zoomed .photo-column {
    overflow: visible;
  }

  .camera-stage.is-zoomed .photo-item {
    cursor: pointer;
    transition: opacity 0.35s ease, border-color 0.3s ease, box-shadow 0.35s ease;
  }
  .camera-stage.is-zoomed:not(.is-closing) .photo-item:not(.is-active) {
    opacity: 0.42;
  }
  .camera-stage.is-zoomed:not(.is-closing) .photo-item.is-active {
    opacity: 1;
    border-color: rgba(255, 255, 255, 0.72);
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.85);
    z-index: 2;
  }

  .camera-stage.is-zoomed .photo-item img {
    transform: none !important;
  }

  .photo-item[data-camera-zoom] {
    cursor: pointer;
  }
  @media (max-width: 900px) {
    .photo-wall {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }
    .photo-set {
      gap: 12px;
      padding-bottom: 12px;
    }
  }

  /* A phone on its side (landscape, at most 500px tall). The wall was a
     fixed 480 to 540px, taller than the whole screen (375 to 430px), and
     the 900px two-column grid either showed two reels whose every photo was
     taller than the screen or wrapped four reels into a 2x2 grid of
     half-height rows. Here: all four reels side by side, each photo a
     quarter of the width, and the wall sized to what the header leaves.
     Portrait phones, tablets, desktop and 4K are untouched. */
  @media (orientation: landscape) and (max-height: 500px) {
    .photo-grid-container {
      margin-top: 0.75rem;
    }
    .photo-wall {
      grid-template-columns: repeat(4, 1fr);
      gap: 10px;
      padding-top: 0;
    }
    .photo-column:nth-child(2),
    .photo-column:nth-child(4) {
      display: block;
    }
    .photo-set {
      gap: 10px;
      padding-bottom: 10px;
    }
  }
  /* The height only while the reels move: with reduced motion the wall is
     static and shows every photo at its own height (rule above). */
  @media (orientation: landscape) and (max-height: 500px) and (prefers-reduced-motion: no-preference) {
    .photo-wall {
      height: calc(100vh - var(--nav-bar-h, 76px) - 1.5rem);
      height: calc(100svh - var(--nav-bar-h, 76px) - 1.5rem);
      min-height: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .camera-stage,
    .photo-stage-wrap,
    .photo-actions,
    .photo-watch,
    .photo-play-badge,
    .photo-intro,
    .photo-note {
      transition-duration: 0.01ms !important;
      transition-delay: 0ms !important;
    }
  }
</style>

<script>
  // Manual reel control: AUTO MOVEMENT + USER CONTROL + CAMERA ZOOM
  (() => {
    const wall = document.querySelector<HTMLElement>('.photo-wall');
    const stage = document.getElementById('camera-stage');
    const stageWrap = document.querySelector<HTMLElement>('.photo-stage-wrap');
    const photoSection = document.querySelector<HTMLElement>('.photo-section');
    if (!wall || !stage || !stageWrap || !('requestAnimationFrame' in window)) return;
    wall.classList.add('js-reels');

    const reduced = () =>
      window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const IDLE_RESUME_MS = 2500;
    const DRAG_THRESHOLD_PX = 8;
    const WHEEL_NUDGE = 1.2;
    const totalItems = Math.max(1, parseInt(wall.dataset.photoTotal || '1', 10));

    let zoomPaused = false;
    let isZoomed = false;
    let isClosing = false;
    let expectPop = false;
    let activeTarget: HTMLElement | null = null;
    let frozenReel: Reel | null = null;
    let savedScrollY = 0;
    let openVpW = 0;
    let openVpH = 0;
    let prevScrollRestoration: ScrollRestoration = 'auto';
    let hudTimer = 0;
    let lastWheelStepAt = 0;
    let wheelDeltaAccum = 0;

    interface Reel {
      column: HTMLElement;
      track: HTMLElement;
      anim: Animation | null;
      direction: 1 | -1; // +1 content moves down, -1 content moves up
      baseDuration: number; // seconds per full loop (from CSS var)
      setH: number;
      dragging: boolean;
      hoverPaused: boolean;
      idleTimer: number;
      visible: boolean;
      updatePlayState?: () => void;
    }

    const reels: Reel[] = [];
    const columns = Array.from(wall.querySelectorAll<HTMLElement>('.photo-column'));

    const isColumnDisplayed = (col: HTMLElement) =>
      getComputedStyle(col).display !== 'none';

    const measure = (reel: Reel) => {
      const h = reel.track.scrollHeight / 2;
      if (h > 0) reel.setH = h;
    };

    const pauseReels = () => {
      zoomPaused = true;
      reels.forEach((r) => r.updatePlayState?.());
    };

    const resumeReels = () => {
      zoomPaused = false;
      reels.forEach((r) => r.updatePlayState?.());
    };

    columns.forEach((column) => {
      const track = column.querySelector<HTMLElement>('.photo-track');
      if (!track) return;
      const duration =
        parseFloat(
          getComputedStyle(column).getPropertyValue('--reel-duration')
        ) || 70;
      const reel: Reel = {
        column,
        track,
        anim: null,
        direction: column.dataset.direction === 'down' ? 1 : -1,
        baseDuration: duration,
        setH: 1,
        dragging: false,
        hoverPaused: false,
        idleTimer: 0,
        visible: true,
      };
      reels.push(reel);

      const createAnim = () => {
        if (reduced()) return;
        const keyframes =
          reel.direction === 1
            ? [{ transform: 'translateY(-50%)' }, { transform: 'translateY(0)' }]
            : [{ transform: 'translateY(0)' }, { transform: 'translateY(-50%)' }];
        reel.anim = track.animate(keyframes, {
          duration: reel.baseDuration * 1000,
          iterations: Infinity,
          easing: 'linear',
        });
      };

      const updatePlayState = () => {
        if (!reel.anim) return;
        if (reel === frozenReel || !isColumnDisplayed(column)) {
          if (reel.anim.playState === 'running') reel.anim.pause();
          return;
        }
        const shouldPlay =
          !zoomPaused && !reel.dragging && !reel.hoverPaused && reel.visible && reel.idleTimer === 0;
        if (shouldPlay && reel.anim.playState === 'paused') reel.anim.play();
        else if (!shouldPlay && reel.anim.playState === 'running') reel.anim.pause();
      };
      reel.updatePlayState = updatePlayState;

      const pauseIdle = () => {
        window.clearTimeout(reel.idleTimer);
        reel.idleTimer = window.setTimeout(() => {
          reel.idleTimer = 0;
          updatePlayState();
        }, IDLE_RESUME_MS);
        updatePlayState();
      };

      column.addEventListener('mouseenter', () => {
        if (isZoomed || isClosing) return;
        reel.hoverPaused = true;
        updatePlayState();
      });
      column.addEventListener('mouseleave', () => {
        reel.hoverPaused = false;
        updatePlayState();
      });

      let startY = 0;
      let startTime = 0;
      let moved = 0;
      let isPointerActive = false;

      column.addEventListener('pointerdown', (e) => {
        if (isZoomed || isClosing) return;
        if (e.isPrimary === false) return;
        /* Touch scrolling scrolls the page naturally; mouse/pen drags scrub the reel. */
        if (e.pointerType === 'touch') return;
        if (e.pointerType === 'mouse' && e.button !== 0) return;
        startY = e.clientY;
        startTime = typeof reel.anim?.currentTime === 'number' ? reel.anim.currentTime : 0;
        moved = 0;
        isPointerActive = true;
      });

      column.addEventListener('pointermove', (e) => {
        if (!isPointerActive || isZoomed || isClosing || e.isPrimary === false) return;
        const dy = e.clientY - startY;
        moved = Math.max(moved, Math.abs(dy));
        if (moved > DRAG_THRESHOLD_PX) {
          reel.dragging = true;
          wall.classList.add('is-dragging');
          window.clearTimeout(reel.idleTimer);
          reel.idleTimer = 0;
          updatePlayState();

          if (reel.anim && typeof startTime === 'number') {
            const dt = (dy / reel.setH) * reel.baseDuration * 1000;
            reel.anim.currentTime = startTime + (reel.direction === 1 ? dt : -dt);
          }
        }
      });

      const endDrag = () => {
        if (!isPointerActive) return;
        isPointerActive = false;
        if (reel.dragging) {
          reel.dragging = false;
          wall.classList.remove('is-dragging');
          pauseIdle();
        }
      };
      column.addEventListener('pointerup', endDrag);
      column.addEventListener('pointercancel', endDrag);

      column.addEventListener(
        'click',
        (e) => {
          if (reel.dragging || moved > DRAG_THRESHOLD_PX) {
            e.preventDefault();
            e.stopPropagation();
          }
        },
        true
      );

      column.addEventListener('dragstart', (e) => e.preventDefault());

      column.addEventListener(
        'wheel',
        (e) => {
          if (isZoomed || isClosing || reel.dragging || !reel.anim) return;
          const dy = (e.deltaY || 0) * WHEEL_NUDGE;
          const dt = (dy / reel.setH) * reel.baseDuration * 1000;
          const cur = reel.anim.currentTime ?? 0;
          reel.anim.currentTime = (cur as number) + (reel.direction === 1 ? dt : -dt);
          pauseIdle();
        },
        { passive: true }
      );
      createAnim();
    });

    if (!reels.length) return;

    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((en) => {
            const reel = reels.find((r) => r.column === en.target);
            if (reel) {
              reel.visible = en.isIntersecting;
              reel.updatePlayState?.();
            }
          });
        },
        { threshold: 0 }
      );
      reels.forEach((r) => io.observe(r.column));
    }

    reels.forEach(measure);

    /* Load every photo once the section is near: lazy images inside the
       clipped, moving reels were left as empty dark tiles. */
    const section = photoSection;
    if (section && 'IntersectionObserver' in window) {
      const near = new IntersectionObserver((entries) => {
        if (!entries.some((en) => en.isIntersecting)) return;
        section.querySelectorAll<HTMLImageElement>('.photo-item img').forEach((img) => { img.loading = 'eager'; });
        near.disconnect();
      }, { rootMargin: '800px 0px' });
      near.observe(section);
    }

    /* ---- Camera: translate(X, Y) scale(s) about the stage's top-left ----
       Every move (open, pan to a neighbour, rotate, close) is computed from
       the photos' untransformed geometry, so it is exact even mid-transition. */
    let s = 1;
    let X = 0;
    let Y = 0;
    let closeTimer = 0;
    let watchTimer = 0;
    const EASE = 'cubic-bezier(0.25, 1, 0.5, 1)';

    const navBottom = () => {
      const nav = document.querySelector('.site-nav');
      return nav ? Math.max(0, nav.getBoundingClientRect().bottom) : 0;
    };

    const layoutTop = (el: HTMLElement): number => {
      let y = 0;
      for (let n: HTMLElement | null = el; n; n = n.offsetParent as HTMLElement | null) {
        y += n.offsetTop;
      }
      return y;
    };

    const instantScrollTo = (y: number) => {
      const root = document.documentElement;
      const prev = root.style.scrollBehavior;
      root.style.scrollBehavior = 'auto';
      void root.offsetHeight;
      window.scrollTo(0, Math.max(0, Math.round(y)));
      root.style.scrollBehavior = prev;
    };

    function apply(ms: number) {
      stage.style.transition = ms ? `transform ${ms}ms ${EASE}` : 'none';
      stage.style.transform = `translate3d(${X}px, ${Y}px, 0) scale(${s})`;
    }

    /* Smoothly expand .photo-stage-wrap's clip-path to the active viewport on
       zoom, and contract it back to inset(0px 0px 0px 0px) on exit so the
       overflowing reel tracks never guillotine-snap over the header or footer. */
    function updateStageClip(expanded: boolean, ms: number) {
      stageWrap.style.transition = ms ? `clip-path ${ms}ms ${EASE}` : 'none';
      if (!expanded) {
        stageWrap.style.clipPath = 'inset(0px 0px 0px 0px)';
        return;
      }
      const wr = stageWrap.getBoundingClientRect();
      const top = navBottom();
      const vw = document.documentElement.clientWidth;
      const vh = window.innerHeight;
      const topInset = Math.min(0, Math.floor(top - wr.top));
      const rightInset = Math.min(0, Math.floor(wr.right - vw));
      const bottomInset = Math.min(0, Math.floor(wr.bottom - vh));
      const leftInset = Math.min(0, Math.floor(-wr.left));
      stageWrap.style.clipPath = `inset(${topInset}px ${rightInset}px ${bottomInset}px ${leftInset}px)`;
    }

    /* Just far enough in to show the WHOLE photo: it may take at most 72%
       of the width and 82% of the height under the header (with room for the
       Instagram CTA when present), so the neighbouring reels and the photos
       above and below stay in view. */
    function focusOn(target: HTMLElement, ms: number) {
      const wr = stageWrap.getBoundingClientRect();
      const sr = stage.getBoundingClientRect();
      const tr = target.getBoundingClientRect();
      const curS = (stage.offsetWidth > 0 ? sr.width / stage.offsetWidth : s) || 1;
      const ux = (tr.left - sr.left) / curS;
      const uy = (tr.top - sr.top) / curS;
      const uw = target.offsetWidth || tr.width / curS || 1;
      const uh = target.offsetHeight || tr.height / curS || 1;
      const top = navBottom();
      const vw = document.documentElement.clientWidth;
      const vh = window.innerHeight;
      const hasWatch = Boolean(target.dataset.videoUrl);
      const bottomPad = hasWatch ? 68 : 0;
      const availH = Math.max(180, vh - top - bottomPad);
      const next = Math.min(3, Math.max(1.1, Math.min((vw * 0.72) / uw, (availH * 0.82) / uh)));
      const originX = wr.left;
      const originY = wr.top;
      s = next;
      let nextX = vw / 2 - originX - s * (ux + uw / 2);
      if (vw >= 768) {
        const stageW = stage.offsetWidth || wr.width || 1;
        const scaledWallW = s * stageW;
        const sideMargin = Math.min(96, Math.round(vw * 0.045));
        const maxWallLeft = Math.max(sideMargin, Math.round((vw - scaledWallW) / 2));
        const minWallRight = Math.min(vw - sideMargin, Math.round((vw + scaledWallW) / 2));
        if (originX + nextX > maxWallLeft) {
          nextX = maxWallLeft - originX;
        }
        if (originX + nextX + scaledWallW < minWallRight) {
          nextX = minWallRight - scaledWallW - originX;
        }
        if (originX + nextX + s * ux < 24) {
          nextX = 24 - originX - s * ux;
        }
        if (originX + nextX + s * (ux + uw) > vw - 24) {
          nextX = vw - 24 - originX - s * (ux + uw);
        }
      }
      X = nextX;
      Y = top + availH / 2 - originY - s * (uy + uh / 2);
      apply(ms);
      updateStageClip(true, ms);
    }

    // Persistent HUD: Item X of Y progress indicator + Close button
    const hud = document.querySelector<HTMLElement>('[data-photo-hud]');
    const progressEl = document.querySelector<HTMLElement>('[data-photo-progress]');
    const closeBtnEl = document.querySelector<HTMLButtonElement>('[data-photo-close]');

    function setHud(target: HTMLElement | null) {
      if (!hud) return;
      window.clearTimeout(hudTimer);
      if (target) {
        const idx = parseInt(target.dataset.photoIndex || '0', 10);
        if (progressEl) {
          progressEl.textContent = `Item ${idx + 1} of ${totalItems}`;
        }
        hud.hidden = false;
        void hud.offsetHeight;
        requestAnimationFrame(() => {
          hud.classList.add('is-visible');
        });
      } else {
        hud.classList.remove('is-visible');
        if (reduced()) {
          hud.hidden = true;
        } else {
          hudTimer = window.setTimeout(() => {
            if (!hud.classList.contains('is-visible')) hud.hidden = true;
          }, 290);
        }
      }
    }

    closeBtnEl?.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      resetZoom();
    });

    // In-place player (see the markup note). It lives on <body> so no
    // transformed or clipped ancestor can trap or cut it.
    const player = document.querySelector<HTMLElement>('[data-photo-player]');
    const playerMedia = player?.querySelector<HTMLElement>('[data-photo-player-media]') ?? null;
    if (player && player.parentElement !== document.body) document.body.appendChild(player);
    let isReelOpen = false;
    let playingTarget: HTMLElement | null = null;
    let placeTimer = 0;

    /* Exactly over the zoomed tile, scaled down to fit between the nav
       (plus room for the close button) and the dock. */
    function placePlayer() {
      if (!player || !playingTarget || player.hidden) return;
      const r = playingTarget.getBoundingClientRect();
      const vw = document.documentElement.clientWidth;
      const vh = window.innerHeight;
      // The close button floats 46px above the player, clear of the nav.
      // A short screen (phone landscape) has no height to spare for it, so
      // there it sits beside the player's top corner instead.
      const side = vh < 600;
      const top = navBottom() + (side ? 0 : 48);
      const dock = 84;
      let w = r.width;
      let h = r.height;
      const maxH = Math.max(200, vh - top - dock - 12);
      if (h > maxH) {
        w *= maxH / h;
        h = maxH;
      }
      w = Math.min(w, vw - 24);
      const cx = r.left + r.width / 2;
      const cy = r.top + r.height / 2;
      const left = Math.min(Math.max(12, cx - w / 2), vw - 12 - w);
      const topPx = Math.min(Math.max(top + 6, cy - h / 2), vh - dock - h);
      player.dataset.close = !side ? 'above' : left + w + 50 <= vw ? 'right' : 'left';
      player.style.left = `${Math.round(left)}px`;
      player.style.top = `${Math.round(topPx)}px`;
      player.style.width = `${Math.round(w)}px`;
      player.style.height = `${Math.round(h)}px`;
    }

    function stopPlayer(restoreFocus = false) {
      if (!player || !isReelOpen) return;
      isReelOpen = false;
      playingTarget = null;
      window.clearTimeout(placeTimer);
      const v = playerMedia?.querySelector('video');
      if (v) {
        v.pause();
        v.removeAttribute('src');
        v.load();
      }
      const f = playerMedia?.querySelector('iframe');
      if (f) f.src = 'about:blank';
      if (playerMedia) playerMedia.textContent = '';
      player.classList.remove('is-visible');
      player.hidden = true;
      delete player.dataset.kind;
      if (restoreFocus) document.querySelector<HTMLButtonElement>('[data-photo-play]')?.focus({ preventScroll: true });
    }

    function playInPlace(target: HTMLElement) {
      if (!player || !playerMedia || !isZoomed) return;
      // Only a self-hosted file plays in place. The reels without one are
      // the ones Instagram withholds (licensed audio), and its embed shows
      // "the link may be broken" for them, so those go to Instagram via the
      // dock's link instead of opening a broken player.
      const src = target.dataset.videoSrc;
      if (!src) return;
      stopPlayer();
      player.dataset.kind = 'file';
      const v = document.createElement('video');
      v.src = src;
      v.controls = true;
      v.playsInline = true;
      v.setAttribute('playsinline', '');
      v.preload = 'auto';
      const poster = target.querySelector('img')?.currentSrc;
      if (poster) v.poster = poster;
      playerMedia.appendChild(v);
      // Started inside the reader's own click, so it may play with sound.
      // If a browser still refuses, the controls are there: one more tap.
      v.play()?.catch(() => {});
      playingTarget = target;
      isReelOpen = true;
      player.hidden = false;
      placePlayer();
      requestAnimationFrame(() => player.classList.add('is-visible'));
      // Re-place once the camera has finished moving onto the tile.
      window.clearTimeout(placeTimer);
      placeTimer = window.setTimeout(placePlayer, 650);
      player.querySelector<HTMLButtonElement>('[data-photo-player-close]')?.focus({ preventScroll: true });
    }

    player?.querySelector('[data-photo-player-close]')?.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      stopPlayer(true);
    });

    // The play path of a zoomed reel; nothing for a photo.
    const actions = document.querySelector<HTMLElement>('[data-photo-actions]');
    const watch = document.querySelector<HTMLAnchorElement>('[data-photo-watch]');
    const playBtn = document.querySelector<HTMLButtonElement>('[data-photo-play]');
    let currentVideoUrl: string | null = null;

    function setWatch(target: HTMLElement | null) {
      if (!actions) return;
      window.clearTimeout(watchTimer);
      const url = target?.dataset.videoUrl;
      currentVideoUrl = url || null;
      if (url) {
        if (watch) watch.href = url;
        if (playBtn) playBtn.hidden = !target?.dataset.videoSrc;
        actions.hidden = false;
        void actions.offsetHeight;
        requestAnimationFrame(() => {
          actions.classList.add('is-visible');
        });
      } else {
        actions.classList.remove('is-visible');
        if (reduced()) {
          actions.hidden = true;
        } else {
          watchTimer = window.setTimeout(() => {
            if (!actions.classList.contains('is-visible')) actions.hidden = true;
          }, 290);
        }
      }
    }

    playBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      if (activeTarget?.dataset.videoSrc) playInPlace(activeTarget);
    });

    function setFrozen(target: HTMLElement | null) {
      const column = target?.closest<HTMLElement>('.photo-column') ?? null;
      const next = reels.find((r) => r.column === column) ?? null;
      const prev = frozenReel;
      frozenReel = next;
      if (prev && prev !== next) prev.updatePlayState?.();
      if (next?.anim && next.anim.playState === 'running') next.anim.pause();
    }

    /* If a rotation to mobile portrait hides the column of the currently
       zoomed item (columns 2 and 4 are display:none <=767px), pick the
       visible item closest to the vertical center of the wall. */
    function ensureVisibleTarget(target: HTMLElement): HTMLElement {
      const col = target.closest<HTMLElement>('.photo-column');
      if (col && isColumnDisplayed(col)) return target;
      const wr = stageWrap.getBoundingClientRect();
      const centerY = wr.top + wr.height / 2;
      let best: HTMLElement = target;
      let bestDist = Infinity;
      reels.forEach((r) => {
        if (!isColumnDisplayed(r.column)) return;
        r.column.querySelectorAll<HTMLElement>('.photo-item').forEach((item) => {
          const ir = item.getBoundingClientRect();
          if (ir.height <= 0) return;
          const dist = Math.abs(ir.top + ir.height / 2 - centerY);
          if (dist < bestDist) {
            bestDist = dist;
            best = item;
          }
        });
      });
      if (best !== target) {
        target.classList.remove('is-active');
        best.classList.add('is-active');
        setFrozen(best);
        setWatch(best);
        setHud(best);
      }
      return best;
    }

    /* Re-anchor scroll position and camera matrix when the viewport rotates
       or resizes while zoomed so the stage stays centered and closes cleanly
       into the new layout's wall position. */
    function handleViewportChange() {
      reels.forEach((r) => {
        measure(r);
        r.updatePlayState?.();
      });
      if (!isZoomed || isClosing || !activeTarget) return;

      const vw = document.documentElement.clientWidth;
      const vh = window.innerHeight;
      const sizeChanged = Math.abs(vw - openVpW) > 2 || Math.abs(vh - openVpH) > 2;
      const orientationOrWidthChanged = Math.abs(vw - openVpW) > 24 || Math.abs(vh - openVpH) > 120;

      if (orientationOrWidthChanged) {
        openVpW = vw;
        openVpH = vh;
        const top = navBottom();
        const wrapTop = layoutTop(stageWrap);
        const wrapH = stageWrap.offsetHeight;
        const targetScreenTop = top + Math.max(0, (vh - top - wrapH) / 2);
        savedScrollY = Math.max(0, Math.round(wrapTop - targetScreenTop));
        instantScrollTo(savedScrollY);
      } else if (Math.abs(window.scrollY - savedScrollY) > 2) {
        instantScrollTo(savedScrollY);
      }

      if (sizeChanged) {
        activeTarget = ensureVisibleTarget(activeTarget);
        focusOn(activeTarget, 0);
      }
    }

    let resizeRaf = 0;
    let settleTimer1 = 0;
    let settleTimer2 = 0;
    const onResizeOrRotate = () => {
      cancelAnimationFrame(resizeRaf);
      window.clearTimeout(settleTimer1);
      window.clearTimeout(settleTimer2);
      resizeRaf = requestAnimationFrame(() => {
        handleViewportChange();
        window.clearTimeout(placeTimer);
        placeTimer = window.setTimeout(placePlayer, 320);
        settleTimer1 = window.setTimeout(handleViewportChange, 120);
        settleTimer2 = window.setTimeout(handleViewportChange, 280);
      });
    };

    window.addEventListener('resize', onResizeOrRotate, { passive: true });
    window.addEventListener('orientationchange', onResizeOrRotate, { passive: true });
    window.visualViewport?.addEventListener('resize', onResizeOrRotate, { passive: true });

    // Delegated click listener on wall so every item click (original or loop) is handled reliably
    wall.addEventListener('click', (e) => {
      const item = (e.target as HTMLElement).closest<HTMLElement>('.photo-item');
      if (!item) return;

      e.preventDefault();
      e.stopPropagation();

      // A video zooms in exactly like a photo; it never plays from the
      // wall. Zoomed onto it, a second tap plays it in place.
      const isVideo = Boolean(item.dataset.videoUrl || item.dataset.videoSrc);

      if (isZoomed) {
        if (item === activeTarget) {
          if (isVideo) {
            if (!isReelOpen) playInPlace(item);
            return;
          }
          resetZoom();
        } else {
          panToElement(item);
        }
      } else {
        zoomToElement(item);
      }
    });

    function zoomToElement(target: HTMLElement) {
      if (isZoomed) {
        if (target === activeTarget) resetZoom();
        else panToElement(target);
        return;
      }
      window.clearTimeout(closeTimer);
      isClosing = false;
      stageWrap.classList.remove('is-closing');

      // Clear any hover-paused state on other columns so neighbours keep moving smoothly
      reels.forEach((r) => {
        r.hoverPaused = false;
      });
      // Freeze ONLY the selected photo's reel; the neighbours keep moving.
      setFrozen(target);

      savedScrollY = window.scrollY;
      openVpW = document.documentElement.clientWidth;
      openVpH = window.innerHeight;
      prevScrollRestoration = 'scrollRestoration' in history ? history.scrollRestoration : 'auto';
      if ('scrollRestoration' in history) {
        history.scrollRestoration = 'manual';
      }

      // Lock scrolling without the page reflowing under the camera.
      // Because html has scrollbar-gutter: stable, only pad body if clientWidth actually changes.
      const clientWBefore = document.documentElement.clientWidth;
      document.body.style.overflow = 'hidden';
      const gutter = Math.max(0, document.documentElement.clientWidth - clientWBefore);
      if (gutter > 0) document.body.style.paddingRight = `${gutter}px`;
      document.documentElement.classList.remove('photo-zoom-closing');
      document.documentElement.classList.add('photo-zoom-open');

      if (!history.state?.photoZoom) {
        history.pushState({ ...(history.state ?? {}), photoZoom: true }, '');
      }

      isZoomed = true;
      activeTarget = target;
      target.classList.add('is-active');
      stage.classList.add('is-zoomed');
      stageWrap.classList.add('is-zoomed');
      photoSection?.classList.add('is-zoomed', 'is-camera');
      setWatch(target);
      setHud(target);
      focusOn(target, reduced() ? 0 : 600);
    }

    function panToElement(newTarget: HTMLElement) {
      if (!isZoomed) {
        zoomToElement(newTarget);
        return;
      }
      if (newTarget === activeTarget) {
        resetZoom();
        return;
      }
      stopPlayer();
      setFrozen(newTarget);
      activeTarget?.classList.remove('is-active');
      activeTarget = newTarget;
      newTarget.classList.add('is-active');
      setWatch(newTarget);
      setHud(newTarget);
      focusOn(newTarget, reduced() ? 0 : 520);
    }

    function stepItem(dir: 1 | -1) {
      if (!isZoomed || isClosing || !activeTarget) return;
      const visibleItems = Array.from(wall.querySelectorAll<HTMLElement>('.photo-item')).filter(
        (el) => {
          const col = el.closest<HTMLElement>('.photo-column');
          return col ? isColumnDisplayed(col) : false;
        }
      );
      if (!visibleItems.length) return;
      const indices = Array.from(
        new Set(
          visibleItems
            .map((el) => parseInt(el.dataset.photoIndex || '-1', 10))
            .filter((n) => n >= 0)
        )
      ).sort((a, b) => a - b);
      if (indices.length <= 1) return;
      const curIdx = parseInt(activeTarget.dataset.photoIndex || '0', 10);
      const pos = Math.max(0, indices.indexOf(curIdx));
      const nextIdx = indices[(pos + dir + indices.length) % indices.length];
      const candidates = visibleItems.filter(
        (el) => parseInt(el.dataset.photoIndex || '-1', 10) === nextIdx
      );
      if (!candidates.length) return;
      const centerY = window.innerHeight / 2;
      let best = candidates[0];
      let bestDist = Infinity;
      candidates.forEach((cand) => {
        const r = cand.getBoundingClientRect();
        const d = Math.abs(r.top + r.height / 2 - centerY);
        if (d < bestDist) {
          bestDist = d;
          best = cand;
        }
      });
      panToElement(best);
    }

    /* Back out from the same photo: the reel stays frozen while clip-path
       contracts smoothly back to the resting wall box in lockstep with the
       camera transform, so nothing pops or re-crops when the return lands. */
    function resetZoom(fromHistory = false) {
      if (!isZoomed || isClosing) return;
      stopPlayer();
      isZoomed = false;
      isClosing = true;
      document.documentElement.classList.add('photo-zoom-closing');

      if (!fromHistory && history.state?.photoZoom) {
        expectPop = true;
        document.documentElement.dataset.viewPop = '1';
        window.setTimeout(() => delete document.documentElement.dataset.viewPop, 80);
        history.back();
      }

      if (Math.abs(window.scrollY - savedScrollY) > 2) {
        instantScrollTo(savedScrollY);
      }

      if (stage.style.transition === 'none') {
        void stage.offsetHeight;
      }

      s = 1;
      X = 0;
      Y = 0;
      const ms = reduced() ? 0 : 600;
      stageWrap.classList.add('is-closing');
      photoSection?.classList.remove('is-zoomed');
      apply(ms);
      updateStageClip(false, ms);
      setWatch(null);
      setHud(null);
      if (activeTarget) {
        activeTarget.classList.remove('is-active');
        activeTarget = null;
      }
      const finish = () => {
        window.clearTimeout(closeTimer);
        if (isZoomed) return; // reopened meanwhile
        isClosing = false;
        stage.style.transition = '';
        stage.style.transform = '';
        stageWrap.style.transition = '';
        stageWrap.style.clipPath = '';
        stage.classList.remove('is-zoomed');
        stageWrap.classList.remove('is-zoomed', 'is-closing');
        photoSection?.classList.remove('is-camera');
        document.body.style.overflow = '';
        document.body.style.paddingRight = '';
        document.documentElement.classList.remove('photo-zoom-open', 'photo-zoom-closing');
        if ('scrollRestoration' in history) {
          history.scrollRestoration = prevScrollRestoration;
        }
        setFrozen(null);
        reels.forEach((r) => {
          r.hoverPaused = r.column.matches(':hover');
          r.updatePlayState?.();
        });
      };
      if (ms === 0) finish();
      else closeTimer = window.setTimeout(finish, ms + 20);
    }

    /* Prevent iOS Safari and desktop wheel from panning the document behind the zoomed stage,
       and advance item-by-item on wheel when zoomed so stepping never costs pages of scroll. */
    const preventBgTouch = (e: Event) => {
      // The player's own controls (scrubbing, volume) need their touches.
      if (player && e.target instanceof Node && player.contains(e.target)) return;
      if (isZoomed || isClosing) e.preventDefault();
    };
    const handleZoomWheel = (e: WheelEvent) => {
      if (!isZoomed && !isClosing) return;
      e.preventDefault();
      if (!isZoomed || isClosing || isReelOpen) return;
      const dy = e.deltaY || 0;
      if (Math.abs(dy) < 2) return;
      const now = performance.now();
      if (now - lastWheelStepAt < 220) return;
      wheelDeltaAccum += dy;
      if (Math.abs(wheelDeltaAccum) >= 16) {
        const dir: 1 | -1 = wheelDeltaAccum > 0 ? 1 : -1;
        wheelDeltaAccum = 0;
        lastWheelStepAt = now;
        stepItem(dir);
      }
    };
    window.addEventListener('touchmove', preventBgTouch, { passive: false });
    window.addEventListener('wheel', handleZoomWheel, { passive: false });

    // Clicking stage background or backdrop when zoomed resets
    stage.addEventListener('click', (e) => {
      if (!isZoomed) return;
      const item = (e.target as HTMLElement).closest('.photo-item');
      if (item) return; // Handled by item/wall listener
      e.preventDefault();
      e.stopPropagation();
      resetZoom();
    });

    const backdrop = document.querySelector('.photo-zoom-backdrop');
    if (backdrop) {
      backdrop.addEventListener('click', (e) => {
        if (isZoomed) {
          e.preventDefault();
          resetZoom();
        }
      });
    }

    // Clicking stage wrapper outside photo items when zoomed resets
    stageWrap.addEventListener('click', (e) => {
      if (!isZoomed) return;
      if ((e.target as HTMLElement).closest('.photo-item')) return;
      resetZoom();
    });

    // ESC key resets; Arrow keys step between items when zoomed
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        if (isReelOpen) {
          e.preventDefault();
          stopPlayer(true);
          return;
        }
        if (isZoomed) {
          e.preventDefault();
          resetZoom();
        }
        return;
      }
      if (isZoomed && !isClosing && !isReelOpen) {
        if (e.key === 'ArrowDown' || e.key === 'ArrowRight') {
          e.preventDefault();
          stepItem(1);
        } else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') {
          e.preventDefault();
          stepItem(-1);
        }
      }
    });

    // Browser navigation resets without letting BaseLayout scroll the page
    window.addEventListener(
      'popstate',
      () => {
        if (!isZoomed && !expectPop) return;
        const wasExpected = expectPop;
        expectPop = false;
        document.documentElement.dataset.viewPop = '1';
        window.setTimeout(() => delete document.documentElement.dataset.viewPop, 80);
        if (isZoomed) {
          resetZoom(true);
        } else if (wasExpected) {
          if (Math.abs(window.scrollY - savedScrollY) > 2) {
            instantScrollTo(savedScrollY);
          }
        }
      },
      { capture: true }
    );
  })();
</script>
