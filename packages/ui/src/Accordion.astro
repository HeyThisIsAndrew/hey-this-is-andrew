---
/**
 * Accordion (@andrew/ui): a group of <AccordionRow>s. Each row toggles on
 * its own; `exclusive` keeps one open at a time (BE Unconventional HQ's
 * /featured), and pressing the open row closes it.
 *
 * A link to a row (or to anything inside one) opens it: on load, on a hash
 * change, and on a same-page link click, which the personal site scrolls
 * with pushState and so fires no hashchange. The click is handled in the
 * capture phase, before that scroll measures where the row is.
 *
 * Rows announce `accordion:toggle` ({ open }) on themselves, so a row's
 * content (an inline video) can load or unload with it.
 *
 * The row you press stays exactly where it is on screen. In an exclusive
 * group, opening a row closes the open one; when that one is above, the row
 * you pressed rises by its height. Rows used to animate their height, both
 * at once, while a requestAnimationFrame loop scrolled the page after the
 * pressed header. The loop always ran a frame behind the animation, so on an
 * iPad the header shook up and down for half a second, and both rows
 * re-laid out their whole contents every frame. Now a row's height changes
 * in one step: the open row closes and the pressed one opens in the same
 * task, the page scrolls by however far the pressed header moved, and only
 * then does the browser paint, so it never shows anything in between.
 * Scroll anchoring is off for that one step (Chrome would correct the same
 * move a second time). The opened row's content then fades and slides in,
 * on the compositor (AccordionRow.astro). If the opened row's header is low
 * on the screen, the page then scrolls it up (smoothly, unless the reader
 * prefers less motion), towards a target that has stopped moving.
 */
interface Props {
  exclusive?: boolean;
}
const { exclusive = false } = Astro.props;
---
<div class="accordion-group" data-accordion-group data-exclusive={exclusive ? '' : undefined}>
  {/* Before the rows are parsed: collapsed is a scripted state, so without
      JavaScript every row reads open, and with it nothing flashes open. */}
  <script is:inline>document.documentElement.classList.add('acc-js');</script>
  <slot />
</div>

<script>
  const OPEN = 'is-expanded';
  const SETTLED = 'is-settled';
  const reduced = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const parts = (row: HTMLElement) => ({
    header: row.querySelector<HTMLButtonElement>(':scope > .accordion-heading > [data-accordion-header]'),
    body: row.querySelector<HTMLElement>(':scope > .accordion-body'),
  });

  function setRow(row: HTMLElement, open: boolean) {
    const { header, body } = parts(row);
    if (row.classList.contains(OPEN) === open && body?.inert === !open) return;
    row.classList.toggle(OPEN, open);
    row.classList.remove(SETTLED);
    header?.setAttribute('aria-expanded', String(open));
    if (body) body.inert = !open;
    row.dispatchEvent(new CustomEvent('accordion:toggle', { bubbles: true, detail: { open } }));
    if (open) {
      // The row is at its full height at once, so it stops clipping at once
      // (see AccordionRow.astro): nothing inside it is cut off while it fades in.
      row.classList.add(SETTLED);
      row.dispatchEvent(new CustomEvent('accordion:settled', { bubbles: true }));
    }
  }

  function rowsOf(group: HTMLElement) {
    return Array.from(group.querySelectorAll<HTMLElement>(':scope > [data-accordion-row]'));
  }

  function openRow(row: HTMLElement) {
    const group = row.closest<HTMLElement>('[data-accordion-group]');
    if (group && group.hasAttribute('data-exclusive')) rowsOf(group).forEach((r) => r !== row && setRow(r, false));
    setRow(row, true);
    // A row inside a closed row: open the way down to it.
    const parent = group?.closest<HTMLElement>('[data-accordion-row]');
    if (parent) openRow(parent);
  }

  /** Run `change` (rows open and close in one step), and before the browser
      paints, scroll the page by however far `el` moved, so it stays exactly
      where it was on screen. Scroll anchoring is off meanwhile, or Chrome
      would make the same correction twice. */
  function keepInPlace(el: HTMLElement, change: () => void) {
    const html = document.documentElement;
    const anchoring = html.style.overflowAnchor;
    html.style.overflowAnchor = 'none';
    const top = el.getBoundingClientRect().top;
    change();
    const moved = el.getBoundingClientRect().top - top;     // the new layout, measured now
    if (Math.abs(moved) > 0.5) window.scrollBy({ top: moved, behavior: 'instant' as ScrollBehavior });
    requestAnimationFrame(() => requestAnimationFrame(() => { html.style.overflowAnchor = anchoring; }));
  }

  /** A row opened with its header low on the screen: bring the header up so
      the row's content shows. Only once the row is open, so the header has
      stopped moving. */
  function revealIfLow(row: HTMLElement, header: HTMLElement) {
    const top = header.getBoundingClientRect().top;
    if (top < window.innerHeight * 0.6) return;
    const margin = parseFloat(getComputedStyle(row).scrollMarginTop) || 0;
    window.scrollTo({ top: window.scrollY + row.getBoundingClientRect().top - margin, behavior: reduced() ? 'auto' : 'smooth' });
  }

  function initGroup(group: HTMLElement) {
    if (group.dataset.ready) return;
    group.dataset.ready = '1';
    rowsOf(group).forEach((row) => {
      const { header, body } = parts(row);
      if (body) body.inert = !row.classList.contains(OPEN);
      header?.addEventListener('click', () => {
        if (!header) return;
        if (row.classList.contains(OPEN)) keepInPlace(header, () => setRow(row, false));
        else {
          keepInPlace(header, () => openRow(row));
          revealIfLow(row, header);
        }
      });
    });
  }

  function rowFor(hash: string) {
    if (!hash || hash === '#') return null;
    let el: HTMLElement | null = null;
    try {
      el = document.getElementById(decodeURIComponent(hash.slice(1)));
    } catch {
      return null;
    }
    return el?.closest<HTMLElement>('[data-accordion-row]') ?? null;
  }

  function openFromHash(hash: string) {
    const row = rowFor(hash);
    if (row && !row.classList.contains(OPEN)) openRow(row);
  }

  function initAccordions() {
    document.querySelectorAll<HTMLElement>('[data-accordion-group]').forEach(initGroup);
    openFromHash(location.hash);
  }

  initAccordions();
  document.addEventListener('astro:page-load', initAccordions);
  if (!(window as unknown as { __accHash?: boolean }).__accHash) {
    (window as unknown as { __accHash?: boolean }).__accHash = true;
    window.addEventListener('hashchange', () => openFromHash(location.hash));
    document.addEventListener(
      'click',
      (e) => {
        const link = (e.target as Element | null)?.closest?.('a[href*="#"]') as HTMLAnchorElement | null;
        if (!link) return;
        const url = new URL(link.href, location.href);
        if (url.pathname.replace(/\/$/, '') !== location.pathname.replace(/\/$/, '')) return;
        openFromHash(url.hash);
      },
      true,
    );
  }
</script>

<style>
  .accordion-group {
    /* Rows never move the page on their own: see keepInPlace. */
    overflow-anchor: none;
    display: flex;
    flex-direction: column;
    gap: 1px;
    background: var(--hairline);
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
  }
</style>
