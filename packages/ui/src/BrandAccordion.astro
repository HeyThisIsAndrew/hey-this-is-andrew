  @media (orientation: landscape) and (max-height: 520px) {
    .bacc-viewport.is-fill .bacc-caption {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        'chips chips'
        '. .'
        'copy logo';
      grid-template-rows: auto minmax(0, 1fr) auto;
    }
    .bacc-caption-logo {
      justify-self: end;
      place-items: end;
    }
    .bacc-caption-logo :global(img) {
      object-position: right bottom;
    }
    .bacc-viewport.is-fill .bacc-caption .bacc-headline {
      font-size: clamp(1.2rem, 3vw, 1.6rem);
      -webkit-line-clamp: 2;
    }
    .bacc-viewport.is-fill .bacc-caption .bacc-deck {
