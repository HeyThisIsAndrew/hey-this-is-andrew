---
/**
 * BrandAccordion (@andrew/ui): a data-driven, themeable brand accordion.
 *
 * Mechanics mirror the hero accordion on beunconventionalhq.com (HQ's
 * src/components/home/HeroAccordion.astro), per the Section 1.3 contract:
 *
 *  - Desktop: a flex row. Collapsed strips are --acc-strip wide and show the
 *    panel's art BLURRED, a vertical label and the logo in a fixed foot box.
 *    The open panel is `flex: 1 1 0%`; panels animate flex-grow/flex-basis.
 *    Hover (fine pointers, 768px+) only PEEKS: 28px wider, art sharpens, the
 *    frame lights up. Hover never opens a panel; a click or the keyboard does.
 *  - Panel 0 is rendered open on the server (`is-open`, aria-expanded="true").
 *  - Rotation: `interval` ms per panel (default 8s) on a requestAnimationFrame clock that only runs
 *    while visible and not held. Held by hover, focus inside and a touch in
 *    progress; the first manual choice stops it; the toggle restarts it. Off
 *    by default below 768px and never with prefers-reduced-motion. The open
 *    panel's progress bar shows the clock.
 *  - Keyboard: arrows move between panels (and open them), Home/End jump,
 *    Escape closes the fullscreen brand view.
 *  - Phones: the same markup stacks (no duplicated markup). The open panel
 *    moves to the top; every panel has a fixed height, so the accordion's
 *    total height never changes.
 *  - Theming: every accent value is a --accordion-* token (@andrew/tokens).
 *    A panel renders data-accent="<accent>"; the site's theme re-points the
 *    tokens for that accent (e.g. the personal site's BE panel in BE red).
 *    Nothing brand-specific is written in this file.
 *  - `fullscreen` adds the "brand view": a camera dolly into the open panel
 *    (the personal site's addition to HQ's mechanics). Desktop only.
 *  - Geometry: the OPEN panel is a true 16:9 box (desktop and the phone's
 *    media frame), sized from the viewport height and capped by the width;
 *    the collapsed strips share what is left. The brand view fits that same
 *    16:9 box on screen whole (contain, never cover) and sets the copy in a
 *    caption band under it, at screen size: the copy is never scaled with
 *    the camera and never sits on the art in the view.
 *  - Copy never reflows while a panel grows or shrinks (it is laid out at
 *    the open width and the panel clips it), and it crossfades with the
 *    panel motion instead of popping in and out.
 */
import { Image } from 'astro:assets';
import type { AccordionPanel, AccordionLabels } from './types';

interface Props {
  panels: AccordionPanel[];
  /** Enables the fullscreen brand view (click the open panel). Desktop only. */
  fullscreen?: boolean;
  /** Auto-rotation interval in ms (HQ uses 7000; the personal site 8000). */
  interval?: number;
  labels?: Partial<AccordionLabels>;
}

const { panels, fullscreen = false, interval = 8000, labels: labelProp = {} } = Astro.props;
const labels: AccordionLabels = {
  play: 'Play auto-rotation',
  pause: 'Pause auto-rotation',
  close: 'Close',
  closeKey: 'Esc',
  closeAria: 'Close brand view (Esc)',
  ...labelProp,
};
const OPEN_SIZES = '(max-width: 767px) calc(100vw - 32px), calc(100vw - 2 * 180px)';
---
<div class="bacc" data-bacc data-avoid-fab data-interval={interval} data-fullscreen={fullscreen ? '' : undefined} style={`--acc-n: ${panels.length}`}>
    <div class="bacc-viewport" data-bacc-viewport>
      <button type="button" class="bacc-close" data-bacc-close hidden aria-label={labels.closeAria}>
        <span class="bacc-close-key" aria-hidden="true">{labels.closeKey}</span>
        <span aria-hidden="true">{labels.close}</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>

      <div class="bacc-stage" data-bacc-stage>
        <div class="bacc-track">
          {panels.map((brand, i) => {
            const open = i === 0;
            const contentId = `bacc-content-${brand.id}`;
            const triggerId = `bacc-trigger-${brand.id}`;
            const hasCta = Boolean(brand.url && brand.cta) && !brand.comingSoon;
            const art = brand.mediaSrc ?? null;
            return (
              <article
                class:list={[
                  'bacc-panel',
                  { 'is-open': open, 'is-teaser': !art, 'is-coming-soon': brand.comingSoon },
                ]}
                id={`brand-${brand.id}`}
                data-accent={brand.accent}
                data-cta-panel-hover={brand.ctaFillOnPanelHover ? '' : undefined}
                data-bacc-panel
                data-brand-id={brand.id}
              >
                <div class="bacc-media" aria-hidden="true">
                  {art ? (
                    <Image
                      src={art}
                      alt=""
                      widths={[640, 960, 1280, 1920]}
                      sizes={OPEN_SIZES}
                      format="webp"
                      loading={open ? 'eager' : 'lazy'}
                      decoding="async"
                    />
                  ) : (
                    /* Teaser card: monochrome "something is brewing" art for a
                       brand with no art yet (never an empty black box). */
                    <div class="bacc-teaser">
                      {brand.teaserSvg && <span class="bacc-teaser-art" set:html={brand.teaserSvg} />}
                    </div>
                  )}
                </div>

                <button
                  type="button"
                  class="bacc-trigger"
                  id={triggerId}
                  aria-expanded={open ? 'true' : 'false'}
                  aria-controls={contentId}
                  data-bacc-trigger
                >
                  <span class="bacc-label">{brand.name}</span>
                  <span class="bacc-logo" aria-hidden="true">
                    {brand.logoSrc ? (
                      <Image src={brand.logoSrc} alt="" widths={[160, 320, 480]} sizes="(max-width: 767px) 96px, 240px" format="webp" loading="lazy" decoding="async" />
                    ) : (
                      <span class="bacc-logo-word">{brand.wordmark}</span>
                    )}
                  </span>
                </button>

                {/* Metadata chip: a sibling of the content block, pinned to the
                    open panel's TOP-LEFT corner (HQ puts tags top-left). */}
                <p class="bacc-chips" aria-hidden="true"><span class="bacc-chip">{brand.kicker}</span></p>

                <div class="bacc-content" id={contentId} role="region" aria-labelledby={triggerId}>
                  <h3 class="bacc-headline">{brand.headline}</h3>
                  <p class="bacc-deck">{brand.deck}</p>
                  {hasCta && (
                    <a class="bacc-cta" href={brand.url} target="_blank" rel="noopener">
                      {brand.cta}
                      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                        <path d="M2 12L12 2H5M12 2v7" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" />
                      </svg>
                    </a>
                  )}
                  {brand.comingSoon && brand.teaserTag && <span class="bacc-teaser-tag">{brand.teaserTag}</span>}
                  {brand.inquiry && (
                    <a class="bacc-inquiry" href={`mailto:${brand.inquiry.email}?subject=${encodeURIComponent(brand.inquiry.subject)}`}>
                      {brand.inquiry.label} <span aria-hidden="true">→</span>
                    </a>
                  )}
                </div>

                <div class="bacc-progress" aria-hidden="true"><span class="bacc-progress-fill"></span></div>
              </article>
            );
          })}
        </div>

        <button type="button" class="bacc-toggle" data-bacc-toggle aria-label={labels.pause} data-label-play={labels.play} data-label-pause={labels.pause} hidden>
          <svg class="bacc-icon-pause" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z" /></svg>
          <svg class="bacc-icon-play" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
        </button>
      </div>
      {fullscreen && <div class="bacc-caption" data-bacc-caption hidden></div>}
    </div>
  <p class="bacc-sr" aria-live="polite" data-bacc-announcer></p>
</div>

<style>
  /* Every colour below is a token (@andrew/tokens) or a neutral black/white
     scrim. Accent tokens (--accordion-*) are read on the panel, so a site
     re-points them per panel with [data-accent="<name>"]. */
  .bacc-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* ─── TRACK ─────────────────────────────────────────────────────────── */
  .bacc {
    position: relative;
    /* The track's 16:9 geometry reads this width (cqw). The root stays in
       the page flow when the brand view fixes the viewport, so the panel
       sizes never change on the way in or out. */
    container-type: inline-size;
  }
  .bacc-viewport {
    position: relative;
    width: 100%;
    overflow: hidden;
    /* The brand view's backdrop fades with the camera, both ways. */
    background-color: transparent;
    transition: background-color 700ms cubic-bezier(0.25, 1, 0.5, 1);
  }
  .bacc-stage {
    position: relative;
    width: 100%;
    transform-origin: 0 0;
  }
  .bacc-track {
    --strip: var(--acc-strip);
    /* The open panel is 16:9: as wide as the viewport height allows (so the
       section heading and the panel fit one screen), capped so the strips
       keep at least their design width. The strips share the rest. */
    --open-w: min(
      calc((100svh - var(--nav-h, 0px) - 10rem) * 16 / 9),
      calc(100cqw - (var(--acc-n) - 1) * (var(--strip) + var(--acc-gap)))
    );
    display: flex;
    gap: var(--acc-gap);
    width: 100%;
    overflow: hidden;
    height: calc(var(--open-w) * 9 / 16);
    background: var(--page-bg);
  }

  .bacc-panel {
    position: relative;
    flex: 1 1 0%;
    min-width: 0;
    overflow: hidden;
    background: #111;
    color: var(--text);
    transition:
      flex-grow var(--acc-duration) var(--acc-ease),
      flex-basis var(--acc-duration) var(--acc-ease);
  }
  .bacc-panel.is-open {
    flex: 0 0 var(--open-w);
  }
  /* The active edge: a pseudo-element, so opening a panel shifts nothing. */
  .bacc-panel::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 5px;
    background: var(--accordion-edge);
    z-index: 5;
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.5s ease 0.2s;
  }
  .bacc-panel.is-open::before {
    transform: scaleY(1);
  }
  /* Hover frame and a glow rising from the strip's foot. */
  .bacc-panel::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 4;
    pointer-events: none;
    opacity: 0;
    box-shadow:
      inset 0 0 0 1px var(--accordion-frame),
      inset 0 -120px 90px -60px var(--accordion-frame-glow);
    transition: opacity 0.35s ease;
  }
  .bacc-panel:not(.is-open):hover::after,
  .bacc-panel:not(.is-open):focus-within::after {
    opacity: 1;
  }

  /* ─── ART ───────────────────────────────────────────────────────────── */
  .bacc-media {
    position: absolute;
    inset: 0;
  }
  .bacc-media > :global(img),
  .bacc-media > .bacc-teaser {
    width: 100%;
    height: 100%;
    object-fit: cover;
    --zoom: 1;
    transform: translateX(var(--img-x, 0)) scale(var(--zoom));
    transition: filter 0.6s ease, transform 1.4s ease;
  }
  /* Collapsed: blurred. Art is framed for the open panel, never for a strip,
     so a sharp sliver is noise; blurred, it is colour and mood. The panel
     clips, so the overscan hides the soft blur edge. */
  .bacc-panel:not(.is-open) .bacc-media > :global(img),
  .bacc-panel:not(.is-open) .bacc-media > .bacc-teaser {
    filter: blur(10px) grayscale(0.35) brightness(0.5);
    --zoom: 1.18;
  }
  .bacc-panel:not(.is-open):hover .bacc-media > :global(img),
  .bacc-panel:not(.is-open):hover .bacc-media > .bacc-teaser {
    filter: blur(2.5px) grayscale(0) brightness(0.82);
  }
  .bacc-panel.is-open:hover .bacc-media > :global(img) {
    filter: brightness(1.08);
  }
  @media (prefers-reduced-motion: no-preference) {
    .bacc-panel:not(.is-open):hover .bacc-media > :global(img),
    .bacc-panel:not(.is-open):hover .bacc-media > .bacc-teaser {
      --zoom: 1.3;
    }
    .bacc-panel.is-open:hover .bacc-media > :global(img) {
      --zoom: 1.06;
    }
  }
  /* Scrim: the headline is always white type over this gradient. */
  .bacc-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(8, 8, 8, 0.92) 0%, rgba(8, 8, 8, 0.25) 60%, rgba(8, 8, 8, 0.1) 100%);
    transition: opacity 700ms cubic-bezier(0.25, 1, 0.5, 1);
  }
  /* Open: shade only the lower-left corner the copy sits in. */
  .bacc-panel.is-open .bacc-media::after {
    background:
      linear-gradient(90deg, rgba(8, 8, 8, 0.82) 0%, rgba(8, 8, 8, 0.45) 30%, rgba(8, 8, 8, 0) 55%),
      linear-gradient(to top, rgba(0, 0, 0, 0.85) 0%, rgba(0, 0, 0, 0.35) 30%, transparent 50%);
  }

  /* Teaser card (no art yet). */
  .bacc-teaser {
    position: relative;
    display: grid;
    place-items: center;
    background:
      radial-gradient(ellipse 60% 70% at 70% 45%, rgba(255, 255, 255, 0.09), transparent 70%),
      #0b0b0b;
    color: rgba(245, 245, 245, 0.55);
    overflow: hidden;
  }
  .bacc-teaser-art {
    position: absolute;
    top: 50%;
    left: 70%;
    width: min(38%, 320px);
    transform: translate(-50%, -58%);
  }
  .bacc-teaser-art :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* ─── TRIGGER: label + logo ─────────────────────────────────────────── */
  .bacc-trigger {
    position: absolute;
    inset: 0;
    z-index: 3;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }
  .bacc-trigger:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: -4px;
  }
  /* The open panel's trigger stays focusable (keyboard) but lets pointer
     clicks through to the copy and the art. */
  .bacc-panel.is-open .bacc-trigger {
    z-index: 7;
    pointer-events: none;
    cursor: default;
  }
  .bacc-label {
    position: absolute;
    top: 50%;
    left: 50%;
    writing-mode: vertical-rl;
    transform: translate(-50%, -50%) rotate(180deg);
    font: 600 clamp(0.76rem, 0.88vw, 0.95rem) / 1 var(--font-body);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    white-space: nowrap;
    color: rgba(245, 245, 245, 0.62);
    transition: color 0.3s ease, letter-spacing 0.4s ease, text-shadow 0.3s ease, opacity 0.3s ease;
  }
  .bacc-panel:not(.is-open):hover .bacc-label {
    color: #fff;
    letter-spacing: 0.42em;
    text-shadow: var(--accordion-label-glow);
  }
  .bacc-panel.is-open .bacc-label {
    opacity: 0;
  }
  /* The logo lives in a FIXED foot box, centred on the strip, contained at
     its natural aspect ratio. It glides to the open panel's bottom-right
     corner along `left` (one property, so it interpolates both ways). */
  .bacc-logo {
    --logo-w: calc(var(--strip) - 1.6rem);
    position: absolute;
    left: calc(50% - var(--logo-w) / 2);
    bottom: 1.6rem;
    width: var(--logo-w);
    height: clamp(56px, 6vw, 96px);
    display: grid;
    place-items: center;
    transition: left var(--acc-duration) var(--acc-ease), transform 0.4s ease, opacity 0.4s ease;
  }
  .bacc-logo :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: contain;
  }
  .bacc-logo-word {
    font: 800 1.35rem / 1 var(--font-display);
    letter-spacing: 0.08em;
    color: rgba(245, 245, 245, 0.8);
  }
  .bacc-panel:not(.is-open):hover .bacc-logo {
    transform: translateY(-6px) scale(1.06);
  }
  .bacc-panel.is-open .bacc-logo {
    left: calc(100% - var(--logo-w) - clamp(1.5rem, 3vw, 3rem));
    bottom: clamp(1.5rem, 3vw, 3rem);
  }

  /* ─── CHIPS (top-left) ──────────────────────────────────────────────── */
  .bacc-chips {
    --pad: clamp(1.5rem, 4vw, 3.75rem);
    position: absolute;
    top: var(--pad);
    left: var(--pad);
    right: calc(var(--pad) + 3.5rem);
    z-index: 6;
    margin: 0;
    display: flex;
    gap: 0.5rem;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.2s ease-out;
  }
  .bacc-panel.is-open .bacc-chips {
    opacity: 1;
    transition: opacity 0.4s ease-in 0.2s;
  }
  .bacc-chip {
    display: inline-block;
    padding: 0.4rem 0.8rem;
    background: rgba(10, 10, 10, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-left: 2px solid var(--accordion-edge);
    font: 600 0.68rem / 1.2 var(--font-body);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.9);
    white-space: nowrap;
  }

  /* ─── OPEN CONTENT ──────────────────────────────────────────────────── */
  /* Laid out at a fixed width (never the panel's animating width), so the
     lines never re-wrap mid-transition; the panel clips it. Hidden copy is
     `visibility: hidden`: no clicks, no focus, nothing in the a11y tree. */
  .bacc-content {
    --pad: clamp(1.25rem, 2.6vw, 2.75rem);
    position: absolute;
    left: 0;
    bottom: 0;
    z-index: 6;
    box-sizing: border-box;
    width: min(var(--open-w, 100%), 40rem);
    padding: var(--pad);
    padding-bottom: clamp(1.5rem, 2.6vw, 2.5rem);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition:
      opacity 0.25s ease,
      transform 0.25s ease,
      visibility 0s linear 0.25s;
  }
  /* In: as the panel finishes opening, on the panel's own easing. */
  .bacc-panel.is-open .bacc-content {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition:
      opacity 0.45s ease calc(var(--acc-duration) * 0.45),
      transform var(--acc-duration) var(--acc-ease) calc(var(--acc-duration) * 0.25),
      visibility 0s linear 0s;
  }
  .bacc-headline {
    margin: 0 0 0.75rem;
    font: 800 clamp(1.35rem, 2vw, 2.35rem) / 1.1 var(--font-display);
    text-transform: uppercase;
    color: #ffffff;
    max-width: 18ch;
    text-wrap: balance;
  }
  .bacc-deck {
    margin: 0;
    max-width: 52ch;
    font: 500 clamp(0.74rem, 0.82vw, 0.92rem) / 1.6 var(--font-body);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.76);
  }
  .bacc-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: var(--tap-min);
    margin-top: 1.1rem;
    padding: 0.8rem 1.6rem;
    border: 1px solid var(--accordion-cta-border);
    background: rgba(8, 8, 8, 0.35);
    color: #ffffff;
    font: 700 0.74rem / 1.2 var(--font-display);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color 0.3s cubic-bezier(0.25, 0.8, 0.2, 1), color 0.3s ease, box-shadow 0.3s ease;
  }
  /* The CTA fills on its own hover and, as on HQ, while its open panel is
     hovered, for panels whose theme opts in with --accordion-cta-panel-hover. */
  .bacc-cta:hover,
  .bacc-cta:focus-visible {
    background: var(--accordion-cta-hover-bg);
    color: var(--accordion-cta-hover-ink);
    box-shadow: var(--accordion-cta-glow);
  }
  .bacc-panel.is-open[data-cta-panel-hover]:hover .bacc-cta {
    background: var(--accordion-cta-hover-bg);
    color: var(--accordion-cta-hover-ink);
    box-shadow: var(--accordion-cta-glow);
  }
  .bacc-cta:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 3px;
  }
  .bacc-teaser-tag {
    display: inline-block;
    margin-top: 1.4rem;
    padding: 0.6rem 1.2rem;
    border: 1px solid rgba(255, 255, 255, 0.25);
    font: 600 0.72rem / 1.2 var(--font-body);
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: rgba(245, 245, 245, 0.75);
  }
  .bacc-inquiry {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: var(--tap-min);
    margin-top: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(245, 245, 245, 0.7);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .bacc-inquiry:hover,
  .bacc-inquiry:focus-visible {
    color: #fff;
    border-color: #fff;
  }

  /* ─── PROGRESS + TOGGLE ─────────────────────────────────────────────── */
  .bacc-progress {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 5;
    height: 3px;
    background: rgba(255, 255, 255, 0.08);
    display: none;
  }
  .bacc-panel.is-open .bacc-progress {
    display: block;
  }
  .bacc-progress-fill {
    display: block;
    height: 100%;
    background: var(--accordion-progress);
    transform: scaleX(0);
    transform-origin: left center;
  }
  .bacc-toggle {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 8;
    display: grid;
    place-items: center;
    width: var(--tap-min);
    height: var(--tap-min);
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.22);
    background: rgba(8, 8, 8, 0.6);
    color: #f0f0f0;
    cursor: pointer;
    transition: border-color 0.2s ease, background 0.2s ease;
  }
  .bacc-toggle:hover {
    border-color: rgba(255, 255, 255, 0.6);
    background: rgba(8, 8, 8, 0.85);
  }
  .bacc-toggle[hidden] {
    display: none;
  }
  .bacc-toggle .bacc-icon-play,
  .bacc-toggle.is-paused .bacc-icon-pause {
    display: none;
  }
  .bacc-toggle.is-paused .bacc-icon-play {
