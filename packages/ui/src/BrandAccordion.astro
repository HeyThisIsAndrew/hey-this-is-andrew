---
/**
 * BrandAccordion (@andrew/ui): a data-driven, themeable brand accordion.
 *
 * Mechanics mirror the hero accordion on beunconventionalhq.com (HQ's
 * src/components/home/HeroAccordion.astro), per the Section 1.3 contract:
 *
 *  - Desktop: a flex row. Collapsed strips are --acc-strip wide and show the
 *    panel's art BLURRED, a vertical label and the logo in a fixed foot box.
 *    The open panel is `flex: 1 1 0%`; panels animate flex-grow/flex-basis.
 *    Hover (fine pointers, 768px+) only PEEKS: 28px wider, art sharpens, the
 *    frame lights up. Hover never opens a panel; a click or the keyboard does.
 *  - Panel 0 is rendered open on the server (`is-open`, aria-expanded="true").
 *  - Rotation: `interval` ms per panel (default 8s) on a requestAnimationFrame clock that only runs
 *    while visible and not held. Held by hover, focus inside and a touch in
 *    progress; the first manual choice stops it; the toggle restarts it. Off
 *    by default below 768px and never with prefers-reduced-motion. The open
 *    panel's progress bar shows the clock.
 *  - Keyboard: arrows move between panels (and open them), Home/End jump,
 *    Escape closes the fullscreen brand view (no visible key hint, as in
 *    search); so do its Close control, a
 *    tap outside the copy, and Back.
 *  - Phones: the same markup stacks (no duplicated markup). The open panel
 *    moves to the top; every panel has a fixed height, so the accordion's
 *    total height never changes.
 *  - Theming: every accent value is a --accordion-* token (@andrew/tokens).
 *    A panel renders data-accent="<accent>"; the site's theme re-points the
 *    tokens for that accent (e.g. the personal site's BE panel in BE red).
 *    Nothing brand-specific is written in this file.
 *  - `fullscreen` adds the "brand view": a camera dolly into the open panel
 *    (the personal site's addition to HQ's mechanics). A tap on ANY brand
 *    goes into its view; a closed one expands on the way. Desktop fits the
 *    panel whole with the copy under it; phones fill the screen with the
 *    art, under a black band, with the copy over its foot. Html carries
 *    `bacc-view-open` meanwhile, for anything floating that should hide.
 *  - Geometry: the OPEN panel is a true 16:9 box (desktop and the phone's
 *    media frame), sized from the viewport height and capped by the width;
 *    the collapsed strips share what is left. The brand view fits that same
 *    16:9 box on screen whole (contain, never cover) and sets the copy in a
 *    caption band under it, at screen size: the copy is never scaled with
 *    the camera and never sits on the art in the view.
 *  - Copy never reflows while a panel grows or shrinks (it is laid out at
 *    the open width and the panel clips it), and it crossfades with the
 *    panel motion instead of popping in and out.
 */
import { Image } from 'astro:assets';
import type { AccordionPanel, AccordionLabels } from './types';

interface Props {
  panels: AccordionPanel[];
  /** Enables the fullscreen brand view (a tap on any brand), all widths. */
  fullscreen?: boolean;
  /** Brand view framing on desktop: 'fill' (default; the art fills the
   *  screen, the copy over it) or 'fit' (the panel whole, the copy under).
   *  Phones always fill. */
  view?: 'fill' | 'fit';
  /** Auto-rotation interval in ms (HQ uses 7000; the personal site 8000). */
  interval?: number;
  labels?: Partial<AccordionLabels>;
}

const { panels, fullscreen = false, view = 'fill', interval = 8000, labels: labelProp = {} } = Astro.props;
const labels: AccordionLabels = {
  play: 'Play auto-rotation',
  pause: 'Pause auto-rotation',
  close: 'Close',
  closeAria: 'Close brand view',
  ...labelProp,
};
const OPEN_SIZES = '(max-width: 767px) 100vw, calc(100vw - 2 * 180px)';
---
<div class="bacc" data-bacc data-avoid-fab data-interval={interval} data-fullscreen={fullscreen ? '' : undefined} data-view={view} style={`--acc-n: ${panels.length}; --acc-rows: ${Math.max(1, panels.length - 1)}`}>
    <div class="bacc-viewport" data-bacc-viewport>
      <button type="button" class="bacc-close" data-bacc-close hidden aria-label={labels.closeAria}>
        <span aria-hidden="true">{labels.close}</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>

      <div class="bacc-stage" data-bacc-stage>
        <div class="bacc-track">
          {panels.map((brand, i) => {
            const open = i === 0;
            const contentId = `bacc-content-${brand.id}`;
            const triggerId = `bacc-trigger-${brand.id}`;
            const hasCta = Boolean(brand.url && brand.cta) && !brand.comingSoon;
            const art = brand.mediaSrc ?? null;
            return (
              <article
                class:list={[
                  'bacc-panel',
                  { 'is-open': open, 'is-teaser': !art, 'is-coming-soon': brand.comingSoon },
                ]}
                id={`brand-${brand.id}`}
                data-accent={brand.accent}
                data-cta-panel-hover={brand.ctaFillOnPanelHover ? '' : undefined}
                data-bacc-panel
                data-brand-id={brand.id}
              >
                <div class="bacc-media" aria-hidden="true">
                  {art ? (
                    <Image
                      src={art}
                      alt=""
                      widths={[640, 960, 1280, 1920]}
                      sizes={OPEN_SIZES}
                      format="webp"
                      loading={open ? 'eager' : 'lazy'}
                      decoding="async"
                    />
                  ) : (
                    /* Teaser card: monochrome "something is brewing" art for a
                       brand with no art yet (never an empty black box). */
                    <div class="bacc-teaser">
                      {brand.teaserSvg && <span class="bacc-teaser-art" set:html={brand.teaserSvg} />}
                    </div>
                  )}
                </div>

                <button
                  type="button"
                  class="bacc-trigger"
                  id={triggerId}
                  aria-expanded={open ? 'true' : 'false'}
                  aria-controls={contentId}
                  data-bacc-trigger
                >
                  <span class="bacc-label">{brand.name}</span>
                  <span class="bacc-logo" aria-hidden="true">
                    {brand.logoSrc ? (
                      <Image src={brand.logoSrc} alt="" widths={[160, 320, 480]} sizes="(max-width: 767px) 96px, 240px" format="webp" loading="lazy" decoding="async" />
                    ) : (
                      <span class="bacc-logo-word">{brand.wordmark}</span>
                    )}
                  </span>
                </button>

                {/* Metadata chips, HQ's construct: WHOSE (the brand, with the
                    accent tick) then WHAT (its kicker), then a status where
                    there is one. A sibling of the content block: pinned to the
                    open panel's TOP-LEFT corner on desktop, in flow under the
                    art on a phone. The trigger names the brand for a screen
                    reader, so the row is hidden from it. */}
                <p class="bacc-chips" aria-hidden="true">
                  <span class="bacc-chip bacc-chip--brand">{brand.name}</span>
                  {brand.kicker && <span class="bacc-chip">{brand.kicker}</span>}
                  {brand.comingSoon && brand.teaserTag && <span class="bacc-chip">{brand.teaserTag}</span>}
                </p>

                <div class="bacc-content" id={contentId} role="region" aria-labelledby={triggerId}>
                  {/* The headline is the panel's link (HQ). On a phone it
                      stretches over the whole panel, so a tap on the art does
                      what the card does; on desktop a click on the art opens
                      the brand view instead. */}
                  <h3 class="bacc-headline">
                    {hasCta ? (
                      <a href={brand.url} target="_blank" rel="noopener">{brand.headline}</a>
                    ) : (
                      brand.headline
                    )}
                  </h3>
                  <p class="bacc-deck">{brand.deck}</p>
                  {hasCta && (
                    <a class="bacc-cta" href={brand.url} target="_blank" rel="noopener">
                      {brand.cta}
                      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                        <path d="M2 12L12 2H5M12 2v7" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" />
                      </svg>
                    </a>
                  )}
                  {brand.inquiry && (
                    <a class="bacc-inquiry" href={`mailto:${brand.inquiry.email}?subject=${encodeURIComponent(brand.inquiry.subject)}`}>
                      {brand.inquiry.label} <span aria-hidden="true">→</span>
                    </a>
                  )}
                </div>

                <div class="bacc-progress" aria-hidden="true"><span class="bacc-progress-fill"></span></div>
              </article>
            );
          })}
        </div>

        <button type="button" class="bacc-toggle" data-bacc-toggle aria-label={labels.pause} data-label-play={labels.play} data-label-pause={labels.pause} hidden>
          <svg class="bacc-icon-pause" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d="M7 5h3v14H7zM14 5h3v14h-3z" /></svg>
          <svg class="bacc-icon-play" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
        </button>
      </div>
      {fullscreen && <div class="bacc-caption" data-bacc-caption hidden></div>}
    </div>
  <p class="bacc-sr" aria-live="polite" data-bacc-announcer></p>
</div>

<style>
  /* Every colour below is a token (@andrew/tokens) or a neutral black/white
     scrim. Accent tokens (--accordion-*) are read on the panel, so a site
     re-points them per panel with [data-accent="<name>"].

     THE LOOK IS BE UNCONVENTIONAL HQ'S HERO, ONE TO ONE (HQ's
     src/styles/modules/home.css, section "1. HERO ACCORDION"). Sizes from
     768 up are HQ's pixels at its 12.8px root, written as N * var(--acc-u):
     --acc-u is 1px by default and a site whose root scales on big screens
     re-points it (the personal site does above 1920). Phones use HQ's rem
     values as they are: both sites have a 16px root there. */
  .bacc-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* ─── TRACK ─────────────────────────────────────────────────────────── */
  .bacc {
    --u: var(--acc-u, 1px);
    position: relative;
    /* The track's geometry reads this width (cqw). The root stays in the
       page flow when the brand view fixes the viewport, so the panel sizes
       never change on the way in or out. */
    container-type: inline-size;
    /* Never a scroll anchor: the brand view fixes the viewport, and an
       anchor inside it (a short landscape screen is all accordion) made
       the browser scroll the page 155px as the view opened. */
    overflow-anchor: none;
  }
  .bacc-viewport {
    position: relative;
    width: 100%;
    overflow: hidden;
  }
  /* The brand view's backdrop fades with the camera, both ways. An opacity
     layer, not a background-color transition: that repainted a full-screen
     box on every frame of the camera move. */
  .bacc-viewport::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: #000;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 700ms cubic-bezier(0.25, 1, 0.5, 1),
      visibility 0s linear 700ms;
  }
  .bacc-viewport.is-zoomed::after {
    opacity: 1;
    visibility: visible;
    transition: opacity 700ms cubic-bezier(0.25, 1, 0.5, 1);
  }
  .bacc-viewport.is-zoomed.is-closing::after {
    opacity: 0;
  }
  .bacc-stage {
    position: relative;
    width: 100%;
    transform-origin: 0 0;
  }
  .bacc-track {
    --strip: var(--acc-strip);
    /* HQ: the open panel takes what the strips leave; the track is 75% of
       the window less the nav and HQ's 36px pagination band, never under
       460px. */
    --open-w: calc(100cqw - (var(--acc-n) - 1) * (var(--strip) + var(--acc-gap)));
    --pad: clamp(calc(19.2 * var(--u)), 4vw, calc(48 * var(--u)));
    display: flex;
    gap: var(--acc-gap);
    width: 100%;
    overflow: hidden;
    height: calc(75vh - var(--nav-bar-h, var(--nav-h, 0px)) - 36px);
    min-height: 460px;
    background: var(--page-bg);
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.6);
  }

  .bacc-panel {
    position: relative;
    flex: 0 0 var(--strip);
    min-width: 0;
    overflow: hidden;
    background: #111;
    color: var(--text);
    transition:
      flex-grow var(--acc-duration) var(--acc-ease),
      flex-basis var(--acc-duration) var(--acc-ease);
  }
  .bacc-panel.is-open {
    flex: 1 1 0%;
  }
  /* The active edge: a pseudo-element, so opening a panel shifts nothing. */
  .bacc-panel::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 5px;
    background: var(--accordion-edge);
    z-index: 5;
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.5s ease 0.2s;
  }
  .bacc-panel.is-open::before {
    transform: scaleY(1);
  }
  /* The focus state (HQ's highlighted row): a frame and a glow rising from
     the foot, in the panel's own accent. */
  .bacc-panel::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 4;
    pointer-events: none;
    opacity: 0;
    box-shadow:
      inset 0 0 0 1px var(--accordion-frame),
      inset 0 -120px 90px -60px var(--accordion-frame-glow);
    transition: opacity 0.35s ease;
  }
  .bacc-panel:not(.is-open):hover::after,
  .bacc-panel:not(.is-open):focus-within::after {
    opacity: 1;
  }

  /* ─── ART ───────────────────────────────────────────────────────────── */
  .bacc-media {
    position: absolute;
    inset: 0;
  }
  .bacc-media > :global(img),
  .bacc-media > .bacc-teaser {
    width: 100%;
    height: 100%;
    object-fit: cover;
    --zoom: 1;
    transform: translateX(var(--img-x, 0)) scale(var(--zoom));
    transition: filter 0.6s ease, transform 1.4s ease;
  }
  /* Collapsed: blurred. Art is framed for the open panel, never for a strip,
     so a sharp sliver is noise; blurred, it is colour and mood. The panel
     clips, so the overscan hides the soft blur edge. */
  .bacc-panel:not(.is-open) .bacc-media > :global(img),
  .bacc-panel:not(.is-open) .bacc-media > .bacc-teaser {
    filter: blur(10px) grayscale(0.35) brightness(0.5);
    --zoom: 1.18;
  }
  .bacc-panel:not(.is-open):hover .bacc-media > :global(img),
  .bacc-panel:not(.is-open):hover .bacc-media > .bacc-teaser {
    filter: blur(2.5px) grayscale(0) brightness(0.82);
  }
  .bacc-panel.is-open:hover .bacc-media > :global(img) {
    filter: brightness(1.08);
  }
  @media (prefers-reduced-motion: no-preference) {
    .bacc-panel:not(.is-open):hover .bacc-media > :global(img),
    .bacc-panel:not(.is-open):hover .bacc-media > .bacc-teaser {
      --zoom: 1.3;
    }
    .bacc-panel.is-open:hover .bacc-media > :global(img) {
      --zoom: 1.06;
    }
  }
  .bacc-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(8, 8, 8, 0.92) 0%, rgba(8, 8, 8, 0.25) 60%, rgba(8, 8, 8, 0.1) 100%);
    transition: opacity 700ms cubic-bezier(0.25, 1, 0.5, 1);
  }
  /* Open: HQ's shade, under the copy only. */
  .bacc-panel.is-open .bacc-media::after {
    background:
      linear-gradient(90deg, rgba(8, 8, 8, 0.94) 0%, rgba(8, 8, 8, 0.7) 32%, rgba(8, 8, 8, 0.15) 62%, rgba(8, 8, 8, 0) 80%),
      linear-gradient(to top, rgba(0, 0, 0, 0.95) 0%, rgba(0, 0, 0, 0.6) 25%, transparent 45%);
  }

  /* Teaser card (no art yet). */
  .bacc-teaser {
    position: relative;
    display: grid;
    place-items: center;
    background:
      radial-gradient(ellipse 60% 70% at 70% 45%, rgba(255, 255, 255, 0.09), transparent 70%),
      #0b0b0b;
    color: rgba(245, 245, 245, 0.55);
    overflow: hidden;
  }
  .bacc-teaser-art {
    position: absolute;
    top: 50%;
    left: 70%;
    width: min(38%, 320px);
    transform: translate(-50%, -58%);
  }
  .bacc-teaser-art :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* ─── TRIGGER: label + logo ─────────────────────────────────────────── */
  .bacc-trigger {
    position: absolute;
    inset: 0;
    z-index: 3;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }
  .bacc-trigger:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: -4px;
  }
  /* The open panel's trigger stays focusable (keyboard) but lets pointer
     clicks through to the copy and the art. */
  .bacc-panel.is-open .bacc-trigger {
    z-index: 7;
    pointer-events: none;
    cursor: default;
  }
  /* A strip's label: vertical, centred (HQ .acc-label, 0.95rem / 0.3em). */
  /* The vertical name is centred in the strip ABOVE the logo's zone (the
     logo box, its distance from the foot, and a gap), never in the whole
     strip: centred in the whole strip, "CAPTURE CREATE CAFFEINATE" ran into
     its logo at 1280 x 800 (23px of overlap). */
  .bacc {
    --logo-h: 104px;
    --logo-zone: calc(var(--logo-h) + 17.92 * var(--u) + 16px);
  }
  @media (max-width: 1599px) {
    .bacc {
      --logo-h: 84px;
    }
  }
  .bacc-label {
    position: absolute;
    top: calc((100% - var(--logo-zone)) / 2);
    left: 50%;
    writing-mode: vertical-rl;
    transform: translate(-50%, -50%) rotate(180deg);
    font: 600 calc(12.16 * var(--u)) / 1 var(--font-body);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--text);
    transition: color 0.3s ease, letter-spacing 0.4s ease, text-shadow 0.3s ease, opacity 0.3s ease;
  }
  .bacc-panel:not(.is-open):hover .bacc-label {
    color: #fff;
    letter-spacing: 0.42em;
    text-shadow: var(--accordion-label-glow);
  }
  .bacc-panel.is-open .bacc-label {
    opacity: 0;
  }
  /* The logo: HQ's art box, a fixed size pinned the same distance from the
     foot on every strip, contained at its natural aspect ratio. It glides
     to the open panel's bottom-right corner along `left` (one property, so
     it interpolates both ways). */
  .bacc-logo {
    --logo-w: calc(var(--strip) - 10.24 * var(--u));
    position: absolute;
    left: calc(50% - var(--logo-w) / 2);
    bottom: calc(17.92 * var(--u));
    width: var(--logo-w);
    height: var(--logo-h);
    display: grid;
    place-items: center;
    opacity: 0.95;
    transition: left var(--acc-duration) var(--acc-ease), transform 0.4s ease, opacity 0.4s ease;
  }
  .bacc-logo :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: contain;
  }
  .bacc-logo-word {
    font: 800 1.35rem / 1 var(--font-display);
    letter-spacing: 0.08em;
    color: rgba(245, 245, 245, 0.8);
  }
  .bacc-panel:not(.is-open):hover .bacc-logo {
    opacity: 1;
    transform: translateY(-6px) scale(1.06);
  }
  .bacc-panel.is-open .bacc-logo {
    left: calc(100% - var(--logo-w) - 1.25rem);
  }

  /* ─── METADATA CHIPS (HQ .acc-chips) ────────────────────────────────── */
  /* WHOSE, then WHAT: the brand with the accent tick, then its kicker. One
     row, exactly one chip tall: a chip that does not fit leaves whole. */
  .bacc-chips {
    --chip-fs: calc(8.704 * var(--u));
    --chip-py: calc(5.12 * var(--u));
    position: absolute;
    top: var(--pad);
    left: var(--pad);
    right: calc(var(--pad) + 44.8 * var(--u));
    z-index: 6;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: calc(6.4 * var(--u));
    max-height: calc(var(--chip-fs) * 1.2 + 2 * var(--chip-py) + 2px);
    overflow: hidden;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.2s ease-out;
  }
  .bacc-panel.is-open .bacc-chips {
    opacity: 1;
    transition: opacity 0.4s ease-in 0.2s;
  }
  .bacc-chip {
    display: inline-block;
    padding: var(--chip-py) calc(10.24 * var(--u));
    background: rgba(10, 10, 10, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.1);
    font: 600 var(--chip-fs) / 1.2 var(--font-body);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.62);
    white-space: nowrap;
  }
  .bacc-chip--brand {
    border-left: 2px solid var(--accordion-edge);
    color: rgba(255, 255, 255, 0.9);
  }

  /* ─── OPEN CONTENT ──────────────────────────────────────────────────── */
  /* Laid out at a fixed width (never the panel's animating width), so the
     lines never re-wrap mid-transition; the panel clips it. Hidden copy is
     `visibility: hidden`: no clicks, no focus, nothing in the a11y tree. */
  .bacc-content {
    position: absolute;
    left: 0;
    bottom: 0;
    z-index: 6;
    box-sizing: border-box;
    width: min(var(--open-w, 100%), calc(870.4 * var(--u) + 2 * var(--pad)));
    padding: var(--pad);
    padding-bottom: clamp(calc(25.6 * var(--u)), 3.5vw, calc(41.6 * var(--u)));
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition:
      opacity 0.25s ease,
      transform 0.25s ease,
      visibility 0s linear 0.25s;
  }
  /* In: as the panel finishes opening, on the panel's own easing. */
  .bacc-panel.is-open .bacc-content {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition:
      opacity 0.45s ease calc(var(--acc-duration) * 0.45),
      transform var(--acc-duration) var(--acc-ease) calc(var(--acc-duration) * 0.25),
      visibility 0s linear 0s;
  }
  /* HQ .acc-title-box + .acc-headline: 800, uppercase, at most four lines. */
  .bacc-headline {
    margin: calc(2.56 * var(--u)) 0 calc(11.52 * var(--u));
    font: 800 clamp(calc(17.92 * var(--u)), 2.15vw, calc(28.16 * var(--u))) / 1.06 var(--font-display);
    text-transform: uppercase;
    color: #ffffff;
    text-wrap: pretty;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .bacc-headline a {
    color: inherit;
    text-decoration: none;
  }
  .bacc-headline a:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 3px;
  }
  /* HQ .acc-deck: a billing block, two lines at most. */
  .bacc-deck {
    margin: 0;
    max-width: min(70ch, 100%);
    font: 500 calc(12.16 * var(--u)) / 1.7 var(--font-body);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.62);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  /* HQ .acc-cta.cta-button-primary: an accent outline that fills on hover,
     and while its open panel is hovered for panels that opt in. */
  .bacc-cta {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    /* The button standard's md size (cta.css); HQ's face and colours. */
    min-height: var(--btn-h-md);
    margin-top: calc(17.92 * var(--u));
    padding: calc(8 * var(--ui-u)) var(--btn-px-md);
    border: 1px solid var(--accordion-cta-border);
    border-radius: var(--btn-radius);
    background: transparent;
    color: #ffffff;
    font: 600 var(--btn-fs-md) / 1.2 var(--font-body);
    letter-spacing: var(--btn-ls);
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.3s cubic-bezier(0.25, 0.8, 0.2, 1), color 0.3s ease, box-shadow 0.3s ease;
  }
  .bacc-cta:hover,
  .bacc-cta:focus-visible {
    background: var(--accordion-cta-hover-bg);
    color: var(--accordion-cta-hover-ink);
    box-shadow: var(--accordion-cta-glow);
  }
  .bacc-panel.is-open[data-cta-panel-hover]:hover .bacc-cta {
    background: var(--accordion-cta-hover-bg);
    color: var(--accordion-cta-hover-ink);
    box-shadow: var(--accordion-cta-glow);
  }
  .bacc-cta:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 3px;
  }
  .bacc-inquiry {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    /* A text CTA (the button standard's text size). */
    min-height: var(--btn-hit);
    margin-top: 0.4rem;
    font-family: var(--font-mono);
    font-size: var(--btn-fs-md);
    letter-spacing: var(--btn-ls);
    text-transform: uppercase;
    color: rgba(245, 245, 245, 0.7);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .bacc-inquiry:hover,
  .bacc-inquiry:focus-visible {
    color: #fff;
    border-color: #fff;
  }

  /* ─── PROGRESS + TOGGLE ─────────────────────────────────────────────── */
  .bacc-progress {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 5;
    height: 3px;
    background: rgba(255, 255, 255, 0.08);
    display: none;
  }
  .bacc-panel.is-open .bacc-progress {
    display: block;
  }
  .bacc-progress-fill {
    display: block;
    height: 100%;
    background: var(--accordion-progress);
    transform: scaleX(0);
    transform-origin: left center;
  }
  /* HQ .acc-toggle: the round play/pause button over the art. */
  .bacc-toggle {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 8;
    display: grid;
    place-items: center;
    /* HQ's is 40px; this site's touch targets are 44 (--tap-min). */
    width: var(--tap-min, 44px);
    height: var(--tap-min, 44px);
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 50%;
    background: rgba(8, 8, 8, 0.6);
    color: #f0f0f0;
    cursor: pointer;
    transition: border-color 0.2s ease, background 0.2s ease;
  }
  .bacc-toggle:hover {
    border-color: rgba(255, 255, 255, 0.6);
    background: rgba(8, 8, 8, 0.85);
  }
  .bacc-toggle[hidden] {
    display: none;
  }
  .bacc-toggle .bacc-icon-play,
  .bacc-toggle.is-paused .bacc-icon-pause {
    display: none;
  }
  .bacc-toggle.is-paused .bacc-icon-play {
    display: block;
  }

  /* ─── DESKTOP: art fixed at the open width, the panel only clips it ────
     So a resize is a new clip, never a repaint (HQ measured 637ms/s of
     raster without this). --open-w is the track less the strips and gaps. */
  @media (min-width: 768px) {
    .bacc-media > :global(img),
    .bacc-media > .bacc-teaser {
      position: absolute;
      top: 0;
      left: 50%;
      width: var(--open-w);
      max-width: none;
      --img-x: -50%;
      will-change: transform;
    }
    .bacc-media::after {
      inset: 0 auto 0 0;
      width: var(--open-w);
    }
  }
  /* Hover peeks: the strip widens 28px (HQ). */
  @media (hover: hover) and (pointer: fine) and (min-width: 768px) {
    .bacc-panel:not(.is-open):hover {
      flex-basis: calc(var(--strip) + 28px);
    }
  }

  /* ─── PHONES (HQ: "the same panels stack into a vertical accordion") ──
     Full bleed, 4px apart; the open story on top, its art 16:9 and its copy
     on a dark band below it, left-aligned; every other brand one 72px row,
     its logo flush left and its name centred in the row. */
  @media (max-width: 767px) {
    .bacc-track {
      flex-direction: column;
      gap: 4px;
      min-height: 0;
      height: auto;
      padding: 0;
      background: none;
    }
    .bacc-panel {
      flex: none;
      width: 100%;
      height: 72px;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.8);
      z-index: 1;
    }
    .bacc-panel.is-open {
      flex: none;
      order: -1;
      height: auto;
      display: flex;
      flex-direction: column;
      background: #0d0d0d;
      z-index: 2;
    }
    .bacc-panel.is-open .bacc-media {
      position: relative;
      inset: auto;
      flex: none;
      width: 100%;
      aspect-ratio: 16 / 9;
      max-height: 30svh;
      overflow: hidden;
    }
    .bacc-panel.is-open .bacc-media::after {
      background: linear-gradient(to top, rgba(8, 8, 8, 0.9) 0%, rgba(8, 8, 8, 0) 50%);
    }
    /* The chips and the copy sit in flow under the art (HQ .acc-body). */
    .bacc-panel.is-open .bacc-chips {
      --chip-fs: 0.68rem;
      --chip-py: 0.4rem;
      position: static;
      order: 1;
      margin: 0.9rem 1rem 0.6rem;
      gap: 0.5rem;
    }
    .bacc-chip {
      padding-inline: 0.8rem;
    }
    .bacc-panel:not(.is-open) .bacc-chips {
      display: none;
    }
    .bacc-panel.is-open .bacc-content {
      position: static;
      order: 2;
      width: 100%;
      max-width: none;
      padding: 0 1rem 1.2rem;
    }
    /* HQ clamps a phone headline to two lines; a brand's line is never cut
       ("WHERE NERD CULTURE GETS CINEMATIC." needs three at 390), so three. */
    .bacc-headline {
      -webkit-line-clamp: 3;
      margin: 0.2rem 0 0.9rem;
      font-size: clamp(1.05rem, 4.5vw, 1.35rem);
    }
    /* No stretched headline link on a phone any more: a tap on the art
       goes INTO the brand's view (Andrew, 2026-10-02), where the button to
       its site is. The headline itself is still the link. */
    .bacc-deck {
      font-size: 0.8rem;
      letter-spacing: 0.14em;
      -webkit-line-clamp: 1;
    }
    /* Rows swap places at once on phones, so the closing row drops its
       copy and chips at once too; the opening panel's copy still fades in. */
    .bacc-panel:not(.is-open) .bacc-content,
    .bacc-panel:not(.is-open) .bacc-chips {
      transition: none;
    }
    /* A closed row: blurred art behind, logo left, name centred. HQ centres
       one-word labels in the row; brand names run to three words, so the
       name is centred in the room right of the logo (the same room on every
       row, so the names still line up) and may take two lines. */
    .bacc-label {
      top: 50%;
      left: calc(1rem + 76px + 0.75rem);
      right: 1rem;
      writing-mode: horizontal-tb;
      transform: translateY(-50%);
      text-align: center;
      white-space: normal;
      text-wrap: balance;
      line-height: 1.25;
      font-size: 0.9rem;
      letter-spacing: 0.16em;
    }
    .bacc-panel:not(.is-open):hover .bacc-label {
      letter-spacing: 0.16em;
    }
    .bacc-logo {
      --logo-w: 76px;
      left: 1rem;
      bottom: 50%;
      height: 48px;
      transform: translateY(50%);
      place-items: center start;
    }
    .bacc-logo :global(img) {
      object-position: left center;
    }
    .bacc-panel:not(.is-open):hover .bacc-logo {
      transform: translateY(50%);
    }
    /* HQ hides the open story's trigger (art and label) on a phone. */
    .bacc-panel.is-open .bacc-logo {
      display: none;
    }
    .bacc-logo-word {
      font-size: 1rem;
    }
    .bacc-toggle {
      top: 10px;
      right: 10px;
    }
  }
  /* Phone portrait (HQ: "way too busy"): no button under the copy. The
     brand view (a tap on the panel) carries it. */
  @media (max-width: 767px) and (orientation: portrait) {
    .bacc-cta,
    .bacc-inquiry {
      display: none;
    }
  }

  /* ─── PHONE LANDSCAPE: the open story left, the others stacked right ───
     HQ's grid: the open panel spans the left column, the rest auto-place
     into one right-hand column. Keyed on a short landscape viewport, so it
     catches phones either side of the 768px line. */
  @media (orientation: landscape) and (max-height: 520px) {
    .bacc {
      --stack-w: clamp(170px, 30cqw, 260px);
    }
    .bacc-track {
      --open-w: calc(100cqw - var(--stack-w) - 4px);
      display: grid;
      grid-template-columns: minmax(0, 1fr) var(--stack-w);
      grid-template-rows: repeat(var(--acc-rows), minmax(0, 1fr));
      gap: 4px;
      flex-direction: row;
      min-height: 0;
      height: calc(100svh - var(--nav-bar-h, var(--nav-h, 0px)) - 8px);
      padding: 0;
    }
    .bacc-panel,
    .bacc-panel:not(.is-open),
    .bacc-panel.is-open {
      grid-column: 2;
      order: 0;
      height: auto;
      min-height: 0;
      box-shadow: none;
    }
    .bacc-panel.is-open {
      grid-column: 1;
      grid-row: 1 / -1;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      padding: 1rem 1.25rem 1.1rem 1.5rem;
    }
    .bacc-media,
    .bacc-panel.is-open .bacc-media {
      position: absolute;
      inset: 0;
      width: auto;
      aspect-ratio: auto;
      max-height: none;
    }
    .bacc-media > :global(img),
    .bacc-media > .bacc-teaser {
      position: static;
      width: 100%;
      --img-x: 0;
    }
    .bacc-media::after {
      inset: 0;
      width: auto;
    }
    .bacc-panel.is-open .bacc-media::after {
      background:
        linear-gradient(90deg, rgba(8, 8, 8, 0.9) 0%, rgba(8, 8, 8, 0.55) 45%, rgba(8, 8, 8, 0) 80%),
        linear-gradient(to top, rgba(0, 0, 0, 0.92) 0%, rgba(0, 0, 0, 0.4) 40%, transparent 65%);
    }
    .bacc-panel.is-open .bacc-chips {
      --chip-fs: 0.6rem;
      --chip-py: 0.3rem;
      position: relative;
      inset: auto;
      margin: 0 0 0.5rem;
    }
    .bacc-chip {
      padding-inline: 0.6rem;
    }
    .bacc-panel:not(.is-open) .bacc-chips {
      display: none;
    }
    .bacc-panel.is-open .bacc-content {
      position: relative;
      inset: auto;
      width: auto;
      max-width: 34rem;
      padding: 0;
    }
    .bacc-headline {
      -webkit-line-clamp: 2;
      margin: 0 0 0.4rem;
      font-size: clamp(1.1rem, 2.6vw, 1.45rem);
    }
    .bacc-deck {
      font-size: 0.72rem;
      letter-spacing: 0.14em;
      -webkit-line-clamp: 1;
    }
    .bacc-cta {
      margin-top: 0.7rem;
    }
    .bacc-panel.is-open .bacc-logo {
      display: none;
    }
    /* The stack: logo flush left, name centred beside it (the phone
       portrait rule). */
    .bacc-label {
      top: 50%;
      left: calc(0.75rem + 52px + 0.7rem);
      right: 0.75rem;
      writing-mode: horizontal-tb;
      transform: translateY(-50%);
      text-align: center;
      white-space: normal;
      text-wrap: balance;
      line-height: 1.25;
      font-size: 0.8rem;
      letter-spacing: 0.2em;
    }
    .bacc-panel:not(.is-open):hover .bacc-label {
      letter-spacing: 0.2em;
    }
    .bacc-logo {
      --logo-w: 52px;
      left: 0.75rem;
      bottom: 50%;
      height: 34px;
      transform: translateY(50%);
    }
    .bacc-panel:not(.is-open):hover .bacc-logo {
      transform: translateY(50%);
    }
    .bacc-logo-word {
      font-size: 0.8rem;
    }
    .bacc-toggle {
      top: 10px;
      right: calc(var(--stack-w) + 14px);
    }
  }

  /* ─── FULLSCREEN BRAND VIEW ───────────────────────────────────────────
     One camera move: the stage dollies until the brand's art FILLS the
     screen under a black band (.is-fill), and the copy is laid over the
     art's foot at screen size, never scaled with the camera. `view="fit"`
     keeps the earlier desktop framing (the panel whole, the copy in a band
     under it); phones always fill. */
  .bacc-viewport.is-zoomed {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100dvh;
    z-index: 1000;
    /* The page behind never pans while the view is up (iOS). */
    touch-action: none;
    overscroll-behavior: none;
  }
  /* The band: the header's own height and colour, solid from the first
     frame to the last, so the top of the screen (and the status bar iOS
     colours from it) stays black throughout. The close control sits in it. */
  .bacc-viewport.is-fill {
    --view-band: var(--nav-bar-h, 64px);
  }
  .bacc-viewport.is-zoomed.is-fill::before {
    content: '';
    position: fixed;
    inset: 0 0 auto;
    height: var(--view-band);
    background: #000;
    z-index: 4;
    pointer-events: none;
  }
  .bacc-viewport.is-fill .bacc-close {
    top: calc((var(--view-band) - var(--tap-min, 44px)) / 2);
    right: max(1rem, env(safe-area-inset-right, 0px));
  }
  /* A brand with no art yet (the teaser): filling a phone screen with it
     blows its glyph up past the edges, so the glyph is held to about 1.6x
     its in-page size while the card around it fills the screen, and it
     drifts from the card's 70% mark to the centre (the glyph is 38% of the
     card, so 20% of the card is 52.6% of the glyph). */
  @media (max-width: 767px), (orientation: landscape) and (max-height: 520px) {
    .bacc-viewport.is-zoomed.is-fill:not(.is-closing) .bacc-panel.is-open .bacc-teaser-art {
      transform: translate(-102.6%, -58%) scale(calc(1.6 / var(--cam-scale, 1)));
    }
    .bacc-viewport.is-fill .bacc-teaser-art {
      transition: transform 700ms cubic-bezier(0.25, 1, 0.5, 1);
    }
  }
  .bacc-viewport.is-zoomed:not(.is-closing) .bacc-panel .bacc-chips,
  .bacc-viewport.is-zoomed.is-fill:not(.is-closing) .bacc-panel .bacc-logo {
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .bacc-stage {
    transition: transform 700ms cubic-bezier(0.25, 1, 0.5, 1);
  }
  /* The close control: out of the page (and the tab order) until the view
     is open, then above everything, including the fixed site header. */
  .bacc-close {
    position: fixed;
    top: calc(1.5rem + env(safe-area-inset-top, 0px));
    right: calc(1.5rem + env(safe-area-inset-right, 0px));
    z-index: 1100;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: var(--tap-min);
    padding: 0.5rem 0.85rem;
    background: rgba(18, 18, 18, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #f5f5f5;
    font: 500 0.72rem / 1 var(--font-mono);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    cursor: pointer;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }
  .bacc-close[hidden] {
    display: none;
  }
  .bacc-close:hover,
  .bacc-close:focus-visible {
    background: #f0f0f0;
    color: #080808;
    border-color: #f0f0f0;
  }
  .bacc-viewport.is-zoomed:not(.is-closing) .bacc-panel:not(.is-open),
  .bacc-viewport.is-zoomed:not(.is-closing) .bacc-toggle,
  .bacc-viewport.is-zoomed:not(.is-closing) .bacc-progress,
  .bacc-viewport.is-zoomed:not(.is-closing) .bacc-panel::before {
    opacity: 0;
    pointer-events: none;
  }
  [data-fullscreen] .bacc-panel.is-open {
    cursor: zoom-in;
  }
  .bacc-panel.is-open :is(a, button) {
    cursor: pointer;
  }
  .bacc-viewport.is-zoomed .bacc-panel.is-open {
    cursor: default;
  }
  /* In the view the art is shown whole and unshaded: the copy leaves the
     panel (it would scale with the camera) for the caption band below. */
  .bacc-viewport.is-zoomed .bacc-track {
    background: transparent;
  }
  .bacc-viewport.is-zoomed:not(.is-closing) .bacc-panel.is-open .bacc-content {
    opacity: 0;
    visibility: hidden;
    transform: none;
    transition: opacity 0.2s ease, visibility 0s linear 0.2s;
  }
  .bacc-viewport.is-zoomed:not(.is-closing) .bacc-panel.is-open .bacc-media::after {
    opacity: 0;
  }
  /* Closing: the copy returns as the camera lands, on its easing. */
  .bacc-viewport.is-closing .bacc-panel.is-open .bacc-content {
    transition:
      opacity 0.35s ease 0.4s,
      transform 0.35s ease 0.4s,
      visibility 0s linear 0s;
  }

  /* The caption band: the open brand's copy at screen size, under the art,
     left-aligned to it. Geometry (--cap-x/y/w) is set by the camera. */
  .bacc-caption {
    position: absolute;
    left: var(--cap-x, 2rem);
    top: var(--cap-y, 70vh);
    z-index: 3;
    width: var(--cap-w, calc(100vw - 4rem));
    opacity: 0;
    transform: translateY(16px);
    pointer-events: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  .bacc-caption[hidden] {
    display: none !important; /* over the fill view's grid */
  }
  .bacc-caption.is-shown {
    opacity: 1;
    transform: none;
    pointer-events: auto;
    /* Rises with the camera: same duration and easing, opacity a beat later. */
    transition:
      opacity 0.45s ease 0.25s,
      transform 700ms cubic-bezier(0.25, 1, 0.5, 1);
  }
  .bacc-caption .bacc-content {
    position: static;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    column-gap: clamp(1.5rem, 3vw, 3rem);
    align-items: start;
    width: auto;
    max-width: none;
    padding: 0;
    opacity: 1;
    visibility: visible;
    transform: none;
    transition: none;
  }
  .bacc-caption .bacc-headline {
    grid-column: 1;
    grid-row: 1 / span 4;
    margin: 0;
    font-size: clamp(1.3rem, 1.9vw, 2.2rem);
    max-width: 22ch;
  }
  .bacc-caption .bacc-content > :not(.bacc-headline) {
    grid-column: 2;
    justify-self: start;
  }
  .bacc-caption .bacc-cta {
    margin-top: 0.9rem;
  }
  .bacc-caption .bacc-chips {
    position: static;
    margin: 0 0 1rem;
    opacity: 1;
    /* Every chip, wrapping if it must (the panel clips to one line). */
    max-height: none;
  }
  .bacc-caption .bacc-deck {
    -webkit-line-clamp: 3;
  }
  /* FILL: the open panel's own structure at screen size (the hero and the
     in-page panel): the chips upper left, ONE stack bottom left (headline,
     deck, then the CTA under the deck, the inquiry quieter under that), the
     brand's logo bottom right on the stack's baseline. Each sits in its own
     grid area, so nothing can float into the middle or overlap. */
  .bacc-viewport.is-fill {
    --fill-pad: clamp(calc(19.2 * var(--u)), 4vw, calc(48 * var(--u)));
  }
  .bacc-viewport.is-fill .bacc-caption {
    left: 0;
    right: 0;
    top: var(--view-band);
    bottom: 0;
    width: auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-rows: auto minmax(0, 1fr) auto;
    grid-template-areas:
      'chips chips'
      '. .'
      'copy logo';
    column-gap: clamp(1.5rem, 4vw, 4rem);
    padding: var(--fill-pad);
    background:
      linear-gradient(to top, rgba(0, 0, 0, 0.9) 0%, rgba(0, 0, 0, 0.62) 30%, rgba(0, 0, 0, 0) 60%),
      linear-gradient(to bottom, rgba(0, 0, 0, 0.5) 0%, rgba(0, 0, 0, 0) 24%);
  }
  .bacc-viewport.is-fill .bacc-caption .bacc-chips {
    grid-area: chips;
    align-self: start;
    margin: 0;
  }
  .bacc-viewport.is-fill .bacc-caption .bacc-content {
    grid-area: copy;
    align-self: end;
    display: block;
    max-width: 46rem;
  }
  .bacc-viewport.is-fill .bacc-caption .bacc-headline {
    max-width: 24ch;
    margin: 0 0 0.75rem;
  }
  .bacc-viewport.is-fill .bacc-caption .bacc-cta {
    margin-top: 1.25rem;
  }
  .bacc-viewport.is-fill .bacc-caption .bacc-inquiry {
    display: flex;
    width: max-content;
    margin-top: 0.5rem;
  }
  .bacc-caption-logo {
    grid-area: logo;
    align-self: end;
    justify-self: end;
    position: relative;
    display: grid;
    place-items: end;
    width: clamp(110px, 12vw, 220px);
    height: clamp(60px, 7vw, 120px);
  }
  .bacc-caption-logo :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: right bottom;
  }
  .bacc-caption-logo .bacc-logo-word {
    font: 800 clamp(1.4rem, 2.4vw, 2.2rem) / 1 var(--font-display);
    letter-spacing: 0.08em;
    color: #fff;
  }
  /* Phones: one column. The logo sits on its own row over the stack, so a
     full-width stack never runs under it. */
  @media (max-width: 767px), (orientation: landscape) and (max-height: 520px) {
    .bacc-viewport.is-fill .bacc-caption {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'chips'
        '.'
        'logo'
        'copy';
      grid-template-rows: auto minmax(0, 1fr) auto auto;
      row-gap: 1rem;
      padding: 1rem max(1.25rem, env(safe-area-inset-right, 0px)) calc(1.75rem + env(safe-area-inset-bottom, 0px)) max(1.25rem, env(safe-area-inset-left, 0px));
      background:
        linear-gradient(to top, rgba(0, 0, 0, 0.94) 0%, rgba(0, 0, 0, 0.8) 42%, rgba(0, 0, 0, 0) 72%),
        linear-gradient(to bottom, rgba(0, 0, 0, 0.5) 0%, rgba(0, 0, 0, 0) 20%);
