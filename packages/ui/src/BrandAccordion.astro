      --chip-fs: 0.68rem;
      --chip-py: 0.4rem;
      gap: 0.5rem;
    }
    .bacc-caption-logo {
      justify-self: start;
      place-items: end start;
      width: 140px;
      height: 52px;
    }
    .bacc-caption-logo :global(img) {
      object-position: left bottom;
    }
    .bacc-viewport.is-fill .bacc-caption .bacc-content {
      max-width: 40rem;
    }
    .bacc-viewport.is-fill .bacc-caption .bacc-headline {
