  .bacc-close[hidden] {
    display: none;
  }
  .bacc-close:hover,
  .bacc-close:focus-visible {
    background: #f0f0f0;
    color: #080808;
    border-color: #f0f0f0;
  }
  .bacc-close-key {
    padding: 0.12rem 0.35rem;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.25);
    font-size: 0.62rem;
