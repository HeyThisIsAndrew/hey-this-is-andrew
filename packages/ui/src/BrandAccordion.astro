</style>

<script>
  const MOBILE = '(max-width: 767px)';
  /* Phones in either orientation always get the FILL view (the art fills
     the screen under a black band, the copy over it), whatever `view` says. */
  const PHONE_VIEW = '(max-width: 767px), (orientation: landscape) and (max-height: 520px)';
  const REDUCED = '(prefers-reduced-motion: reduce)';

  function initBrandAccordion() {
    const root = document.querySelector<HTMLElement>('[data-bacc]');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';

    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-bacc-panel]'));
    const triggers = panels.map((p) => p.querySelector<HTMLButtonElement>('[data-bacc-trigger]')!);
    const toggle = root.querySelector<HTMLButtonElement>('[data-bacc-toggle]');
    const announcer = document.querySelector<HTMLElement>('[data-bacc-announcer]');
    const viewport = root.querySelector<HTMLElement>('[data-bacc-viewport]')!;
    const stage = root.querySelector<HTMLElement>('[data-bacc-stage]')!;
    const closeBtn = root.querySelector<HTMLButtonElement>('[data-bacc-close]');
    const caption = root.querySelector<HTMLElement>('[data-bacc-caption]');
    const fullscreen = root.hasAttribute('data-fullscreen');
    const DURATION = Number(root.dataset.interval) || 8000;
    if (!panels.length || triggers.some((t) => !t)) return;

    const reduced = window.matchMedia(REDUCED);
    const mobile = window.matchMedia(MOBILE);
    const phoneView = window.matchMedia(PHONE_VIEW);
    const fillView = () => root.dataset.view !== 'fit' || phoneView.matches;
    const track = root.querySelector<HTMLElement>('.bacc-track')!;

    let current = Math.max(0, panels.findIndex((p) => p.classList.contains('is-open')));
    let elapsed = 0;
    let last = 0;
    let raf = 0;
    let onScreen = false;
    /* Why rotation is not running, as independent reasons. */
    const holds = { hover: false, focus: false, touch: false, zoom: false };
    let userPaused = mobile.matches; // off by default on phones
    let stopped = false; // the first manual choice stops it (Play restarts)

    const canRotate = () => panels.length > 1 && !reduced.matches;
    const running = () =>
      canRotate() && !stopped && !userPaused && !holds.hover && !holds.focus && !holds.touch && !holds.zoom;

    function setFill(ratio: number) {
      const fill = panels[current]?.querySelector<HTMLElement>('.bacc-progress-fill');
      if (fill) fill.style.transform = `scaleX(${Math.min(1, Math.max(0, ratio))})`;
    }

    function open(index: number, { focus = false, announce = false } = {}) {
      const next = (index + panels.length) % panels.length;
      if (next !== current) {
        setFill(0);
        panels[current].classList.remove('is-open');
        triggers[current].setAttribute('aria-expanded', 'false');
        current = next;
        panels[current].classList.add('is-open');
        triggers[current].setAttribute('aria-expanded', 'true');
        if (announce && announcer) {
          const name = triggers[current].querySelector('.bacc-label')?.textContent ?? '';
          announcer.textContent = `${name}, panel ${current + 1} of ${panels.length}`;
        }
      }
      elapsed = 0;
      setFill(0);
      if (focus) triggers[current].focus();
    }

    /* The clock only ticks while it has something to do. */
    function kick() {
      if (raf || !running() || !onScreen) return;
      last = 0;
      raf = requestAnimationFrame(frame);
    }
    function frame(now: number) {
      if (!running() || !onScreen) {
        raf = 0;
        return;
      }
      if (!last) last = now;
      /* Capped: rAF pauses in a hidden tab, so the first frame back would
         otherwise count the whole time away and flip the panel at once. */
      const dt = Math.min(now - last, 100);
      last = now;
      elapsed += dt;
      if (elapsed >= DURATION) open(current + 1);
      setFill(elapsed / DURATION);
      raf = requestAnimationFrame(frame);
    }

    /* The label always states what the button will do next, which is the
       state: "Pause" while rotating, "Play" while paused. No aria-pressed
       (a pressed "Play" was the contradiction the audit caught). */
    function syncToggle() {
      if (toggle) {
        toggle.hidden = !canRotate();
        const paused = stopped || userPaused;
        toggle.classList.toggle('is-paused', paused);
        const label = paused ? toggle.dataset.labelPlay : toggle.dataset.labelPause;
        toggle.setAttribute('aria-label', label ?? '');
        toggle.title = label ?? '';
      }
      if (stopped || userPaused) setFill(0);
      kick();
    }

    const choose = (i: number, focus = false) => {
      stopped = true;
      open(i, { focus, announce: true });
      syncToggle();
    };

    triggers.forEach((t, i) => {
      t.addEventListener('click', (e) => {
        e.stopPropagation();
        if (i === current) {
          // Enter/Space (or a tap) on the open panel's trigger opens the view.
          viewBrand(i);
          return;
        }
        /* A tap or click on a closed brand expands it and goes straight
           through into its view, as one move. The keyboard (detail 0) only
           opens the panel: arrows move between brands, Enter then views. */
        if (fullscreen && e.detail > 0) viewBrand(i);
        else choose(i);
      });
      t.addEventListener('keydown', (e) => {
        let target = -1;
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') target = i + 1;
        else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') target = i - 1;
        else if (e.key === 'Home') target = 0;
        else if (e.key === 'End') target = panels.length - 1;
        else return;
        e.preventDefault();
        choose(target, true);
      });
    });

    toggle?.addEventListener('click', () => {
      if (stopped || userPaused) {
        stopped = false;
        userPaused = false;
        /* Play means play NOW: the pointer is on this button and it has
           focus, so both holds are true at this moment. They re-arm on the
           next mouseenter / focusin. */
        holds.hover = false;
        holds.focus = false;
      } else {
        userPaused = true;
      }
      syncToggle();
    });

    const hold = (key: keyof typeof holds, value: boolean) => () => {
      holds[key] = value;
      kick();
    };
    root.addEventListener('mouseenter', hold('hover', true));
    root.addEventListener('mouseleave', hold('hover', false));
    root.addEventListener('focusin', hold('focus', true));
    root.addEventListener('focusout', (e) => {
      if (!root.contains(e.relatedTarget as Node | null)) holds.focus = false;
      kick();
    });
    root.addEventListener('touchstart', hold('touch', true), { passive: true });
    root.addEventListener('touchend', hold('touch', false), { passive: true });
    root.addEventListener('touchcancel', hold('touch', false), { passive: true });
    new IntersectionObserver(([entry]) => {
      onScreen = entry.isIntersecting;
      kick();
    }, { threshold: 0.25 }).observe(root);
    const onMedia = () => {
      if (mobile.matches) userPaused = true;
      syncToggle();
    };
    reduced.addEventListener('change', onMedia);
    mobile.addEventListener('change', onMedia);

    /* ─── Fullscreen brand view: a camera dolly into the open panel ───
       The 16:9 panel is fitted WHOLE (contain) into the screen above a
       caption band, and the copy is set in that band at screen size. The
       copy is never inside the scaled stage while the view is open, so the
       camera cannot blow it up or lay it over the art. */
    const EDGE = 32; // px kept clear around the art + caption block
    const BAND_GAP = 24; // px between the art and the caption
    const camera = {
      isZoomed: false,
      isClosing: false,
      expectPop: false,
      panel: null as HTMLElement | null,
      restX: 0,
      restY: 0,
      /* Clone the open panel's chips and copy into the caption layer (ids
         and the region role stay on the original, hidden meanwhile). */
      fillCaption(panel: HTMLElement) {
        if (!caption) return;
        const copy = panel.querySelector<HTMLElement>('.bacc-content');
        const chips = panel.querySelector<HTMLElement>('.bacc-chips');
        caption.replaceChildren();
        if (!copy) return;
        if (chips) caption.appendChild(chips.cloneNode(true));
        /* The brand's logo, bottom right at screen size (the panel's own
           would scale with the camera). */
        const logo = panel.querySelector<HTMLElement>('.bacc-logo');
        if (logo) {
          const box = document.createElement('div');
          box.className = 'bacc-caption-logo';
          const scope = Array.from(caption.attributes).find((a) => a.name.startsWith('data-astro-cid-'));
          if (scope) box.setAttribute(scope.name, '');
          box.setAttribute('aria-hidden', 'true');
          logo.childNodes.forEach((n) => box.appendChild(n.cloneNode(true)));
          box.querySelectorAll('img').forEach((img) => {
            img.loading = 'eager';
            img.sizes = '220px';
          });
          caption.appendChild(box);
        }
        const clone = copy.cloneNode(true) as HTMLElement;
        clone.removeAttribute('id');
        clone.removeAttribute('role');
        clone.removeAttribute('aria-labelledby');
        caption.appendChild(clone);
        if (panel.dataset.accent) caption.dataset.accent = panel.dataset.accent;
        else delete caption.dataset.accent;
        caption.hidden = false;
      },
      captionHeight(width: number) {
        if (!caption || caption.hidden) return 0;
        caption.style.setProperty('--cap-w', `${width}px`);
        return caption.getBoundingClientRect().height;
      },
      /* The open panel's box in the stage, untransformed (offsets, not
         client rects), so a resize while the view is open measures the
         panel, not the camera. `expanding`: the panel was opened in this
         same click and is still growing, so its FINAL box is worked out
         from the track (every other panel ends as a strip) and the camera
         heads there while it grows. */
      box(panel: HTMLElement, expanding = false) {
        if (!expanding) return { width: panel.offsetWidth, height: panel.offsetHeight, x: panel.offsetLeft, y: panel.offsetTop };
        const probe = document.createElement('div');
        probe.style.cssText = 'position:absolute;visibility:hidden;height:0;width:var(--strip)';
        track.append(probe);
        const strip = probe.offsetWidth;
        probe.remove();
        const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
        const i = panels.indexOf(panel);
        return {
          width: track.clientWidth - (panels.length - 1) * (strip + gap),
          height: panel.offsetHeight,
          x: track.offsetLeft + i * (strip + gap),
          y: panel.offsetTop,
        };
      },
      /* FILL: the art fills the screen under a black band the height of
         the site header (it stays black behind the status bar the whole
         time), cover, centred; the copy is laid over its foot at screen
         size. The camera dollies into the art box itself: the whole panel
         on desktop (its art is inset 0), the 16:9 frame on a phone. */
      measureFill(panel: HTMLElement, expanding = false) {
        const media = panel.querySelector<HTMLElement>('.bacc-media') ?? panel;
        let mx = 0;
        let my = 0;
        let mw = media.offsetWidth;
        let mh = media.offsetHeight;
        if (expanding) {
          // Desktop only (phones swap rows at once): the art is the panel.
          ({ x: mx, y: my, width: mw, height: mh } = this.box(panel, true));
        } else {
          for (let el: HTMLElement | null = media; el && el !== stage; el = el.offsetParent as HTMLElement | null) {
            mx += el.offsetLeft;
            my += el.offsetTop;
          }
        }
        const band = parseFloat(getComputedStyle(viewport).getPropertyValue('--view-band')) || 0;
        const vw = window.innerWidth;
        const h = window.innerHeight - band;
        const scale = Math.max(vw / mw, h / mh);
        return { tx: (vw - mw * scale) / 2 - scale * mx, ty: band + (h - mh * scale) / 2 - scale * my, scale };
      },
      measure(panel: HTMLElement, expanding = false) {
        if (fillView()) return this.measureFill(panel, expanding);
        const r = this.box(panel, expanding);
        /* A status bar or home indicator inset, where a viewport reports one,
           is not room for the art. */
        const probe = document.createElement('div');
        probe.style.cssText = 'position:fixed;top:0;left:0;visibility:hidden;pointer-events:none;height:env(safe-area-inset-top,0px);width:env(safe-area-inset-bottom,0px)';
        document.body.append(probe);
        const safeTop = probe.offsetHeight;
        const safeBottom = probe.offsetWidth;
        probe.remove();
        const vw = window.innerWidth;
        const vh = window.innerHeight - safeBottom;
        /* The close control sits top-right; the art never runs under it. */
        const closeR = closeBtn && !closeBtn.hidden ? closeBtn.getBoundingClientRect() : null;
        const solve = (top: number) => {
          const fit = (capH: number) =>
            Math.min((vw - 2 * EDGE) / r.width, (vh - top - EDGE - (capH ? capH + BAND_GAP : 0)) / r.height);
          /* The caption's height depends on its width (the art's width), and
             the art's size on the caption's height: two passes settle it. */
          let capH = this.captionHeight(Math.min(vw - 2 * EDGE, r.width * fit(0)));
          let scale = fit(capH);
          capH = this.captionHeight(r.width * scale);
          scale = fit(capH);
          const artW = r.width * scale;
          const artH = r.height * scale;
          const blockH = artH + (capH ? capH + BAND_GAP : 0);
          const x0 = (vw - artW) / 2;
          const y0 = Math.max(top, top + (vh - top - EDGE - blockH) / 2);
          return { scale, artW, artH, x0, y0 };
        };
        let g = solve(EDGE + safeTop);
        if (closeR && g.x0 + g.artW > closeR.left - 8 && g.y0 < closeR.bottom + 8) g = solve(closeR.bottom + 12);
        const { scale, artW, artH, x0, y0 } = g;
        if (caption) {
          caption.style.setProperty('--cap-x', `${x0}px`);
          caption.style.setProperty('--cap-y', `${y0 + artH + BAND_GAP}px`);
          caption.style.setProperty('--cap-w', `${artW}px`);
        }
        return { tx: x0 - scale * r.x, ty: y0 - scale * r.y, scale };
      },
      open(panel: HTMLElement, expanding = false) {
        if (this.isZoomed || this.isClosing) return;
        this.isZoomed = true;
        this.panel = panel;
        holds.zoom = true;
        this.fillCaption(panel);
        if (closeBtn) closeBtn.hidden = false;
        /* The page stays where it is underneath: no scroll while the view
           is up (iOS ignores overflow alone, so touches on the full-screen
           view are not allowed to pan either; see touchmove below). */
        document.documentElement.classList.add('bacc-view-open');
        document.documentElement.style.overflow = 'hidden';
        /* Back closes the view, not the page. */
        if (!history.state?.baccView) history.pushState({ ...(history.state ?? {}), baccView: true }, '');
        const s = stage.getBoundingClientRect();
        /* Hold the stage at its in-page width: the fixed viewport is wider
           by the scrollbar, which would re-flow the strips (and shift a
           panel that is not the first) as the view opens. */
        stage.style.width = `${s.width}px`;
        /* Keep the accordion's place in the page while its viewport is
           fixed, so the page behind does not move up (it shows through as
           the backdrop fades out on the way back). */
        root.style.height = `${root.offsetHeight}px`;
        viewport.classList.toggle('is-fill', fillView());
        const { tx, ty, scale } = this.measure(panel, expanding);
        viewport.style.setProperty('--cam-scale', String(scale));
        this.sharpen(panel, scale);
        this.restX = s.left;
        this.restY = s.top;
        const gutter = window.innerWidth - document.documentElement.clientWidth;
        if (gutter > 0) document.body.style.paddingRight = `${gutter}px`;
        viewport.classList.remove('is-closing');
        viewport.classList.add('is-zoomed');
        document.body.style.overflow = 'hidden';
        closeBtn?.focus({ preventScroll: true });
        stage.style.transition = 'none';
        if (reduced.matches) {
          stage.style.transform = `translate3d(${tx}px, ${ty}px, 0) scale(${scale})`;
          caption?.classList.add('is-shown');
          return;
        }
        stage.style.transform = `translate3d(${this.restX}px, ${this.restY}px, 0) scale(1)`;
        void stage.offsetWidth;
        stage.style.transition = '';
        stage.style.transform = `translate3d(${tx}px, ${ty}px, 0) scale(${scale})`;
        caption?.classList.add('is-shown');
      },
      /* The art is fetched for its in-page size; at the camera's scale ask
         for the larger file (browsers only ever upgrade a srcset pick). */
      sharpen(panel: HTMLElement, scale: number) {
        const img = panel.querySelector<HTMLImageElement>('.bacc-media img');
        if (img && scale > 1) img.sizes = `${Math.ceil(img.offsetWidth * scale)}px`;
      },
      recalc() {
        if (!this.panel || this.isClosing) return;
        /* A rotation re-lays the page behind: the stage keeps the in-page
           width and starts from the in-page spot of the moment. */
        stage.style.width = `${root.offsetWidth}px`;
        const at = root.getBoundingClientRect();
        this.restX = at.left;
        this.restY = at.top;
        viewport.classList.toggle('is-fill', fillView());
        const { tx, ty, scale } = this.measure(this.panel);
        viewport.style.setProperty('--cam-scale', String(scale));
        stage.style.transition = 'none';
        stage.style.transform = `translate3d(${tx}px, ${ty}px, 0) scale(${scale})`;
      },
      close(fromHistory = false) {
        if (!this.isZoomed || this.isClosing) return;
        this.isClosing = true;
        /* Take the view's history entry back off, so Back after a close
           leaves the page as it would have. */
        if (!fromHistory && history.state?.baccView) {
          this.expectPop = true;
          history.back();
        }
        viewport.classList.add('is-closing');
        caption?.classList.remove('is-shown');
        if (reduced.matches) return this.cleanup();
        stage.style.transition = '';
        stage.style.transform = `translate3d(${this.restX}px, ${this.restY}px, 0) scale(1)`;
        /* Ends on the STAGE's own transitionend (children's bubble up and
           must not end it early), with a timer as the safety net. */
        const onEnd = (e: TransitionEvent) => {
          if (e.target === stage && e.propertyName === 'transform') done();
        };
        const done = () => {
          stage.removeEventListener('transitionend', onEnd);
          if (this.isClosing) this.cleanup();
        };
        stage.addEventListener('transitionend', onEnd);
        window.setTimeout(done, 900);
      },
      cleanup() {
        stage.style.transition = 'none';
        stage.style.transform = '';
        stage.style.width = '';
        root.style.height = '';
        viewport.classList.remove('is-zoomed', 'is-closing', 'is-fill');
        document.body.style.overflow = '';
        document.documentElement.style.overflow = '';
        document.documentElement.classList.remove('bacc-view-open');
        document.body.style.paddingRight = '';
        if (closeBtn) closeBtn.hidden = true;
        if (caption) {
          caption.hidden = true;
          caption.replaceChildren();
        }
        const panel = this.panel;
        this.isZoomed = false;
        this.isClosing = false;
        this.panel = null;
        holds.zoom = false;
        panel?.querySelector<HTMLElement>('[data-bacc-trigger]')?.focus({ preventScroll: true });
        kick();
      },
    };

    /* Into a brand's view. A closed brand opens first; on desktop the camera
       sets off at once for the box the panel is growing into, so the expand
       and the dolly are one move. Phones swap rows at once, so the box is
       already final. A brand's art that was never on screen (lazy) is
       decoded first, briefly, so the camera never flies into a blank. */
    function viewBrand(i: number) {
      if (!fullscreen || camera.isZoomed || camera.isClosing) return;
      const expanding = i !== current;
      if (expanding) choose(i);
      const panel = panels[i];
      const img = panel.querySelector<HTMLImageElement>('.bacc-media img');
      const go = () => camera.open(panel, expanding && !phoneView.matches);
      if (!img || img.complete) return go();
      img.loading = 'eager';
      Promise.race([img.decode().catch(() => {}), new Promise((r) => setTimeout(r, 350))]).then(go);
    }

    panels.forEach((panel, i) => {
      panel.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (camera.isZoomed) return; // the viewport's handler closes it
        if (target.closest('a, button')) return; // links and controls act for themselves
        if (fullscreen) {
          e.stopPropagation(); // the click that opens the view must not reach the viewport's close
          viewBrand(i);
        } else if (i !== current) choose(i);
      });
    });
    closeBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      camera.close();
    });
    /* A tap anywhere in the view that is not a link, a control or the copy
       closes it: the art, the black around it, the band. */
    viewport.addEventListener('click', (e) => {
      if (!camera.isZoomed || camera.isClosing) return;
      const target = e.target as HTMLElement;
      if (target.closest('a, button, .bacc-caption .bacc-content')) return;
      camera.close();
    });
    /* No scrolling the page behind (iOS pans through overflow: hidden). */
    const noScroll = (e: Event) => {
      if (camera.isZoomed) e.preventDefault();
    };
    viewport.addEventListener('touchmove', noScroll, { passive: false });
    viewport.addEventListener('wheel', noScroll, { passive: false });
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && camera.isZoomed) {
        e.preventDefault();
        camera.close();
      }
    });
    window.addEventListener('resize', () => camera.isZoomed && camera.recalc());
    /* Capture phase: this runs before the page's own popstate handlers, and
       marks the pop as the view's, so they leave the scroll alone. */
    window.addEventListener(
      'popstate',
      () => {
        if (!camera.isZoomed && !camera.expectPop) return;
        camera.expectPop = false;
        document.documentElement.dataset.viewPop = '1';
        setTimeout(() => delete document.documentElement.dataset.viewPop, 0);
        camera.close(true);
      },
      { capture: true },
    );

    /* #brand-<id> (a link or the URL hash) opens that brand's panel. */
    const selectById = (id: string) => {
      const i = panels.findIndex((p) => p.dataset.brandId === id);
      if (i >= 0) choose(i);
    };
    document.addEventListener('click', (e) => {
      const link = (e.target as Element | null)?.closest?.('a[href*="#brand-"]');
      const m = link?.getAttribute('href')?.match(/#brand-([a-z0-9-]+)$/);
      if (m) selectById(m[1]);
    });
    const fromHash = () => {
      const m = window.location.hash.match(/^#brand-([a-z0-9-]+)$/);
      if (m) selectById(m[1]);
    };
    window.addEventListener('hashchange', fromHash);
    fromHash();

    syncToggle();
  }

  initBrandAccordion();
</script>
