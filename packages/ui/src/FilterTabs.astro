---
/**
 * FilterTabs (@andrew/ui): a row of filter buttons over a list.
 *
 * Items inside the element named by `target` carry data-kind="<key>". Plain
 * buttons with aria-pressed (a filter, not a tablist: the list itself never
 * changes identity). Without JavaScript every item stays visible.
 *
 * Two modes:
 *  - `single` (default): exactly one tab is pressed; a tab with key "all"
 *    shows everything, and the first tab starts pressed.
 *  - `toggle` (BE Unconventional HQ's coverage filters): no "All" tab and
 *    nothing pressed at first, which shows everything. A press filters to
 *    that kind (releasing any other); pressing it again releases it and
 *    everything shows again. The tabs share one equal width.
 * Either way, ?filter=<key> presses that tab on load (deep links).
 */
interface Props {
  /** id of the element whose [data-kind] children are filtered */
  target: string;
  tabs: { key: string; label: string }[];
  label: string;
  mode?: 'single' | 'toggle';
}

const { target, tabs, label, mode = 'single' } = Astro.props;
const toggle = mode === 'toggle';
---
<div class:list={['filter-tabs', { 'filter-tabs--toggle': toggle }]} role="group" aria-label={label} data-filter-tabs data-target={target} data-mode={mode} style={toggle ? `--tab-n: ${tabs.length}` : undefined}>
  {tabs.map((t, i) => (
    <button type="button" class="filter-tab" data-key={t.key} aria-pressed={!toggle && i === 0 ? 'true' : 'false'}>
      {t.label}
    </button>
  ))}
</div>

<style>
  .filter-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 1.5rem;
  }
  /* The button standard's sm size (cta.css): a 32px box, a 44px hit area. */
  .filter-tab {
    position: relative;
    z-index: 1; /* its hit area paints over the list that follows */
    min-height: var(--btn-h-sm);
    padding: calc(6 * var(--ui-u)) var(--btn-px-sm);
    background: transparent;
    border: 1px solid var(--hairline-strong, rgba(255, 255, 255, 0.15));
    border-radius: var(--btn-radius);
    color: var(--muted);
    font: 600 var(--btn-fs-sm)/1.2 var(--font-body);
    letter-spacing: var(--btn-ls);
    text-transform: uppercase;
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease, background-color 0.2s ease;
  }
  .filter-tab::before {
    content: '';
    position: absolute;
    inset: min(0px, calc((var(--btn-h-sm) - var(--tap-min)) / 2 - 1px)) -1px /* from the padding box: past the 1px border */;
  }
  /* Tabs wrap onto a second row on a phone: the rows stay a hit area
     apart. */
  .filter-tabs {
    row-gap: calc(var(--tap-min) - var(--btn-h-sm) + 2px);
  }
  .filter-tab:hover {
    color: var(--ink);
    border-color: rgba(255, 255, 255, 0.4);
  }
  /* Toggle mode: one equal width (the widest label's), evenly spaced. */
  .filter-tabs--toggle {
    display: grid;
    grid-template-columns: repeat(var(--tab-n, 2), minmax(0, 1fr));
    width: max-content;
    max-width: 100%;
    gap: 0.75rem;
  }
  .filter-tabs--toggle .filter-tab {
    min-width: 7.5rem;
  }
  .filter-tab[aria-pressed='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--page-bg, #080808);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-filter-tabs]').forEach((group) => {
    if (group.dataset.ready) return;
    group.dataset.ready = '1';
    const list = document.getElementById(group.dataset.target ?? '');
    if (!list) return;
    const tabs = Array.from(group.querySelectorAll<HTMLButtonElement>('.filter-tab'));
    const toggle = group.dataset.mode === 'toggle';
    // key null: nothing pressed (toggle mode), which shows everything.
    const apply = (key: string | null) => {
      tabs.forEach((t) => t.setAttribute('aria-pressed', String(key !== null && t.dataset.key === key)));
      list.querySelectorAll<HTMLElement>('[data-kind]').forEach((item) => {
        item.hidden = key !== null && key !== 'all' && item.dataset.kind !== key;
      });
      // Anything revealed here must not sit at a scroll-reveal pre-state.
      document.dispatchEvent(new CustomEvent('reveal:force', { detail: list }));
    };
    tabs.forEach((t) =>
      t.addEventListener('click', () => {
        const key = t.dataset.key ?? 'all';
        if (toggle && t.getAttribute('aria-pressed') === 'true') apply(null);
        else apply(key);
      }),
    );
    // ?filter=<key> preselects a tab (deep links from nav and search).
    const fromUrl = new URLSearchParams(window.location.search).get('filter');
    if (fromUrl && tabs.some((t) => t.dataset.key === fromUrl)) apply(fromUrl);
  });
</script>
