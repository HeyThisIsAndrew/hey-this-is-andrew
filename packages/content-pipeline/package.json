{
  "name": "@andrew/content-pipeline",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Substack ingestion, HTML sanitization, snapshot merging, and article image optimization pipeline for sites in this monorepo.",
  "type": "module",
  "bin": {
    "sync-substack": "./bin/sync-substack.mjs",
    "sync-article-images": "./bin/sync-article-images.mjs"
  },
  "exports": {
    ".": "./src/index.ts",
    "./substack/client": "./src/substack/client.ts",
    "./substack/parser": "./src/substack/parser.ts",
    "./substack/transform": "./src/substack/transform.ts",
    "./substack/media": "./src/substack/media.ts",
    "./substack/toc": "./src/substack/toc.ts",
    "./substack/images-transform": "./src/substack/images-transform.ts",
    "./substack/store": "./src/substack/store.ts",
    "./substack/sync": "./src/substack/sync.ts",
    "./images/optimizer": "./src/images/optimizer.ts",
    "./snapshot": "./src/snapshot.ts",
    "./file-lock": "./src/file-lock.ts"
  },
  "files": [
    "src",
    "bin"
  ],
  "scripts": {
    "test": "node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "fast-xml-parser": "^5.8.0",
    "sanitize-html": "^2.17.6",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@types/sanitize-html": "^2.16.1"
  }
}
