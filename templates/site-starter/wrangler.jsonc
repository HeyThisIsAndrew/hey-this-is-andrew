// Cloudflare Worker serving this static site from dist/.
// Deploy: pnpm cf deploy __SITE__ (or push to main; see .github/workflows/cloudflare.yml).
{
  "name": "__SITE__",
  "compatibility_date": "2026-10-06",
  // Branch and PR previews at https://<alias>-<worker>.heythisisandrewb.workers.dev
  // (wrangler versions upload --preview-alias; production is untouched).
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
