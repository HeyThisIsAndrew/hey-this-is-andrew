---
/**
 * The ONE layout every page uses: head and meta, favicon, shared chrome
 * (grain, focus, selection) from @andrew/ui, the Nav and the Footer.
 */
import '@andrew/tokens/tokens.css';
import '../styles/theme.css';
import '@andrew/ui/styles/base.css';
import '@andrew/ui/styles/chips.css';
import '../styles/global.css';
import '@andrew/ui/styles/cta.css';
import Nav from '@andrew/ui/Nav.astro';
import Footer from '@andrew/ui/Footer.astro';
import ChromeMeta from '@andrew/ui/ChromeMeta.astro';
import PageNav from '@andrew/ui/PageNav.astro';
import logo from '../assets/logo.svg';
import { SITE, NAV_LINKS, FOOTER_EXPLORE, SOCIALS, homeUrl } from '../data/site';

interface Props {
  title: string;
  description?: string;
}

const { title, description = SITE.description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const logoAsset = { src: logo.src, width: logo.width, height: logo.height, alt: SITE.name };
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <ChromeMeta />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@600;700;800&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <Nav logo={logoAsset} homeHref={homeUrl} links={NAV_LINKS} />
    <main id="main-content">
      <slot />
    </main>
    <PageNav />
    <Footer
      logo={logoAsset}
      tagline={SITE.tagline}
      explore={FOOTER_EXPLORE}
      socials={SOCIALS}
      copyright={SITE.copyright}
      privacyHref={homeUrl}
    />
    <script>
      import { initSectionAnchors } from '@andrew/ui/scripts/section-anchors.ts';
      initSectionAnchors();
    </script>
  </body>
</html>
