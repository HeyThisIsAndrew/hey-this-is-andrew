---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '@andrew/ui/SectionHeader.astro';
import PhotoElevator from '@andrew/ui/PhotoElevator.astro';

const photos = [
  { id: '1', image: { src: '', width: 800, height: 600, format: 'webp' }, caption: 'Sample Photo', category: 'Photography', location: 'Studio', video: false }
];
---
<BaseLayout title="Gallery · NEW_SITE" description="Selected photography.">
  <div class="container" style="padding-top: 6rem; padding-bottom: 6rem;">
    <section id="photos">
      <SectionHeader index="01" kicker="Portfolio" title="Photos" lede="Shot on the job." />
      <div style="margin-top: 2rem;">
        <PhotoElevator photos={[]} />
      </div>
    </section>
  </div>
</BaseLayout>
